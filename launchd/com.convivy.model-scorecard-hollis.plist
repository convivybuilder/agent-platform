<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.convivy.model-scorecard-hollis</string>

    <!-- Deploy-pinned per platform/decisions/0059 rule 1
         (issue_01M19RRWSS9ETR09N9M2BJPA0Q): a timer firing unattended is
         production USE of model-scorecard, not someone working on it, so this reads
         a COPY installed from `main` into ~/.local/deploy/agent-platform-shared/
         (rules 2, 6, 7) instead of the ~/.local/bin symlink into the checkout —
         that symlink still exists and still reaches the tree, for the person who
         re-invokes model-scorecard interactively while working on it (rule 5).
         bin/agent-platform-autopull refreshes the deploy area on every
         origin/main advance; bin/install-agent-platform-shared is what actually
         builds it.
         ProgramArguments names the deploy area's own pinned interpreter
         explicitly (rule 4), not the shebang or launchd's PATH.

         Recovered from ~/Library/LaunchAgents/com.convivy.model-scorecard-hollis.plist
         (this PR's own audit found this job's definition existed nowhere in any
         repo, the same gap com.convivy.model-scorecard-weekly closed for the Monday
         rollup). This is the per-repo hollis scorecard (the repo-scorecard flag,
         set to hollis), distinct from com.convivy.model-scorecard (the daily fleet-wide scan) and
         com.convivy.model-scorecard-weekly (the Monday rollup post). It is currently
         NOT loaded on this machine — committing this definition recovers it into
         git so a reprovision would not lose it silently, but does not load it;
         loading it is a separate, deliberate step. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/deploy/agent-platform-shared/venv/bin/python3</string>
        <string>__HOME__/.local/deploy/agent-platform-shared/bin/model-scorecard</string>
        <string>--repo-scorecard</string>
        <string>hollis</string>
        <string>--days</string>
        <string>14</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.local/deploy/agent-platform-shared</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>35</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Convivy/agent-runs/model-scorecard-hollis.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Convivy/agent-runs/model-scorecard-hollis.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
