# A NEW lib module is a deploy hazard, and the obvious guard is worse than the hazard.
#
# `~/.local/lib/agent-platform` is a directory of PER-FILE symlinks into the repo, so the
# moment main carries an agentctl importing a module install.sh has not linked yet, every
# spawn dies at import time — a fleet-down footgun aimed at the 01:00 overnight.
#
# The first fix here was `sys.path.append(<repo>/lib/agent-platform)`. Security review
# killed it, correctly. The deployed dir only exposes the files install.sh has linked;
# appending the repo lib dir makes any file DROPPED there importable. An agent reviewing
# an attacker-authored diff can read the symlink, learn the repo root, and write a
# tool_policy.py that the next spawn imports — and this is the module that decides the
# permission mode. Curing an availability bug by widening the import surface of the
# permission system is a bad trade at any price.
#
# So the import is allowed to FAIL SOFT instead. An unlinked module degrades policy
# recording and leaves the fleet running on its prior behaviour, loudly. Nothing new
# becomes importable.
try:
    import tool_policy as TP  # noqa: E402
except ImportError as _e:  # pragma: no cover — deploy-window only
    TP = None
    print(f"agentctl: tool_policy unavailable ({_e}); policy will not be resolved or "
          f"recorded this run. Run install.sh to link it.", file=sys.stderr)

try:
    import bosun_authz as AU  # noqa: E402
except ImportError as _e:  # pragma: no cover — deploy-window only
    AU = None
    print(f"agentctl: bosun_authz unavailable ({_e}); `authz replay` will not run "
          f"this session. Run install.sh to link it.", file=sys.stderr)

# Same deploy hazard, same fail-soft, for the same reason (see the block above).
# Unlinked, the primary-mutation guard does not run and every other behaviour is
# unchanged — a run that would have been caught finalizes as it did before the
# guard existed, which is the pre-guard status quo rather than a new failure.
try:
    import primary_guard as PG  # noqa: E402
except ImportError as _e:  # pragma: no cover — deploy-window only
    PG = None
    print(f"agentctl: primary_guard unavailable ({_e}); a run that writes into a "
          f"primary checkout will NOT be caught this run. Run install.sh to link it.",
          file=sys.stderr)

# Same deploy hazard, but the failure direction is the opposite: an unlinked
# codex_bridge means a Codex dispatch cannot show its guards are installed, so
# `codex_dispatch_refusal` refuses it. Every non-Codex dispatch is unaffected.
try:
    import codex_bridge as CB  # noqa: E402
    import codex_probe as CP  # noqa: E402
except ImportError as _e:  # pragma: no cover — deploy-window only
    CB = CP = None

# Same deploy hazard as the block above, but `_content_scan_gate` (not this
# import) is where the failure direction differs from every other module
# here: those fail soft and let their caller proceed on the platform's prior
# behaviour; an unlinked publish_scan instead makes `cmd_publish` REFUSE every
# push until it is linked, because this module's whole job is making sure a
# push is never unscanned.
try:
    import publish_scan as PS  # noqa: E402
except ImportError as _e:  # pragma: no cover — deploy-window only
    PS = None
    print(f"agentctl: publish_scan unavailable ({_e}); `agentctl publish` will refuse "
          f"every push until install.sh (or the next agent-platform-autopull tick) "
          f"links it. Run install.sh to link it now.", file=sys.stderr)

# Back-off budget for the pre-spawn concurrency reservation (Defect 1 of
# issue_01KYMF2GZKSG1VX1XSX83MA9FY). Agent runs last minutes; the global
# ceiling (16 concurrent) drains on this timescale during a normal burst.
# 5 min budget → at most ~10 attempts (5 s → 10 s → 20 s → 30 s × remainder).
# Override in tests via monkeypatch so retry loops don't add wall time.
_SPAWN_RETRY_BUDGET_S  = 300
_SPAWN_RETRY_SLEEP_0   = 5.0
_SPAWN_RETRY_SLEEP_MAX = 30.0
_SPAWN_RETRY_BACKOFF   = 2.0

# Back-off for `_finalize_run`'s end-of-run private-object import
# (issue_01M4RP1K026XJE740DMQ7AP31M, run-89f78c3f, 2026-10-12: the box at its
# per-user process limit, every fork failing with BlockingIOError/EAGAIN).
# Much shorter than the spawn budget above — a run's finalize must not sit for
# minutes on a fork contention that spawn's own retry loop is already easing,
# just long enough (a few attempts over a few seconds) to ride out the same
# transient condition rather than crash before the commit ever reaches the
# shared store.
_PRIVATE_IMPORT_RETRY_ATTEMPTS = 4
_PRIVATE_IMPORT_RETRY_SLEEP_0  = 0.5
_PRIVATE_IMPORT_RETRY_BACKOFF  = 2.0

