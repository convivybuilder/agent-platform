<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.convivy.limit-resume</string>

    <!-- Wakes each co session that stopped on a usage limit, once, after the
         limit resets (issue_01M3PXMTR0PFF6QH46F8SN76CZ). On 2026-09-29 the
         monthly spend limit refused every call at 02:31 MST; the window reset
         at 03:00 and six crews sat idle until the operator typed at ~08:something,
         because nothing was watching for the reset. This is that watcher. -->

    <!-- Deploy-pinned per platform/decisions/0059 rule 1
         (issue_01M19RRWSS9ETR09N9M2BJPA0Q), same as
         com.convivy.session-follow-watchdog.plist: a timer firing unattended is
         production USE of limit-resume, not someone working on it, so this
         reads a COPY installed from `main` into
         ~/.local/deploy/agent-platform-shared/ (rules 2, 6, 7) rather than the
         ~/.local/bin symlink into the checkout. bin/agent-platform-autopull
         refreshes the deploy area on every origin/main advance;
         bin/install-agent-platform-shared is what actually builds it, and
         needs to have run at least once after this file's bin/ and
         lib/agent-platform/ additions land before this plist's target paths
         exist.
         ProgramArguments names the deploy area's own pinned interpreter
         explicitly (rule 4), not the shebang or launchd's PATH. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/deploy/agent-platform-shared/venv/bin/python3</string>
        <string>__HOME__/.local/deploy/agent-platform-shared/bin/limit-resume</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.local/deploy/agent-platform-shared</string>

    <!-- EVERY 3 MINUTES. The window this closes is real money: every minute a
         stopped session sits idle after its limit has reset is a minute of
         autonomous work lost for nothing. `bin/limit-resume` itself is cheap
         (one rate-limit scan bounded by DEFAULT_RUN_SCAN_LIMIT, then one
         capture-pane per live co session) and its own lock file makes an
         overlapping firing a no-op, so a short interval costs little. -->
    <key>StartInterval</key>
    <integer>180</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Convivy/agent-runs/limit-resume.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Convivy/agent-runs/limit-resume.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
