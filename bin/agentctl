    return BR.root()


# Matches knowledge-ctx's `KNOWLEDGE_CTX_NO_CREW` line, emitted when no crew
# resolved for the repo and its crew-scoped instruction blocks were not composed.
_NO_CREW_RE = re.compile(
    r"^KNOWLEDGE_CTX_NO_CREW repo=(?P<repo>\S+) reason=(?P<reason>.*)$",
    re.MULTILINE,
)
# Matches knowledge-ctx's `KNOWLEDGE_CTX_TOPICS_UNREADABLE` line, emitted when
# `session_topics()` could not read the dispatched item's `topics` — a run on
# this path captures knowledge-ctx's stderr, so without re-emitting this the
# warning reaches nobody and a dispatched session's `binds_topics` selectors
# silently match nothing (reviewer, run-a0b4152c).
_TOPICS_UNREADABLE_RE = re.compile(
    r"^KNOWLEDGE_CTX_TOPICS_UNREADABLE issue=(?P<issue>\S+) reason=(?P<reason>.*)$",
    re.MULTILINE,
)
# ON THE RESOLVER TOGETHER WITH THE INDEXER. `kb sync` and `kb apply`
# fast-forward this tree and then hand the changed files to
# lib/knowledge/indexer.py, whose KNOWLEDGE now comes from the same root. Moving
# one without the other would fast-forward one tree and index another wherever
# CREWS_ROOT differs from the home's layout (review, PR 530), so they move in
# one change.
KNOWLEDGE_ROOT = BR.root() / "knowledge"
KNOWLEDGE_CTX = Path.home() / ".local" / "bin" / "knowledge-ctx"
# Matches knowledge-ctx's `_CLAUDE_MD_NOT_DELIVERED_MARKER` line — a stable,
# machine-parseable signal, not the human-readable prose beside it, so a
# later wording change to that prose can't silently break `activate_profile`'s
# detection (security-reviewer, PR #635 round 3).
_CLAUDE_MD_NOT_DELIVERED_RE = re.compile(
    r"^KNOWLEDGE_CTX_CLAUDE_MD_NOT_DELIVERED path=(?P<path>.*) reason=(?P<reason>.*)$",
    re.MULTILINE,
)
# Matches knowledge-ctx's `KNOWLEDGE_CTX_DEFAULT_PROFILE` line, emitted when it
# loaded platform/default in place of the requested profile. A dispatched run
# captures knowledge-ctx's stderr, so without re-emitting this the fallback
# would reach nobody and meta.json would name a profile that was not used.
_DEFAULT_PROFILE_USED_RE = re.compile(
    r"^KNOWLEDGE_CTX_DEFAULT_PROFILE profile=(?P<profile>\S+) reason=(?P<reason>.*)$",
    re.MULTILINE,
)
# The fixed payload knowledge-ctx writes to the dedicated pipe fd
# `activate_profile` opens and passes as `--profile-documents-current-fd`,
# exactly when THIS call's `.profile-documents.json` is current for the plan
# it just computed (it wrote the file, or its own no-op short-circuit proved
# the existing file already matches byte-for-byte) — never on `--dry-run`,
# which returns before either of those happens. `_spawn_dispatch` keys its
# document-set capture on this, not on "did activate_profile run", so a
# `--dry-run` dispatch can never read a stale or forged file left by another
# run as its own (security-reviewer, PR #740 round 4).
#
# Round 4 carried this as a stable text marker matched by regex over
# knowledge-ctx's combined stdout+stderr. Round 5 moved it to this dedicated
# pipe instead: that combined stream also carries text derived from the
# worktree (an orphan candidate's filename, among others), and a filename
# containing a newline followed by the old marker's own text forged it on a
# `--dry-run` call into a worktree a prior run had left a crafted file in.
# Nothing but knowledge-ctx's own `_signal_profile_documents_current` ever
# writes to this fd, so no copy of that forgery surface exists on this
# channel by construction — `activate_profile` below reads this fd alone and
# no longer scans stdout/stderr for any marker of this kind (security-
# reviewer, PR #740 round 5).
_PROFILE_DOCUMENTS_CURRENT_PAYLOAD = b"current\n"
# ON THE RESOLVER TOGETHER WITH ITS WRITER. telemetry.py WRITES run dirs under its
# own RUNS_ROOT and this constant is how agentctl READS them back, so both come
# from builder_root.runs_root() in the same change: moving the reader alone split
# the two wherever the root differed from <root> (PR 530 tried it, and the
# subprocess tests caught it). Tests redirect it with BUILDER_ROOT, not HOME.
RUNS_ROOT = BR.runs_root()
