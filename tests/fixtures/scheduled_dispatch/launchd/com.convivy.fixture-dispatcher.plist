<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A test fixture, not a real scheduled job: never installed under
         launchd/, never loaded by launchctl. See bin/fixture-dispatcher
         beside it (tests/fixtures/scheduled_dispatch/bin/fixture-dispatcher)
         for why this exists. -->
    <key>Label</key>
    <string>com.convivy.fixture-dispatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/fixture-dispatcher</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
