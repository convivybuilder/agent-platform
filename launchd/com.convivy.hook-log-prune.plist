<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Prunes the Claude Code hook-event spool (Deck WS1.1).

  The spool captures full user prompts and tool inputs. This job deletes lines
  the reducer has consumed and deletes whole days past the 14-day backstop. Until
  the reducer ships (WS1.3) the backstop is the only pruning in force, which
  makes this job the ONLY thing bounding that disclosure window.

  04:10 local, daily. After the UTC day has rolled for MST (17:00 local), so the
  previous UTC day is closed and prunable on the same calendar night. Off the
  01:00 overnight orchestrator hour so the two never contend.

  RunAtLoad is deliberately false: a pruner that runs on every bootstrap would
  delete on a reload during debugging, when the operator wants the corpus intact.
  A missed day is harmless — the next run collects it.

  A plist change needs bootout + bootstrap, not kickstart (ARCH-104).
-->
<dict>
    <key>Label</key>
    <string>com.convivy.hook-log-prune</string>

    <!-- Deploy-pinned per platform/decisions/0059 rule 1
         (issue_01M19RRWSS9ETR09N9M2BJPA0Q): a timer firing unattended is
         production USE of hook-log-prune, not someone working on it, so this reads
         a COPY installed from `main` into ~/.local/deploy/agent-platform-shared/
         (rules 2, 6, 7) instead of the ~/.local/bin symlink into the checkout —
         that symlink still exists and still reaches the tree, for the person who
         re-invokes hook-log-prune interactively while working on it (rule 5).
         bin/agent-platform-autopull refreshes the deploy area on every
         origin/main advance; bin/install-agent-platform-shared is what actually
         builds it.
         ProgramArguments names the deploy area's own pinned interpreter
         explicitly (rule 4), not the shebang or launchd's PATH. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/deploy/agent-platform-shared/venv/bin/python3</string>
        <string>__HOME__/.local/deploy/agent-platform-shared/bin/hook-log-prune</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.local/deploy/agent-platform-shared</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Convivy/agent-runs/hook-log-prune.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Convivy/agent-runs/hook-log-prune.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
