#!/usr/bin/env bash
# bug-sweep — daytime cost-shift packaging for a GitHub-issue ingest +
# #*-bugs triage pass against a single product. ARCH-075.
#
# Subscription-billed: launches an interactive co session on the
# bug-investigator agent inside the product repo, scoped to ingesting
# unmirrored GitHub issues and triaging the product's open ops-queue bugs.
#
# Usage:
#   bug-sweep <product>
#
#   product: one of the registry's shared-coverage products (projects.shared_coverage_products())
#
# Pre-2026-06-15 this is just convenience (everything is subscription).
# Post-2026-06-15 this is the cost-shift — the ingest+triage work moved from
# metered API to this subscription-billed command. See substrate/decisions.md
# ARCH-075.

set -euo pipefail

# The product lives under the machine's root (company/decisions/0008), printed by
# the bin/builder-root beside this file's real path; HOME does not move it.
_self_path="${BASH_SOURCE[0]}"; [ -L "$_self_path" ] && _self_path="$(readlink "$_self_path")"
lib_dir="$(dirname "$_self_path")/../lib/agent-platform"

# The valid <product> set is the registry's shared-coverage products (ARCH-358),
# read through lib/agent-platform/projects.py rather than a literal copy.
shared_coverage_products=$(PYTHONPATH="$lib_dir" python3 -c '
import projects
print(" ".join(projects.shared_coverage_products()))
') && [[ -n "$shared_coverage_products" ]] \
    || { echo "bug-sweep: cannot read the shared-coverage product list from the registry" >&2; exit 1; }

usage() {
    echo "Usage: bug-sweep <$(echo "$shared_coverage_products" | tr ' ' '|')>" >&2
    exit 1
}

[[ $# -eq 1 ]] || usage
product=$1

case " $shared_coverage_products " in
    *" $product "*) ;;
    *) echo "bug-sweep: invalid product '$product'" >&2; usage ;;
esac

root="$("$(dirname "$_self_path")/builder-root" --root)" && [[ -n "$root" ]] \
    || { echo "bug-sweep: cannot resolve the machine's root (bin/builder-root --root)" >&2; exit 1; }
product_dir="$root/$product"
[[ -d "$product_dir" ]] || { echo "bug-sweep: no product dir at $product_dir" >&2; exit 1; }

# The product's GitHub-issue intake repos (registry's `bug_sweep_repos`, else
# just the product's own repo), expanded to owner/repo and joined for the
# prompt below.
gh_repos=$(PYTHONPATH="$lib_dir" python3 -c '
import sys
import projects
repos = projects.bug_sweep_repos(sys.argv[1])
print(" + ".join(projects.repo_github_slug(r) for r in repos))
' "$product") && [[ -n "$gh_repos" ]] \
    || { echo "bug-sweep: cannot resolve the GitHub repos for product $product" >&2; exit 1; }

# Initial prompt for the bug-investigator co session: ingest unmirrored
# GitHub issues and triage the product's open ops-queue bugs.
prompt="Task: Run a GitHub-issue ingest + triage sweep for $product end-to-end. Subscription-billed daytime cost-shift per ARCH-075.

(a) GitHub-issue ingestion. Poll \`gh issue list --state open --label '-claude-mirrored'\` against $gh_repos. For each unmirrored open issue, apply the \`claude-mirrored\` label so it's not re-ingested, then file a bug on the ops queue via \`agentctl bug-create\` with the issue title and URL.

(b) Bug triage. For each open bug on the ops queue for $product, diagnose it (read the code, follow the stack trace if there is one, check the database schema if relevant), then add a threaded diagnosis comment via \`gh issue comment\` summarizing your findings.

You do NOT fix bugs in this command — diagnose and comment only. Fixing a diagnosed bug is a separate interactive session's job.

If you can't complete the sweep (rate limit, ambiguous bug, unknown state), surface that to me and say what's left undone."

cd "$product_dir"
exec co bug "$prompt"
