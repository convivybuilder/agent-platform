#!/usr/bin/python3
"""
co-session-health — Claude Code status line that warns BEFORE long-context
tool-call degradation breaks a session.

Background (ARCH-088): in a very long vivy co session, the model began emitting
malformed tool-call blocks — un-namespaced <invoke>/<parameter> tags (missing the
antml: prefix), often preceded by a stray "court" token. The harness parser only
recognizes the namespaced form, so the block leaks as literal text and the command
never runs. It is a model-side, long-context output-formatting failure (NOT a defect
in agentctl/cage/publish). Calibration against the broken session: sustained
corruption clustered at ~500K in-context tokens (~50% of the 1M window).

This status line surfaces that risk every turn, quiet until it matters:
  • below SOFT       -> dim ambient gauge
  • SOFT .. HARD     -> yellow "context large, plan a handoff"
  • >= HARD          -> orange "degradation zone, handoff now"
  • corruption seen  -> bold red "TOOL-CALL CORRUPTION, restart now" (overrides tiers)

The fix when it fires is operational, not a code change: /handoff-leave then start a
fresh co. A clean context emits clean tool-call syntax.

Input: Claude Code status-line JSON on stdin. Output: one ANSI-colored line.
Must stay fast (runs per turn, 300ms-debounced) — the transcript scan is tail-bounded.
"""
import json
import math
import os
import re
import subprocess
import sys
import time

# --- thresholds (in-context tokens) -------------------------------------------
SOFT = 350_000          # plan a handoff
HARD = 500_000          # empirical degradation onset — handoff now
PCT_SOFT = 60           # or this fraction of *whatever* window (covers 200K sessions)
PCT_HARD = 80
TAIL_BYTES = 300_000    # only scan the recent transcript tail for corruption

# un-namespaced tool-call tags = the malformed signature
_BARE_INVOKE = re.compile(r'(?<!antml:)<invoke\s+name=')
_BARE_PARAM  = re.compile(r'(?<!antml:)<parameter\s+name=')

# --- ANSI ---------------------------------------------------------------------
DIM    = "\033[2m"
YELLOW = "\033[33m"
ORANGE = "\033[38;5;208m"
RED    = "\033[1;31m"
RESET  = "\033[0m"


def _read_payload():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except Exception:
        return {}


def _ctx_tokens(cw):
    """Best in-context token estimate, with fallbacks for early/post-compact turns."""
    if not isinstance(cw, dict):
        return 0, 0, None
    size = cw.get("context_window_size") or 0
    pct = cw.get("used_percentage")
    cu = cw.get("current_usage") or {}
    # prefer the explicit breakdown (input + cache) when available
    if cu:
        toks = (cu.get("input_tokens", 0) or 0) \
             + (cu.get("cache_read_input_tokens", 0) or 0) \
             + (cu.get("cache_creation_input_tokens", 0) or 0)
    else:
        toks = cw.get("total_input_tokens", 0) or 0
    # if we only have a percentage, back into a token count from the window size
    if not toks and pct and size:
        toks = int(size * pct / 100.0)
    if pct is None and size:
        pct = round(100.0 * toks / size, 1) if size else None
    return toks, size, pct


def _corruption_in_tail(path):
    """True iff the recent transcript tail shows a leaked (un-namespaced) tool-call
    block — both <invoke> and <parameter> bare, inside assistant text (not tool_use)."""
    if not path:
        return False
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - TAIL_BYTES))
            chunk = fh.read().decode("utf-8", "ignore")
    except Exception:
        return False
    # walk only complete JSONL lines in the tail; inspect assistant text blocks
    for line in chunk.split("\n"):
        line = line.strip()
        if not line or '"assistant"' not in line:
            continue
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if ev.get("type") != "assistant":
            continue
        for b in (ev.get("message", {}) or {}).get("content", []) or []:
            if isinstance(b, dict) and b.get("type") == "text":
                t = b.get("text", "")
                if _BARE_INVOKE.search(t) and _BARE_PARAM.search(t):
                    return True
    return False


def _fmt_k(n):
    if not n:
        return "0"
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M".replace(".0M", "M")
    return f"{n/1000:.0f}K"


# --- live detached-run indicator (sous-chef request 2026-07-05) ----------------
# A detached `agentctl spawn` has no shell pane and isn't a Task-tool agent, so the
# operator's board can read empty while a full review wave runs — acute now that
# detach is the default (ARCH-317). Surface the same live runs `agentctl list`
# shows, from its source (active.json), filtered to PIDs that are actually alive so
# a stale entry can't misreport.
#
# Scope to THIS co's product (from cwd), because active.json is machine-wide: an
# unscoped count showed another product's coder on every co (constance reading
# "coder in flight" when the coder was sous-chef's — operator 2026-07-05). Product co's
# see only their own repo's runs; the steward (substrate), which dispatches across
# repos, keeps the fleet-wide view but labels it "(fleet)". Must never raise: a
# broken read yields no segment, never a broken status line.
try:
    # The run-records root from builder_root.runs_root() (company/decisions/0008),
    # found beside this script's real path. Any failure leaves no path, so the read
    # below fails into "no segment" rather than breaking the status line.
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                    "..", "lib", "agent-platform"))
    import builder_root as _BR
    ACTIVE_JSON = str(_BR.runs_root() / "active.json")
except BaseException:
    ACTIVE_JSON = ""
CYAN = "\033[36m"


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, just not ours
    except (ValueError, TypeError, OSError):
        return False
    return True


def _product_from_cwd(cwd):
    """The product/repo segment right after the machine's root in the co's cwd, or
    None. The root is builder_root.root() (company/decisions/0008); when the
    resolver did not load, there is no product, so no segment is scoped."""
    # Both sides resolved, the containment idiom the create-dir floor uses, so a
    # symlinked cwd scopes the same as the real directory it names (review, PR 539).
    try:
        root = os.path.realpath(str(_BR.root())).rstrip("/") + "/"
    except BaseException:
        return None
    if not cwd:
        return None
    # A cwd realpath cannot take (not a string, or an embedded NUL) is no product,
    # never an exception: the status line must not break (security review, PR 539).
    try:
        real = os.path.realpath(cwd)
    except (TypeError, ValueError, OSError):
        return None
    if not real.startswith(root):
        return None
    return real[len(root):].split("/", 1)[0] or None


def _live_runs(cwd):
    """`(agent names, scoped)` for the runs alive right now, or `([], False)`.

    Split from the segment that colours it so the vitals file can carry the same
    list to Deck's frame. One reader of active.json means the frame and the
    status line cannot disagree about what is running.
    """
    try:
        with open(ACTIVE_JSON) as fh:
            runs = (json.load(fh) or {}).get("runs", []) or []
    except Exception:
        return [], False
    live = [r for r in runs if _pid_alive(r.get("pid"))]
    product = _product_from_cwd(cwd)
    scoped = bool(product) and product != "substrate"
    if scoped:
        live = [r for r in live if str(r.get("repo")) == product]
    return [str(r.get("agent") or "?") for r in live], scoped




# --- billed-subscription indicator (operator 2026-07-12, ARCH-339) ------------------
# Two Claude Max subscriptions share one machine (ARCH-252): `claude-sub use A|B`
# swaps the Keychain item every NEW session reads. Nothing in the co window said
# which account the session in front of you is spending, and `claude auth status`
# / in-session /status can't answer it — they read the cached oauthAccount, which
# only a full `claude auth login` refreshes, so the display lags a switch.
#
# Show the LIVE slot, cached briefly. ARCH-339 originally resolved once per
# session and froze that value, on the premise that "what it billed at launch is
# what it bills". That premise is wrong: `claude-sub use` swaps ONE machine-wide
# Keychain item, and a session bills whatever that item holds at request time —
# a launch token only survives until it refreshes or 401s (≤ its ~8h TTL), after
# which the session follows the swap. So a session started on convivy, once its
# launch token expired and the operator had switched to nyh, was billing nyh while its
# frozen status line still read convivy — 7 sessions in that state on 2026-07-24,
# all actually on nyh, and a per-session cache that never updated could not say
# so. Since every live session shares the one credential, they all bill the same
# account: there is a single live slot, not one per session (ARCH-407).
#
# So resolve the live slot and cache it SHARED with a short TTL — cheap (one
# Keychain read per TTL window, not per render) and converges within the TTL of
# a switch. On a failed resolve, keep the last good value rather than flipping a
# correct display to "?" over a transient Keychain lock.
SUB_CACHE_DIR = os.path.expanduser("~/.cache/co-session-health")
CLAUDE_SUB = os.path.expanduser("~/.local/bin/claude-sub")
SUB_TTL_S = 60          # re-resolve the live slot at most once a minute
# Per claude-sub call. Bounded so a locked/contended Keychain degrades to the
# last good value within a couple of seconds rather than stalling the render.
SUB_TIMEOUT_S = 3
GREEN = "\033[32m"

# The slot id and email come from Keychain attributes the operator set via `claude-sub
# save`, and they are interpolated straight into an ANSI-colored line. Strip
# escape sequences so a label can never repaint or clear his terminal.
_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]|[\x00-\x1f\x7f]")


def _resolve_sub():
    """`<slot> <email>` for the live credential, or "?" if it can't be read.
    Runs at most once per session (cached by the caller) — it reads the Keychain."""
    try:
        cur = subprocess.run([CLAUDE_SUB, "current"], capture_output=True,
                             text=True, timeout=SUB_TIMEOUT_S)
        slot = cur.stdout.strip()
        if cur.returncode != 0 or not slot:
            return "?"
        lst = subprocess.run([CLAUDE_SUB, "list"], capture_output=True,
                             text=True, timeout=SUB_TIMEOUT_S)
        email = ""
        if lst.returncode == 0:
            for line in lst.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) == 2 and parts[0].strip() == slot:
                    email = parts[1].strip()
                    break
        return f"{slot} {email}".strip()
    except Exception:
        return "?"


def _cache_label(path, label):
    """Persist a resolved label. A write failure is survivable — this render still
    shows the label it resolved — so it must not propagate and lose the segment."""
    try:
        os.makedirs(SUB_CACHE_DIR, mode=0o700, exist_ok=True)
        # pid-unique temp + atomic rename: two renders racing the same session
        # can't leave a half-written label behind. O_EXCL|0o600 creates it
        # unreadable to other local users and closes the symlink-swap on the temp
        # path (the label is an email, not a secret — this is defense in depth).
        tmp = f"{path}.{os.getpid()}"
        try:
            os.unlink(tmp)          # a same-pid crash could have left one behind
        except OSError:
            pass
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(label)
        os.replace(tmp, path)
    except OSError:
        pass


def _session_key(session_id):
    """A session id reduced to something safe to use as a filename, or "".

    The id reaches this process from the status-line payload, and both the sub
    cache and the vitals file are named from it, so it is anchored once here
    rather than at each write.
    """
    if not session_id:
        return ""
    return re.sub(r"[^A-Za-z0-9_-]", "", str(session_id))[:64]


SUB_GC_AGE_S = 3 * 24 * 3600   # sweep dead-session sidecars older than 3 days


def _gc_stale_caches():
    """Remove sidecars from sessions that are gone.

    `pane-*` (the pane→tmux-session-name mapping) is swept on the same terms as
    the rest. It is one tiny file per pane ever seen on the box, which is the
    same accumulation shape the sub-cache sweep was built for — small enough to
    ignore individually and unbounded over time, which is exactly how the earlier
    accumulation got there. A live session rewrites its
    vitals file every render, so only a dead one goes stale; the legacy
    per-session `sub-<uuid>` files (this build no longer writes them) all age out
    here. `rollover-*` (ADR-0069's hook state, one per session) is the same
    shape again: a session that ends stops having anything rewrite its file.
    `render-staleness-*` (`tools/render-staleness-context.py`'s own baseline
    and fingerprint state, one pair per session) is the same shape once more.
    Never touches `sub-current`. Best-effort — a sweep failure is nothing.
    """
    try:
        cutoff = time.time() - SUB_GC_AGE_S
        for name in os.listdir(SUB_CACHE_DIR):
            if name == "sub-current" or not (name.startswith("sub-")
                                             or name.startswith("vitals-")
                                             or name.startswith("pane-")
                                             or name.startswith("rollover-")
                                             or name.startswith("render-staleness-")):
                continue
            p = os.path.join(SUB_CACHE_DIR, name)
            try:
                if os.path.getmtime(p) < cutoff:
                    os.unlink(p)
            except OSError:
                pass
    except OSError:
        pass


def _live_sub_raw():
    """`<slot> <email>` for the credential the machine is on RIGHT NOW, cached
    shared with a short TTL. Not keyed by session: one Keychain item serves every
    session, so they all bill the same account and share one label.

    On a resolve failure, keep the last good cached value — a transient Keychain
    lock must not flip a correct display to "?". Only a resolve that fails with no
    prior good value reads "?"."""
    path = os.path.join(SUB_CACHE_DIR, "sub-current")
    try:
        fresh = (time.time() - os.path.getmtime(path)) < SUB_TTL_S
    except OSError:
        fresh = False
    cached = ""
    try:
        with open(path) as fh:
            cached = fh.read().strip()
    except OSError:
        pass
    if fresh and cached:
        return cached
    label = _resolve_sub()
    _gc_stale_caches()        # bounded to the resolve branch → at most once per TTL
    if label and label != "?":
        _cache_label(path, label)
        return label
    return cached or "?"      # resolve failed → last good value, else "?"


def _sub_label(session_id=None):
    """`slot (account)` for the machine's live credential, or "". `session_id` is
    accepted and ignored — the slot is machine-wide, not per session — so the two
    callers (the coloured segment and the vitals sidecar) name the same account.
    """
    label = _ANSI.sub("", _live_sub_raw()).strip()
    if not label:
        # An empty or all-escapes label still has something to say: the resolve
        # produced nothing usable. Say it, rather than render `sub `.
        label = "?"
    slot, _, email = label.partition(" ")
    # Slot id first — it is what the operator types (`claude-sub use nyh`) — then the
    # account's local part, so two slots on the same provider stay distinct.
    return f"{slot} ({email.split('@')[0]})" if email else slot


def _sub_segment(session_id):
    """The billed-subscription segment: slot + account of the credential this
    session launched on."""
    try:
        who = _sub_label(session_id)
        return f"{DIM}{GREEN}\U0001F4B3 sub {who}{RESET}  " if who else ""
    except Exception:
        return ""


# --- the vitals file Deck's frame reads (operator 2026-07-24) ----------------------
# The operator asked for the status area's facts in Deck's own frame, so they are legible
# while he is looking at the session pane rather than at the terminal.
#
# WRITTEN FROM HERE BECAUSE THIS IS WHERE THE NUMBERS ALREADY ARE. Claude Code
# hands this process a payload carrying the context window, the model's display
# name and the session id, and nothing outside the session is given them. Deck
# could re-derive a context estimate from the transcript's usage records and a
# model name from its `message.model` id, but it would be a SECOND arithmetic
# on a different input, and the first time the two disagreed the honest answer
# would be "the terminal says 48% and the frame says 44%, and neither is wrong".
# Persisting what the status line itself rendered removes that question.
#
# AS FRESH AS THE STATUS LINE, WHICH IS THE POINT. This runs per turn, so the
# file is rewritten exactly when the TUI redraws — a session that has been idle
# for an hour has an hour-old file saying precisely what its terminal still
# says, because neither has moved. `written_at` travels with it so a reader can
# say how old the reading is rather than presenting it as live.
#
# Must never raise. A status line that fails to write its sidecar still has a
# status line to draw, and this is the last thing that should be able to break
# the first.
def _write_vitals(session_id, payload):
    key = _session_key(session_id)
    if not key:
        return
    try:
        _cache_label(os.path.join(SUB_CACHE_DIR, f"vitals-{key}.json"),
                     json.dumps(payload, sort_keys=True))
    except Exception:
        pass


def _model_label(p):
    """The running model's short name from the status-line payload (operator 2026-07-06:
    always show which model this co is on). display_name is the friendly form
    ('Opus 4.8'); fall back to the raw id, then nothing."""
    m = p.get("model") or {}
    return str(m.get("display_name") or m.get("id") or "")


def _pr(p):
    """The PR this session is working on, from the status-line payload, or None.

    The operator, 2026-07-24: the PR shows in the TUI footer and he wanted it in Deck's
    frame too. Claude Code hands it to the status-line command as `pr.{number,
    url,review_state}` — the same badge the footer draws — so it is recorded
    here rather than derived from the branch, which would be a `gh` call per turn
    and would disagree with what the footer says. Absent until a PR is found for
    the branch, and dropped once it merges, so `None` is the ordinary case."""
    pr = p.get("pr")
    if not isinstance(pr, dict):
        return None
    number = pr.get("number")
    if not isinstance(number, int):
        return None
    return {"number": number,
            "url": pr.get("url") if isinstance(pr.get("url"), str) else None,
            "review_state": pr.get("review_state")
            if isinstance(pr.get("review_state"), str) else None}


# --- what this session says it is working on (operator 2026-08-27) ----------------
#
# MEASURED BEFORE BUILDING, because the shape of the fix follows the shape of
# the failure. Across the fleet on 2026-08-27: 18 co sessions live in tmux,
# and 7 had ever recorded a working-on line at all. The freshest of those 7 was
# 7.9 hours old; the oldest 33.8. And `written_at == started_at` in every one,
# which means the re-announce path — same text, refreshed liveness, duration
# left alone — had been used ZERO times since it was built.
#
# So the dominant failure is a line that was NEVER SET, not a line that went
# stale, and a co cannot notice either one today: the age is drawn in Deck's
# cockpit, which the co is not looking at. This segment puts the fact where the
# co already looks every turn.
#
# DELIBERATELY A FACT AND NOT AN INSTRUCTION. It prints an age, never "update
# this". A co told to update rewrites the text, and ANY new text resets
# `started_at` — so a nagging segment would quietly convert "how long has this
# been the work" into "time since the co was last nagged", destroying the one
# signal the second timestamp exists for. An age is something a co reads and
# acts on or does not; it cannot be complied with cosmetically.
#
# SILENT WHEN THE LINE IS FRESH. The common case draws nothing, so the segment
# is a condition rather than decoration, and a co that has just set its line
# gets the nag to disappear as its confirmation.
WORKING_ON_STALE_S = 30 * 60     # older than this and the age is worth showing
WORKING_ON_NAME_TTL_S = 60 * 60  # how long a pane→session-name mapping is trusted


def _tmux_session_name():
    """The tmux session this pane belongs to, cached, or "".

    `co-working-on` keys its record by the TMUX SESSION NAME, because a command
    a human runs by hand has no status-line payload to read a Claude session id
    out of. This process has the payload and not the name, so it is the side
    that has to resolve one to the other.

    CACHED BECAUSE THIS IS THE PER-TURN HOT PATH. Measured on the mini,
    2026-08-27: a full render is ~32.5 ms and `tmux display-message` is ~5.1 ms
    of subprocess on top, a ~16% tax on every turn for one cosmetic segment.
    The mapping is keyed by `$TMUX_PANE`, which arrives free in the environment,
    and a pane changing sessions is rare enough that an hour-stale mapping
    self-heals long before anyone notices. Same shape as `_live_sub_raw`'s
    credential cache above, deliberately, rather than a second scheme.
    """
    pane = os.environ.get("TMUX_PANE")
    if not os.environ.get("TMUX") or not pane:
        return ""
    key = re.sub(r"[^A-Za-z0-9_-]", "", pane)[:64]
    path = os.path.join(SUB_CACHE_DIR, f"pane-{key}")
    try:
        if (time.time() - os.path.getmtime(path)) < WORKING_ON_NAME_TTL_S:
            with open(path) as fh:
                cached = fh.read().strip()
            if cached:
                return cached
    except OSError:
        pass
    try:
        done = subprocess.run(["tmux", "display-message", "-p", "#S"],
                              capture_output=True, text=True, timeout=5,
                              check=False)   # a returncode is read below, not raised on
    except (OSError, subprocess.SubprocessError):
        return ""
    name = done.stdout.strip() if done.returncode == 0 else ""
    if name:
        _cache_label(path, name)
    return name


def _working_on_segment():
    """`⌁ working-on: 47m` when the line is stale, `never set` when there is
    none, and "" when it is fresh.

    Reads `co-working-on`'s record directly rather than through a shared
    helper: one small JSON file with three keys, and a second import between
    two scripts that already agree on a filename would cost more than it saves.
    A malformed or unreadable record reads as no record, which is the honest
    answer — an unparseable line is not a line.
    """
    name = _tmux_session_name()
    if not name:
        return ""                      # not in tmux → nothing is keyed, say nothing
    key = re.sub(r"[^A-Za-z0-9_-]", "", name)[:64]
    path = os.path.join(SUB_CACHE_DIR, f"working-{key}.json")
    try:
        with open(path) as fh:
            record = json.load(fh)
        written = record["written_at"]
        # `isinstance(x, float)` IS TRUE FOR NaN AND INFINITY, and Python's json
        # module accepts both as literals by default — `jq`, which the bash half
        # of this pair uses, does not. So a hand-edited record can carry a shape
        # that only this side admits. NaN then reaches `_fmt_age`, where
        # `int(nan // 60)` raises ValueError and takes the WHOLE status line down
        # with it, not just this segment. `isfinite` is the guard; the try/except
        # at the call site is the mechanism that makes it survivable anyway.
        if not isinstance(written, (int, float)) or not math.isfinite(written):
            raise TypeError("written_at is not a finite number")
    except (OSError, ValueError, KeyError, TypeError):
        return f"  {YELLOW}⌁ working-on: never set{RESET}"
    age = time.time() - written
    if age < WORKING_ON_STALE_S:
        return ""
    return f"  {YELLOW}⌁ working-on: {_fmt_age(age)}{RESET}"


# --- rollover: what `tools/rollover-trigger.py` last decided (ADR-0069) ------
#
# THE HOOK WRITES IT, THIS ONLY READS IT. `rollover-<session_id>.json` is the
# hook's own state file, in the same cache directory the vitals write already
# uses; this segment does not evaluate a zone itself; it quotes the hook's
# last decision the same way the rest of this file quotes the status-line
# payload rather than re-deriving it. Silent when the zone is `ok` or the file
# does not exist yet — a session below the seek threshold, or on a mini before
# this shipped, should not grow a segment nobody asked for.
def _rollover_segment(session_id):
    key = _session_key(session_id)
    if not key:
        return ""
    path = os.path.join(SUB_CACHE_DIR, f"rollover-{key}.json")
    try:
        with open(path) as fh:
            record = json.load(fh)
        if not isinstance(record, dict):
            return ""
    except (OSError, ValueError):
        return ""
    state = record.get("state")
    if state == "roll_now":
        return f"  {ORANGE}↻ ROLL NOW{RESET}"
    if state != "seeking":
        return ""
    calls = record.get("calls_seeking")
    cap = record.get("cap")
    if isinstance(calls, int) and isinstance(cap, int):
        return f"  {YELLOW}↻ seeking {calls}/{cap}{RESET}"
    if isinstance(calls, int):
        return f"  {YELLOW}↻ seeking {calls}{RESET}"
    return f"  {YELLOW}↻ seeking{RESET}"


def _fmt_age(seconds):
    """`47m`, `3h`, `2d` — one unit, no decimals. An age is being read at a
    glance beside a context gauge, and "2h" answers the question "is this line
    still about what I am doing" exactly as well as "2h13m" does."""
    minutes = int(seconds // 60)
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    if hours < 24:
        return f"{hours}h"
    return f"{hours // 24}d"


def main():
    p = _read_payload()
    cw = p.get("context_window") or {}
    toks, size, pct = _ctx_tokens(cw)
    win = _fmt_k(size) if size else "?"
    model = _model_label(p)
    prefix = _sub_segment(p.get("session_id"))
    prefix += f"{DIM}⬡ {model}{RESET}  " if model else ""
    gauge = f"ctx {_fmt_k(toks)}/{win}"
    if pct is not None:
        gauge += f" ({pct:.0f}%)"

    # corruption check is the loudest signal — but skip the file read when context is
    # still small (corruption does not occur early; keeps the common path cheap)
    corrupt = False
    if toks >= SOFT or (pct or 0) >= PCT_SOFT:
        corrupt = _corruption_in_tail(p.get("transcript_path"))

    # The tier is named once and then both rendered and recorded, so the colour
    # in the terminal and the badge in Deck's frame cannot come to different
    # conclusions about the same session.
    if corrupt:
        tier = "corrupt"
        line = f"{RED}\U0001F534 {gauge} — TOOL-CALL CORRUPTION: restart now (/handoff-leave → fresh co){RESET}"
    elif toks >= HARD or (pct or 0) >= PCT_HARD:
        tier = "hard"
        line = f"{ORANGE}▲ {gauge} — degradation zone, handoff now{RESET}"
    elif toks >= SOFT or (pct or 0) >= PCT_SOFT:
        tier = "soft"
        line = f"{YELLOW}⚠ {gauge} — context large, plan a handoff{RESET}"
    else:
        tier = "ok"
        line = f"{DIM}◷ {gauge}{RESET}"

    cwd = p.get("cwd") or (p.get("workspace") or {}).get("current_dir")
    agents, scoped = _live_runs(cwd)
    if agents:
        shown = "·".join(agents[:4])
        if len(agents) > 4:
            shown += f"·+{len(agents) - 4}"
        line += f"  {CYAN}⚙ {len(agents)} in flight{'' if scoped else ' (fleet)'}: {shown}{RESET}"

    # BELT AND BRACES, AND THE BRACES ARE THE POINT. The `isfinite` guard inside
    # the segment closes the NaN case a review found; this closes the CLASS. A
    # cosmetic segment must never be able to blank the status line — the gauge,
    # the model, the credential and the in-flight runs are what a co is actually
    # reading, and losing all of them because a cache file was hand-edited is a
    # far worse outcome than losing the age. This file already takes that posture
    # for the vitals write, which happens AFTER stdout for the same reason; the
    # segment is drawn before it, so it needs its own.
    try:
        line += _working_on_segment()
    except Exception as exc:   # noqa: BLE001 — see above; a nicety may not break the line
        # ONE LINE TO STDERR, because a guard that hides a bug perfectly is the
        # failure this file keeps finding elsewhere: silence and success have to
        # stay distinguishable. stdout is the status line and must not carry it;
        # stderr costs a maintainer nothing and gives them something to notice.
        # Guarded in turn, since even this must not be able to break the line.
        try:
            sys.stderr.write(f"co-session-health: working-on segment failed: {exc!r}\n")
        except Exception:  # noqa: BLE001
            pass

    try:
        line += _rollover_segment(p.get("session_id"))
    except Exception as exc:  # noqa: BLE001 — same posture as the working-on segment above
        try:
            sys.stderr.write(f"co-session-health: rollover segment failed: {exc!r}\n")
        except Exception:  # noqa: BLE001
            pass

    sys.stdout.write(prefix + line)

    # Last, and after the line is already on stdout: the status line is what a
    # human is waiting for, and nothing about recording it should be able to
    # delay or break drawing it.
    _write_vitals(p.get("session_id"), {
        "written_at": time.time(),
        "model": model,
        "ctx_tokens": toks,
        "ctx_window": size,
        "ctx_pct": pct,
        "tier": tier,
        "sub": _sub_label(p.get("session_id")),
        "agents_in_flight": agents,
        "agents_are_fleet_wide": not scoped,
        "cwd": cwd,
        "pr": _pr(p),
    })


if __name__ == "__main__":
    main()
