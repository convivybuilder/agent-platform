# Resolved from THIS FILE, not `~/.local/lib/agent-platform` (ARCH-229): `.local/bin`
# and `.local/lib` are themselves symlinks into the primary checkout, so a bare
# `Path.home()` target collapses every caller onto whatever branch primary has
# checked out, however this script was reached. `.resolve()` is what makes the
# three real callers land on three different, correct answers: a worktree's own
# copy of this file (a real file, not a symlink) resolves to that worktree's own
# lib; `~/.local/bin/agentctl` (a symlink into primary) resolves through the
# symlink to primary's own lib, so a person typing `agentctl` still runs their
# edits; and a standalone deploy copy (agent-platform#469) resolves to that
# deploy area's own lib, decoupled from whatever primary has checked out.
_LIB_DIR = Path(__file__).resolve().parent.parent / "lib" / "agent-platform"
sys.path.insert(0, str(_LIB_DIR))
import telemetry as T  # noqa: E402
