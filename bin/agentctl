    sp_publish.add_argument("worktree", nargs="?", default=None,
                            help="worktree path (or use --run / --repo+--purpose)")
    sp_publish.add_argument("--run", default=None, help="resolve the worktree from this run-id")
    sp_publish.add_argument("--repo", default=None, help="repo name (with --purpose)")
    sp_publish.add_argument("--purpose", default=None, help="worktree purpose (with --repo)")
    sp_publish.add_argument("--pr", default=None,
                            help="verify the push lands on PR N's own branch (ARCH-347). "
                                 "Refuses if the worktree is on a different branch — the "
                                 "round-fix divergence that leaves a PR head stale. Inferred "
