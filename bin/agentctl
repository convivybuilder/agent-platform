    authz_sub = sp_authz.add_subparsers(dest="authz_command", required=True)
    sp_authz_replay = authz_sub.add_parser(
        "replay", help="replay a run's tool_calls.jsonl through the authorization "
                       "decision; reads only, writes nothing")
    sp_authz_replay.add_argument("run", nargs="*", help="a run-id or run-dir to replay")
    sp_authz_replay.add_argument("--all-since", metavar="YYYY-MM-DD", default=None,
                                 help="also replay every dispatched run on or after "
                                      "this date")
    sp_authz_replay.add_argument("--json", action="store_true", help="machine-readable")
    sp_authz_replay.set_defaults(func=cmd_authz_replay)

    sp_rpost = sp.add_parser(
        "review-post", help="post a SHA-stamped review verdict to a PR (ARCH-184 phase 2)")
    sp_rpost.add_argument("--pr", required=True, help="PR number")
    sp_rpost.add_argument("--verdict", required=True, choices=list(RP.VERDICTS),
                          help="review verdict (APPROVE | REQUEST_CHANGES)")
    sp_rpost.add_argument("--agent", required=True,
                          help="reviewer roster name (e.g. reviewer, security-reviewer)")
    sp_rpost.add_argument("--ignore-ci", dest="ignore_ci", action="store_true",
                          help="record an APPROVE even when the reviewed commit's CI is "
                               "not green or cannot be read (ARCH-345). For a repo with "
                               "no required checks; NOT a way past a red check.")
    sp_rpost.add_argument("--no-ci-wait", dest="no_ci_wait", action="store_true",
                          help=f"do not wait for an in-progress check; refuse immediately. "
                               f"By default an APPROVE over a merely-PENDING check waits up "
                               f"to {CI_PENDING_WAIT_SECS}s for it to finish rather than "
                               f"throwing the finished review away. A RED check still "
                               f"refuses at once, with or without this flag.")
    sp_rpost.add_argument("--ci-wait", dest="ci_wait", type=int, default=None,
                          metavar="SECONDS",
                          help=f"override how long to wait for a PENDING check "
                               f"(default {CI_PENDING_WAIT_SECS}s, sized to the slowest "
                               f"suite observed). Raise it for a repo with a slower suite. "
                               f"Does not affect a RED check, which never waits.")
    sp_rpost.add_argument("--body-file", dest="body_file", required=True,
                          help="path to the prose review body markdown")
    sp_rpost.add_argument("--reviewed-commit", dest="reviewed_commit", default=None,
                          help="commit reviewed (default: AGENTCTL_REVIEW_SHA from the Phase-1 pin)")
    sp_rpost.add_argument("--run-id", dest="run_id", default=None,
                          help="dispatch run-id (default: AGENTCTL_RUN_ID from the env)")
    sp_rpost.add_argument("-R", "--repo", default=None,
                          help="owner/repo (default: resolved from cwd via gh)")
    sp_rpost.add_argument("--dry-run", action="store_true",
                          help="render the stamped comment without posting")
    sp_rpost.add_argument("--allow-unverified", dest="allow_unverified", action="store_true",
                          help="when deciding auto-ready, count a stamp that carries no "
                               "run-id (the human-supervised steward Agent-tool path). "
                               "Same carve-out review-status documents (ARCH-193).")
    sp_rpost.add_argument("--allow-rescued", dest="allow_rescued", action="store_true",
                          help="post a body recovered from a run that never posted it "
                               "(ARCH-397 rescue). Refused by default: the stamp would "
                               "carry this run's id over another run's analysis. Pass "
                               "only after reading it.")
    sp_rpost.add_argument("--ignore-dispatchable", dest="ignore_dispatchable",
                          action="store_true",
                          help="post a run-id-less APPROVE even though the repo IS an "
                               "agentctl dispatch target (ARCH-392). Refused by default, "
                               "because review-status discards such a stamp and the PR "
                               "then reads APPROVED while the gate reads FAIL. The "
                               "override is recorded in both the visible banner and the "
                               "stamp. Pair it with --allow-unverified if auto-ready "
                               "should also count the stamp; without that the PR stays a "
                               "draft, because the stamp remains unauthenticated.")
    sp_rpost.add_argument("--no-auto-ready", dest="no_auto_ready", action="store_true",
                          help="do not take the PR out of draft even when this APPROVE "
                               "completes the required reviewer set (ARCH-364). By default "
                               "it is marked ready so the full suite runs; a PR nobody "
                               "marks ready is stranded, since GitHub will not merge a draft.")
    sp_rpost.set_defaults(func=cmd_review_post)

    sp_rready = sp.add_parser(
        "pr-ready", help="mark a draft PR ready once its review cycle clears (ARCH-364)")
    sp_rready.add_argument("--pr", required=True, help="PR number")
    sp_rready.add_argument("-R", "--repo", default=None,
                           help="owner/repo (default: resolved from cwd via gh)")
