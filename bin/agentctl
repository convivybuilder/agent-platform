    sp_pr.set_defaults(func=cmd_pr_open)

    sp_pol = sp.add_parser(
        "policy", help="show an agent's effective tool policy for a runtime (ARCH-346)")
    sp_pol.add_argument("agent", help="agent roster name (e.g. reviewer, coder)")
    # Literals, NOT TP.AUTONOMOUS. The parser is built on EVERY agentctl invocation, so
    # touching TP here reaches through the soft import and re-arms the fleet-down bug it
    # exists to prevent: an unlinked tool_policy would take out `agentctl spawn`, and with
    # it the 01:00 overnight, from an argparse line about a help command. Verified by
    # reproducing exactly that crash (2026-07-14). A degraded import must degrade ONE
    # feature, not the binary.
    sp_pol.add_argument("--runtime", choices=["autonomous", "interactive"],
                        default="autonomous",
                        help="autonomous = `agentctl spawn` (claude -p); "
                             "interactive = a Claude Code session reading .claude/agents")
    sp_pol.add_argument("--on", default=None, help="repo the spawn targets (scopes gh grants)")
    sp_pol.add_argument("--json", action="store_true", help="machine-readable")
    sp_pol.set_defaults(func=cmd_policy)

    sp_authz = sp.add_parser(
