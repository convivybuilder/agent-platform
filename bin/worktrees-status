#!/usr/bin/env python3.11
"""worktrees-status — print every git worktree under management.

Discovers primaries at depth 1 under the machine's root and lists
each worktree with branch, status summary, and the agent currently holding it
if any (from <root>/agent-runs/active.json).
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

# Prefer this checkout's own lib over the installed farm (bin/knowledge-watcher's
# shape) — a Builder deploy area has bin/ and lib/agent-platform/ together but no
# ~/.local farm at all.
for _libdir in ((Path(__file__).resolve().parent.parent / "lib" / "agent-platform"),
                Path.home() / ".local" / "lib" / "agent-platform"):
    if (_libdir / "worktrees.py").is_file():
        sys.path.insert(0, str(_libdir))
        break

import worktrees as W  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description="List all managed git worktrees with status.")
    p.add_argument("--base-branch", default=W.DEFAULT_BASE_BRANCH,
                   help="branch used for ahead/behind comparison (default: main)")
    args = p.parse_args(argv)

    holds = W.in_use_map()
    rows = W.all_worktrees(base_branch=args.base_branch)
    if not rows:
        print("(no worktrees discovered)")
        return 0

    label_w = max(len(wt.label) for wt in rows)
    branch_w = max(len(wt.branch or "(detached)") for wt in rows)
    for wt in rows:
        branch = wt.branch or "(detached)"
        status = W.status_summary(wt)
        held = holds.get(wt.path.resolve())
        suffix = ""
        if held:
            suffix = f"      [{held.get('run_id')}: {held.get('agent')}]"
        print(f"{wt.label:<{label_w}}  {branch:<{branch_w}}  {status}{suffix}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
