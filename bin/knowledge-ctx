#!/usr/bin/env python3
"""knowledge-ctx: individuate a knowledge profile into the current repo's .claude/.

Usage:
  knowledge-ctx use <profile>         # individuate <profile> into ./.claude/
  knowledge-ctx active                # print the currently-active profile
  knowledge-ctx list                  # list profiles available for the current project
  knowledge-ctx inventory             # read-only: every rendered skill/agent on this
                                       # machine, matched to its source, unmatched ones listed
  knowledge-ctx check                 # read-only: is cwd's render current for its active
                                       # profile? exit 0 current, 1 behind, 3 cannot tell

Flags (for `use`):
  --force                             # clear .claude/agents and .claude/skills, then write
  --force-anyway                      # skip the live-Claude-process pre-flight check
  --dry-run                           # print the individuation plan without writing
  --agent NAME                        # this render is for agent NAME (a dispatched run);
                                       # absent means a crew session render, as today

Spec: 01-knowledge-infra.md deliverable 2.9. Contracts:
- ARCH-022: profiles resolved by the Library (GET /profiles/<project>/<variant>); the
            knowledge checkout is not read for a profile
- ARCH-023: non-destructive by default (abort on conflicts); --force opts into clear+rewrite;
            both modes pre-flight against live Claude Code processes with --force-anyway escape.
            The one exception (issue_01M2HT8TM0M85WCQ594ADPMEFT): a rendered agent/skill file
            with NO document anywhere in the index OR the knowledge checkout on disk — not merely
            excluded by this profile — is a CANDIDATE for removal in either mode, but is only
            actually removed once it also clears a per-file gate: listed in the workspace's
            PREVIOUS individuation manifest, a plain file with no symlink anywhere between it
            and agents_dir/skills_dir, not tracked by git in the target repo, and read from a
            trustworthy index (both known-id sets non-empty, KB_INDEX_DB unset or pointed at the
            default) AND a readable knowledge checkout on disk (round 3: the index alone can be
            caught mid-reconcile, populated yet still missing the one id that matters). A candidate
            that fails any of those is reported ("orphan, not removed: <reason>") and left alone
            rather than deleted (round 2, extended round 3, same issue).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sqlite3
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "agent-platform"))
import venv_bootstrap  # noqa: E402
if __name__ == "__main__":
    venv_bootstrap.ensure(__file__, requires=("yaml",))
import yaml  # noqa: E402

# The individuation manifest, relative to `.claude/`. Mirrored by
# worktrees._MANIFEST_NAME and pinned by a test — the two live either side of the
# deployed-lib seam (bin/ tools import from ~/.local/lib), so a shared constant
# would break every branch until the lib half merged.
_MANIFEST_NAME = ".materialized"

# The per-document record `individuate()` writes beside `.active-profile`, so
# `session-agent documents` (agent-platform issue_01M0Y6NVCECKQMDS74R1KZ1WT4)
# can answer "which knowledge documents did this checkout's profile bring"
# without re-deriving the plan, which needs the KB index and the profile YAML
# neither of which a session-agent caller has. Mirrored in
# session_documents._PROFILE_DOCUMENTS_NAME, on the same either-side-of-the-
# deployed-lib-seam basis as _MANIFEST_NAME above, and pinned equal by a test.
_PROFILE_DOCUMENTS_NAME = ".profile-documents.json"

# Stable, machine-parseable marker for a blocked `.claude/CLAUDE.md` write
# (see `claude_md_write_blocked` below) — emitted on stderr alongside the
# human-readable line so `agentctl`'s `activate_profile` can detect the
# outcome on a capturing, zero-exit call without matching the prose, which a
# later wording change would otherwise break silently (security-reviewer,
# PR #635 round 3: the prose line reached nobody on a dispatch, because
# `activate_profile` only inspects captured output on a non-zero exit).
_CLAUDE_MD_NOT_DELIVERED_MARKER = "KNOWLEDGE_CTX_CLAUDE_MD_NOT_DELIVERED"

# The one-byte-payload signal `_signal_profile_documents_current` writes to
# `--profile-documents-current-fd` exactly when THIS call's
# `.profile-documents.json` on disk is current for the plan THIS call
# computed — either because the write loop just wrote it, or because the
# `plan_is_current` no-op short-circuit proved it already matches byte-for-
# byte (`_profile_documents_match`, which ignores only the ever-changing
# `materialized_at` field). `--dry-run` returns before that proof ever runs,
# so it never writes this. Round 4 carried this as a stable text marker on
# stderr instead of a dedicated fd; round 5 moved it here because stderr also
# carries text derived from the worktree (a blocked orphan's filename, among
# others) that a caller cannot fully control the shape of — a filename
# containing a newline followed by the marker's own text forged the round-4
# marker on a `--dry-run` call into a worktree a prior run had left a crafted
# file in (security-reviewer, PR #740 round 5). A dedicated fd that nothing
# else in this process ever writes to closes that whole class by construction
# rather than by hardening each place worktree-derived text reaches stderr.
_PROFILE_DOCUMENTS_CURRENT_PAYLOAD = b"current\n"


def _signal_profile_documents_current(fd: int | None) -> None:
    """Tell the caller (`agentctl`) that THIS call's `.profile-documents.json`
    is current for the plan it just computed, by writing one fixed payload to
    the pipe fd `--profile-documents-current-fd` named — never to stdout or
    stderr, which also carry text derived from the worktree (orphan
    filenames, conflict paths, source document content) that this process
    does not fully control the shape of. The reader on the other end
    (`agentctl.activate_profile`) drains this same fd alone; it no longer
    scans combined output for a text marker (PR #740 round 5).

    `fd is None` — every caller but `agentctl` today — is a silent no-op. A
    write failure is swallowed rather than aborting an otherwise-successful
    render: the reader already fails closed to "not current" when nothing
    arrives on the pipe. Deliberately does NOT close `fd`: ownership stays
    with whoever opened it (`agentctl`'s `read_fd, write_fd = os.pipe()`, or
    a test calling `individuate()` in-process the same way) — in the real
    subprocess case that fd is a distinct descriptor-table entry in THIS
    process regardless, reclaimed on exit either way, so closing it here
    would only save the caller a redundant close on the paths that do call
    this; every OTHER return from `individuate()` (`--dry-run`, every abort)
    never calls this at all, so a close here would not even be symmetric.
    """
    if fd is None:
        return
    try:
        os.write(fd, _PROFILE_DOCUMENTS_CURRENT_PAYLOAD)
    except OSError:
        pass

_DEFAULT_DB_PATH = Path.home() / ".knowledge-index" / "index.db"
# Honours KB_INDEX_DB the same way lib/knowledge/indexer.py's DB does, so a test
# run (or a repair pass) that points the whole machine's index elsewhere is
# something orphan deletion below can detect and refuse rather than trust
# blindly (see _index_trust_problem).
DB_PATH = Path(os.environ.get("KB_INDEX_DB", str(_DEFAULT_DB_PATH)))
