# Deprecated tool aliases — kept for one cycle (ARCH-361). Each delegates to
# the issue_* implementation so behavior cannot drift. Remove after migration.
# ---------------------------------------------------------------------------

@mcp.tool()
def bug_create(product: str, title: str, severity: str, body: str = "",
               url: str | None = None, once_key: str | None = None) -> str:
    """Deprecated alias for issue_create. Use issue_create instead (ARCH-361)."""
    return issue_create(product=product, title=title, severity=severity, body=body,
                        url=url, once_key=once_key)


@mcp.tool()
def bug_list(product: str | None = None, state: str = "open") -> str:
    """Deprecated alias for issue_list. Use issue_list instead (ARCH-361)."""
    return issue_list(product=product, state=state)


@mcp.tool()
def bug_claim(bug_id: str) -> str:
    """Deprecated alias for issue_claim. Use issue_claim instead (ARCH-361)."""
    return issue_claim(issue_id=bug_id)


@mcp.tool()
def bug_resolve(bug_id: str, resolution: str, outcome_note: str = "",
                fix_pr: str | None = None, owner: str | None = None) -> str:
    """Deprecated alias for issue_resolve. Use issue_resolve instead (ARCH-361)."""
    return issue_resolve(issue_id=bug_id, resolution=resolution,
                         outcome_note=outcome_note, fix_pr=fix_pr, owner=owner)


@mcp.tool()
def bug_link_pr(bug_id: str, pr: str, url: str = "") -> str:
    """Deprecated alias for issue_link_pr. Use issue_link_pr instead (ARCH-361)."""
    return issue_link_pr(issue_id=bug_id, pr=pr, url=url)


@mcp.tool()
def bug_escalate(bug_id: str, decision_id: str, url: str = "") -> str:
    """Deprecated alias for issue_escalate. Use issue_escalate instead (ARCH-361)."""
    return issue_escalate(issue_id=bug_id, decision_id=decision_id, url=url)


