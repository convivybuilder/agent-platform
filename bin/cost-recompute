#!/usr/bin/env python3
"""Recompute stored sub-run cost.json records priced with the wrong rates.

Dry run by default: prints, per day, how many records would change and the old and
new dollar totals, and changes nothing. Policy and rationale live in
`lib/agent-platform/cost_recompute.py`.

Usage:
  cost-recompute                       # dry run: recompute from transcript usage
  cost-recompute --apply               # save cost.json.pre-recompute beside each record, then rewrite it
  cost-recompute --scale-sonnet-5          # dry run: scale old-rate Sonnet 5 records with no transcript
  cost-recompute --scale-sonnet-5 --apply  # same, writing the change
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

for _libdir in ((Path(__file__).resolve().parent.parent / "lib" / "agent-platform"),
                Path.home() / ".local" / "lib" / "agent-platform"):
    if (_libdir / "cost_recompute.py").is_file():
        sys.path.insert(0, str(_libdir))
        break

import venv_bootstrap  # noqa: E402
if __name__ == "__main__":
    venv_bootstrap.ensure(__file__, prefer_venv=True)
import cost_recompute as CR  # noqa: E402
import telemetry as T  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="Recompute stored sub-run cost records.")
    ap.add_argument("--apply", action="store_true",
                    help="rewrite the records; without it nothing is changed")
    ap.add_argument("--scale-sonnet-5", action="store_true",
                    help="scale old-rate claude-sonnet-5 usd by 2/3 instead of "
                         "recomputing from a transcript, for records with no transcript to recompute from")
    args = ap.parse_args()
    if args.scale_sonnet_5:
        _, report = CR.run_sonnet_5_scale(T.RUNS_ROOT, apply=args.apply)
    else:
        _, report = CR.run(T.RUNS_ROOT, Path.home() / ".claude" / "projects", apply=args.apply)
    print(f"cost-recompute: {'APPLIED' if args.apply else 'dry run, nothing changed'}")
    print(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
