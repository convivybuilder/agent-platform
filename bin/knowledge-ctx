# (builder_root.root(), company/decisions/0008), found beside this script's real
# path so the repo, the ~/.local/bin link and the deploy area each read their own.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "agent-platform"))
import builder_root as BR  # noqa: E402
import agent_roles  # noqa: E402
import projects  # noqa: E402
CONVIVY = BR.root()
KNOWLEDGE = CONVIVY / "knowledge"

# Individuation telemetry (ARCH-121): each `knowledge-ctx use` appends one
# line to kb-materializations.jsonl — profile, target repo, per-rule match
# counts (a dead rule matches 0; an over-broad one dominates), totals, and
# outcome — so the convivy-orient /kb dashboard can show the individuated-vs-live
# consumption mix. Shared helper in lib/knowledge, imported defensively so a
# not-yet-installed copy degrades to no-telemetry rather than blocking `use`.
sys.path.insert(0, str(Path.home() / ".local" / "lib" / "knowledge"))
try:
    import kb_telemetry
except Exception:  # telemetry is optional — never block individuation on it
    kb_telemetry = None


def _kb_indexer():
    """Import lib/knowledge/indexer.py, preferring this checkout's own copy
    over the deployed one — mirrors agentctl._kb_indexer's reasoning:
    `bin/knowledge-ctx` can itself be the repo's working copy (ARCH-229
    symlink) or the deployed ~/.local/bin one, and a feature branch must
    exercise its OWN indexer.py rather than whatever install.sh last
    deployed.

    Used only for `indexer.split_frontmatter` — the exact frontmatter parse
    the indexer runs on every document — so `_known_ids_from_disk` derives an
    id the same way the index itself does, by calling it rather than
    re-implementing the split.
    """
    for cand in (Path(__file__).resolve().parent.parent / "lib" / "knowledge",
                Path.home() / ".local" / "lib" / "knowledge"):
        if (cand / "indexer.py").is_file():
            if str(cand) not in sys.path:
                sys.path.insert(0, str(cand))
            break
    import indexer
    return indexer


def _log_individuation(record: dict[str, Any]) -> None:
    if kb_telemetry is not None:
        kb_telemetry.append(kb_telemetry.INDIVIDUATE_LOG, record)


def die(msg: str, code: int = 1) -> None:
    sys.stderr.write(f"knowledge-ctx: {msg}\n")
    sys.exit(code)


# Exit code reserved for `detect_project` affirmatively resolving cwd to NO
# known project. Distinct from the default die() code (1, which also covers a
# generic internal crash — argparse errors, an uncaught exception, anything
# NOT emitted by detect_project itself) and from `list`'s own code=4 (a
# KNOWN, resolved project that simply has no profiles yet). `bin/co`'s
# generic tail matches on this SPECIFIC code as its only affirmative
# "cwd maps to no project" signal, and treats every other exit — missing
# binary, a crash, code 4 — as inconclusive. Do not reuse this value for any
# other die() call in this file.
NO_PROJECT_MAPPING = 42

# Exit code for a profile this DIRECTORY may not individuate — a different fact
# from the one above, and given its own code because the comment above forbids
# reusing that one. "This cwd maps to no project at all" and "this cwd maps
# fine, and is not allowed THAT profile" want opposite responses: the first is
# `bin/co`'s signal to fall back safely, the second means the caller asked for
# the wrong thing and a fallback would be exactly wrong.
#
# Nothing discriminates on it today — `bin/co`'s three refresh branches take any
# nonzero as fatal, its generic tail reads only `list`'s code, and `list` never
# reaches this refusal. It is separated now because this PR anticipates an EA
# branch in `bin/co`, and a branch written later to tell those two apart would
# have got the wrong answer from a shared code (reviewer, PR #513).
PROFILE_NOT_ALLOWED = 43


# --- cwd → project detection ---


# The directory -> project table is `projects.EXPLICIT_PROJECT_BY_NAME`, shared with
# agentctl; `projects.resolve_project` adds the `projects/<name>/` rule.


# A directory may be restricted to a NAMED SET OF PROFILES. Absent from this
# table means unrestricted, which is every directory but one, so this costs
# nothing anywhere else.
#
# WHY IT KEYS ON THE DIRECTORY RATHER THAN THE PROJECT. Several directories share
# one project — substrate and EA both map to `platform` — and a
# constraint right for one is wrong for the others. `platform/daytime` is
# substrate's own profile and must stay reachable there.
#
# THE OCCURRENCE IS AN OPERATOR AT A TERMINAL, and that is not the weaker case —
# it is the only case. Nothing else reaches `EA/.claude/agents/` at all: a
# dispatch on EA resolves its agents repo-locally and skips `activate_profile`
# entirely (see `agentctl.LOCAL_AGENT_REPOS`), and no `bin/co` branch individuates
# EA either, since it fails the `-r` git-toplevel gate and is absent from the
# six-product `case`. **So `knowledge-ctx use` typed by hand is the path that puts
# a profile in that directory, which makes it the path this guard exists for.**
#
# And the string a hand reaches for is `daytime`. It is the literal in all three
# `bin/co` refresh branches and the habit of every co on this machine.
# `platform/daytime`'s reference selector spans `[commercial, company, knowledge,
# platform]` and carries the founders' history, the portfolio and the taste map —
# into the crew holding the operator's personal correspondence. `--force` rmtrees
# `.claude/agents` and `.claude/skills` first, so the narrow profile is deleted by
# the same call that installs the wide one. Measured before the guard existed:
# `use daytime` from an EA-shaped directory individuated 31 files.
#
# AN EARLIER REVISION OF THIS COMMENT NAMED A FUTURE `bin/co` EA BRANCH as the
# occurrence. That branch does not exist, and a guard justified by a hypothetical
# is the shape this platform has a rule against. The `bin/co` literals still
# matter — they are why `daytime` is the habitual string, and an EA branch written
# by analogy with its siblings would inherit the hazard — but they are the reason
# the operator reaches for that word, not the occurrence themselves
# (reviewer and steward, PR #513).
#
# IT FAILS CLOSED, and that is the whole point: an unlisted profile is refused,
# never silently redirected to the right one. A silent redirect would make a
# directory where typing one profile name gets you a different profile, which is
# harder to reason about than the hazard, and it fails OPEN if the redirect is
# ever dropped.
_PROFILE_ALLOWLIST: dict[str, set[str]] = {
    # EA is a black box (platform/decisions/0043) holding the operator's personal email and
    # text archive. `projects/platform/profiles/ea-daytime.yaml` (knowledge#370) is
    # the only profile it may individuate.
    "EA": {"ea-daytime"},
}


def detect_product(cwd: Path) -> tuple[str, str]:
    """The PRODUCT key for cwd, plus a label naming where it came from.

    Split out of `detect_project` so `_PROFILE_ALLOWLIST` can key on the
    DIRECTORY rather than on the project it maps to. See that table's comment
    for why the distinction is load-bearing.

    Two cwd shapes are valid:
      <root>/<product>/...                        — canonical clone (daytime co)
      <root>/worktrees/<product>.<purpose>/...     — agentctl-allocated worktree
                                                      (overnight + agentctl spawn flow)
    For the worktree shape, the product is the prefix of the dirname before
    the first `.` (e.g. `constance.overnight` → `constance`).
    """
    try:
        rel = cwd.resolve().relative_to(CONVIVY.resolve())
    except ValueError:
        die(f"cwd {cwd} is not under {CONVIVY}; cannot detect product.",
            code=NO_PROJECT_MAPPING)

    parts = rel.parts
    if not parts:
        die(f"cwd is exactly {CONVIVY}; cd into a sub-repo first.",
            code=NO_PROJECT_MAPPING)
    first = parts[0]

    # agentctl worktree case: `worktrees/<product>.<purpose>/...`
    if first == "worktrees":
        if len(parts) < 2:
            die(f"cwd is exactly {CONVIVY}/worktrees; expected a worktree subdir.",
                code=NO_PROJECT_MAPPING)
        wt_dirname = parts[1]
        return wt_dirname.split(".", 1)[0], f"worktree {wt_dirname}"

    # Canonical clone case: `<root>/<product>/...`
    return first, f"cwd {cwd} (under {CONVIVY}/{first})"


def allowed_profiles(product: str) -> set[str] | None:
    """The profiles `product` may individuate, or None when unrestricted."""
    folded = product.casefold()
    for key, profiles in _PROFILE_ALLOWLIST.items():
        if key.casefold() == folded:
            return profiles
    return None


def check_profile_allowed(product: str, profile_name: str) -> None:
    """Refuse a profile this directory may not individuate. Fails closed."""
    allowed = allowed_profiles(product)
    if allowed is None or profile_name in allowed:
        return
    die(f"profile {profile_name!r} is not permitted in {product} — "
        f"allowed here: {', '.join(sorted(allowed))}. This directory is "
        f"restricted on purpose; see _PROFILE_ALLOWLIST in bin/knowledge-ctx.",
        code=PROFILE_NOT_ALLOWED)


def detect_project(cwd: Path) -> str:
    """Resolve cwd to a knowledge-base project. See spec 2.9 step 1 + ARCH-022 note."""
    product, label = detect_product(cwd)
    return projects.resolve_project(product, KNOWLEDGE) or die(
        f"no project mapping for {label} (product {product!r})",
        code=NO_PROJECT_MAPPING
    )


def _default_refused(product: str) -> bool:
    """A private crew or a restricted directory never takes `platform/default`,
    under any spelling (projects.default_profile_refused)."""
    return projects.default_profile_refused(product, _PROFILE_ALLOWLIST)


def _default_profile_available() -> bool:
    return ((projects.DEFAULT_PROFILE_PROJECT, projects.DEFAULT_PROFILE_NAME)
            in _library_profile_variants())


def detect_project_or_default(cwd: Path, allow_default: bool = True) -> tuple[str, bool]:
    """`(project, resolved)`. A directory that maps to no project takes the
    `platform` project when the Library serves `platform/default` (`GET /profiles`),
    with `resolved` False so the caller loads that profile rather than looking for
    its own name under `platform`. With `allow_default` False (`--no-default-fallback`)
    or no served `platform/default`, this is `detect_project`, exit 42 included: an
    unresolved directory must never come back as `platform`, or the caller would
    load `platform/<requested name>`. A private crew, a restricted name or an
    unreadable registry exits 42 here even when the Library serves the default."""
    product, _ = detect_product(cwd)
    if (allow_default and projects.resolve_project(product, KNOWLEDGE) is None
            and _default_profile_available()):
        if _default_refused(product):
            die(f"{product!r} is a private crew directory (or the registry could not "
                f"be read) and takes no default profile", code=NO_PROJECT_MAPPING)
        return projects.DEFAULT_PROFILE_PROJECT, False
    return detect_project(cwd), True


def iter_workspaces() -> list[Path]:
    """Every directory under CONVIVY that could hold an individuated `.claude/`
    — canonical clones (`<root>/<product>`) and worktrees
    (`<root>/worktrees/<product>.<purpose>`), the same two shapes
    `detect_product` resolves cwd through. Used only by `inventory` (read-only);
    `use` never needs the full set, just its own cwd."""
    out: list[Path] = []
    if not CONVIVY.exists():
        return out
    for p in sorted(CONVIVY.iterdir()):
        if not p.is_dir():
            continue
        if p.name == "worktrees":
            out.extend(sorted(wt for wt in p.iterdir() if wt.is_dir()))
            continue
        out.append(p)
    return out


def _yn(value: bool) -> str:
    return "yes" if value else "no"


def _inventory_flags(p: Path, ws: Path, root_dir: Path, claude_dir: Path,
                     manifest: set[str]) -> str:
    """The three per-file conditions `use`'s orphan deletion gates on
    (`_find_orphans`), reported for an UNMATCHED file so an operator can see
    which ones a render would actually remove versus report-and-leave."""
    try:
        rel = str(p.relative_to(claude_dir))
    except ValueError:
        rel = p.name
    contained = _is_contained_regular_file(p, root_dir)
    tracked = _is_git_tracked(ws, p)
    in_manifest = rel in manifest
    return f"tracked={_yn(tracked)} contained={_yn(contained)} manifest={_yn(in_manifest)}"


def inventory() -> int:
    """Read-only: every rendered skill/agent across every workspace this
    machine knows about, matched by slug to a source document id anywhere in
    the index, with unmatched (orphaned) ones listed and — for each — whether
    a render's orphan deletion would actually remove it (git-tracked,
    contained under a symlink-free path, and listed in this workspace's
    current manifest are the three per-file conditions `use` checks).

    Never writes or deletes anything — `use` is the only command that changes
    a workspace's `.claude/`. This is purely the inventory the parent epic
    asks for, so the orchestrator can act on it after review rather than this
    command acting unattended.
    """
    known = all_agent_and_skill_ids()
    agent_ids_by_slug: dict[str, list[str]] = {}
    for doc_id in known["agent"]:
        agent_ids_by_slug.setdefault(slug_from_id(doc_id), []).append(doc_id)
    skill_ids_by_slug: dict[str, list[str]] = {}
    for doc_id in known["skill"]:
        skill_ids_by_slug.setdefault(slug_from_id(doc_id), []).append(doc_id)

    workspaces = iter_workspaces()
    total = 0
    unmatched: list[str] = []
    for ws in workspaces:
        claude_dir = ws / ".claude"
        agents_dir = claude_dir / "agents"
        skills_dir = claude_dir / "skills"
        manifest = _read_previous_manifest(claude_dir)
        for p in sorted(agents_dir.glob("*.md")) if agents_dir.is_dir() else []:
            total += 1
            ids = sorted(agent_ids_by_slug.get(p.stem, []))
            if ids:
                print(f"{ws.name}\tagent\t{p.stem}\t{','.join(ids)}")
            else:
                flags = _inventory_flags(p, ws, agents_dir, claude_dir, manifest)
                print(f"{ws.name}\tagent\t{p.stem}\tUNMATCHED\t{flags}")
                unmatched.append(str(p))
        for p in sorted(skills_dir.glob("*/SKILL.md")) if skills_dir.is_dir() else []:
            total += 1
            slug = p.parent.name
            ids = sorted(skill_ids_by_slug.get(slug, []))
            if ids:
                print(f"{ws.name}\tskill\t{slug}\t{','.join(ids)}")
            else:
                flags = _inventory_flags(p, ws, skills_dir, claude_dir, manifest)
                print(f"{ws.name}\tskill\t{slug}\tUNMATCHED\t{flags}")
                unmatched.append(str(p))

    print(f"\n{total} rendered files across {len(workspaces)} workspaces; "
          f"{len(unmatched)} unmatched:")
    for u in unmatched:
        print(f"  {u}")
    return 0


# --- profile loading ---
#
# Every profile comes from the Library, which evaluates the selection rule and
# serves the resolved document set (`GET /profiles/{project}/{variant}`). No
# profile is read from the knowledge checkout, so a machine without one
# materializes the same profile. There is no local fallback: a Library that
# cannot answer stops the render with a message that names it.


def load_profile(project: str, profile_name: str) -> dict:
    """The resolved profile: `documents` (ids and hashes, no bodies), `rules`
    (each `include` rule's match count, by position) and `claude_md_extras`."""
    # Quoted: a `use` argument may hold `/`, `?` or `..`, which must not reshape the path.
    project_seg = urllib.parse.quote(project, safe="")
    variant_seg = urllib.parse.quote(profile_name, safe="")
    try:
        return _library_request("GET", f"/profiles/{project_seg}/{variant_seg}")
    except BundleRefused as e:
        if e.status == 404:
            die(f"profile not found in the Library: {project}/{profile_name}")
        die(f"cannot load profile {project}/{profile_name} from the Library: {e}. "
            f"NOTHING WAS WRITTEN.", code=LIBRARY_REFUSED)


def _library_profile_variants() -> list[tuple[str, str]]:
    """`(project, variant)` for every profile the Library holds (`GET /profiles`)."""
    try:
        listed = _library_request("GET", "/profiles")
    except BundleRefused as e:
        die(f"cannot list profiles from the Library: {e}. NOTHING WAS WRITTEN.",
            code=LIBRARY_REFUSED)
    return [(p["project"], p["variant"]) for p in listed.get("profiles", [])]


def load_profile_or_default(project: str, profile_name: str, resolved: bool,
                            restricted: bool, allow_default: bool = True,
                            where: str = "") -> tuple[dict, str, str]:
    """`(profile, project, profile_name)` actually loaded.

    `platform/default` stands in for exactly two cases: the directory resolved to
    no project (`resolved` False), or its project has no profile files at all. A
    project that has profiles but not `profile_name` fails as "profile not found",
    because a wrong name that quietly becomes the generic profile is the failure
    agentctl's NO FALLBACK PRODUCT note records. A refused directory (`restricted`,
    which the caller computes with `_default_refused`), a caller passing
    `allow_default=False`, and a Library that does not serve `platform/default` all
    get `load_profile` for the requested name, with no fallback.

    The fallback prints its real cause on stderr and a machine-readable
    `KNOWLEDGE_CTX_DEFAULT_PROFILE` line, which agentctl re-emits and records."""
    if restricted or not allow_default or not _default_profile_available():
        if not resolved:
            # `project` is the placeholder for "no project"; never load
            # `<placeholder>/<requested name>` when the default is not allowed.
            die(f"no project mapping for {where or 'this directory'} and the "
                f"default profile is not allowed here", code=NO_PROJECT_MAPPING)
        return load_profile(project, profile_name), project, profile_name
    if not resolved:
        reason = f"{where or 'this directory'} maps to no project"
    elif not _has_profiles(project):
        reason = f"project {project} has no profiles"
    else:
        return load_profile(project, profile_name), project, profile_name
    proj, name = projects.DEFAULT_PROFILE_PROJECT, projects.DEFAULT_PROFILE_NAME
    sys.stderr.write(f"knowledge-ctx: {reason}; using {proj}/{name}\n"
                     f"KNOWLEDGE_CTX_DEFAULT_PROFILE profile={proj}/{name} "
                     f"reason={reason}\n")
    return load_profile(proj, name), proj, name


def list_profiles(project: str) -> list[str]:
    return sorted(v for p, v in _library_profile_variants() if p == project)


def _has_profiles(project: str) -> bool:
    """`projects.has_profiles`, answered by the Library: `platform`'s own
    default does not count, so a `platform` with only the fallback is unprofiled."""
    names = [v for p, v in _library_profile_variants() if p == project]
    if project == projects.DEFAULT_PROFILE_PROJECT:
        names = [v for v in names if v != projects.DEFAULT_PROFILE_NAME]
    return bool(names)


# --- index queries ---


def _conn() -> sqlite3.Connection:
    if not DB_PATH.exists():
        die(f"index missing at {DB_PATH}; is the watcher running?")
    conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    return conn


# Paging size for `/reference/documents`, matching `bin/agentctl`'s
# `_LIBRARY_AGENT_PAGE` — the same listing route, read from this file's side.
_LIBRARY_DOCS_PAGE = 200


def _library_reference_rows(kind: str) -> list[dict]:
    """Every `kind` document the Library's Reference Room lists, any status,
    read to the end of `GET /reference/documents?kind=<kind>&status=all`
    (CQ·371). Dies naming the Library on any refusal or malformed page —
    there is no local fallback."""
    rows: list[dict] = []
    offset = 0
    while True:
        try:
            page = _library_request(
                "GET", f"/reference/documents?kind={kind}&status=all"
                       f"&limit={_LIBRARY_DOCS_PAGE}&offset={offset}")
        except BundleRefused as e:
            die(f"cannot list {kind} documents from the Library: {e}", code=LIBRARY_REFUSED)
        found = page.get("documents")
        if not isinstance(found, list):
            die(f"the Library's {kind} listing has no documents list", code=LIBRARY_REFUSED)
        truncated = page.get("truncated")
        if not isinstance(truncated, bool):
            die(f"the Library's {kind} listing has no boolean 'truncated'; cannot tell "
                f"whether a later page holds more rows", code=LIBRARY_REFUSED)
        rows += found
        if not truncated:
            return rows
        if not found:
            die(f"the Library's {kind} listing is truncated but returned no rows",
                code=LIBRARY_REFUSED)
        offset += len(found)


def all_agent_and_skill_ids() -> dict[str, set[str]]:
    """Every agent/skill doc id the Library's Reference Room lists, any
    project or status — the full corpus, not one profile's `include:`
    matches.

    Read from the Library (`GET /reference/documents`), not the local index
    (CQ·371, issue_01M43AE2QD6H3JZMKM2RR2NK2W): the local index does not
    exist on a machine with no knowledge checkout, and this read must not
    need one.

    `_find_orphans` uses this to tell a render this PROFILE's rules simply
    exclude (its document is still live in the corpus and correctable through
    the KB) from one with NO document anywhere (unattributable — a session can
    never correct it, because there is nothing to propose a change against).
    Only that second case is what issue_01M2HT8TM0M85WCQ594ADPMEFT calls an
    orphan.
    """
    result: dict[str, set[str]] = {"agent": set(), "skill": set()}
    for kind in ("agent", "skill"):
        for row in _library_reference_rows(kind):
            doc_id = row.get("id")
            if isinstance(doc_id, str) and doc_id:
                result[kind].add(doc_id)
    return result


def _index_trust_problem(known_ids: dict[str, set[str]]) -> str | None:
    """None if `known_ids` is trustworthy enough to justify deleting a file on
    its say-so; otherwise the reason it is not.

    `known_ids` comes from the Library now (CQ·371), so there is no more
    `KB_INDEX_DB` to point away from the default; the one thing left to
    distrust is an empty set on either side. A not-yet-populated, mid-reindex,
    or misrooted corpus reads back with no agent or no skill documents at
    all — indistinguishable, from here, from a genuinely empty corpus, which
    never happens on a real machine (reproduced: an empty-both-sets index
    makes every rendered agent/skill file in a workspace look orphaned)."""
    if not known_ids.get("agent"):
        return "the Library's known-agent set is empty"
    if not known_ids.get("skill"):
        return "the Library's known-skill set is empty"
    return None


# Generous for any real frontmatter block (a handful of short YAML lines);
# tiny next to a full document, which can run to many pages. Sized so this
# read never needs to know a document's actual length up front.
_MAX_FRONTMATTER_BYTES = 64 * 1024


def _frontmatter_from_disk(path: Path, indexer_mod) -> tuple[dict | None, bool]:
    """`(frontmatter, ok)` for one `.md` file under the knowledge checkout.

    `ok` is False for anything this could not fully account for — the
    caller must never read `ok=False` as "this document declares nothing":
    that is exactly how a document this scan could not see would look
    identical to one that was genuinely deleted. `ok=True` with
    `frontmatter=None` is the OTHER, legitimate outcome: this scan looked
    and is CONFIDENT there is nothing to declare — either a frontmatter
    document that simply isn't one (no delimiter, or malformed YAML, WITHIN
    what this scan actually read), or `path` proven, by `lstat` alone, to
    not even be a regular file.

    A document whose frontmatter's closing `---` sits PAST
    `_MAX_FRONTMATTER_BYTES` is neither of those: this scan cannot see the
    closing delimiter at all, so a parse failure here does not mean the
    document HAS no frontmatter — it may have real frontmatter this read
    simply never reached, which looks byte-for-byte identical to "no
    frontmatter" from inside the truncated window alone. Treated as
    `ok=False` (unreadable), never as "confirmed nothing to declare" — round
    4 read exactly `_MAX_FRONTMATTER_BYTES` bytes and could not tell the two
    apart, so an oversized-but-real frontmatter silently read back as
    `ok=True, frontmatter=None`, which is precisely the "declares nothing"
    misreading this whole function exists to refuse (security-reviewer,
    round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT). One extra byte read below
    (`_MAX_FRONTMATTER_BYTES + 1`) is what distinguishes the two cases
    without reading a giant document whole: fewer than that many bytes back
    proves EOF fell within the cap, so a parse failure there IS a genuine,
    fully-seen "no frontmatter."

    That `lstat` proof matters on its own: a FIFO, socket, or device
    dropped into this tree can NEVER declare a frontmatter id, and `lstat`
    (which does not follow and does not open) establishes that without ever
    calling `open(2)` on it — so a FIFO here cannot even reach the syscall
    that would otherwise block on it. `open(2)` on a FIFO with no writer
    blocks at the syscall until one appears; that is what let one dropped
    into this tree hang every render on the machine, forever, before this
    fix (round 4, issue_01M2HT8TM0M85WCQ594ADPMEFT — reproduced with
    `os.mkfifo`). `O_NONBLOCK` on the open below is the second layer: a FIFO
    created in the instant between the `lstat` and that open (a race the
    `lstat` alone cannot close) returns immediately instead of blocking.

    A regular file that turns out NOT to be one by the time it is actually
    opened (`fstat` on the live descriptor disagreeing with the `lstat`
    moments earlier) is a DIFFERENT case from the direct-`lstat` one above:
    it is a race, not an established fact, so it counts as `ok=False`
    (unreadable) rather than "confirmed not a document."

    Capped at `_MAX_FRONTMATTER_BYTES` so a giant document is never read
    whole for the sake of its `id`/`kind` fields, and decoded with
    `errors='replace'` rather than raising on a stray non-UTF-8 byte
    anywhere in the file — `str.read_text()`'s default strict decoding
    raised `UnicodeDecodeError`, which is a `ValueError` subclass, not an
    `OSError`, so it passed straight through the read guard that existed
    before this fix and crashed every render on the machine until someone
    found the one file (round 4, same issue).
    """
    try:
        lst = path.lstat()
    except OSError:
        return None, False
    if not stat.S_ISREG(lst.st_mode):
        return None, True
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None, False
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            return None, False
    except OSError:
        os.close(fd)
        return None, False
    try:
        with os.fdopen(fd, "rb") as f:
            raw = f.read(_MAX_FRONTMATTER_BYTES + 1)
    except OSError:
        return None, False
    truncated = len(raw) > _MAX_FRONTMATTER_BYTES
    text = raw[:_MAX_FRONTMATTER_BYTES].decode("utf-8", errors="replace")
    # `indexer_mod.parse_doc` reads every document through `Path.read_text()`,
    # whose text-mode open universal-newline-translates `\r\n` and a lone
    # `\r` to `\n` before `split_frontmatter` ever sees it. This read is
    # binary (so `lstat`/`fstat`/`O_NONBLOCK` above can do their job), so
    # nothing upstream of `split_frontmatter` has done that translation —
    # without it, a CRLF document's bytes start `---\r\n`, `split_frontmatter`
    # requires the literal delimiter `---\n`, and the same document that
    # parses fine through the indexer's own path reads back here as "no
    # frontmatter": exactly the divergence this whole scan exists to avoid,
    # since it is the disk-side check the index's own read is corroborated
    # against (round 6, issue_01M2HT8TM0M85WCQ594ADPMEFT). Applied in the same
    # order Python's own universal-newline mode does — CRLF pairs first, then
    # any remaining lone CR — so this can never disagree with what
    # `Path.read_text()` would have handed the indexer for the same bytes.
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    try:
        fm, _body, err = indexer_mod.split_frontmatter(text)
    except Exception:
        return None, False
    if err or not isinstance(fm, dict):
        if truncated:
            return None, False
        return None, True
    return fm, True


# The largest real document under the knowledge checkout measured 96399 bytes
# (projects/selector/decisions/0083-record-completeness-invariant.md,
# 2026-10-01). 1 MiB is roughly 11x that.
_MAX_SOURCE_BYTES = 1024 * 1024


def _guarded_read_bytes(path: Path, max_bytes: int) -> bytes | None:
    """`path`'s raw bytes, or None for anything this must not open at all: a
    symlink, FIFO, socket, device or directory, or a file past `max_bytes`.

    `lstat` before any `open` (refuses a symlink without ever calling
    `open(2)` on it), `O_NOFOLLOW | O_NONBLOCK` on the actual open (closes
    the lstat-to-open symlink-swap race and refuses a FIFO without blocking
    on it), `fstat` re-checking `S_ISREG` on the live descriptor. Used by
    `_guarded_existing_text`, which `plan_is_current` calls for an
    already-rendered target's bytes: the no-op comparison that decides
    whether `individuate()` ever signals `.profile-documents.json` current
    (security-reviewer, PR #740 round 5).
    """
    try:
        lst = path.lstat()
    except OSError:
        return None
    if not stat.S_ISREG(lst.st_mode):
        return None
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            return None
    except OSError:
        os.close(fd)
        return None
    try:
        with os.fdopen(fd, "rb") as f:
            raw = f.read(max_bytes + 1)
    except OSError:
        return None
    if len(raw) > max_bytes:
        return None
    return raw


def _guarded_existing_text(path: Path) -> str | None:
    """`path`'s on-disk text for `plan_is_current`'s byte-for-byte comparison
    against this call's plan, or None for anything `_guarded_read_bytes`
    refuses to open (a symlink, FIFO, or oversized file) or that fails to
    decode.

    Every caller treats None as "does not match the plan" — fail-closed to a
    real write, never to a falsely-confirmed no-op — the same posture
    `_profile_documents_match` already takes on malformed JSON. `plan`'s
    targets live under `agents_dir`/`skills_dir`/`claude_dir`, the exact
    worktree locations a prior, compromised dispatch into a reused worktree
    could have planted content in, and this comparison is what decides
    whether `individuate()` signals `.profile-documents.json` current without
    writing anything (security-reviewer, PR #740 round 5).
    """
    raw = _guarded_read_bytes(path, _MAX_SOURCE_BYTES)
    if raw is None:
        return None
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return None


def _known_ids_from_disk(projects_root: Path) -> dict[str, set[str]] | None:
    """The same shape as `all_agent_and_skill_ids()` — `{"agent": {ids},
    "skill": {ids}}` — but read straight from the knowledge checkout on disk
    under `projects_root` rather than the SQLite index.

    `_index_trust_problem` alone cannot catch a PARTIAL index: `full_scan_
    and_reconcile` (lib/knowledge/indexer.py) upserts one document per
    commit, so a render whose index read lands mid-reconcile can see a
    populated, trustworthy-looking index that still lacks the one id that
    matters (reproduced: a mid-reconcile index with both known-agent/skill
    sets non-empty still deleted a current, manifest-listed, untracked file).
    Absence from the index alone never proves a source document is gone —
    `_find_orphans` treats a candidate as undeclared anywhere only once this
    second, independent read agrees too (round 3, issue_01M2HT8TM0M85WCQ594ADPMEFT).

    Every file is read through `_frontmatter_from_disk` — `lstat`'d, opened
    `O_NOFOLLOW | O_NONBLOCK`, byte-capped, `errors='replace'`-decoded — so
    a FIFO dropped anywhere in this tree returns instead of hanging the
    render forever, and a stray non-UTF-8 byte is replaced instead of
    raising `UnicodeDecodeError` (round 4: both reproduced against round 3's
    plain `path.read_text()`, which neither guard covered). A file this read
    could not fully account for (`ok=False`) makes the WHOLE scan return
    `None`, exactly like `indexer.py` being unimportable or `projects_root`
    itself being unreadable below — this scan cannot enumerate what such a
    file would have declared, so it cannot prove any candidate elsewhere is
    absent either; a candidate's absence is only ever trusted when this scan
    fully succeeds. A file that reads fine but simply isn't a frontmatter
    document (`ok=True`, `frontmatter=None`) is the ordinary, legitimate
    "looked and found nothing" case and does not trigger this.

    Frontmatter is parsed with `indexer.split_frontmatter` (`_kb_indexer()`)
    — the exact split the indexer itself runs on every document — imported
    rather than reimplemented, so this can never silently disagree with what
    the indexer would actually do with the same text.

    Returns None when the check cannot be performed at all: `indexer.py`
    unimportable, `projects_root` missing, a read/list failure, or any file
    under it this scan could not fully read — a caller must refuse deletion
    on `None` rather than mistake "couldn't look" for "looked and found
    nothing" (an empty-but-successful scan is a legitimate result here,
    unlike the index-emptiness case `_index_trust_problem` guards against).
    """
    try:
        indexer_mod = _kb_indexer()
    except Exception:
        return None
    if not projects_root.is_dir():
        return None
    try:
        paths = list(projects_root.rglob("*.md"))
    except OSError:
        return None
    result: dict[str, set[str]] = {"agent": set(), "skill": set()}
    for path in paths:
        try:
            fm, ok = _frontmatter_from_disk(path, indexer_mod)
        except Exception:
            # Defensive backstop — every failure mode `_frontmatter_from_disk`
            # itself anticipates already returns (None, False) rather than
            # raising; this exists so a bad file's fallout can never be
            # anything worse than "the scan gives up," never a crash.
            return None
        if not ok:
            return None
        if fm is None:
            continue
        kind = fm.get("kind")
        doc_id = fm.get("id")
        if kind in result and isinstance(doc_id, str) and doc_id:
            result[kind].add(doc_id)
    return result


def _disk_trust_problem(disk_ids: dict[str, set[str]] | None) -> str | None:
    """None if `disk_ids` (from `_known_ids_from_disk`) is trustworthy enough
    to help clear a candidate for deletion; otherwise the reason it is not.

    Unlike `_index_trust_problem`, an empty result here is NOT itself
    suspicious — a knowledge checkout can legitimately declare zero agent or
    zero skill documents (a narrow project, or a test tree). Only a check
    that could not run at all (`None`) is a trust problem: the knowledge root
    is unset, missing, or unreadable, so a candidate's absence from the index
    can no longer be confirmed against this second source.
    """
    if disk_ids is None:
        return ("the knowledge checkout on disk could not be read to confirm "
                "a candidate's source document is absent")
    return None


def _read_previous_manifest(claude_dir: Path) -> set[str]:
    """Paths (relative to `claude_dir`) listed in the manifest THIS run is
    about to overwrite. Read before any part of the new plan is written, so a
    render can never grant itself permission to delete something by way of
    the very manifest it is about to produce. Missing or unreadable reads the
    same as empty — a candidate absent either way is left alone, matching
    "if no previous manifest exists, delete nothing."
    """
    manifest_path = claude_dir / _MANIFEST_NAME
    if not manifest_path.exists():
        return set()
    try:
        return {line for line in manifest_path.read_text().splitlines() if line}
    except OSError:
        return set()


def _is_contained_regular_file(candidate: Path, root_dir: Path) -> bool:
    """True iff `candidate` is a plain file — not a symlink itself, no
    symlink among the directory components between `root_dir` and it, and its
    realpath still resolves inside `root_dir`.

    A directory symlink planted at e.g. `.claude/skills/<name>` is exactly
    what `skills_dir.glob('*/SKILL.md')` traverses without complaint, so the
    glob alone cannot be trusted to have stayed inside the workspace — this
    check is what a caller uses before treating a globbed candidate as safe to
    touch.
    """
    try:
        st = candidate.lstat()
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    try:
        rel_parts = candidate.relative_to(root_dir).parts
    except ValueError:
        return False
    if root_dir.is_symlink():
        return False
    walked = root_dir
    for part in rel_parts[:-1]:
        walked = walked / part
        if walked.is_symlink():
            return False
    try:
        real_root = root_dir.resolve(strict=False)
        real_candidate = candidate.resolve(strict=False)
    except OSError:
        return False
    try:
        real_candidate.relative_to(real_root)
    except ValueError:
        return False
    return True


def _is_git_tracked(target_repo: Path, candidate: Path) -> bool:
    """True unless git POSITIVELY reports `candidate` as untracked in
    `target_repo`. Any other outcome — not a git repository, git missing, a
    timeout, an exit code neither 0 (tracked) nor 1 (git's own "did not match
    any file(s) known to git" signal) — fails closed to "tracked", since a
    deletion this check cannot clear must never proceed.
    """
    try:
        rel = str(candidate.relative_to(target_repo))
    except ValueError:
        return True
    try:
        result = subprocess.run(
            ["git", "-C", str(target_repo), "ls-files", "--error-unmatch", "--", rel],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return True
    if result.returncode == 1:
        return False
    return True


def _has_disk_check_candidate(
    agents_dir: Path, skills_dir: Path, planned: set[Path], known_ids: dict[str, set[str]],
) -> bool:
    """True iff at least one rendered agent/skill file is neither part of
    this render's plan nor known to the index — the only shape the
    knowledge-checkout disk walk (`_known_ids_from_disk`) could possibly
    change an outcome for. Every OTHER rendered file is either part of the
    plan (never a candidate at all) or already attributable through the
    index alone (`has_document` short-circuits `_find_orphans`'s `_consider`
    before the disk check ever matters), so walking the whole knowledge tree
    to answer a question that cannot change either of those is pure cost —
    measured at ~0.5s against today's corpus, paid on EVERY render
    regardless of whether anything on disk is actually unattributed (round
    4, issue_01M2HT8TM0M85WCQ594ADPMEFT). This check itself only globs
    `agents_dir`/`skills_dir` — the target repo's own small `.claude/` tree,
    not the knowledge checkout — so it costs nothing by comparison.
    """
    known_agent_slugs = {slug_from_id(i) for i in known_ids.get("agent", set())}
    known_skill_slugs = {slug_from_id(i) for i in known_ids.get("skill", set())}
    if agents_dir.exists():
        for p in agents_dir.glob("*.md"):
            if p.resolve() not in planned and p.stem not in known_agent_slugs:
                return True
    if skills_dir.exists():
        for p in skills_dir.glob("*/SKILL.md"):
            if p.resolve() not in planned and p.parent.name not in known_skill_slugs:
                return True
    return False


def _safe_slugs(ids: set[str]) -> set[str]:
    """`slug_from_id` for each id in `ids`, dropping any that fails the
    safety check rather than raising. Disk-sourced ids come from arbitrary
    frontmatter, not the validated index — an unsafe one (`slug_from_id`'s
    guard) must not crash the whole render over an unrelated malformed
    document; just don't trust it.
    """
    slugs: set[str] = set()
    for doc_id in ids:
        try:
            slugs.add(slug_from_id(doc_id))
        except SystemExit:
            continue
    return slugs


def _orphan_gate_reason(
    p: Path, has_document: bool, on_disk: bool, root_dir: Path,
    previous_manifest: set[str], claude_dir: Path, target_repo: Path,
) -> str | None:
    """`None` if `p` clears every per-file gate an orphan candidate must
    clear to be removed; otherwise the first reason it does not, in the
    same order `_find_orphans` always checked them:

    1. no document for it exists anywhere (index or disk)
    2. it is listed in the PREVIOUS `.materialized` manifest (`previous_manifest`)
    3. it is a plain file fully contained under `agents_dir`/`skills_dir`,
       with no symlink anywhere in its path (`_is_contained_regular_file`)
    4. it is not tracked by git in `target_repo` (`_is_git_tracked`)

    Shared by `_find_orphans` (the first pass, taken early in
    `individuate()`, before the dry-run print, the live-process pre-flight,
    and the fd chain) and `_reverify_removable` (the second pass, taken
    immediately before the actual delete) so the two can never silently
    diverge on what "removable" means — a candidate `_find_orphans` cleared
    is deleted only if THIS SAME check, re-run against fresh state, still
    clears it too (round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT).
    """
    if has_document:
        return "a document for it exists"
    if on_disk:
        return "source document exists on disk but is not yet reflected in the index"
    rel = str(p.relative_to(claude_dir))
    if rel not in previous_manifest:
        return "not listed in the previous individuation manifest"
    if not _is_contained_regular_file(p, root_dir):
        return "not a plain contained file — a symlink is in its path"
    if _is_git_tracked(target_repo, p):
        return "tracked by git in this repo"
    return None


def _stale_claude_md_gate_reason(
    p: Path, previous_manifest: set[str], claude_dir: Path, target_repo: Path,
) -> str | None:
    """`None` if a `CLAUDE.md` this render no longer composes may be
    removed; otherwise the first reason it may not.

    Gates 2 through 4 of `_orphan_gate_reason`, applied to the one file this
    tool deletes outside `agents_dir`/`skills_dir`. Gate 1 there asks whether
    a document for the file exists; the equivalent question here is whether
    this render composes any content for it, which the caller has already
    answered before calling this.

    Written as a separate function rather than by widening
    `_orphan_gate_reason` because the two differ in that first gate and in
    their root directory, and a shared function with a flag for each would
    read as one rule while being two. What must not differ is the ANSWER,
    so the gates below are in the same order and use the same helpers.
    """
    rel = str(p.relative_to(claude_dir))
    if rel not in previous_manifest:
        return "not listed in the previous individuation manifest"
    if not _is_contained_regular_file(p, claude_dir):
        return "not a plain contained file — a symlink is in its path"
    if _is_git_tracked(target_repo, p):
        return "tracked by git in this repo"
    return None


def _find_orphans(
    agents_dir: Path,
    skills_dir: Path,
    planned: set[Path],
    known_ids: dict[str, set[str]],
    disk_known_ids: dict[str, set[str]],
    previous_manifest: set[str],
    claude_dir: Path,
    target_repo: Path,
) -> tuple[list[Path], list[tuple[Path, str]]]:
    """Partition rendered agent/skill files with no document anywhere in the
    index OR on disk into (removable, blocked).

    The caller has already checked both `known_ids` (`_index_trust_problem`)
    and `disk_known_ids` (`_disk_trust_problem`) trustworthy. A candidate
    whose slug is known to EITHER source is not an orphan candidate at all —
    it is merely excluded by this profile's rules, still correctable through
    the KB, and left for `--force`'s ordinary clear+rewrite rather than
    reported here.

    A candidate absent from the index but present on disk (`disk_known_ids`)
    is a THIRD, distinct outcome from either of those: its document is real,
    just not yet reconciled into the index (round 3,
    issue_01M2HT8TM0M85WCQ594ADPMEFT) — reported as blocked, like any other
    per-file-gate failure, so `--force` preserves it rather than treating the
    reconcile gap as license to wipe and rewrite it.

    Everything else is a genuine orphan candidate, partitioned by
    `_orphan_gate_reason` — removable only when every gate clears, otherwise
    blocked with the first reason that failed and left untouched. This is a
    SNAPSHOT, taken once here, early in `individuate()` — see
    `_reverify_removable` for why the actual delete never trusts this
    partition on its own.
    """
    known_agent_slugs = {slug_from_id(i) for i in known_ids.get("agent", set())}
    known_skill_slugs = {slug_from_id(i) for i in known_ids.get("skill", set())}
    disk_agent_slugs = _safe_slugs(disk_known_ids.get("agent", set()))
    disk_skill_slugs = _safe_slugs(disk_known_ids.get("skill", set()))

    removable: list[Path] = []
    blocked: list[tuple[Path, str]] = []

    def _consider(p: Path, has_document: bool, on_disk: bool, root_dir: Path) -> None:
        if p.resolve() in planned:
            return
        reason = _orphan_gate_reason(
            p, has_document, on_disk, root_dir, previous_manifest, claude_dir, target_repo)
        if reason is None:
            removable.append(p)
        elif not has_document:
            # A candidate `has_document` excludes is not an orphan candidate
            # at all (still correctable through the KB) — never reported.
            blocked.append((p, reason))

    if agents_dir.exists():
        for p in sorted(agents_dir.glob("*.md")):
            _consider(p, p.stem in known_agent_slugs, p.stem in disk_agent_slugs, agents_dir)
    if skills_dir.exists():
        for p in sorted(skills_dir.glob("*/SKILL.md")):
            _consider(p, p.parent.name in known_skill_slugs,
                      p.parent.name in disk_skill_slugs, skills_dir)

    return removable, blocked


def _reverify_removable(
    removable: list[Path],
    agents_dir: Path,
    skills_dir: Path,
    known_ids: dict[str, set[str]],
    previous_manifest: set[str],
    claude_dir: Path,
    target_repo: Path,
) -> tuple[list[Path], list[tuple[Path, str]]]:
    """Re-run `_orphan_gate_reason` for each of `removable` — the same four
    gates `_find_orphans` used to mark them removable — one more time,
    immediately before `individuate()` actually deletes any of them.

    `_find_orphans`'s pass runs once, early in `individuate()`, well before
    the dry-run summary print, the live-process pre-flight, and the fd chain
    open — real time in which a source document for one of these candidates'
    slugs can land (a `kb_propose` merging, a reconcile completing) without
    this render ever looking again. The snapshot `removable` computed then
    is what fed the printed report and the no-op check; it must never be the
    thing that ACTUALLY authorizes a delete this far downstream
    (security-reviewer, round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT — a mid-
    render appearance of a candidate's source document was reproduced still
    getting deleted against the pre-round-5 code, which never looked again
    after the first pass).

    `known_ids` is REUSED exactly as `individuate()` received it, not
    re-queried from the index here: `known_ids` is always an injected
    parameter in this file (fetched once, by `main()`, immediately before
    calling `individuate()`), never fetched from inside `individuate()`
    itself — every test in this suite that exercises orphan detection
    relies on that seam to supply a synthetic index without a real
    `KB_INDEX_DB` behind it, and a fresh SQLite query from in here would
    break every one of them for a freshness gain of a few milliseconds.
    What this DOES freshly re-derive is the DISK side
    (`_known_ids_from_disk`) — the literal shape the round-5 finding names:
    a source document APPEARING ON DISK between `_find_orphans`'s snapshot
    and the actual delete, which only a fresh walk of the knowledge
    checkout can catch.

    Cheap here because it only ever examines `removable` itself — typically
    zero files on any render that isn't actively deleting an orphan, and the
    caller only invokes this at all when `removable` is non-empty. The one
    expensive part it repeats, the knowledge-tree disk walk, is the same
    ~0.5s `_has_disk_check_candidate` already gates the FIRST walk behind
    (round 4); this pays it a second time only on the render that is about
    to delete something, never on the common no-op path.
    """
    disk_result = _known_ids_from_disk(KNOWLEDGE / "projects")
    trust_problem = _disk_trust_problem(disk_result)
    if trust_problem is not None:
        return [], [
            (p, f"re-check immediately before deletion could not be trusted — {trust_problem}")
            for p in removable
        ]
    disk_known_ids = disk_result

    known_agent_slugs = {slug_from_id(i) for i in known_ids.get("agent", set())}
    known_skill_slugs = {slug_from_id(i) for i in known_ids.get("skill", set())}
    disk_agent_slugs = _safe_slugs(disk_known_ids.get("agent", set()))
    disk_skill_slugs = _safe_slugs(disk_known_ids.get("skill", set()))

    still_removable: list[Path] = []
    now_blocked: list[tuple[Path, str]] = []
    for p in removable:
        if p.parent == agents_dir:
            has_document = p.stem in known_agent_slugs
            on_disk = p.stem in disk_agent_slugs
            root_dir = agents_dir
        else:
            has_document = p.parent.name in known_skill_slugs
            on_disk = p.parent.name in disk_skill_slugs
            root_dir = skills_dir
        reason = _orphan_gate_reason(
            p, has_document, on_disk, root_dir, previous_manifest, claude_dir, target_repo)
        if reason is None:
            still_removable.append(p)
        else:
            now_blocked.append((p, f"no longer clears the gate at delete time: {reason}"))
    return still_removable, now_blocked


def _open_root_fd(
    root: Path, expected_stat: tuple[int, int] | None,
) -> tuple[int | None, str | None]:
    """`(fd, None)` — an owned, open `O_NOFOLLOW` descriptor for `root`
    itself — or `(None, error)`. The first link in the fd chain
    `_open_container_fd` extends: every directory this render opens after
    this one is opened RELATIVE to a descriptor already obtained this way,
    never by re-resolving a path from the filesystem root, so nothing
    between `root` and the descriptor a later call returns can be swapped to
    redirect it (round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT — see
    `_open_container_fd`'s docstring for the gap this closes).

    `root` here is `target_repo` — `Path.cwd()` as read in `main()`, which is
    the kernel's own already-resolved cwd (`getcwd(2)` returns a path with no
    symlink components), not a path this process built by joining strings.
    So a symlink anywhere along a path a caller might have typed to REACH
    `root` is already resolved away by the time `root` exists as a `Path`
    here — AT THE INSTANT it was resolved. `O_NOFOLLOW` on the open below
    still refuses `root` itself having become a symlink by the time this
    call runs, but it says nothing about an ANCESTOR of `root`: real work
    happens in `main()`/`individuate()` between that resolution and this
    open (the disk-corroboration walk chief among them), and if an ancestor
    directory is swapped for a symlink in that window, this open's path
    string resolves straight through it to whatever now sits at `root`'s
    name under the redirected tree — a real, non-symlink directory, so
    `O_NOFOLLOW` on the final component has nothing to refuse (round 6,
    issue_01M2HT8TM0M85WCQ594ADPMEFT).

    `expected_stat` is `(st_dev, st_ino)` for `root`, captured by `main()`
    immediately after `Path.cwd()` resolved it — the earliest possible
    instant, minimizing the window an ancestor swap has to land in. Once
    this open succeeds, `fstat` on the resulting fd is compared against it;
    a mismatch means `root`'s name now refers to a DIFFERENT real directory
    than the one this render was asked to touch, and the open is refused
    just as if `root` itself had been a symlink. `None` (only reachable
    internally, from `_reverify_removable`'s or a test's own direct calls
    where no such baseline was ever captured) skips the comparison — every
    caller reachable from `main()`'s `use` path always supplies one.

    This is deliberately a PIN, not a symlink refusal: an ancestor that was
    ALREADY a symlink before `main()` ever ran (an operator's own checkout
    legitimately living behind one, e.g. under a symlinked home directory)
    is exactly what `getcwd(2)` resolves away before `expected_stat` is ever
    captured, so it is accepted without complaint — the same directory,
    reached the same way, every time this render looks. Only a CHANGE
    introduced after that first look — the swap this render cannot see
    happen — is refused.
    """
    try:
        fd = os.open(str(root), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as e:
        return None, f"cannot open {root}: {e}"
    if expected_stat is not None:
        try:
            st = os.fstat(fd)
        except OSError as e:
            os.close(fd)
            return None, f"cannot stat opened {root}: {e}"
        if (st.st_dev, st.st_ino) != expected_stat:
            os.close(fd)
            return None, (
                f"{root} no longer identifies the directory this render was "
                f"asked to touch — an ancestor was swapped after cwd was resolved"
            )
    return fd, None


def _open_container_fd(parent_fd: int, name: str, create: bool) -> tuple[int | None, str | None]:
    """`(fd, None)` — an owned, open `O_NOFOLLOW` descriptor for `name`, a
    DIRECT CHILD of `parent_fd` — or `(None, error)` naming why it could not
    be opened as a real directory this render owns.

    THE CHECK AND THE OPEN ARE THE SAME OPERATION (`O_NOFOLLOW`), not a
    `Path.is_symlink()` check followed later by a separate open — the same
    reasoning `session_files.py`'s module docstring gives at length: a
    verdict from a check made now describes a filesystem state that can
    change before a later open runs. `individuate()` still keeps its OWN
    `is_symlink()` check at function entry, for the ordinary case (fast,
    fails before any of this render's slower work runs at all) — this
    function is the second, LATE binding: called immediately before the
    force-clear / unlink / write phase begins, so the fd it returns is
    unaffected by anything that happened in between, including the
    knowledge-tree disk-corroboration walk. Every later write, unlink, and
    directory-clear for `name` in this render goes through the returned fd
    (`dir_fd=`), never by re-opening a path again — the container-swap-then-
    write race the security reviewer demonstrated (park a render on a
    blocking read, swap the container for a symlink, release it) needs a
    SECOND path-based open somewhere after the swap to succeed; there is no
    longer one (round 4, issue_01M2HT8TM0M85WCQ594ADPMEFT). Confirmed
    empirically before writing this: on this platform, a write attempted
    through a dir_fd whose directory was `rmdir`'d out from under it fails
    closed (`ENOENT`) rather than reaching whatever now sits at the path —
    the fd does not silently follow the swap.

    OPENED RELATIVE TO `parent_fd`, NEVER BY PATH — the fix round 5 adds.
    Round 4's version opened `<target_repo>/.claude/agents` by joining and
    re-resolving the whole PATH from the filesystem root, and `O_NOFOLLOW`
    only refuses the open when the FINAL path component (`agents`) is
    itself a symlink; it says nothing about `.claude`, an ancestor
    component, so swapping `.claude` for a symlink defeated every fd-based
    protection downstream with no race needed at all — the open just
    followed the swapped parent and returned a valid descriptor for
    whatever an attacker pointed it at (security-reviewer, round 5). Taking
    an already-opened, already-`O_NOFOLLOW`-verified `parent_fd` and
    resolving `name` against ITS inode (`dir_fd=parent_fd`) closes that:
    the kernel never re-walks a path string, so nothing between the
    original root and `parent_fd` can be swapped after the fact to
    redirect this open. `individuate()` builds the full chain this way —
    `target_repo` (`_open_root_fd`) → `.claude` → `agents`/`skills` — so
    `.claude` itself is proven non-symlink by the same mechanism as
    `agents`/`skills` always were, not merely checked once by path earlier.

    `create=True` makes `name` first if missing (a single `os.mkdir`, not
    `parents=True` — nothing under `parent_fd` needs more than one level
    here). The mkdir and the open are adjacent calls with nothing of this
    render's slower work between them, so the only window left for a
    symlink to land there is a few back-to-back syscalls, and `O_NOFOLLOW`
    still refuses the open even then. `create=False` with a missing `name`
    returns `(None, None)` — nothing to protect or write, not an error.
    """
    if not create:
        try:
            os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except OSError:
            return None, None
    try:
        os.mkdir(name, dir_fd=parent_fd)
    except FileExistsError:
        pass
    except OSError as e:
        return None, f"cannot create {name}: {e}"
    try:
        return os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                       dir_fd=parent_fd), None
    except OSError as e:
        return None, f"cannot open {name}: {e}"


def _clear_dir_preserving_fd(dir_fd: int | None, preserve_children: set[str]) -> None:
    """Remove every direct child of the directory `dir_fd` refers to except
    those named in `preserve_children` (matched by name — an agent's
    filename, or a skill's directory name) — entirely through `dir_fd`,
    never by re-opening the container's path, so a container swapped for a
    symlink at any point after `dir_fd` was opened (`_open_container_fd`,
    called once per render before this and every other write below) cannot
    redirect a single removal.

    Used by `--force` in place of a blanket `shutil.rmtree(d)`, so a
    manifest-blocked orphan (git-tracked, absent from the previous manifest,
    or reached only through a symlink) survives force's clear+rewrite exactly
    as it survives the non-force conflict/unlink path — `co -r` runs `use
    daytime --force`, so force is the render most sessions actually take.

    A symlinked child (the `.claude/skills/<name>` attack `_is_contained_
    regular_file` guards against elsewhere) is removed by unlinking the link
    itself rather than by recursing into it, so the directory it points to is
    never touched. `dir_fd=None` (the container never existed and this
    render never created it — see `_open_container_fd`) is a no-op.
    """
    if dir_fd is None:
        return
    with os.scandir(dir_fd) as it:
        entries = list(it)
    for entry in entries:
        if entry.name in preserve_children:
            continue
        if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
            os.unlink(entry.name, dir_fd=dir_fd)
        else:
            child_fd = os.open(entry.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                dir_fd=dir_fd)
            try:
                _clear_dir_preserving_fd(child_fd, set())
            finally:
                os.close(child_fd)
            os.rmdir(entry.name, dir_fd=dir_fd)


def _unlink_orphan_fd(orphan: Path, agents_dir: Path, skills_dir: Path,
                       agents_fd: int, skills_fd: int) -> None:
    """Unlink a removable orphan through the container fd `individuate()`
    already opened (`_open_container_fd`) — the non-force counterpart to
    `_clear_dir_preserving_fd`, with the same fd-bound guarantee. An agent
    file is a direct child of `agents_fd`; a skill's `SKILL.md` sits one
    level down inside its own slug subdirectory, opened through `skills_fd`
    for the removal and closed again once done — if that leaves the slug
    directory empty, the directory itself is removed too, matching the
    path-based version's behavior.
    """
    if orphan.parent == agents_dir:
        os.unlink(orphan.name, dir_fd=agents_fd)
        return
    slug = orphan.parent.name
    slug_fd = os.open(slug, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=skills_fd)
    try:
        os.unlink(orphan.name, dir_fd=slug_fd)
        empty = not os.listdir(slug_fd)
    finally:
        os.close(slug_fd)
    if empty:
        try:
            os.rmdir(slug, dir_fd=skills_fd)
        except OSError:
            pass


def _write_regular_relative(dir_fd: int, name: str, content: str) -> bool:
    """Write `content` to `name` inside `dir_fd`, returning True iff bytes
    were written — False for an idempotent no-op, the same behavior the
    path-based writer always had.

    Bound to `dir_fd` rather than a re-opened path — containment of the
    DIRECTORY component is `dir_fd`'s job, established once by
    `_open_container_fd` before any of this render's writes begin.
    `O_NOFOLLOW` on both opens refuses a symlink planted at the LEAF itself.
    The read-back is capped at one byte past the new content's own length:
    if that many bytes come back, the existing file is provably longer than
    the new content and cannot match, so nothing past that point is ever
    read — a stray, arbitrarily large existing file is never read whole
    just to learn it differs.
    """
    content_bytes = content.encode("utf-8")
    try:
        rfd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
    except OSError:
        rfd = None
    if rfd is not None:
        try:
            cap = len(content_bytes) + 1
            existing = os.read(rfd, cap)
        finally:
            os.close(rfd)
        if len(existing) < cap and existing == content_bytes:
            return False
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644,
                 dir_fd=dir_fd)
    with os.fdopen(fd, "wb") as f:
        # A buffered file object, not a raw `os.write(fd, ...)` — the latter
        # is not guaranteed to write every byte in one call (POSIX `write(2)`
        # may return a short count), where `f.write()` loops until it has
        # written all of `content_bytes` or raises.
        f.write(content_bytes)
    return True


def collect_matches(profile: dict) -> tuple[list[dict], list[dict]]:
    """Return (rows, per-rule match counts) for a profile the Library resolved.

    The counts are the Library's, `{"position", "matches"}` in rule order, and
    feed individuation telemetry: a rule matching 0 docs is dead; one dominating
    the total is over-broad. Each body comes from `GET /reference/documents/{id}`.
    A body whose hash differs from the one the profile listed is refused: the
    profile and the bodies are read at two moments, and a change between them
    must not render."""
    docs = []
    for listed in profile["documents"]:
        doc_path = "/reference/documents/" + urllib.parse.quote(listed["id"])
        doc = _library_request("GET", doc_path)
        if doc.get("body_sha256") != listed.get("body_sha256"):
            raise BundleRefused(
                f"the Library changed {listed['id']} between the profile and its body")
        _verified_document(doc)
        docs.append(doc)
    rows, _ = library_rows(docs)
    return rows, profile["rules"]


def _library_profile_rows(profile: dict) -> tuple[list[dict], list[dict]]:
    """`collect_matches`, with a refused Library a named stop: nothing was written."""
    try:
        return collect_matches(profile)
    except BundleRefused as e:
        die(f"refusing to render from the Library: {e}. NOTHING WAS WRITTEN. The "
            f"Library is the only source of a render (platform/decisions/0085).",
            code=LIBRARY_REFUSED)


# --- the Library's bundle (issue_01M2MAP3X0Q1BQW06AV8204CFW) ---
#
# platform/decisions/0085: a dispatched agent is individuated with the bundle
# the Library scopes to it, not with the whole profile. Two calls on the
# Library's loopback service: POST /bundles issues a single-use token naming the
# documents, POST /bundles/redeem returns them with bodies.
#
# THERE IS NO FALLBACK TO THE LOCAL INDEX, and that is the design. A render
# that quietly reverted to the profile when the Library was down would fire
# exactly when nobody is watching and hand a dispatched agent the wide,
# possibly-stale preamble this exists to end (`start-overnight` was rendered
# into thirteen workspaces after its source was deleted). The Library is a
# launchd job with KeepAlive, so a restart window is one realistic outage, but
# not the only one seen: contention with another dispatch's bundle render is
# also observed (19.7s on 2026-09-22, issue_01M35DC5TJY5ZXM8MRZKPAWJDD), so a
# refusal here must not assert which one occurred. Every refusal below names
# the Library and states only what this client observed.
LIBRARY_CLIENT_TOKENS = Path.home() / ".library" / "client-tokens.json"
LIBRARY_CLIENT_NAME = "bosun"
# 60s: a bundle render can wait behind another dispatch's concurrent render
# (19.7s measured 2026-09-22, which a 15s timeout refused). Not derived from a
# measured distribution of render times — raised past the one measured
# failure with headroom. The bound exists so a wedged Library cannot hang a
# dispatch indefinitely; if it needs to rise again, say what it's protecting
# against rather than just moving the number.
LIBRARY_TIMEOUT_SECONDS = 60
# Exit code for a render the Library refused or could not serve. Distinct from
# the 1 a generic crash gives, so a caller can tell "the Library said no" apart.
LIBRARY_REFUSED = 6


class BundleRefused(Exception):
    """The Library refused a bundle, or could not be asked. `status` is the HTTP
    status, None when there was no answer at all; `error` is the Library's own
    `error` string, which is what a caller branches on."""

    def __init__(self, message: str, status: int | None = None, error: str = ""):
        super().__init__(message)
        self.status = status
        self.error = error


def _library_open(req: urllib.request.Request):
    """The one place this file touches the network, so tests replace exactly it.
    `urlopen` rather than a private opener: importing `vault_plane` (below) has
    installed the process default that refuses a redirect carrying the token."""
    return urllib.request.urlopen(req, timeout=LIBRARY_TIMEOUT_SECONDS)


def _vault_plane():
    """`vault_plane`, imported on first use and only by a per-agent render.
    Its import parses `VAULTS_ON_LIBRARY` and refuses a cleartext
    `LIBRARY_BASE_URL`, and a crew session's `use` must not be able to fail on
    either, since it never calls the Library."""
    try:
        import vault_plane
    except Exception as e:  # noqa: BLE001 - its refusals are RuntimeError/SystemExit
        raise BundleRefused(f"cannot address the Library: {e}") from e
    return vault_plane


def _library_token() -> str:
    """The `bosun` client credential. Never included in a message or a log."""
    try:
        tokens = json.loads(LIBRARY_CLIENT_TOKENS.read_text())
    except (OSError, ValueError) as e:
        raise BundleRefused(
            f"cannot read the Library credential at {LIBRARY_CLIENT_TOKENS}: "
            f"{type(e).__name__}") from e
    if isinstance(tokens, dict):
        for token, entry in tokens.items():
            if isinstance(entry, dict) and entry.get("name") == LIBRARY_CLIENT_NAME:
                return token
    raise BundleRefused(
        f"{LIBRARY_CLIENT_TOKENS} has no client named {LIBRARY_CLIENT_NAME!r}")


def _library_request(method: str, path: str, body: dict | None = None) -> dict:
    """One call to the Library. `body` is sent as JSON when given, so a POST
    names its payload and a GET names none."""
    vp = _vault_plane()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        vp.library_url(path), data=data, method=method,
        headers=vp.library_headers(_library_token(), json_body=body is not None))
    try:
        with _library_open(req) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read() or b"null")
        except ValueError:
            detail = None
        error = str(detail.get("error", "")) if isinstance(detail, dict) else ""
        raise BundleRefused(
            f"the Library refused {method} {path}: HTTP {e.code} {error or e.reason}",
            status=e.code, error=error) from e
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        # urlopen surfaces a timeout two ways: a bare TimeoutError (raised
        # after the connection opens, e.g. during read()) or a URLError whose
        # .reason is one (raised while opening the connection). Same for a
        # refused connection. Check the underlying cause either way; assert
        # only what it says, never a restart or other cause it did not report.
        cause = e.reason if isinstance(e, urllib.error.URLError) else e
        if isinstance(cause, TimeoutError):
            raise BundleRefused(
                f"the Library did not answer {method} {path} within "
                f"{LIBRARY_TIMEOUT_SECONDS}s") from e
        if isinstance(cause, ConnectionRefusedError):
            raise BundleRefused(
                "nothing is listening at the Library's address") from e
        raise BundleRefused(
            f"the Library is unreachable ({type(cause).__name__}: {cause})") from e
    try:
        data = json.loads(raw)
    except ValueError as e:
        raise BundleRefused(f"the Library answered {method} {path} with non-JSON") from e
    if not isinstance(data, dict):
        raise BundleRefused(f"the Library answered {method} {path} with a non-object")
    return data


def _library_post(path: str, body: dict) -> dict:
    return _library_request("POST", path, body)


def fetch_bundle(agent: str, *, repo: str, variant: str,
                 item_id: str | None = None) -> tuple[list[dict], dict, str]:
    """Issue and redeem one bundle. Returns (documents, scope, scope_note).

    Scoped to agent+item when `item_id` is given and the Library has a profile
    for that item's product, otherwise agent+repo. The item scope is tried
    first because it is the precise one (decision 0085); a 422 `no profile ...`
    is the one refusal that falls through to the repo scope, since it says the
    item's PRODUCT has no profile (`bosun` has none, so every dispatch for a
    bosun item would otherwise be refused) and says nothing about the agent.
    Any other refusal, including a 409, ends the render: nothing degrades to a
    smaller bundle."""
    note = f"agent+repo ({repo}/{variant})"
    issued = None
    if item_id:
        try:
            issued = _library_post("/bundles", {"agent": agent, "item_id": item_id,
                                                "variant": variant})
            note = f"agent+item ({item_id})"
        except BundleRefused as e:
            if e.status != 422 or not e.error.startswith("no profile"):
                raise
            note = (f"agent+repo ({repo}/{variant}); the item scope was refused: "
                    f"{e.error}")
    if issued is None:
        issued = _library_post("/bundles", {"agent": agent, "repo": repo,
                                            "variant": variant})
    token_id = issued.get("token_id")
    if not isinstance(token_id, str) or not token_id:
        raise BundleRefused("the Library issued a bundle with no token_id")
    redeemed = _library_post("/bundles/redeem", {"token_id": token_id})
    docs = redeemed.get("documents")
    if not isinstance(docs, list) or redeemed.get("count") != len(docs):
        raise BundleRefused("the Library's bundle is malformed: document count mismatch")
    return docs, redeemed.get("scope") or {}, note


# A rendered agent's or skill's `description:` is the text Claude Code reads to
# decide when to fire it. `_rendered_description` passes every source through
# this bound: one line, printable, at most 500 characters. The bound limits
# shape, not content; see `library_rows` for why this one field arrives
# unverified.
_TRIGGER_MAX = 500


def _bounded_trigger(value: object) -> str:
    if not isinstance(value, str):
        return ""
    flat = " ".join(value.split())
    flat = "".join(ch for ch in flat if ch.isprintable())
    return flat[:_TRIGGER_MAX]


def _verified_document(doc: dict) -> None:
    """Refuse a Library document that is not what it claims: a field missing, or a
    body that does not hash to its own `body_sha256`. Every document the Library
    serves reaches a render through here."""
    for key in ("id", "source_ref", "kind", "title", "body", "body_sha256"):
        if not isinstance(doc.get(key), str):
            raise BundleRefused(f"the Library's document has no {key!r}")
    if hashlib.sha256(doc["body"].encode("utf-8")).hexdigest() != doc["body_sha256"]:
        raise BundleRefused(
            f"the Library's document {doc['id']} does not match its own body_sha256")


def library_rows(docs: list[dict]) -> tuple[list[dict], list[str]]:
    """Turn verified Library documents, bodies included, into rows `individuate`
    renders. Returns `(rows, untriggered_skill_ids)`; the second element is what
    makes a silently-degraded skill observable, and `render_source` puts it on the
    individuation telemetry for a bundle.

    `trigger` comes from the Library (`doc_dict` serves it on agents and skills,
    convivy/library#211). The body hash does not cover it, so nothing verifies it
    against the document; it becomes the `description:` every session loads, and
    `_bounded_trigger` is what keeps it one line of printable text.

    A skill with no trigger renders a body-derived description, which says what the
    skill is about rather than when to fire it. That is recorded, not only printed:
    the stderr line is discarded on a successful render.
    """
    rows: list[dict] = []
    untriggered: list[str] = []
    for doc in docs:
        fm: dict = {}
        if doc["kind"] == "agent":
            fm = {k: doc.get(k) for k in ("tools", "model") if doc.get(k)}
            fm["trigger"] = _bounded_trigger(doc.get("trigger"))
        elif doc["kind"] == "skill":
            fm = {"trigger": _bounded_trigger(doc.get("trigger")) or None}
            if not fm["trigger"]:
                untriggered.append(doc["id"])
                sys.stderr.write(
                    f"knowledge-ctx: no trigger for skill {doc['id']} in the Library's "
                    f"document; its description is derived from the body\n")
        rows.append({"id": doc["id"], "source_ref": doc["source_ref"], "kind": doc["kind"],
                     "project": doc.get("project", ""), "title": doc["title"],
                     "body": doc["body"],
                     "_bundle": {"fm": fm, "body": doc["body"].rstrip() + "\n",
                                 "body_sha256": doc["body_sha256"]}})
    rows.sort(key=lambda r: r["id"])
    return rows, untriggered


def bundle_rows(docs: list[dict], agent: str) -> tuple[list[dict], list[str]]:
    """Turn a redeemed bundle into rows `individuate` renders, refusing one that
    is not what it claims. Returns `(rows, untriggered_skill_ids)`.

    Three refusals, each because a wrong bundle renders as a normal-looking
    `.claude/`: a body that does not hash to its `body_sha256`, a bundle with
    a definition for any agent but the one dispatched (decision 0085: no agent
    receives another agent's definition), and one with no definition for it."""
    own = 0
    for doc in docs:
        _verified_document(doc)
        if doc["kind"] == "agent":
            if slug_from_id(doc["id"]) != agent:
                raise BundleRefused(
                    f"the Library's bundle for {agent} carries the definition of "
                    f"{doc['id']}; no agent receives another agent's definition")
            own += 1
    if own != 1:
        raise BundleRefused(
            f"the Library's bundle for {agent} carries {own} agent definitions, expected 1")
    return library_rows(docs)


def _is_spawn_owned_worktree(cwd: Path) -> bool:
    """True when `cwd`'s `.git` is a pointer file naming a path under a
    `.git/worktrees/` directory, which is where git puts a LINKED worktree's
    gitdir and is the one kind of tree `agentctl spawn` creates and owns.

    ANYTHING ELSE ANSWERS FALSE AND GETS THE WHOLE PROFILE RENDER, and the
    asymmetry is the point rather than a default. Answering "not spawn-owned"
    wrongly costs a wide render of documents the agent will not read. Answering
    "spawn-owned" wrongly takes a narrowing `--force` render through a tree
    somebody is working in and deletes their `.claude/agents` and
    `.claude/skills`. `worktrees.is_primary_checkout` states the same asymmetry
    for the same dispatch path; this mirrors it rather than inventing a second
    rule.

    THIS DOCSTRING DELIBERATELY DOES NOT LIST WHICH TREE SHAPES IT ACCEPTS.
    Four earlier versions did, and every one of the four shipped a claim the
    predicate did not have — each review round found another shape the list had
    missed (an absent `.git`, a submodule, a submodule under a `worktrees/`
    path, a submodule inside a linked worktree), and correcting the list one
    member at a time is what kept it wrong. The list was the defect, not any
    particular entry in it. What is written here is the test itself; a reader
    who needs to know how a given tree answers should run the predicate on it.

    The substring test is weaker than resolving the pointer with git, and that
    is a deliberate trade: `git rev-parse --git-common-dir` would answer
    structurally but puts a subprocess on the dispatch path. A tree crafted to
    satisfy the substring while pointing elsewhere has to be authored on
    purpose, and no tool here creates one.
    """
    dot_git = cwd / ".git"
    try:
        if not dot_git.is_file():
            return False
        with dot_git.open("rb") as fh:
            head = fh.read(4096)
    except OSError:
        return False
    try:
        text = head.decode("utf-8")
    except UnicodeDecodeError:
        return False
    line = text.splitlines()[0] if text.splitlines() else ""
    if not line.startswith("gitdir:"):
        return False
    target = line[len("gitdir:"):].strip()
    if not target:
        return False
    # `.git/worktrees/` rather than a parent named `worktrees`: a submodule at
    # path `worktrees/<name>` points at `.git/modules/worktrees/<name>`, whose
    # parent is `worktrees` too. Compared with forward slashes on the raw
    # pointer, which is what git writes on every platform this runs on.
    return "/.git/worktrees/" in target.replace("\\", "/")


def render_source(profile: dict, project: str, args, cwd: Path) -> tuple[list[dict], list[dict]]:
    """The documents this render individuates, and the telemetry that says how
    they were chosen (issue_01M2MAP3X0Q1BQW06AV8204CFW, decision 0085).

    THREE CASES, and only the middle one is new:

    * No `--agent`: a crew (`co`) session. It is not one agent and needs the
      crew's whole set, so it keeps the profile render, unchanged.
    * `--agent` into a PRIMARY checkout (`.git` is a directory): the profile
      render too, with a notice. `agentctl spawn` resolves `planner` and
      `curator` (no dedicated worktree) into the operator's own clone, and a
      narrowed `--force` render there would delete the sibling agents and skills
      out from under the co session working in it. A per-agent render is only
      safe in a tree spawn owns, which is a linked worktree (`.git` is a file).
    * `--agent` into a linked worktree: the agent's bundle from the Library.
      Refused, never degraded, when the Library refuses or is down.
    """
    if not args.agent:
        return _library_profile_rows(profile)
    if not _is_spawn_owned_worktree(cwd):
        sys.stderr.write(
            f"knowledge-ctx: {cwd} is not a linked worktree spawn owns; rendering "
            f"the whole profile rather than {args.agent}'s bundle, so a session "
            f"working here keeps its files\n")
        return _library_profile_rows(profile)
    try:
        docs, scope, note = fetch_bundle(
            args.agent, repo=project, variant=args.profile, item_id=args.issue)
        rows, untriggered = bundle_rows(docs, args.agent)
    except BundleRefused as e:
        die(f"refusing to render {args.agent}: {e}. NOTHING WAS WRITTEN. The Library is "
            f"the only source for a dispatched render; there is no fallback to the "
            f"local index (platform/decisions/0085).", code=LIBRARY_REFUSED)
    sys.stderr.write(f"knowledge-ctx: {args.agent} bundle from the Library, scoped "
                     f"{note}: {len(rows)} documents\n")
    rule: dict = {"bundle": scope, "scope": note, "agent": args.agent}
    if untriggered:
        # Carried so the degrade is visible in telemetry rather than only on a
        # stderr stream the success path throws away (reviewer, #630).
        rule["untriggered_skills"] = untriggered
    return rows, [{"rule": rule, "matches": len(rows)}]


# --- instruction blocks (issue_01M2PXHKZ3SE1AQPS8MWWT691X) ---
#
# A `kind: instruction-block` document states one rule and carries, in
# `frontmatter_extra`, who must obey it: `scope` (fleet/crew/agent/task —
# `INSTRUCTION_BLOCK_SCOPES` in lib/knowledge/knowledge.py, composition order
# only, never override order — the assembly epic's steward ruling,
# issue_01M2MBQ8Q7YX34DDF8H9YM5T58 comment 2807, is that a `fleet` block is
# never overridden by a narrower one) plus zero or more of `binds_crews`,
# `binds_agents`, `binds_sessions`, `binds_topics`. `scope: fleet` carries
# none of those and binds every session.
#
# Mirrors lib/knowledge/knowledge.py's `INSTRUCTION_BLOCK_SCOPES` — copied
# rather than imported, on the same either-side-of-the-deployed-lib-seam
# basis as `_MANIFEST_NAME`/`_PROFILE_DOCUMENTS_NAME` above: this script can
# itself be the repo's working copy or the deployed `~/.local/bin` one, and
# importing `lib/knowledge`'s `knowledge` module by name risks resolving the
# DEPLOYED copy even from a feature branch — the exact hazard `_kb_indexer()`'s
# own docstring describes for `indexer.py`. Pinned equal to the source by
# `test_instruction_block_scopes_matches_the_knowledge_module`.
INSTRUCTION_BLOCK_SCOPES = ("fleet", "crew", "agent", "task")


def fetch_instruction_blocks() -> list[dict]:
    """Every `kind='instruction-block'` row in the index, ANY status — not
    filtered to `current` in SQL, so `resolve_instruction_blocks` can tell a
    block this session must obey but whose status has moved out from under
    it (fail closed) apart from one this session was simply never going to
    receive (silently absent, and rightly so).

    REQUIRES THE `/instruction-blocks/` PATH AS WELL AS THE KIND, so that what
    is composed into a session's CLAUDE.md and what the write-side guard
    protects are the same set. Without it, `kind` alone decides what every bound
    session obeys while `kb_writes.PR_ONLY_SEGMENTS` guards a path, and the gap
    is reachable: a document at `projects/platform/decisions/0099-foo.md`
    carrying `kind: instruction-block` and `scope: fleet` passes every
    validator, is not a guarded path, takes an `in-session` direct write to main
    unreviewed, and is composed into every bound session.

    THE CLAUSE MATCHES ON `source_ref`, NOT ON `id`, AND THAT DISTINCTION IS THE
    WHOLE CONTROL. `source_ref` is the repo-relative path the indexer records
    from where the file actually sits (`indexer.py`: `fm["source_ref"] = str(rel)`)
    and is the same string `is_pr_only` checks. `id` is a FRONTMATTER field the
    author writes, validated only against `ID_PATTERN` and never checked against
    the file's real location — so an `id` of
    `platform/instruction-blocks/evil-block` on a file written to
    `projects/platform/decisions/0099-foo.md` satisfies an `id`-based clause
    while the write guard sees an unguarded path. That costs an attacker one
    frontmatter line. An earlier version of this filter matched on `id` and was
    bypassed exactly that way (security review, PR #616, round 2).

    `resolve_agent` is NOT the precedent to copy here, though it looks like one:
    it selects on `id LIKE '%/agents/%'`, which carries this same divergence."""
    conn = _conn()
    try:
        sql = ("SELECT id, project, status, body, body_hash, frontmatter_extra "
               "FROM docs WHERE kind = 'instruction-block' "
               "AND source_ref LIKE '%/instruction-blocks/%'")
        return [dict(row) for row in conn.execute(sql).fetchall()]
    finally:
        conn.close()


def _instruction_block_frontmatter(row: dict) -> dict:
    """The parsed `frontmatter_extra` for one instruction-block row.

    Dies (fail closed) rather than returning `{}` on anything this cannot
    read — a block whose selectors cannot be parsed must never fall back to
    looking like `scope: fleet` (no selectors, binds every session), which is
    exactly what treating unreadable frontmatter as `{}` would do.
    """
    raw = row.get("frontmatter_extra") or "{}"
    try:
        fm = json.loads(raw)
    except (TypeError, ValueError) as e:
        die(f"instruction-block {row.get('id')!r} has unreadable "
            f"frontmatter_extra, cannot resolve its selectors: {e}")
    if not isinstance(fm, dict):
        die(f"instruction-block {row.get('id')!r} frontmatter_extra is not "
            f"a JSON object: {raw!r}")
    return fm


def _instruction_block_mismatch(
    fm: dict, *, crew: str | None, agent: str | None, session_kind: str,
    topics: frozenset[str] = frozenset(),
) -> str | None:
    """Why a session shaped this way does NOT bind a block carrying selector
    fields `fm`, or None when it binds.

    `_instruction_block_binds` is `mismatch is None`, and the manifest's
    `writing_standards` record prints this same string, so what a session was
    told about a block and what the render did with it cannot disagree.

    Every selector field the block carries must match, AND across fields, and
    within one field any listed value is enough, OR within a field. That is the
    steward's ruling on how selectors combine (assembly epic
    issue_01M2MBQ8Q7YX34DDF8H9YM5T58, comment 2808): read as OR across fields, a
    block carrying both `binds_agents: [reviewer]` and
    `binds_sessions: [interactive]` would bind every reviewer AND every
    interactive session instead of their intersection. A field the block does
    not carry places no constraint of its own. `scope: fleet` carries no
    selector field at all and binds every session, checked first because an
    ABSENT `binds_*` list must place no constraint regardless of scope.

    Two agent selectors, per the operator's ruling of 2026-09-24 (issue
    issue_01M3ABW3HN0J8N154YZMM8Y6G5, comment 4099) following the approved
    instruction-block specification (issue_01M2MC21YAWT2V61QWSM247VRX):

    - `binds_roles` selects by the agent's declared role, the `role:` its
      document declares (`agent_roles.role_for`, read from the same index as
      the blocks), never by its bare id.
    - `binds_agents` selects an exact agent name.

    `role_for` returning `None` (no document, or one declaring no role) fails
    CLOSED for `binds_roles`: an agent with no declared role matches no
    role-selected block. Roster instance ids and roles are different
    vocabularies, so nothing here derives one from the other.
    """
    if fm.get("scope") == "fleet":
        return None

    crews = fm.get("binds_crews") or []
    if crews and crew not in crews:
        return f"crew {crew!r} is not in the block's binds_crews"

    roles = fm.get("binds_roles") or []
    agents = fm.get("binds_agents") or []
    if agent is None and (roles or agents):
        return "no agent is named, and the block selects by agent"

    role: str | None = None
    if agent is not None and roles:
        try:
            role = agent_roles.role_for(agent, db_path=DB_PATH)
        except agent_roles.AgentRoleError as e:
            # A refusal, never None: None reads as "no declared role", which
            # fails closed, so the render would drop every role-selected block
            # for this agent and still look successful.
            die(str(e))

    if roles:
        if role is None:
            return f"agent {agent!r} declares no role, so no binds_roles block binds it"
        if role not in roles:
            return f"role {role!r} is not in the block's binds_roles"

    if agents and agent not in agents:
        return f"agent {agent!r} is not in the block's binds_agents"

    sessions = fm.get("binds_sessions") or []
    if sessions and session_kind not in sessions:
        return f"the block binds {'/'.join(sessions)} sessions only, this one is {session_kind}"

    topics_sel = fm.get("binds_topics") or []
    if topics_sel and not (set(topics_sel) & set(topics)):
        return "none of the block's binds_topics is among this session's topics"

    return None


def _instruction_block_binds(
    fm: dict, *, crew: str | None, agent: str | None, session_kind: str,
    topics: frozenset[str] = frozenset(),
) -> bool:
    """True iff a session shaped this way must obey a block carrying selector
    fields `fm`. The rules and their reasons are in `_instruction_block_mismatch`."""
    return _instruction_block_mismatch(
        fm, crew=crew, agent=agent, session_kind=session_kind,
        topics=topics) is None


def resolve_instruction_blocks(
    rows: list[dict], *, crew: str | None, agent: str | None, session_kind: str,
    topics: frozenset[str] = frozenset(), include_fleet: bool = True,
) -> list[dict]:
    """The instruction blocks this session must obey, in composition order —
    `fleet`, `crew`, `agent`, `task` (`INSTRUCTION_BLOCK_SCOPES` in
    lib/knowledge/knowledge.py) — each row carrying its parsed frontmatter
    under `_fm`.

    Fails closed: a block whose selectors bind this session but whose
    `status` is not `current` — or whose scope this render cannot place in
    composition order — stops the whole render rather than being left out of
    a plan that still looks successful. `start-overnight`
    (issue_01M2HT8TM0M85WCQ594ADPMEFT) was individuated into thirteen
    workspaces after its source was deleted; a missing safety rule and a
    successful assembly must not look alike here either.

    `include_fleet=False` skips `scope: fleet` rows BEFORE that status check.
    An interactive targeted (`use`) render composes no fleet block once the
    floor render owns them, so a fleet block retired in the KB must not stop
    a render that would not have composed it. Filtering after the check
    would let one retired block fail every workspace render on the machine.
    A DISPATCHED render always passes `include_fleet=True` instead (`main`),
    since a dispatched run's own claude never reads the floor file
    (`claudeMdExcludes`, issue_01M4D32KA2F99QGKABZ8HV2RG5) and so is the one
    render a retired fleet block SHOULD still fail. The fail-closed check on
    a fleet block then runs in the floor render and in every dispatched
    render, which is why `knowledge-ctx floor` keeps the default `True`.
    """
    order = {s: i for i, s in enumerate(INSTRUCTION_BLOCK_SCOPES)}
    matched: list[dict] = []
    for row in rows:
        fm = _instruction_block_frontmatter(row)
        if not include_fleet and fm.get("scope") == "fleet":
            continue
        if not _instruction_block_binds(
            fm, crew=crew, agent=agent, session_kind=session_kind, topics=topics
        ):
            continue
        if row.get("status") != "current":
            die(f"instruction-block {row['id']!r} binds this session "
                f"(scope={fm.get('scope')!r}) but its status is "
                f"{row.get('status')!r}, not current — refusing to assemble "
                f"a CLAUDE.md that would silently omit a rule which applies "
                f"here (issue_01M2HT8TM0M85WCQ594ADPMEFT).")
        if fm.get("scope") not in order:
            die(f"instruction-block {row['id']!r} binds this session but "
                f"carries no valid scope ({fm.get('scope')!r}) to place it "
                f"in composition order — one of {INSTRUCTION_BLOCK_SCOPES}.")
        matched.append({**row, "_fm": fm})
    matched.sort(key=lambda r: (order[r["_fm"]["scope"]], r["id"]))
    return matched


def render_instruction_blocks_md(blocks: list[dict]) -> str:
    """The composed instruction-block section of `CLAUDE.md`: each
    block named by its id, scope and `body_sha256` (the index's `body_hash`
    column, `sha256(body)` per `lib/knowledge/indexer.py`) ahead of its body,
    in the order `resolve_instruction_blocks` already placed them, so a past
    run's instructions reconstruct exactly from this file alone."""
    parts = []
    for row in blocks:
        fm = row["_fm"]
        parts.append(
            f"<!-- instruction-block: {row['id']} "
            f"scope:{fm.get('scope')} body_sha256:{row.get('body_hash')} -->\n"
            f"{(row.get('body') or '').strip()}\n"
        )
    return "\n".join(parts)


# The writing standards the platform composes by instruction block, keyed by the
# name a reader looks for in `.profile-documents.json`. Each names the blocks
# (by the last segment of their id) that deliver it. Absence from the composed
# list is what a correct render and a broken selector produce identically, so
# the record states, per standard, whether it was composed and why not.
_WRITING_STANDARD_BLOCKS = {
    "write-better": ("write-better-import", "write-better-import-dispatched"),
    "talk-better": ("talk-better-import",),
}


def crew_resolution_record(repo: str, crew: str | None) -> dict:
    """`{"name": crew, "resolved": True}`, or `{"name": None, "resolved": False,
    "reason": ...}` naming the repo whose crew-scoped instruction blocks were not
    composed. Written to `.profile-documents.json` so a reader of the record sees
    what a reader of stderr would."""
    if crew is not None:
        return {"name": crew, "resolved": True}
    return {"name": None, "resolved": False,
            "reason": f"crew-scoped instruction blocks were not composed for {repo!r}: "
                      f"no crew is registered or found in the knowledge repo"}


def writing_standards_record(
    raw_rows: list[dict], composed: list[dict], *, crew: str | None,
    agent: str | None, session_kind: str,
    topics: frozenset[str] = frozenset(), include_fleet: bool = True,
) -> dict[str, dict]:
    """For each writing standard, `{"composed": True, "blocks": [...]}` or
    `{"composed": False, "reason": ...}`. A block whose `@` import the
    inliner dropped (`_dropped_imports`, set by `inline_block_imports`) is in
    the file with no standard in it, so it is not composed.

    The reason comes from `_instruction_block_mismatch`, the evaluation that
    decided the block list, so this record cannot disagree with the file. A
    fleet candidate the render dropped (`include_fleet=False`) says the floor
    delivers it."""
    composed_ids = {b["id"] for b in composed}
    record: dict[str, dict] = {}
    for standard, names in _WRITING_STANDARD_BLOCKS.items():
        candidates = [r for r in raw_rows if r["id"].rsplit("/", 1)[-1] in names]
        dropped = {b["id"]: b["_dropped_imports"] for b in composed
                   if b.get("_dropped_imports")}
        bound = sorted(r["id"] for r in candidates
                       if r["id"] in composed_ids and r["id"] not in dropped)
        if bound:
            record[standard] = {"composed": True, "blocks": bound}
        elif not candidates:
            record[standard] = {
                "composed": False,
                "reason": f"the index serves no instruction block named "
                          f"{' or '.join(names)}"}
        else:
            def reason(r: dict) -> str:
                if r["id"] in dropped:
                    return ("the inliner dropped its import of "
                            + ", ".join(dropped[r["id"]]))
                fm = _instruction_block_frontmatter(r)
                if not include_fleet and fm.get("scope") == "fleet":
                    return "delivered by the floor"
                return (_instruction_block_mismatch(
                    fm, crew=crew, agent=agent, session_kind=session_kind,
                    topics=topics) or "bound but not composed")
            why = "; ".join(
                f"{r['id'].rsplit('/', 1)[-1]}: " + reason(r)
                for r in sorted(candidates, key=lambda r: r["id"]))
            record[standard] = {"composed": False,
                                "reason": f"{session_kind}; {why}"}
    return record


# The floor: what every session on the machine reads at start, whatever its
# cwd, rendered from the `scope: fleet` instruction blocks. The manifest names
# the file this tool owns, so `co` can tell a rendered floor from a hand-written
# one without re-deriving the plan from the index.
_FLOOR_MANIFEST_NAME = ".floor-manifest.json"


def floor_cut_over() -> bool:
    """True once `~/.claude/CLAUDE.md` is a rendered floor.

    The same test as `_co_refresh_floor` in bin/co: `~/.claude/.floor-manifest.json`
    exists and names `~/.claude/CLAUDE.md` as its `output`. `co` is zsh and greps
    the manifest; this reads it as JSON. The two are not shared because a bash
    caller would have to shell out to this tool on every `co` launch for a
    one-line test; a drift between them shows as `use` composing fleet blocks
    that `co` refuses to refresh, which repeats a rule and loses none.

    Until the cutover the global file is hand-written and holds rules only some
    fleet blocks repeat, and a targeted render that stopped composing those
    blocks would drop the rest from the session (security-reviewer, PR #657).
    Reads HOME at call time, so a test's HOME is honoured.
    """
    floor = Path.home() / ".claude" / "CLAUDE.md"
    try:
        manifest = json.loads(
            (floor.parent / _FLOOR_MANIFEST_NAME).read_text())
    except (OSError, ValueError):
        return False
    return isinstance(manifest, dict) and manifest.get("output") == str(floor)


def fleet_composition_record(include_fleet: bool, *, session_kind: str) -> dict:
    """What `.profile-documents.json` says about fleet blocks in this render.

    A dispatched render's `include_fleet` is always True (see `main`), for a
    reason unrelated to the floor's cutover state, so `session_kind` picks
    the reason that is actually true rather than reporting "floor not cut
    over" on a dispatched render where the floor IS cut over."""
    if not include_fleet:
        return {"composed": False, "reason": "floor cut over"}
    if session_kind == "dispatched":
        return {"composed": True, "reason": "a dispatched run does not read the floor"}
    return {"composed": True, "reason": "floor not cut over"}


def resolve_floor_blocks(rows: list[dict]) -> list[dict]:
    """The `scope: fleet` blocks, in composition order, each carrying `_fm`.

    Selects fleet rows FIRST and hands only those to
    `resolve_instruction_blocks`, so the fail-closed `status` check and the
    scope ordering are the ones a workspace render already runs. Passing every
    row through it with `crew=None, agent=None` would also bind any non-fleet
    block whose selectors happen to match an interactive session.

    Refuses an empty result: the caller replaces the one file every new session
    reads, and a floor composed of nothing (an index not yet built, a kind
    filter that drifted) would blank it with no error anywhere.
    """
    fleet = [row for row in rows
             if _instruction_block_frontmatter(row).get("scope") == "fleet"]
    blocks = resolve_instruction_blocks(
        fleet, crew=None, agent=None, session_kind="interactive")
    if not blocks:
        die("the index holds no `scope: fleet` instruction block; refusing to "
            "render an empty floor over the file every session reads.")
    return blocks


# Claude Code saves SessionStart `additionalContext` over its limit to a file and
# shows the session a 2 KB preview, so the standards would be lost. A fresh
# session received 9,500 bytes whole and not 10,500 (measured by the steward,
# issue_01M3CE7E4Z1QTKRQKP94JXN9PF), hence one hook per part, each under this
# cap. KNOWLEDGE_CTX_PART_MAX_BYTES overrides it for tests.
GENERIC_PART_MAX_BYTES = 9000
GENERIC_PART_MAX_ENV = "KNOWLEDGE_CTX_PART_MAX_BYTES"

# The parts of the generic bundle, split along the two inlined imports: a block
# belongs to the part named for it here, and every other block is in `blocks`.
# Keyed by the last segment of the block id, as _WRITING_STANDARD_BLOCKS is.
GENERIC_PARTS = ("blocks", "write-better", "talk-better")
_GENERIC_PART_OF_BLOCK = {
    "write-better-import": "write-better",
    "talk-better-import": "talk-better",
}


def render_generic_bundle(part: str | None = None) -> int:
    """Print the non-fleet instruction blocks an interactive session with no
    agent and no crew receives, for the SessionStart hook
    (`tools/generic-bundle-context.sh`) to deliver where no render exists.

    The set is whatever `resolve_instruction_blocks` selects with
    `include_fleet=False`, so a block added or retired in the KB reaches the
    bundle with no edit here. Fleet blocks stay out because the floor
    (~/.claude/CLAUDE.md) already carries them; repeating them would make this a
    second floor that can diverge from the first.

    Refuses an empty result for the reason `resolve_floor_blocks` does: a hook
    emitting nothing looks the same as a session that needed nothing.

    With PART (one of GENERIC_PARTS) prints only that part's blocks, and refuses
    with exit 1 and prints nothing when the text is over the byte cap or the
    part holds no block. Exit 1 and never 2: a SessionStart hook's exit 2 has
    its own meaning in Claude Code. An over-cap part is refused whole, never
    truncated, because half a standard is worse than a named absence.
    """
    if part is not None and part not in GENERIC_PARTS:
        die(f"unknown generic bundle part {part!r}; expected one of "
            f"{', '.join(GENERIC_PARTS)}.")
    blocks = resolve_instruction_blocks(
        fetch_instruction_blocks(), crew=None, agent=None,
        session_kind="interactive", include_fleet=False)
    if not blocks:
        die("the index holds no non-fleet instruction block an interactive "
            "session with no agent receives; refusing to print an empty bundle.")
    blocks = inline_block_imports(blocks)
    if part is not None:
        blocks = [b for b in blocks if _GENERIC_PART_OF_BLOCK.get(
            b["id"].rsplit("/", 1)[-1], "blocks") == part]
        if not blocks:
            die(f"generic bundle part {part!r} holds no instruction block; "
                f"refusing to print an empty part.")
    text = render_instruction_blocks_md(blocks)
    if part is not None:
        cap = int(os.environ.get(GENERIC_PART_MAX_ENV) or GENERIC_PART_MAX_BYTES)
        size = len(text.encode("utf-8"))
        # tools/generic-bundle-context.sh keys on "-byte cap; refusing" to tell
        # this refusal from every other exit 1; keep the phrase in step with it.
        if size > cap:
            die(f"generic bundle part {part!r} is {size} bytes, over the "
                f"{cap}-byte cap; refusing to print it.")
    sys.stdout.write(text)
    return 0


# Claude Code expands an `@path` line in a CLAUDE.md but not in SessionStart
# `additionalContext` (measured 2026-09-24, issue_01M3BG8SJABPQT9ZRGJZ8D3K6F), so
# the generic bundle, which travels as additionalContext, carries the file
# itself. It asks once per project before following an external `@` import in a
# CLAUDE.md too: interactively that is a prompt, and under `claude -p` the import
# is dropped silently, with a new worktree path on every dispatch so it cannot be
# pre-approved (issue_01M3DAAXJMT5X1FE2RF0JG28SB). So the crew and dispatched
# renders inline as well. A block is knowledge content, so only a file whose real
# path lies under one of these roots is read; otherwise a block could pull ~/.ssh
# or a token file into a CLAUDE.md.
GENERIC_INLINE_MAX_BYTES = 64 * 1024
GENERIC_INLINE_ROOTS_ENV = "KNOWLEDGE_CTX_INLINE_ROOTS"
_IMPORT_LINE = re.compile(r"^[ \t]*@(/[^\r\n]*?)[ \t]*$")


def generic_inline_roots() -> list[Path]:
    """The write-better repo under the configured Convivy root, plus any
    absolute root named in `KNOWLEDGE_CTX_INLINE_ROOTS` (os.pathsep-separated).
    Resolved so a comparison against a resolved file path is like for like."""
    roots = [CONVIVY / "write-better"]
    for extra in os.environ.get(GENERIC_INLINE_ROOTS_ENV, "").split(os.pathsep):
        if extra.strip() and Path(extra.strip()).is_absolute():
            roots.append(Path(extra.strip()))
    return [r.resolve() for r in roots]


def inline_imports(body: str, roots: list[Path], budget: list[int],
                   dropped: list[str] | None = None) -> str:
    """Replace each line that is exactly `@<absolute path>` with the file's
    contents behind a marker naming the path and its sha256. An import that is
    outside ROOTS (after symlink resolution), missing, unreadable, not UTF-8 or
    past the remaining BUDGET bytes is dropped with one stderr line, and never
    left as a bare `@` line. Each dropped path is appended to DROPPED."""
    out = []
    for line in body.split("\n"):
        m = _IMPORT_LINE.match(line)
        if not m:
            out.append(line)
            continue
        raw = m.group(1)
        try:
            real = Path(raw).resolve()
            if not any(real == r or r in real.parents for r in roots):
                raise ValueError("outside the allowlisted roots")
            data = real.read_bytes()
            text = data.decode("utf-8")
            if len(data) > budget[0]:
                raise ValueError(
                    f"{len(data)} bytes exceeds the {budget[0]} bytes left of "
                    f"the {GENERIC_INLINE_MAX_BYTES}-byte inline bound")
        except (OSError, ValueError) as exc:  # UnicodeDecodeError is a ValueError
            sys.stderr.write(f"knowledge-ctx: import @{raw} left out of the "
                             f"rendered instructions: {exc}\n")
            if dropped is not None:
                dropped.append(raw)
            continue
        budget[0] -= len(data)
        out.append(f"<!-- inlined: {real} sha256:"
                   f"{hashlib.sha256(data).hexdigest()} -->")
        out.append(text.rstrip("\n"))
    return "\n".join(out)


def inline_block_imports(blocks: list[dict]) -> list[dict]:
    """BLOCKS with every `@<absolute path>` line in a body inlined by
    `inline_imports`, all under one `GENERIC_INLINE_MAX_BYTES` budget. A block
    whose import was dropped carries `_dropped_imports`, which
    `writing_standards_record` reads."""
    roots = generic_inline_roots()
    budget = [GENERIC_INLINE_MAX_BYTES]
    out = []
    for b in blocks:
        dropped: list[str] = []
        body = inline_imports(b.get("body") or "", roots, budget, dropped)
        out.append({**b, "body": body, "_dropped_imports": dropped}
                   if dropped else {**b, "body": body})
    return out


def _atomic_replace_file(path: Path, text: str) -> None:
    """Write `text` to `path` by temp file + fsync + `os.replace`.

    `os.replace` swaps the directory entry, so a session starting mid-write
    reads the whole old file or the whole new one; `_write_regular_relative`
    truncates in place and leaves an empty file in between. It also replaces a
    symlink AT `path` rather than following it, so the target of a link the
    floor does not own is never written. The temp file lives beside `path`
    because rename is atomic only within one filesystem, and is removed when
    anything between creating it and the replace fails.
    """
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.floor-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(text.encode("utf-8"))
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _knowledge_head() -> str | None:
    try:
        out = subprocess.run(
            ["git", "-C", str(KNOWLEDGE), "rev-parse", "HEAD"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return (out.stdout.strip() or None) if out.returncode == 0 else None


def render_floor(output: Path, *, dry_run: bool) -> int:
    """Render the floor to `output` and its manifest beside it."""
    blocks = resolve_floor_blocks(fetch_instruction_blocks())
    text = render_instruction_blocks_md(blocks)
    entries = [{"id": b["id"], "scope": b["_fm"].get("scope"),
                "body_sha256": b.get("body_hash")} for b in blocks]
    if dry_run:
        sys.stdout.write(text)
        sys.stderr.write(f"knowledge-ctx floor (dry run): {len(blocks)} block(s) "
                         f"for {output}; nothing written.\n")
        return 0
    if not output.parent.is_dir():
        die(f"{output.parent} is not a directory; the floor needs its "
            f"container to exist.")
    manifest = {
        "rendered_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "knowledge_commit": _knowledge_head(),
        "output": str(output),
        "blocks": entries,
    }
    _atomic_replace_file(output, text)
    _atomic_replace_file(output.parent / _FLOOR_MANIFEST_NAME,
                         json.dumps(manifest, indent=2) + "\n")
    sys.stderr.write(f"knowledge-ctx floor: rendered {len(blocks)} block(s) to "
                     f"{output}\n")
    return 0


def resolve_agent_bound_instruction_blocks(
    rows: list[dict], *, crew: str | None, agent: str, session_kind: str,
    topics: frozenset[str] = frozenset(), include_fleet: bool = True,
) -> list[dict]:
    """The subset of `resolve_instruction_blocks(rows, agent=agent, ...)`
    that depends on `agent`'s identity — i.e. carries `binds_agents` or
    `binds_roles` — rather than matching the same way regardless of which agent this is
    (issue_01M35B8Q926KNB53X4050T9V5F).

    A crew-session render (`knowledge-ctx use` with no `--agent`) calls
    `resolve_instruction_blocks` once, with `agent=None`, to compose the
    session's own `CLAUDE.md`. `_instruction_block_binds` never lets a
    `binds_agents` or `binds_roles` selector match when `agent` is `None`, so
    that call can never place such a block anywhere — the ONLY render that ever
    resolves one is a dispatched (`--agent`) run, composing straight into
    its own `CLAUDE.md`. A crew session that also individuates agent
    definitions into `.claude/agents/` (so it can invoke them as Agent-tool
    subagents) has no other file of its own to carry such a block into, so
    this is called once per individuated agent slug and its result is
    appended to THAT agent's definition file instead.

    Filtering to those two selectors keeps the file that a block with none of
    that selector — a `fleet` block, or a `crew` block selecting only
    `binds_crews`/`binds_sessions`/`binds_topics` — is already correctly
    resolved (or excluded) by the top-level, `agent=None` call and belongs
    in the session's `CLAUDE.md` once, not repeated into every agent's own
    file. Whether an Agent-tool subagent also reads that `CLAUDE.md` is not
    established, so this deliberately does not widen to those on a guess —
    only `binds_agents` blocks are demonstrably unreachable otherwise.

    Reuses `resolve_instruction_blocks`, so the same fail-closed behaviour
    binds here too: a `binds_agents` block that matches this agent but is
    not `status: current` stops the render exactly as it would at the top
    level.
    """
    return [
        row for row in resolve_instruction_blocks(
            rows, crew=crew, agent=agent, session_kind=session_kind,
            topics=topics, include_fleet=include_fleet)
        if row["_fm"].get("binds_agents") or row["_fm"].get("binds_roles")
    ]


def render_agent_bound_instruction_blocks_md(agent_md: str, blocks: list[dict]) -> str:
    """Append `blocks` (already resolved for one agent by
    `resolve_agent_bound_instruction_blocks`) to that agent's rendered
    definition, in a section using the same marker format
    `render_instruction_blocks_md` emits — so a past render's obligations
    reconstruct from the definition file alone, the same property that
    format already gives `CLAUDE.md`.

    A no-op (returns `agent_md` unchanged) when `blocks` is empty, so an
    individuated agent with no block bound to it keeps exactly the body
    `_agent_md` produced — unchanged from before this
    function existed."""
    if not blocks:
        return agent_md
    return (
        f"{agent_md.rstrip()}\n\n"
        f"<!-- knowledge-ctx: instruction blocks bound to this agent -->\n\n"
        f"{render_instruction_blocks_md(blocks)}"
    )


# --- frontmatter translation ---


FM_SPLIT = re.compile(r"^---\s*\n(.*?)\n---\s*\n(.*)\Z", re.DOTALL)


def split_frontmatter(text: str) -> tuple[dict, str]:
    m = FM_SPLIT.match(text)
    if not m:
        return {}, text
    return yaml.safe_load(m.group(1)) or {}, m.group(2)


def derive_description(title: str, body: str) -> str:
    """Synthesize a one-line description from the agent/skill doc's body —
    used as the `description:` field Claude Code surfaces to the orchestrator
    to decide when to invoke the subagent/skill."""
    # Take the first non-empty, non-heading paragraph.
    paragraph = ""
    for line in body.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line.startswith("---"):
            continue
        paragraph = line
        break
    if not paragraph:
        return title
    # Stop at the first sentence-ender, capped to ~200 chars.
    sentence_end = re.search(r"[.!?](?:\s|$)", paragraph)
    if sentence_end and sentence_end.end() < 250:
        paragraph = paragraph[: sentence_end.end()].rstrip()
    return paragraph[:250].rstrip()


def slug_from_id(doc_id: str) -> str:
    """e.g. 'shared/agents/planner' → 'planner'.

    Rejects a slug that would escape `agents_dir/<slug>.md` or
    `skills_dir/<slug>/SKILL.md` when a caller joins it onto those roots — ''
    (a trailing slash in doc_id), '.', '..', anything containing '/' (an
    id with more than one embedded slash segment) or a NUL. None of these are
    refused by `Path.__truediv__` itself, so a malformed KB doc id would
    otherwise write or delete outside the directory this render owns.
    """
    slug = doc_id.rsplit("/", 1)[-1]
    if not slug or slug in (".", "..") or "/" in slug or "\x00" in slug:
        die(f"unsafe slug derived from doc id {doc_id!r}: {slug!r}")
    return slug


def _rendered_description(row: dict, fm: dict, body: str) -> str:
    """The `description:` of a rendered agent or skill file. The trigger, the
    body-derived line and the title that `derive_description` falls back to all
    pass `_bounded_trigger`, because every session loads this value. When all
    three bound to nothing, the description is the bounded slug the file is
    named by. The slug fallback is bounded by the same rule and can be empty,
    in which case `description:` renders empty."""
    return (_bounded_trigger(fm.get("trigger"))
            or _bounded_trigger(derive_description(row["title"], body))
            or _bounded_trigger(slug_from_id(row["id"])))


def _agent_md(row: dict, fm: dict, body: str) -> str:
    """Translate one of our agent docs into a Claude Code subagent file.

    Prefers the `trigger:` frontmatter field when present, the same way
    `_skill_md` does and for the same reason: `description:` is what Claude
    Code shows an orchestrator deciding WHICH subagent to invoke, so it has to
    say when to pick this one. A body-derived first sentence says what the agent
    does, which is a different question — `cfo-ingest`'s hand-written trigger is
    "use when the operator has a downloaded bank/card statement to load", while its first
    paragraph is "You load a single statement file into cfo.db".

    Falls back to derivation for agents without `trigger:`, which is every agent
    authored in the KB to date — all 30 of them were written body-first with no
    such field, which is why this loss stayed invisible until the 33 repo-native
    definitions moving into the Reference Room brought hand-written triggers with
    them.
    """
    name = slug_from_id(row["id"])
    description = _rendered_description(row, fm, body)
    out_fm = {"name": name, "description": description}
    tools = fm.get("tools")
    if tools:
        if isinstance(tools, list):
            out_fm["tools"] = ", ".join(tools)
        else:
            out_fm["tools"] = str(tools)
    model = fm.get("model")
    if model:
        out_fm["model"] = model
    fm_text = yaml.safe_dump(out_fm, default_flow_style=False, sort_keys=False).rstrip()
    return f"---\n{fm_text}\n---\n\n{body.lstrip()}"


def _skill_md(row: dict, fm: dict, body: str) -> str:
    """Translate a skill doc into Claude Code's SKILL.md format; see `_agent_md`."""
    name = slug_from_id(row["id"])
    description = _rendered_description(row, fm, body)
    out_fm = {"name": name, "description": description}
    fm_text = yaml.safe_dump(out_fm, default_flow_style=False, sort_keys=False).rstrip()
    return f"---\n{fm_text}\n---\n\n{body.lstrip()}"


# --- pre-flight checks (ARCH-023) ---


def live_claude_processes_in(target_root: Path,
                             exempt_pids: frozenset[int] = frozenset()) -> list[tuple[int, Path]]:
    """Return PIDs of running `claude` processes whose cwd is in/under target_root.

    `exempt_pids` are skipped (P2a, 2026-07-04): when an orchestrator dispatches a
    spawn into its own primary worktree, the invoking co/claude session's cwd IS the
    target, so the guard would abort on the caller itself. agentctl passes its own
    ancestor pids so the caller is exempt while a *different* live session still
    aborts the write correctly."""
    target_resolved = str(target_root.resolve())
    out: list[tuple[int, Path]] = []
    try:
        ps = subprocess.run(
            ["ps", "-axo", "pid=,comm="], capture_output=True, text=True, check=False, timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    for line in ps.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        pid_str, comm = parts
        if "claude" not in comm.lower():
            continue
        try:
            pid = int(pid_str)
        except ValueError:
            continue
        if pid in exempt_pids:
            continue
        # Resolve cwd via lsof.
        try:
            ls = subprocess.run(
                ["lsof", "-a", "-d", "cwd", "-Fn", "-p", str(pid)],
                capture_output=True, text=True, check=False, timeout=5,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        cwd_str = ""
        for ln in ls.stdout.splitlines():
            if ln.startswith("n"):
                cwd_str = ln[1:]
                break
        if not cwd_str:
            continue
        cwd_path = Path(cwd_str)
        try:
            cwd_resolved = str(cwd_path.resolve())
        except OSError:
            continue
        if cwd_resolved == target_resolved or cwd_resolved.startswith(target_resolved + "/"):
            out.append((pid, cwd_path))
    return out


def find_conflicts(plan: list[tuple[Path, str]]) -> list[Path]:
    """Return target paths that exist with content different from what we'd write.

    `.profile-documents.json` is compared via `_profile_documents_match`, the
    same as `plan_is_current`, ignoring its ever-changing `materialized_at`
    field — a literal comparison here reported that file as conflicting on
    every non-force run past the first, purely because of its timestamp, with
    nothing an operator could actually resolve about it (security-reviewer,
    round 2 outside-the-diff note on PR #594). It never changed whether a run
    aborted (a REAL difference elsewhere in the plan still does, correctly),
    only whether the reported conflict list carried that one spurious,
    non-actionable entry alongside the real one.
    """
    conflicts: list[Path] = []
    for target, content in plan:
        if not target.exists():
            continue
        existing = target.read_text()
        if target.name == _PROFILE_DOCUMENTS_NAME:
            if not _profile_documents_match(existing, content):
                conflicts.append(target)
        elif existing != content:
            conflicts.append(target)
    return conflicts


def _profile_documents_match(existing_text: str, new_text: str) -> bool:
    """True if two `.profile-documents.json` bodies agree on everything a
    no-op cares about — `profile`, `documents`, `instruction_blocks`,
    `writing_standards` and `fleet_blocks` — ignoring `materialized_at`.

    That field is the actual wall-clock time of the write, by design (the
    record is "what did the LAST real individuation bring", not "was this
    checked just now"), so it differs on every call. Comparing it literally
    would mean this file never equals its own prior write, which would defeat
    `plan_is_current` for every dispatch — see that function's docstring for
    why that guard is load-bearing. Malformed JSON — including valid JSON that
    parses to something other than an object, like `null` or `[]` — reads as a
    mismatch, matching this function's callers' fail-closed-to-"not current"
    posture.
    """
    try:
        existing = json.loads(existing_text)
        new = json.loads(new_text)
    except json.JSONDecodeError:
        return False
    if not isinstance(existing, dict) or not isinstance(new, dict):
        return False
    return (existing.get("profile") == new.get("profile")
            and existing.get("documents") == new.get("documents")
            and existing.get("instruction_blocks") == new.get("instruction_blocks")
            and existing.get("writing_standards") == new.get("writing_standards")
            and existing.get("fleet_blocks") == new.get("fleet_blocks")
            and existing.get("crew") == new.get("crew"))


def plan_is_current(
    plan: list[tuple[Path, str]], agents_dir: Path, skills_dir: Path, *, force: bool
) -> bool:
    """True iff the on-disk .claude already equals this plan exactly, so
    individuating would write nothing AND remove nothing — i.e. a true no-op.

    Every planned target must already exist with identical content — except
    `.profile-documents.json`, compared via `_profile_documents_match` so its
    ever-changing `materialized_at` doesn't itself force a write. In force
    mode (which clears agents/ + skills/ of everything not preserved before
    rewriting — `_clear_dir_preserving`) there must also be no stray file
    under those dirs beyond the plan — a leftover would be deleted by force,
    which is a real change, not a no-op.

    Used to short-circuit `individuate()` before the live-process guard: the
    guard only protects against clobbering a live session's .claude, and a
    no-op clobbers nothing. This is what lets a live daytime `co` session spawn
    an agent that resolves to the primary worktree (e.g. `planner`) into its
    own already-daytime primary worktree without self-deadlocking against the
    guard (ARCH-080).

    A True here is also what `individuate()` treats as proof that
    `.profile-documents.json` is current enough to signal on
    `--profile-documents-current-fd`, so every `target` read above goes
    through `_guarded_existing_text` (`_guarded_read_bytes`'s lstat/
    O_NOFOLLOW/O_NONBLOCK/fstat/size-cap guard) rather than a plain
    `read_text()` — every `target` lives under `agents_dir`/`skills_dir`/
    `claude_dir`, which a prior, compromised dispatch into a reused worktree
    could have planted a symlink, FIFO or oversized file in, and a read this
    function cannot vouch for must count as a mismatch, never as a match
    (security-reviewer, PR #740 round 5). `find_conflicts` above reads the
    same targets the same unguarded way still: unlike this function, it only
    ever gates an ABORT (the non-force conflict path, before any write), not
    the no-op signal, so content it misreads can block a write but can never
    make `individuate()` claim a stale or forged file is current."""
    for target, content in plan:
        if not target.exists():
            return False
        existing = _guarded_existing_text(target)
        if existing is None:
            return False
        if target.name == _PROFILE_DOCUMENTS_NAME:
            if not _profile_documents_match(existing, content):
                return False
        elif existing != content:
            return False
    if force:
        planned = {t.resolve() for t, _ in plan}
        for d in (agents_dir, skills_dir):
            if d.exists():
                for p in d.rglob("*"):
                    if p.is_file() and p.resolve() not in planned:
                        return False
    return True


_LOG_CONTROL_CHAR_ESCAPES = {"\n": "\\n", "\r": "\\r", "\x1b": "\\x1b"}


def _escape_for_log(text: str) -> str:
    """`text` with newline, carriage return and ESC replaced by their
    backslash escapes, for a stderr line about to embed a worktree-controlled
    filename (an orphan candidate's path, found by walking `agents_dir`/
    `skills_dir`).

    A Unix filename may contain any byte but `/` and NUL, including a literal
    newline — a prior, compromised dispatch into a reused worktree can plant
    one. Printed raw, such a name splits this process's stderr into extra
    lines a reader (or a regex over it) did not ask for; round 5 used exactly
    that against the then-current `KNOWLEDGE_CTX_PROFILE_DOCUMENTS_CURRENT`
    text marker (security-reviewer, PR #740 round 5). That marker now travels
    on a dedicated pipe fd nothing here can reach (`_signal_profile_documents_
    current`), so this escaping is no longer load-bearing for it — it is kept
    as its own fix, because a filename able to inject lines into a log is a
    defect independent of any one marker it happens to be able to forge.
    """
    for ch, esc in _LOG_CONTROL_CHAR_ESCAPES.items():
        text = text.replace(ch, esc)
    return text


# --- individuation ---


def abort(message: str, code: int) -> int:
    """Refuse: stdout FLUSHED FIRST, then the reason on stderr, then `code`.

    Every abort below goes through here, because the ORDERING is the defect
    this exists to fix. The plan summary above is printed to stdout, which is
    block-buffered whenever this command is piped or captured — which is what
    an agent does with it — while stderr is unbuffered and surfaces
    immediately. So an abort written straight to stderr came out BEFORE the
    summary, and `plan: 32 files` landed LAST. Reading the tail of a blocked
    run therefore showed nothing but a completed plan, with the refusal
    scrolled off above it.

    The exit code was correct all along and is not what failed. What failed is
    that a refusal and a success produced the same evidence at the end of the
    output, which is the one thing a caller reads. Orient took a blocked
    `use daytime --force` for a completed one on 2026-09-09 and caught it only
    by checking the individuated file's mtime.

    Flushing makes the order true, so the LAST thing a blocked run prints is
    why it refused. The success path's closing `wrote N files.` is what a
    completed run ends with instead, and the two now differ where they are
    read.
    """
    sys.stdout.flush()
    sys.stderr.write(message)
    sys.stderr.flush()
    return code


def individuate(
    *,
    project: str,
    profile_name: str,
    profile: dict,
    target_repo: Path,
    rows: list[dict],
    force: bool,
    force_anyway: bool,
    dry_run: bool,
    rule_stats: list[dict] | None = None,
    exempt_pids: frozenset[int] = frozenset(),
    known_ids: dict[str, set[str]] | None = None,
    expected_root_stat: tuple[int, int] | None = None,
    instruction_blocks: list[dict] | None = None,
    agent_bound_instruction_blocks: dict[str, list[dict]] | None = None,
    writing_standards: dict[str, dict] | None = None,
    fleet_blocks: dict | None = None,
    crew: dict | None = None,
    profile_documents_current_fd: int | None = None,
) -> int:
    claude_dir = target_repo / ".claude"
    agents_dir = claude_dir / "agents"
    skills_dir = claude_dir / "skills"

    # A render owns `.claude`, `.claude/agents` and `.claude/skills` as
    # directories it can freely clear and rewrite (`_clear_dir_preserving_fd`,
    # the write loop below). If any of the three is ITSELF a symlink, every
    # write below would follow it and land somewhere this render does not
    # own. The old `shutil.rmtree(agents_dir)` raised on this shape; round 2's
    # `_clear_dir_preserving` turned that into a warn-and-continue that still
    # went on to write through the symlink afterwards (round 3, reproduced).
    # `.claude` itself joined this check in round 5: swapping IT for a
    # symlink defeated every fd-based protection on `agents`/`skills` with no
    # race needed at all, since round 4's fix only ever verified the FINAL
    # path component of `<target_repo>/.claude/agents`, never `.claude`
    # itself (security-reviewer, round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT).
    # Refuse before touching anything — in both --force and non-force mode,
    # and before the plan is even built. THIS IS THE FAST PATH ONLY: it
    # proves the shape at THIS instant, and a container swapped for a symlink
    # any time between here and the actual write would still follow it
    # straight through — the binding that closes THAT gap is
    # `_open_root_fd`/`_open_container_fd`, called again, late, immediately
    # before the write phase begins, this time as a single fd chain rooted at
    # `target_repo` so `.claude` is proven non-symlink the same way
    # `agents`/`skills` are, not by a separate, re-defeatable path check.
    for container in (claude_dir, agents_dir, skills_dir):
        if container.is_symlink():
            return abort(
                f"\n✗ {container} is a symlink, not a directory this render "
                f"owns — aborting before writing anything.\n"
                f"Remove or replace it with a real directory, then re-run.\n"
                f"NOTHING WAS WRITTEN.\n",
                5,
            )

    # Read BEFORE any part of the new plan is written (the write loop is at the
    # end of this function) — so a render can never grant itself permission to
    # delete something by way of the very manifest it is about to produce.
    previous_manifest = _read_previous_manifest(claude_dir)

    plan: list[tuple[Path, str]] = []
    # One {id, kind, body_sha256} per row this individuation actually
    # resolves, across EVERY kind — not only agent/skill, which are the only
    # ones rendered to disk below. `body_sha256` is the hash of what this
    # individuation actually resolved for the row: for agent/skill, the exact
    # bytes written to its target file below (frontmatter, body and any bound
    # instruction blocks included, since that whole file is what a run reads);
    # for every other kind, which is never mirrored to disk, the Library body
    # the row was rendered from. Either way it is a hash of content this
    # process composed just now, not a value carried over from the index.
    documents: list[dict] = []
    for row in rows:
        # Every row carries its own frontmatter and body from the Library (`_bundle`),
        # so no render reads a document from the shared checkout.
        bundled = row["_bundle"]
        if row["kind"] == "agent":
            slug = slug_from_id(row["id"])
            target = agents_dir / f"{slug}.md"
            agent_md = _agent_md(row, bundled["fm"], bundled["body"])
            bound = (agent_bound_instruction_blocks or {}).get(slug) or []
            content = render_agent_bound_instruction_blocks_md(agent_md, bound)
            plan.append((target, content))
            body_sha256 = hashlib.sha256(content.encode("utf-8")).hexdigest()
        elif row["kind"] == "skill":
            target = skills_dir / slug_from_id(row["id"]) / "SKILL.md"
            content = _skill_md(row, bundled["fm"], bundled["body"])
            plan.append((target, content))
            body_sha256 = hashlib.sha256(content.encode("utf-8")).hexdigest()
        else:
            # Other kinds (architecture/decision/runbook/reference/spec) stay
            # queryable via the `kb` MCP server — not mirrored into .claude/
            # to keep the surface tight. The Library's own `body_sha256`, which
            # `_verified_document` checked against the body it served.
            body_sha256 = bundled["body_sha256"]
        documents.append({
            "id": row["id"], "kind": row["kind"],
            "body_sha256": body_sha256,
        })

    # Synthesize CLAUDE.md from claude_md_extras and from any resolved
    # instruction blocks (issue_01M2PXHKZ3SE1AQPS8MWWT691X) — independent
    # sources composed into the same file, so either alone is enough to
    # write it, and a render with no `claude_md_extras` still gets at least
    # the fleet-scope blocks that bind every session.
    extras = profile.get("claude_md_extras") or []
    instruction_md = render_instruction_blocks_md(instruction_blocks or [])
    claude_md_path = claude_dir / "CLAUDE.md"
    # A render producing NO CLAUDE.md content must delete any file a
    # previous render left, rather than leaving it in place unmentioned.
    # Inclusion-in-plan is the only thing that ever rewrites this file, so
    # without this the content-goes-empty transition is invisible: the
    # instructions an earlier render composed keep being read as current
    # indefinitely. Demonstrated on the `--force` path `agentctl`'s
    # `activate_profile` uses — render with `claude_md_extras`, render again
    # with them removed, and the withdrawn rule is still on disk and still
    # served, with exit 0 and `wrote N files.` both reporting success.
    #
    # This is the mirror of the fail-closed rule in `resolve_instruction_blocks`
    # and matters for the same reason. There, a rule that should apply must
    # never go missing quietly; here, a rule that should NO LONGER apply must
    # never linger quietly. A withdrawn rule and a correct render must not
    # look alike either.
    #
    # THE DELETION IS GATED, because ".claude/CLAUDE.md" is the generic
    # Claude Code path for local repo instructions (measured directly on
    # Claude Code 2.1.280: a canary sentence placed there was loaded; the
    # same canary placed at ".claude/CLAUDE.local.md" — where this tool used
    # to compose — was not) and not a name this tool owns by virtue of
    # writing it sometimes. An operator or agent who hand-places notes there
    # — in a repo whose active profile composes nothing on this render —
    # must not have them removed by a `knowledge-ctx use` typed at a
    # terminal, which `_PROFILE_ALLOWLIST` above establishes is a real and
    # named occurrence rather than a weaker hypothetical one. So this clears
    # the same per-file gates `_orphan_gate_reason` applies to every other
    # file this tool deletes, which the orphan path earned over five rounds
    # of exactly this risk. A candidate that fails a gate is REPORTED and
    # kept, never removed.
    stale_claude_md = None
    stale_claude_md_blocked: str | None = None
    if not extras and not instruction_md and claude_md_path.exists():
        stale_claude_md_blocked = _stale_claude_md_gate_reason(
            claude_md_path, previous_manifest, claude_dir, target_repo)
        if stale_claude_md_blocked is None:
            stale_claude_md = claude_md_path

    # Migration off the retired path `.claude/CLAUDE.local.md` — measured
    # directly on Claude Code 2.1.280 (same measurement as above): a canary
    # sentence placed there was not loaded. This tool no longer writes under
    # that path under any profile. Unlike `claude_md_path` above, this is
    # not conditioned on "nothing composed this render" — there is no
    # profile state under which this tool will ever compose there again, so
    # a previous render's copy is permanently orphaned the moment this
    # render's plan is built. It clears the same per-file gates before
    # removal for the same reason: a hand-placed file at this generic path
    # must survive exactly as it would at the live path.
    legacy_local_md_path = claude_dir / "CLAUDE.local.md"
    stale_legacy_local_md = None
    stale_legacy_local_md_blocked: str | None = None
    if legacy_local_md_path.exists():
        stale_legacy_local_md_blocked = _stale_claude_md_gate_reason(
            legacy_local_md_path, previous_manifest, claude_dir, target_repo)
        if stale_legacy_local_md_blocked is None:
            stale_legacy_local_md = legacy_local_md_path

    # The write side of the same ownership question the deletion gate above
    # answers: a `.claude/CLAUDE.md` this render is about to WRITE may
    # already hold hand-placed notes rather than a previous render's output.
    # `_write_regular_relative` truncates unconditionally, and under
    # `--force` the conflict check below (`find_conflicts`) never runs, so
    # nothing else stands between a hand-written file and this write. Reuse
    # the same ownership test the deletion gate uses — a file not listed in
    # the previous individuation manifest is not this tool's file — rather
    # than inventing a second notion of ownership that could disagree with
    # the first.
    claude_md_write_blocked: str | None = None
    if (extras or instruction_md) and claude_md_path.exists():
        claude_md_write_blocked = _stale_claude_md_gate_reason(
            claude_md_path, previous_manifest, claude_dir, target_repo)

    if extras or instruction_md:
        sections = [s.strip() for s in extras]
        if instruction_md:
            sections.append(instruction_md)
        claude_md_body = "\n\n".join(sections).rstrip() + "\n"
        claude_md = (
            "<!-- AUTO-GENERATED by knowledge-ctx — edit the profile YAML instead -->\n"
            f"<!-- Profile: {project}/{profile_name} -->\n\n"
            + claude_md_body
        )
        if claude_md_write_blocked is None:
            plan.append((claude_md_path, claude_md))

    # Active-profile marker.
    plan.append((claude_dir / ".active-profile", f"{project}/{profile_name}\n"))

    # Profile-documents record: which knowledge documents this individuation
    # brought, so a consumer (Deck's cockpit, via `session-agent documents`)
    # can list them without the KB index or the profile YAML this process just
    # used — it reads this record instead, so the answer stays true to what
    # THIS individuation resolved even after the profile or the corpus moves
    # on. Written before the manifest below so the manifest lists it too.
    _individuated_at = datetime.now(timezone.utc).isoformat()
    documents_record = {
        "profile": f"{project}/{profile_name}",
        # `materialized_at` is the pre-0088 key; both carry one value. Readers
        # accept either, and the old key stays until nothing reads it.
        "materialized_at": _individuated_at,
        "individuated_at": _individuated_at,
        "documents": sorted(documents, key=lambda d: d["id"]),
        # The blocks composed into this CLAUDE.md, in composition order, with
        # the hash of the body each carried. A dispatched render's
        # `instruction_blocks` carries the `scope: fleet` rows too
        # (`include_fleet` is always True for `session_kind == "dispatched"`,
        # above) — only an interactive render on the cut-over floor, where
        # `include_fleet` is False, omits them here and leaves them to
        # `.floor-manifest.json` instead.
        "instruction_blocks": [
            {"id": b["id"], "scope": b["_fm"].get("scope"),
             "body_sha256": b.get("body_hash")}
            for b in instruction_blocks or []],
        "writing_standards": writing_standards or {},
        # Whether fleet blocks are in this CLAUDE.md, and why.
        "fleet_blocks": fleet_blocks or {},
        # Which crew the crew-scoped blocks were bound for, or why none were.
        "crew": crew or {},
    }
    plan.append((claude_dir / _PROFILE_DOCUMENTS_NAME,
                 json.dumps(documents_record, indent=2) + "\n"))

    # Manifest of exactly what this individuation owns, relative to .claude/.
    #
    # It exists so a CONSUMER can tell platform-written files from agent-written
    # ones without re-deriving the plan (which needs the KB index and the profile).
    # The ARCH-344 worktree reap is that consumer: it must clear its own scaffolding
    # while preserving anything an agent wrote, and a name-shaped guess cannot do
    # that — `agents/exfil.md` looks exactly like an individuated agent. Listing the
    # paths makes the question exact.
    #
    # Written LAST and listing itself, so the manifest is a fixed point: a consumer
    # comparing the on-disk set to the manifest sees equality, not an extra file.
    manifest_path = claude_dir / _MANIFEST_NAME
    owned = sorted(str(t.relative_to(claude_dir)) for t, _ in plan)
    owned.append(_MANIFEST_NAME)
    plan.append((manifest_path, "\n".join(sorted(owned)) + "\n"))

    # Orphans: rendered agent/skill files with no document anywhere in the
    # index OR on disk (issue_01M2HT8TM0M85WCQ594ADPMEFT). Distinct from a
    # file this profile's rules simply exclude — that one's document is
    # still live and correctable through the KB, so it is left for
    # `--force`'s ordinary clear+rewrite. An orphan has no document to
    # propose a fix against, so a session must never load it silently — but
    # "no document anywhere" is only ever inferred from reads this run
    # trusts: the index (`_index_trust_problem`) AND, independently, the
    # knowledge checkout on disk (`_known_ids_from_disk` /
    # `_disk_trust_problem`) — the index alone can be caught mid-reconcile,
    # populated on both axes yet still missing the one id that matters
    # (round 3). Even a genuine orphan is only REMOVED when it also clears
    # the per-file gate in `_find_orphans` (previous manifest, containment,
    # git-tracked); a candidate that fails any of those, including "found on
    # disk but not yet in the index", is reported and left alone rather than
    # removed (issue_01M2HT8TM0M85WCQ594ADPMEFT round 2, extended round 3).
    #
    # The disk walk itself (`_known_ids_from_disk`) only runs when
    # `_has_disk_check_candidate` finds at least one file it could actually
    # change the verdict for — every render with nothing index-unknown
    # rendered (the common case: a clean re-render, or a profile with no
    # agents/skills at all) skips the ~0.5s knowledge-tree walk entirely
    # (round 4).
    planned = {t.resolve() for t, _ in plan}
    removable: list[Path] = []
    blocked: list[tuple[Path, str]] = []
    if known_ids is not None:
        trust_problem = _index_trust_problem(known_ids)
        disk_known_ids: dict[str, set[str]] = {"agent": set(), "skill": set()}
        if trust_problem is None and _has_disk_check_candidate(
                agents_dir, skills_dir, planned, known_ids):
            disk_result = _known_ids_from_disk(KNOWLEDGE / "projects")
            trust_problem = _disk_trust_problem(disk_result)
            if disk_result is not None:
                disk_known_ids = disk_result
        if trust_problem is not None:
            sys.stderr.write(
                f"knowledge-ctx: orphan detection skipped — {trust_problem}\n"
            )
        else:
            removable, blocked = _find_orphans(
                agents_dir, skills_dir, planned, known_ids, disk_known_ids,
                previous_manifest, claude_dir, target_repo,
            )
    for path, reason in blocked:
        sys.stderr.write(
            f"knowledge-ctx: orphan, not removed: {_escape_for_log(str(path))} "
            f"({reason})\n")
    for orphan in removable:
        sys.stderr.write(
            f"knowledge-ctx: orphan (no source document anywhere): "
            f"{_escape_for_log(str(orphan))}\n"
        )

    # Dry-run summary up front (helpful for both modes).
    print(f"profile: {project}/{profile_name}")
    print(f"target:  {target_repo}/.claude/")
    print(f"plan:    {len(plan)} files")
    agent_count = sum(1 for t, _ in plan if t.parts[-2] == "agents")
    skill_count = sum(1 for t, _ in plan if t.name == "SKILL.md")
    print(f"  agents: {agent_count}")
    print(f"  skills: {skill_count}")
    print(f"  + CLAUDE.md, .active-profile, {_PROFILE_DOCUMENTS_NAME}")

    def _emit(outcome: str, written: int = 0) -> None:
        _log_individuation({
            "event": "materialize",
            "project": project,
            "profile": profile_name,
            "target_repo": str(target_repo),
            "rules": rule_stats or [],
            "total_docs": len(rows),
            "agents": agent_count,
            "skills": skill_count,
            "force": force,
            "outcome": outcome,
            "written": written,
            "orphans_removed": len(removable),
            "orphans_blocked": len(blocked),
            "claude_md_blocked": (
                {"path": str(claude_md_path), "reason": claude_md_write_blocked}
                if claude_md_write_blocked is not None else None
            ),
        })

    if stale_claude_md is not None:
        print("  - CLAUDE.md (no longer composed by this profile)")
    elif stale_claude_md_blocked is not None:
        # Reported on every render rather than once, and BEFORE the no-op
        # short-circuit below, which a blocked candidate does not defeat —
        # this render will never delete it, so treating it as a change would
        # force the live-process guard on every future render of a file that
        # is simply not ours. The same reasoning the orphan path applies to a
        # blocked orphan.
        print(f"  ! CLAUDE.md left in place — {stale_claude_md_blocked}")

    if stale_legacy_local_md is not None:
        print("  - CLAUDE.local.md (retired path, no longer composed by this tool)")
    elif stale_legacy_local_md_blocked is not None:
        print(f"  ! CLAUDE.local.md left in place — {stale_legacy_local_md_blocked}")

    if claude_md_write_blocked is not None:
        _not_delivered_msg = (
            f"  ! composed session instructions were NOT delivered — "
            f"{claude_md_path} left in place ({claude_md_write_blocked}).")
        print(_not_delivered_msg)
        # Also on stderr (round 3, PR #635): `bin/co` never captures this
        # tool's stdout, so a human on `co -r` only ever sees this line via
        # stderr, and a dispatched run's caller (`activate_profile`) captures
        # both streams but only reads them on a non-zero exit — this write
        # returns 0. Neither gap is closed by moving the human line alone;
        # the marker two lines down is what `activate_profile` actually
        # keys on, on both a zero and non-zero exit.
        sys.stderr.write(_not_delivered_msg + "\n")
        sys.stderr.write(
            f"{_CLAUDE_MD_NOT_DELIVERED_MARKER} path={claude_md_path} "
            f"reason={claude_md_write_blocked}\n")

    if dry_run:
        print("\n(dry-run — no files written.)")
        _emit("dry_run")
        return 0

    # Idempotency short-circuit (ARCH-080): if the on-disk .claude already
    # matches this plan exactly, individuation is a no-op — skip BOTH the
    # write and the live-process pre-flight below. The guard exists only to
    # avoid clobbering a live session's .claude; a no-op clobbers nothing.
    # Without this, a live daytime `co` session can't `agentctl spawn` an agent
    # that resolves to the primary worktree (which re-individuates its own
    # already-current daytime profile there) — the guard would trip on the
    # calling session itself.
    #
    # A REMOVABLE ORPHAN MAKES THIS NOT A TRUE NO-OP, even when every planned
    # file already matches and `force` is false: a "no changes" report on disk
    # that still carries an unattributable file is the exact silent survival
    # issue_01M2HT8TM0M85WCQ594ADPMEFT found — the on-disk `plan_is_current`
    # stray check below is gated on `force` (a full-wipe question, unrelated to
    # attribution), so it alone never catches this case in default mode. A
    # BLOCKED orphan does NOT break the no-op: this run will never delete it
    # (it already failed the per-file gate above and is reported every time
    # regardless), so treating it as a real change would force the
    # live-process guard on every future render of a git-tracked or
    # unmanifested stray that will never actually be removed.
    # A stale `CLAUDE.md`, or a leftover `CLAUDE.local.md` from before this
    # tool retired that path, needs no clause of its own here, and this was
    # checked rather than assumed. A file this render may delete must be
    # listed in the PREVIOUS manifest (the ownership gate above). `.materialized`
    # is itself a planned target whose content is the sorted list of what this
    # render owns — so the very render that stops composing (or ever composed)
    # the file also omits it from that list, and `plan_is_current` already
    # returns False on the `.materialized` comparison. Added `stale_claude_md
    # is None` / `stale_legacy_local_md is None` clauses here would be
    # branches no input can reach and no test can pin.
    if plan_is_current(plan, agents_dir, skills_dir, force=force) and not removable:
        print("\n(profile already current — no changes; skipping re-individuation.)")
        _emit("noop")
        # The no-op short-circuit above just proved, byte-for-byte, that
        # `.profile-documents.json` on disk equals the `documents`/
        # `instruction_blocks` this call computed — so it is current for THIS
        # individuation even though nothing was (re)written.
        _signal_profile_documents_current(profile_documents_current_fd)
        return 0

    # Pre-flight 1: liveness.
    live = live_claude_processes_in(target_repo, exempt_pids=exempt_pids)
    if live and not force_anyway:
        _emit("blocked_live")
        return abort(
            "\n✗ live Claude Code processes detected in target — aborting.\n"
            + "".join(f"  pid {pid}  cwd={cwd}\n" for pid, cwd in live)
            + "\nQuit those sessions, or pass --force-anyway to override.\n"
            + "NOTHING WAS WRITTEN — the plan above was not applied.\n",
            2,
        )

    # From here on this render is committed to writing. Open the WHOLE chain
    # ONCE, now — immediately before the force-clear / unlink / write work
    # below, not separated from it by any of the slower work already done
    # above (the disk-corroboration walk chief among them) — and hold every
    # descriptor for every write, unlink, and clear in the rest of this
    # render. `target_repo` (`_open_root_fd`) → `.claude` → `agents`/`skills`
    # (`_open_container_fd`, relative to the previous descriptor each time):
    # round 5 made this a genuine CHAIN rather than two independent opens of
    # `<target_repo>/.claude/agents` and `<target_repo>/.claude/skills` by
    # path, because a path-based open of either only ever proved the FINAL
    # component (`agents`/`skills`) non-symlink, never `.claude` itself — see
    # `_open_container_fd`'s docstring for why that let a `.claude` swap
    # defeat every fd-based protection downstream with no race needed at all
    # (security-reviewer, round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT). Every
    # site below that used to re-open `claude_dir` by path — including the
    # write loop's own claude_dir-root branch — now goes through `claude_fd`
    # instead, so `.claude` is bound to the same instant as `agents`/`skills`
    # rather than re-verified separately, later, by a path check that could
    # itself be raced.
    #
    # `_open_root_fd` opened `target_repo` BY PATH, and `O_NOFOLLOW` there only
    # refuses `target_repo` itself being a symlink — an ANCESTOR swapped for
    # one in the real time this render has already spent (the disk walk,
    # the live-process check) redirects the open with no race needed, since
    # the final component is a genuine, non-symlink directory either way
    # (round 6, issue_01M2HT8TM0M85WCQ594ADPMEFT). `expected_root_stat` —
    # `target_repo`'s `(st_dev, st_ino)`, captured by `main()` the instant
    # `Path.cwd()` resolved it — is threaded through so `_open_root_fd` can
    # refuse an ancestor swap the same way `_open_container_fd` refuses a
    # `.claude` swap: not by re-checking the path, but by confirming the
    # descriptor actually opened still names the same real directory.
    needs_agents = agents_dir.exists() or any(t.parent == agents_dir for t, _ in plan)
    needs_skills = skills_dir.exists() or any(t.parent.parent == skills_dir for t, _ in plan)
    root_fd, fd_err = _open_root_fd(target_repo, expected_root_stat)
    claude_fd = agents_fd = skills_fd = None
    if fd_err is None:
        claude_fd, fd_err = _open_container_fd(root_fd, ".claude", True)
        os.close(root_fd)  # claude_fd (if obtained) no longer depends on this
    if fd_err is None:
        agents_fd, fd_err = _open_container_fd(claude_fd, "agents", needs_agents)
    if fd_err is None:
        skills_fd, fd_err = _open_container_fd(claude_fd, "skills", needs_skills)
    if fd_err is not None:
        for fd in (claude_fd, agents_fd, skills_fd):
            if fd is not None:
                os.close(fd)
        _emit("blocked_container")
        return abort(
            f"\n✗ {fd_err} — aborting before writing anything.\n"
            f"NOTHING WAS WRITTEN.\n",
            5,
        )

    try:
        # Immediately before this render deletes anything: re-verify every
        # gate `_find_orphans` used to mark a candidate removable, against
        # freshly-read state rather than the snapshot taken earlier in this
        # render — before the dry-run print, the live-process pre-flight, and
        # the fd chain just opened above, all of which take real time in
        # which a source document for a candidate's slug can appear
        # (`_reverify_removable`, round 5, issue_01M2HT8TM0M85WCQ594ADPMEFT).
        # A candidate that no longer clears every gate moves to `blocked`, so
        # BOTH the non-force unlink loop below (which only ever iterates
        # `removable`) and force's `_clear_dir_preserving_fd` (which preserves
        # everything named in `blocked`) leave it alone. Skipped entirely
        # when there is nothing removable — the common case — so this never
        # pays its cost on a render that isn't about to delete anything.
        if removable:
            removable, freshly_blocked = _reverify_removable(
                removable, agents_dir, skills_dir, known_ids,
                previous_manifest, claude_dir, target_repo)
            for path, reason in freshly_blocked:
                sys.stderr.write(
                    f"knowledge-ctx: orphan, not removed: "
                    f"{_escape_for_log(str(path))} ({reason})\n")
            blocked = blocked + freshly_blocked

        # Pre-flight 2: conflicts (default mode) or wipe (force mode). Either
        # way, a REMOVABLE orphan is removed here — unconditionally, since an
        # unattributable file that cleared the per-file gate is never a
        # "conflict" `--force` is required to resolve (there is nothing left
        # to resolve it against). A BLOCKED orphan survives both modes: force
        # clears everything else in agents_dir/skills_dir but preserves it by
        # name (`_clear_dir_preserving_fd`), and the non-force unlink loop
        # below only ever iterates `removable`.
        if force:
            _clear_dir_preserving_fd(
                agents_fd, {p.name for p, _ in blocked if p.parent == agents_dir})
            _clear_dir_preserving_fd(
                skills_fd, {p.parent.name for p, _ in blocked if p.parent.parent == skills_dir})
        else:
            conflicts = find_conflicts(plan)
            if conflicts:
                _emit("conflict")
                return abort(
                    "\n✗ conflicting files exist with different content:\n"
                    + "".join(f"  {p}\n" for p in conflicts)
                    + "\nResolve manually, or pass --force to clear + rewrite.\n"
                    + "NOTHING WAS WRITTEN — the plan above was not applied.\n",
                    3,
                )
            for orphan in removable:
                _unlink_orphan_fd(orphan, agents_dir, skills_dir, agents_fd, skills_fd)

        # Write. Every target in this plan is a direct child of `agents_dir`,
        # `skills_dir`, or `claude_dir` itself (`.active-profile`,
        # `.profile-documents.json`, `.materialized`, `CLAUDE.md`), and
        # every one of those three now has an open, `O_NOFOLLOW`-verified
        # descriptor from the chain above — so every write below goes
        # through a `dir_fd`, bound to that descriptor regardless of what its
        # path resolves to by the time this runs. Round 4 left the
        # `claude_dir`-root case as a path-based write re-verified by its own
        # `is_symlink()` check immediately before writing; `claude_fd` closes
        # that the same way `agents_fd`/`skills_fd` always did, rather than
        # by a second, independent check that could itself be raced (round 5,
        # issue_01M2HT8TM0M85WCQ594ADPMEFT).
        written = 0
        for target, content in plan:
            if target.parent == agents_dir:
                if _write_regular_relative(agents_fd, target.name, content):
                    written += 1
                continue
            if target.parent.parent == skills_dir:
                slug = target.parent.name
                try:
                    os.mkdir(slug, dir_fd=skills_fd)
                except FileExistsError:
                    pass
                slug_fd = os.open(slug, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                   dir_fd=skills_fd)
                try:
                    if _write_regular_relative(slug_fd, target.name, content):
                        written += 1
                finally:
                    os.close(slug_fd)
                continue
            # target.parent == claude_dir — the only remaining shape a plan
            # entry can take.
            if _write_regular_relative(claude_fd, target.name, content):
                written += 1

        # Remove a CLAUDE.md this render no longer composes, through the
        # same `claude_fd` every write above is bound to, so the unlink cannot
        # be redirected by a container swapped underneath this render. A file
        # already gone is the outcome this wanted.
        if stale_claude_md is not None:
            # Re-run the same gates against fresh state, immediately before
            # the unlink. The first pass ran before the dry-run print, the
            # live-process pre-flight and the fd chain, so its answer is
            # already stale by the time we get here — and the file may have
            # been committed to git, replaced by a symlink, or rewritten in
            # between. `_reverify_removable` exists for exactly this window on
            # the orphan path and this one is no shorter.
            still = _stale_claude_md_gate_reason(
                stale_claude_md, previous_manifest, claude_dir, target_repo)
            if still is not None:
                print(f"! CLAUDE.md left in place — {still} "
                      f"(changed since this render started).")
            else:
                try:
                    os.unlink(stale_claude_md.name, dir_fd=claude_fd)
                    print(f"removed {stale_claude_md.name} "
                          f"(no longer composed by this profile).")
                except FileNotFoundError:
                    pass

        # Remove a leftover `.claude/CLAUDE.local.md` from a render before this
        # migration — same re-verification, same `claude_fd`, same reasoning,
        # unconditional on what this render composes at the live path.
        if stale_legacy_local_md is not None:
            still = _stale_claude_md_gate_reason(
                stale_legacy_local_md, previous_manifest, claude_dir, target_repo)
            if still is not None:
                print(f"! CLAUDE.local.md left in place — {still} "
                      f"(changed since this render started).")
            else:
                try:
                    os.unlink(stale_legacy_local_md.name, dir_fd=claude_fd)
                    print(f"removed {stale_legacy_local_md.name} "
                          f"(retired path, no longer composed by this tool).")
                except FileNotFoundError:
                    pass
    except OSError as e:
        # A container removed or replaced mid-render (the swap this fd
        # binding defends against) surfaces here as a plain OSError — ENOENT
        # from a dir_fd whose directory is gone, most often — rather than as
        # a write landing somewhere this render does not own. Confirmed:
        # this platform refuses a dir_fd-relative write once its directory
        # has been unlinked, it does not silently redirect to whatever now
        # sits at the old path.
        _emit("blocked_container")
        return abort(
            f"\n✗ could not complete this render — the container may have "
            f"changed underneath it: {e}\n"
            f"Some files from this plan may already be written; re-run.\n",
            5,
        )
    finally:
        if agents_fd is not None:
            os.close(agents_fd)
        if skills_fd is not None:
            os.close(skills_fd)
        if claude_fd is not None:
            os.close(claude_fd)

    print(f"\nwrote {written} files.")
    _emit("written", written)
    # The write loop above just wrote `.profile-documents.json` (it is always
    # in `plan`), so it is current for THIS individuation.
    _signal_profile_documents_current(profile_documents_current_fd)
    return 0


# --- session topics (issue_01M3V1J3TCHC7CWCZ9534WD6KG) ---


def session_topics(issue_id: str | None) -> tuple[frozenset[str], str | None]:
    """The dispatched work item's `topics`, for `binds_topics` selectors.

    Returns `(topics, None)` — `topics` empty when `issue_id` is `None` (no
    item named, so no topic constraint applies) or when the item was read and
    genuinely carries none. Returns `(frozenset(), why)` when the item could
    NOT be read, so a lookup failure is never silently indistinguishable from
    an item that truly has no topics — the same distinction
    `get_item_from_default_library`'s own docstring draws for its caller.
    `why` is a status code or exception NAME only, same contract as
    `_fetch_work_item` in `bin/agentctl`, never a message that could carry a
    token or URL.

    Calls `issue_client.get_item_from_default_library` — the SAME function
    `agentctl spawn --issue` reads a work item's `model_choice` through — but
    this is a SECOND request for the same item, not a reuse of that one: this
    render runs in its own `knowledge-ctx` process, with no path back to
    whatever `agentctl` already read. `IC.DISPATCH_READ_TIMEOUT` bounds it the
    same 3s `agentctl`'s own read uses, rather than the module's
    general-purpose 5s default, so the two critical-path reads share one
    budget."""
    if not issue_id:
        return frozenset(), None
    try:
        import issue_client as IC  # lazy: a render with no --issue never loads it
        res = IC.get_item_from_default_library(issue_id, timeout=IC.DISPATCH_READ_TIMEOUT)
    except Exception as e:  # noqa: BLE001 — a read that raises is a read that failed
        return frozenset(), e.__class__.__name__
    if res.get("status") != "ok":
        return frozenset(), str(res.get("status"))
    item = res.get("item") or {}
    raw = item.get("topics") if isinstance(item, dict) else None
    if raw is None:
        return frozenset(), None
    if not isinstance(raw, list):
        return frozenset(), "topics is not a list"
    return frozenset(t for t in raw if isinstance(t, str) and t), None


# --- check (issue_01M4GJRCDNKCV4QREH68KSRS3W) ---
#
# `bin/co`'s plain launch (no `-r`) execs claude on whatever `.claude/` is
# already on disk, however old — only `-r` re-renders, and nobody can be
# relied on to remember it. `check` is the read-only probe a plain launch
# runs first: it resolves the workspace's active profile through the SAME
# calls `use` makes (`load_profile`, `fetch_instruction_blocks`,
# `resolve_instruction_blocks`, `inline_block_imports`), so the two can never
# disagree about what the profile currently contains, and compares that
# against what `.profile-documents.json` recorded from the LAST render.

# Exit code for "cannot tell" — no manifest, an unreadable or malformed
# manifest, no active profile, or a resolve failure. Distinct from 1 (behind,
# an affirmative answer) so a caller can tell "the render is stale" apart
# from "this could not be checked at all" (`bin/co` takes the same refresh
# path either way, but says which one it saw).
CHECK_CANNOT_TELL = 3


def _escape_for_check_output(text: str) -> str:
    """`text` with every C0 control char, DEL and C1 control char replaced by
    a visible `\\xHH` escape, before `cmd_check` prints it.

    Unlike `_escape_for_log` above (newline/CR/ESC only, for a worktree-
    controlled filename reaching a log line), every id `cmd_check` prints
    below is read back from `.profile-documents.json` or `.active-profile`
    — both workspace-writable — and this command now runs on every plain
    `co` launch rather than only on an explicit `-r`, so that text reaches
    the operator's real terminal with no operator action (security-
    reviewer, PR #835 round 1). C0 (0x00-0x1f) covers the ESC that
    introduces a CSI/OSC sequence; C1 (0x80-0x9f) covers the 8-bit
    equivalents some terminals still honour.
    """
    out = []
    for ch in text:
        cp = ord(ch)
        if cp < 0x20 or cp == 0x7f or 0x80 <= cp <= 0x9f:
            out.append(f"\\x{cp:02x}")
        else:
            out.append(ch)
    return "".join(out)


def cmd_check(cwd: Path, record_path: Path | None = None) -> int:
    """Read-only. See the module comment above `CHECK_CANNOT_TELL`.

    Assumes an INTERACTIVE crew-session render — `agent=None`,
    `session_kind="interactive"`, no `--issue` topics — because that is the
    only shape a `bin/co` plain launch (this command's one caller) ever
    produces. A dispatched workspace's render is scoped by `fetch_bundle`
    instead of the profile, which this never calls; running `check` there
    would compare against the wrong resolution and is out of scope for the
    occurrence this fixes.

    Compares two sets, never more: the instruction block set by id and
    `body_hash` (`.profile-documents.json`'s `body_sha256`, the index's
    `body_hash` — the SAME field name mismatch `render_instruction_blocks_md`
    already carries, not a new one), and the document id set alone — a
    document's own `body_sha256` in the record is a hash of what THAT
    render composed to disk (frontmatter, body and bound blocks for an
    agent/skill), which `check` would have to re-render to reproduce; the id
    set is what `use`'s `profile["documents"]` already states with no
    further work, and is the comparison this command makes.

    *record_path*, when given, is compared against instead of the
    workspace's own `.profile-documents.json` (issue_
    01M4GJRCDNKCV4QREH68KSRS3W slice 2: a live session's own render-staleness
    hook keeps a copy of what IT loaded at launch, taken once, and must keep
    diffing the CURRENT resolution against that copy rather than the on-disk
    manifest — which a re-render during the session's life updates out from
    under it). `project`/`profile_name` still come from cwd's own
    `.active-profile` marker either way; only the comparison's other side
    moves.
    """
    claude_dir = cwd / ".claude"
    marker = claude_dir / ".active-profile"
    try:
        active = marker.read_text().strip()
    except OSError as e:
        print(f"knowledge-ctx: no active profile to check against ({e})",
              file=sys.stderr)
        return CHECK_CANNOT_TELL
    if "/" not in active:
        print(f"knowledge-ctx: {marker} does not name project/profile: {active!r}",
              file=sys.stderr)
        return CHECK_CANNOT_TELL
    project, _, profile_name = active.rpartition("/")

    manifest_path = record_path if record_path is not None else claude_dir / _PROFILE_DOCUMENTS_NAME
    try:
        previous = json.loads(manifest_path.read_text())
    except (OSError, json.JSONDecodeError) as e:
        print(f"knowledge-ctx: cannot read {manifest_path}: {e}", file=sys.stderr)
        return CHECK_CANNOT_TELL
    if not isinstance(previous, dict):
        print(f"knowledge-ctx: {manifest_path} is not a JSON object", file=sys.stderr)
        return CHECK_CANNOT_TELL

    try:
        product, _ = detect_product(cwd)
        # `project` above came from the workspace-writable `.active-profile`
        # marker, never from cwd — unlike `cmd_use`, which only ever derives
        # it via `detect_project_or_default(cwd, ...)` and can never be
        # pointed at an attacker-chosen project at all. Pin it to that same
        # resolution before trusting it for anything below: an unrestricted
        # workspace (any product with no `_PROFILE_ALLOWLIST` entry) could
        # otherwise write a marker naming a DIFFERENT project — EA, the
        # platform's black box (platform/decisions/0043) — and have `check`
        # fetch and print that project's own profile, which
        # `check_profile_allowed` cannot catch: it validates `profile_name`
        # against the CALLING directory's own allowlist entry, never
        # `project` itself (security-reviewer, PR #835 round 3).
        expected_project, _ = detect_project_or_default(cwd)
        if project != expected_project:
            print(f"knowledge-ctx: {marker} names project "
                  f"{_escape_for_check_output(project)}, but this directory "
                  f"resolves to {_escape_for_check_output(expected_project)}; "
                  f"refusing to check a different project's profile",
                  file=sys.stderr)
            return CHECK_CANNOT_TELL
        # Same refusal `cmd_use` applies via `check_profile_allowed`, and
        # ahead of `load_profile` for the same reason: a directory on
        # `_PROFILE_ALLOWLIST` (EA) must not resolve a wider profile even to
        # diff it, and `profile_name` here comes from the workspace-writable
        # `.active-profile` marker rather than a CLI argument (security-
        # reviewer, PR #835 round 1).
        check_profile_allowed(product, profile_name)
        profile = load_profile(project, profile_name)
        crew = projects.crew_for_repo(product, KNOWLEDGE)
        topics, _ = session_topics(None)
        include_fleet = not floor_cut_over()
        instruction_blocks = resolve_instruction_blocks(
            fetch_instruction_blocks(), crew=crew, agent=None,
            session_kind="interactive", topics=topics, include_fleet=include_fleet,
        )
        instruction_blocks = inline_block_imports(instruction_blocks)
    except SystemExit as e:
        print(f"knowledge-ctx: could not resolve "
              f"{_escape_for_check_output(project)}/"
              f"{_escape_for_check_output(profile_name)} to check it "
              f"(exit {e.code})", file=sys.stderr)
        return CHECK_CANNOT_TELL

    current_doc_ids = {d["id"] for d in (profile.get("documents") or [])}
    previous_doc_ids = {d["id"] for d in (previous.get("documents") or [])}
    current_blocks = {b["id"]: b.get("body_hash") for b in instruction_blocks}
    previous_blocks = {b["id"]: b.get("body_sha256")
                        for b in (previous.get("instruction_blocks") or [])}

    # Every id below is escaped before it reaches the line this appends —
    # see `_escape_for_check_output`.
    changes: list[str] = []
    for doc_id in sorted(current_doc_ids - previous_doc_ids):
        changes.append(f"+ document {_escape_for_check_output(doc_id)}")
    for doc_id in sorted(previous_doc_ids - current_doc_ids):
        changes.append(f"- document {_escape_for_check_output(doc_id)}")
    for block_id in sorted(current_blocks.keys() - previous_blocks.keys()):
        changes.append(f"+ instruction-block {_escape_for_check_output(block_id)}")
    for block_id in sorted(previous_blocks.keys() - current_blocks.keys()):
        changes.append(f"- instruction-block {_escape_for_check_output(block_id)}")
    for block_id in sorted(current_blocks.keys() & previous_blocks.keys()):
        if current_blocks[block_id] != previous_blocks[block_id]:
            changes.append(f"~ instruction-block {_escape_for_check_output(block_id)}")

    if not changes:
        print(f"knowledge-ctx: {_escape_for_check_output(project)}/"
              f"{_escape_for_check_output(profile_name)} is current.")
        return 0
    for line in changes:
        print(line)
    return 1


# --- main entry ---


def main() -> int:
    parser = argparse.ArgumentParser(prog="knowledge-ctx")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_use = sub.add_parser("use", help="individuate a profile into ./.claude/")
    p_use.add_argument("profile")
    p_use.add_argument("--force", action="store_true")
    p_use.add_argument("--force-anyway", action="store_true")
    p_use.add_argument("--dry-run", action="store_true")
    p_use.add_argument("--no-default-fallback", action="store_true",
                       help="load the named profile or refuse; never take "
                            "platform/default (agentctl passes this for an "
                            "explicit `spawn --profile`)")
    p_use.add_argument("--agent", default=None,
                       help="the agent this render is for (e.g. `reviewer`, "
                            "`platform-coder`). Absent means a crew session "
                            "render, as today; present means a dispatched "
                            "run. `agentctl spawn` passes it, so instruction-"
                            "block `binds_agents`/`binds_sessions` selectors "
                            "(issue_01M2PXHKZ3SE1AQPS8MWWT691X) can resolve.")
    p_use.add_argument("--issue", default=None,
                       help="the work item this dispatch is for "
                            "(issue_01M2MAP3X0Q1BQW06AV8204CFW). Scopes the "
                            "agent's bundle to agent+item where the Library has "
                            "a profile for the item's product, else agent+repo. "
                            "Only meaningful with --agent.")
    p_use.add_argument("--exempt-pid", action="append", type=int, default=[],
                       metavar="PID",
                       help="a live-claude PID to skip in the pre-flight guard "
                            "(repeatable). agentctl passes its own ancestor pids so an "
                            "orchestrator dispatching into its own worktree isn't blocked "
                            "by its own session (P2a).")
    p_use.add_argument("--profile-documents-current-fd", type=int, default=None,
                       metavar="FD",
                       help="write one fixed payload to this already-open pipe fd iff "
                            ".profile-documents.json ends this call current for the plan "
                            "it computed (written, or proven a byte-for-byte no-op); "
                            "never emitted on --dry-run. agentctl passes the write end "
                            "of a pipe it opened itself (subprocess.run's pass_fds) and "
                            "reads this fd alone, rather than scanning stdout/stderr for "
                            "a text marker (PR #740 round 5).")

    p_floor = sub.add_parser(
        "floor",
        help="render the machine-wide floor from the scope: fleet instruction "
             "blocks into --output, plus a manifest beside it")
    p_floor.add_argument("--output", required=True, metavar="PATH",
                         help="the file to render. Replaced atomically; a "
                              "symlink at PATH is replaced, never written "
                              "through. Required: there is no default, so no "
                              "invocation cuts ~/.claude/CLAUDE.md over by "
                              "omission.")
    p_floor.add_argument("--dry-run", action="store_true",
                         help="print the render to stdout and write nothing")

    p_bundle = sub.add_parser(
        "bundle",
        help="print the instruction blocks a session with no render receives")
    p_bundle.add_argument(
        "--generic", action="store_true", required=True,
        help="the non-fleet blocks an interactive session with no agent and "
             "no crew receives; required so a later bundle kind cannot be "
             "selected by omission")
    p_bundle.add_argument(
        "--part", default=None, metavar="NAME",
        help="print one part of the bundle (blocks, write-better, talk-better) "
             "so each fits the SessionStart hook-context limit; refused with "
             "exit 1 when over the byte cap. Validated in code because "
             "argparse's own refusal exits 2")

    sub.add_parser("active", help="print the currently-active profile in this repo")
    sub.add_parser("list", help="list profiles available for this repo's project")
    sub.add_parser(
        "inventory",
        help="read-only: list every rendered skill/agent across every workspace, "
             "matched to its source document id, with unmatched ones listed",
    )
    p_check = sub.add_parser(
        "check",
        help="read-only: is cwd's render current for its active profile? "
             "exit 0 current, 1 behind, 3 cannot tell",
    )
    p_check.add_argument(
        "--record", default=None, metavar="PATH",
        help="compare against this manifest file instead of cwd's own "
             ".claude/.profile-documents.json (issue_01M4GJRCDNKCV4QREH68KSRS3W "
             "slice 2: a live session's baseline render, captured once at its "
             "first firing, rather than the workspace's current on-disk "
             "manifest). Same exit codes and output either way.")

    args = parser.parse_args()
    cwd = Path.cwd()
    # Captured in the same breath as `cwd` itself — the earliest this
    # process can pin what `cwd` actually names, minimizing the window an
    # ancestor swap has to land in before `individuate()`'s `_open_root_fd`
    # checks against it (round 6, issue_01M2HT8TM0M85WCQ594ADPMEFT). Unused
    # by every command but `use`; a failure here is vanishingly unlikely
    # (cwd is the directory this process is already running from) and is
    # surfaced only if `use` actually needs it, below.
    try:
        _cwd_stat = os.stat(cwd)
        cwd_identity: tuple[int, int] | None = (_cwd_stat.st_dev, _cwd_stat.st_ino)
    except OSError:
        cwd_identity = None

    if args.cmd == "active":
        marker = cwd / ".claude" / ".active-profile"
        if marker.exists():
            print(marker.read_text().strip())
            return 0
        die("no .claude/.active-profile in cwd", code=4)

    if args.cmd == "list":
        product, _ = detect_product(cwd)
        # `list` is the detection primitive bin/co reads: exit 42 means "this
        # directory maps to no project" and selects co's generic plain-session
        # tail. It must not report `default` for such a directory, so it
        # resolves through `detect_project`, never `detect_project_or_default`.
        project = detect_project(cwd)
        profiles = list_profiles(project)
        if not profiles and _default_profile_available() and not _default_refused(product):
            project, profiles = projects.DEFAULT_PROFILE_PROJECT, [projects.DEFAULT_PROFILE_NAME]
        # Show only what `use` would accept. Listing a profile this directory is
        # forbidden to individuate is an invitation to type it.
        allowed = allowed_profiles(product)
        if allowed is not None:
            profiles = [p for p in profiles if p in allowed]
        if not profiles:
            die(f"no profiles defined for project {project}", code=4)
        print(f"profiles for {project}:")
        for p in profiles:
            print(f"  {p}")
        return 0

    if args.cmd == "inventory":
        return inventory()

    if args.cmd == "check":
        return cmd_check(cwd, record_path=Path(args.record) if args.record else None)

    if args.cmd == "floor":
        # abspath, not resolve(): resolving would follow a symlink at the
        # output and name its target, which is the file this must not write.
        return render_floor(Path(os.path.abspath(os.path.expanduser(args.output))),
                            dry_run=args.dry_run)

    if args.cmd == "bundle":
        return render_generic_bundle(args.part)

    # `use` path
    if cwd_identity is None:
        die(f"cannot stat cwd {cwd}; refusing to individuate without it")
    product, _ = detect_product(cwd)
    project, resolved = detect_project_or_default(
        cwd, allow_default=not args.no_default_fallback)
    check_profile_allowed(product, args.profile)
    profile, project, args.profile = load_profile_or_default(
        project, args.profile, resolved, _default_refused(product),
        allow_default=not args.no_default_fallback, where=str(cwd))
    if args.issue and not args.agent:
        die("--issue names the work item a DISPATCH is for; it needs --agent")
    rows, rule_stats = render_source(profile, project, args, cwd)

    # binds_sessions is supplied by the assembler, never the document
    # (nothing in a document can tell interactive from dispatched): a crew
    # session passes no --agent, a dispatched `agentctl spawn` run always
    # names one, so presence of --agent doubles as which kind this is.
    session_kind = "dispatched" if args.agent else "interactive"
    crew = projects.crew_for_repo(product, KNOWLEDGE)
    crew_record = crew_resolution_record(product, crew)
    if crew is None:
        # ONE line, marker first: agentctl captures this stderr and re-emits it
        # (`_NO_CREW_RE`). A crew that resolves to nothing gets a render that
        # looks complete and lacks its crew's instruction blocks.
        sys.stderr.write(f"KNOWLEDGE_CTX_NO_CREW repo={product} reason={crew_record['reason']}\n")
    raw_instruction_blocks = fetch_instruction_blocks()
    # The floor render owns the `scope: fleet` blocks for an INTERACTIVE
    # session once it has replaced ~/.claude/CLAUDE.md; before that the
    # hand-written file lacks two fleet rules, so they stay composed here.
    # A DISPATCHED run composes them unconditionally, cut over or not:
    # `run_sandbox.settings`'s `claudeMdExcludes` (context trim phase 2,
    # issue_01M4D32KA2F99QGKABZ8HV2RG5) stops every dispatched run's own
    # claude from ever reading the floor file, so a targeted render is the
    # only path a fleet rule reaches it through at all.
    include_fleet = session_kind == "dispatched" or not floor_cut_over()
    topics, topics_failure = session_topics(args.issue)
    if topics_failure:
        # ONE line, marker first: agentctl captures this stderr and re-emits it
        # (`_TOPICS_UNREADABLE_RE`), the same KNOWLEDGE_CTX_NO_CREW pattern above —
        # a dispatched run's own process never sees this stderr directly, so
        # without re-emission the warning reaches nobody.
        sys.stderr.write(
            f"KNOWLEDGE_CTX_TOPICS_UNREADABLE issue={args.issue} reason={topics_failure}\n"
            f"knowledge-ctx: could not read {args.issue}'s topics "
            f"({topics_failure}); this session's binds_topics selectors will "
            f"not match anything\n")
    instruction_blocks = resolve_instruction_blocks(
        raw_instruction_blocks, crew=crew, agent=args.agent,
        session_kind=session_kind, topics=topics, include_fleet=include_fleet,
    )
    instruction_blocks = inline_block_imports(instruction_blocks)
    writing_standards = writing_standards_record(
        raw_instruction_blocks, instruction_blocks, crew=crew,
        agent=args.agent, session_kind=session_kind, topics=topics,
        include_fleet=include_fleet)
    for standard, state in writing_standards.items():
        sys.stderr.write(
            f"knowledge-ctx: writing standard {standard}: "
            + (f"composed via {', '.join(state['blocks'])}\n" if state["composed"]
               else f"NOT composed, {state['reason']}\n"))

    # Only on a crew-session render (no `--agent`): that call above always
    # passes `agent=None`, so it can never place a `binds_agents` block
    # anywhere — a dispatched (`--agent`) render already resolves and
    # composes those directly into ITS OWN CLAUDE.md, above, so this stays
    # `None` there and `individuate()` appends nothing
    # (issue_01M35B8Q926KNB53X4050T9V5F).
    agent_bound_instruction_blocks: dict[str, list[dict]] | None = None
    if not args.agent:
        agent_slugs = {slug_from_id(row["id"]) for row in rows
                        if row["kind"] == "agent"}
        agent_bound_instruction_blocks = {
            slug: inline_block_imports(resolve_agent_bound_instruction_blocks(
                raw_instruction_blocks, crew=crew, agent=slug,
                session_kind=session_kind, include_fleet=include_fleet))
            for slug in agent_slugs
        }

    return individuate(
        project=project,
        profile_name=args.profile,
        profile=profile,
        target_repo=cwd,
        rows=rows,
        rule_stats=rule_stats,
        force=args.force,
        force_anyway=args.force_anyway,
        dry_run=args.dry_run,
        exempt_pids=frozenset(args.exempt_pid or []),
        known_ids=all_agent_and_skill_ids(),
        expected_root_stat=cwd_identity,
        instruction_blocks=instruction_blocks,
        agent_bound_instruction_blocks=agent_bound_instruction_blocks,
        writing_standards=writing_standards,
        fleet_blocks=fleet_composition_record(include_fleet, session_kind=session_kind),
        crew=crew_record,
        profile_documents_current_fd=args.profile_documents_current_fd,
    )


if __name__ == "__main__":
    sys.exit(main())
