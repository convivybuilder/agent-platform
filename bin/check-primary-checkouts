        "adr": "ARCH-249",
        # BOTH checked, not just the reader: `com.convivy.appkit.autoupdate` is
        # the exact job that sat disabled for 26 days unnoticed (module docstring
        # "A SECOND, INDEPENDENT BREACH" above) — "not a reader" explains why the
        # branch check above never names it, not why its own liveness wouldn't
        # matter.
        "jobs": ("com.convivy.rails.update", "com.convivy.appkit.autoupdate"),
