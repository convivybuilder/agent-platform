    if slug:
        home = projects.home_path(slug)
        if home is not None:
            print("\t".join([str(home), projects.co_default_agent(slug) or ""]))
except Exception:
    pass
PY
)
_co_company_workspace_home=""
_co_company_default_agent=""
if [[ -n $_co_company_workspace_fields ]]; then
    _co_cw_fields=("${(@ps:\t:)_co_company_workspace_fields}")
    _co_company_workspace_home=$_co_cw_fields[1]
    _co_company_default_agent=$_co_cw_fields[2]
fi
unset _co_company_workspace_fields _co_cw_fields

_co_convivy_commercial_refresh() {
    # ${(V)}: the directory's basename is cwd-derived, escaped regardless of
    # this branch's closed-set (registry-resolved, exact-literal) gate.
    print -u2 "co: refresh (${(V)$(basename "$repo_root")}) — pulling $_co_crews_root/knowledge"
    _co_pull_knowledge || {
        print -u2 "co: refresh — knowledge pull failed."
        return 1
    }
    _co_reindividuate commercial "Common cause: a prior \`claude\` session still running here. Exit it first."
}

if [[ -n $repo_root && -n $_co_company_workspace_home \
      && $(basename "$repo_root") == $(basename "$_co_company_workspace_home") ]]; then
    # Re-checked against the same bare-name shape validate_registry holds
    # co_default_agent to (lib/agent-platform/projects.py's _AGENT_NAME_OK,
    # `^[a-z0-9-]+$`) before it is joined into agent_file below — a value
    # that bypassed that check (a hand-edited registry, never run through
    # crew_registration.register) falls back to this branch's own hardcoded
    # default rather than reaching .claude/agents/<name>.md unchecked.
    _co_cw_default=$_co_company_default_agent
    [[ -n $_co_cw_default && $_co_cw_default =~ ^[a-z0-9-]+$ ]] || _co_cw_default=positioning-strategist
    agent=$_co_cw_default
    case "${1:-}" in
        "")                                        [[ -n ${1:-} ]] && shift ;;
        ps|strategist|positioning-strategist)     agent=positioning-strategist; shift ;;
        w|writer|commercial-writer)               agent=commercial-writer; shift ;;
        pa|analyst|product-analyst)               agent=product-analyst; shift ;;
        pm|product-manager)                       agent=product-manager; shift ;;
        # A leading `/` is a prompt (e.g. rollover's `/handoff-pickup <path>`,
        # spawn_successor's `co -r "/handoff-pickup <path>"`), not an agent
        # name — no agent name here starts with `/`. Leave it in place as the
        # positional prompt and keep the branch's resolved default agent.
        # `--resume` is the same, for `co restore`'s typed resume line.
        /*|--resume)                               ;;
        *)                                        agent=$1; shift ;;
    esac
    if $refresh; then
        _co_convivy_commercial_refresh || exit 1
        [[ $agent == $_co_cw_default && $# -eq 0 ]] && set -- /handoff-pickup
    fi
    _co_refresh_if_stale _co_convivy_commercial_refresh
    agent_file=".claude/agents/${agent}.md"
    if [[ ! -f $agent_file ]]; then
        # ${(V)}: $(pwd) is cwd-derived (issue_01M3Q2DJMB5R37HZD9SMVTS323 round 2),
        # escaped regardless of this branch's closed-set (exact-literal) gate.
        print -u2 "co: agent '$agent' not individuated in ${(V)$(pwd)}/.claude/agents/"
        print -u2 "    Activate the company commercial profile first:  knowledge-ctx use commercial"
        exit 1
    fi
    # Style comes from this crew's own registry row (co_accent/co_label/co_fg)
    # via the same `co_style` helper the crew-cockpit branch reads — a lemon
    # accent with a dark status foreground, distinct from the steward's coral.
    _co_cc_style=$(python3 - "$(_co_lib_dir)" "$(_co_registry_path)" "$_co_crews_root" \
        2>/dev/null <<'PY' || true
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
try:
    import projects

    if sys.argv[2]:
        projects.PROJECTS_JSON = Path(sys.argv[2])
    projects.ROOT_OVERRIDE = sys.argv[3]
    projects._load_raw.cache_clear()
    slug = projects.company_workspace_slug()
    style = projects.co_style(slug) if slug else None
    if style:
        style_id, accent, label, fg = style
        print("\t".join([style_id, accent, label or "", fg]))
except Exception:
    pass
PY
    )
    if [[ -n $_co_cc_style ]]; then
        _co_cc_fields=("${(@ps:\t:)_co_cc_style}")
        _apply_co_style "$_co_cc_fields[1]" "$_co_cc_fields[2]" "$_co_cc_fields[3]" "$_co_cc_fields[4]"
    fi
    unset _co_cc_style _co_cc_fields
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --agent "$agent" --permission-mode $_co_permission_mode "$@"
fi
unset _co_company_workspace_home _co_company_default_agent _co_cw_default

# Commercial path: the <root>/<product>-commercial/ workspaces (ARCH-049) —
# commercial-side product-manager sessions on the `commercial` profile, distinct
# from the engineering `daytime` profile. Default agent is product-manager; `pa`
# starts the product-analyst it dispatches for data. `-r` pulls knowledge,
# re-individuates the commercial profile, and resumes from the latest handoff.
#
# No full-path gate here either (same note as the company-level commercial
# branch above): a basename-only match in both places, unchanged.
_co_commercial_refresh() {
    print -u2 "co: refresh (commercial) — pulling $_co_crews_root/knowledge"
    _co_pull_knowledge || {
        print -u2 "co: refresh — knowledge pull failed."
        return 1
    }
    _co_reindividuate commercial "Common cause: a prior \`claude\` session still running here. Exit it first."
}

if [[ -n $repo_root && $(basename "$repo_root") == *-commercial ]]; then
    agent=product-manager
    case "${1:-}" in
        ""|pm|product-manager)        [[ -n ${1:-} ]] && shift ;;
        pa|analyst|product-analyst)   agent=product-analyst; shift ;;
        # A leading `/` is a prompt (e.g. rollover's `/handoff-pickup <path>`,
        # spawn_successor's `co -r "/handoff-pickup <path>"`), not an agent
        # name — no agent name here starts with `/`. Leave it in place as the
        # positional prompt and keep the branch's default agent. `--resume` is
        # the same, for `co restore`'s typed resume line.
        /*|--resume)                  ;;
        *)                            agent=$1; shift ;;
    esac
    if $refresh; then
        _co_commercial_refresh || exit 1
        [[ $agent == product-manager && $# -eq 0 ]] && set -- /handoff-pickup
    fi
    _co_refresh_if_stale _co_commercial_refresh
    agent_file=".claude/agents/${agent}.md"
    if [[ ! -f $agent_file ]]; then
        # ${(V)}: $(pwd) is cwd-derived (issue_01M3Q2DJMB5R37HZD9SMVTS323 round 2);
        # this is the glob-suffix (*-commercial) arm the round-1 reviews flagged
        # as reachable by any attacker-named directory ending in -commercial.
        print -u2 "co: agent '$agent' not individuated in ${(V)$(pwd)}/.claude/agents/"
        print -u2 "    Activate the commercial profile first:  knowledge-ctx use commercial"
        exit 1
    fi
    # Commercial workspaces share their product's own brand styling — the
    # registry row for the product this workspace strips `-commercial` off of.
    commercial_product=$(basename "$repo_root")
    commercial_product=${commercial_product%-commercial}
    # Same helper the generic daytime fallback's own styling case calls at the
    # end of this file, and the same fallback reasoning: a commercial
    # workspace for a product with no `co_accent` of its own, or for a name
    # the registry does not resolve to any product, launches unnamed-but-set
    # rather than crashing. `_co_apply_product_style` returns 1 on that path
    # (`set -eu` would otherwise end the whole launch here), so `|| true`
    # carries it — unlike that other caller's own no-style path, nothing else
    # runs: `agent_file` above already confirmed this directory is an
    # individuated commercial crew, and `_co_set_name` already gave it a
    # title, so there's no "might not even be a crew" case left to signal
    # with a fallback accent.
    _co_set_name "$commercial_product"
    _co_apply_product_style "$commercial_product" || true
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --agent "$agent" --permission-mode $_co_permission_mode "$@"
fi

# Standalone Cookbook projects (~/Cookbook, ~/cookbook-app) — personal projects,
# NOT Convivy products: no knowledge-ctx profile and no agent to individuate. `co`
# here is purely the launch ergonomic carried over from the product repos —
# always --remote-control, and `-r` (with no prompt) resumes from the latest
# handoff. No KB pull: these repos edit their data in place and have no remote.
proj=$(basename "${repo_root:-}")
if [[ -n ${repo_root:-} && ( $proj == Cookbook || $proj == cookbook-app ) ]]; then
    # Named here rather than by _apply_co_style, which this path deliberately
    # does not call — it has no iTerm profile or tmux styling of its own. Both
    # repo spellings read as one crew in the picker.
    _co_set_name "Cookbook"
    if $refresh && [[ $# -eq 0 ]]; then
        set -- /handoff-pickup
    fi
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --permission-mode $_co_permission_mode "$@"
fi

# Generic tail (multiple-sessions-per-project design, Phase 3): a directory
# none of the branches above recognises, with nothing individuated in it
# either, launches plain Claude Code instead of failing. Deck's New Project
# flow creates a brand-new directory and starts `co -r` in it before anything
# has ever run `knowledge-ctx use` there — no branch above matches a directory
# like that, and without this path it would fail below on every new project.
#
# CONSEQUENCE OF TAKING THIS PATH, not just the mechanism below: an agent that
# lands here gets none of the steering a product's own CLAUDE.md, skills, or
# agent role would apply. It runs bypassPermissions from its first prompt, in
# a directory nobody has vetted. Every other bypassPermissions launch in this
# file is gated on an enumerated, hardcoded directory name (a closed set the operator
# controls) — this is the one default-*allow* branch, so getting its gate
# wrong is worse than getting any other branch's wrong.
#
# HOW A BRAND-NEW DIRECTORY IS TOLD APART FROM A KNOWN PRODUCT WHOSE AGENTS ARE
# MERELY UN-INDIVIDUATED, since only the first may take this path and the
# second must keep hitting the loud error further down. `knowledge-ctx list`
# runs the same cwd -> KB-project lookup `knowledge-ctx use` itself relies on
# (`detect_project`): it exits with knowledge-ctx's own NO_PROJECT_MAPPING code
# (42; see bin/knowledge-ctx) ONLY when it affirmatively resolves cwd to no KB
# project at all — never for a directory that IS a recognized product, whether
# or not THIS worktree has individuated it yet.
#
# THE INVARIANT: an INCONCLUSIVE read must land in the LESS permissive branch.
# This generic tail fires ONLY on that specific affirmative code. Every other
# outcome — knowledge-ctx missing from PATH, knowledge-ctx crashing or exiting
# for an unrelated reason, `list`'s own code=4 for a known-but-profile-less
# project, any exit this comment doesn't name — is inconclusive and must fall
# through, unchanged, to the "agent ... is not individuated" error below. That
# message is load-bearing (it tells a person to run `knowledge-ctx use
# daytime`) and must never be silently swallowed by an inconclusive read here.
# (Matching on bare nonzero used to do exactly that — a missing binary or an
# unrelated crash reads identically to "no project" under `! ... list`.)
_co_generic_agent_mds=(.claude/agents/*.md(N))
if (( ${#_co_generic_agent_mds} == 0 )); then
    _co_kx_status=1
    if (( $+commands[knowledge-ctx] )); then
        # `|| _co_kx_status=$?`, not a bare statement: under this script's
        # `set -eu`, an unguarded nonzero exit here would abort the whole
        # script via errexit before the status could ever be captured or
        # compared below.
        _co_kx_status=0
        knowledge-ctx list >/dev/null 2>&1 || _co_kx_status=$?
    fi
    if (( _co_kx_status == 42 )); then
        # The generic tail has no styling to hang a name off, so it takes the
        # project's own directory name. This is Deck's New Project path: a
        # brand-new project would otherwise be the one launch with no identity
        # at all in the picker, which is when knowing which session is which
        # matters most.
        _co_set_name "$proj"
        if $refresh && [[ $# -eq 0 ]]; then
            set -- /handoff-pickup
        fi
        _co_exec_claude --remote-control $_co_name_args $claude_model_args --permission-mode $_co_permission_mode "$@"
    fi
fi
unset _co_generic_agent_mds _co_kx_status

agent=""
case "${1:-}" in
    "")                    agent=planning-orchestrator ;;
    p|plan|planner)        agent=planner; shift ;;
    c|coder)               agent=coder; shift ;;
    b|bug|bug-investigator) agent=bug-investigator; shift ;;
    f|fix|bug-fixer)       agent=bug-fixer; shift ;;
    e|exp|explain|explainer) agent=explainer; shift ;;
    a|arch|architect)      agent=architect; shift ;;
    rev|review|reviewer)   agent=reviewer; shift ;;
    # A leading `/` is a prompt (e.g. rollover's `/handoff-pickup <path>`,
    # spawn_successor's `co -r "/handoff-pickup <path>"`), not an agent name —
    # no agent name here starts with `/`. Leave it in place as the positional
    # prompt and take the branch's default agent. `--resume <session id>` is the
    # same: `co restore` types it for a crew with no recorded agent.
    /*|--resume)           agent=planning-orchestrator ;;
    *)                     agent=$1; shift ;;
esac

# Whether NAME is a Builder adopter's own crew: NOT a repo any registered
# project's `repos`/`aliases` names (`projects.project_for_repo` — a
# registered name, handled or deliberately left unhandled below, is
# unaffected by this and keeps whatever this file already does for it), yet
# the knowledge tree resolves it anyway through a bare `projects/<name>/`
# directory with no registry row at all (`projects.resolve_project`'s own
# fallback, company decision 0011) — the same admission `agentctl crew
# doctor`'s `check_registry` was fixed to make. THE SAME TWO FUNCTIONS, called
# directly, rather than a second list here that can (and did: this is the bug
# tidytags hit) fall out of step with the one the rest of the platform reads.
#
# NOT `projects.crew_for_repo`, which folds this exact fallback INTO its own
# answer (it calls `resolve_project` itself once no unit claims the repo), so
# it cannot tell "registered" apart from "adopter" — the distinction this
# whole check exists to make. `project_for_repo` stops at the registry alone.
_co_is_an_adopter_crew() {  # <name>
    local lib=$_co_self_dir/../lib/agent-platform
    [[ -d $lib ]] || lib=$_co_crews_root/agent-platform/lib/agent-platform
    python3 - "$lib" "$1" "$_co_crews_root/knowledge" "$(_co_registry_path)" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
try:
    import projects
    if sys.argv[4]:
        projects.PROJECTS_JSON = Path(sys.argv[4])
    projects._load_raw.cache_clear()
    name, root = sys.argv[2], sys.argv[3]
    if projects.project_for_repo(name) is not None:
        sys.exit(1)
    sys.exit(0 if projects.resolve_project(name, root) == name else 1)
except Exception:
    sys.exit(1)
PY
}

# Whether the crew registry can be read and parsed at all — the Library's
# `GET /registry` on a real launch (CQ·565; there is no file to resolve by
# default any more). Both `_co_generic_refresh_allowed` and
# `_co_is_an_adopter_crew` fail closed on a registry read error the same way
# they fail closed on a genuinely unrecognized name (`|| true` / `except
# Exception` with no distinct code), so `_co_generic_daytime_refresh`'s
# validator cannot otherwise tell "the registry is down" apart from "this
# directory really isn't a product" — the two cases that need different
# responses below (skip the refresh and launch, vs. refuse to launch at all).
_co_registry_readable() {
    python3 - "$(_co_lib_dir)" "$(_co_registry_path)" "$_co_crews_root" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
try:
    import projects

    if sys.argv[2]:
        projects.PROJECTS_JSON = Path(sys.argv[2])
    projects.ROOT_OVERRIDE = sys.argv[3]
    projects._load_raw.cache_clear()
    projects.load()
    sys.exit(0)
except Exception:
    sys.exit(1)
PY
}

# Refresh path: pull knowledge, re-individuate for cwd's product, then fall
# through to the launch step. Gate (recognized product or adopter crew),
# `_co_pull_knowledge` and `_co_reindividuate` live in one function so `-r`
# and the automatic staleness path below cannot apply different checks
# before calling `knowledge-ctx use --force` here — see
# `_co_refresh_if_stale`'s own comment for why (reviewer, PR #835 round 1).
# This is the least-restricted launch branch in the file (no enumerated
# directory name gates it), so letting the automatic path skip this
# validation would have been the widest version of that same gap.
#
# RETURNS 2, DISTINCT FROM 1, when the registry itself cannot be read for the
# `*)` case below — co must launch even when the registry cannot be read (see
# the Opus-pin fallback's own comment above), and that invariant covers this
# path too: the caller below treats 2 as "skip the refresh, launch anyway"
# rather than the hard failure 1 still means for a name that reads cleanly
# and simply isn't a recognized product (round 2, reviewer).
_co_generic_daytime_refresh() {
    # Must be inside a git tree.
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -z $repo_root ]]; then
        print -u2 "co: cwd is not inside a git tree. -r requires a product repo."
        return 1
    fi
    product=$(basename "$repo_root")
    case $product in
        # `knowledge` and `dev-setup` are two legacy workspace names with no
        # registry unit of their own (the KB repo itself, and a frozen build
        # workshop) — everything else reachable through this least-restricted
        # path names itself in the registry, via `co_generic_refresh: true`.
        knowledge|dev-setup) ;;
        *)
            if ! _co_registry_readable; then
                print -u2 "co: refresh — registry is unreadable; skipping the refresh."
                return 2
            fi
            if ! _co_generic_refresh_allowed "$product" && ! _co_is_an_adopter_crew "$product"; then
                # `${(V)product}` RATHER THAN RAW: $product is an unvalidated
                # git-toplevel basename (the same value issue_01M3Q2DJMB5R37HZD9SMVTS323
                # gates before it reaches _apply_co_style's OSC/tmux sinks),
                # and this print goes straight to the terminal with no gate
                # of its own. `(V)` renders a control byte as a visible
                # `^X`-style escape (two printable characters) instead of
                # the raw byte, so an ESC or BEL in the name cannot reach the
                # terminal as its own escape sequence.
                print -u2 "co: cwd is not a recognized product repo (got '${(V)product}')."
                print -u2 "    Run -r from a registered product's own directory,"
                print -u2 "    $_co_crews_root/knowledge, $_co_crews_root/dev-setup,"
                print -u2 "    or from a crew whose own projects/${(V)product}/ the knowledge tree resolves."
                return 1
            fi
            ;;
    esac
    print -u2 "co: refresh — product=${(V)product}"

    # 1. Pull the knowledge repo.
    print -u2 "co: refresh — pulling $_co_crews_root/knowledge"
    _co_pull_knowledge || {
        print -u2 "co: refresh — knowledge pull failed."
        return 1
    }

    # 2. Re-individuate daytime for this product. --force handles the
    #    KB-changed-since-last-activation case. ARCH-023's live-process
    #    pre-flight will refuse if the prior co session is still running —
    #    that's the safety net; exit it before re-running this script.
    #    (Skipped on a rollover successor — see _co_reindividuate.)
    _co_reindividuate daytime
}

if $refresh; then
    print -u2 "co: refresh — validating cwd"
    # `&& _co_gdr_rc=0 || _co_gdr_rc=$?`, not a bare statement followed by
    # `$?`: under this script's `set -eu`, an unguarded nonzero return here
    # would abort the whole script via errexit before the code could ever be
    # captured (same pitfall as `_co_kx_status` above).
    _co_generic_daytime_refresh && _co_gdr_rc=0 || _co_gdr_rc=$?
    # 1 is the hard failure (not a recognized product, or the pull/
    # reindividuate step itself failed) — unchanged, `-r` still refuses to
    # launch. 2 is the registry-unreadable case: the function already printed
    # why and ran neither the knowledge pull nor the reindividuate, so this
    # falls straight through to the launch below, the same as plain `co`.
    (( _co_gdr_rc == 1 )) && exit 1

    # If we're launching the default orchestrator with no positional
    # prompt, auto-add /handoff-pickup so the new session immediately
    # resumes from the most recent handoff. If the operator passed a prompt or a
    # non-default agent, respect that intent — don't override. Only on a
    # completed refresh (rc 0): a skipped refresh (rc 2) launches exactly as
    # plain `co` does, which does not add this on its own.
    if (( _co_gdr_rc == 0 )) && [[ $agent == planning-orchestrator && $# -eq 0 ]]; then
        set -- /handoff-pickup
    fi
    unset _co_gdr_rc
fi
_co_refresh_if_stale _co_generic_daytime_refresh

agent_file=".claude/agents/${agent}.md"
if [[ ! -f $agent_file ]]; then
    # ${(V)}: $(pwd) is cwd-derived (issue_01M3Q2DJMB5R37HZD9SMVTS323 round 2);
    # this is the generic daytime fallback — the single least-restricted path
    # in this file, reached by plain `co` in any repo with no agent individuated.
    print -u2 "co: agent '$agent' is not individuated in ${(V)$(pwd)}/.claude/agents/"
    print -u2 ""
    print -u2 "If you haven't activated this worktree:"
    print -u2 "  knowledge-ctx use daytime"
    print -u2 ""
    print -u2 "If you have activated and the agent still isn't there, it isn't"
    print -u2 "in this profile's include list. Run \`knowledge-ctx active\` to"
    print -u2 "see which profile is active, then check the profile YAML at"
    print -u2 "$_co_crews_root/knowledge/projects/<project>/profiles/<name>.yaml"
    exit 1
fi

# Per-product styling for the product daytime branch. $product was set
# earlier when validating cwd; if cwd wasn't a product (no refresh, no
# pre-validation), derive it from repo_root for styling only.
style_product=${product:-$(basename "${repo_root:-}")}
# A NAME BEFORE THE CASE: `_co_set_name` is overwritten below by a matched
# arm's `_apply_co_style`, or by the `*)` arm for everything else, but reaching
# here at all means the agent_file check above already passed — this cwd IS a
# launchable crew, named or not — so a name must be set before either can run.
_co_set_name "$style_product"
# `_apply_co_style` (reached here through `_co_apply_product_style`, or
# directly in the fallback below) is the one place that intercepts
# `--resolve` (see its own comment): a crew with no `co_accent` of its own —
# `knowledge`, `dev-setup`, or a Builder adopter's own crew the knowledge tree
# resolves with no registry row (company decision 0011) — used to fall
# straight to `_co_exec_claude` below, which under `--resolve` reports "no
# crew resolves" for a directory that plain `co` launches without complaint.
# The slate accent in the fallback matches the private-crew fallback's own
# slate (above); nothing claims a nicer colour for a crew the operator hasn't
# picked one for.
if ! _co_apply_product_style "$style_product"; then
    # GATED ON THE NAME RULE THE PLATFORM ALREADY ENFORCES ELSEWHERE
    # (projects._NAME_OK, lib/agent-platform/projects.py:408 —
    # ^[A-Za-z0-9][A-Za-z0-9._-]*$, literal ranges rather than a
    # locale-dependent [[:alnum:]] class). $style_product reaching here is a
    # bare git-toplevel basename that nothing has validated —
    # `_co_is_an_adopter_crew` only runs on the -r path — and `_apply_co_style`
    # writes it raw as `profile_name` into an OSC 1337 SetProfile sequence
    # (`co-$style_id`, both the tmux and non-tmux branches). A basename
    # carrying a control byte (BEL, ESC) would close that sequence early and
    # inject its own escapes into the terminal (security-reviewer, PR #709).
    # $style_id also supplies `label`'s default here (no $3 passed), so
    # gating the call itself — rather than sanitizing inside
    # `_apply_co_style` — skips every sink fed by this value in one place:
    # profile_name, label, title, status-left and rename-window alike. A name
    # that fails launches unstyled, and `--resolve` correctly reports no crew
    # resolving for it (the call that would say otherwise never runs) rather
    # than claiming a name it never validated.
    if [[ $style_product =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        _apply_co_style "$style_product" "#5b6b7a"
    fi
fi

_co_exec_claude --remote-control $_co_name_args $claude_model_args --agent "$agent" --permission-mode $_co_permission_mode "$@"
