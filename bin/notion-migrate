#!/usr/bin/env python3
"""notion-migrate: one-shot migration of existing Notion pages to <root>/knowledge/.

For each MIGRATION entry, walk the subtree rooted at the Notion page id,
classify each page's kind/project per the rule set, convert blocks to
markdown, and emit <root>/knowledge/projects/<project>/<kind-dir>/<slug>.md.

Default mode is --dry-run (prints what would be written; no writes).
Use --commit to actually write files.

Spec: 01-knowledge-infra.md deliverable 2.7. Migration plan agreed
with the operator 2026-05-18 (calls 1-5 resolved).
"""
from __future__ import annotations

import argparse
import re
import sys
import time
from pathlib import Path
from typing import Any

