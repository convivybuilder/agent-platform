# --- frontmatter + agent resolution -----------------------------------------


def _parse_frontmatter(text: str) -> tuple[dict, str]:
    """Tiny YAML-ish parser. Handles scalar fields, single-line `[a, b]` lists,
    and a folded multi-line scalar (a key's value continuing onto following
    lines indented past column 0 — the shape every real `LOCAL_AGENT_REPOS`
    roster's `tools:` grant wraps to once it's long). A continuation line is
    joined onto the PRECEDING key's raw value (space-separated) before any
    key is parsed, rather than read as a line of its own — read on its own, an
    embedded `:` inside a continuation line (e.g. `Bash(git diff:*)`) would
    split it into a spurious extra key, and a continuation line with no `:`
    at all would be silently dropped (security-reviewer, PR #811 round 2).
    Returns (frontmatter_dict, body_text)."""
    if not text.startswith("---"):
        return {}, text
    end = text.find("\n---", 3)
    if end < 0:
        return {}, text
    block = text[3:end].lstrip("\n")
    body = text[end + len("\n---"):].lstrip("\n")
    raw: dict[str, str] = {}
    last_key: str | None = None
    for line in block.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[:1].isspace() and last_key is not None:
            raw[last_key] += " " + line.strip()
            continue
        if ":" not in line:
            continue
        key, _, val = line.partition(":")
        key = key.strip()
        raw[key] = val.strip()
        last_key = key
    fm: dict = {}
    for key, val in raw.items():
        if val.startswith("[") and val.endswith("]"):
            inner = val[1:-1].strip()
            fm[key] = [s.strip() for s in inner.split(",")] if inner else []
        elif val.startswith('"') and val.endswith('"'):
            fm[key] = val[1:-1]
        else:
            fm[key] = val
    return fm, body


def _parse_tool_rules(value) -> list[str]:
    """A frontmatter `tools:` value as a list of individual tool rules.

    A real list (the bracket form `_parse_frontmatter` already parses, or the
    Library's served `tools` field) passes through unchanged. A string — what
    every real `LOCAL_AGENT_REPOS` roster file writes, one line or folded
    across several and already joined whole by `_parse_frontmatter` above —
    is a comma-separated grant, split on commas OUTSIDE parentheses so a rule
    like `Bash(agentctl review-post:*)` (whose own text contains a comma-free
    but colon-bearing argument pattern) stays one rule rather than splitting
    on a comma that belongs to a DIFFERENT rule's parenthesized argument."""
    if isinstance(value, list):
        return value
    if not isinstance(value, str) or not value.strip():
        return []
    rules: list[str] = []
    current: list[str] = []
    depth = 0
    for ch in value:
        if ch == "(":
            depth += 1
            current.append(ch)
        elif ch == ")":
            depth = max(0, depth - 1)
            current.append(ch)
        elif ch == "," and depth == 0:
            rule = "".join(current).strip()
            if rule:
                rules.append(rule)
            current = []
        else:
            current.append(ch)
    rule = "".join(current).strip()
    if rule:
        rules.append(rule)
    return rules


# Repos whose dev crew lives in their own `<repo>/.claude/agents/` and is the
# CANONICAL source — deliberately NOT in the shared knowledge index (ARCH-101/177).
# Products are excluded on purpose: their `.claude/agents/` are *individuated*
# copies of the indexed source, so they must still resolve from the index (the
# single source of truth) — agentctl product spawns stay byte-identical. Gating on
# this allowlist, not on `.claude/agents/` existence, is what keeps products on the
# index (they all have an individuated `.claude/agents/` too).
# convivy-deck is repo-local like the others (its crew is canonical in
# convivy-deck/.claude/agents/ and stays OFF the shared index), and additionally
# has its crew NAMES registered in the roster allowlist (ARCH-382 [J6]). Roster
# registration is a separate registry from the index — being "known" to the roster
# does not put the doc bodies in the index, so deck belongs here exactly like hollis.
# EA'S AGENTS ARE INDIVIDUATED INTERACTIVELY AND READ BACK LOCALLY, AND DISPATCH
# NEVER INDIVIDUATES THEM (2026-09-08). The two halves are worth stating together
# because a first version of this comment got the second one wrong.
#
# `resolve_agent` reads `EA/.claude/agents/` for every repo listed here and
# returns before touching the shared index, so a spawn carries `local: True`.
# `cmd_spawn` then takes the sentinel profile `EA/none` and SKIPS
# `activate_profile` entirely — so no dispatch on EA ever runs `knowledge-ctx
# use`, resolves a profile, or consults `knowledge-ctx._PROFILE_ALLOWLIST`.
# That is ARCH-177 working as designed and is unchanged by the EA row below.
#
# **SO THE FILES GET THERE BY AN OPERATOR RUNNING `knowledge-ctx use ea-daytime`
# IN THAT DIRECTORY, and dispatch only reads what is already on disk.** An
# earlier revision of this PR added a per-repo default profile so that a spawn
# would ask for `ea-daytime` instead of `platform/daytime`; it was dead code,
# because `default_profile` is not reached for a local-resolved repo. Removed
# rather than left as future-proofing for a condition nobody has (reviewer,
# PR #513, round 2).
#
# `knowledge-ctx use --force` rmtrees `agents/` and `skills/` before rewriting,
# so anything hand-authored in that directory is deleted by the next refresh. To
# give EA a bespoke agent, add it to the profile. Do NOT drop a file in and
# expect it to survive.
#
# CFO cannot hit that and the asymmetry is the reason: CFO has no profile, so
# nothing ever runs `--force` in its directory and its four hand-authored agents
# are safe. Giving EA a profile is what creates the collision.
#
# No guard is built for it, deliberately: `EA/.claude/agents/` holds nothing
# hand-authored today, so there is no occurrence to defend against, and a guard
# refusing `--force` on an unexpected file would block the refresh the profile
# exists to enable. Revisit if a bespoke EA agent is ever written.
LOCAL_AGENT_REPOS = ("CFO", "EA")

# ONLY THE BLACK BOXES ARE HERE, AND THAT IS THE POINT RATHER THAN AN ACCIDENT OF
# ATTRITION. EA joined CFO on 2026-09-06 on the same terms: a private crew whose
# agents, if any, are repo-local and unprefixed under EA/.claude/agents/.
# This list held six until 2026-08-25, and the five that left were there for a
# different reason from the one that remains.
#
# `hollis`, `selector`, `convivy-app-kit`, `convivy-deck` and `convivy-services`
# were kept off the shared index as a SCOPING choice (ARCH-243/177) — they are
# self-contained internal apps and their crews were nobody else's business. The operator's
# 2026-08-17 directive reverses that: all materials for all agents live in the
# Reference Room so the Bosun can retrieve them for individuation. Their 25
# definitions are indexed, each repo has a profile, and they now resolve through
# the shared path like every other product.
#
# CFO is a BLACK BOX (platform/decisions/0043): its agents must never enter the
# shared index at all, so this is a PRIVACY CONTROL rather than a tidiness one,
# and no directive about agent materials reaches it. "None of its content
# reaching the Library" is the decision's own wording. It is layer 3 of three,
# and the outermost layer — `bin/co` launching CFO with `--strict-mcp-config` —
# is the one that holds under `bypassPermissions`. This entry is what stops
# `resolve_agent` reading, or the indexer writing, CFO's four agents through the
# shared path.
#
# So the list is not "repos we have not migrated yet". Anything added here is
# being walled, and the reason has to be privacy rather than scope. `Ask` is the
# other black box named by ADR-0043 and is NOT here, which is a real gap tracked
# as issue_01M0X1J5SNXAPDC964WCWXXC17 — it has no registry entry either, so
# nothing enforces its wall today.
#
# Capital `CFO` because this tuple is matched against the REPO DIRECTORY name and
# the directory is capital on disk; the registry slug is lower-case `cfo`.

# ARCH-389's generated-provenance mode is RETIRED (ARCH-390). It existed so queue-sync
# could write the overnight queues, which lived in the provenance-gated KB and could
# not go through factual-sync (ARCH-388). Moving those queues to substrate/queues/
# removed the only consumer, and an unused path that writes the KB without a verifier
# is a liability in a cage whose whole job is that no such path exists. Deleted rather
# than kept for a hypothetical second generator: when one appears, re-add it with the
# paths it owns and the reasoning it needs, which is cheaper than auditing a bypass
# nothing exercises.


def resolve_agent(name: str, repo: str | None = None, agents_dir: str | None = None) -> dict:
    """Resolve an agent by short name to its definition.

    Resolution order (ARCH-177, E9·5):
      1. `--agents-dir` override → read `<agents_dir>/<name>.md` off disk.
      2. repo-local → if `repo` is a LOCAL_AGENT_REPOS internal app, read
         `<root>/<repo>/.claude/agents/<name>.md`. Returns BEFORE any
         Library call, so an internal app's spawn never reaches the Library.
      3. the Library's served definition (`GET /reference/documents`). Nothing
         is read from the knowledge index or the checkout. An unreachable
         Library, or an agent it does not hold, refuses the dispatch
         (SystemExit naming the Library); there is no fallback.

    A locally-resolved agent carries `"local": True` and has no knowledge-ctx
    profile (the caller skips `activate_profile`)."""
    # Agent names are lowercase-kebab. Constrain before building any path so a
    # crafted name (e.g. `../../etc/x`) can't read an arbitrary `*.md` on the
    # repo-local / --agents-dir path (defence in depth — reviewer note, ARCH-177).
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
        raise SystemExit(f"invalid agent name {name!r} (expected lowercase-kebab)")
    local_dir: Path | None = None
    if agents_dir:
        local_dir = Path(agents_dir).expanduser()
    elif repo in LOCAL_AGENT_REPOS:
        local_dir = _root() / repo / ".claude" / "agents"
    if local_dir is not None:
        source_path = local_dir / f"{name}.md"
        if not source_path.is_file():
            raise SystemExit(f"agent {name!r} not found in {local_dir}")
        fm, body = _parse_frontmatter(source_path.read_text())
        return {
            "id": f"local/{name}", "name": name, "project": repo or "local",
            "source": str(source_path), "body": body, "frontmatter": fm,
            "model_alias": fm.get("model"), "tools": _parse_tool_rules(fm.get("tools", [])),
            # `builtins:` (issue_01M4C04GYC3R9NPZCK9RTYPASZ, CQ·426), read like `tools:`
            # above but kept `None` when the key is absent — `_resolved_agent_builtins`
            # needs that to tell "no override" apart from an explicit empty list.
            "builtins": _parse_tool_rules(fm["builtins"]) if "builtins" in fm else None,
            "status": "current", "local": True,
        }
    doc = _library_agent(name)
    if doc.get("status") == "deprecated":
        print(f"WARNING: agent {name!r} is marked deprecated", file=sys.stderr)
    model = doc["model"]
    tools = doc.get("tools") or []
    return {
        "id": doc.get("id"), "name": name, "project": doc.get("project"),
        # No local file, so `dispatch_is_private` gets a None source and checks the
        # repo alone. That holds only while the Library serves no private crew's
        # agent: ADR-0043 keeps black-box agents repo-local and out of the shared
        # index, and its Library-side exclusion (layer 2) did not exist when written.
        "source": None,
        "body": doc["body"],
        # The served fields in the shape `model_floor_for` reads (ARCH-378).
        "frontmatter": {"model": model, "tools": tools,
                        "model_floor": doc["model_floor"]},
        "model_alias": model,
        "tools": tools,
        # The Library's served `builtins:`, carried through unparsed like `tools` above
        # (issue_01M4C04GYC3R9NPZCK9RTYPASZ, CQ·426) — `doc.get` already yields `None`
        # when the Library's record has no such field, which is the signal
        # `_resolved_agent_builtins` reads as "no override".
        "builtins": doc.get("builtins"),
        "status": doc.get("status"),
        "local": False,
    }


# The Library read that resolves an agent, and (CQ·371) the same fixed
# address/token/opener a profile-existence check uses. Fixed address and the
# Bosun's own token, with no proxy and no redirects, the same as the
# `--issue` read (`issue_client.get_item_from_default_library`): a definition
# decides the model and tool policy a run gets, so nothing the dispatching
# process controls may repoint it. A timeout is a refusal, not a fallback.
_LIBRARY_AGENT_TIMEOUT_S = 10
_LIBRARY_AGENT_PAGE = 200


def _library_get(path: str, name: str) -> dict:
    """One GET on the Library's fixed address, as a JSON object. `name` is
    what this read was for, named in every refusal. Every failure raises
    SystemExit naming the Library and the refused dispatch."""
    import http.client
    import urllib.error
    import urllib.request
    import issue_client as IC
    import vault_plane as VP
    try:
        tok = SC.TOKEN_FILE.read_text().strip()
    except OSError as e:
        raise SystemExit(f"dispatch refused: cannot resolve {name!r} from the "
                         f"Library; its credential at {SC.TOKEN_FILE} is unreadable "
                         f"({type(e).__name__})")
    req = urllib.request.Request(VP.fixed_library_url(path),
                                 headers=VP.library_headers(token=tok))
    try:
        with IC.pinned_opener().open(req, timeout=_LIBRARY_AGENT_TIMEOUT_S) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        raise SystemExit(f"dispatch refused: the Library answered HTTP {e.code} for "
                         f"{name!r} ({path})")
    except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
        # HTTPException covers a body cut short mid-read (IncompleteRead), which is
        # not an OSError and would otherwise escape as a traceback.
        raise SystemExit(f"dispatch refused: the Library is unreachable "
                         f"({type(e).__name__}); cannot resolve {name!r}")
    try:
        body = json.loads(raw.decode("utf-8"))
    except ValueError as e:
        raise SystemExit(f"dispatch refused: the Library answered {path} with malformed "
                         f"JSON ({type(e).__name__}); cannot resolve {name!r}")
    if not isinstance(body, dict):
        raise SystemExit(f"dispatch refused: the Library answered {path} with a non-object")
    return body


def _library_profile_variants() -> list[tuple[str, str]]:
    """`(project, variant)` for every profile the Library holds (`GET
    /profiles`) — the same route `bin/knowledge-ctx`'s own
    `_library_profile_variants` reads, so `default_profile`'s existence
    checks ask the same source a render will resolve a profile against,
    with no knowledge-tree disk read (CQ·371, issue_01M43AE2QD6H3JZMKM2RR2NK2W)."""
    page = _library_get("/profiles", "the Library's profile listing")
    profiles = page.get("profiles")
    if not isinstance(profiles, list):
        raise SystemExit("dispatch refused: the Library's profile listing has no "
                         "'profiles' list")
    out: list[tuple[str, str]] = []
    for p in profiles:
        if (not isinstance(p, dict) or not isinstance(p.get("project"), str)
                or not isinstance(p.get("variant"), str)):
            raise SystemExit("dispatch refused: the Library's profile listing has a "
                             "malformed row")
        out.append((p["project"], p["variant"]))
    return out


def _variants_has_profiles(variants: list[tuple[str, str]], project: str) -> bool:
    """`projects.has_profiles`, answered from the Library's profile listing
    instead of a `projects/<project>/profiles/` directory walk (CQ·371):
    `platform`'s own fallback (`platform/default`) does not count as a
    profile of `platform`'s own, matching `knowledge-ctx`'s `_has_profiles`."""
    names = [v for p, v in variants if p == project]
    if project == projects.DEFAULT_PROFILE_PROJECT:
        names = [v for v in names if v != projects.DEFAULT_PROFILE_NAME]
    return bool(names)


def _library_agent(name: str) -> dict:
    """The Library's served record for the agent `name`, body included.

    The listing filters by kind and status, not by name, so every agent page is
    read and matched on the id suffix `/agents/<name>`, which is the match the
    index's LIKE made. `status=all` keeps retired agents visible, as the index
    read did. Several projects holding one name resolve to agent-platform's
    (ARCH-426); otherwise the name is ambiguous and the dispatch is refused.

    `tools` is not checked here. `resolve_agent` maps every falsy served value
    (null, absent, "", false, 0, {}) to `[]`, since it uses `doc.get("tools") or []`;
    any truthy value, including a non-list, passes through unchanged. The read
    that matters is `_resolved_agent_tools`, which `_run_session` calls to union
    this value into the dispatch's `--tools`/`--mcp-config` tool surface
    (issue_01M4BT13RP23KRTA80VM6R7HNF) — it refuses the dispatch outright if the
    resolved value isn't a list of strings, so a served non-list value is caught
    there, not here."""
    import urllib.parse
    rows: list[dict] = []
    offset = 0
    while True:
        page = _library_get(f"/reference/documents?kind=agent&status=all"
                            f"&limit={_LIBRARY_AGENT_PAGE}&offset={offset}", name)
        found = page.get("documents")
        if not isinstance(found, list):
            raise SystemExit(f"dispatch refused: the Library's agent listing for "
                             f"{name!r} has no documents list")
        if not all(isinstance(r, dict) for r in found):
            # A row that is not an object refuses the whole listing: dropping it could
            # hide a canonical copy and resolve another project's agent of the same
            # name. An object row whose id is missing or not a string is skipped by
            # the id match below, not refused.
            raise SystemExit(f"dispatch refused: the Library's agent listing for "
                             f"{name!r} has a row that is not an object")
        truncated = page.get("truncated")
        if not isinstance(truncated, bool):
            # Read as the last page, a page without this key would hide a later copy.
            raise SystemExit(f"dispatch refused: the Library's agent listing for "
                             f"{name!r} has no boolean 'truncated'; cannot tell whether "
                             f"a later page holds another copy")
        rows += found
        if not truncated:
            break
        if not found:
            raise SystemExit(f"dispatch refused: the Library's agent listing for "
                             f"{name!r} is truncated but returned no rows")
        offset += len(found)
    matches = [r for r in rows if str(r.get("id", "")).endswith(f"/agents/{name}")]
    if not matches:
        raise SystemExit(f"agent {name!r} not found in the Library (kind: agent)")
    if len(matches) > 1:
        canonical = [r for r in matches if r.get("project") == "agent-platform"]
        if not canonical:
            raise SystemExit(f"ambiguous agent {name!r}; matches: "
                             f"{[r.get('id') for r in matches]}")
        matches = canonical
    doc_id = str(matches[0]["id"])
    doc = _library_get("/reference/documents/" + urllib.parse.quote(doc_id, safe="/"), name)
    if doc.get("kind") != "agent" or not isinstance(doc.get("body"), str):
        raise SystemExit(f"dispatch refused: the Library's record for {doc_id!r} is not "
                         f"an agent definition with a body")
    # Each field is checked, not defaulted: a missing model would dispatch on the
    # default model, so the record is refused rather than read with a fallback.
    record = f"the Library's record for agent {name!r} ({doc_id})"
    if not isinstance(doc.get("model"), str) or not doc["model"].strip():
        raise SystemExit(f"dispatch refused: {record} has no non-empty model")
    if "model_floor" not in doc or not (doc["model_floor"] is None
                                        or isinstance(doc["model_floor"], str)):
        raise SystemExit(f"dispatch refused: {record} has no model_floor that is a "
                         f"string or null")
    return doc


# --- materializing an agent from a Library checkout grant (issue_01M4AEY9RGJVTCBNEY3YN49DCG) ---
#
# A second materialization path, beside `resolve_agent`'s roster render: a
# dispatch with a work item can take its persona, documents, model and
# limits from the call-slip grant `POST /items/{id}/checkout` already
# returns (ADR-0062; Library app.py `_call_slip_grant`), rather than from the
# Library's served agent definition plus a knowledge-ctx profile render. The
# grant's `budget.cap_usd` is the run's per-run dollar cap (the operator's 2026-10-07
# ruling, slate a-1ommg6) — see `_run_cost_cap_for_agent`, which reads it ahead
# of `_run_cost_cap`'s ordinary default/env fallback.
# Selected explicitly by `spawn --materialize-from-grant`; the roster render
# in `resolve_agent` stays the default and is untouched by any of this.
#
# This does not redeem the slip or hold a library card — that is E15·2
# (issue_01M35KR8VAC656WMQTY9D8SJ1H), gated on the Library's client
# authentication, which does not exist yet. The grant is read and discarded;
# `slip_id` is carried through the returned dict unused.
_LIBRARY_GRANT_TIMEOUT_S = 10


def _library_post(path: str, name: str, body: dict) -> tuple[int, dict]:
    """One POST to the Library's FIXED default address, as `(status, body)`.

    The fixed address, pinned opener and direct token-file read are the same
    transport `_library_get` uses, for the same reason: a checkout decides a
    dispatch's agent and model, so nothing the dispatching process's
    environment controls (`LIBRARY_BASE_URL`, `VAULTS_ON_LIBRARY`, a proxy
    variable) may change where the request goes or whose identity rides on
    it.

    Unlike `_library_get`, a non-2xx answer is returned rather than raised:
    a checkout's 409 ("already claimed"/held) is a routing signal a caller
    reads and acts on, not a Library failure. An unreachable Library or a
    malformed answer still raises SystemExit, naming the refused dispatch."""
    import http.client
    import urllib.error
    import urllib.request
    import issue_client as IC
    import vault_plane as VP
    try:
        tok = SC.TOKEN_FILE.read_text().strip()
    except OSError as e:
        raise SystemExit(f"dispatch refused: cannot {name} against the Library; its "
                         f"credential at {SC.TOKEN_FILE} is unreadable ({type(e).__name__})")
    req = urllib.request.Request(VP.fixed_library_url(path),
                                 data=json.dumps(body).encode("utf-8"), method="POST",
                                 headers=VP.library_headers(token=tok, json_body=True))
    try:
        with IC.pinned_opener().open(req, timeout=_LIBRARY_GRANT_TIMEOUT_S) as resp:
            raw = resp.read()
        status = 200
    except urllib.error.HTTPError as e:
        raw = e.read()
        status = e.code
    except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
        raise SystemExit(f"dispatch refused: the Library is unreachable "
                         f"({type(e).__name__}); cannot {name}")
    try:
        parsed = json.loads(raw.decode("utf-8")) if raw else {}
    except ValueError as e:
        raise SystemExit(f"dispatch refused: the Library answered {path} with malformed "
                         f"JSON ({type(e).__name__}); cannot {name}")
    if not isinstance(parsed, dict):
        raise SystemExit(f"dispatch refused: the Library answered {path} with a non-object; "
                         f"cannot {name}")
    return status, parsed


def _checkout_item_grant(issue_id: str, *, owner: str | None, run_id: str | None) -> dict:
    """`POST /items/{id}/checkout` on the Library's fixed address, returning
    the full response (item, lease, policy, claimed, adjacency, plus the
    call-slip grant's own fields).

    Taking the lease is a side effect of the call the grant cannot be read
    without: `_do_checkout` (Library app.py) claims the item and takes its
    epic's lease, then mints the slip, atomically. `resolve_agent_from_grant`
    releases what this takes, in a `finally` — see its docstring for how long
    it is held. A held item (409) and an unreachable Library both refuse the
    dispatch; neither falls back to the roster render."""
    import urllib.parse
    body: dict = {}
    if owner:
        body["owner"] = owner
    if run_id:
        body["run_id"] = run_id
    status, parsed = _library_post(
        f"/items/{urllib.parse.quote(issue_id, safe='')}/checkout",
        f"check out {issue_id!r} for its materialization grant", body)
    if status != 200:
        error = parsed.get("error") if isinstance(parsed.get("error"), str) else str(parsed)
        raise SystemExit(f"dispatch refused: the Library refused to check out {issue_id!r} "
                         f"for its materialization grant (HTTP {status} {error})")
    return parsed


def _release_item_grant(issue_id: str, *, owner: str | None) -> None:
    """Best-effort `POST /items/{id}/release` on the Library's fixed address.

    Never raises: a release that fails leaves the lease to lapse on its own
    TTL (independent of the checkout lock, per the call slip's own grant)
    rather than masking whatever `resolve_agent_from_grant` is already
    returning or raising from the `try` this runs in `finally` for."""
    import urllib.parse
    body: dict = {}
    if owner:
        body["owner"] = owner
    try:
        _library_post(f"/items/{urllib.parse.quote(issue_id, safe='')}/release",
                      f"release {issue_id!r}", body)
    except SystemExit as e:
        print(f"  grant materialization: could not release the checkout lease on "
              f"{issue_id!r} ({e}); it will lapse on its own TTL", file=sys.stderr)


def _verify_grant_document(doc_id: str, expected_sha256: str, issue_id: str) -> dict:
    """`GET /reference/documents/{id}` on the fixed address, refusing a body
    that does not hash to its own `body_sha256` or to the one the checkout
    grant listed for it.

    The same two-moment check knowledge-ctx's `collect_matches` /
    `_verified_document` run for a rendered bundle (agent-platform#772): the
    grant and the body are read at different times, and a Library write
    landing between them must not be individuated as if it had not."""
    import urllib.parse
    doc = _library_get("/reference/documents/" + urllib.parse.quote(doc_id, safe="/"), doc_id)
    for key in ("id", "source_ref", "kind", "title", "body", "body_sha256"):
        if not isinstance(doc.get(key), str):
            raise SystemExit(f"dispatch refused: the Library's document {doc_id!r} "
                             f"(checkout grant for {issue_id!r}) has no non-empty {key!r}")
    if hashlib.sha256(doc["body"].encode("utf-8")).hexdigest() != doc["body_sha256"]:
        raise SystemExit(f"dispatch refused: the Library's document {doc_id!r} does not "
                         f"match its own body_sha256")
    if doc["body_sha256"] != expected_sha256:
        raise SystemExit(f"dispatch refused: the Library changed {doc_id!r} between the "
                         f"checkout grant for {issue_id!r} and its body")
    return doc


def _agent_from_grant(issue_id: str, response: dict, *, repo: str | None) -> dict:
    """Build a `resolve_agent`-shaped dict from one checkout response's
    call-slip grant (ADR-0062; Library app.py `_call_slip_grant`):
    `{slip_id, persona_md, docs, bundle, model, budget, limits}` alongside
    the unchanged `item`/`lease`/`policy`/`adjacency`.

    `claimed: false` (platform/decisions/0079) is a 200 the checkout still
    answers with when the item has unmet prerequisites: the lease is taken
    but no claim and no call slip is minted, so `persona_md` and the rest of
    the grant fields are absent by design, not malformed. Checked and
    refused by name, naming the item as blocked with the response's own
    `unmet_count` and hint, before any of the field-presence checks below
    read a grant that was never minted.

    Every field below is read raw and checked by hand, the same posture
    `_library_agent` takes for a served agent record: a missing or malformed
    field refuses the dispatch by name. There is no fallback to the roster
    render on this path."""
    record = f"the Library's checkout grant for {issue_id!r}"
    if response.get("claimed") is False:
        raise SystemExit(
            f"dispatch refused: {issue_id!r} is blocked, not claimed "
            f"(unmet_count={response.get('unmet_count')!r}); {response.get('hint')}")
    persona_md = response.get("persona_md")
    if not isinstance(persona_md, str) or not persona_md.strip():
        raise SystemExit(f"dispatch refused: {record} has no non-empty 'persona_md'")
    model = response.get("model")
    if not isinstance(model, str) or not model.strip():
        raise SystemExit(f"dispatch refused: {record} has no non-empty 'model'")
    docs = response.get("docs")
    if not isinstance(docs, list):
        raise SystemExit(f"dispatch refused: {record} has no 'docs' list")
    budget = response.get("budget")
    if not isinstance(budget, dict) or "cap_usd" not in budget:
        raise SystemExit(f"dispatch refused: {record} has no 'budget' carrying 'cap_usd'")
    cap_usd = budget["cap_usd"]
    if cap_usd is not None and (isinstance(cap_usd, bool) or not isinstance(cap_usd, (int, float))):
        raise SystemExit(f"dispatch refused: {record} has a 'budget.cap_usd' that is "
                         f"neither null nor a number")
    limits = response.get("limits")
    if not isinstance(limits, dict):
        raise SystemExit(f"dispatch refused: {record} has no 'limits' object")
    documents = []
    for listed in docs:
        if not isinstance(listed, dict):
            raise SystemExit(f"dispatch refused: {record} has a 'docs' entry that is not "
                             f"an object")
        doc_id, doc_sha = listed.get("id"), listed.get("body_sha256")
        if not isinstance(doc_id, str) or not doc_id:
            raise SystemExit(f"dispatch refused: {record} has a 'docs' entry with no "
                             f"non-empty 'id'")
        if not isinstance(doc_sha, str) or not doc_sha:
            raise SystemExit(f"dispatch refused: {record} has a 'docs' entry with no "
                             f"non-empty 'body_sha256'")
        documents.append(_verify_grant_document(doc_id, doc_sha, issue_id))
    return {
        "id": f"grant/{issue_id}", "name": issue_id, "project": repo or "local",
        "source": None, "body": persona_md,
        "frontmatter": {"model": model, "tools": [], "model_floor": None},
        "model_alias": model, "tools": [], "status": "current", "local": False,
        "grant": {"slip_id": response.get("slip_id"), "budget": budget, "limits": limits,
                  "documents": documents},
    }


def resolve_agent_from_grant(issue_id: str, *, repo: str | None = None,
                             owner: str | None = None,
                             run_id: str | None = None,
                             agent_name: str | None = None,
                             agents_dir: str | None = None) -> dict:
    """Materialize a dispatched agent from a Library checkout grant, instead
    of `resolve_agent`'s roster render (issue_01M4AEY9RGJVTCBNEY3YN49DCG).

    `POST /items/{id}/checkout` both mints the grant and takes the Library's
    lease on the item — the claim plus its epic's lease — as one atomic
    write; there is no way to read the grant without taking it. This holds
    that lease for exactly the round trip needed to read and verify the
    grant, releasing it in `finally` below, the same synchronous,
    request-scoped shape `_fetch_work_item` already gives `spawn --issue`'s
    model-choice read. It does NOT hold the lease for the dispatched run's
    lifetime — who would hold a lease across a detached run, and release it
    at the run's end, is a separate design question this item does not
    answer (see the PR body for `agent-platform` for how it is left).

    `agent_name` (CQ·434, issue_01M4D39EFVVJS9Q5XTN7HEFTEM): the checkout
    grant carries a persona, a model and a budget, but no `builtins:` — #818's
    round-1 reviewer found that a dispatch materialized this way got none of
    its `--tools` saving no matter what the dispatched ROLE's own definition
    says. Rather than teach this function a second `builtins:` reader, it
    calls the exact `resolve_agent` the roster path already calls for
    `agent_name` and carries through only its `builtins` field — so the two
    paths can never answer differently for the same role. `None` (the
    default: no role name given) leaves `agent["builtins"]` unset, same as
    before this change.

    That lookup runs BEFORE `_checkout_item_grant` (#825 round-1: this
    function's own docstring says the grant path never falls back to the
    roster render for the dispatched agent, so `agent_name` not resolving
    there must not claim the work item and then fail on it). A role that
    does not resolve writes one line to stderr and the dispatch proceeds
    with no builtins override, the same "every built-in tool loads"
    behaviour as `None`.

    Does not redeem the slip or hold a library card — that is E15·2
    (issue_01M35KR8VAC656WMQTY9D8SJ1H), gated on the Library's client
    authentication."""
    import issue_client as IC
    have_builtins_override = False
    builtins_override = None
    if agent_name:
        try:
            builtins_override = resolve_agent(
                agent_name, repo=repo, agents_dir=agents_dir).get("builtins")
            have_builtins_override = True
        except SystemExit as e:
            print(f"  grant materialization: role {agent_name!r} does not "
                  f"resolve ({e}); dispatching with no builtins override "
                  f"(every built-in tool loads)", file=sys.stderr)
    owner = owner or IC.session_owner()
    response = _checkout_item_grant(issue_id, owner=owner, run_id=run_id)
    try:
        agent = _agent_from_grant(issue_id, response, repo=repo)
    finally:
        _release_item_grant(issue_id, owner=owner)
    if have_builtins_override:
        agent["builtins"] = builtins_override
    return agent


def model_id(alias_or_id: str | None) -> str:
    if not alias_or_id:
        return DEFAULT_MODEL
    return MODEL_ALIASES.get(alias_or_id, alias_or_id)


# Capability tiers for the ARCH-378 fail-over floor. Only the ORDER matters, and
# only for answering "is the fail-over target at least as capable as this agent's
# floor" — these are not quality scores and nothing else should read them.
#
# Every Anthropic snapshot is listed by resolved id rather than by family prefix,
# so adding a model is a deliberate edit here. An id absent from this map ranks
# BELOW every floor (`_model_tier` returns 0), which is the fail-closed direction:
# an unrecognised model can never satisfy a floor, so a new provider cannot start
# silently passing one by being unknown.
#
# Gateway models sit under haiku as a class. That is a statement about what a
# fail-over may silently substitute, not a claim about their general ability: the
# 2026-07-19 incident was 17 review-class runs completing on deepseek-flash after
# an opus/sonnet death, and the floor exists to stop exactly that swap.
_MODEL_TIERS = {
    "claude-opus-5-5": 40,
    "claude-opus-5": 40,
    "claude-opus-4-8": 40,
    "claude-opus-4-7": 40,
    "claude-sonnet-5": 30,
    "claude-sonnet-4-6": 30,
    "claude-haiku-4-5": 20,
}
_GATEWAY_TIER = 10


def _model_tier(model_id_str: str | None) -> int:
    """Capability rank of a resolved model id. 0 for anything unrecognised."""
    if not model_id_str:
        return 0
    base = model_id_str.split("[")[0]          # strip a `[1m]` context suffix
    if base in _MODEL_TIERS:
        return _MODEL_TIERS[base]
    if is_gateway_model(base):
        return _GATEWAY_TIER
    return 0


def model_floor_for(agent: dict) -> str:
    """The resolved model id this agent must never run below (ARCH-378).

    Read from the `model_floor` the Library serves, and **defaulting to the agent's
    own declared `model:` when null** — so non-degradation is what you get without
    saying anything, and accepting a downgrade is the opt-in. The operator's call, and the
    reason it matters is that the roster predates this field: every agent written
    before ARCH-378 is protected without being edited, including every reviewer.

    The served floor is derived from the knowledge index, so a floor raised in
    knowledge but not yet reindexed is served at its older value. That is the
    reindex lag the Library already has for `model` and `tools`, accepted here
    rather than worked around. The null fallback is the fail-closed side.
    """
    fm = agent.get("frontmatter") or {}
    # `model_alias` is the canonical resolved field (`resolve_agent` sets it from
    # frontmatter `model:`); read it rather than re-deriving, and keep the
    # frontmatter reads as the fallback for a dict built without it.
    return model_id(fm.get("model_floor")
                    or agent.get("model_alias")
                    or fm.get("model"))


def is_gateway_model(model_id_str: str) -> bool:
    """Return True iff model_id_str is served by the local LiteLLM gateway.

    Fails closed to Anthropic-direct: an unknown literal that matches no
    GATEWAY_MODEL_PREFIXES entry returns False, preserving today's behavior.
    This is the load-bearing safety property (Phase C, ARCH-102).
    """
    return any(model_id_str.startswith(p) for p in GATEWAY_MODEL_PREFIXES)


# The slugs Codex serves ("gpt-6-astra", "gpt-5.5", "codex-auto-review", ...).
# Gateway ids carry a provider prefix and a slash, which this pattern excludes,
# so "openai/gpt-5" stays a gateway model.
_CODEX_MODEL_RE = re.compile(r"(?:gpt|codex)-[A-Za-z0-9][A-Za-z0-9._-]*")


def is_codex_model(model_id_str: str) -> bool:
    """True iff the resolved model string names a model the Codex CLI serves."""
    return bool(_CODEX_MODEL_RE.fullmatch(model_id_str or ""))


def codex_precondition_refusal(model: str | None, home: "Path | None" = None) -> str | None:
    """Why no Codex run may start on `model`, the probe included, or None.

    Three preconditions, all refusals rather than warnings. The model is priced.
    The model is pinned:
    Codex resolves an unpinned model from a server-side catalog, the same hazard
    model-pin-guard.sh closes for Claude. And the PreToolUse guards bind the run
    (codex_bridge.verify): the operator ruled that a Codex run is held to a Claude run's
    restrictions, and a guard that does not run reads as coverage.
    """
    if not model or not model.strip():
        return "no model is pinned; pass -m with an explicit Codex model slug"
    if not is_codex_model(model):
        return f"'{SC.sanitise(model, max_len=80)}' is not a model the Codex CLI serves"
    if model not in T.CODEX_PRICING_PER_MTOK:
        # An unpriced slug would record usd=0.0, which every cost guard reads as
        # free (the Fable row's lesson); refuse it rather than measure nothing.
        return (f"'{SC.sanitise(model, max_len=80)}' has no published price, so its cost "
                f"cannot be recorded; add a row to telemetry.CODEX_PRICING_PER_MTOK")
    if CB is None:
        return "codex_bridge is not linked, so the guards cannot be verified; run install.sh"
    problems = CB.verify(home or CB.codex_home())
    if problems:
        return "the PreToolUse guards do not bind this run: " + "; ".join(problems)
    return None


# PR #821 round 2 (security-reviewer, at a3581172): `-s read-only` denies the
# conformance probe's and a Codex reviewer's WRITES, not its reads, so a Codex run
# under it can still read `~/.config/gh`, `~/.gitconfig`, `~/Library/Keychains` and
# the convivy-bosun App's private key directly (a `cat`, or `security
# find-generic-password`) — none of which an env var closes, because an env var
# redirects where GIT/GH LOOK for a config file, not what the sandbox lets the
# process read from disk by any other means. Round 4 (CQ·418) routes both this
# probe's and the reviewer dispatch's env through `git_credential_guard_env`, which
# closes the FILE-based git/gh credential-helper route specifically (`GH_CONFIG_DIR`/
# `GIT_CONFIG_GLOBAL`/`GIT_CONFIG_SYSTEM` point away from those paths, so git's own
# credential resolution never opens them) — see `dispatch_env`'s own docstring. It
# does not touch the raw-read exposure above, which still needs a read-confinement
# mechanism this round could not confirm working: codex-cli 0.161.0's own `-c
# sandbox_permissions=[...]` has exactly one disk-read value ("disk-full-read-
# access"), no finer-grained read-deny list (checked against `codex exec --help`
# and the installed binary's own strings; neither names a second one); and
# wrapping the launch in `sandbox-exec` (or codex's own `codex sandbox` debug
# command, which applies one directly) could not be exercised live from this
# round's own coder session — every `sandbox_apply` call, including a
# no-op-permissive profile applied to a canary-only `cat`, is refused with
# "sandbox_apply: Operation not permitted" from inside that session's own
# Seatbelt sandbox (nested sandbox application denied categorically, independent
# of profile content — see the PR body for the exact commands and output). So
# this is unconfirmed, not disconfirmed: a real, unsandboxed `agentctl` process
# may well be able to apply one. Until that is confirmed live, fail closed: every
# Codex review dispatch is refused here, pass or no pass.
CODEX_READ_CONFINEMENT_REFUSAL = (
    "no mechanism confines a Codex run's reads to its worktree (PR #821 round 3): "
    "`-s read-only` denies writes, not reads, and codex-cli 0.161.0 has neither a "
    "config read-deny list nor a confirmed sandbox-exec wrap — every Codex dispatch "
    "is refused until one is confirmed working from a live, unsandboxed run")


def codex_dispatch_refusal(model: str | None, home: "Path | None" = None) -> str | None:
    """Why a GENERAL Codex dispatch must not start, or None to proceed.

    The preconditions above, plus a recorded conformance-probe pass for this model
    against the current bridge manifest. verify() alone can be green while Codex
    skips an untrusted hook (its trust test cannot tell), so only a probe that saw
    the guards deny real commands lifts the refusal; a changed manifest voids it.

    A probe pass does NOT lift the refusal on its own (PR #821 round 3): see
    `CODEX_READ_CONFINEMENT_REFUSAL`'s comment for why every Codex dispatch is
    refused regardless, until a read-confinement mechanism is confirmed live.
    """
    refusal = codex_precondition_refusal(model, home)
    if refusal is not None:
        return refusal
    if CP is None:
        return "codex_probe is not linked, so the conformance pass cannot be checked; run install.sh"
    pass_refusal = CP.pass_refusal(home or CB.codex_home(), model)
    if pass_refusal:
        return f"the conformance probe gate is closed: {pass_refusal}"
    return CODEX_READ_CONFINEMENT_REFUSAL


def claude_model_arg(model: str) -> str:
    """The value passed to `claude --model` for a resolved model string.

    Gateway-served models get their gateway group name so router fallbacks
    fire (ARCH-130); a gateway-prefixed literal with no known group passes
    through unchanged (it still routes, just without fallbacks). Anthropic
    models pass through unchanged.
    """
    if is_gateway_model(model):
        return GATEWAY_MODEL_GROUPS.get(model, model)
    return model


def model_display_name(model: str) -> str:
    """Human-facing model name for review/post attribution (ARCH-138).

    Gateway-served models resolve to their gateway group name (deepseek, gpt5,
    kimi) — the name the operator and PR readers recognize. A Codex model resolves to its
    own slug (the catalog has no group name, and it is not "Claude"). Every other
    (Anthropic-direct) model maps to the "Claude" brand, which the agent prompts
    already hardcode as their default attribution.
    """
    if is_gateway_model(model):
        return GATEWAY_MODEL_GROUPS.get(model, model)
    if is_codex_model(model):
        return model
    return "Claude"


def worktree_directive(worktree: Path, repo: str) -> str:
    """Tell the agent where its worktree is, because nothing else does (ARCH-441
    follow-up; issue_01KZ7E0YNV84W55796CZ8ETX6X).

    A dispatched run is bound to its worktree ONLY by the process `cwd`. The
    diagnosis found zero occurrences of `Convivy/worktrees` in a leaking run's
    system prompt or brief, and `coder.md` mentions "worktree" once in passing
    without naming the root. So the agent builds absolute paths by analogy from
    whatever root it was handed — and the brief's first instruction routinely
    hands it the PRIMARY, which is how ~30 reads and 14 writes landed in the operator's
    checkout in the run that produced this issue.

    Injected here for the same reason `attribution_directive` is: the DISPATCHER
    knows the resolved worktree path and the agent cannot, and appending it last
    supersedes any path the prompt above established. Editing 29 roster files
    would reach the agents that have one and miss every ad-hoc dispatch; this
    reaches all of them, and cannot drift from the truth because it is computed
    from the same variable that sets `cwd`.

    Paired with the finalize-time guard in `primary_guard`, which catches what
    this fails to prevent. Neither substitutes for the other: 26 of the 56
    measured leaks had no brief path to correct, so wording alone cannot reach
    the ambient floor, and a guard alone only reports damage already done.
    """
    primary = _root() / repo
    # A repo-local (CFO) or private-crew dispatch legitimately RUNS IN the primary
    # (`keeps_primary` in `_spawn_dispatch`); every other dispatch has a worktree. Telling such a run "the primary is not
    # yours" would be false, self-contradictory (both paths are the same), and
    # would teach it to distrust the directive in every other run where it holds.
    # Returning "" leaves those runs exactly as they are today.
    try:
        if worktree.resolve() == primary.resolve():
            return ""
    except OSError:
        return ""
    return (
        "\n\n## Your worktree (authoritative — supersedes any path above)\n\n"
        f"Everything you read, write, or run `git` against belongs INSIDE:\n\n"
        f"    {worktree}\n\n"
        f"`{primary}` is the operator's PRIMARY checkout. It is not yours. Writing there "
        f"corrupts a working tree you cannot see, and running `git` there can "
        f"destroy uncommitted work that is not in any branch.\n"
        f"- Build every path from your worktree root above. **A path you were "
        f"handed is not a root to reason from** — a brief may cite a design doc by "
        f"its path in the primary, and reading that one file does NOT make the "
        f"primary your working directory.\n"
        f"- Pass `-C {worktree}` to every `git` command rather than relying on `cwd`.\n"
        f"- If a path you are about to write starts with `{primary}`, stop: you have "
        f"the wrong root. Translate it to your worktree and continue.\n"
    )


def attribution_directive(model: str, agent_name: str) -> str:
    """Authoritative attribution override appended to a gateway- or Codex-model
    spawn's system prompt (ARCH-138).

    Two surfaces misattribute a non-Anthropic worker as "Claude": the roster
    agents' prompts hardcode `Comment by Claude (<agent>):` as their mandatory
    PR-comment prefix, and the Claude Code harness injects a
    `Co-Authored-By: Claude ...` commit trailer from the running model. Both are
    accurate on Anthropic, wrong once ARCH-135 moved reviewer/coder/refactorer/
    test-writer (and others) onto deepseek, and wrong again for a Codex
    reviewer, which has no Claude Code harness to inject anything but still
    inherits the same hardcoded prompt text. Rather than couple either to a
    mutable `model:` frontmatter field (which would drift the day an agent
    reverts to sonnet, the ARCH-135 escape hatch), the dispatcher injects the
    truth at spawn: it knows the resolved model, so it names it — and being
    appended last, it supersedes both the prompt and the harness default.
    Returns "" for Anthropic-direct models, where "Claude" is already correct
    and the Task-dispatched path (which never reaches this injection) depends
    on it.
    """
    if not (is_gateway_model(model) or is_codex_model(model)):
        return ""
    name = model_display_name(model)
    via = "the Codex CLI" if is_codex_model(model) else "the gateway (ARCH-135 roster)"
    return (
        "\n\n## Attribution override (authoritative — supersedes the prompt above)\n\n"
        f"You are running on the `{name}` model, dispatched via {via}. "
        f"Attribute your output to `{name}`, never to Claude:\n"
        f"- **PR comments / posted review findings:** prefix with "
        f"`**Comment by {name} ({agent_name}):**` — substitute `{name}` wherever "
        f'the prompt above tells you to write "Claude".\n'
        f"- **Git commit trailers:** end commit messages with "
        f"`Co-Authored-By: {name} <noreply@convivy.com>`, replacing any "
        f"`Co-Authored-By: Claude ...` line you would otherwise add.\n"
        f"This keeps the git history and PR audit trail honest about which model "
        f"actually produced the work."
    )


def _eval_mode_system_prompt(scratch_dir: Path) -> str:
    """Appended to `--append-system-prompt` for a `--eval-mode` dispatch (the
    review-replay eval harness, agent-platform#813 round 1): the one thing the
    eval allow-list's permission layer cannot say by itself — where the verdict
    goes once `gh` and `agentctl review-post` are both unreachable.

    The replayed brief (`--task`) is the corpus entry's ORIGINAL brief, verbatim
    (agent-platform#807's own requirement — the harness must not re-synthesize
    what the candidate is asked), so it still tells the model to post or to call
    `review-post`. This directive, not the brief, is what actually produces this
    run's result: write the verdict as JSON to `RS.eval_verdict_path(scratch_dir)`
    (round 8 — `scratch_dir` is this run's OWN directory,
    `RS.create_eval_scratch_dir`'s return value for this dispatch, never the
    shared-root/run_id-keyed path round 6 used, which a sibling eval arm sharing
    that same root could glob for and overwrite before the dispatcher ever
    collected it. Still never this run's own `run_dir`: that sits under
    `runs_root`, which is denied to every run's own write regardless of `Write`
    being in the tool surface). `_collect_eval_verdict`, below, reads that
    directory back once this run's claude process has exited and, after
    validating what it finds there, writes `eval-review.json` into `run_dir`
    itself — which is what `agentctl review-eval` actually reads
    (`review_eval_replay.collect_run_result`)."""
    target = RS.eval_verdict_path(scratch_dir)
    return (
        "\n\n## Eval mode (authoritative — supersedes the task above)\n\n"
        "This is a REPLAY against a historical commit for the review-replay eval "
        "harness, not a live review, and it must never post to GitHub. `gh` and "
        "`agentctl review-post` are both denied to this run at the permission "
        "layer; do not attempt either, including through a workaround — there is "
        "no route to post and none should be sought.\n\n"
        "When your review is complete, write your verdict and full review body "
        f"as JSON to `{target}`, with this shape:\n"
        '{"verdict": "APPROVE" or "REQUEST_CHANGES", "body": "<the full review '
        'text you would otherwise have posted, unabridged>"}\n\n'
        "That file is how this replay's result is read. Nothing else is."
    )


def _read_eval_verdict_file(scratch_dir: Path) -> str | None:
    """The filesystem-level half of the untrusted-input boundary on a replay's
    verdict write (round 8, agent-platform#813 round 7 finding): reads
    `RS.eval_verdict_path(scratch_dir)` back WITHOUT ever following a symlink,
    and refuses anything that is not a regular file sitting directly inside
    `scratch_dir` itself.

    Opens `scratch_dir` first (an ordinary path open, so its own parent
    components resolve normally — this run's directory is a known, fixed
    path, not untrusted input), then opens the verdict filename relative to
    THAT directory's own file descriptor with `O_NOFOLLOW`. A symlink planted
    in place of the verdict file — pointing anywhere, another run's
    directory included — is refused outright rather than followed, so what
    is read is provably a direct child of the exact directory this dispatch
    created, never one reached through an extra hop. `os.fstat` on the
    opened descriptor is the second check: a non-symlink, non-regular file
    (a FIFO, a device node) is refused too.

    Returns None for anything that doesn't clear every one of those checks —
    a missing directory, a missing file, a symlink, a non-regular file, or
    any OSError reading either — exactly the same as the file never having
    been written at all; no caller may read None as anything but "no
    verdict"."""
    try:
        dir_fd = os.open(scratch_dir, os.O_RDONLY)
    except OSError:
        return None
    try:
        try:
            fd = os.open(RS.EVAL_VERDICT_FILENAME,
                        os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
        except OSError:
            return None
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                os.close(fd)
                return None
        except OSError:
            os.close(fd)
            return None
        try:
            with os.fdopen(fd, "r") as f:
                return f.read()
        except OSError:
            return None
    finally:
        os.close(dir_fd)


# The identity fields `_collect_eval_verdict` checks a replay's verdict write
# against — this run's OWN values, never re-derived from the untrusted file itself
# (the same standard ARCH-193 holds `review_sha` to, and `_finalize_run`'s docstring
# states for `model`/`repo`/`issue`: a run's own subprocess can write anything into a
# file it controls for its entire execution window, so nothing downstream may trust
# that file to say what run, repo, commit or PR it was). The eval directive above
# only asks the model for `verdict`/`body`, so an absent identity field in the
# written JSON is the ordinary case, not evidence of tampering — only a field that
# IS present and disagrees invalidates the write. The write is confined to this run's
# OWN directory (`scratch_dir`, below) regardless, so this check is defense in depth,
# not the primary guarantee (round 8, agent-platform#813 round 7 finding) — see
# `RS.create_eval_scratch_dir`'s docstring for what actually confines it.
def _collect_eval_verdict(scratch_dir: Path, *, run_id: str, repo: str,
                          review_sha: str | None, agent_name: str,
                          pr: int | str | None) -> dict | None:
    """Reads back a finished `--eval-mode` replay's verdict write inside its
    own directory (`scratch_dir`, `RS.create_eval_scratch_dir`'s return value
    for this dispatch), validates it, and returns `{"verdict", "body"}` to
    record in `run_dir` — or None when there is nothing trustworthy there: a
    missing or symlinked file, one that doesn't parse as a JSON object, a
    `verdict` outside `RP.VERDICTS`, a `body` that isn't a string, or one that
    names a different run, repo, commit or PR than this dispatch actually
    was. None is never treated as a pass by any caller — it means "no
    verdict", the same as the file never having existed.

    Called once, after this run's claude process has already exited (so the
    write this reads is complete, if it happened at all), from the one caller
    that also removes `scratch_dir` regardless of what this returns."""
    text = _read_eval_verdict_file(scratch_dir)
    if text is None:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    if not isinstance(data, dict):
        return None
    verdict, body = data.get("verdict"), data.get("body")
    if verdict not in RP.VERDICTS or not isinstance(body, str):
        return None
    expected = {"run_id": run_id, "repo": repo, "agent": agent_name,
               "sha": review_sha, "pr": str(pr) if pr is not None else None}
    for key, want in expected.items():
        got = data.get(key)
        if got is None:
            continue  # not claimed by the file; nothing to check
        if want is None or str(got) != str(want):
            return None
    return {"verdict": verdict, "body": body}


def kb_coauthor_trailer() -> str:
    """The `Co-Authored-By:` line for a KB write commit, with its leading
    newline, or "" when nothing can honestly be named.

    A KB write used to append one hardcoded Opus line, so an
    operator's own hand save credited Claude and every agent write said Opus
    whatever model ran. Now only a dispatched run names a model: the run
    `AGENTCTL_RUN_ID` resolves, by meta.json's `model`. That field, not
    `model_resolved`, because `_respawn_in_place` rewrites `model` on fail-over
    while `model_resolved` keeps naming what the roster asked for (ARCH-378).
    Address follows `attribution_directive`: convivy.com for gateway models,
    anthropic.com otherwise.

    Anything else (an interactive co session, an editor, no run id, an
    unreadable run dir) gets no line: no variable names the model an interactive
    session runs, so any name would be a guess.

    meta.json is writable by the run it describes, so a run can misstate which
    model wrote its own commit. That is the same trust level as the origin
    system and is deliberately not guarded. Authoring extra commit lines is
    another matter: `model_display_name` returns an unknown gateway-prefixed
    model raw, newlines included, so a model outside a single-line charset gets
    no line, the same class `kb_writes.message_is_trailer_safe` refuses.
    """
    run_id = os.environ.get("AGENTCTL_RUN_ID")
    if not run_id:
        return ""
    try:
        run_dir = _find_run_dir(run_id)
        model = T.read_meta(run_dir).get("model") if run_dir else None
    except (OSError, ValueError, AttributeError):
        return ""
    if not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9._/:-]+", model):
        return ""
    domain = "convivy.com" if is_gateway_model(model) else "anthropic.com"
    return f"\nCo-Authored-By: {model_display_name(model)} <noreply@{domain}>"


def fallback_model_for(model: str) -> str | None:
    """Harness-level fail-over target for a resolved model string (ARCH-131).

    Anthropic-direct models respawn once on deepseek when the claude process
    dies abnormally (nonzero exit or signal kill) — the failure mode the
    subscription 7-day rate limit produces.

    deepseek respawns on sonnet (ARCH-186). kimi was deepseek's rescue via the
    LiteLLM router (deepseek → kimi, ARCH-130, for DeepSeek's json_schema
    400-storms), but kimi is cut. The rescue is done at the harness level, not the
    gateway, on purpose: the gateway has no Anthropic key, and routing
    deepseek → sonnet through it would bill the Anthropic API (console credits) —
    a harness respawn runs sonnet claude-direct on the SUBSCRIPTION (the operator's
    constraint: sonnet-as-backup only if it's subscription-billed). Other gateway
    models (gpt5, kimi*) keep no harness fallback — a second hop would mask a
    genuinely broken task.
    """
    if model == MODEL_ALIASES["deepseek"]:
        return MODEL_ALIASES["sonnet"]
    if is_gateway_model(model):
        return None
    # A Codex run that died respawned on deepseek before this line: the model id
    # is not gateway-prefixed, so it fell through to the Anthropic-direct branch,
    # and the respawn reused the worktree on a metered gateway model. A second hop
    # off the Codex lane is a different harness and a different bill.
    if is_codex_model(model):
        return None
    return MODEL_ALIASES["deepseek"]


def gateway_env(model: str, base_env: dict, *,
                virtual_key: str, gateway_url: str) -> dict:
    """Return the subprocess env dict for a claude spawn.

    For gateway models: add ANTHROPIC_BASE_URL and override ANTHROPIC_API_KEY
    with the LiteLLM virtual key. For Anthropic models: return base_env
    byte-identical (dict-equality guaranteed — the Anthropic path is unchanged).
    """
    if is_gateway_model(model):
        return {
            **base_env,
            "ANTHROPIC_BASE_URL": gateway_url,
            "ANTHROPIC_API_KEY": virtual_key,
        }
    return base_env


def _billing_source_for(model: str) -> str:
    """Derive the billing_source value for write_meta from the resolved model string.

    Anthropic models use 'subscription_credit' (unchanged from today). Gateway
    models use 'provider_api:<provider>' so meta.json reflects the real billing
    provider. Unknown literals (is_gateway_model returns False) fall back to
    'subscription_credit', preserving today's behaviour. A Codex slug is checked
    first: it would otherwise fall to 'subscription_credit', which means Anthropic.
    """
    if is_codex_model(model):
        return T.CODEX_BILLING_SOURCE
    if not is_gateway_model(model):
        return "subscription_credit"
    provider = model.split("/", 1)[0]  # "openai" / "deepseek" / "moonshot" / "openrouter"
    return f"provider_api:{provider}"


def _origin_of_run(run_id: str) -> str | None:
    """The origin RECORDED in run_id's own meta.json, or None when it can't be
    read (missing/unreadable run dir, unreadable meta.json, or an origin field
    that's absent or not a member of T.VALID_ORIGINS).

    This reads a value already written to disk at that run's own spawn time —
    the run cannot have changed it since, because nothing in this codebase
    updates `origin` after `write_meta` — rather than re-deriving one from
    the current process's environment (issue_01M0VJ8KDMKQYD1HJVXC78FT5J)."""
    run_dir = _find_run_dir(run_id)
    if run_dir is None:
        return None
    try:
        meta = T.read_meta(run_dir)
    except Exception:
        return None
    origin = meta.get("origin")
    return origin if origin in T.VALID_ORIGINS else None


def _recorded_origin_refusal(run_id: str, subject: str) -> str | None:
    """The refusal reason for `run_id`'s RECORDED origin (`_origin_of_run`), or
    `None` to permit — used by `_model_override_refusal`'s sources 2 and 3,
    never by `_run_origin` (see that function's docstring for why it stays
    separate: `_run_origin` also feeds the budget gate, and this fail
    direction is wrong for billing).

    Refuses both when the recorded origin is positively capped AND when it
    can't be read at all (missing run dir, unreadable meta.json, or a
    non-`T.VALID_ORIGINS` value — see `_origin_of_run`). Inside this
    resolver, a record that cannot be read is treated as capped, because the
    party that would benefit from it being unreadable is the party that can
    make it unreadable: a worker owns its own run dir and can truncate its
    own meta.json (or point `--parent` at a leaked interactive run-id while
    its own record is unreadable) to make `_origin_of_run` answer `None`
    instead of a capped value (round-4 blocking finding — the two rounds
    before this one each closed a variant of "read this signal in a way
    where 'cannot tell' comes out as 'not capped'" one call site over).

    `subject` is the clause describing whose record this is, e.g. "this
    process's own" or "this process's cwd is inside {rid}'s registered
    worktree, whose" — interpolated ahead of "recorded origin" in both
    messages so the two read as continuations of the same sentence the
    call site used to build inline."""
    origin = _origin_of_run(run_id)
    if origin is None:
        return f"{subject} recorded origin could not be read"
    if origin in B.CAPPED_ORIGINS:
        return f"{subject} recorded origin ({origin}) is autonomous"
    return None


def _run_origin(parent: str | None) -> str:
    """The origin to stamp on a spawn whose resolved parent (post
    `_resolve_parent`) is `parent` — or, for a self-lookup via `_own_origin`,
    the origin of the CURRENT process itself (ARCH-156).

    A run cannot be trusted to assert its own origin: AGENT_RUN_ORIGIN lives in
    the process's OWN environment, and a worker that clears or misspells it
    before dispatching used to fall to `interactive`, which the budget gate
    never caps (issue_01M0VJ8KDMKQYD1HJVXC78FT5J). So whenever `parent` is
    not None — this spawn was dispatched from inside another agentctl run, not
    fresh from a human `co` session or the launchd launcher — origin is
    INHERITED from the parent's own RECORDED origin (`_origin_of_run`, which
    reads the parent's meta.json), never re-derived from environment the child
    controls. A parent whose origin can't be read falls to `scheduled`, the
    pool an autonomous dispatcher's own descendants actually live in: an
    unreadable parent record is exactly what an escape attempt would produce,
    so this direction must fail INTO the capped pool — the opposite of the
    fallback below, and the opposite of this function's pre-fix behaviour.

    With no parent — a genuinely top-level dispatch — there is nothing to
    inherit from, so this IS the root of the inheritance chain rather than a
    link in it: AGENT_RUN_ORIGIN is read directly from the environment, same
    as before the fix. An unrecognized value still falls to `interactive`
    (fail OUT of the capped pool, never falsely INTO it) — mis-billing is the
    only risk at the root, since nothing here is trying to escape its own cap.

    This closes the hole for every spawn dispatched from inside another run.
    It does not authenticate the root of the chain itself — see the PR body
    for why, and for why that remaining gap is materially narrower than the
    one this closes.

    `--parent` is a public, unauthenticated CLI flag: nothing checks that the
    calling process actually descends from the run-id it names, and past
    run-ids routinely leak (every review-post stamp embeds one in a PR
    comment). So a capped-origin caller could point `--parent` at any known
    uncapped run and inherit ITS origin instead of its own. `--parent`
    legitimately sets nesting and telemetry; it must not be able to LOWER
    this process's own cap. So once `parent` is resolved, this also reads
    the CALLING process's own origin (via ITS OWN `AGENTCTL_RUN_ID`, not
    `parent`) and keeps that instead whenever it is itself a capped origin —
    a scheduled worker passing `--parent <interactive-run>` still resolves
    `scheduled`, because its own run says so. This also picks the caller's
    own pool over the hard-coded `scheduled` fallback when the named
    parent's record is unreadable but the caller's own is not (ARCH-320)."""
    if parent is None:
        val = os.environ.get("AGENT_RUN_ORIGIN", T.DEFAULT_ORIGIN)
        return val if val in T.VALID_ORIGINS else T.DEFAULT_ORIGIN
    origin = _origin_of_run(parent)
    origin = origin if origin is not None else "scheduled"
    own_run_id = os.environ.get("AGENTCTL_RUN_ID")
    if own_run_id and own_run_id != parent:
        own_origin = _origin_of_run(own_run_id)
        if own_origin in B.CAPPED_ORIGINS:
            origin = own_origin
    return origin


def _model_override_refusal(parent: str | None) -> str | None:
    """The REASON to refuse a model-changing `--model` override, or `None` to
    permit it (security-reviewer finding on PR #476, round 1; hardened
    against a fail-open hole in the resolver itself on round 3; hardened
    again on round 4 against an unreadable recorded origin reading as
    permission rather than doubt). Used ONLY at the two override-refusal
    sites — never for stamping/logging, which stays
    on `_run_origin` at the same call sites, computed separately. Naming the
    failed condition in the returned reason (rather than just an origin
    string) is what lets both call sites print which of several independent
    checks fired, instead of duplicating the two-part "which one" logic at
    each site.

    `_run_origin`'s root branch deliberately fails OUT of the capped pool
    (falls to `interactive`) when it can't determine a real origin, because
    at the root the only thing at stake is mis-billing — nothing there is
    trying to escape its own cap, so that asymmetry is correct FOR BILLING.
    It is wrong for a refusal: a refusal is exactly a control something would
    want to escape, so this resolver fails INTO refusal on any doubt at all —
    not just a positively-capped answer from one of the three sources below,
    but also a source that cannot be EVALUATED (a `Path.cwd()` that raises, a
    registry that cannot be read). Unevaluable is doubt, not permission. This
    is the opposite asymmetry from `_run_origin`'s root, which is why this is
    a deliberately separate function rather than a branch inside
    `_run_origin`: `_run_origin` also feeds the budget gate, and changing its
    fail direction would change budget/billing behaviour platform-wide to fix
    a problem billing doesn't have. Leave `_run_origin` itself alone — its
    own internal anti-downgrade check (the `own_origin` comparison in its
    docstring) has this same None-is-not-capped shape, unfixed, on purpose:
    it feeds the budget gate, not this refusal, so it is not this function's
    to change. Source 2 below reads the SAME signal (the caller's own
    `AGENTCTL_RUN_ID`) independently and fails closed on it for this
    refusal's purposes, which is what actually covers this ground here.

    Refuses when ANY of three INDEPENDENT sources says the calling process's
    ancestry is autonomous, rather than trusting the single
    environment-derived signal `_run_origin`'s root trusts:

    1. `_run_origin(parent)` itself — the existing parent-inheritance chain.
       Robust on its own terms (it reads the parent's recorded `meta.json`),
       but only REACHED when `AGENTCTL_RUN_ID` or an explicit `--parent`
       resolves to non-None — and this process is free to clear
       `AGENTCTL_RUN_ID` (and `AGENT_RUN_ORIGIN`) for the one invocation that
       matters: `env -u AGENTCTL_RUN_ID -u AGENT_RUN_ORIGIN agentctl spawn
       <agent> --model opus --reason "..."` drops straight to `_run_origin`'s
       root, which resolves `interactive`.
    2. This process's OWN `AGENTCTL_RUN_ID`, read directly from the
       environment rather than through `_resolve_parent`/`parent` — an
       independent look at the same signal `_run_origin`'s internal
       anti-downgrade check uses, so an explicit `--parent` naming an
       uncapped run (the narrower bypass: clear only `AGENTCTL_RUN_ID`, pass
       `--parent <leaked-interactive-run-id>`) cannot make source 1 alone
       decide this — sources 2 and 3 still get their own look regardless of
       what `parent` resolved to or how `_run_origin` answered. Routed
       through `_recorded_origin_refusal` (round-4 finding — see below), so
       an unreadable record here refuses exactly like a positively-capped
       one, not like a pass.
    3. The current working directory: a dispatched worker's `claude` process
       (and everything it runs, including its own `agentctl spawn` calls)
       runs with cwd inside its own REGISTERED worktree (`registry.list_runs()`
       — every live entry carries `worktree`), and clearing environment
       variables does not move the process out of that directory. Matching
       cwd against a live entry's worktree, then reading THAT entry's run_id's
       RECORDED origin off disk (`_origin_of_run`, unspoofable the same way
       `_run_origin` relies on) via `_recorded_origin_refusal`, is what
       closes the bypass in practice — it needs no signal from the calling
       process's own environment at all, so it is the one source that still
       fires when both env vars are cleared with no `--parent` given.

       Evaluating source 3 needs `Path.cwd()` and `R.list_runs()` to
       succeed, and each is refused separately (not silently skipped) when
       it can't: `Path.cwd()` raises `FileNotFoundError` once the calling
       process's own working directory has been removed out from under it
       (`mkdir /tmp/x && cd /tmp/x && rmdir /tmp/x` — verified directly), and
       a worker that removes its cwd before clearing its env and spawning
       reproduces the exact bypass source 3 exists to close, one step
       removed — round-3 finding. `R.list_runs()` raises on a corrupted or
       unreadable `active.json`; refusing here (rather than either letting
       the exception crash the whole `agentctl spawn` invocation, or quietly
       falling through to permit) also closes off a worker buying its
       override by corrupting a file it already has write access to.

       A single registry ENTRY whose `worktree` fails to resolve (`OSError`,
       or `RuntimeError` from a symlink loop — round-4 style finding) is
       SKIPPED, not refused outright (round-4 finding, reverting round 3):
       an entry that can't resolve its own worktree can't match `cwd`
       either way, so it carries no signal worth failing into doubt over,
       and a whole-spawn refusal here means an unrelated LIVE run's garbage
       `worktree` value — or a worker's own forged entry, planted
       specifically to weaponize this — denies every interactive override
       on the machine, not just its own. This is safe only because source 2
       above now independently covers the case that actually matters — the
       CALLING process's own record being unreadable — via the caller's own
       `AGENTCTL_RUN_ID`, which needs no registry entry to resolve at all;
       the two fixes are coupled, and reverting this one without the other
       would reopen the round-3 hole. Distinct from `R.list_runs()` failing
       outright above: that's every entry gone at once, still refused, since
       there both cwd's own live entry (if any) AND every other one become
       simultaneously unevaluable, which is doubt, not the ordinary churn of
       one stale entry among many.

    STILL NOT a security boundary against a hostile agent. Two distinct
    things still get through:

    - A worker that leaves its registered worktree AND clears its
      environment resolves `interactive` here too, same as `_run_origin`'s
      root branch — because an interactive `co` session sets neither
      `AGENT_RUN_ORIGIN` nor `AGENTCTL_RUN_ID` (confirmed: `bin/co` sets
      neither), so a stripped worker and a genuine human spawn are
      indistinguishable BY CONSTRUCTION; making this resolver refuse that
      case would refuse every interactive override on the machine along
      with it.
    - A worker with unrestricted Bash can defeat source 3 WITHOUT leaving
      its worktree at all, by rewriting its own accounting state instead of
      its environment: `<root>/agent-runs/active.json` is an ordinary
      flock-guarded JSON file (`registry.py`'s `ACTIVE_PATH`), and
      `_origin_of_run` trusts whatever origin is written in a run's
      `meta.json`. `registry.remove_run` on its own real (capped) entry
      followed by `registry.add_run` of a fabricated one pointing at its own
      worktree with a forged `interactive` origin defeats source 3 the same
      way clearing env vars defeats sources 1 and 2 — `AGENTCTL_RUN_ID` still
      has to be cleared too, or source 2 reads the real entry's own
      unforged, still-capped `meta.json` and refuses regardless of what the
      registry says. Since round-4's fix makes source 2 fail closed on an
      unreadable record too, corrupting the OWN meta.json in place of
      clearing `AGENTCTL_RUN_ID` no longer helps this combination either —
      clearing the env var is now the only surviving way through source 2,
      and that also means every OTHER `agentctl` invocation this same
      process makes for the rest of its life loses its own recorded
      identity, not just this one override. Removing its own real registry
      entry costs it further: any of its own subsequent commands that
      resolve concurrency, cost tracking, or its own status through
      `registry.list_runs()`/`get_run` keyed on its real run_id no longer
      find themselves there either. This is not new to this PR — the whole
      origin system, including the budget gate `_run_origin` also feeds,
      already assumes a run will not rewrite its own accounting state — but
      is worth naming here since the bypass list above reads as complete
      otherwise.
    - A worker could plant a run directory dated in the future under
      `RUNS_ROOT` (`mkdir -p <root>/agent-runs/2099-01-01/$AGENTCTL_RUN_ID`
      plus a `meta.json` inside it claiming `"origin": "interactive"`) and
      defeat every source above at once, without touching its own
      environment or editing any existing file — because `_find_run_dir`
      used to glob `RUNS_ROOT.glob("20*-*-*/")`, sort the date directories in
      reverse, and return the FIRST match, so a `2099-01-01` directory sorted
      ahead of every real date and won. Fixed (issue_01M1JWB7M75SZ160VRJRCGARBF):
      `_find_run_dir` now refuses (returns `None`) rather than picking one
      when a run-id resolves under more than one date directory, and
      `_origin_of_run` — the function all three sources above end up
      calling, source 1 through `_run_origin`, sources 2 and 3 through
      `_recorded_origin_refusal` — resolves through this same lookup, so a
      planted duplicate now reads as an unreadable record, which both of
      those functions already treat as the capped/refuse direction (see
      their own docstrings). That fix lives in `review_protocol.find_run_dir`
      (shared with every other one of `_find_run_dir`'s ~17 callers,
      including `agentctl publish`'s promotion and the `status`/`logs`/cost
      paths) rather than here, since the ambiguity a planted duplicate
      creates is not specific to origin resolution.

    A known, accepted false positive, not worth building around: an
    interactive `co` session whose cwd happens to sit inside another live
    capped run's registered worktree (a human `cd`s into a worker's worktree
    to debug it, then runs `agentctl spawn --model opus` from there) gets
    refused too, even though it's a genuine human override with no autonomous
    ancestry — the resolver cannot distinguish "cwd inside a capped run's
    worktree because I AM that run" from "...because a human wandered in."
    Narrow and self-inflicted, recoverable by `cd`ing back out.

    Origin becomes unforgeable only once an agent's identity comes from a
    signed grant rather than its own environment or process state — the
    Individuator epic (issue_01M17V9XB22KEFMRDA3ZKGGXWE, stage two). Until
    then this is a guardrail against unaccountable drift, not a boundary
    against a hostile agent — exactly as strong as the budget cap whose
    input (`_run_origin`) it shares, no stronger and no weaker."""
    origin = _run_origin(parent)
    if origin in B.CAPPED_ORIGINS:
        return f"this spawn's origin ({origin}) is autonomous"

    own_run_id = os.environ.get("AGENTCTL_RUN_ID")
    if own_run_id:
        refusal = _recorded_origin_refusal(own_run_id, "this process's own")
        if refusal:
            return refusal

    try:
        cwd = Path.cwd().resolve()
    except OSError:
        return "this process's own working directory could not be resolved"

    try:
        runs = R.list_runs()
    except Exception:
        return "the run registry could not be read"

    for entry in runs:
        wt, rid = entry.get("worktree"), entry.get("run_id")
        if not wt or not rid:
            continue
        try:
            wt_path = Path(wt).resolve()
        except (OSError, RuntimeError):
            # Skip, don't refuse: an entry whose own worktree can't resolve
            # can't match cwd either way, so it carries no signal — and
            # refusing here (round 3) let an unrelated live run's garbage
            # `worktree`, or a worker's own forged entry, deny every
            # interactive override on the machine (round-4 finding). Safe
            # only paired with source 2 above now covering the caller's own
            # record independently of the registry — see this function's
            # docstring. RuntimeError is a symlink loop, which OSError alone
            # does not catch.
            continue
        if cwd.is_relative_to(wt_path):
            refusal = _recorded_origin_refusal(
                rid, f"this process's cwd is inside {rid}'s registered worktree, whose")
            if refusal:
                return refusal

    return None


def _own_origin() -> str:
    """The origin of the CURRENTLY RUNNING agentctl process itself, for a
    self-referential check (e.g. "is MY OWN dispatch interactive") rather than
    a decision about a new spawn's parent.

    AGENTCTL_RUN_ID in this process's own env is the run-id this process was
    spawned AS — its OWN dispatcher set it, at the same site that sets a
    child's AGENTCTL_RUN_ID to the child's newly-generated run_id — so this is
    a self-lookup through `_run_origin`, not the parent-inheritance decision a
    fresh `agentctl spawn` makes for the run it's about to create."""
    return _run_origin(os.environ.get("AGENTCTL_RUN_ID"))


def _co_session(parent: str | None) -> str | None:
    """The originating co session UUID for an interactive spawn, or None.

    Claude Code exports CLAUDE_CODE_SESSION_ID into the Bash env of a session, so
    an `agentctl spawn` a co session runs inherits it. Recording it lets cost_join
    nest the spawn under its co session on /activity instead of orphaning it as a
    top-level row (the co main-loop is a ~/.claude/projects session, not a run-dir,
    so the spawn carries no parent_run). `parent` is the already-resolved parent
    (post `_resolve_parent`): non-None means the spawn nests by run-id — an
    orchestrator's worker, which now nests under the dispatching run whether or not
    --parent was passed (the AGENTCTL_RUN_ID default), and is scheduled-origin — so
    it must NOT also carry a co UUID. Only a truly parentless interactive spawn does."""
    if parent is not None or _run_origin(parent) in B.CAPPED_ORIGINS:
        return None
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or None


def _dispatch_is_from_a_co_session() -> bool:
    """True when THIS agentctl process's own environment carries CLAUDECODE —
    the variable Claude Code sets in every shell an agent session runs,
    including the one a spawned co uses to invoke `agentctl spawn`. A claim,
    not a cryptographic proof (issue_01M3NTZP9W8WEYWVERW2F9NARP): a person at a
    terminal could set it too. This is the one place a later Touch-ID-signed
    `operator_verified` (root-ca dependent, not built here) slots in, once it
    exists, to replace a claim with a proof."""
    return bool(os.environ.get("CLAUDECODE"))


def _resolve_parent(explicit: str | None) -> str | None:
    """The parent run-id for a spawn: an explicit --parent if given, else the
    dispatching run's AGENTCTL_RUN_ID from the env.

    agentctl stamps AGENTCTL_RUN_ID into every spawn's env, so a spawn made from
    *inside* an agentctl run (an overnight orchestrator, or any worker that itself
    dispatches) can nest under its dispatcher automatically — even when the caller
    forgot --parent. This is the dispatch-side fix for orphaned overnight workers
    (ARCH-284 follow-up): the orchestrator passed --parent for its first-round
    workers but not the late close-loop / cycle-2 re-dispatch, so those landed as
    standalone /activity rows. Absent the env var — an interactive co spawn, where
    Claude Code sets CLAUDE_CODE_SESSION_ID, not AGENTCTL_RUN_ID — this returns None
    and the co_session nesting path still applies."""
    return explicit or os.environ.get("AGENTCTL_RUN_ID") or None


def _overnight_wave() -> str | None:
    """The wave key grouping a deterministic bash launcher's dispatches, or None.

    A bash launcher (the ARCH-268 phase-split overnight, or the ARCH-122 weekly
    curation) is a sequencer, not a co session, so the agents it spawns carry no
    parent_run and no co_session — each would orphan as its own top-level
    /activity row. The launcher exports a wave key into the spawn env; recording
    it lets cost_join nest all of one run's dispatches under a single synthetic
    row instead.

    Two key shapes: the overnight night is `<product>/<day>` (no colon); any other
    launcher uses the explicit `<kind>:<scope>` form (e.g. `curation:2026-06-28`),
    which cost_join labels by its kind. `AGENT_WAVE` is the generic env var;
    `OVERNIGHT_WAVE` is the original overnight alias, still honored. The var is
    inherited by a stage's own --parent'd workers too, but cost_join nests those
    by run-id first, so the wave only groups the top-level dispatches."""
    return os.environ.get("AGENT_WAVE") or os.environ.get("OVERNIGHT_WAVE") or None


MODEL_OVERRIDES_LOG = RUNS_ROOT / "model-overrides.jsonl"


SKIPPED_CHECKS_LOG = RUNS_ROOT / "publish-skipped-checks.jsonl"


def _log_skipped_checks(*, wt: Path, branch: str) -> None:
    """Append one record per `publish --skip-checks`, mirroring the ARCH-188
    model-override log. The gates exist because instructions did not hold; an
    escape hatch nobody can count would decay the same way. Best-effort; a log failure must never fail the publish."""
    try:
        SKIPPED_CHECKS_LOG.parent.mkdir(parents=True, exist_ok=True)
        with SKIPPED_CHECKS_LOG.open("a", encoding="utf-8") as f:
            f.write(json.dumps({
                "ts": T.now_iso(), "worktree": str(wt), "branch": branch,
                "origin": _own_origin(),
            }) + "\n")
    except OSError:
        pass


def _log_model_override(*, agent: str, repo: str, model: str, origin: str,
                        run_id: str, reason: str, issue: str | None = None,
                        actor: str | None = None, channel: str = "cli") -> None:
    """Append one record per `--model` override (ARCH-188, model-lane epic
    issue_01KZH2GYGTVHFXZ055GEZVH2ZJ). The model-override monitor reads the
    trailing 24h and alerts #alerts-agent-cost-perf if a co overrides more than
    3 times — the cheap default should be the norm, not the override.

    `run_id` and `reason` are what make a row accountable rather than merely
    counted: `run_id` joins the row back to the run it belongs to (timestamp
    matching, what a human previously did by hand, breaks the moment two
    dispatches land in the same second), and `reason` is why the override
    happened, captured at the one moment it's cheap — the caller knows it now
    and nobody knows it later. The caller (`_run_session`) refuses the spawn
    outright when a model-changing override carries no reason, so this
    function can assume `reason` is non-empty, but NOT that it is safe: it is
    free text typed at the CLI, not platform-authored, and this row is later
    read back and interpolated into a Slack-rendered alert (metric-alerts'
    model_override_alerts) — signal_client's own contract is that any such
    value passes through `sanitise` before it lands in a body, so a --reason
    carrying a credential-shaped string is redacted here rather than logged
    and re-quoted verbatim in an alert (security review on this epic's first
    PR). Best-effort: an override-log failure must never fail the spawn.

    `issue`, `actor` and `channel` say HOW the choice arrived (model-lane epic
    issue_01M35KQ8WTW8R3WSKXS81TV2DZ, slice 2). `channel` is `cli` for a typed
    `--model`, and `work_item:<client>` for a model read off a work item, where
    `<client>` is the Library client that wrote it (`set_by_client`, taken from
    that client's credential). `actor` for an item model is the `acting_human`
    the client SUPPLIED, stored as text ending `(claimed, unverified)`; the
    Library records it and does not check it. Where no actor is named (every
    typed override) the row says `unattested` rather than leaving the field
    blank. `actor`, `channel` and `issue` arrive from a store this process does
    not control, so they are sanitised HERE, where they land, exactly as
    `reason` is, and not where a later reader renders them."""
    try:
        MODEL_OVERRIDES_LOG.parent.mkdir(parents=True, exist_ok=True)
        with MODEL_OVERRIDES_LOG.open("a", encoding="utf-8") as f:
            f.write(json.dumps({
                "ts": T.now_iso(), "agent": agent, "repo": repo,
                "model": model, "origin": origin,
                "run_id": run_id, "reason": SC.sanitise(reason, max_len=200),
                "issue": SC.sanitise(issue, max_len=200) if issue else None,
                "actor": SC.sanitise(actor, max_len=200) if actor else "unattested",
                "channel": SC.sanitise(channel, max_len=200),
            }) + "\n")
    except OSError:
        pass


def _header_task_label(task: str | None) -> str:
    """Sanitize a task string into a header-safe x-agentctl-task value.

    HTTP header values must be ASCII. The Anthropic SDK forwards
    ANTHROPIC_CUSTOM_HEADERS verbatim as request headers, so a task label with
    an em dash, emoji, or accent (common in the nightly drain, which derives
    labels from Slack messages) makes the gateway reject the request outright.
    Keep only printable ASCII (0x20–0x7E), collapse newlines, truncate to 80.
    """
    raw = (task or "").replace("\n", " ").replace("\r", " ")
    return "".join(c for c in raw if " " <= c <= "~")[:80]


def _gateway_url() -> str:
    return "http://127.0.0.1:4000"


class SpawnPreflightError(RuntimeError):
    """A spawn cannot proceed, decided before the model process starts.

    A plain Exception rather than SystemExit ON PURPOSE. SystemExit derives from
    BaseException, so `except Exception` does not catch it, and raising one from
    inside `_spawn_claude` skipped the caller's cleanup handler entirely.
    """


# `security find-generic-password` exit codes worth telling apart. The secret is
# read with `-w`; without it the command returns only metadata, which is what
# makes the two states distinguishable at all.
_SEC_NOT_FOUND = 44          # errSecItemNotFound — no such item
_SEC_INTERACTION_DENIED = 36  # errSecInteractionNotAllowed — present, locked


# Virtual keys live here first, Keychain second. THE FILE IS NOT A CONVENIENCE:
# an SSH-originated session gets its own macOS security session and cannot read
# the login keychain at all, and every dispatched run detaches from such a
# session, so Keychain is unreachable from the only place this actually runs.
#
# ON THE EXPOSURE, since it is the obvious objection: any process running as this
# user can already read the unlocked login keychain, and /etc/kcpassword already
# holds the account password in a recoverable form on this machine. Three API
# keys at 0600 is a narrower exposure than what is on disk today, not a wider
# one. The alternatives were measured and rejected — `launchctl asuser` reaches
# the console's context but needs root for every dispatch path, and
# `security unlock-keychain -p` needs the account password in plaintext, which is
# strictly worse than the secrets it would guard.
# LLM_GATEWAY_CONFIG_DIR is the directory the mint and the key readers share (default
# ~/.config/convivy). It is read once, at import.
GATEWAY_KEYS_FILE = (
    Path(os.environ.get("LLM_GATEWAY_CONFIG_DIR") or Path.home() / ".config" / "convivy")
    / "litellm-keys.json"
)


def _read_keys_file(service: str) -> str | None:
    """The key for `service` from GATEWAY_KEYS_FILE, or None if there is no file.

    A MISSING FILE FALLS THROUGH TO KEYCHAIN; A BROKEN ONE DOES NOT. Absent means
    "not adopted here yet", which is a fine state to fall back from. Present but
    unparseable, unreadable, or group/world-readable means something is wrong with
    the thing holding the credential, and silently falling back would turn that
    into a confusing Keychain error somewhere else — or, on a machine where
    Keychain happens to work, hide a leaking key file indefinitely.
    """
    try:
        st = GATEWAY_KEYS_FILE.stat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise SpawnPreflightError(f"could not stat {GATEWAY_KEYS_FILE}: {exc}") from exc
    if st.st_mode & 0o077:
        raise SpawnPreflightError(
            f"{GATEWAY_KEYS_FILE} is readable beyond its owner "
            f"(mode {st.st_mode & 0o777:o}); it holds gateway credentials. "
            f"Fix with: chmod 600 {GATEWAY_KEYS_FILE}"
        )
    try:
        data = json.loads(GATEWAY_KEYS_FILE.read_text())
    except (OSError, ValueError) as exc:
        raise SpawnPreflightError(
            f"{GATEWAY_KEYS_FILE} exists but could not be read as JSON: {exc}"
        ) from exc
    entry = (data or {}).get(service)
    if not isinstance(entry, dict):
        return None
    key = entry.get("key")
    if not isinstance(key, str) or not key.strip():
        return None
    if key.startswith("PASTE_"):
        raise SpawnPreflightError(
            f"{GATEWAY_KEYS_FILE} still holds the {service} placeholder; "
            f"replace it with the real key"
        )
    return key.strip()


def _gateway_virtual_key() -> str:
    """Read the LiteLLM agentctl virtual key from Keychain.

    THE TWO FAILURES ARE NOT THE SAME AND THE FIX FOR ONE DAMAGES THE OTHER.
    This used to report every non-zero exit as "not found" and send the reader to
    the bootstrap checklist to re-add the key. On 2026-09-03 that one word sent
    the diagnosis toward a missing key and would have overwritten three intact
    ones.

    Exit 44 means the item is absent and re-adding it is right. Exit 36 means it
    is present and THIS PROCESS may not read it, where re-adding fixes nothing
    and destroys a working credential.

    WHAT EXIT 36 ACTUALLY MEANS HERE, because the obvious reading is also wrong.
    It is NOT a locked keychain waiting to be unlocked. macOS gives an
    SSH-originated login its own security session, which cannot reach the login
    keychain even while the same user is logged in at the console with the
    keychain unlocked and in active use. Every co session on this machine arrives
    over SSH or mosh and `agentctl spawn` detaches from there, so every dispatched
    run inherits a context that can never read this key — with no reboot and no
    lock involved. Measured 2026-09-03: SSH_CONNECTION set and the read at 36,
    while `who` showed a console login and login.keychain-db had been written
    minutes earlier.

    So "unlock the keychain and re-dispatch" is the WRONG advice and is why this
    message names the session boundary instead. It only surfaced now because
    gateway-model agents are rare; Claude-direct agents never read this key.
    """
    from_file = _read_keys_file("litellm-agentctl-virtual-key")
    if from_file is not None:
        return from_file
    cp = subprocess.run(
        ["security", "find-generic-password", "-w", "-s", "litellm-agentctl-virtual-key"],
        capture_output=True, text=True, check=False,
    )
    if cp.returncode == 0:
        return cp.stdout.strip()
    if cp.returncode == _SEC_INTERACTION_DENIED:
        raise SpawnPreflightError(
            "litellm-agentctl-virtual-key is present in Keychain but this "
            "process may not read it (errSecInteractionNotAllowed). The usual "
            "cause is not a locked keychain: an SSH-originated session gets its "
            "own macOS security session and cannot reach the login keychain at "
            "all, even while the same user is logged in at the console with it "
            "unlocked. Every dispatched run detaches from such a session, so "
            "this fails identically with no reboot and nothing to unlock. "
            "DO NOT re-add the key — it is intact, and re-adding would overwrite "
            "a working credential without changing this."
        )
    if cp.returncode == _SEC_NOT_FOUND:
        raise SpawnPreflightError(
            "litellm-agentctl-virtual-key not found in Keychain (errSecItemNotFound); "
            "run the bootstrap checklist in the Phase C plan"
        )
    raise SpawnPreflightError(
        f"could not read litellm-agentctl-virtual-key from Keychain: "
        f"`security` exited {cp.returncode}"
        + (f" — {cp.stderr.strip()}" if cp.stderr.strip() else "")
    )


# Model ids no alias resolves to any more, kept accepted because a work item or
# script may still name one directly (2026-09-28 opus/fable repoint). Not added
# to _list_models: the contract lists aliases and tier ids only, and is a subset
# of what's accepted (knowledge PR convivy/knowledge#663).
_RETIRED_MODEL_IDS = {"claude-fable-5"}


def _model_known(model: str) -> bool:
    """Whether `model` (already resolved through `model_id`) is something this
    platform actually serves — override preflight condition 1. Claude-direct:
    a value from `MODEL_ALIASES`, a recognised fail-over tier (`_MODEL_TIERS`,
    which also covers a still-valid legacy literal like `claude-sonnet-4-6`;
    it deliberately excludes `claude-fable-5-1` — ARCH-134 is a
    roster-authoring rule, not a reason to refuse fable here), or a retired id
    no alias resolves to any more (`_RETIRED_MODEL_IDS`). Gateway-served:
    `is_gateway_model`, prefix-matched, so a literal the gateway proxies with
    no group name still counts. Codex-served: a priced slug
    (`telemetry.CODEX_PRICING_PER_MTOK`) — an unpriced `is_codex_model` slug is
    still unknown here, refused at this same condition rather than reaching
    `codex_dispatch_refusal`'s pricing-specific message. A literal matching
    none of these is a typo, not a real dispatch target."""
    return (
        model in _MODEL_TIERS
        or model in MODEL_ALIASES.values()
        or model in _RETIRED_MODEL_IDS
        or is_gateway_model(model)
        or model in T.CODEX_PRICING_PER_MTOK
    )


def _gateway_reachable(*, timeout: float = 2.0) -> bool:
    """Short-timeout TCP connect to the local gateway's host:port — override
    preflight condition 3. A plain connect needs no liveness ROUTE; whether
    LiteLLM serves one at `_gateway_url()`'s base is unverified (Handoff)."""
    host_port = _gateway_url().split("://", 1)[-1]
    host, _, port = host_port.partition(":")
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except (OSError, ValueError):
        return False


def _spawn_override_preflight(*, model: str, parent: str | None,
                              origin_exempt: bool = False) -> str | None:
    """The refusal CONDITION for a model-changing `--model` override — a short
    clause naming why, or `None` to permit (model-lane epic
    issue_01M35KQ8WTW8R3WSKXS81TV2DZ, slice 1).

    Checked BEFORE the detach fork — `cmd_spawn` calls this ahead of any
    worktree/run-dir side effect — so a condition that used to be discovered
    only inside the detached grandchild, minutes later, as
    `spawn_preflight_failed` (`_spawn_claude`'s failure path), now refuses
    synchronously, at the call. One function so a future in-process caller
    (not `cmd_spawn`'s argv) gets the identical answer without
    re-implementing it or parsing this command's stderr.

    Four conditions, in this FIXED order, so the message a caller renders is
    deterministic:

    1. `model` is unknown to the platform (`_model_known`).
    2. (gateway models only) no credential covers it — `_gateway_virtual_key`,
       the SAME function `_spawn_claude` would call, so the answer here is
       the answer the run would have hit. Its exception is caught and
       DISCARDED, not echoed: `_gateway_virtual_key`'s own messages carry
       `GATEWAY_KEYS_FILE`'s path and raw keychain error text, and the
       refusal this feeds must leak neither.
    3. (gateway models only) the provider is unreachable —
       `_gateway_reachable`, a short-timeout TCP connect.
    4. the origin is autonomous — `_model_override_refusal`, unchanged.

    2 before 3 deliberately: the credential read is a local, deterministic
    file read; the reachability probe has a timeout and can be flaky, and a
    flaky probe must not mask a real misconfiguration.

    Conditions 2 and 3 apply ONLY to a gateway-served model
    (`is_gateway_model`). A Claude-direct dispatch has no equivalent cheap
    probe, and none is built here: probing a vendor endpoint on every
    dispatch buys a slower dispatch and a new false-refusal mode, not a
    safer one.

    `origin_exempt=True` skips condition 4 and ONLY condition 4, for a model
    read off a work item's `model_choice` (slice 2, `_parse_item_model`), which
    the Library accepts only through a route no agent credential can reach.
    Conditions 1-3 still run, in the same order, because an operator's choice
    can still name a model this platform does not serve or cannot reach. Nothing
    on the CLI sets it: the only caller that passes it is `_spawn_dispatch`,
    from a record it just parsed.
    """
    if not _model_known(model):
        # `model` can now arrive off a work item (slice 2), a store this process
        # does not control, so it is sanitised where it is echoed.
        return f"resolves to {SC.sanitise(model, max_len=80)!r}, which this platform does not serve"
    if is_gateway_model(model):
        try:
            _gateway_virtual_key()
        except SpawnPreflightError:
            return "no credential covers it"
        if not _gateway_reachable():
            return f"its provider ({_gateway_url()}) is unreachable"
    if origin_exempt:
        return None
    return _model_override_refusal(parent)


# --- a model set on a work item (model-lane epic issue_01M35KQ8WTW8R3WSKXS81TV2DZ,
# slice 2) ---------------------------------------------------------------------
#
# THE SHAPE THIS READS, served by the Library's `GET /items/{id}`:
#
#     item["model_choice"] = None
#         | {"model": str, "reason": str, "set_by_client": str,
#            "acting_human": str, "set_at": str}
#
# The only writer is `POST /items/{id}/model`, gated on the human-reserved
# capability `item.model`, which only an approved client holds; `/correct`,
# `/revision` and `POST /items` refuse `model_choice` by name. So a non-null
# choice was written through that route, and no agent credential can reach it.
#
# WHAT THE LIBRARY VOUCHES FOR IS THE CLIENT, NOT THE PERSON. `set_by_client`
# comes from the authenticated credential. `acting_human` is copied from the
# request body and is NOT verified, so this file names it only as the CLAIMED
# actor. A choice is honoured on an AUTONOMOUS dispatch because of the route it
# came through; nothing here believes a person was checked.
#
# `null` (or an empty object) means no item override and the roster default
# applies. Any other shape that lacks a non-empty `model` or `set_by_client` is
# MALFORMED, and the dispatch is refused: the Library's writer never produces
# one, so it is either a defect on that side or a forged record, and dispatching
# on the roster default would drop the operator's choice with nothing saying so.

class _MalformedModelChoice(ValueError):
    """`model_choice` is present but is not the shape the Library writes."""


def _parse_item_model(item: dict) -> dict | None:
    """The model choice a work item carries, or `None` when it carries none.

    Returns `{"model", "reason", "client", "claimed_actor", "set_at"}`. Raises
    `_MalformedModelChoice` when `model_choice` is neither null/empty nor an
    object with a non-empty `model` and `set_by_client`. Every string is
    returned RAW; the caller sanitises where each one lands."""
    raw = item.get("model_choice") if isinstance(item, dict) else None
    if raw is None or raw == {} or raw == "":
        return None
    if not isinstance(raw, dict):
        raise _MalformedModelChoice("model_choice is not an object")
    model, client = raw.get("model"), raw.get("set_by_client")
    if not isinstance(model, str) or not model.strip():
        raise _MalformedModelChoice("model_choice has no model")
    if not isinstance(client, str) or not client.strip():
        raise _MalformedModelChoice("model_choice has no set_by_client")
    actor, reason, set_at = raw.get("acting_human"), raw.get("reason"), raw.get("set_at")
    return {
        "model": model.strip(),
        "reason": reason.strip() if isinstance(reason, str) else "",
        "client": client.strip(),
        "claimed_actor": actor.strip() if isinstance(actor, str) else "",
        "set_at": set_at if isinstance(set_at, str) else "",
    }


def _item_override_channel(choice: dict) -> str:
    """The ledger/meta channel text: the client that wrote the choice."""
    return f"work_item:{choice['client']}"


def _item_override_actor(choice: dict) -> str:
    """The person the client SAID acted, marked as the unchecked claim it is."""
    return f"{choice['claimed_actor'] or 'no actor named'} (claimed, unverified)"


def _fetch_work_item(issue_id: str) -> tuple[dict | None, str | None]:
    """`(item, None)` when the work item was read, `(None, why)` when it could
    not be. The one seam `spawn --issue` reads the Library through.

    `why` is a status code or exception NAME only, never a message: the
    refusal it feeds must not carry a token, a URL or raw error text.

    The read goes to the Library's FIXED default address, never through
    `vault_plane`'s environment-derived one. Its result exempts a dispatch from
    the origin refusal, so its source must be one the caller cannot repoint: a
    dispatched worker could otherwise set LIBRARY_BASE_URL (or
    VAULTS_ON_LIBRARY / ORIENT_BASE_URL) to its own listener, serve itself a
    model_choice, and skip the refusal.

    Inline on the dispatch's critical path, so short: `IC.DISPATCH_READ_TIMEOUT`,
    not the module's general-purpose `_TIMEOUT` — a slow Library is a refusal,
    not a multi-second hold on the spawn. The same constant bounds
    knowledge-ctx's `session_topics()` read of this same item, so the two
    critical-path reads share one number rather than drifting apart."""
    try:
        import issue_client as IC  # name binding only: agentctl's import already loaded it, via policy_client
        res = IC.get_item_from_default_library(issue_id, timeout=IC.DISPATCH_READ_TIMEOUT)
    except Exception as e:  # noqa: BLE001 — a read that raises is a read that failed
        return None, e.__class__.__name__
    if res.get("status") != "ok":
        return None, str(res.get("status"))
    return res.get("item") or {}, None


def _record_item_override_meta(run_dir: Path, args: argparse.Namespace) -> None:
    """Stamp the run's meta.json with how an item-sourced model reached it, so
    the run's own record (not only the ledger row) names the client that wrote
    it and the actor that client claimed. A no-op for every run whose model did
    not come off a work item."""
    choice = getattr(args, "_item_model_choice", None)
    if not choice:
        return
    T.update_meta(run_dir,
                  model_override_channel=SC.sanitise(_item_override_channel(choice), max_len=200),
                  model_override_actor=SC.sanitise(_item_override_actor(choice), max_len=200))


def _announce_item_override(*, issue: str, run_id: str, agent: str, repo: str,
                            model: str, client: str, actor: str, reason: str) -> None:
    """The two loud surfaces beyond the ledger row, for a dispatch that HONOURED
    a model off a work item: a comment on the item naming the run, and one alert
    per override on the team site's engineering alerts stream (the existing
    three-in-24h Slack alert is separate and untouched).

    Each is independently best-effort and short-timeout, because this sits
    inline on dispatch: a failed post is reported on stderr and never fails the
    dispatch. Everything interpolated arrived from a store this process does not
    control and passes `sanitise` first."""
    s_issue = SC.sanitise(issue, max_len=200)
    s_model = SC.sanitise(model, max_len=80)
    s_client = SC.sanitise(client, max_len=200)
    s_actor = SC.sanitise(actor, max_len=200)
    s_reason = SC.sanitise(reason, max_len=200) or "(none recorded)"
    text = (f"Model override honoured: run {run_id} ({agent} on {repo}) ran on "
            f"{s_model} because {s_issue} carries that model, set through client "
            f"{s_client}; the person it names, {s_actor}, is the client's claim "
            f"and was not checked. Reason recorded: {s_reason}")
    try:
        import issue_client as IC
        res = IC.comment_on_issue(issue, text, run_id=run_id)
        if res.get("status") != "ok":
            print(f"  model override: comment on {s_issue} NOT posted "
                  f"({res.get('status')})", file=sys.stderr)
    except Exception as e:  # noqa: BLE001
        print(f"  model override: comment on {s_issue} NOT posted "
              f"({e.__class__.__name__})", file=sys.stderr)
    try:
        SC.post_alert("agent-platform", "Work-item model override honoured. " + text,
                      meta={"run_id": run_id, "issue": s_issue, "model": s_model,
                            "client": s_client, "claimed_actor": s_actor, "agent": agent, "repo": repo},
                      timeout=3)
    except Exception as e:  # noqa: BLE001
        print(f"  model override: alert NOT posted ({e.__class__.__name__})",
              file=sys.stderr)


def _preflight_python_worktree(worktree: Path) -> None:
    """Fail loudly if the worktree's venv Python is missing or broken.

    Runs at spawn admission, after worktree allocation but before the claude
    process starts. Skips silently for repos without a .venv (hollis,
    convivy-orient — no Python project). For repos with .venv, converts the
    silent wrong-interpreter failure — where bare pytest resolves to Homebrew's
    /opt/homebrew/bin/pytest under Python 3.14 with older globally-installed
    deps (sqlalchemy 2.0.40 vs the repo's 2.0.51), and the resulting traceback
    frames the repo rather than the interpreter — into a diagnosable error at
    allocation time.

    The linked venv comes from :func:`worktrees._link_primary_venv`, which
    symlinks the primary checkout's .venv into every dispatched worktree."""
    venv_dir = worktree / ".venv"
    if not venv_dir.is_dir() and not venv_dir.is_symlink():
        return  # no venv in this repo — nothing to check
    python_path = venv_dir / "bin" / "python"
    if not python_path.exists():
        print(
            f"preflight FAILED: {python_path} does not exist in worktree "
            f"{worktree}. The repo's primary .venv was not linked during "
            "worktree provisioning. A worker here would resolve bare pytest "
            "to the global Homebrew install under Python 3.14 with older "
            "globally-installed deps instead of the repo's .venv — refusing "
            "to spawn.",
            file=sys.stderr,
        )
        raise SystemExit(1)
    cp = subprocess.run([str(python_path), "--version"],
                         capture_output=True, text=True)
    if cp.returncode != 0:
        print(
            f"preflight FAILED: {python_path} in worktree {worktree} cannot "
            f"run: {cp.stderr.strip()}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    version = cp.stdout.strip()
    print(f"preflight: worktree {worktree.name} Python {version}",
          file=sys.stderr)


# Repos whose spawn default is a NAMED profile rather than <product>/daytime.
# convivy-commercial maps to the `company` product (projects.EXPLICIT_PROJECT_BY_NAME),
# but `company` has no `daytime` profile at all — its only one is
# projects/company/profiles/commercial.yaml (ARCH-124, re-pointed ARCH-438). Every
# other mapped repo's product carries a `daytime`, so this table stays this small
# on purpose: add a row only when the product's default profile is genuinely not
# named `daytime`, never as a per-agent or per-task override.
#
# No mirror needed in knowledge-ctx: the project table resolves a repo to a
# PROJECT, and a bare profile name (whatever this table names) is passed straight
# through to `projects/<project>/profiles/<name>.yaml` — knowledge-ctx already
# resolves the bare name `commercial` for convivy-commercial with no code change,
# since it never derives the profile name itself.
_DEFAULT_PROFILE_BY_REPO = {
    "convivy-commercial": "commercial",
}


def default_profile(repo: str, agent_name: str) -> str:
    """Returns the qualified profile (e.g. 'vivy/daytime') for storage in
    meta.json. The CLI flag form (just 'daytime'/'overnight') is derived from
    this via `_profile_name()`."""
    # NO FALLBACK PRODUCT. This read `.get(repo, "shared")`, which resolved an
    # unmapped repo to a profile that EXISTED — so a repo nobody had mapped
    # silently got the KB's review crew and corpus instead of failing, and the
    # missing row looked like a present one. ARCH-438 retires `shared`, which
    # would have turned that into "profile not found:
    # projects/shared/profiles/daytime.yaml" — loud, but naming a scope that no
    # longer exists and sending the reader hunting.
    #
    # Failing here names the table and the directory rule, which is what the
    # caller has to fix.
    #
    # A repo resolves to a project by an explicit row in
    # projects.EXPLICIT_PROJECT_BY_NAME, or by having its own `projects/<repo>/`
    # in the knowledge repo. When there is none, or the project lacks the profile,
    # `platform/default` is the fallback if the Library serves it (an adopter's
    # seed does; Convivy's machine does not, so every refusal below stands there).
    #
    # The default is narrow on purpose: it stands in only for a repo that
    # resolves to no project, or to a project with no profile files at all. A
    # project that has profiles but not `<name>` is a wrong name and is returned
    # as `<project>/<name>`, so it fails as "profile not found" downstream.
    product = projects.resolve_project(repo, KNOWLEDGE_ROOT)
    name = _DEFAULT_PROFILE_BY_REPO.get(repo, "daytime")
    # Whether a profile exists is asked of the Library (`GET /profiles`), not
    # a `projects/<project>/profiles/` directory walk — CQ·371: a machine
    # with no knowledge checkout must still resolve a dispatch's profile.
    variants = _library_profile_variants()
    # A private crew, or an unreadable registry, takes no generic profile.
    has_default = ((projects.DEFAULT_PROFILE_PROJECT, projects.DEFAULT_PROFILE_NAME)
                   in variants and not projects.default_profile_refused(repo))
    if product is not None and (
            _variants_has_profiles(variants, product) or not has_default):
        return f"{product}/{name}"
    if has_default:
        used = f"{projects.DEFAULT_PROFILE_PROJECT}/{projects.DEFAULT_PROFILE_NAME}"
        why = (f"repo {repo!r} maps to no project" if product is None
               else f"project {product} has no profiles")
        print(f"agentctl: {why}; using default profile {used}", file=sys.stderr)
        return used
    if projects.default_profile_refused(repo):
        print(f"agentctl: {repo!r} is a private crew directory (or the registry could "
              f"not be read) and takes no default profile", file=sys.stderr)
    raise SystemExit(
        f"no knowledge project mapped for repo {repo!r}, and no --profile was given. "
        f"Profiles are served from the Library: pass --profile <project>/<variant>, "
        f"or have the crew's profile loaded into the Library. A repo can also be "
        f"mapped in projects.EXPLICIT_PROJECT_BY_NAME.")


def _profile_name(qualified: str) -> str:
    """Extract the 'daytime'/'overnight' part of a 'product/profile' string."""
    return qualified.split("/", 1)[1] if "/" in qualified else qualified


def _slug(text: str, *, prefix: str = "", maxlen: int = 32) -> str:
    """`branch_naming.slugify`, moved to a lib module (CQ·354) so
    `issue_gate.py`'s branch scan can call the exact same transform when it
    predicts a dispatched worker's branch fragment, instead of a second
    implementation of this regex that could drift from it. Kept as `_slug`
    here, rather than inlining `BN.slugify` at each of this file's own call
    sites, so this file's output is unchanged."""
    return BN.slugify(text, prefix=prefix, maxlen=maxlen)


def _task_hash(text: str) -> str:
    """Return an 8-char hex digest of *text* as a stable-per-task discriminator.

    Same *text* produces the same hash; different text produces a different
    hash (2^32 possible values, birthday bound ~2^16). Used to distinguish
    bug-fixer/bug-investigator purposes for tasks that share a leading slug but
    differ in detail (e.g. two "Fix mode for in-box issue issue_…" tasks for
    different issues).
    """
    return hashlib.sha256(text.encode()).hexdigest()[:8]


# Dispatched workers that must NOT share the interactive primary worktree.
# `agentctl spawn` re-individuates the knowledge-ctx profile into its target
# worktree (activate_profile → `knowledge-ctx use --force`). Re-individuating
# into a tree that holds a live `claude` (a daytime `co` session) trips
# knowledge-ctx's live-process guard (ARCH-080) unless the individuation is a
# perfect no-op — which the ARCH-135 deepseek squeeze breaks, since the gateway
# flip changes the rendered profile. The guard then aborts the spawn and the
# daytime orchestrator falls back to Task→sonnet, off-gateway, defeating the
# squeeze (vivy, 2026-06-11; 5 blocked_live events that day, all on the primary
# tree). A per-task dedicated worktree removes the overlap, mirroring how
# bug-fixer/bug-investigator already isolate. Read-only workers keep the diff:
# `reviewer` resolves it from shared worktree refs (git worktrees share the
# object store + branch refs), `explainer` reads the parent worktree by absolute
# path. `security-reviewer` joined the list in ARCH-184 (review integrity): a
# review must be pinnable to an exact commit, and pinning hard-resets the
# worktree — which we refuse to do to the shared primary tree, so the reviewer
# needs its own. (The steward's daytime security-reviewer runs via Task in-process
# and never reaches agentctl spawn, so this only changes the overnight path, where
# isolation is strictly safer.)
#
# `planning-orchestrator` joined in 2026-07-29 (ARCH-391): it was running in the
# primary checkout for multi-hour drain runs, holding the lock the autopull (PR
# #288) defers to. The autopull fast-forwards only when no live run holds the
# primary — so an orchestrator that runs the whole issue drain manufactured the
# deploy backlog and then held the lock that prevented deploying it. Measured:
# ~4 of 20 autopull cycles deferred since PR #288 went live, three consecutive,
# all one drain. Giving it a per-task dedicated worktree removes the contention
# entirely. There is no technical dependency on the primary: agentctl's library
# imports are hardcoded to ~/.local/lib/agent-platform (independent of cwd),
# workers are dispatched via --on <product> (a name, not a path), and the ops MCP
# tools read/write the control store (also path-independent). The orchestrator
# also avoids the ARCH-080 live-process collision that profile re-individuation
# into the shared primary would trip during a concurrent daytime co session.
#
# `architect` joined 2026-07-29 (issue_01KYQ9N00Q7HJYSETBV8TPY3D9). It was absent,
# so `derive_purpose` returned None and it resolved to the primary — which
# `overnight-triage`, also absent, already held for the length of its stage. Triage
# was what spawned the architect on an arch-led night, so the parent held the tree its
# own child needed and every arch-produce step died on `worktree busy — held by
# run-<triage>`. Sous Chef went 7 days without an arch pass (last 2026-07-22, against
# a 72-hour threshold) with four proposals and the 2026-07-26 security findings
# F21–F25 unreviewed.
#
# The failure was quiet in the way that matters: WorktreeBusy is a refusal, not a
# crash, so the night completed, the ledger recorded every stage `done`, and the only
# trace was one `fyi` line in digest-input. A product silently stops receiving
# architectural review while the run looks healthy.
#
# A dedicated worktree is right on the merits, not just as a way out of the
# collision: the architect reads the product's code deeply and writes proposal docs,
# which is the `coder`/`refactorer` shape.
#
# `overnight-triage` was deliberately left off this list, back when it ran: moving
# EITHER side of the collision fixed it, and the architect was the correct side.
# Triage wrote its worklist to the run dir rather than the repo and read a product
# queue that lived in substrate, so it had no repo-write reason for its own tree;
# relocating a live nightly stage would have been a behavioural change deserving
# its own review, the same judgement #295 and #296 made. overnight-triage itself
# was retired 2026-09-14 (agent-platform#578 deleted its only dispatcher,
# bin/launch-overnight), so this is history, not a live exclusion.
_DEDICATED_WORKTREE_WORKERS = ("coder", "refactorer", "test-writer", "reviewer",
                               "security-reviewer", "explainer", "planning-orchestrator",
                               "architect")

# Internal-app crews carry a per-app prefix (`hollis-coder`, `svc-reviewer`,
# `sel-coder`, and the legacy `pa-` alias); strip it to match the underlying role.
# Not the multi-hyphen role names themselves (`security-reviewer`, `bug-fixer`),
# so this is an explicit prefix set, not a split-on-first-hyphen.
#
# KEPT IN SYNC WITH review_protocol.INTERNAL_APP_PREFIXES, and pinned by
# test_agentctl_and_review_protocol_prefixes_match. It is a literal rather than
# `RP.INTERNAL_APP_PREFIXES` for a reason that is now historical rather than
# live: agentctl used to import its libs from the DEPLOYED path
# (`sys.path.insert(0, ~/.local/lib/agent-platform)`), which symlinked to
# whatever the primary checkout was on, so a branch's agentctl imported MAIN's
# review_protocol and a cross-module reference would pass CI (no ~/.local
# there) while breaking every worktree until merge. agentctl now resolves its
# lib relative to its own `__file__` (ARCH-229), so that skew is closed and a
# worktree's agentctl sees that worktree's own review_protocol. The two lists
# are left as duplicated literals anyway, since collapsing them is a separate
# change from closing the import seam that once required the duplication.
#
# The two lists drifted once, and both halves of that drift failed silently
# (2026-07-12):
#   - Here, `svc-` and `sel-` were missing, so the kit's and Selector's crews were
#     not internal-app agents. Their reviewers were therefore not review-class, so
#     ARCH-246 DENIED them `gh pr comment` — the review ran, cost tokens, reached a
#     verdict, and died in the run log. A whole svc review of convivy-app-kit PR #45
#     was lost this way, surfacing only because a human went looking for the missing
#     comment. `--review-sha` was also rejected for them (no ARCH-184 pinning), and
#     `svc-coder`/`sel-coder` missed _DEDICATED_WORKTREE_WORKERS, so they wrote in
#     the PRIMARY checkout instead of their own worktree.
#   - There, `_review_base` still stripped only `pa-`, so the ARCH-193 authenticity
#     gate rejected every `hollis-` review stamp as "not a review-class agent".
#
# The prefix is the crew's, not the repo's: convivy-app-kit's crew is `svc-*` and
# selector's is `sel-*`, and the Library crew's `platform-*` are filed in the
# central roster. When you add a crew, add its prefix HERE and in
# review_protocol, in the same commit — the test enforces both.
#
# It happened again on 2026-09-06 (issue_01M1VR0JCH2YWZJCD2MPJKW8Q7): `platform-`
# was missing, so `platform-coder` committed into the Library PRIMARY checkout
# and `--pr` refused it, blocking the round-fix path. Same miss, second crew, and
# the 2026-07-12 paragraph above had already described it. The lesson this time
# is about the DEFAULT rather than the list: an unregistered prefix used to mean
# "bare role", which for a write-class worker is the harmful reading, and it
# looked like success until someone found the checkout on a branch. So `spawn`
# now refuses a name that reads as `<prefix>-<worktree- or review-class role>`
# with an unregistered prefix (`_unregistered_crew_prefix`), naming both tuples.
# Nothing here recognises a crew the registrar forgot; the refusal is what makes
# forgetting loud, at the one site every crew passes through however it was made.
# `wb-` is the write-better crew (operator, 2026-09-06: yes to that crew running
# reviewers), so `wb-reviewer` is review-class rather than refused at dispatch.
_INTERNAL_APP_PREFIXES = ("hollis-", "svc-", "sel-", "pa-", "deck-", "orient-", "platform-",
                          "wb-", "sig-", "archy-")

# KEPT IN SYNC WITH review_protocol.STALE_REPLAY_MARKER, pinned by
# test_agentctl_and_review_protocol_stale_replay_marker_match. Same history as
# _INTERNAL_APP_PREFIXES above: the duplication was once load-bearing against a
# deployed-path import seam that agentctl's own `__file__`-relative resolution
# (ARCH-229) has since closed. Left as two literals bound by a test anyway,
# since collapsing them is a separate change.
_STALE_REPLAY_MARKER = "stale replay"


def _strip_app_prefix(agent_name: str) -> str:
    for p in _INTERNAL_APP_PREFIXES:
        if agent_name.startswith(p):
            return agent_name[len(p):]
    return agent_name


# Review-class agents (role base, after stripping an internal-app prefix). Their
# dispatch must pin an exact review commit (ARCH-184) so they can't review a stale tree.
_REVIEW_AGENTS = ("reviewer", "security-reviewer")


def _is_review_agent(agent_name: str) -> bool:
    return _strip_app_prefix(agent_name) in _REVIEW_AGENTS


# THE ROUTING DECISION (platform/decisions/0090, platform/specs/builder-runs-
# as-two-accounts): once Builder runs as two accounts, `agents` cannot sign a
# review itself — the only path is `sudo /opt/builder/libexec/review-launch`,
# a root-owned program that fetches the PR, runs the reviewer session as
# `reviewers`, and posts a GitHub check with a key `agents` never reads. That
# account, the sudo rule and the launcher binary do not exist on this machine
# yet; today's direct dispatch (run the claude session in-process, post a
# comment-stamp via `agentctl review-post`, decide via `review-status`'s
# stamp gate) has to keep working until they do.
#
# THE SIGNAL IS THE LAUNCHER'S OWN PRESENCE ON DISK, nothing else. Every
# caller below (`_spawn_claude`, `cmd_review_status`, `cmd_review_post`) asks
# this same question before deciding which regime applies, so the day
# Shipwright's installer places the binary, every caller flips together with
# no second switch to forget. A monkeypatch of this one function is how every
# test here exercises the "installed" branch without a real account, a real
# sudo rule, or a real launcher (platform/decisions/0090's own constraint).
_REVIEW_LAUNCH_PATH = Path("/opt/builder/libexec/review-launch")


def _review_launch_path() -> "Path | None":
    """The launcher's path, if it exists and is executable — None otherwise,
    meaning "route through today's direct dispatch instead" (see the
    docstring just above)."""
    try:
        if _REVIEW_LAUNCH_PATH.is_file() and os.access(_REVIEW_LAUNCH_PATH, os.X_OK):
            return _REVIEW_LAUNCH_PATH
    except OSError:
        pass
    return None


def _review_launch_cmd(launcher: Path, *, repo: str, pr, role: str, run_id: str) -> list[str]:
    """The one sudo invocation `_spawn_claude` makes instead of launching
    `claude -p` directly, once `_review_launch_path()` says the launcher is
    installed. `role` is stripped of any internal-app crew prefix
    (`hollis-reviewer` -> `reviewer`) because the launcher's own grammar
    (`review_launch.ROLES`) knows only the two product role names — the crew
    a dispatch came from is an `agentctl` deployment detail the launcher has
    no reason to see."""
    slug = repo if "/" in repo else f"convivy/{repo}"
    return ["sudo", str(launcher), "--repo", slug, "--pr", str(pr),
            "--role", _strip_app_prefix(role), "--run-id", run_id]


# PR-review-surface commands denied to non-review agents (ARCH-246). Every way an
# agent can post to a PR thread or land it:
#   - gh pr comment      — the review-stamp surface
#   - gh pr review        — the formal review verb
#   - gh pr merge         — landing (also blocked globally by the ARCH-100 hook;
#                           kept here for explicit, defense-in-depth intent)
#   - gh issue comment    — gh treats a PR as an issue, so this posts to the same
#                           thread (PR #59 security review)
#   - agentctl review-post — the command that EMITS the machine-parseable review
#                           stamp; the most purpose-built forgery path, so it must
#                           be denied to workers even though the ARCH-193 run-id
#                           gate would reject the resulting stamp at land time
#                           (this stops the official-looking comment landing in the
#                           timeline at all). Review agents keep it (it's how they
#                           post their verdict).
# Residual (not closeable by a verb deny): `gh api .../issues/N/comments` and raw
# shell-escape (curl/urllib) can still POST. The ARCH-193 authenticity gate is the
# check of record; this layer closes the casual/ergonomic paths.
_PR_REVIEW_DENY = (
    "Bash(gh pr comment:*)", "Bash(gh pr review:*)", "Bash(gh pr merge:*)",
    "Bash(gh issue comment:*)", "Bash(agentctl review-post:*)",
)

# Same posting surface, applied to a review-class agent itself under `--eval-mode`
# (the review-replay eval harness, agent-platform#813 round 1). Round 1 found the
# PREVIOUS version of this list — `agentctl review-post` deliberately left out so
# eval mode could take a forced-dry-run branch — gave the replayed model a
# cooperative-only control: `env -u AGENTCTL_EVAL_MODE agentctl review-post ...`
# stripped the one signal that branch read and posted for real, and neither this
# list nor `_PR_REVIEW_DENY` ever closed `gh api .../issues/N/comments`, a second
# route to the same PR thread. Both are included now, as DEFENSE IN DEPTH: the
# real control is `tool_policy.resolve`'s eval branch, which grants NEITHER at the
# allow-list level under the `dontAsk` mode eval mode forces unconditionally (see
# `_spawn_claude`), so there is no route to post regardless of this deny list. The
# replay writes its verdict to a file instead — see `_eval_mode_system_prompt`.
_EVAL_MODE_PR_DENY = (
    "Bash(gh pr comment:*)", "Bash(gh pr review:*)", "Bash(gh pr merge:*)",
    "Bash(gh issue comment:*)", "Bash(gh api:*)", "Bash(agentctl review-post:*)",
)


# Slack WRITE tools, denied to every dispatched agent. Reads stay — a workflow that
# still polls a channel keeps working, and the retirement was always about output.
#
# WHY A DENY AND NOT A ROSTER EDIT. agent-platform#293 deleted the Slack CLI binaries
# and knowledge#126 stripped the Slack grants from every agent spec. Neither removed
# the capability, because a spec's `tools:` list is RECORDED, NOT ENFORCED
# (`_enforce_tool_policy`, ARCH-346, default off) — so the allow-list is advisory and
# an agent can reach any MCP tool the session has connected.
#
# It did. On 2026-07-29 an `explainer` whose instructed binary was gone called
# ToolSearch with `select:mcp__claude_ai_Slack__slack_send_message`, found the tool,
# posted the overnight digest to #overnight-digest at 01:50, and then logged an
# `infrastructure-gap` signal reporting the very binaries it had just routed around.
# The post landed under the operator's own Slack identity rather than the bot's, because the
# MCP server acts as the authenticated user — a worse attribution story than the
# bot-token path being retired.
#
# This list is the enforcement, and it works where the roster does not: the spawn site
# passes `--disallowedTools` UNCONDITIONALLY, while `--allowedTools` is gated on
# `enforcing`. A deny here therefore holds today, with policy enforcement still off.
#
# ENUMERATED, NOT WILDCARDED, and that is a real trade-off. `mcp__claude_ai_Slack__*`
# would catch a future write tool automatically but would also deny every read, which
# is the half being kept. So new write tools added to the Slack MCP server are NOT
# covered until added here. `test_slack_write_deny_covers_every_known_write_tool`
# pins the list; if the server grows a write verb, that test is the place it gets
# noticed.
_SLACK_WRITE_DENY = (
    "mcp__claude_ai_Slack__slack_send_message",
    "mcp__claude_ai_Slack__slack_send_message_draft",
    "mcp__claude_ai_Slack__slack_schedule_message",
    "mcp__claude_ai_Slack__slack_add_reaction",
    "mcp__claude_ai_Slack__slack_create_canvas",
    "mcp__claude_ai_Slack__slack_update_canvas",
    "mcp__claude_ai_Slack__slack_create_conversation",
)

# A dispatched worker reports through its artifact — a PR, a review stamp, a return
# value — and exits; it never holds the messaging tools (operator, 2026-08-18, ADR-0046).
# Verified live rather than assumed: a scratch agent with no `SendMessage` in its
# roster `tools:` still reached the real message dispatcher under both an ordinary
# launch and `--strict-mcp-config` (CFO's own wall), which only strips MCP servers
# and never touches this built-in — the roster list is not an enforcement boundary
# on this path (ADR-0046 amendment; the case that forced the point was a black-box
# crew's own worker able to `SendMessage` crew content straight to another `co`,
# an exit `platform/decisions/0043-black-box-crews` never enumerated).
#
# HARDCODED STOPGAP, DELIBERATELY. The durable fix is a Library-owned deny-list,
# keyed per agent/crew/model and mutable only through Orient, so no agent can widen
# its own permissions the way a hardcoded tuple in this repo cannot prevent. Do not
# generalize this into a config file or lookup layer while that lands — two names,
# applied unconditionally, is the whole fix until the Library owns the shape.
# A DISPATCHED WORKER FILES NOTHING (platform/decisions/0073, operator 2026-09-10).
# Its findings travel in its review-post, and its co decides whether to file; a
# run with no co files nothing at all. The friction behind it is that the queue
# became self-feeding — filing is cheaper than finishing, and an out-of-scope
# finding wastes the run that chases it before it wastes the triage. The operator's
# instruction was to enforce it by REMOVING THE CAPABILITY, because an
# instruction is not enough: workers file under load.
#
# A TUPLE HERE RATHER THAN THE LIBRARY'S DENY-LIST, which is what ADR-0073
# originally specified and what the amendment now records. The Library's policy
# table is EXACT-MATCH WITH NO WILDCARDS, keyed on agent, crew and model — so a
# fleet-wide "dispatched workers never create items" would need one row per
# combination, and a crew or model added later would silently get no row and
# file freely. That fails OPEN, which is the wrong direction for a rule whose
# whole purpose is that it holds without anyone remembering it. The same
# reasoning keeps the other categorical lists here, as the note below says,
# "until the Library models that scoping".
#
# UNCONDITIONAL, and that is the whole mechanism. `bin/co` never calls this
# function — an interactive session is not on this path at all — and every
# `agentctl spawn` resolves `TP.AUTONOMOUS` regardless of `--foreground`, which
# changes only detaching and streaming. So "denied on the dispatch path" IS "no
# co means no filing", with no origin threading required.
#
# THE WORKING VERBS STAY. `issue_claim`, `issue_comment` and `issue_resolve` are
# how a bug-investigator or bug-fixer records the task it was dispatched ON; a
# blanket ops-write deny would break the work rather than the filing.
_FILING_DENY = (
    "mcp__ops__issue_create",
    "mcp__ops__bug_create",
)

# `knowledge-ctx`'s `session_topics()` reads the dispatched item's `topics` to
# decide which `binds_topics` instruction blocks constrain THIS session
# (issue_01M3V1J3TCHC7CWCZ9534WD6KG) — so a dispatched agent able to rewrite
# `topics` on its own item could drop a constraining block before its own
# revise-round re-dispatch rendered it (security-reviewer, run-5299a04e).
#
# `mcp__ops__issue_correct` is the only live write tool that can change
# `topics` ON AN EXISTING ITEM: it takes `topics` and needs no lease
# (platform/skills/groom-work-items.md — "needs no checkout of your own"),
# so a run holding its own item's lease is not stopped by that lease either.
# `issue_revise` has no `topics` parameter at all and refuses it by name; it
# cannot reach this field. `issue_create`'s `topics` only seeds a NEW item
# and is already denied above via `_FILING_DENY`. Every `bug_*` alias is a
# thin wrapper over the `issue_*` route it deprecates (ARCH-361) and none
# passes `topics` through. Checked against the full `mcp-ops-server` tool
# surface, not just the tool the finding named.
#
# The only roster entry that grants `issue_correct` is
# `agent-platform/agents/planning-orchestrator` — the Bosun `co` itself
# (`role: orchestrator`), launched by `bin/co`, which never calls
# `_disallowed_tools` (see that function's docstring above). No
# `agentctl spawn`-dispatched agent holds it as a roster-granted tool.
#
# THIS DENY REMOVES THE TOOL, NOT THE CAPABILITY
# (platform/decisions/0073's 2026-09-11 amendment, measured for
# `_FILING_DENY` in agent-platform#523, and unchanged by this tuple). A
# dispatched worker holds `Bash`, runs as the same user, and can read
# `~/.orient-control/ops-mcp-token` to call `issue_correct` by raw request;
# that route is unaffected by this tuple and stays open. The rule holds by
# the harness for the tool and by instruction for the raw route. Closing
# the raw route is an open decision for the operator, per that amendment — do not
# treat this tuple as having closed it.
#
# UNCONDITIONAL, same reasoning as `_FILING_DENY` beside it: every caller of
# `_disallowed_tools` is a dispatched run, and a dispatched run's own topics
# are not its own to rewrite through this tool.
_TOPICS_WRITE_DENY = (
    "mcp__ops__issue_correct",
)

_MESSAGING_DENY = (
    "SendMessage",
    "ListAgents",
)

# `ScheduleWakeup` schedules a resumption of THIS session, which only exists for
# an interactive `co` under remote control (/loop's dynamic-pacing mode). A
# dispatched run is `claude -p`: its session ends when its turn ends, so no
# wakeup can ever fire into it — unlike `CronCreate` below, this isn't a no-op
# that leaves nothing to fire into, it's a call that convinces the run a
# wakeup WILL resume it, so it ends its turn to "wait," and the process behind
# it is gone for good. On 2026-10-01 three platform-coder runs did exactly
# that after starting their test suites in the background — run-4d1e49bb
# (delaySeconds 600, then 900), run-038357fe and run-34715471 — and lost their
# uncommitted work, $15.50 across the three (issue_01KZPCH0HG7V3NVQP07DXT3QC7,
# comments 4435-4436). Each brief had already told the coder to run tests in
# the foreground; only denying the tool stops the pattern.
_SCHEDULE_DENY = (
    "ScheduleWakeup",
)

# `SendMessage` turned out to be one member of a family, and not the worst one
# (security-reviewer on PR #243, 2026-08-19). All three below share its shape —
# a non-MCP built-in, unenforced by the roster `tools:` list on the autonomous
# path, untouched by `--strict-mcp-config` because it only strips MCP servers —
# and each can move content to infrastructure outside Convivy's control:
#
# - `WebFetch` fetches an arbitrary attacker-controlled URL. Worse than
#   `SendMessage`: that call failed on target resolution (it needs a real `co`
#   to name); `WebFetch` has no equivalent failure mode; a URL with crew content
#   encoded in it reaches whatever server the caller names.
# - `RemoteTrigger` creates/updates claude.ai routines (`action: create/update`,
#   arbitrary `body`) that persist and run OUTSIDE this session entirely — unlike
#   `CronCreate` (checked and left open below), a routine is not session-scoped
#   memory that dies when this process exits.
# - `DesignSync`'s `write_files` uploads local file content to an external
#   claude.ai-hosted design-system project; `get_file` separately reads content
#   other org members wrote, a prompt-injection vector into this session.
#
# Audited and left OPEN, with the reason each stays open recorded here rather
# than left for the next reader to re-derive:
# - `WebSearch` — a real but narrow channel (query text only, no attacker-chosen
#   destination) against a genuine everyday need; a call the operator should make, not
#   this stopgap.
# - `CronCreate`/`CronDelete`/`CronList` — session-only, in-memory, gone when
#   this process exits (its own schema says so); a one-shot dispatched worker's
#   session ends when the task does, so a scheduled job has nothing left to fire
#   into. Harmless rather than merely useless: the call returns and the run
#   carries on, same as it would with no scheduled job at all. `ScheduleWakeup`
#   fails the same way but isn't left open alongside it (see `_SCHEDULE_DENY`
#   above) — it doesn't just create dead state, it tells the run a wakeup WILL
#   resume it, so the run ends its turn to wait for one that can never fire and
#   the work in progress is abandoned. Useless and harmful beats useless and
#   inert.
# - `PushNotification` — reaches only the operator's own terminal/phone; the
#   worst case is unwanted disclosure to the operator, not data leaving Convivy.
# - `Monitor` — its `command` is shell, same surface as `Bash`, which every
#   worker holding it already has reviewed separately; adds nothing new.
# - `EnterWorktree`/`ExitWorktree` — scoped to worktrees of the current
#   repository (validated against `git worktree list`); cannot reach another
#   crew's separate repository.
# - `TaskOutput`/`TaskStop`/`NotebookEdit` — introspection of this session's own
#   background tasks, and local file edit no broader than `Write`/`Edit`.
#
# NOT audited here, deliberately: `Skill`/`Workflow` are a capability-escalation
# question (a worker spawning its own sub-dispatch) rather than an exfiltration
# one, and belongs to its own review rather than folding into this one.
#
# THE EXFILTRATION BUILT-INS (`WebFetch`, `RemoteTrigger`, `DesignSync`) and the
# connector servers are NOT listed in this file. The Library's record carries
# them, and `_library_denials` denies them to every dispatched worker, with an
# explicit allow in the record exempting one target (platform/decisions/0048).


def _is_private_dispatch(repo: str | None, agent: dict | None) -> bool:
    """Is this dispatch a black-box crew's, by EITHER signal that can say so?

    Delegates to `projects.dispatch_is_private` — the single comparison this
    now shares with `session_state._dispatched_by`'s derived-working-on-line
    filter (agent-platform#465 round 2: a repo-only check there let a public
    session's `--agents-dir` dispatch into a private crew leak that crew's
    task text, the same bypass this function exists to close for
    `--strict-mcp-config`/`_disallowed_tools`). See that function's docstring
    in `projects.py` for the full `--agents-dir` argument
    (security-reviewer, run-1031c63b / run-b5dee6b0).

    THE SINGLE GATE, used by both the categorical denials (`_disallowed_tools`) and the
    `--strict-mcp-config` transport wall (`_spawn_claude`) — exactly the
    consolidation security-reviewer asked for on PR #409 (run-8b7bca8d) after
    finding a second unrestricted spawn site protected only by an unrelated
    check. One function, one comparison, reused rather than re-derived at each
    call site."""
    source = agent.get("source") if agent else None
    return projects.dispatch_is_private(repo, source)


def _dispatch_mcp_config_json(agent_name: str, run_id: str, verdict_server: Path,
                              servers: set[str] | None = None) -> str:
    """The `--mcp-config` JSON a non-private dispatch needs once
    `--strict-mcp-config` applies unconditionally (issue_01M4APS4KRPE6ESTZAVEJVFDKC):
    the `kb` and `ops` stdio servers a normal session otherwise gets only from
    the operator's global `~/.claude.json` `mcpServers` block, which
    `--strict-mcp-config` ignores along with everything else outside
    `--mcp-config` — a worktree's own committed `.mcp.json` included. For a
    review-class agent (`_is_review_agent`), also the `verdict` server
    (knowledge#793's mcp-verdict-server): the run's sandboxed Bash cannot read the
    review-record credential, so a reviewer's verdict posts through this MCP
    tool instead — `run_verdict.post`'s own checks are what actually refuse a
    non-reviewer or a PR-less run's call, not withholding the server. All named
    in ONE `--mcp-config` value, since `--strict-mcp-config` makes it the only
    MCP source a dispatch gets.

    `kb`/`ops` point at THIS checkout's `bin/mcp-kb-server`/`bin/mcp-ops-server`
    (resolved beside agentctl's own real path, the same symlink-following
    `Path(__file__).resolve()` the rest of this file uses to find its
    tree), not a copy of the operator's mutable `~/.claude.json` — the
    servers `install.sh` registers under those two names are these two
    scripts, nothing else, so there is nothing to read back from account
    config to get the same servers a dispatch already had.

    `servers` narrows which of `kb`/`ops` are included — `_mcp_servers_for_policy`
    computes it from the run's policy (issue_01M4BT13RP23KRTA80VM6R7HNF), so a
    dispatch whose policy allows no `mcp__kb__`/`mcp__ops__` tool gets neither
    server's schema loaded into the opening context. `None` (every pre-existing
    caller) means both, unchanged from before this parameter existed.

    `servers` never touches `verdict`: the `_is_review_agent` check below adds it
    AFTER the `kb`/`ops` filter, so a review-class agent's own tool-surface
    narrowing (however `servers` was computed) can never drop its one way to post
    a verdict — the thing a reviewer's sandboxed Bash cannot do directly is the
    reason this server exists in the first place.

    PRIVATE DISPATCHES NEVER CALL THIS. `_spawn_claude` passes `--mcp-config`
    only on the non-private branch, so a black-box crew still gets the ZERO
    MCP servers `--strict-mcp-config` alone already gave it (ADR-0043) —
    adding `kb`/`ops`/`verdict` there would be a privacy regression, not a fix;
    a black-box crew's reviewer has no PR review record to post in the first
    place."""
    bin_dir = Path(__file__).resolve().parent
    all_servers = {
        "kb": {"type": "stdio", "command": str(bin_dir / "mcp-kb-server"), "args": []},
        "ops": {"type": "stdio", "command": str(bin_dir / "mcp-ops-server"), "args": []},
    }
    if servers is None:
        servers = set(all_servers)
    mcp_servers = {name: cfg for name, cfg in all_servers.items() if name in servers}
    if _is_review_agent(agent_name):
        mcp_servers.update(json.loads(RV.mcp_config(run_id, verdict_server))["mcpServers"])
    return json.dumps({"mcpServers": mcp_servers}, sort_keys=True, separators=(",", ":"))


def _resolved_agent_tools(agent: dict, agent_name: str) -> tuple[str, ...]:
    """`agent["tools"]` as `_run_session` unions it into the dispatch's tool
    surface (issue_01M4BT13RP23KRTA80VM6R7HNF): `resolve_agent` maps a falsy
    value to `()`/`[]` on both branches, but a TRUTHY non-list value passes
    through unchanged on either one — a served non-list from the Library, or
    (before the companion `_parse_tool_rules` fix) a comma-separated roster
    string that a bracket-only frontmatter parser left as one long string
    instead of a list. Unioned via `(*policy.allowed, *agent_tools)` or fed
    to `tuple()`, a string explodes into its individual characters rather
    than refusing, silently dropping every multi-char rule it names
    (security-reviewer, PR #811 round 2) instead of failing loud. Refuses the
    dispatch outright, naming the agent, rather than iterating a shape it
    can't trust."""
    raw = agent.get("tools") or ()
    if not isinstance(raw, (list, tuple)) or not all(isinstance(t, str) for t in raw):
        raise SystemExit(
            f"dispatch refused: agent {agent_name!r}'s resolved tools grant is "
            f"{raw!r} ({type(raw).__name__}), not a list of strings")
    return tuple(raw)


def _resolved_agent_builtins(agent: dict | None, agent_name: str) -> tuple[str, ...] | None:
    """`agent["builtins"]` (issue_01M4C04GYC3R9NPZCK9RTYPASZ, CQ·426): an optional
    policy field that sets `--tools` DIRECTLY, bypassing `_builtin_tool_surface`'s
    enforced/unenforced branch entirely — see that function's docstring for why a
    coder needs this. `None` means the field is absent, which is the overwhelming
    majority of agents today; `_builtin_tool_surface` falls back to #811's
    policy-derived surface in that case.

    Validated the same way `_resolved_agent_tools` validates `agent["tools"]`,
    because this value reaches `--tools` argv the same way: refuses, naming the
    agent, rather than silently dropping or exploding a shape it can't trust."""
    raw = (agent or {}).get("builtins")
    if raw is None:
        return None
    if not isinstance(raw, (list, tuple)) or not all(isinstance(t, str) for t in raw):
        raise SystemExit(
            f"dispatch refused: agent {agent_name!r}'s resolved builtins list is "
            f"{raw!r} ({type(raw).__name__}), not a list of strings")
    return tuple(raw)


def _mcp_servers_for_policy(policy, agent_tools: tuple[str, ...] = ()) -> set[str] | None:
    """Which of the two public-dispatch MCP servers (`kb`, `ops`) a non-private
    dispatch's `--mcp-config` should include, read off the UNION of the policy's
    own allow rules and the agent's own roster `tools:` grants
    (issue_01M4BT13RP23KRTA80VM6R7HNF): a reviewer whose policy allows only
    `mcp__ops__issue_get`/`mcp__ops__issue_list` has no use for the `kb` server's
    schema reaching its opening context UNLESS its own roster entry grants a
    `mcp__kb__` tool — and `reviewer`/`security-reviewer`/`planner`/
    `platform-planner`/`scout` all do, to run the ADR check their own role file
    and the security-review rubric instruct (round-1 review of this change,
    PR #811: `tool_policy.py`'s `_READ_SURFACE` grants none, so narrowing on
    `policy.allowed` alone cut every one of them off from `kb` on every dispatch,
    not only once live enforcement turns on). No agent may lose a server its own
    definition grants; `agent_tools` is `_run_session`'s already-resolved
    `agent["tools"]`, not re-read here.

    `agent_tools` plays no role unless the policy narrows at all: when this
    returns `None` (see below), today's full both-servers behaviour already
    covers anything `agent_tools` could ask for.

    Returns `None` — "keep both, today's behaviour" — whenever the policy gives
    no explicit allow-list to read: no policy (`tool_policy` didn't import),
    a build-class agent (`enforced=False`, ARCH-346's honest "deny-list only"
    state), or an enforced policy whose `allowed` is empty. Narrowing only
    happens when there is a real allow-list to narrow BY.

    Scans for the `mcp__kb__`/`mcp__ops__` prefix rather than requiring an exact
    tool name, matching how Claude Code itself resolves a permission rule
    against an MCP tool name."""
    if policy is None or not policy.enforced or not policy.allowed:
        return None
    servers: set[str] = set()
    for rule in (*policy.allowed, *agent_tools):
        if rule.startswith("mcp__kb__"):
            servers.add("kb")
        elif rule.startswith("mcp__ops__"):
            servers.add("ops")
    return servers


def _builtin_tool_surface(policy, agent_tools: tuple[str, ...] = (),
                          agent_builtins: tuple[str, ...] | None = None) -> tuple[str, ...] | None:
    """The `--tools` built-ins a run's policy allows (issue_01M4BT13RP23KRTA80VM6R7HNF):
    restricting the session's tool SURFACE, not just which calls are permitted
    within it, is what keeps Claude Code from loading every built-in's schema
    into the opening context — the Library's own measurement found a reviewer's
    init event carrying ~24 built-ins its policy never grants.

    `agent_builtins` (issue_01M4C04GYC3R9NPZCK9RTYPASZ, CQ·426), WHEN PRESENT, IS
    RETURNED DIRECTLY, bypassing the enforced/unenforced branch below entirely —
    checked first so an enforced policy's own allow-list-derived surface can never
    override it. A coder needs arbitrary shell, so `tool_policy.ENFORCEABLE_AGENTS`
    never includes it and `policy.enforced` is always `False`; an allow-list is the
    wrong control for a coder anyway (one permissive enough to let it work would be
    equivalent to full Bash, `tool_policy.py`'s own "THE HONEST PART"). But WHICH
    BUILT-INS LOAD is a separate axis from WHAT'S PERMITTED, and `builtins:` sets
    only that axis — so it has to reach `--tools` regardless of `policy.enforced`,
    which is exactly why this check comes before the policy is even read.

    Absent `agent_builtins` (`None` — the field's absence, not an explicit empty
    list), derived from the UNION of `policy.allowed` and the agent's own roster
    `tools:` grants (`agent_tools` — same reasoning and same round-1 citation as
    `_mcp_servers_for_policy`'s docstring): a rule's built-in is the text before
    its first `(` — `"Bash(git diff:*)"` means the `Bash` tool, a bare `"Read"`
    means `Read`. `mcp__`-prefixed rules are skipped; they name an MCP tool, not
    a built-in, and are not part of `--tools`' vocabulary — `_mcp_servers_for_policy`
    is what acts on those.

    Returns `None` — "pass no --tools flag, today's full built-in surface" —
    under the exact conditions `_mcp_servers_for_policy` keeps both MCP servers
    for: no policy, a build-class agent (`enforced=False`), or an enforced
    policy with an empty `allowed`. Only a real allow-list narrows the surface,
    and only then does `agent_tools` get consulted.

    An enforced policy whose `allowed` names no built-in at all (every rule
    MCP-prefixed) returns an empty tuple, not `None` — the caller must still
    pass `--tools` (`""`, or `"ToolSearch"` alone when an MCP server is
    attached — see the spawn site's own comment) rather than silently keeping
    the full surface, since the policy DID answer and the answer was "no
    built-ins"."""
    if agent_builtins is not None:
        return agent_builtins
    if policy is None or not policy.enforced or not policy.allowed:
        return None
    names = {rule.split("(", 1)[0] for rule in (*policy.allowed, *agent_tools)
              if not rule.startswith("mcp__")}
    return tuple(sorted(names))


def _disallowed_tools(agent_name: str, repo: str | None = None,
                      agent: dict | None = None, *, model: str | None = None,
                      eval_mode: bool = False) -> list[str]:
    """The --disallowedTools deny list for a spawned agent (ARCH-064 + ARCH-246).
    Pure so it's unit-testable; the spawn site applies it. These hard-deny even
    under bypassPermissions (bypass auto-approves only what isn't explicitly
    denied). Review-class agents keep the PR-review surface; every other agent is
    structurally blocked from posting a (forgeable) review stamp or self-merging —
    the structural complement to the ARCH-193 run-id authenticity gate.

    `eval_mode` (the review-replay eval harness) denies that same surface back to
    a REVIEW-CLASS agent, `agentctl review-post` and `gh api` included: a replay
    must never post to GitHub or record a review stamp (old PRs would get
    comments, and a stamp on a live PR would move its merge gate), so
    `--eval-mode` withdraws every exemption review-class agents otherwise get —
    see `_EVAL_MODE_PR_DENY`. Defense in depth: the allow-list `tool_policy.resolve`
    builds for an eval dispatch already grants neither, under the `dontAsk` mode
    eval mode forces unconditionally (`_spawn_claude`).

    The categorical denials (exfiltration built-ins and connector servers) come
    from the Library's record in `_library_denials`, and apply to every dispatch
    regardless of `repo` or `agent`. `agent` is accepted for the existing callers
    and is not read here. When the Library does not answer, this raises SystemExit
    and nothing is dispatched (`_library_denials`)."""
    deny: list[str] = []
    if not _is_review_agent(agent_name):
        deny += list(_PR_REVIEW_DENY)
    elif eval_mode:
        deny += list(_EVAL_MODE_PR_DENY)
    # Every agent, no exception: Slack is retired as an output channel and nobody has
    # read it since 2026-07-21, so a write there reaches no one while looking delivered
    # in every log. Reads are absent from this list; they are denied through the
    # Library's connector class (`mcp__claude_ai_Slack__*`) unless the record allows
    # Slack, per platform/decisions/0048.
    deny += list(_SLACK_WRITE_DENY)
    # Every dispatched agent, no exception: a worker reports through its artifact and
    # exits, never by messaging another session (ADR-0046). See _MESSAGING_DENY.
    deny += list(_MESSAGING_DENY)
    # Every dispatched agent, no exception: a dispatched run's session ends when its
    # turn ends, so no scheduled wakeup can ever fire into it. See _SCHEDULE_DENY.
    deny += list(_SCHEDULE_DENY)
    # Unconditional, for the reasons at `_FILING_DENY`'s definition: every caller
    # of this function is a dispatched run, and a dispatched run has no co.
    deny += list(_FILING_DENY)
    # Unconditional, for the reasons at `_TOPICS_WRITE_DENY`'s definition: a
    # dispatched run's own `topics` govern which instruction blocks constrain
    # it, so rewriting them is not a capability any dispatched run needs.
    deny += list(_TOPICS_WRITE_DENY)
    # Every dispatched agent, no exception (operator, 2026-08-24: "cease use of the Agent
    # tool altogether and only use agentctl"). A run dispatches helpers with
    # `agentctl spawn` and reads them with `agentctl result`. The tool is named
    # `Agent` in Claude Code 2.1.282: recorded transcripts carry `"name":"Agent"`
    # tool_use blocks and none carry `"name":"Task"`.
    deny.append("Agent")

    # THE LIBRARY'S DENY-LIST, MERGED IN. The categorical classes (exfiltration
    # built-ins and connector servers) are part of this, for every dispatch. Orient's policy page writes entries
    # keyed per agent/crew/model; until this call nothing on the dispatch path
    # read them, so a denial the operator set restricted nothing while the page looked
    # exactly as it looks when it works.
    #
    # MERGED INTO THE DENY LIST SPECIFICALLY, not the allow-list, and that is the
    # difference between binding and not. `tool_policy._ENFORCEMENT_GATE_CAVEAT`
    # records that with AGENTCTL_ENFORCE_TOOL_POLICY unset — the default — a run
    # executes under bypassPermissions with none of the allow-list applied and
    # "only the deny-list binds". Wiring the operator's entries through the gated
    # allow-list would leave them inert while the stored row stayed correct,
    # passing any check that re-reads the row.
    deny += _library_denials(agent_name, repo, model)
    return deny


# Whether the Library actually answered for this process, recorded into
# policy.json. ADR-0048 requires the policy to fail closed and a reader of a
# run's policy.json could not otherwise tell "no denials existed" from "the
# Library could not be asked" — the same two-states-one-value confusion this
# whole change exists to remove (reviewer, PR #487).
_POLICY_CONSULTED: dict = {"ok": None}


# ONE ANSWER PER DISPATCH. `_disallowed_tools` runs at least TWICE per real run —
# once to build the policy object `_write_policy` records, and again inside
# `_spawn_claude` to build the actual `--disallowedTools` flag — plus once more on
# every ARCH-131 fail-over or retry. Unmemoised, each paid its own 6s network
# timeout AND the calls could DISAGREE: the first succeeding (recorded in
# policy.json as `library_policy.ok: true`) while the second times out and
# contributes nothing, so the audit says "checked" for a run whose spawned
# process never carried the operator's denial. That is this change's own
# two-states-one-value gap, one layer down (reviewer, PR #487).
#
# Process-scoped and keyed per combination: a dispatch resolves one answer and
# every consumer within it sees that answer.
_LIBRARY_DENIALS_MEMO: dict = {}


def _library_denials(agent_name: str, repo: str | None, model: str | None, *,
                     failover: bool = False) -> list[str]:
    """The Library's denials for this dispatch, as `--disallowedTools` values.

    TWO SETS, BOTH FROM THE RECORD. The explicit denials an operator wrote through
    Orient's policy page, and the categorical classes (`exfiltration_builtins` and
    `connector_servers`), which every dispatched worker is denied unless the record
    explicitly allows that target (`policy_client.categorical_denials`). The
    categorical classes apply to every dispatch, whatever the crew: the Library
    does not model private/public scope for them (operator, 2026-09-29), and the agents
    whose purpose is the tool get an explicit allow instead (platform/decisions/0048).

    A `--model` override changes the (agent, crew, model) triple, so an overridden
    `scout` or `consultant` gets no WebFetch grant and is denied it. On a public
    crew that is new; it fails closed.

    REFUSED WHEN THE LIBRARY DOES NOT ANSWER. Any outcome other than a valid policy record
    refuses the dispatch: a timeout, a refused connection, an HTTP error status (a 400 for a
    dispatch with no crew included), a malformed body, or no control-plane token. The operator
    ruled on 2026-10-06 that agents halt during a Keel outage, and platform/decisions/0048's
    "Unreachable Library: a dispatch is refused" section carries that rule
    (https://github.com/convivy/knowledge/pull/796). This raises SystemExit, which names what
    was observed, and no fallback denial list is served in its place. A first dispatch's
    refusal is raised before any run directory or agent process exists. A fail-over's
    (`failover=True`) comes after the first agent has run and exited, and the fail-over
    agent is not started.
    """
    # CREW, NOT REPO, and they are different identifiers. The Library keys policy
    # by crew; `repo` is what `--on` resolves to. `agent-platform`'s crew is `bosun`,
    # `convivy-app-kit`'s is `svc`, `convivy-deck`'s is `deck` — so passing the
    # repo meant a denial an operator set for a crew never matched, restricting
    # nothing with nothing to distinguish it from working. That is this PR's own
    # failure mode one layer down, found by both reviewers.
    #
    # `projects.crew_for_repo`, NOT `crew_for` — the latter takes a PROJECT slug
    # and returns None for a repo name, which both reviewers proposed and which
    # would have turned a wrong-key lookup into a no-key one.
    crew = projects.crew_for_repo(repo, KNOWLEDGE_ROOT)
    memo_key = (agent_name, crew, model)
    if memo_key in _LIBRARY_DENIALS_MEMO:
        return list(_LIBRARY_DENIALS_MEMO[memo_key])
    try:
        record = policy_client.resolve(agent_name, crew, model)
    except policy_client.PolicyUnavailable as exc:
        outcome = ("The first agent ran and exited, and the fail-over agent was not started."
                   if failover else
                   "Nothing was dispatched and no agent was started. Retry the dispatch once "
                   "the Library answers.")
        raise SystemExit(
            f"dispatch refused: the Library's tool policy for {agent_name!r} (crew {crew!r}, "
            f"model {model!r}) did not arrive from GET /policy/resolve — {exc}. {outcome}")
    _POLICY_CONSULTED["ok"] = True
    _POLICY_CONSULTED["crew"] = crew
    _POLICY_CONSULTED["version"] = record.get("version")

    # A name that cannot safely be argv is REPORTED, never silently dropped — a
    # denial that vanished quietly is the failure this change exists to close.
    explicit = record.get("explicit") or {}
    if isinstance(explicit, dict):
        for tool, verdict in explicit.items():
            if (str(verdict).strip().lower() in ("deny", "denied", "false", "block")
                    and not policy_client.is_safe_tool_name(str(tool))):
                print(f"policy: REFUSING to apply the denial for {tool!r} — it is "
                      f"not a usable tool identifier and would be re-parsed as a "
                      f"flag by `claude -p`. Fix the entry in Orient's policy "
                      f"page.", file=sys.stderr)
    categorical = policy_client.categorical_denials(record)
    for tool in categorical:
        if not policy_client.is_safe_tool_name(tool):
            print(f"policy: REFUSING to apply the categorical denial for {tool!r} — "
                  f"it is not a usable tool identifier. Fix the Library's record.",
                  file=sys.stderr)
    out = sorted(dict.fromkeys(
        d for d in policy_client.explicit_denials(record) + categorical
        if policy_client.is_safe_tool_name(d)))
    _LIBRARY_DENIALS_MEMO[memo_key] = out
    return out


def _enforce_tool_policy() -> bool:
    """Is autonomous allow-list enforcement switched ON? (ARCH-346)

    Default OFF, deliberately. The roster's declared `tools:` lists have never been
    enforced on this path, so they drifted into fiction: mined across 9,069 real runs,
    `reviewer` alone made 19,066 tool calls it does not declare. Enforcing on day one
    would break the fleet mid-overnight. So the policy is RECORDED from day one and
    ENFORCED only once a day of recorded runs shows the allow-list covers real usage.

    Config, not code (the ARCH-342 lesson): flipping a canary must not need a deploy.
    """
    return os.environ.get("AGENTCTL_ENFORCE_TOOL_POLICY", "").strip() not in ("", "0")


def _resolve_run_policy(agent_name: str, repo: str | None, agent: dict | None,
                        model: str | None, *, eval_mode: bool = False):
    """The tool policy for a run that executes `model`, or None if tool_policy did not
    import. The Library grants per (agent, crew, model) triple, so a fail-over respawn
    needs the policy of the model it runs, not the model the roster asked for."""
    if TP is None:
        return None
    return TP.resolve(agent_name, TP.AUTONOMOUS, repo, eval_mode=eval_mode,
                      denied=_disallowed_tools(agent_name, repo, agent, model=model,
                                               eval_mode=eval_mode))


def _review_launcher_for(agent_name: str, pr) -> "Path | None":
    """The review-launch path for a review-class run pinned to a PR, or None. Shared by
    the policy record and the spawn route, so both answer the same question."""
    return (_review_launch_path()
            if (_is_review_agent(agent_name) and pr is not None) else None)


def _write_policy(run_dir: Path, policy, *, denials_applied: bool = True) -> None:
    """Record the run's effective tool policy. Best-effort: a telemetry write must
    never take down a run.

    `except Exception`, not `except OSError`. The catch has to be as wide as the stated
    invariant, and the invariant is "an audit write never fails a run". `OSError` covers
    the disk; it does not cover `json.dumps` raising `TypeError` on a field some future
    `Policy` gains. Narrow it and the next non-serializable field kills every spawn at
    01:00, with the noqa comment sitting there implying it was already handled.

    `denials_applied` is False when this path passes no `--disallowedTools` (a
    review-class run routed through review-launch), so the denials listed here were
    resolved but not applied by agentctl.
    """
    if policy is None:
        return
    try:
        rec = policy.as_dict()
        rec["enforcement_active"] = bool(policy.enforced and _enforce_tool_policy())
        rec["disallowed_tools_applied"] = denials_applied
        if not denials_applied:
            rec["disallowed_tools_note"] = (
                "review-class run routed through review-launch: agentctl passed no "
                "--disallowedTools on this path, so the denials listed above were not "
                "applied by agentctl.")
        # WAS THE LIBRARY ACTUALLY ASKED? Without this a reader of policy.json
        # cannot tell "no operator denials existed" from "the Library could not
        # be reached" — the same two-states-one-value confusion this change
        # exists to remove, and ADR-0048 requires the policy to fail closed
        # rather than degrade silently (reviewer, PR #487).
        rec["library_policy"] = dict(_POLICY_CONSULTED)
        T.write_owner_only(run_dir / "policy.json", json.dumps(rec, indent=2) + "\n")
    except Exception as exc:  # noqa: BLE001 — never fail a run over an audit write
        print(f"warning: could not write policy.json ({exc})", file=sys.stderr)


def derive_purpose(agent_name: str, task: str | None, pr: str | None = None) -> str | None:
    # Strip any internal-app prefix (hollis-, svc-, sel-, …) once up front so every
    # role check below covers both the plain name and its prefixed variant (ARCH-177).
    base = _strip_app_prefix(agent_name)
    if base in ("bug-fixer", "bug-investigator") and task:
        # The task slug alone truncates to 32 chars, so two tasks with the same
        # leading text — every in-box drain dispatches "Fix mode for in-box issue
        # issue_<id>" or "Investigate bug report issue_<id>" — collide on the same
        # purpose, reusing a stale worktree from a prior issue. Adding an 8-char
        # SHA-256 digest of the full task text distinguishes tasks that share the
        # same slug while keeping the name stable per task (same text → same tree,
        # so a resumed dispatch reuses its worktree).
        return f"{_slug(task, prefix='bug')}-{_task_hash(task)}"
    if base in _DEDICATED_WORKTREE_WORKERS and task:
        # A REVIEW worktree is scoped to its PR. `purpose` is slugged from the task
        # text and truncated to 32 chars, so two reviews of DIFFERENT PRs whose
        # tasks share a lead — "Review the changes on this PR for correctness…" —
        # slug identically and resolve to ONE worktree. Concurrently that is a
        # WorktreeBusy refusal of the second dispatch; serially it is one tree
        # force-reset between two unrelated reviews. Observed live: both of this
        # session's reviewer dispatches only stayed apart because their task strings
        # happened to lead with the PR number, which is a habit, not a guarantee.
        #
        # The PR goes in the PREFIX, not appended, because truncation is the whole
        # bug — `_slug` cuts the tail, so a suffix marker is exactly what a long
        # task would eat.
        #
        # REVIEW AGENTS ONLY, deliberately. Their trees are detached, commit-pinned
        # (ARCH-184) and reaped after the run (ARCH-344), so the branch name derived
        # from the purpose means nothing to them. A coder's does: its branch IS
        # `agent/<purpose>`, and ARCH-347 resolves a round-fix's tree by the branch
        # the PR points at. Re-scoping that would fork a round-fix onto an orphan
        # branch and push it while the PR head never moves — the vivy #923 footgun.
        #
        # KEEP ONLY THE DIGITS. `_slug` sanitizes the TASK but concatenates the
        # PREFIX raw, and `purpose` is interpolated straight into a filesystem path
        # (`desired_path` → `<extras>/<repo>.<purpose>`) and into a branch name
        # (`agent/<purpose>`). Unsanitized, this argument is a path-traversal
        # primitive: `--pr ../../../../tmp/evil` yielded the purpose
        # `reviewer-pr../../../../tmp/evil-review-it`. A PR number is an integer, so
        # digits are the whole legitimate alphabet. A value carrying no digits
        # cannot scope anything and falls back to the plain purpose rather than
        # inventing a marker.
        #
        # re.ASCII, and a length bound, both from the #213 security review.
        # Python's `\d` is Unicode-aware by default, so Arabic-Indic `٩١٢` and
        # fullwidth `１２３` survive the strip and would land in a path and a git
        # ref; a GitHub PR number is always an ASCII integer. And `purpose` becomes
        # `<extras>/<repo>.<purpose>`, where NAME_MAX is 255 on every common
        # filesystem, so an unbounded digit run turns a spawn into ENAMETOOLONG.
        # Real PR numbers are five digits at most; eight is generous headroom.
        if _is_review_agent(agent_name):
            if pr:
                digits = re.sub(r"\D", "", str(pr), flags=re.ASCII)[:8]
                if digits:
                    return _slug(task, prefix=f"{agent_name}-pr{digits}")
            return _slug(task, prefix=agent_name)
        # Write-class (coder, refactorer, test-writer, explainer,
        # planning-orchestrator, architect): this purpose IS the branch
        # (`agent/<purpose>`), reused verbatim on a resumed dispatch of the same
        # task — so two DIFFERENT tasks sharing a 32-char slug lead (every
        # Course-item dispatch: "Implement Course item issue_01M1CY6X…" and
        # "…issue_01M1CY8G…" truncate identically) collided on ONE worktree, and
        # the second run committed onto the first's already-open PR
        # (issue_01M3P0VPT1T33K4Y5HRFKH90JE; vivy PR 1342/1344, this session's
        # own #705). bug-fixer/bug-investigator already carry this discriminator
        # (above); review agents don't need it (commit-pinned, reaped — see the
        # long comment above). Same task text → same hash → the same branch, so
        # a resumed dispatch still reuses its tree.
        return f"{_slug(task, prefix=agent_name)}-{_task_hash(task)}"
    # None: no dedicated purpose. `_spawn_dispatch` gives these agents a detached
    # worktree at the repo's main (`_detached_main_purpose`), except a repo-local
    # or private dispatch, which stays in the primary.
    return None


def _is_worktree_class(agent_name: str) -> bool:
    """True for workers and orchestrators that MUST get their own dedicated worktree
    and must never run in the primary checkout: the dedicated-worktree roster
    (including planning-orchestrator) plus the bug pair. Used to reject a blank
    --task that would otherwise fall through derive_purpose to purpose=None → the
    primary (P0, 2026-07-04).

    Not included, with the reason each is excluded:
    - `planner` and other non-write agents: they are not required to have a
      dedicated purpose, so a blank task is not refused for them. `_spawn_dispatch`
      still gives them a detached worktree, except for a repo-local or private
      dispatch, which stays in the primary."""
    base = _strip_app_prefix(agent_name)
    return base in _DEDICATED_WORKTREE_WORKERS or base in ("bug-fixer", "bug-investigator")


def _detached_main_purpose(agent_name: str, task: str | None) -> str:
    """The worktree purpose for an agent `derive_purpose` leaves without one
    (scout, planner, curator and any agent outside the dedicated-worktree list).

    The task hash is what keeps two such dispatches apart. Scouts are dispatched
    in parallel with tasks that share a lead ("Find where ..."), and the 32-char
    slug alone would resolve those to ONE worktree and refuse the second as busy,
    the collision `derive_purpose` documents for reviewers. `agent_name` goes
    through `_slug` because the purpose is interpolated into a filesystem path."""
    text = task or ""
    return f"{_slug(text, prefix=_slug(agent_name))}-{_task_hash(text)}"


def _detached_main_base(repo: str) -> str:
    """The commit a detached-main dispatch is placed on, read from `repo`'s primary.

    A repo with an `origin` remote resolves `refs/remotes/origin/main`. A repo with
    no `origin` (CFO, convivy-commercial, vivy-commercial, the operator's personal crew) has no other
    main than its own, so it resolves `refs/heads/main`. Either way the primary is
    only read.

    `show-ref --verify` takes the FULL ref and does no search, where `rev-parse
    origin/main` walks git's search rules and reads a TAG named `origin/main`
    ahead of the remote-tracking branch (agent-platform#681 and #682). A missing
    ref raises ValueError, which the caller turns into a refused dispatch: an
    agent placed on some other commit would read a tree nobody chose."""
    primary = W.desired_path(repo, None)
    remote = subprocess.run(["git", "-C", str(primary), "remote", "get-url", "origin"],
                            capture_output=True, text=True, check=False)
    has_origin = remote.returncode == 0
    ref = "refs/remotes/origin/main" if has_origin else "refs/heads/main"
    cp = subprocess.run(["git", "-C", str(primary), "show-ref", "--verify", "--hash", ref],
                        capture_output=True, text=True, check=False)
    sha = cp.stdout.strip()
    if cp.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", sha):
        if has_origin:
            raise ValueError(
                f"{ref} does not exist in {primary}, so there is no remote-tracking "
                f"main to place {repo}'s dispatched agent on. Run `git fetch origin` "
                f"in that checkout and retry.")
        raise ValueError(
            f"{primary} has no `origin` remote and no {ref}, so there is no main to "
            f"place {repo}'s dispatched agent on.")
    return sha


def _unregistered_crew_prefix(agent_name: str) -> tuple[str, str] | None:
    """`(prefix, role)` when `agent_name` reads as a crew variant of a worktree- or
    review-class role under a prefix that is NOT in _INTERNAL_APP_PREFIXES, else None.

    An unregistered prefix used to be indistinguishable from a bare role:
    `_strip_app_prefix` returned the name unchanged, no role check matched, and a
    write-class worker was routed into the primary checkout with `--pr` refused —
    silently, twice (2026-07-12 for `svc-`/`sel-`, 2026-09-06 for `platform-`).
    `cmd_spawn` refuses on this, before the index is read.

    Only the harmful reading is refused. A variant of a planner or of any other
    role that needs no worktree and no review surface dispatches the same either
    way, and a hyphenated bare role (`security-reviewer`, `bug-fixer`,
    `test-writer`) is a role, not a prefix plus a role — those are checked by name
    against the role lists first, so this cannot mistake `security-` for a crew.
    """
    if (agent_name in _DEDICATED_WORKTREE_WORKERS or agent_name in _REVIEW_AGENTS
            or agent_name in ("bug-fixer", "bug-investigator")):
        return None
    if _strip_app_prefix(agent_name) != agent_name:
        return None
    seg, _, rest = agent_name.partition("-")
    if rest and (_is_worktree_class(rest) or _is_review_agent(rest)):
        return f"{seg}-", rest
    return None


def _deployed_platform_path_under(home: Path) -> Path | None:
    """Resolve the deployed agent-platform checkout given a home directory.

    `<home>/.local/bin/agentctl` is a symlink into the repo working tree.
    Reading the link gives us the deployed checkout root — the one that runs
    every cron job on the machine. Returns None when the path is not a
    symlink (we are running from a dev checkout or a test fixture, so there
    is nothing to warn about).  Does NOT resolve through an intermediate link
    (is_symlink alone, not resolve), so a test that replaces the binary with
    a temp-file resolves to the temp dir and skips the warning — the right
    call, since the test infrastructure is not the deployed tree.

    Shared by `_deployed_platform_path` (soft warning, follows `Path.home()`)
    and `_canonical_spawn_lib_dirs` (hard gate, uses the passwd-database home
    instead) — see the latter's docstring for why those two need different
    homes.

    Both `is_symlink()` and `resolve()` can raise OSError (EACCES from an
    unreadable intermediate component; the same failure class fixed in
    `_path_has_symlink_component`, agent-platform#470 round 6), which would
    otherwise propagate into both callers — including `_canonical_spawn_lib_dirs`,
    which has no try/except of its own around this call (the crash
    reviewer found this round). Caught here so the fix covers both callers at
    once: `None` is already each caller's existing answer for "nothing to
    check here" (not a symlink / no farm checkout), so an unverifiable
    symlink or link target gets the identical treatment rather than a new
    code path."""
    deployed = home / ".local" / "bin" / "agentctl"
    try:
        if not deployed.is_symlink():
            return None
        # The agentctl binary is at bin/agentctl in the repo. Resolve the
        # link, then go up two levels (bin/ → repo root).
        return deployed.resolve().parent.parent
    except OSError:
        return None


def _deployed_platform_path() -> Path | None:
    """Resolve the deployed agent-platform checkout from the running agentctl,
    following `Path.home()` (i.e. $HOME). Soft-warning use only — see
    `_warn_deployed_tree`. Do NOT use this as the trust anchor for anything
    that refuses to act (`_canonical_spawn_lib_dirs` deliberately does not
    call this, security-reviewer, agent-platform#470 round 2)."""
    return _deployed_platform_path_under(Path.home())


def _warn_deployed_tree() -> None:
    """Warn when the DEPLOYED platform tree is not on main or is behind
    origin/main.  WARN only, never block — a hard failure here could wedge
    every dispatch on the machine, including the fix for this condition.

    This check uses already-fetched refs (no network fetch).  It fails open: a
    check that errors (e.g. the repo is gone, origin/main is absent) must not
    break the spawn."""
    path = _deployed_platform_path()
    if path is None:
        return
    repo_dir = str(path)
    try:
        branch = subprocess.run(
            ["git", "-C", repo_dir, "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, timeout=5).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return  # fail open
    if not branch or branch == "HEAD":
        return  # detached HEAD — nothing meaningful to compare
    if branch != "main":
        print(f"warning: the deployed platform tree ({path}) is on branch "
              f"'{branch}', not 'main'.  Every cron job on the machine runs this "
              f"tree.  Switch to main:  git checkout main && git pull --ff-only",
              file=sys.stderr)
        return  # short-circuit: behind-count on a non-main branch is noise
    # Fast check: already-fetched origin/main ref, no network I/O.
    try:
        out = subprocess.run(
            ["git", "-C", repo_dir, "rev-list", "--count", "HEAD..refs/remotes/origin/main"],
            capture_output=True, text=True, timeout=5)
        if out.returncode != 0:
            return
        behind = int(out.stdout.strip())
    except (ValueError, subprocess.SubprocessError, OSError):
        return
    if behind > 0:
        print(f"warning: the deployed platform tree ({path}) is {behind} commit(s) "
              f"behind origin/main.  It has been updated since this tree was pulled.  "
              f"Run:  git pull --ff-only",
              file=sys.stderr)


# Env var escape hatch for _spawn_lib_gate. Loud on stderr whenever used (never
# silent, never the default) — see that function's docstring.
_ALLOW_WORKTREE_SPAWN_ENV = "AGENTCTL_ALLOW_WORKTREE_SPAWN"

# The shared deploy area's lib dir, relative to <passwd-home> (agent-platform#469,
# `bin/install-agent-platform-shared`, platform/decisions/0059 rule 2). That
# installer is a POSIX-sh script, so there is no importable Python constant to
# share this from — keep this literal in sync with its own `DEPLOY_DIR`.
_DEPLOY_SHARED_LIB_RELPATH = Path(".local") / "deploy" / "agent-platform-shared" / "lib" / "agent-platform"


def _path_has_symlink_component(resolved_anchor: Path, relpath: Path) -> bool:
    """True when any component of `relpath`, walked underneath
    `resolved_anchor`, is itself a symlink. `resolved_anchor` must already be
    resolved and is not itself checked — the caller anchors against the
    resolved passwd home specifically so that a legitimately symlinked home
    (macOS's `/tmp` -> `/private/tmp`, or a test fixture under one) does not
    cause a false rejection of an otherwise-real path underneath it. Only
    what `relpath` adds below that anchor is in scope.

    `Path.is_symlink()` swallows ENOENT/ENOTDIR/EBADF/ELOOP itself but not
    EACCES from an unreadable intermediate component, which would otherwise
    propagate out of this walk and crash `cmd_spawn` with an unhandled
    traceback (reviewer, agent-platform#470 round 6) — the same failure
    shape as the `pwd.getpwuid` KeyError fixed two rounds earlier, and the
    same policy applies: fail open rather than crash. Attempts to reproduce
    an actual raise (an unreadable parent directory with an existing child,
    a nonexistent child, and a nested child, each as a normal user) all
    returned False rather than raising — this platform's `is_symlink()`
    swallows EACCES too, at least for those shapes — and the one call site
    only reaches this walk after `deploy_lib.is_dir()` has already
    succeeded, which needs strictly MORE traversal permission than this
    lstat walk needs, so under normal single-threaded execution the walk
    cannot newly fail where `is_dir()` already succeeded. This is therefore
    reachable only via a TOCTOU race (permissions change between the two
    calls) or a future caller reusing this general-purpose helper without
    that precondition — defensive consistency, not a reproduced crash. If a
    component can't be verified as not-a-symlink, the deploy area hasn't
    been established as trustworthy either, so the conservative answer is
    to treat it the same as a confirmed symlink (return True): the caller
    then skips admitting it and falls through to the existing fail-open
    path, rather than propagating the OSError into `cmd_spawn`."""
    current = resolved_anchor
    try:
        for part in relpath.parts:
            current = current / part
            if current.is_symlink():
                return True
    except OSError:
        return True
    return False


def _canonical_spawn_lib_dirs() -> set[Path] | None:
    """The set of lib dirs `spawn`'s tool-policy resolution may run against.
    Two members, either of which is acceptable:

    1. Wherever `<passwd-home>/.local/bin/agentctl`'s symlink resolves to
       (the primary checkout, via the deploy symlink farm).
    2. The shared deploy area's lib dir once agent-platform#469's installer
       has populated it (`<passwd-home>/.local/deploy/agent-platform-shared/lib/agent-platform`).

    Neither membership widens the trust boundary this gate enforces: both are
    written only by a trusted install-time process from a git ref (the farm
    by `install.sh`, the deploy area by `install-agent-platform-shared` via
    `git archive`), never by hand and never from a worktree — the same trust
    class as the primary checkout, arguably stronger, since the deploy area
    is always installed from `main` (ADR-0059 rule 6) while the primary
    checkout can sit on a branch. A worktree is a member of neither set, so
    the gate still refuses exactly what it refused before this function grew
    a second member.

    Member 2 may legitimately not exist yet — it did not exist anywhere on
    this fleet until agent-platform#469 shipped, and won't on a fresh machine
    before its installer has ever run — so it is included only when
    `.is_dir()`. Returns None only when NEITHER member resolves: there is
    then no canonical reference at all to check `_LIB_DIR` against (CI, or a
    machine `install.sh` hasn't touched).

    Member 2 is admitted only when reaching it from the passwd home involves
    no symlink at any component (`_path_has_symlink_component`). `.is_dir()`
    follows symlinks, so without this check a symlink placed at or below
    `.local/deploy/agent-platform-shared` (e.g. pointing into a worktree)
    would be admitted as canonical, and because the gate later resolves both
    sides before comparing, a spoofed `_LIB_DIR` under that same worktree
    would then equal the resolved canonical entry and pass exactly as
    legitimately as a real deploy (security-reviewer, agent-platform#470
    round 4). The check walks from the RESOLVED passwd home rather than
    comparing the deploy path's resolved and unresolved forms directly,
    because a resolved-vs-unresolved comparison would also trip on a
    legitimately symlinked home directory (macOS's `/tmp` ->
    `/private/tmp`) and silently drop a good deploy area from the canonical
    set. A symlinked deploy area is skipped, not fatal — it behaves exactly
    like an absent one, falling through to the same fail-open this function
    already has when neither member resolves — but it is unusual enough on a
    real machine to warn about, so `_canonical_spawn_lib_dirs` prints to
    stderr when it happens.

    Deliberately resolved from the OS passwd database
    (`pwd.getpwuid(os.getuid()).pw_dir`), NOT from `Path.home()` /
    `_deployed_platform_path()` (which follows `$HOME`). The actor this gate
    exists to stop is exactly the one who can run
    `<worktree>/bin/agentctl spawn ...` in the first place, and that same
    actor can set `$HOME` to a scratch directory containing a forged
    `.local/bin/agentctl` symlink pointing back at their own worktree —
    making that worktree its own canonical reference and defeating the gate
    silently, with no warning at all (security-reviewer, agent-platform#470
    round 2). A process cannot change what the passwd database reports for
    its own real uid, so this is not steerable per-invocation the way `$HOME`
    is.

    `pwd.getpwuid` raises `KeyError` when the running uid has no
    passwd-database entry — an ordinary shape for a container running as an
    arbitrary numeric uid, or a minimal image with no matching `/etc/passwd`
    row. Caught here and treated the same as "no canonical reference": there
    is nothing to anchor the gate to, so fail open rather than crash
    `cmd_spawn` with an unhandled traceback."""
    try:
        passwd_home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, TypeError):
        return None
    canonical: set[Path] = set()
    farm_checkout = _deployed_platform_path_under(passwd_home)
    if farm_checkout is not None:
        canonical.add(farm_checkout / "lib" / "agent-platform")
    deploy_lib = passwd_home / _DEPLOY_SHARED_LIB_RELPATH
    # `.is_dir()` can raise OSError (EACCES from an unreadable intermediate
    # component, same class as `_path_has_symlink_component`); an unverifiable
    # directory gets the same treatment this function already gives a
    # legitimately absent one -- skipped, silently, no warning.
    try:
        deploy_lib_is_dir = deploy_lib.is_dir()
    except OSError:
        deploy_lib_is_dir = False
    if deploy_lib_is_dir:
        # `.resolve()` on the anchor can also raise OSError; if the anchor
        # itself can't be verified, the walk below it can't be trusted either,
        # so this gets the same conservative answer
        # `_path_has_symlink_component` gives an unverifiable component:
        # treat as symlinked (skip admitting, warn) rather than propagate.
        try:
            resolved_passwd_home = passwd_home.resolve()
            has_symlink_component = _path_has_symlink_component(
                resolved_passwd_home, _DEPLOY_SHARED_LIB_RELPATH)
        except OSError:
            has_symlink_component = True
        if has_symlink_component:
            print(f"warning: {deploy_lib} is reached through a symlink — not "
                  f"admitted as a canonical spawn reference. The shared deploy "
                  f"area is trusted specifically because it is a plain "
                  f"directory tree written by `install-agent-platform-shared`, "
                  f"never a symlink; a symlink here could point anywhere, "
                  f"including a worktree. Investigate why a component of this "
                  f"path is a symlink.", file=sys.stderr)
        else:
            canonical.add(deploy_lib)
    return canonical or None


def _spawn_lib_gate() -> int | None:
    """Refuse `spawn` when THIS process's own lib (`_LIB_DIR`, ARCH-229) is not
    the canonical one — i.e. this copy of `bin/agentctl` was invoked by a
    worktree path instead of the bare `agentctl` on PATH. Returns an exit code
    if spawn should be refused, or None to proceed.

    `spawn` resolves the spawned agent's tool policy (`TP.resolve`, ARCH-346)
    by importing THIS process's own `tool_policy` module. Before ARCH-229 that
    was always the deployed farm's copy, so a worktree's `tool_policy.py`
    could never govern a spawn. ARCH-229 makes `_LIB_DIR` resolve relative to
    `__file__` instead — correct for every other module this file imports,
    but it reopens exactly this one path for `spawn`: a worktree's
    tool_policy.py is as editable as any other file in that worktree, so
    running `<worktree>/bin/agentctl spawn ...` lets that branch's policy
    module decide what tools a dispatched agent — including a reviewer or
    security-reviewer — is granted, under INTERACTIVE, the runtime meant to
    enforce unconditionally. A compromised or careless worktree could edit
    its own tool_policy.py to report a permissive grant while claiming
    `enforced=True`, then spawn its own reviewer by worktree path so the
    review it depends on runs under the tampered policy.
    security-reviewer, agent-platform#470.

    This is a guardrail against an ACCIDENTAL worktree spawn, not a defence
    against a hostile one: an actor deliberately evading this gate can set
    `AGENTCTL_ALLOW_WORKTREE_SPAWN` directly, which takes no more sophistication
    than the `<worktree>/bin/agentctl spawn ...` invocation the gate is
    already checking for. The accidental case is the one this gate actually
    caught during this PR's own testing, and stopping it is still worth doing.

    Scoped to `cmd_spawn` only — status/list/logs/wait/review-status read
    state and steer nothing, so they keep working from a worktree path.

    Fails OPEN when there's no canonical reference to compare against
    (`_canonical_spawn_lib_dirs` returns None): CI has no `~/.local` at all,
    and a fresh machine before `install.sh` has nothing deployed yet either.
    Refusing there would brick every spawn on precisely the machines that
    never had the deploy-symlink hazard to begin with.

    That fail-open is loud, not silent, for exactly one of the two ways the
    real symlink can go bad: deleting it (or it never having existed), WITH
    the shared deploy area also absent, makes `_canonical_spawn_lib_dirs`
    return None, which this warns about instead of disabling the gate
    without a trace (security-reviewer, agent-platform#470 round 3). One
    exception: under `CI` (the `CI=true` convention every major CI provider
    sets), there is never a canonical reference — no machine runs
    `install.sh` in a CI runner — so the warning would fire on every single
    job on every repo and teach everyone to ignore it. Suppressed there,
    printed everywhere else.

    REPLACING the farm symlink is not covered and cannot be made loud by any
    check here: repointing `.local/bin/agentctl` at a worktree's own lib dir
    makes that worktree a member of the canonical set, so `this_lib` matches
    it and the gate passes as legitimately as a real deploy would. There is
    no signal left to check — a repointed symlink IS what "canonical" means
    to this function. Only the deleted/missing shape is detectable; a
    repointed one is undetectable by construction, and stays that way as
    long as the reference is a symlink the same principal can rewrite. The
    shared deploy area (`install-agent-platform-shared`, agent-platform#469)
    does not have this weakness — it is a plain directory tree copied via
    `git archive` from a pinned ref, never a symlink a worktree could
    repoint — but it is an ADDITIONAL member of the canonical set, not a
    replacement for the farm symlink, since the farm is still what most
    machines run today."""
    if os.environ.get(_ALLOW_WORKTREE_SPAWN_ENV, "").strip().lower() not in ("", "0", "false"):
        print(f"warning: {_ALLOW_WORKTREE_SPAWN_ENV} is set — spawning with this "
              f"process's own lib ({_LIB_DIR}), not the canonical one. The spawned "
              f"agent's tool policy is resolved against THIS tool_policy.py. Only "
              f"use this when you specifically intend to spawn against a "
              f"worktree's own module tree.", file=sys.stderr)
        return None
    canonical = _canonical_spawn_lib_dirs()
    if canonical is None:
        # No canonical reference on this machine -- fails open, but loudly,
        # unless CI (where this is the expected, universal shape). A bare
        # `os.environ.get("CI")` truthy check reads CI=false/CI=0 as "in CI"
        # even though both mean "not CI" -- exactly the AGENTCTL_ALLOW_WORKTREE_SPAWN=0
        # defect two rounds ago. Only "" (unset), "0", and "false" mean "not CI".
        if os.environ.get("CI", "").strip().lower() in ("", "0", "false"):
            print("warning: no canonical lib to check this spawn against (no "
                  "`.local/bin/agentctl` symlink and no shared deploy area under "
                  "this user's real home) — proceeding without the ARCH-229 "
                  "worktree-spawn gate. Expected on a fresh machine before "
                  "`install.sh`; if this is a deployed machine that should have "
                  "one of those, something is wrong with the deploy.",
                  file=sys.stderr)
        return None
    # `.resolve()` can raise OSError on either side of this comparison (same
    # EACCES class as above). Refusing spawn on a comparison we could not
    # actually perform would fail CLOSED on a filesystem error -- worse than
    # this gate's existing no-canonical-reference case, since a member of
    # `canonical` positively exists here. Same fail-open policy, loudly.
    try:
        canonical_resolved = {c.resolve() for c in canonical}
        this_lib = _LIB_DIR.resolve()
    except OSError as exc:
        print(f"warning: could not resolve a path while checking this spawn's "
              f"lib against the canonical set ({exc}) — proceeding without the "
              f"ARCH-229 worktree-spawn gate rather than refusing spawn on an "
              f"unverifiable comparison.", file=sys.stderr)
        return None
    if this_lib not in canonical_resolved:
        accepted = ", ".join(str(c) for c in sorted(canonical_resolved))
        print(f"error: refusing to spawn — this agentctl resolves its own lib to "
              f"{this_lib} (ARCH-229, __file__-relative), which matches none of "
              f"the canonical ones: {accepted}. spawn resolves the spawned "
              f"agent's tool policy (ARCH-346) against THIS lib's tool_policy.py, "
              f"so spawning from a worktree path lets that worktree govern "
              f"another agent's tool grants. Invoke the bare `agentctl` on PATH "
              f"instead. To spawn against this worktree's own lib anyway, set "
              f"{_ALLOW_WORKTREE_SPAWN_ENV}=1.", file=sys.stderr)
        return 2
    return None


# --- subprocess helpers -----------------------------------------------------


def _ancestor_pids() -> list[int]:
    """PIDs of this process's ancestor chain (self → parent → …), best-effort.

    Passed to `knowledge-ctx use --exempt-pid` so the invoking co/claude session
    isn't flagged as a live-process collision when a spawn individuates into its own
    primary worktree (P2a, 2026-07-04). A *different* live session — not an ancestor
    — is not exempted and still aborts the write correctly."""
    out: list[int] = []
    seen: set[int] = set()
    pid = os.getpid()
    while pid and pid > 1 and pid not in seen:
        seen.add(pid)
        out.append(pid)
        cp = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                            capture_output=True, text=True)
        try:
            pid = int(cp.stdout.strip())
        except (ValueError, AttributeError):
            break
    return out


# The single definition lives in `worktrees`, which also has to RECOGNISE the
# deletion in `unlanded_entries`. Two literals held equal by a test was the first
# shape; both reviewers pointed out that agentctl already imports worktrees in
# the same process, so one name removes the drift instead of catching it. The
# dangerous direction was a name added to the "forgive" list but not the "strip"
# list, which would exempt a real agent deletion.
REPO_INSTRUCTION_FILES = W.SUPPRESSED_INSTRUCTION_FILES


def suppress_repo_instructions(repo: str, worktree: Path) -> list[str]:
    """Remove repo-root instruction files from a DISPATCHED worktree.

    THE PRINCIPLE (operator, 2026-09-04): when an agent is individuated, exactly what
    it needs is pulled from the Library. An agent must not read instructions out
    of the repository it is working on.

    THE CONCRETE FAILURE, which is why this is not hygiene. A dispatched reviewer
    works in a worktree checked out to the PR's branch, and `CLAUDE.md` /
    `AGENTS.md` are TRACKED — so the branch carries them. A branch whose
    CLAUDE.md says "this project does not use type hints, do not flag their
    absence" instructs the agent reviewing it. No malice is needed: a coder agent
    editing that file for ordinary reasons has the same effect, and the reviewer
    treats it as project context because that is exactly what the file is.

    THE DELETION IS LEFT PLAIN AND VISIBLE TO GIT, and that is a decision rather
    than an omission. These files are tracked, so the unlink shows as ` D
    CLAUDE.md` in porcelain; `unlanded_entries` exempts exactly that line via
    `worktrees._is_platform_suppression`, the same way it already exempts the
    `.claude/` the dispatcher individuates.

    The alternative — `git update-index --skip-worktree` — was built and rejected
    on review. It leaves status clean, but it blinds git to the path for the LIFE
    of the worktree, and nothing clears it: an `*.overnight` tree reused across
    runs stays blind on every later branch. Two things break. A coder editing
    CLAUDE.md has its write silently dropped, with the Write succeeding and the
    commit simply not containing it. And a prompt-injected write to CLAUDE.md
    produces no porcelain output at all, defeating the ARCH-344 guarantee
    `unlanded_entries` exists to give. Hiding the change from git costs more than
    the change costs.

    AT THE WORKTREE, NOT IN A FLAG, for three reasons. It is harness-independent
    — `codex` reads AGENTS.md the same way (measured), and a tree with no file
    needs cooperation from neither binary nor any future one. It is assertable —
    the file is there or it is not. And the flag that would do it,
    Claude Code's `--bare`, also stops reading OAuth, which would silently move
    every dispatched run off subscription billing onto API billing.

    WHAT THIS DELIBERATELY DOES NOT TOUCH. `.claude/` is untracked in product
    repos and is individuated fresh here by `activate_profile`, so it never
    arrives from the branch. The exception is a `LOCAL_AGENT_REPOS` repo (CFO),
    where `.claude/agents/<name>.md` IS tracked and IS the individuation source
    `resolve_agent` reads by name — removing it would break the dispatch it
    exists to serve. The line is what the principle names: pulled by name at
    individuation, versus picked up ambiently from the working directory.

    WHAT THIS DOES NOT CLAIM. The content is still in git history — an agent that
    runs `git show HEAD:CLAUDE.md` can read it, and deletion cannot change that
    (security review, PR #486). That is a different property from the one this
    closes. An agent reading a file as DATA is what agents do all day, and no
    mechanism here can stop it, the same way none stops it reading a comment in
    src/foo.py and following it. What made this a trust-boundary inversion is
    that the HARNESS auto-loads CLAUDE.md into the system prompt with nobody
    choosing it — that is what goes away. Removing the content from history
    entirely is the Library migration, issue_01M092R482KSQHKKVG4XJ8X257.

    ROOT ONLY, AND THAT IS MEASURED RATHER THAN ASSUMED. A security review asked
    whether a nested `src/CLAUDE.md` is discovered while an agent reads files in
    that subtree — which every reviewer and coder does — and could not test it.
    Probed with a positive control: a root CLAUDE.md carrying a passphrase came
    back after the agent read `src/calc.py`; the same passphrase in
    `src/CLAUDE.md`, same prompt, same read, came back NONE. So a nested file was
    not loaded, and the control proves the probe can detect one that is. That is
    ONE probe over one discovery path, not a proof; if a harness later walks
    subtrees, this set becomes a walk rather than two root paths.

    Interactive `co` sessions never call this. A person chose the directory and
    can read the file; the distinction is whether a human is present to judge the
    instructions, not whether the instructions are good.

    Returns the names removed, so the caller can record what it did.
    """
    # THE PRIMARY-CHECKOUT GUARD LIVES HERE, NOT AT THE CALL SITE, and that is
    # deliberate. It was inline in cmd_spawn first, and a mutation showed the
    # whole test suite still passed with it deleted — nothing proved the caller
    # asked. A guard the caller can forget is one a future caller will.
    #
    # `allocate_worktree(repo, purpose=None)` resolves to the human's own clone,
    # and a repo-local (CFO) or private dispatch still gets that, so an
    # unguarded call would delete CLAUDE.md off the real repo (reviewer, PR #486,
    # when planner and curator took that path).
    #
    # Skipping is right on the merits, not merely safe: the exposure this closes
    # is a BRANCH UNDER REVIEW instructing the agent reviewing it, and the
    # primary sits on main holding content that already went through review.
    if W.is_primary_checkout(repo, worktree):
        return []
    removed = []
    for name in REPO_INSTRUCTION_FILES:
        f = worktree / name
        try:
            # `is_file()` follows symlinks, so a CLAUDE.md that is a symlink to a
            # directory, or a broken one, would be skipped. Remove the LINK
            # rather than reasoning about what it points at.
            if not (f.is_file() or f.is_symlink()):
                continue
            f.unlink()
            removed.append(name)
        except OSError as exc:
            # Refuse rather than dispatch an agent that would read it. A file we
            # cannot remove is one the agent CAN read.
            raise SystemExit(
                f"could not remove {name} from the dispatch worktree {worktree}: "
                f"{exc}. Refusing to dispatch, because the agent would read it."
            ) from exc
    _record_suppression(worktree, removed)
    return removed


# The record lives in the worktree's own git dir rather than in the run dir,
# and that is a deliberate choice about REACHABILITY. `cmd_publish` resolves its
# worktree three ways — a bare path, `--run <id>`, or `--repo R --purpose P`
# (bin/agentctl's "need a worktree" error names all three) — and only one of
# them knows a run id. All three end up holding a worktree path, so a record
# keyed to the worktree is readable however publish was invoked, where a
# `started_suppressed.json` beside `started_head.txt` would be readable only
# from `--run`.
#
# `git rev-parse --git-dir` in a linked worktree gives that worktree's own
# private directory (`<primary>/.git/worktrees/<name>`), so the record is
# per-worktree and, being outside the working tree, CANNOT ITSELF BE COMMITTED.
# That last property is the point: a record of what the dispatcher deleted must
# not be a thing the next `git commit -a` sweeps up, which is the exact failure
# this whole mechanism exists to stop.
_SUPPRESSION_RECORD = "agentctl-suppressed.json"


def _worktree_git_dir(worktree: Path) -> Path | None:
    """The worktree's private git directory, or None if this is not a worktree."""
    cp = subprocess.run(["git", "-C", str(worktree), "rev-parse", "--git-dir"],
                        capture_output=True, text=True)
    if cp.returncode != 0:
        return None
    d = Path(cp.stdout.strip())
    return d if d.is_absolute() else (worktree / d).resolve()


def _record_suppression(worktree: Path, removed: list[str]) -> None:
    """Write down WHAT the dispatcher removed AND the commit it removed it from.

    WHAT THE RECORD ACTUALLY SEPARATES, stated carefully because an earlier
    version of this docstring claimed more. It separates "suppression ran on
    this worktree" from "it did not" — nothing more. It does NOT separate the
    dispatcher's deletion from an agent's, and cannot: the file is already gone
    from the tree before the agent starts, so an agent assigned to delete
    `CLAUDE.md` commits exactly the deletion the record names and has it
    restored. That direction is fail-safe and is the accepted default; no escape
    hatch exists for it, because nobody has named an occurrence.

    The distinction it DOES buy, which is why recording beats re-deriving the
    set from `REPO_INSTRUCTION_FILES` (the operator's call, 2026-09-18): when a branch
    deleted an instruction file in an EARLIER round, a later dispatch suppresses
    nothing — the file is already gone — so the record is empty and publish
    restores nothing. Re-deriving would see the file deleted against base,
    restore it, and silently resurrect work the branch legitimately did.

    THE HEAD SHA IS THE SOURCE OF TRUTH FOR CONTENT, and recording it is not
    bookkeeping. Restoring from the merge base writes whatever base held, which
    throws away any edit the branch itself made to the file before this dispatch
    — under a commit that says it is restoring. It also writes main's NEWER text
    when origin has advanced, so the PR shows an instruction-file modification
    it never made, which is the exact unexplained change this mechanism exists
    to remove. What the dispatcher deleted is what HEAD held at spawn, so that
    is what gets put back.

    Best-effort by design. A dispatch must not fail because a record could not
    be written — the suppression itself has already succeeded by this point, and
    the agent is safe either way. The cost of a missing record is that publish
    restores nothing, which is exactly the pre-2026-09-19 behaviour.
    """
    gd = _worktree_git_dir(worktree)
    if gd is None:
        return
    cp = subprocess.run(["git", "-C", str(worktree), "rev-parse", "HEAD"],
                        capture_output=True, text=True)
    head = cp.stdout.strip() if cp.returncode == 0 else ""
    try:
        (gd / _SUPPRESSION_RECORD).write_text(
            json.dumps({"paths": sorted(removed), "head": head}))
    except OSError:
        pass


def read_suppression_record(worktree: Path) -> tuple[list[str], str]:
    """`(paths, head_sha)` that `suppress_repo_instructions` removed and removed from.

    `([], "")` when there is no record, it is unreadable, it is not an object, or
    it names no path this dispatcher could have suppressed. Every one of those
    means "restore nothing", which leaves the pre-2026-09-19 behaviour rather
    than guessing at what should come back.
    """
    gd = _worktree_git_dir(worktree)
    if gd is None:
        return [], ""
    try:
        data = json.loads((gd / _SUPPRESSION_RECORD).read_text())
    except (OSError, ValueError):
        return [], ""
    if not isinstance(data, dict):
        return [], ""
    head = data.get("head")
    head = head if isinstance(head, str) else ""
    data = data.get("paths")
    if not isinstance(data, list):
        return [], ""
    # Only names this dispatcher could have suppressed. A record naming anything
    # else was not written by `_record_suppression`, and restoring an arbitrary
    # path out of a file in `.git` on its say-so is a hole rather than a feature.
    return [p for p in data if p in REPO_INSTRUCTION_FILES], head


def activate_profile(worktree: Path, qualified_profile: str, *, dry_run: bool = False,
                     agent: str | None = None,
                     issue: str | None = None, allow_default: bool = True,
                     loaded: dict | None = None) -> tuple[str, str] | None:
    """Run `knowledge-ctx use <name> --force` in the worktree. `qualified_profile`
    is 'product/name' form for storage; the CLI receives just 'name' since
    knowledge-ctx infers the product from cwd.

    Returns `(blocked_path, reason)` when knowledge-ctx reported that a
    `.claude/CLAUDE.md` it did not write blocked delivery of the composed
    session instructions, `None` otherwise — the caller (`cmd_spawn`) records
    a non-None result on the run so `agentctl status` shows it.

    ARCH-050: spawn force-individuates. The worktree spawn allocates is a
    machine-owned individuation target, not a hand-edited tree, and the
    dedicated (e.g. `*.overnight`) worktrees are reused across runs without
    clearing `.claude/`. So whenever a profile's agent/skill *source* changes
    between two spawns into the same worktree, knowledge-ctx's non-destructive
    default (ARCH-023) sees the stale prior copy as a conflict and aborts the
    spawn. ARCH-023's non-destructive default is correct for *interactive*
    `knowledge-ctx use` in a human's working clone; it's wrong for spawn, which
    owns its tree and re-individuates every run. We pass `--force` (clear+rewrite)
    but NOT `--force-anyway`, so the live-Claude-process pre-flight still aborts
    if a session is genuinely using the worktree (belt-and-suspenders atop the
    in_use_map WorktreeBusy guard).

    `dry_run=True` passes knowledge-ctx's OWN `--dry-run` instead of `--force`.
    `cmd_spawn` calls this unconditionally, before `_run_session` ever looks at
    `args.dry_run` (that check only decides whether to launch the claude
    subprocess) — so without this, a `spawn --dry-run` against a repo whose
    worktree resolves to the primary checkout ran a REAL `knowledge-ctx use
    <name> --force` against that live tree. Found dispatching commercial-writer
    against convivy-commercial: the dry run force-individuated into the live
    workspace and was saved only by the profile failing to resolve first.

    `agent` names the agent this worktree is being individuated for, and passing
    it is what makes instruction-block assembly deliver the right blocks
    (issue_01M2PXHKZ3SE1AQPS8MWWT691X). knowledge-ctx reads the flag's PRESENCE
    as `binds_sessions: dispatched` and its value as the `binds_agents` subject,
    because nothing in a document can tell a dispatched run from a crew session.
    Omitting it here does not merely leave `binds_agents` blocks unmatched: the
    render is then classified `interactive`, so a dispatched agent receives every
    `binds_sessions: [interactive]` block — `working-with-the-operator` reaching
    a worker that has no operator to work with — while `review-a-pull-request`
    reaches no reviewer. That is the definition of done inverted rather than
    unmet, which is why the flag is wired at the same time as the feature.

    `agent` ALSO decides WHAT is rendered (issue_01M2MAP3X0Q1BQW06AV8204CFW):
    knowledge-ctx fetches that agent's bundle from the Library instead of
    rendering the whole profile, so this one flag is the only place the agent is
    known. `issue` is the work item the dispatch names (`spawn --issue`); it
    scopes the bundle to agent+item where the Library has a profile for the
    item's product, and knowledge-ctx falls back to agent+repo where it has
    none. Meaningless without an agent, so it is only forwarded with one.

    `allow_default=False` (an explicit `spawn --profile`) makes knowledge-ctx load
    the named profile or refuse. When knowledge-ctx does fall back to
    platform/default, this re-emits its reason on stderr and, if `loaded` is a
    dict, sets `loaded["profile"]` to the profile actually rendered so the caller
    records that one rather than the one requested.

    If `loaded` is a dict, this also sets `loaded["profile_documents_current"]`
    — True iff knowledge-ctx wrote `_PROFILE_DOCUMENTS_CURRENT_PAYLOAD` to the
    dedicated pipe fd this call opened and passed it, i.e.
    `.claude/.profile-documents.json` in `worktree` is current for the
    individuation THIS call just ran (written, or proven a byte-for-byte
    no-op), False otherwise — in particular False for `dry_run=True`, which
    returns from knowledge-ctx before that proof ever runs, and False for
    anything received on that pipe other than the exact expected payload. The
    caller must gate any read of that file on this value rather than on "did
    this function run" (security-reviewer, PR #740 round 4). The pipe, not a
    marker matched out of stdout/stderr, is what that value comes from
    (security-reviewer, PR #740 round 5)."""
    name = _profile_name(qualified_profile)
    cmd = [str(KNOWLEDGE_CTX), "use", name, "--dry-run" if dry_run else "--force"]
    if not allow_default:
        cmd.append("--no-default-fallback")
    if agent:
        cmd += ["--agent", agent]
        if issue:
            cmd += ["--issue", issue]
    # Exempt our own session chain from knowledge-ctx's live-process guard so an
    # orchestrator dispatching into its own primary worktree isn't blocked by itself
    # (P2a). A different live session in the target still aborts the write.
    for apid in _ancestor_pids():
        cmd += ["--exempt-pid", str(apid)]
    # A dedicated pipe for the profile-documents-current signal, opened by
    # this process and handed to knowledge-ctx by fd number — a channel
    # nothing else writes to, unlike stdout/stderr (see
    # `_PROFILE_DOCUMENTS_CURRENT_PAYLOAD`'s comment for why that distinction
    # is the round-5 fix). `pass_fds` is what keeps `write_fd` open across the
    # `exec` despite Python's default close-on-exec; `read_fd` stays ours
    # alone.
    read_fd, write_fd = os.pipe()
    cmd += ["--profile-documents-current-fd", str(write_fd)]
    try:
        cp = subprocess.run(cmd, cwd=str(worktree), capture_output=True, text=True,
                             pass_fds=(write_fd,))
    finally:
        # The child (if it ran at all) has already exited by the time
        # subprocess.run returns, closing its own copy; closing ours here is
        # what lets the read below reach EOF instead of blocking forever on a
        # write end subprocess.run itself still holds open.
        os.close(write_fd)
    try:
        signal = b""
        while True:
            chunk = os.read(read_fd, 4096)
            if not chunk:
                break
            signal += chunk
    finally:
        os.close(read_fd)
    profile_documents_current = signal == _PROFILE_DOCUMENTS_CURRENT_PAYLOAD
    if cp.returncode != 0:
        sys.stderr.write(cp.stdout + cp.stderr)
        mode = "--dry-run" if dry_run else "--force"
        raise SystemExit(f"knowledge-ctx use {name} {mode} failed in {worktree}")
    if loaded is not None:
        loaded["profile_documents_current"] = profile_documents_current
    # A zero exit does not mean every composed instruction was delivered:
    # knowledge-ctx refuses to overwrite a `.claude/CLAUDE.md` it did not
    # write (ARCH-023/080) and reports that on its own stdout/stderr, but
    # still exits 0 — a dispatched run's only caller is this function, and
    # until now nothing here looked at that output on the success path, so
    # the composed fleet/agent instruction blocks silently never reached the
    # run (security-reviewer, PR #635 round 3). Matched on the stable marker
    # knowledge-ctx emits for exactly this, not on the human-readable line,
    # which a wording change would otherwise break silently.
    fell_back = _DEFAULT_PROFILE_USED_RE.search(cp.stdout + "\n" + cp.stderr)
    if fell_back:
        print(f"agentctl: dispatched with default profile {fell_back.group('profile')} "
              f"instead of {qualified_profile} ({fell_back.group('reason')}).",
              file=sys.stderr)
        if loaded is not None:
            loaded["profile"] = fell_back.group("profile")
    no_crew = _NO_CREW_RE.search(cp.stdout + "\n" + cp.stderr)
    if no_crew:
        print(f"agentctl: {no_crew.group('reason')} (repo {no_crew.group('repo')}).",
              file=sys.stderr)
    topics_unreadable = _TOPICS_UNREADABLE_RE.search(cp.stdout + "\n" + cp.stderr)
    if topics_unreadable:
        print(f"agentctl: could not read {topics_unreadable.group('issue')}'s topics "
              f"({topics_unreadable.group('reason')}); this session's binds_topics "
              f"selectors will not match anything.", file=sys.stderr)
    blocked_match = _CLAUDE_MD_NOT_DELIVERED_RE.search(cp.stdout + "\n" + cp.stderr)
    if blocked_match:
        blocked = (blocked_match.group("path"), blocked_match.group("reason"))
        print(f"agentctl: composed session instructions were NOT delivered in "
              f"{worktree} — {blocked[0]} left in place ({blocked[1]}).",
              file=sys.stderr)
        return blocked
    return None


def _git_head(wt: Path) -> str:
    cp = subprocess.run(["git", "rev-parse", "HEAD"], cwd=str(wt),
                        capture_output=True, text=True, check=False)
    return cp.stdout.strip() if cp.returncode == 0 else "unknown"


def _commits_since(wt: Path, base: str) -> int | None:
    """Commits reachable from HEAD but not from `base` — what THIS run added on
    top of the `started_head.txt` snapshotted at spawn, as opposed to
    `W.unpublished_commits`'s "every commit HEAD has that no remote has",
    which counts commits from BEFORE this run too.

    Returns None, never 0, when the count can't be determined (missing/unknown
    base, or git itself fails) — an inconclusive read must never be mistaken
    for "this run committed nothing".
    """
    if not base or base == "unknown":
        return None
    cp = subprocess.run(["git", "rev-list", "--count", f"{base}..HEAD"], cwd=str(wt),
                        capture_output=True, text=True, check=False)
    if cp.returncode != 0:
        return None
    try:
        return int(cp.stdout.strip() or 0)
    except ValueError:
        return None


def _has_git_remote(wt: Path) -> bool | None:
    """Whether this tree has any git remote configured. None (not False) when
    the read itself fails, so a caller can tell "no remotes" from "couldn't
    check"."""
    cp = subprocess.run(["git", "remote"], cwd=str(wt),
                        capture_output=True, text=True, check=False)
    if cp.returncode != 0:
        return None
    return bool(cp.stdout.strip())


def _snapshot_remote_flag(wt: Path) -> str:
    """Spawn-time record of whether `wt` has a git remote, written to
    started_remote.txt beside started_head.txt.

    Finalize reads THIS record rather than re-running `_has_git_remote` after
    the run exits, because a worktree shares its primary checkout's
    `.git/config` — a run that executes `git remote remove origin` during its
    own lifetime would otherwise flip its own committed_local_only/
    committed_not_pushed label at finalize time, silencing the loud
    committed_not_pushed state on nothing but its own say-so
    (issue_01M2EKF1YCM97QDTZ2EHS6W5NX round 2).

    Returns "true", "false", or "unknown" (the check itself failed) — a
    string, not bool | None, because this is written to disk and read back by
    a later process.
    """
    has_remote = _has_git_remote(wt)
    if has_remote is None:
        return "unknown"
    return "true" if has_remote else "false"


def _snapshot_dirty_paths(wt: Path) -> set[str]:
    """Set of paths currently dirty per `git status --porcelain`. Used to
    baseline pre-existing dirt so finalize can attribute only the new changes
    to the agent."""
    cp = subprocess.run(
        ["git", "status", "--porcelain"], cwd=str(wt),
        capture_output=True, text=True, check=False,
    )
    out: set[str] = set()
    if cp.returncode != 0:
        return out
    for line in cp.stdout.splitlines():
        if len(line) < 4:
            continue
        # Rename status "R" formats as "old -> new"; both ends are pre-existing.
        raw = line[3:]
        for chunk in raw.split(" -> "):
            out.add(chunk.strip())
    return out


def _baseline_primaries(run_dir: Path, worktree: Path) -> None:
    """Record every primary checkout's state before the agent starts.

    `_finalize_run` diffs against this to decide whether the run wrote into a
    checkout it does not own (`primary_guard`, issue_01KZ7E0YNV84W55796CZ8ETX6X).
    Best-effort throughout: a dispatch must never fail because the guard could
    not read a repo, so a missing or partial baseline just means fewer repos are
    checked at the other end."""
    if PG is None:
        return
    try:
        PG.write_baseline(run_dir, PG.snapshot(owned=worktree))
    except Exception as exc:  # pragma: no cover — defensive; never abort a spawn
        print(f"agentctl: could not baseline primary checkouts ({exc}); "
              f"a mutation by this run will not be caught.", file=sys.stderr)


def _detect_primary_mutations(*, run_dir: Path, worktree: Path, run_id: str) -> list:
    """Primaries this run changed since its spawn-time baseline.

    Prints loudly and persists the detail whatever the run's status; the caller
    decides what to do to `exit_status`. Returns [] when the guard cannot reach a
    verdict — unlinked module, no baseline, an unreadable repo — because a
    fabricated leak would teach its reader to ignore the one signal that matters.
    """
    if PG is None:
        return []
    try:
        before = PG.read_baseline(run_dir)
        if not before:
            return []
        mutations = PG.diff(before, PG.snapshot(owned=worktree), worktree=worktree)
    except Exception as exc:  # pragma: no cover — defensive; never break finalize
        print(f"agentctl: primary-mutation check failed to run ({exc}); "
              f"this run was NOT checked.", file=sys.stderr)
        return []

    if not mutations:
        return []

    meta = T.read_meta(run_dir)
    agent = meta.get("agent") or "?"

    # The guard sees the filesystem, not the process. Any run live at this moment
    # shared the window, so on a busy night one real leak is reported by every
    # overlapping run. Naming them is what lets an operator tell one cause from
    # several — a shared target across disjoint worktrees is the concurrent
    # signature. Best-effort: the registry being unreadable must not lose the
    # finding it annotates.
    try:
        concurrent = sorted(r.get("run_id") for r in R.list_runs()
                            if r.get("run_id") and r.get("run_id") != run_id)
    except Exception:
        concurrent = []

    try:
        (run_dir / "primary_mutations.json").write_text(json.dumps(
            {"run_id": run_id, "agent": agent, "worktree": str(worktree),
             "concurrent_runs": concurrent,
             "mutations": [
                 {"repo": m.repo, "added": list(m.added), "removed": list(m.removed),
                  "head_before": m.head_before, "head_after": m.head_after,
                  "echoed_in_worktree": list(m.echoed_in_worktree),
                  "attribution": m.attribution}
                 for m in mutations]}, indent=2))
    except OSError:
        pass

    real = [m for m in mutations if m.is_working_tree_mutation]
    print(f"agentctl: PRIMARY CHECKOUT(S) CHANGED during run {run_id} ({agent}) — "
          f"its worktree is {worktree}.", file=sys.stderr)
    for m in mutations:
        print(f"  {m.describe()}", file=sys.stderr)
    if concurrent:
        print(f"  {len(concurrent)} other run(s) were live and share this window, so "
              f"the change may be theirs: {', '.join(concurrent[:6])}"
              f"{' …' if len(concurrent) > 6 else ''}. The same files reported by "
              f"several runs with disjoint worktrees means ONE cause, not several.",
              file=sys.stderr)
    if real:
        print(f"  Worktree isolation is what stops a dispatched run touching the "
              f"operator's checkouts. Inspect before doing anything else: added files may be "
              f"stale duplicates of work that also reached a branch, and any "
              f"REMOVED entry was uncommitted work whose content is gone unless it also "
              f"reached a commit or a stash that still exists. "
              f"Detail: {run_dir / 'primary_mutations.json'}", file=sys.stderr)
    else:
        print("  FYI only — no file changed, so this run's status is untouched. A "
              "HEAD move on its own is usually a human or another process switching "
              "branches mid-run, and branch state belongs to check-primary-checkouts "
              "(ARCH-437) rather than here.", file=sys.stderr)

    _file_unattributed_mutations(mutations, run_dir=run_dir, run_id=run_id,
                                 agent=agent, worktree=worktree)
    return mutations


# The guard's signal runs on the finalize path, where a locked store must not hold a finished run.
# `timeout` is per socket operation, and it is per attempt in the sense that post_structured makes up
# to three attempts with backoff between them. A store that stops answering costs about 19.5 seconds
# inline (3 x 5s plus at most 4.5s of backoff). A store that trickles bytes can exceed that, since
# urllib applies the timeout to each read, not to the whole request.
_GUARD_SIGNAL_TIMEOUT = 5


def _file_unattributed_mutations(mutations: list, *, run_dir: Path, run_id: str,
                                 agent: str, worktree: Path) -> None:
    """A real mutation nobody can be pinned for logs an alert signal for a human.

    THE OTHER HALF OF `Mutation.downgrades_run`, and the half that must not be
    dropped (`issue_01KZ94PCSF9HFQ9487FR4A3V5F`). Now that an unattributed
    mutation no longer fails the run that noticed it, this is the only thing that
    carries it to a human — and a stderr line in a run log nobody greps is what
    the #362 security review named as the weakness of report-only. It logs a
    signal and never a work item (platform/decisions/0073).

    Best-effort throughout. `post_alert` never raises by design, and a store that
    is unreachable must not change how a run finalizes; the stderr report and
    `primary_mutations.json` have already landed by the time this is called.
    """
    unowned = [m for m in mutations if m.needs_an_owner]
    if not unowned:
        return
    try:
        from signal_client import post_alert, sanitise  # lazy: only a mutation needs it
    except ImportError as exc:  # pragma: no cover — deploy-window only
        print(f"  Could not log a signal for the unattributed mutation(s) "
              f"({exc}); the detail is in {run_dir / 'primary_mutations.json'} and "
              f"nothing else will surface it.", file=sys.stderr)
        return

    for m in unowned:
        # THE WHOLE BODY IS GUARDED, not just the network call. A client returning an
        # unexpected shape would otherwise raise from outside the try and lose the run's
        # whole recorded outcome, to report a mutation the run probably did not cause
        # (reviewer, PR #367). Finalize is the last thing standing between a finished
        # agent and its status, so "best-effort" has to be structural.
        try:
            # Routed to the product that OWNS the mutated checkout, since that is where the
            # stale files sit and who has the context to judge whether an added path is a
            # duplicate or the only copy. The guard's own defects go to agent-platform.
            product = projects.resolve_project(m.repo, KNOWLEDGE_ROOT) or "agent-platform"
            # Keyed on the DESTRUCTION (the removed set and, when HEAD orphaned a commit, that commit), the day and the repo,
            # never the run: runs that see one destruction collapse to one signal, and a second destruction
            # the same day logs its own. Added paths stay out of the key, since their set depends on each
            # run's window (`primary_guard.fingerprint`), so an additive-only change after the first on a
            # day answers `duplicate`. The day bound lets a recurrence next week log again. A window
            # spanning midnight logs twice.
            today = _utc_day()
            once_key = (f"primary-mutation:{m.fingerprint()}:{today}:"
                        f"{_destruction_hash(m)}")
            title = f"Unattributed change to the {m.repo} primary checkout"
            # The body sanitises its own prose and leaves the removed paths verbatim; see
            # `_unattributed_signal_body`. Only the title goes through `sanitise` here.
            body = _unattributed_signal_body(m, run_id=run_id, agent=agent,
                                             worktree=worktree, run_dir=run_dir)
            status = post_alert("primary-mutation", f"{sanitise(title)}\n\n{body}",
                                product=product, dedup_key=once_key,
                                timeout=_GUARD_SIGNAL_TIMEOUT, meta={"severity": "medium"})
            if status == "created":
                print(f"  Logged a signal for the {m.repo} change — nobody is attributable, so "
                      f"it needs a human.", file=sys.stderr)
            elif status == "duplicate":
                # The same destruction, seen again today by another run: one destruction, one signal.
                # The store cannot take a comment on that signal, so this run's paths stay in its own file.
                print(f"  The {m.repo} change is already logged today ({once_key}). This run's "
                      f"paths are only in {run_dir / 'primary_mutations.json'}.", file=sys.stderr)
            else:
                print(f"  COULD NOT LOG a signal for the {m.repo} change ({status}). The only "
                      f"remaining trace is {run_dir / 'primary_mutations.json'}.", file=sys.stderr)
        except Exception as exc:
            print(f"  COULD NOT LOG a signal for the {m.repo} change "
                  f"({exc.__class__.__name__}). The only remaining trace is "
                  f"{run_dir / 'primary_mutations.json'}.", file=sys.stderr)


def _destruction_hash(m) -> str:
    """An unambiguous suffix for a primary-mutation key: a hash of what the mutation removed
    from the dirty set. That is the REMOVED path set and, when the HEAD orphaned a commit, that
    commit's id. A second destruction the same day with a different removed set, or a different
    orphaned commit, logs its own signal (reviewer, PR #788 rounds 1 and 4). An orphan-only
    mutation has an empty removed set, so without the commit id it would share the key of every
    additive-only change that day. Added paths are left out on purpose; see
    `primary_guard.fingerprint`.

    `"|".join(sorted(removed))` would let a path itself containing `|` alias two DIFFERENT sets
    to the same joined string (reviewer, PR #385 round 3). `json.dumps` of the sorted list keeps
    them distinct regardless of what characters a path contains."""
    payload = json.dumps(sorted(m.removed))
    if m.orphaned_head:
        payload = json.dumps([sorted(m.removed), m.head_before])
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:8]


def _utc_day() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def _md_path(p: str) -> str:
    """One filesystem path, safe to interpolate into a markdown bullet.

    These bodies are markdown logged unattended as a signal, one bullet per
    line, and since the guard read `git status` with `-z` (PR #608) a path
    arrives verbatim — so a filename like `evil.py` embedding two literal
    newlines before `# forged content` would inject its own lines into a
    logged signal. The rule lives in `primary_guard.safe_path`, beside the
    `-z` read that made paths untrusted, so the stderr line and these bodies
    cannot drift apart. The backtick is this destination's addition:
    markdown has no escape for one INSIDE a code span, since a backslash there
    renders literally and the span still closes.

    Reached only via `_file_unattributed_mutations`, which returns early when
    `PG` is None, so there is no import-failure path to this line.
    """
    return PG.safe_path(p, extra="`")


def _path_bullet(p: str, clean) -> str:
    """One path as a markdown bullet. `clean` (`SC.sanitise` or `SC.sanitise_path`) redacts a
    credential prefix in the raw name, as written or with a character `clean` removes, before
    `_md_path` escapes it — escaping first turned a control character inside the prefix into text
    the prefix rule does not match. A whitespace control or a kept format character inside the
    prefix still lets the value through, a known gap not acted on. The closing backtick is added
    last, since the prefix rule's run of non-space characters would otherwise take it."""
    return f"- `{_md_path(clean(p))}`"


# The two files an ordinary install writes that `_doctor_auth` falls back to,
# beside `SC.TOKEN_FILE` (`agent-platform-token`, never written by an install —
# see `_doctor_auth`). A module-level constant, like `signal_client.TOKEN_FILE`
# beside it, so a test can monkeypatch where these are looked for without
# monkeypatching `Path.home` itself.
_ORIENT_CONTROL_DIR = Path.home() / ".orient-control"
_DOCTOR_FALLBACK_TOKEN_FILES = ("library-token", "ops-mcp-token")


class _DoctorAuth(NamedTuple):
    """The token, its destination and its headers, bound together so a later
    edit cannot pair one token with the other's address (security-reviewer,
    PR #708 round 2). `pinned` is set exactly when `base_url` is the Library's
    fixed default rather than wherever the environment currently points, which
    is the caller's cue to send the request through `issue_client.
    pinned_opener()` rather than the process-wide one."""
    token: str | None
    base_url: str
    headers: dict[str, str]
    pinned: bool


def _doctor_auth() -> _DoctorAuth:
    """The bearer token AND the address it is safe to send it to, for the
    Library routes `crew doctor` calls (`roster.read`, granted to any
    `agent`- or `system`-kind credential — library identity.py).

    `SC.token()` first, UNCHANGED for the callers that already depend on it
    (`AGENT_SIGNAL_TOKEN`, or the 0600 file `~/.orient-control/agent-platform-
    token`) — a name this Convivy machine happens to have minted by hand,
    which is why the doctor worked here and 401'd on every adopter install
    that never mints it (issue_01M3NW81FC33701HQE3WV7HFRE). It goes to
    `vault_plane.base_url()`, exactly as before: this call site deliberately
    checks the Library wherever the environment points it, and this token is
    the one this Convivy machine already scoped for that.

    Two files an ordinary install DOES write are tried next: `library-token`
    — the Library's own README mints this one specifically "for `agentctl`
    and Orient's own tooling" — then `ops-mcp-token`, the credential
    `mcp-ops-server` (this repo's other Library client over a plain bearer
    token) already sends for routes gated the same way. **Neither goes to
    `vault_plane.base_url()`.** In the Library's own identity.py these resolve
    to an `agent`- or `system`-kind credential holding far more than
    `roster.read` — `merge.admit`, `ledger.spend`, `item.resolve` among them —
    and `base_url()` is an address `LIBRARY_BASE_URL` (or `VAULTS_ON_LIBRARY`/
    `ORIENT_BASE_URL`) lets the environment repoint to any host that passes
    `_refuse_cleartext` (loopback, or any `https://` address). So a fallback
    token goes only to `vault_plane.fixed_library_url()` — the same guard
    `issue_client.get_item_from_default_library` holds a Library read to for
    the identical reason — with `vault_plane.library_headers()`, which always
    carries the `Library-Protocol` header the fixed address needs regardless
    of which plane the rest of this process is configured for (security-
    reviewer, PR #708 round 2).
    """
    import vault_plane as VP
    tok = SC.token()
    if tok:
        return _DoctorAuth(tok, VP.base_url(), VP.headers(token=tok), False)
    for name in _DOCTOR_FALLBACK_TOKEN_FILES:
        try:
            tok = (_ORIENT_CONTROL_DIR / name).read_text().strip()
        except OSError:
            continue
        if tok:
            return _DoctorAuth(tok, VP.fixed_library_url(""),
                               VP.library_headers(token=tok), True)
    return _DoctorAuth(None, VP.base_url(), VP.headers(token=None), False)


def cmd_crew_doctor(args) -> int:
    """Report every registration site for a crew, by exercising each one.

    THE STATUS LINE IS THE PRODUCT. A crew that fails is useless in a way nobody
    notices — Signals had a directory, a repo, a session and a Deck spec, was
    reported done, and could not dispatch a writing agent or launch with `co -r`.
    So this prints one line per site naming the site and its owning crew, and
    exits non-zero when any site is MISSING **or** UNKNOWN: a site that could not
    be checked has not passed, and treating it as a pass is how a guard becomes
    decoration.

    UNKNOWN IS KEPT SEPARATE FROM MISSING because they send the reader somewhere
    different. The Library being mid-WAL-switch is not a broken crew, and a
    doctor that says it is sends whoever runs it after the wrong thing.
    """
    # Optional, not required. `crew_doctor` no longer imports PyYAML (its profile
    # site reads the Library, not a YAML file), and neither do the `knowledge.py`
    # validators this command loads. The request stays so `ensure` still enters a
    # yaml-capable venv when one is present; with none, the command carries on and
    # checks every site.
    venv_bootstrap.ensure(__file__, requires=("yaml",), optional=True)
    import crew_doctor as CD
    import vault_plane as VP

    # `knowledge.py` lives in lib/knowledge, not lib/agent-platform, so it is not
    # already on the path. THIS CHECKOUT'S COPY FIRST, then the deployed one —
    # the same ordering and the same reason as `_kb_indexer` above: `bin/agentctl`
    # may itself be the working copy or the deployed symlink (ARCH-229), and a
    # branch changing the validators must be checked against ITS OWN, not against
    # whatever `install.sh` last deployed.
    for cand in (Path(__file__).resolve().parent.parent / "lib" / "knowledge",
                 Path.home() / ".local" / "lib" / "knowledge"):
        if (cand / "knowledge.py").is_file():
            sys.path.insert(0, str(cand))
            break
    # REFUSE ON WHAT WE GOT, NOT ON HOW IT FAILED. `ImportError` is not the only
    # way this comes back unusable: `sys.modules` can hold `None` for a name, and
    # a module can import while lacking what we need. Catching only `ImportError`
    # left `K` bound to `None` and the command died three lines later with
    # `AttributeError: 'NoneType' object has no attribute 'ALLOWED_PROJECTS'`,
    # which is worse than either outcome — a crash rather than the refusal this
    # branch exists to produce. Found by the test the round-2 reviewer asked for,
    # which is the argument for writing it.
    try:
        import knowledge as K
    except ImportError as exc:
        K, why = None, str(exc)
    else:
        # NAME THE ATTRIBUTE THAT IS ACTUALLY MISSING, not the pair. A module
        # holding ALLOWED_PROJECTS but no ID_PATTERN reported "has no
        # ALLOWED_PROJECTS/ID_PATTERN", which reads as neither being there and
        # sends the reader to the wrong half of the file — against this module's
        # own rule, which is why `check_index_serves` names the documents it
        # cannot find rather than counting them (reviewer, PR #609 round 3).
        absent = [n for n in ("ALLOWED_PROJECTS", "ID_PATTERN", "project_catalogue")
                  if not hasattr(K, n)]
        why = f"the module imported but has no {', '.join(absent)}" if absent else ""
        if absent:
            K = None
    if K is None:
        print(f"agentctl crew doctor: cannot use the KB validators ({why}); "
              f"the KB site cannot be checked, so refusing rather than "
              f"reporting it passed.", file=sys.stderr)
        return 2

    crews = CD.active_crews() if args.all_crews else ([args.crew] if args.crew else [])
    if not crews:
        print("agentctl crew doctor: name a crew, or pass --all", file=sys.stderr)
        return 2

    # The same plane every other Library client here uses when the token is
    # `SC.token()`'s own, so a doctor run cannot disagree with the thing it is
    # checking about where the Library is. A token an install actually writes
    # instead goes only to the Library's fixed default address, never
    # wherever the environment points `vault_plane.base_url()` — see
    # `_doctor_auth`.
    auth = _doctor_auth()
    base_url, headers = auth.base_url, auth.headers
    opener = None
    if auth.pinned:
        import issue_client as IC  # name binding only: agentctl's import already loaded it; this path calls pinned_opener
        opener = IC.pinned_opener()
        if base_url != VP.base_url():
            print(f"agentctl crew doctor: the token came from an "
                  f"install-written fallback file, so this run checks the "
                  f"Library's fixed default address rather than "
                  f"{VP.describe()}", file=sys.stderr)

    # The set the indexer applies to this checkout, not the module's baseline: a
    # project the knowledge repo holds is admitted without a row in knowledge.py.
    catalogue = K.project_catalogue(KNOWLEDGE_ROOT)

    worst = 0
    for i, crew in enumerate(crews):
        if i:
            print()
        results = CD.diagnose(
            crew, derive_purpose=derive_purpose,
            allowed=catalogue.allowed, id_pattern=catalogue.id_pattern,
            variant=args.variant, base_url=base_url, headers=headers,
            opener=opener)
        bad = [r for r in results if not r.ok]
        print(f"crew doctor: {crew} — "
              f"{'OK' if not bad else f'{len(bad)} of {len(results)} site(s) need attention'}")
        for r in results:
            print(f"  {r.line()}")
        if bad:
            worst = 1
    return worst


def cmd_crew_register(args: argparse.Namespace) -> int:
    """CLI entry point for `agentctl crew register`
    (issue_01M3YN6857H5J541G73Y9P3KA1): add one crew to config/projects.json,
    refusing a clashing name and leaving the registry file untouched on any
    refusal. `crew_registration.register` does the work; this wraps it in
    the command's own argument shape and exit-code convention.
    """
    import crew_registration as CR
    import operator_config

    overnight = {"true": True, "false": False, "own-drain": "own-drain",
                 None: None}[args.overnight]
    # The creator is recorded from the operator config's `person_id`, never
    # refused when it is absent: a fresh install registers crews before the
    # Library's bootstrap has created anyone to name (issue_01M2QWFR8PCBPANF8Q5P460GHY).
    created_by = None
    try:
        created_by = operator_config.get("person_id")
    except operator_config.OperatorConfigError as exc:
        print(f"agentctl crew register: did not record a creator for "
              f"{args.slug!r} — {exc}", file=sys.stderr)
    spec = CR.CrewSpec(
        slug=args.slug,
        display=args.display,
        repos=args.repos if args.repos is not None else [args.slug],
        crew=args.crew,
        owner=args.owner,
        created_by=created_by,
        cls=args.cls,
        kb=args.kb,
        kb_project=args.kb_project,
        aliases=args.aliases,
        products=args.products,
        home_dir=args.home_dir,
        dirs=args.dirs,
        lifecycle=args.lifecycle,
        model_tier=args.model_tier,
        task_text_public=args.task_text_public,
        overnight=overnight,
        private=args.private,
        data_local=args.data_local,
        agent_prefix=args.agent_prefix,
        crew_cockpit=args.crew_cockpit,
        note=args.note,
    )
    registry_path = Path(args.registry) if args.registry else None
    # Resolved up front, independent of CR.register()'s own return value: a
    # refusal raised inside build_row() (a bad slug, an inconsistent
    # --private row, …) never reaches that return, so this is the only path
    # an operator has at refusal time to learn which file was left alone.
    path = CR.resolved_registry_path(registry_path)
    try:
        _, row = CR.register(spec, registry_path=registry_path, dry_run=args.dry_run)
    except CR.RegistrationRefused as exc:
        print(f"agentctl crew register: refused — {exc} (registry: {path})",
              file=sys.stderr)
        return 1
    verb = "would register" if args.dry_run else "registered"
    print(f"agentctl crew register: {verb} {args.slug!r} in {path}")
    print(json.dumps(row, indent=2, ensure_ascii=False))
    if not args.dry_run:
        print(
            "agentctl crew register: the Library picks up this row on its "
            "next lookup")
    return 0


def _propose_crew_profile(rel: str, content: str, title: str, rationale: str) -> str:
    """The Library's route for a crew's profile: `kb propose` opens the pull request.
    The content goes through a temp file outside any checkout, and the PR URL is
    the command's last stdout line."""
    import crew_create as CC
    with tempfile.TemporaryDirectory(prefix="crew-create-") as tmp:
        src = Path(tmp) / "profile.yaml"
        src.write_text(content, encoding="utf-8")
        cp = subprocess.run(
            [sys.executable, str(Path(__file__).resolve()), "kb", "propose", rel,
             "--title", title, "--rationale", rationale, "--content-file", str(src)],
            capture_output=True, text=True, check=False)
    if cp.returncode != 0:
        raise CC.ProposeError((cp.stderr or cp.stdout or "no output").strip()[-400:])
    return (cp.stdout.strip().splitlines() or [""])[-1]


def cmd_crew_create(args) -> int:
    """`agentctl crew create <id>` (issue_01M4AB9X62112MCG8B5501CMKV): the eight
    steps in lib/agent-platform/crew_create.py, composed on the existing `crew
    register` and `crew doctor` paths. A person supplies the id, `--display` and
    `--dir`. Every other field takes `crew register`'s defaults.
    """
    import crew_create as CC
    import crew_doctor as CD
    import crew_registration as CR
    import session_crews as SC

    auth = _doctor_auth()
    opener = None
    if auth.pinned:
        import issue_client as IC  # lazy: only the fallback-token path needs it
        opener = IC.pinned_opener()
    short_host = subprocess.run(["hostname", "-s"], capture_output=True, text=True,
                                check=False).stdout.strip() or socket.gethostname()
    env = CC.Env(
        registry_path=Path(args.registry) if args.registry else None,
        crews_dir=Path(args.crews_dir) if args.crews_dir else SC.CREWS_D,
        knowledge_ctx=CD._own_bin("knowledge-ctx", _root()),
        knowledge_root=KNOWLEDGE_ROOT,
        library_loader=_root() / "library" / "load_crew_registry.py",
        host=short_host,
        propose=_propose_crew_profile,
        served=lambda crew: CD._served_profile(
            crew, CC.DEFAULT_VARIANT, base_url=auth.base_url, headers=auth.headers,
            opener=opener),
        doctor=lambda crew: cmd_crew_doctor(argparse.Namespace(
            crew=crew, all_crews=False, variant=CC.DEFAULT_VARIANT)),
        tmux_socket=os.environ.get("CREW_TMUX_SOCKET") or None,
    )
    spec = CR.CrewSpec(slug=args.slug, display=args.display, repos=[args.slug])
    return CC.create(args.slug, display=args.display, working_dir=Path(args.dir).expanduser(),
                     spec=spec, env=env)


def _unattributed_signal_body(m, *, run_id: str, agent: str, worktree: Path,
                             run_dir: Path) -> str:
    """What a human needs to act, written so the reader is not misled about blame.

    The reporting run is named as the OBSERVER, not the author. Stating it any
    other way would re-create in prose the false accusation the status change
    removed.

    THE REMOVED PATHS SKIP ONLY THE LONG-RUN RULE. The removed paths are the only record of what
    left the dirty set, so a long file name must name the file. `sanitise` would redact a
    32-character run as a credential, so the removed bullets clean their names with
    `SC.sanitise_path`, which applies every other step. A credential prefix in a removed name is
    redacted when it appears as written or with a character `sanitise_path` removes; a whitespace
    control or a kept format character inside the prefix lets the value through, and that gap is
    known and not acted on, because no occurrence of it is named. Added names clean with
    `SC.sanitise`. Each name is cleaned before
    `_path_bullet` escapes it, and the bullets skip the outer `SC.sanitise` pass. Every other
    line goes through `SC.sanitise`, so a credential in the run id or the agent name is redacted
    when it appears as written or with a character `sanitise` removes; a whitespace control or a
    kept format character inside the prefix lets it through there too, a known gap not acted on.
    The caller sanitises the title only.
    """
    path_lines: set[int] = set()  # indexes of path bullets, already cleaned by _path_bullet
    lines = [
        f"A primary checkout at `{_root() / m.repo}` changed while run `{run_id}` "
        f"(`{agent}`) was live, and **the guard cannot tell who changed it**. None "
        f"of the paths exist in that run's own worktree (`{worktree}`), which is "
        f"the signal that would identify it as the author, so it is reported here "
        f"as the observer rather than the cause.",
        "",
        "A dispatched run works in a worktree; a change in a primary is either "
        "another run leaking, or a human working in that checkout. Both are worth "
        "a look and only one is a defect.",
        "",
    ]
    if m.added:
        lines += [f"**{len(m.added)} path(s) appeared** — check whether each is a stale "
                  f"duplicate of work that also reached a branch, or the only copy:", ""]
        start = len(lines)
        lines += [_path_bullet(p, SC.sanitise) for p in m.added[:20]]
        path_lines.update(range(start, len(lines)))
        if len(m.added) > 20:
            lines.append(f"- …and {len(m.added) - 20} more")
        lines.append("")
    if m.removed:
        lines += [f"**{len(m.removed)} pre-existing uncommitted change(s) REMOVED from the "
                  f"dirty set.** This is the class that discards content (`reset --hard`, "
                  f"`checkout -- .`). `git stash` also takes dirt out of the tree, and keeps "
                  f"its content in the stash. The content is gone unless it also reached a "
                  f"commit or a stash that still exists:", ""]
        start = len(lines)
        lines += [_path_bullet(p, SC.sanitise_path) for p in m.removed[:20]]
        path_lines.update(range(start, len(lines)))
        if len(m.removed) > 20:
            lines.append(f"- …and {len(m.removed) - 20} more")
        lines.append("")
    if m.orphaned_head:
        lines += [f"**HEAD moved and ORPHANED the old commit** "
                  f"(`{(m.head_before or '')[:9]}` → `{(m.head_after or '')[:9]}`). No "
                  f"ref contains it any more, so its content is recoverable only from "
                  f"the reflog, by someone who knows to look.", ""]
    lines += [
        f"Full detail: `{run_dir / 'primary_mutations.json'}`, which also names every "
        f"other run live in the same window. The same paths reported by several runs "
        f"with disjoint worktrees means ONE cause, not several.",
        "",
        "Logged by the primary-mutation guard (`lib/agent-platform/primary_guard.py`, "
        "issue_01KZ7E0YNV84W55796CZ8ETX6X). It logs rather than failing the "
        "observing run because five of the guard's first six firings failed a run "
        "its own attribution had already called innocent "
        "(issue_01KZ94PCSF9HFQ9487FR4A3V5F).",
    ]
    return "\n".join(ln if i in path_lines else SC.sanitise(ln)
                     for i, ln in enumerate(lines))


def _parse_status_letter(letter: str) -> str:
    """Map git porcelain X/Y to one of {M,A,D,R} for our bucketing."""
    return letter if letter in ("M", "A", "D", "R") else "M"


def _changed_files(wt: Path, run_dir: Path) -> tuple[list[str], list[str], list[str]]:
    """Files the AGENT touched, not files that were already dirty pre-run.

    Uses `started_head.txt` + `started_dirty.txt` (snapshotted at spawn) as
    the baseline. Computes the union of (a) files in commits since the
    baseline HEAD and (b) currently-dirty files that weren't in the baseline
    dirty set. Falls back to plain working-tree status when the baseline is
    missing (legacy run dirs).
    """
    head_file = run_dir / "started_head.txt"
    if not head_file.exists():
        return _changed_files_fallback(wt)

    started_head = head_file.read_text().strip()
    dirty_file = run_dir / "started_dirty.txt"
    started_dirty: set[str] = set()
    if dirty_file.exists():
        started_dirty = {ln.strip() for ln in dirty_file.read_text().splitlines() if ln.strip()}

    mod: set[str] = set()
    add: set[str] = set()
    dele: set[str] = set()

    # 1) Committed changes since baseline HEAD
    if started_head and started_head != "unknown":
        cp = subprocess.run(
            ["git", "diff", "--name-status", f"{started_head}..HEAD"],
            cwd=str(wt), capture_output=True, text=True, check=False,
        )
        if cp.returncode == 0:
            for line in cp.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) < 2:
                    continue
                status = parts[0][0]
                if status == "R" and len(parts) >= 3:
                    dele.add(parts[1]); add.add(parts[2])
                    continue
                path = parts[-1]
                if status == "M":   mod.add(path)
                elif status == "A": add.add(path)
                elif status == "D": dele.add(path)
                else:               mod.add(path)

    # 2) Working-tree dirty MINUS pre-existing dirty (agent's uncommitted work)
    cp2 = subprocess.run(
        ["git", "status", "--porcelain"], cwd=str(wt),
        capture_output=True, text=True, check=False,
    )
    if cp2.returncode == 0:
        for line in cp2.stdout.splitlines():
            if len(line) < 4:
                continue
            x, y, raw = line[0], line[1], line[3:]
            target = raw.split(" -> ")[-1].strip()
            if target in started_dirty:
                continue
            if x == "?" and y == "?":
                add.add(target); continue
            status = x if x != " " else y
            if status == "R" and "->" in raw:
                old, _, new = raw.partition(" -> ")
                dele.add(old.strip()); add.add(new.strip())
            elif status == "D":
                dele.add(target)
            elif status == "A":
                add.add(target)
            else:
                mod.add(target)

    return sorted(mod), sorted(add), sorted(dele)


def _changed_files_fallback(wt: Path) -> tuple[list[str], list[str], list[str]]:
    """Legacy path for run dirs predating per-run-diff (#16). Working-tree
    status only — conflates pre-existing dirt with agent changes."""
    cp = subprocess.run(
        ["git", "status", "--porcelain"], cwd=str(wt),
        capture_output=True, text=True, check=False,
    )
    mod, add, dele = [], [], []
    for line in cp.stdout.splitlines():
        if len(line) < 4:
            continue
        x, y, path = line[0], line[1], line[3:]
        if x == "?" and y == "?":
            add.append(path); continue
        status = x if x != " " else y
        if status == "M":   mod.append(path)
        elif status == "A": add.append(path)
        elif status == "D": dele.append(path)
        elif status == "R" and "->" in path:
            old, _, new = path.partition(" -> ")
            dele.append(old.strip()); add.append(new.strip())
        else:
            mod.append(path)
    return mod, add, dele


# --- spawn ------------------------------------------------------------------

# The convivy-bosun GitHub App (github_app.py), installed org-wide — the same App
# `bin/pr-state-capture` and `kb_audit.py` already mint scoped read tokens from. Every
# dispatched run gets its OWN per-run installation token here, in the dispatcher, minted
# fresh by `_mint_run_github_token` below and handed to `dispatch_env()` as `github_token`
# — never the operator's `gh`-managed, keyring-stored token a run's own git credential
# helper could otherwise reach (CQ·418: two security-reviewer runs printed that token into
# their transcripts by running `git credential fill`).
_BOSUN_APP_ID = "4666673"
_BOSUN_APP_OWNER = "convivy"
_BOSUN_APP_KEY_PATH = BR.real_account_home() / ".config" / "convivy" / "bosun-app.pem"
# metadata:read is implicit on every GitHub App installation token and is not named here.
# Every key must be one the installation itself grants, or GitHub refuses the whole token
# with 422 and every spawn fails. On 2026-10-08 the installation granted actions:read,
# checks:read, contents:write, metadata:read and pull_requests:write, and no `issues`;
# asking for issues:read stopped all dispatch the moment this landed.
_RUN_TOKEN_PERMISSIONS = {
    "contents": "read", "pull_requests": "read",
    "checks": "read", "actions": "read",
}


def _mint_run_github_token(repo: str) -> tuple[str | None, str | None]:
    """A per-run convivy-bosun installation token: `(token, None)` on success, or
    `(None, reason)` when the App key or GitHub refuses. Read-only, and scoped to
    `repo` (narrowing the blast radius of a leaked token to the one repository this
    run is dispatched against — the same narrowing `kb_audit.py` applies for its own
    read, reviewer + security-reviewer PR #803 round 1) and to `_RUN_TOKEN_PERMISSIONS`.

    The App's private key is read HERE, in the dispatcher process, by `GA.app_jwt` —
    it goes no further than this function's own stack. Only the token this function
    returns is ever passed into a run's environment."""
    problem = GA.key_problem(_BOSUN_APP_KEY_PATH, label="the convivy-bosun App")
    if problem:
        return None, problem
    try:
        jwt = GA.app_jwt(_BOSUN_APP_KEY_PATH, _BOSUN_APP_ID)
        inst = GA.single_installation(jwt, _BOSUN_APP_OWNER)
        inst_id = str(inst.get("id") or "")
        if not inst_id:
            raise GA.Unreadable("the installation carries no id")
        token = GA.installation_token(
            jwt, inst_id, repositories=[repo], permissions=_RUN_TOKEN_PERMISSIONS)
    except GA.Unreadable as e:
        return None, str(e)
    return token, None


def cmd_spawn(args: argparse.Namespace) -> int:
    """CLI entry point for `agentctl spawn`. Thin wrapper over
    `_spawn_dispatch`, which does the actual work and hands back the run id
    it allocated as a return value (`None` for a refusal that happens before
    one exists) instead of only printing it — the shape a future in-process
    dispatch verb can call directly rather than parsing this command's
    stderr (model-lane epic issue_01M35KQ8WTW8R3WSKXS81TV2DZ, slice 1)."""
    exit_code, _run_id = _spawn_dispatch(args)
    return exit_code


def _spawn_dispatch(args: argparse.Namespace) -> tuple[int, str | None]:
    """Setup phase (runs in the parent process so errors reach the user).

    Resolves agent + profile, checks concurrency + budget, allocates worktree,
    activates the knowledge profile, creates the run dir and writes the
    pre-run baselines. Then either runs the session inline (foreground) or
    daemonizes via double-fork and runs the session in the grandchild
    (--detach).

    Returns `(exit_code, run_id)`. `run_id` is `None` for every refusal that
    happens before one is allocated (`T.new_run_id()`, below) and the
    allocated id for everything after — `cmd_spawn` above discards it; this
    is the value-returning shape for an in-process caller. A Library refusal
    returns nothing: `_library_denials` raises SystemExit, and its preflight
    runs before `T.new_run_id()`.
    """
    run_id: str | None = None
    # A dispatched run dispatches nothing (steward ruling, 2026-10-06). This refusal is
    # the first statement, so it precedes every read of a credential: the profile
    # listing below reads the Library grant, which a run's sandbox denies.
    if RS.inside_dispatched_run():
        print("error: a dispatched run cannot dispatch; name the helper you need in your result",
              file=sys.stderr)
        return 2, None
    # Auto-nest under the dispatching run when --parent wasn't passed explicitly, so an
    # orchestrator's late close-loop / cycle-2 dispatches nest instead of orphaning
    # (ARCH-284 follow-up). Resolved once here; every downstream use of args.parent
    # (can_spawn, _co_session, the meta write) then sees the nested parent.
    args.parent = _resolve_parent(args.parent)

    # Warn if the DEPLOYED platform tree is stale or off-main.  Do this early
    # and non-blocking — a hard failure would wedge every dispatch.
    _warn_deployed_tree()

    # Refuse (not warn) when THIS process's own lib is not the canonical one —
    # unlike the check above, this blocks: it governs which tool_policy module
    # a spawned agent's grants are resolved against (security-reviewer,
    # agent-platform#470). Before any other side effect, same as the checks
    # below.
    lib_gate_exit = _spawn_lib_gate()
    if lib_gate_exit is not None:
        return lib_gate_exit, run_id

    # `--pr N` reads PR N from whatever repo `--on` names, so an omitted `--on`
    # with `--pr` set would silently resolve against the "constance" default —
    # the exact wrong-repo pin this refusal exists to close (issue
    # issue_01M1RZ3DTAN0PE1DDR3KMK2YVD). Three earlier rounds tried to infer the
    # repo from ambient state (the origin remote, the worktree's commondir file,
    # the live cwd) and each inference was a fresh input some other same-user
    # process could forge into a wrong pin; round 4 removes the inference
    # instead of hardening it again. Checked before any gh call.
    if getattr(args, "pr", None) and args.on is None:
        print(f"error: --pr {args.pr} needs --on naming the repo that PR belongs to "
              f"(e.g. --on agent-platform) — refused rather than guessing.",
              file=sys.stderr)
        return 2, run_id
    repo = args.on or "constance"
    # An unregistered crew prefix fails CLOSED here, before the index is read or
    # anything is allocated. The alternative is what happened twice: the name is
    # read as a bare role, the worker commits into a shared checkout, and the
    # first sign is the checkout sitting on a branch (see _INTERNAL_APP_PREFIXES).
    unregistered = _unregistered_crew_prefix(args.agent)
    if unregistered:
        prefix, role = unregistered
        print(f"error: {args.agent} reads as a crew variant of `{role}`, but `{prefix}` is "
              f"not a registered crew prefix, so it would dispatch as a bare role: into "
              f"the PRIMARY checkout of {repo}, with --pr refused. Register `{prefix}` in "
              f"_INTERNAL_APP_PREFIXES (bin/agentctl) and INTERNAL_APP_PREFIXES "
              f"(lib/agent-platform/review_protocol.py) in the same commit; "
              f"test_agentctl_and_review_protocol_prefixes_match pins the two together.",
              file=sys.stderr)
        return 2, run_id
    if getattr(args, "materialize_from_grant", False):
        if not getattr(args, "issue", None):
            print("error: --materialize-from-grant requires --issue naming the work item "
                  "whose checkout grant supplies the agent's materialization",
                  file=sys.stderr)
            return 2, run_id
        agent = resolve_agent_from_grant(
            args.issue, repo=repo, agent_name=args.agent,
            agents_dir=getattr(args, "agents_dir", None))
    else:
        agent = resolve_agent(args.agent, repo=repo, agents_dir=getattr(args, "agents_dir", None))
    is_local = agent.get("local", False)
    # A repo-local (internal-app) agent has no knowledge-ctx profile: use a sentinel
    # and skip individuation (ARCH-177). Skipping also sidesteps the ARCH-080/135
    # live-process collision that profile individuation can hit.
    profile = args.profile or (f"{repo}/none" if is_local else default_profile(repo, args.agent))
    purpose = derive_purpose(args.agent, args.task, pr=getattr(args, "pr", None))
    # A repo-local agent (CFO's) or a black-box crew's dispatch (ADR-0043) takes no
    # render, and its working files (cfo.db, statements/, taxes/, yearend/) are
    # untracked and gitignored, so a worktree at main would not hold them and the
    # prompts name them by absolute path in the primary. These stay in the primary.
    keeps_primary = purpose is None and (is_local or _is_private_dispatch(repo, agent))

    # P0 guard (2026-07-04): a worktree-class worker with a blank/whitespace --task
    # slips through derive_purpose's `and task` checks to purpose=None, which
    # allocate_worktree resolves to the PRIMARY checkout — a coder committing in the
    # human's clone, the worst failure mode here. The same empty task also hands
    # `claude -p ""` an empty prompt (a startup exit 1). Refuse it before any side
    # effect. `required=True` on --task only enforces the flag's presence, not a
    # non-empty value, so `--task ""` reaches here.
    if _is_worktree_class(args.agent) and not (args.task and args.task.strip()):
        print(f"error: {args.agent} is a worktree-class worker and requires a non-empty "
              f"--task. An empty task would fall back to the primary checkout (a worker "
              f"committing in the human's clone) and hand the model an empty prompt.",
              file=sys.stderr)
        return 2, run_id

    # A model set on the work item this dispatch names (model-lane epic
    # issue_01M35KQ8WTW8R3WSKXS81TV2DZ, slice 2). `spawn --issue` is the one
    # chokepoint every dispatch of a named item passes, the overnight drain's
    # supervisors and a co in session alike. A dispatch with no --issue never
    # reaches the Library here (pinned by a test on the fetch never being called).
    #
    # FAILS CLOSED: an item that cannot be read refuses the dispatch, naming that
    # condition. Proceeding on the roster default would drop an operator's model
    # choice with nothing on any surface saying it happened. The cost is that
    # item-scoped dispatch stops while the Library is down.
    args._item_model_choice = None
    _item_issue = getattr(args, "issue", None)
    if _item_issue:
        _item, _why = _fetch_work_item(_item_issue)
        if _item is None:
            print(f"error: cannot read work item {SC.sanitise(_item_issue, max_len=80)} "
                  f"from the Library ({_why}), so any model set on it is unknown — "
                  f"refused rather than dispatching on the roster default. The refusal "
                  f"leaves any claim the caller holds in place; retry once the Library "
                  f"is reachable.",
                  file=sys.stderr)
            return 2, run_id
        try:
            _item_model = _parse_item_model(_item)
        except _MalformedModelChoice as e:
            print(f"error: work item {SC.sanitise(_item_issue, max_len=80)} holds a "
                  f"malformed model choice ({e}) — refused rather than dispatching on "
                  f"the roster default, which would drop whatever model an operator "
                  f"set. The Library's writer never produces this shape.",
                  file=sys.stderr)
            return 2, run_id
        _default_model = model_id(agent.get("model_alias"))
        # The conflict check sits OUTSIDE the equality test below: an item that
        # chooses the roster default plus a typed, different --model would
        # otherwise skip it and drop the operator's choice with nothing said.
        if (_item_model and args.model
                and model_id(args.model) != model_id(_item_model["model"])):
            print(f"error: --model {SC.sanitise(args.model, max_len=80)} conflicts "
                  f"with the model {SC.sanitise(_item_model['model'], max_len=80)} set "
                  f"on work item {SC.sanitise(_item_issue, max_len=80)}; pass one or "
                  f"the other.", file=sys.stderr)
            return 2, run_id
        if _item_model and model_id(_item_model["model"]) != _default_model:
            _shown = SC.sanitise(_item_model["model"], max_len=80)
            _refusal = _spawn_override_preflight(
                model=model_id(_item_model["model"]), parent=args.parent,
                origin_exempt=True)
            if _refusal is not None:
                print(f"error: work item {SC.sanitise(_item_issue, max_len=80)} "
                      f"carries model {_shown}, set through client "
                      f"{SC.sanitise(_item_model['client'], max_len=80)}, and "
                      f"{_refusal} — refused.", file=sys.stderr)
                return 2, run_id
            # Honoured. `_run_session` reads this to skip the origin refusal
            # and to record the item, client and claimed actor; nothing on the
            # CLI can set it.
            args.model = _item_model["model"]
            args.reason = (_item_model["reason"]
                           or f"model set on {_item_issue} through client {_item_model['client']}")
            args._item_model_choice = _item_model

    # Accountable override (model-lane epic issue_01KZH2GYGTVHFXZ055GEZVH2ZJ): a
    # model-changing --model must carry --reason. Checked here, before any
    # worktree/run-dir side effect, on the same "refuse before any side effect"
    # logic as the --task guard just above — `_run_session` re-checks the origin
    # condition at the actual logging point (it's the invariant; this is the
    # fail-fast UX; slice 1 of issue_01M35KQ8WTW8R3WSKXS81TV2DZ only widens what
    # runs here, not what `_run_session` re-checks).
    if args.model:
        _default_model = model_id(agent.get("model_alias"))
        _override_model = model_id(args.model)
        if _override_model != _default_model:
            # Shared preflight (model-lane epic issue_01M35KQ8WTW8R3WSKXS81TV2DZ,
            # slice 1): all four refusal conditions, checked here, before the
            # detach fork, instead of discovering the credential/reachability
            # ones minutes later inside the detached grandchild
            # (`terminal_reason: spawn_preflight_failed`). See
            # `_spawn_override_preflight`'s docstring for the fixed order and
            # why. Condition 4 (origin) is unchanged: still
            # `_model_override_refusal`, not `_run_origin` directly — see its
            # docstring for why the two must resolve doubt in opposite
            # directions. This does not make the override unforgeable; see
            # that docstring's "what still gets through" section.
            _refusal = _spawn_override_preflight(
                model=_override_model, parent=args.parent,
                origin_exempt=args._item_model_choice is not None)
            if _refusal is not None:
                print(f"error: --model {SC.sanitise(args.model, max_len=80)} changes the "
                      f"resolved model from the roster default ({_default_model}), and "
                      f"{_refusal} — refused. The roster model pin is the control being "
                      f"protected.",
                      file=sys.stderr)
                return 2, run_id
            if not (args.reason and args.reason.strip()):
                print(f"error: --model {args.model} changes the resolved model from the "
                      f"roster default ({_default_model}); pass --reason to explain why.",
                      file=sys.stderr)
                return 2, run_id

    # A Codex run is held to the restrictions of a Claude run, so it is refused
    # before any side effect unless its guards are installed, trusted and
    # unmodified and its model is pinned.
    _codex_model = model_id(args.model or agent.get("model_alias"))
    if is_codex_model(_codex_model):
        _codex_refusal = codex_dispatch_refusal(_codex_model)
        if _codex_refusal is not None:
            print(f"error: refusing to dispatch on Codex model {_codex_model}: "
                  f"{_codex_refusal}", file=sys.stderr)
            return 2, run_id
        # The probe passing lifts the guard refusal, but only for a reviewer: a
        # coder needs a writable sandbox, and keeping CODEX_HOME, the bridge
        # manifest, hooks.json, the shim and the guards outside every writable
        # root is a separate design nothing here builds yet. A Codex slug must
        # never fall through into the `claude --model` spawn below, so this is
        # the one other outcome besides falling through into the shared setup
        # (worktree, run dir, meta) that `_run_session` launches `codex exec`
        # from once it reaches its own Codex branch.
        if not _is_review_agent(args.agent):
            print(f"error: refusing to dispatch {args.agent} on Codex model "
                  f"{_codex_model}: Codex runs only reviewer and security-reviewer "
                  f"dispatches until the writable-sandbox design lands for coders",
                  file=sys.stderr)
            return 2, run_id

    # Pass the agent so a supervisor spawn is checked against the live-supervisor
    # fairness cap here, at the cheap preflight, rather than only at add_run
    # (ARCH-422). Both enforce it; refusing early keeps the message next to the
    # active-runs listing that explains it.
    # `args.agent` is exactly what add_run records as the entry's `agent`
    # (lines 1513/1631/1752), so the preflight and the enforcement agree.
    ok, current, reason = R.can_spawn(args.parent, args.agent)
    if not ok:
        print(f"error: cannot spawn — {reason}. Active runs:", file=sys.stderr)
        for r in current:
            print(f"  {r['run_id']}  {r['agent']:<28}  ({r['repo']})", file=sys.stderr)
        return 2, run_id

    # The Library's tool policy is read here, in the foreground, before the run directory
    # and the worktree exist. The detached grandchild reads it too, but a refusal raised
    # there would come after this process had returned 0 with a run id, so the caller would
    # never see it. `_LIBRARY_DENIALS_MEMO` is filled here and survives the fork, so the
    # run's own reads of the same triple reuse this answer.
    _spawn_override = getattr(args, "model", None)
    _library_denials(args.agent, repo,
                     model_id(_spawn_override) if _spawn_override
                     else model_id(agent.get("model_alias")))

    # Budget gate (3.7) — pre-flight before any worktree side effects.
    gate_exit = _budget_gate(args, agent, repo, profile)
    if gate_exit is not None:
        return gate_exit, run_id

    # PR-awareness (ARCH-347): a run can belong to an EXISTING PR, not a fresh task.
    # `--pr N` binds it, and what that means differs by class:
    #   - review-class: pin to the PR's LIVE head, self-resolved (footgun 2 — no stale
    #     hand-carried --review-sha, which reviewed an already-fixed commit on #941).
    #   - write-class:  commit on the PR's OWN branch, so `publish` pushes the PR and not
    #     an `agent/<new-task-slug>` orphan the PR never points at (footgun 1, #923).
    review_sha = getattr(args, "review_sha", None)
    pr_number = getattr(args, "pr", None)
    pr_branch = None

    if pr_number and review_sha:
        print("error: --pr and --review-sha are mutually exclusive — --pr self-resolves "
              "the PR's live head, so passing a SHA too is ambiguous.", file=sys.stderr)
        return 2, run_id
    if pr_number and not (_is_review_agent(args.agent) or _is_worktree_class(args.agent)):
        print(f"error: --pr is only meaningful for a review- or worktree-class agent "
              f"(one that reviews or commits on the PR), not {args.agent}.", file=sys.stderr)
        return 2, run_id

    # --eval-mode (the review-replay eval harness): refused together with --pr. --pr
    # self-resolves the PR's LIVE head and, for a review-class agent pinned to a PR,
    # routes through `sudo review-launch` once that's installed (`_review_launcher_for`)
    # — which posts the verdict itself, as root, after the session ends. A replay must
    # never post, so it pins with --review-sha (never --pr) and this refusal makes that
    # the only way to reach eval mode, rather than something the harness's own care is
    # left to guarantee.
    if getattr(args, "eval_mode", False):
        if pr_number:
            print("error: --eval-mode and --pr are mutually exclusive — a --pr dispatch "
                  "self-resolves the PR's live head and can route through review-launch, "
                  "either of which a replay must not do. Pin with --review-sha instead.",
                  file=sys.stderr)
            return 2, run_id
        if not _is_review_agent(args.agent):
            print(f"error: --eval-mode is only meaningful for a review-class agent "
                  f"({', '.join(_REVIEW_AGENTS)}), not {args.agent}.", file=sys.stderr)
            return 2, run_id

    # ARCH-346 + knowledge#793 round 6 made `dontAsk` the permission mode of EVERY
    # dispatch, unconditionally, specifically so `run_sandbox`'s file-write scope
    # (the worktree/`/tmp` confinement, the runs-root denyWrite) binds on every run
    # rather than only when a canary env var says so — that scope binds only under
    # `dontAsk`, which requires `TP.MODE_ENFORCE` to resolve, which requires
    # `tool_policy` to have imported. The import is allowed to fail soft (the
    # deploy-window condition at the `try: import tool_policy` above this
    # function), and `_spawn_claude` used to fall back to `bypassPermissions` when
    # it had — the one mode where that file-write scope does not bind at all.
    # Security review, #813 round 4: that fallback reopened the gap for every
    # dispatch, not only an eval one, the moment `tool_policy` doesn't import.
    # Refused here, before any worktree/run-dir side effect, for both eval and
    # non-eval dispatches alike — one check covering both, rather than a second
    # one nested under `eval_mode` the way round 2 first wrote it.
    if TP is None:
        if getattr(args, "eval_mode", False):
            print("error: --eval-mode requires tool_policy, which did not import on "
                  "this machine — the eval allow-list and the forced dontAsk mode both "
                  "live there, and with no policy a dispatch falls back to "
                  "bypassPermissions, where an allow-list blocks nothing. Run install.sh "
                  "to link tool_policy, or dispatch without --eval-mode.", file=sys.stderr)
        else:
            print("error: tool_policy did not import on this machine — the sandbox's "
                  "file-write scope binds only under dontAsk, which requires tool_policy "
                  "to resolve the mode, so no dispatch can run with that scope bound. Run "
                  "install.sh to link tool_policy.", file=sys.stderr)
        return 2, run_id

    if pr_number:
        slug = repo if "/" in repo else f"convivy/{repo}"
        try:
            pr_view = _gh_pr_json(str(pr_number),
                                  ["headRefName", "headRefOid", "state"], repo=slug)
        except (RuntimeError, json.JSONDecodeError) as e:
            print(f"error: --pr {pr_number}: cannot read PR ({e}).", file=sys.stderr)
            return 2, run_id
        if (pr_view.get("state") or "").upper() != "OPEN":
            print(f"error: --pr {pr_number} is {pr_view.get('state') or 'unknown'!r}, not "
                  f"OPEN — refusing to dispatch against a closed/merged PR.", file=sys.stderr)
            return 2, run_id
        pr_branch = pr_view.get("headRefName") or ""
        pr_head = pr_view.get("headRefOid") or ""
        if not pr_branch or not pr_head:
            print(f"error: --pr {pr_number}: gh returned no head branch/oid.", file=sys.stderr)
            return 2, run_id
        if _is_review_agent(args.agent):
            review_sha = pr_head  # self-pin the live head; no manual --review-sha step

    # A live review run for this same PR means one of two things, and both are
    # worth stopping for (ARCH-374). "Same PR" is enforced for the stale case by
    # matching the `pr` recorded in meta.json — repo+agent alone spans every open
    # PR in the repo, which is what made this warn about other sessions' reviews.
    #
    #   SAME sha  — a duplicate dispatch. The run already in flight will post; a
    #               second one is a wasted review and two stamps racing.
    #   OTHER sha — that run is already DEAD. Its stamp will be discarded by
    #               ARCH-193 as a stale replay, because the head moved under it.
    #               It is still burning tokens on a review nobody can accept.
    #
    # The second case is the expensive one and it is invisible without this: the
    # steward hit it three times in one session, each time spending a full review
    # run that the gate then threw away.
    if _is_review_agent(args.agent) and review_sha:
        live = _live_review_runs(repo, args.agent, review_sha)
        same = [r for r in live if r["review_sha"] == review_sha]
        stale = _stale_review_runs(live, review_sha=review_sha, pr_number=pr_number)
        if same and not getattr(args, "force", False):
            ids = ", ".join(r["run_id"] for r in same)
            print(f"error: {args.agent} is ALREADY reviewing {repo} at {review_sha[:9]} "
                  f"({ids}). That run will post its own stamp; a second dispatch is a "
                  f"wasted review. Wait for it, or pass --force if you truly want both.",
                  file=sys.stderr)
            return 2, run_id
        for r in stale:
            print(f"warning: {r['agent']} run {r['run_id']} is still running against "
                  f"{r['review_sha'][:9]}, but the head is now {review_sha[:9]} — its "
                  f"stamp will be DISCARDED as a stale replay (ARCH-193). Kill it so it "
                  f"stops burning tokens on a review nobody can accept:\n"
                  f"  agentctl kill --final {r['run_id']}", file=sys.stderr)

    # Review integrity (ARCH-184): a review-class dispatch pins its worktree to an exact
    # commit so it can never review a stale tree. The SHA comes from `--pr` (above) or a
    # forwarded `--review-sha`. Unpinned review dispatch still warns loudly.
    if _is_review_agent(args.agent) and not review_sha:
        print(f"warning: {args.agent} dispatched WITHOUT --review-sha or --pr — the review "
              f"is not pinned to a commit and may read a stale tree (ARCH-184). Pass --pr N "
              f"(preferred: self-pins the live head) or the SHA from `agentctl publish`.",
              file=sys.stderr)
    if review_sha and not _is_review_agent(args.agent):
        print(f"error: --review-sha is only valid for review-class agents "
              f"({', '.join(_REVIEW_AGENTS)}), not {args.agent}.", file=sys.stderr)
        return 2, run_id

    # CQ·418: this run's own read-only GitHub credential, minted before the worktree is
    # allocated — the first real side effect below — so a minting failure refuses the
    # spawn before anything is checked out. `--dry-run` mints nothing (its own contract:
    # it never spawns a claude process, so nothing downstream ever needs the token) and
    # never calls `_mint_run_github_token`, which is the one function that can reach the
    # network or the App's private key. Never falls back to the operator's own credential
    # on a mint failure — the run simply does not start.
    run_github_token: str | None = None
    if not getattr(args, "dry_run", False):
        run_github_token, _token_problem = _mint_run_github_token(repo)
        if _token_problem is not None:
            print(f"error: cannot mint this run's own GitHub credential — "
                  f"{_token_problem} — refused rather than letting the run reach the "
                  f"operator's git credential helper.", file=sys.stderr)
            return 2, run_id

    try:
        if pr_branch and not _is_review_agent(args.agent):
            # Write-class round-fix: reuse the tree on the PR branch (or create one on
            # it), NOT a fresh task-slug branch. This is the divergence fix (ARCH-347).
            worktree = W.allocate_on_branch(repo, pr_branch)
        elif purpose is None and not keeps_primary:
            # Scout, planner, curator and every other agent outside the dedicated
            # list, except the repo-local and private dispatches above. They used
            # to run in the primary checkout on whatever `.claude` its co had
            # rendered, so they never received their own instructions. Each now
            # gets a detached worktree at the repo's main, which `knowledge-ctx
            # use --agent` renders like any coder's or reviewer's.
            worktree = W.allocate_worktree(
                repo, _detached_main_purpose(args.agent, args.task),
                commit=_detached_main_base(repo))
        else:
            # Not a --pr round-fix (that took the branch above): refuse rather
            # than silently reuse a branch a live PR already points at
            # (issue_01M3P0VPT1T33K4Y5HRFKH90JE).
            refusal = _refuse_open_pr_reuse(args.agent, repo, purpose)
            if refusal:
                print(f"error: {refusal}", file=sys.stderr)
                return 2, run_id
            worktree = W.allocate_worktree(repo, purpose, commit=review_sha)
    except W.WorktreeBusy as e:
        print(f"error: worktree busy — held by {e.holder['run_id']} ({e.holder['agent']})", file=sys.stderr)
        return 2, run_id
    except W.WorktreePinError as e:
        print(f"error: worktree pin failed — {e} (ARCH-184/347: refusing to run on a tree "
              f"that isn't the requested commit/branch, or would lose unlanded work).",
              file=sys.stderr)
        return 2, run_id
    except (ValueError, FileNotFoundError) as e:
        print(f"error: {e}", file=sys.stderr)
        return 2, run_id

    # Before ANY individuation or agent start: strip repo-root instruction
    # files the branch carries. Placed here rather than beside activate_profile
    # so it covers every allocation path above and any future one, and so no
    # code between allocation and the agent can read them either.
    # Only a repo-local or private dispatch still resolves to the primary here,
    # and `suppress_repo_instructions` refuses a primary checkout on its own,
    # because it deletes files.
    _suppressed = suppress_repo_instructions(repo, worktree)
    if _suppressed:
        print(f"worktree: suppressed repo instruction files {_suppressed} "
              f"(dispatched agents are individuated, not repo-instructed)",
              file=sys.stderr)

    claude_md_blocked = None
    render_skipped = None
    _loaded: dict = {}   # filled by activate_profile when knowledge-ctx defaulted
    # A dispatch that resolved to the PRIMARY checkout (`keeps_primary`: a private
    # crew's dispatch that is not repo-local) must not run `knowledge-ctx use
    # --force` there. The primary's `.claude` is the live co's interactive render,
    # and `activate_profile` exempts every ancestor of this shell from the
    # live-process guard, so the co that ran `agentctl spawn` was itself the
    # exempted process and had its session replaced (Bosun co, run-891b01bb,
    # 2026-09-25). `is_primary_checkout` answers True when it cannot tell, so an
    # unresolvable repo also skips the render.
    if not is_local and W.is_primary_checkout(repo, worktree):
        render_skipped = "primary-checkout"
        print(f"spawn: skipped individuating profile {profile} because {worktree} is "
              f"the primary checkout (no worktree was allocated for {args.agent}); "
              f"the run uses whatever .claude the primary already holds.",
              file=sys.stderr)
    elif not is_local:
        claude_md_blocked = activate_profile(worktree, profile, dry_run=args.dry_run,
                         agent=args.agent, issue=getattr(args, "issue", None),
                         allow_default=not args.profile, loaded=_loaded)
        # meta.json records the profile knowledge-ctx actually rendered.
        profile = _loaded.get("profile", profile)

    # Captured HERE, before the agent subprocess exists, not later at
    # finalize time — the worktree stays writable by that subprocess for its
    # entire execution window, so a read taken after it exits could be
    # whatever the run itself left behind rather than what individuation
    # actually gave it (security review, PR #740 round 1; see
    # `_materialized_documents`'s docstring).
    #
    # Gated on the EXACT SAME condition that decided whether `activate_profile`
    # ran above (`is_local`, or `render_skipped` set by the primary-checkout
    # branch) so the two can never drift apart. For either skipped-render
    # class (an is_local agent like CFO/EA, or a private crew's dispatch that
    # resolves to the primary checkout) no render ran THIS dispatch, and
    # `.profile-documents.json` in that checkout — if it exists at all — was
    # written by someone else, usually `bin/co` individuating the primary for
    # the operator's own interactive session. That checkout's own agent subprocess can
    # write to the same file for its whole execution window, so reading it
    # here would record another process's profile — or rows a prior run of
    # this same dispatch class planted — as what THIS run received (security
    # review, PR #740 round 2). The file is never opened in that case.
    #
    # For every OTHER dispatch (the `elif not is_local` branch above, where
    # `activate_profile` did run), gated a second time on
    # `loaded["profile_documents_current"]` rather than on "activate_profile
    # was called" — those are different facts. `--dry-run` reaches that call
    # (`cmd_spawn` passes `args.dry_run` straight through) but
    # `knowledge-ctx use --dry-run` returns before writing or even checking
    # whether the file is current, so the file in the worktree, if present at
    # all, is whatever an EARLIER call into this same worktree left there —
    # a legitimate prior individuation, or a forged plant from a compromised
    # run of it (security review, PR #740 round 4; this is the same class of
    # bug round 2 closed for is_local/primary-checkout, reopened by the one
    # path that condition didn't cover). `profile_documents_current` is False
    # by default (`_loaded` starts `{}`), so any future early return inside
    # `activate_profile`/`individuate()` that forgets to set it fails closed
    # the same way, without needing a new clause here.
    docs_unavailable_reason = None
    if is_local or render_skipped is not None:
        materialized_documents: list[dict] = []
        individuated_agents: list[str] = []
        individuated_skills: list[str] = []
        docs_unavailable_reason = "render skipped for local/private dispatch"
    elif not _loaded.get("profile_documents_current", False):
        materialized_documents = []
        individuated_agents = []
        individuated_skills = []
        docs_unavailable_reason = "render did not produce a current individuation (e.g. --dry-run)"
    else:
        materialized_documents = _materialized_documents(worktree)
        individuated_agents, individuated_skills = _activation_names(worktree)

    if not R.ACTIVE_PATH.exists():
        R.bootstrap()
    run_id = T.new_run_id()
    run_dir = T.create_run_dir(run_id)
    started_at = T.now_iso()

    user_prompt = args.task
    if args.reviewer:
        user_prompt = f"{user_prompt}\n\n(reviewer: {args.reviewer})"
    T.write_prompt(run_dir, system=agent["body"], user=user_prompt)
    T.write_owner_only(run_dir / "started_head.txt", _git_head(worktree) + "\n")
    T.write_owner_only(run_dir / "started_remote.txt", _snapshot_remote_flag(worktree) + "\n")
    T.write_owner_only(run_dir / "started_dirty.txt",
                       "\n".join(sorted(_snapshot_dirty_paths(worktree))) + "\n")
    _baseline_primaries(run_dir, worktree)

    # Written NOW, before the agent subprocess exists (most dispatches detach
    # and fork well after this point — see `_detach_and_run`'s docstring — so
    # this is well ahead of the actual `claude` launch), so a run's
    # `docs_consulted.json` answers for it while it is still live rather than
    # staying absent (and `GET /runs/<id>/docs_given` answering `null`) for a
    # run's whole execution window. Uses the SAME `materialized_documents`/
    # `individuated_agents`/`individuated_skills` just computed above — never
    # re-derived from the worktree a second time — so this write and
    # `_finalize_run`'s later rewrite of the same file agree on the docs list
    # by construction. `queried_at_runtime` is empty here because no tool call
    # has happened yet; `_finalize_run` fills it in from the run's own
    # transcript once the agent has exited.
    T.write_docs_consulted(run_dir, profile=profile,
                           individuated_agents=individuated_agents,
                           individuated_skills=individuated_skills,
                           queried_at_runtime=[],
                           materialized_documents=materialized_documents)

    # Record the PR this write-class run belongs to (ARCH-347), so `publish --run` can
    # verify it pushes the PR's own branch and refuse a divergent one. Best-effort: a
    # stamp failure must not abort a dispatch. (A first coder dispatch has no --pr; its
    # PR link is stamped later by `pr-open`.)
    if pr_number and pr_branch and not _is_review_agent(args.agent):
        try:
            T.write_owner_only(run_dir / "pr-link.json", json.dumps({
                "pr_number": int(pr_number),
                "branch": pr_branch,
                "linked_at": T.now_iso(),
                "linked_by": "agentctl spawn --pr",
            }, indent=2) + "\n")
        except (OSError, ValueError) as e:
            print(f"spawn: pr-link stamp failed (non-fatal): {e}", file=sys.stderr)

    session_kwargs = dict(
        args=args, agent=agent, run_id=run_id, run_dir=run_dir,
        worktree=worktree, profile=profile, repo=repo,
        started_at=started_at, user_prompt=user_prompt,
        # Pass the RESOLVED review pin, not args.review_sha — for a `--pr N` reviewer this
        # holds the self-resolved live head (ARCH-347); _run_session must not re-derive it
        # from args (which is None on the --pr path).
        review_sha=review_sha,
        pr=pr_number,
        claude_md_blocked=claude_md_blocked,
        render_skipped=render_skipped,
        materialized_documents=materialized_documents,
        docs_unavailable_reason=docs_unavailable_reason,
        run_github_token=run_github_token,
    )

    # Detach is the default (P1a, 2026-07-04): a foreground spawn streams and blocks,
    # so a caller with a command timeout (e.g. 120s) SIGTERMs the parent — and its
    # child claude — killing the run mid-stream with nothing committed. Daemonizing by
    # default reparents the worker so a caller timeout can't reach it. `--foreground`
    # restores inline streaming for a caller that deliberately blocks (interactive
    # watching, or a script sequencing stages by the spawn's exit — the launch-*
    # launchers pass it explicitly). `--detach` still works (now implied).
    detach = args.detach or not getattr(args, "foreground", False)
    if detach:
        rc = _detach_and_run(**session_kwargs)
        if rc == 0 and getattr(args, "wait", False):
            # Dispatch stays DETACHED and we block alongside it, rather than
            # running inline. The distinction is the whole point: if the caller's
            # harness kills this waiter — session closed, turn cancelled — the run
            # survives and can be collected later. An inline (`--foreground`) run
            # would die with the caller, trading "the co sat idle" for "closing a
            # co killed its reviewers", which is the worse failure (ARCH-070).
            return _wait_for_runs([run_id], timeout=getattr(args, "wait_timeout", None),
                                  poll=1.0), run_id
        return rc, run_id
    return _run_session(**session_kwargs), run_id


def _on_broken_stream(run_id: str, run_dir: Path, exc: BaseException) -> None:
    """Recover from a transcript-stream write failure (ARCH-253).

    An *inline* spawn (no --detach) whose stdout is a truncating pipe — e.g. the
    overnight orchestrator running `agentctl spawn ... | head -2` — closes that
    pipe early; the next write inside `_stream_transcript` then raises
    BrokenPipeError. Historically only KeyboardInterrupt was caught, so the
    exception propagated past `_finalize_run` + `R.remove_run`, leaving the run
    with `ended_at: null`, a stale registry entry, and an orphaned claude child
    that died on its own SIGPIPE. We log to the run's stderr.log *file* (sys.stderr
    may be the same dead pipe), then repoint sys.stdout/stderr at /dev/null so the
    remaining finalization can never re-raise on another write to the dead pipe.
    """
    try:
        T.write_owner_only(
            run_dir / "stderr.log",
            f"{run_id}: transcript stream ended on {type(exc).__name__}: {exc}\n",
            append=True,
        )
    except OSError:
        pass
    # Close the (likely-broken) originals first so the reader on the other end
    # of the dead pipe gets EOF promptly instead of waiting for CPython GC to
    # drop the fd, then repoint at /dev/null so the rest of finalization can't
    # re-raise on another write.
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.close()
        except (OSError, ValueError):
            pass
    try:
        devnull = open(os.devnull, "w")
        sys.stdout = devnull
        sys.stderr = devnull
    except OSError:
        pass


# How long a Codex reviewer's `codex exec` is given before it is killed. Separate
# from `codex_probe.TIMEOUT_S` (600s, sized for the probe's three-command task):
# a real review reads a diff and writes a verdict, closer in shape to a short
# Claude review than to the probe. No live run has measured this yet (the
# codex-cli is not installed as this lands); tune once one has.
_CODEX_REVIEW_TIMEOUT_S = 1800

# What a Codex reviewer's final message must be: nothing else is read as its
# verdict. `additionalProperties` is left at its default (true) rather than
# pinned False — a model that also names `pr`/`repo`/`reviewed_commit` (it is
# never instructed to) still has those read and checked against the run's own
# pinned target by `_parse_codex_verdict` below, not silently dropped.
_CODEX_VERDICT_SCHEMA = {
    "type": "object",
    "properties": {
        "verdict": {"type": "string", "enum": list(RP.VERDICTS)},
        "body": {"type": "string"},
    },
    "required": ["verdict", "body"],
}


def _codex_review_prompt(agent: dict, agent_name: str, model: str, worktree: Path,
                         repo: str, user_prompt: str) -> str:
    """The single exec prompt a Codex reviewer gets: the same rendered agent
    definition and worktree directive a Claude reviewer's system prompt carries,
    the brief a Claude reviewer's user prompt carries, and — since `codex exec`
    takes one prompt, not a system/user pair — explicit instructions for how to
    end the turn, since nothing else here can call the verdict tool for it."""
    return (
        agent["body"] + worktree_directive(worktree, repo)
        + attribution_directive(model, agent_name)
        + "\n\n## Your task\n\n" + user_prompt
        + "\n\n## How to end this review\n\n"
          "You have no network access and cannot call `agentctl review-post` or any "
          "`gh` command — do not try. When you are done, end your FINAL turn with a "
          "message that is nothing but one JSON object (no markdown fence, no text "
          "before or after it) with exactly these keys:\n"
          '  "verdict": "APPROVE" or "REQUEST_CHANGES"\n'
          '  "body": the review, as markdown, written the way a posted review comment '
          "reads\n"
          "Something else will read this object and post it for you."
    )


def _codex_verdict_fields(data: dict) -> tuple[str, str, dict] | None:
    """(verdict, body, extra) from a parsed verdict object, or None when verdict/body
    are missing, not strings, or body is blank. `extra` carries whichever of
    pr/repo/reviewed_commit the model named (never asked for, but if present it is
    checked, not ignored) — passed to `run_verdict.target_for` so a verdict naming
    another PR, repository or commit is refused rather than posted."""
    verdict, body = data.get("verdict"), data.get("body")
    if not isinstance(verdict, str) or not isinstance(body, str) or not body.strip():
        return None
    extra = {k: data[k] for k in ("pr", "repo", "reviewed_commit")
            if isinstance(data.get(k), str) and data[k].strip()}
    return verdict, body, extra


def _codex_agent_message_texts(events: list[dict]) -> list[str]:
    """Every `agent_message` the event stream carries, in order — the model's own
    words, read only as the fallback source for the verdict object (see
    `_parse_codex_verdict`) when `--output-last-message` produced nothing."""
    texts = []
    for ev in events:
        item = ev.get("item") if isinstance(ev.get("item"), dict) else {}
        if item.get("type") == "agent_message" and isinstance(item.get("text"), str):
            texts.append(item["text"])
        elif ev.get("type") == "agent_message" and isinstance(ev.get("text"), str):
            texts.append(ev["text"])
    return texts


def _parse_codex_verdict(last_message_path: Path, stream_text: str
                         ) -> tuple[tuple[str, str, dict] | None, str | None]:
    """The model's own (verdict, body, extra) (see `_codex_verdict_fields`), read
    from `--output-last-message` first and the LAST `agent_message` in the `--json`
    stream otherwise (that flag, and `--output-schema`, are unconfirmed against a
    real codex-cli — see this change's PR body). Returns `(None, reason)` when
    neither carries one: a missing, unparsable or incomplete verdict is the
    caller's cue to error the run rather than post anything.
    """
    text = None
    source = "the --output-last-message file"
    try:
        text = last_message_path.read_text().strip() or None
    except OSError:
        text = None
    if text is None:
        texts = _codex_agent_message_texts(CP.parse_events(stream_text))
        text = texts[-1].strip() if texts and texts[-1].strip() else None
        source = "the final agent_message in the event stream"
    if text is None:
        return None, ("no --output-last-message file and no agent_message in the "
                      "event stream")
    try:
        data = json.loads(text)
    except ValueError:
        return None, f"{source} is not valid JSON"
    if not isinstance(data, dict):
        return None, f"{source} is not a JSON object"
    fields = _codex_verdict_fields(data)
    if fields is None:
        return None, f"{source} is missing verdict/body"
    return fields, None


def _codex_turn_usage(events: list[dict]) -> dict | None:
    """The `usage` block of the LAST `turn.completed` event, or None when the
    stream carries none (e.g. a run killed before it got that far)."""
    usage = None
    for ev in events:
        if ev.get("type") == "turn.completed" and isinstance(ev.get("usage"), dict):
            usage = ev["usage"]
    return usage


def _run_codex_review_session(*, args: argparse.Namespace, agent: dict, run_id: str,
                              run_dir: Path, worktree: Path, repo: str, profile: str,
                              started_at: str, user_prompt: str,
                              review_sha: str | None, pr: int | str | None,
                              model: str, model_resolved: str, model_choice: str,
                              co_session: str | None, overnight_wave: str | None,
                              issue_val: str | None, dry_run: bool) -> int:
    """Launch a Codex reviewer under its read-only sandbox, wait for it, post its
    verdict dispatcher-side through `run_verdict.post_verdict`, and record its cost
    against the Codex billing lane. Reached only from `_run_session`'s own Codex
    branch, for a dispatch `_spawn_dispatch` already confirmed is review-class with
    a passing conformance probe — see both docstrings for why nothing here
    re-checks either.

    UNREACHABLE THROUGH A NORMAL `_spawn_dispatch` CALL as of PR #821 round 3:
    `codex_dispatch_refusal` now refuses every Codex dispatch regardless of the
    probe (`CODEX_READ_CONFINEMENT_REFUSAL` — no confirmed mechanism confines this
    function's own `codex exec` reads to the worktree). Still reachable directly
    (every test in `tests/test_codex_review_dispatch.py` calls `_run_session`/this
    function, not `cmd_spawn`), which is how the launch mechanics below stay
    covered while the dispatch gate stays closed.

    Shares the run registry (`R.reserve_slot`/`attach_pid`/`remove_run`), the
    worktree a review-class dispatch already pinned to `review_sha`, and the
    meta.json/cost.json/outcome.json shapes every other run uses — `agentctl
    wait`/`status`/`result` read those generically and need nothing Codex-specific
    to work on this run.

    Deliberately narrower than `_run_session`'s Claude path: one launch attempt (no
    `_SPAWN_RETRY_BUDGET_S` back-off — a low-volume trial, not a fleet-wide path),
    no mid-run cost/token cap (a single `codex exec` turn, not an agentic loop that
    can run away the way `_stream_transcript`'s caps exist to catch), no usage-hold
    wait (a Claude subscription-window heuristic that does not apply to Codex's own
    subscription), and no item-override announcement comment. All four are noted in
    the PR body rather than silently absent.
    """
    assert _is_review_agent(args.agent), (
        f"_run_codex_review_session reached for non-review agent {args.agent!r}; "
        f"_spawn_dispatch's Codex gate should have refused this before any side effect")

    if dry_run:
        proc_pid = os.getpid()
        T.write_meta(run_dir, run_id=run_id, agent=args.agent, task=args.task,
                     started_at=started_at, repo=repo, worktree=str(worktree),
                     profile=profile, model=model, pid=proc_pid, label=args.label,
                     parent_run=args.parent, billing_source=_billing_source_for(model),
                     origin=_run_origin(args.parent), review_sha=review_sha,
                     co_session=co_session, overnight_wave=overnight_wave, pr=pr,
                     model_resolved=model_resolved, agent_source=agent.get("source"),
                     model_choice=model_choice, issue=issue_val,
                     held_until=None, hold_reason=None, cost_cap_source="none")
        _record_item_override_meta(run_dir, args)
        try:
            R.add_run({"run_id": run_id, "agent": args.agent, "task": args.task,
                      "started_at": started_at, "repo": repo,
                      "worktree": str(worktree), "pid": proc_pid,
                      "label": args.label, "parent_run": args.parent})
        except R.ConcurrencyError as e:
            T.update_meta(run_dir, ended_at=T.now_iso())
            T.write_outcome(run_dir, exit_status="capacity_refused",
                            error_reason=f"{e} — dry run, lost the concurrency race")
            print(f"error: lost concurrency race: {e}", file=sys.stderr)
            return 2
        print(f"[dry-run] would launch `codex exec` for {run_id}  agent={args.agent}  "
              f"model={model}  worktree={worktree}", file=sys.stderr)
        T.write_outcome(run_dir, exit_status="completed")
        T.write_cost(run_dir, by_model={}, cost_source="codex_turn_usage")
        R.remove_run(run_id)
        return 0

    home = CB.codex_home()
    codex_bin = shutil.which("codex") or "codex"
    schema_path = run_dir / "codex-verdict-schema.json"
    T.write_owner_only(schema_path, json.dumps(_CODEX_VERDICT_SCHEMA) + "\n")
    last_message_path = run_dir / "codex-last-message.json"
    prompt = _codex_review_prompt(agent, args.agent, model, worktree, repo, user_prompt)
    argv = CP.launch_argv(model, worktree, codex_bin, task=prompt,
                          output_last_message=last_message_path,
                          output_schema=schema_path)
    # `probe_env` allowlists to PATH/HOME/USER/etc (never GH_TOKEN/GITHUB_TOKEN
    # to begin with); `git_credential_guard_env` layers on the same GH_CONFIG_DIR/
    # GIT_CONFIG_*/GIT_TERMINAL_PROMPT redirection the Claude dispatch lane gets
    # (dispatch_env's own docstring, CQ·418) and strips either var explicitly —
    # this lane never mints a token (a Codex review has no network and posts
    # nothing itself), so github_token stays None.
    env = DE.git_credential_guard_env(CP.probe_env(dict(os.environ), home))
    # The REAL run id, not probe_env's synthetic `codex-probe-<ts>` one — so
    # block-pr-merge.sh and every other guard keyed on AGENTCTL_RUN_ID bind this
    # run the same way they bind a Claude dispatch (codex_bridge.verify, the
    # conformance probe this dispatch's gate already required to have passed).
    env["AGENTCTL_RUN_ID"] = run_id

    T.write_meta(run_dir, run_id=run_id, agent=args.agent, task=args.task,
                 started_at=started_at, repo=repo, worktree=str(worktree),
                 profile=profile, model=model, pid=None, label=args.label,
                 parent_run=args.parent, billing_source=_billing_source_for(model),
                 origin=_run_origin(args.parent), review_sha=review_sha,
                 co_session=co_session, overnight_wave=overnight_wave, pr=pr,
                 model_resolved=model_resolved, agent_source=agent.get("source"),
                 model_choice=model_choice, issue=issue_val,
                 held_until=None, hold_reason=None, cost_cap_source="none")
    _record_item_override_meta(run_dir, args)
    T.update_meta(run_dir, dispatcher_pid=os.getpid())

    try:
        R.reserve_slot({"run_id": run_id, "agent": args.agent, "task": args.task,
                       "started_at": started_at, "repo": repo,
                       "worktree": str(worktree), "parent_run": args.parent})
    except R.ConcurrencyError as e:
        T.update_meta(run_dir, ended_at=T.now_iso())
        T.write_outcome(run_dir, exit_status="capacity_refused", error_reason=str(e))
        print(f"error: cannot spawn — {e}", file=sys.stderr)
        return 2

    stderr_path = run_dir / "stderr.log"
    try:
        proc = subprocess.Popen(argv, cwd=str(worktree), env=env, text=True,
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=T.open_owner_only(stderr_path, append=True))
    except OSError as exc:
        T.update_meta(run_dir, ended_at=T.now_iso())
        T.write_outcome(run_dir, exit_status="errored",
                        error_reason=f"codex exec failed to start: {exc}")
        R.remove_run(run_id)
        print(f"error: codex exec failed to start: {exc}", file=sys.stderr)
        return 2

    T.update_meta(run_dir, pid=proc.pid)
    R.attach_pid(run_id, proc.pid, pid_started_at=_pid_start_time(proc.pid),
                dispatcher_pid=os.getpid(),
                dispatcher_pid_started_at=_pid_start_time(os.getpid()))
    print(f"spawned {run_id}  pid={proc.pid}  agent={args.agent}  worktree={worktree}",
          file=sys.stderr)

    timed_out = False
    try:
        stream_text, _ = proc.communicate(timeout=_CODEX_REVIEW_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        proc.kill()
        stream_text, _ = proc.communicate()
        timed_out = True
    T.write_owner_only(run_dir / "events.jsonl", stream_text or "")

    events = CP.parse_events(stream_text or "")
    fields, parse_error = (None, "the run timed out and was killed") if timed_out \
        else _parse_codex_verdict(last_message_path, stream_text or "")

    exit_status, error_reason = "errored", parse_error
    if fields is not None:
        verdict, body, extra = fields
        T.write_owner_only(run_dir / "transcript.jsonl",
                           json.dumps({"type": "result", "result": body},
                                      separators=(",", ":")) + "\n")
        try:
            target, done = RV.post_verdict(
                run_id, verdict, body, agentctl=Path(__file__).resolve(),
                pr=extra.get("pr"), repo=extra.get("repo"),
                reviewed_commit=extra.get("reviewed_commit"))
        except RV.Refused as e:
            error_reason = f"verdict refused: {e}"
        else:
            if done.returncode == 0:
                exit_status, error_reason = "completed", None
            else:
                error_reason = (f"review-post exited {done.returncode}: "
                                f"{done.stderr.strip()}")

    usage = _codex_turn_usage(events)
    by_model = T.cost_from_codex_usage(model, usage) if usage is not None else {}
    T.write_cost(run_dir, by_model=by_model, cost_source="codex_turn_usage")
    T.update_meta(run_dir, ended_at=T.now_iso())
    T.write_outcome(run_dir, exit_status=exit_status, error_reason=error_reason)
    R.remove_run(run_id)
    _reap_review_worktree(args.agent, worktree, run_id)
    return 0 if exit_status == "completed" else 1


def _run_session(*, args: argparse.Namespace, agent: dict, run_id: str,
                 run_dir: Path, worktree: Path, profile: str, repo: str,
                 started_at: str, user_prompt: str,
                 review_sha: str | None = None, pr: int | str | None = None,
                 claude_md_blocked: tuple[str, str] | None = None,
                 render_skipped: str | None = None,
                 materialized_documents: list[dict] | None = None,
                 docs_unavailable_reason: str | None = None,
                 run_github_token: str | None = None) -> int:
    """Long-running session work. Called in the foreground process for plain
    spawn, or in the daemonized grandchild for --detach.

    `run_github_token` is this run's own per-run convivy-bosun installation token
    (CQ·418), minted once in `_spawn_dispatch` before any side effect and threaded
    through from there — never minted again here, so a fail-over respawn inside this
    same run (`_respawn_in_place`, below) reuses the same token rather than minting a
    second one. `None` only for `--dry-run` (which never reaches `_spawn_claude` at
    all) or a direct caller — e.g. a test — that passes none.

    Writes meta + registers with the run's PID, launches claude (or the
    dry-run stub), streams the transcript, finalizes artifacts, and
    deregisters. Returns the exit code.

    `claude_md_blocked` is `activate_profile`'s `(path, reason)` return value,
    threaded through from `cmd_spawn` — `activate_profile` runs before
    `run_dir` exists, so it can't record the outcome itself; this is the
    first point after `write_meta` (below) where `meta.json` is on disk for
    `T.update_meta` to read-modify-write.

    `materialized_documents` is `_materialized_documents(worktree)`'s result,
    also threaded through from `cmd_spawn`/`_spawn_dispatch` rather than
    computed here, for the same reason `claude_md_blocked` is: it must be
    read before the agent subprocess this function launches below ever
    starts, never after (see `_finalize_run`'s docstring).

    `docs_unavailable_reason` is set (to a fixed string) by `_spawn_dispatch`
    exactly when `materialized_documents` was forced to `[]` because no
    render ran for this dispatch (an is_local agent or a private crew's
    dispatch) — recorded onto meta.json below so a run with an empty `docs`
    list in its `docs_consulted.json` is distinguishable from one whose
    render genuinely produced no documents."""
    # The model is deterministic from the agent's roster `model:` field (ARCH-135),
    # NOT chosen by the dispatching session — that's what holds it against drift.
    # `--model` is the explicit per-dispatch override (ARCH-188); it's logged so a
    # co leaning on the override (defeating the cheaper default) surfaces in
    # #alerts-agent-cost-perf.
    default_model = model_id(agent.get("model_alias"))
    override = getattr(args, "model", None)
    # The item-override announcement, held until the session has launched (see
    # the call after `_spawn_claude`): a comment saying "ran on <model>" must not
    # exist for a run that never started.
    _pending_item_announce = None
    if override:
        model = model_id(override)
        # A `--model` that resolves to the SAME model as the roster default is a
        # no-op, not a real override: it defeats nothing and has no cost/perf
        # impact, so it must not count toward the ARCH-188 budget. Without this,
        # a redundant `--model sonnet` on a sonnet-default agent trips a false
        # alert (22 such sous-chef dispatches did on 2026-06-27). Only a
        # model-CHANGING override is logged.
        if model != default_model:
            # Accountable override (model-lane epic issue_01KZH2GYGTVHFXZ055GEZVH2ZJ):
            # a model-changing override must carry a reason. An interactive co can
            # always type one, so this is mild friction there; an autonomous caller
            # that passes no --reason has nobody to supply one, so it's refused
            # outright rather than quietly defeating the roster pin.
            #
            # Refused outright, with no reason able to rescue it, when the origin
            # this spawn will be STAMPED with (not `_own_origin` — a chain rooted in
            # a human `co` session stays permitted through every worker it dispatches,
            # because the human is who is accountable for it) is one of the capped/
            # autonomous origins. There is deliberately no caller-supplied escape
            # hatch (no --hard-ground flag, no magic --reason string): on an
            # autonomous run nobody is present to compose one, so any ground the
            # CALLER names is attacker-controlled input past a denylist — the same
            # shape platform/decisions/0051 recorded block-pr-merge.sh losing to
            # (five of nine bypass shapes got past a denylist over caller input).
            # The only hard ground recognized is the platform's OWN mechanism,
            # which does not arrive as `--model`: `fallback_model_for` (ARCH-131,
            # a harness respawn on abnormal death) — it runs after this point, on
            # `model`/`default_model` directly, never through this override gate,
            # so this refusal cannot block it.
            origin = _run_origin(args.parent)
            # Fail-closed refusal check (security-reviewer finding on PR #476):
            # `_model_override_refusal`, not `origin` above, decides whether to
            # refuse — see its docstring for why the two must resolve doubt in
            # opposite directions. `origin` itself stays `_run_origin`'s value,
            # since it's also what gets STAMPED into the log below on the
            # permitted path, and the two agree whenever nothing refuses. This
            # does not make the override unforgeable; see that docstring's
            # "what still gets through" section.
            # A model choice read off the work item (`_spawn_dispatch`, slice 2)
            # was written through a Library route no agent credential can
            # reach, so it skips this origin refusal. Only that in-process
            # record does; a typed `--model` never reaches it.
            _choice = getattr(args, "_item_model_choice", None)
            _refusal = None if _choice else _model_override_refusal(args.parent)
            if _refusal is not None:
                raise SystemExit(
                    f"--model {SC.sanitise(override, max_len=80)} changes the resolved "
                    f"model from the roster default ({default_model}), and {_refusal} "
                    f"— refused. The roster model pin is the control being protected; "
                    f"no human is present on an autonomous run to answer for a "
                    f"caller-supplied override."
                )
            reason = getattr(args, "reason", None)
            if not (reason and reason.strip()):
                raise SystemExit(
                    f"--model {override} changes the resolved model from the roster "
                    f"default ({default_model}); pass --reason to explain why."
                )
            reason = reason.strip()
            if _choice:
                _log_model_override(agent=args.agent, repo=repo, model=model,
                                    origin=origin, run_id=run_id, reason=reason,
                                    issue=getattr(args, "issue", None),
                                    actor=_item_override_actor(_choice),
                                    channel=_item_override_channel(_choice))
                if not args.dry_run:
                    _pending_item_announce = dict(
                        issue=args.issue, run_id=run_id, agent=args.agent, repo=repo,
                        model=model, client=_choice["client"],
                        actor=_item_override_actor(_choice), reason=reason)
            else:
                _log_model_override(agent=args.agent, repo=repo, model=model,
                                    origin=origin, run_id=run_id, reason=reason)
    else:
        model = default_model
    # How the model above was chosen (model-lane epic issue_01M174CH86JBCP7291PS0TM097,
    # issue_01M3NTZP9W8WEYWVERW2F9NARP): recorded onto meta.json so the Archives
    # record written at finalize can name the mechanism rather than a boolean.
    # `harness_fallback` below can still override this — a fail-over is the last
    # word on what model actually ran, whatever the spawn asked for.
    #
    # Most specific wins: an item-sourced override (read off `_item_model_choice`,
    # set through the Library's client-gated route) is `item_override` even when
    # CLAUDECODE is also set, since a co relaying a work item's choice didn't
    # choose it itself. Otherwise a model-changing --model is `co_override` when
    # this process's own environment carries CLAUDECODE (an agent session
    # dispatched it) and `typed_override` when it doesn't — a person at a
    # terminal, claimed rather than proven.
    _item_choice = getattr(args, "_item_model_choice", None)
    if not (override and model != default_model):
        model_choice = "roster_default"
    elif _item_choice:
        model_choice = "item_override"
    elif _dispatch_is_from_a_co_session():
        model_choice = "co_override"
    else:
        model_choice = "typed_override"
    # The model the roster resolved AT SPAWN (ARCH-378), captured here before
    # ARCH-131's fail-over can reassign the `model` local to whatever it
    # respawned onto — `model_resolved` must keep naming what was asked for,
    # not what actually ran. Threaded into `_finalize_run` below so the
    # harness's own restamp (not a re-read of the subprocess-writable
    # meta.json) is what `model_resolved` gets pinned to at finalize.
    model_resolved = model

    # Pinned review commit (ARCH-184), persisted to meta.json so the authenticity
    # gate (ARCH-193) can bind a posted stamp to the run that produced it. NOTE: do NOT
    # re-read this from args here — `review_sha` is already resolved above, and for a
    # `--pr N` reviewer it holds the SELF-RESOLVED live head (ARCH-347). Re-reading
    # args.review_sha (None on the --pr path) silently dropped that head from meta + the
    # reviewer's AGENTCTL_REVIEW_SHA env.
    co_session = _co_session(args.parent)
    overnight_wave = _overnight_wave()
    # Sanitised once, here, and reused for both write_meta calls below and for
    # _finalize_run's restamp — meta.json's `issue` is the source of truth
    # several other things (the Archives record, a future cost-attribution
    # join) now read back, so it gets the same treatment `_log_model_override`
    # already applies to `reason`, at the point it first lands rather than
    # only where it's posted (security review, PR #477 round 3).
    raw_issue = getattr(args, "issue", None)
    issue_val = SC.sanitise(raw_issue, max_len=200) if raw_issue else None

    # A Codex reviewer has none of what follows below: no Claude Code tool policy
    # (ARCH-346), no private object store (its sandbox cannot write a git object),
    # no ARCH-131 cross-provider fail-over, no `claude -p` stream-json transcript.
    # `_spawn_dispatch`'s own Codex gate (`codex_dispatch_refusal` + the
    # review-class check) already refused everything this branch does not cover,
    # so reaching here with `is_codex_model(model)` true means a review-class
    # dispatch whose probe passed — see `_run_codex_review_session`.
    if is_codex_model(model):
        return _run_codex_review_session(
            args=args, agent=agent, run_id=run_id, run_dir=run_dir, worktree=worktree,
            repo=repo, profile=profile, started_at=started_at, user_prompt=user_prompt,
            review_sha=review_sha, pr=pr, model=model, model_resolved=model_resolved,
            model_choice=model_choice, co_session=co_session, overnight_wave=overnight_wave,
            issue_val=issue_val, dry_run=args.dry_run)

    # ARCH-346: resolve THIS runtime's policy, and record it whether or not it is
    # enforced. The record is the point: "what could this run do" stops being an
    # inference from a field whose meaning depends on the runtime, and becomes a fact
    # written next to the run. Recording is unconditional; enforcement is gated.
    # A soft-failed import degrades to the pre-ARCH-346 behaviour (bypass, no record)
    # rather than taking the fleet down; see the import block at the top. Each spawn
    # resolves its own policy again (`_spawn_claude`), so a fail-over is recorded too.
    policy = _resolve_run_policy(args.agent, repo, agent, model_resolved,
                                 eval_mode=getattr(args, "eval_mode", False))
    _write_policy(run_dir, policy,
                  denials_applied=_review_launcher_for(args.agent, pr) is None)

    # Round 6 (knowledge#793): this run's own private object store, computed once here so
    # both the claude launch below and the post-exit import (right before _finalize_run)
    # share the same path. None when `worktree` isn't a git checkout at all (a non-repo
    # agent, or a test) — nothing in this run needs the object-store redirect then.
    git_dir = RS.git_common_dir(worktree)
    private_objects_dir = RS.run_private_objects_dir(worktree, git_dir) if git_dir else None
    # A dry run never touches the worktree (its own contract, _finalize_run's docstring) —
    # the directory must exist before spawn for git to write into it, but dry-run never
    # spawns, so it must not create it either.
    if private_objects_dir is not None and not args.dry_run:
        private_objects_dir.mkdir(parents=True, exist_ok=True)

    # Usage hold (issue_01M3PZ6J0D55EFC8GGAYMN9SH4): operator, 2026-09-29, "no to
    # extra usage on autonomous work". A fresh dispatch into a five-hour window
    # at or past 0.9 utilization, or a weekly window at or past 0.99 (operator,
    # 2026-10-08), or a five-hour window already spending from overage, waits
    # for that window to reset rather than run into billed extra usage. Weekly
    # overage does not hold: see `_rate_limit_hold_decision`. A `--pr` run
    # (round fix or review) is exempt from the five-hour utilization threshold
    # only; it still holds on five-hour overage, and the weekly threshold holds
    # every dispatch, `--pr` runs included (see `_rate_limit_hold_decision`).
    # `--dry-run` reports what it would do and does not wait, per its own
    # contract; it is decided here, synchronously, since dry-run's own meta
    # write (right below) is the only place that needs it. The REAL wait,
    # below, happens later — see its own
    # comment for why the placement is load-bearing.
    held_until = None
    hold_reason = None
    # Set here, before the dry-run/real-dispatch split, because a dry run never
    # reaches the `else` branch below (where the real one is set from
    # `_stream_transcript`'s return) but still flows into `_finalize_run` past
    # the end of this `if`/`else` — and a dry run never spawns a subprocess, so
    # the cap can never fire.
    cost_stop_reason: str | None = None
    if args.dry_run:
        dry_run_now = datetime.now(timezone.utc)
        decision = _usage_hold_decision(dry_run_now, pr_round_fix=pr is not None)
        if decision is not None:
            held_until_dt, hold_reason = decision
            held_until = held_until_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
            print(f"[dry-run] would hold until {held_until} — {hold_reason}",
                  file=sys.stderr)
        proc_pid = os.getpid()  # the agentctl process IS the run in dry-run
        T.write_meta(run_dir, run_id=run_id, agent=args.agent, task=args.task,
                     started_at=started_at, repo=repo, worktree=str(worktree),
                     profile=profile, model=model, pid=proc_pid, label=args.label,
                     parent_run=args.parent, billing_source=_billing_source_for(model),
                     origin=_run_origin(args.parent), review_sha=review_sha, co_session=co_session,
                     overnight_wave=overnight_wave, pr=pr,
                     model_resolved=model_resolved, agent_source=agent.get("source"),
                     model_choice=model_choice, issue=issue_val,
                     held_until=held_until, hold_reason=hold_reason,
                     cost_cap_source=_run_cost_cap_for_agent(model, agent)[1])
        _record_item_override_meta(run_dir, args)
        if getattr(args, "eval_mode", False):
            # Audit trail only (round-2 revise, agent-platform#813): nothing in
            # `cmd_review_post` or any other gate reads this field back. The
            # guarantee that an eval replay never posts is the permission layer
            # (`tool_policy.resolve`'s eval branch, forced `dontAsk`), not a
            # record the run's own `Write` tool could later edit.
            T.update_meta(run_dir, eval_mode=True)
        if claude_md_blocked is not None:
            T.update_meta(run_dir, claude_md_blocked_path=claude_md_blocked[0],
                          claude_md_blocked_reason=claude_md_blocked[1])
        if render_skipped is not None:
            T.update_meta(run_dir, profile_render_skipped=render_skipped)
        if docs_unavailable_reason is not None:
            T.update_meta(run_dir, docs_unavailable_reason=docs_unavailable_reason)
        try:
            R.add_run({"run_id": run_id, "agent": args.agent, "task": args.task,
                       "started_at": started_at, "repo": repo,
                       "worktree": str(worktree), "pid": proc_pid,
                       "label": args.label, "parent_run": args.parent})
        except R.ConcurrencyError as e:
            # Record the refusal, like every other path that gives up after
            # write_meta. This one returned bare, leaving a run directory with a
            # meta.json and no outcome.json — indistinguishable, from outside,
            # from a run whose process vanished mid-flight, which is exactly what
            # `run-observer` reports. Found by tracing every write_meta call site
            # for paths that leave no outcome (reviewer, PR #451).
            T.update_meta(run_dir, ended_at=T.now_iso())
            T.write_outcome(run_dir, exit_status="capacity_refused",
                            error_reason=f"{e} — dry run, lost the concurrency race")
            print(f"error: lost concurrency race: {e}", file=sys.stderr)
            return 2
        print(f"[dry-run] spawned {run_id}  agent={args.agent}  worktree={worktree}", file=sys.stderr)
        fake_lines = [
            {"type": "system", "subtype": "init", "model": model},
            {"type": "assistant", "message": {"content": [{"type": "text", "text": "[dry-run output]"}]}},
            {"type": "result", "subtype": "success", "model": model,
             "usage": {"input_tokens": 100, "output_tokens": 5, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0},
             "total_cost_usd": 0.0},
        ]
        with (run_dir / "transcript.jsonl").open("a") as f:
            for ev in fake_lines:
                f.write(json.dumps(ev, separators=(",", ":")) + "\n")
        final_event = fake_lines[-1]
        exit_code = 0
    else:
        stderr_path = run_dir / "stderr.log"
        # Created once per dispatch (round 8, agent-platform#813 round 7 finding),
        # before this run's claude ever starts, and never recorded anywhere a
        # sibling run could read — see `RS.create_eval_scratch_dir`'s docstring.
        # None for a non-eval dispatch. `_spawn_claude` reads this same local on
        # every call, so an ARCH-131 fail-over respawn reuses the one directory
        # this dispatch was given rather than getting a second one.
        eval_scratch_dir = (RS.create_eval_scratch_dir()
                            if getattr(args, "eval_mode", False) else None)

        # Fleet-block decision (round 3 of #823, reviewer): taken exactly ONCE,
        # before any subprocess exists, and reused — never recomputed — by
        # every spawn AND respawn below. `_spawn_claude` used to call
        # `_fleet_blocks_confirmed_in_claude_md` itself, which re-read this
        # worktree's own `.claude/CLAUDE.md` on every ARCH-131 fail-over
        # respawn too — after the subprocess that just died had write access
        # to that same file, breaking the function's own invariant that it
        # reads before any subprocess exists. If the fleet check declines at
        # the first spawn, every respawn of this dispatch keeps the user
        # CLAUDE.md, even if the file changes in between.
        fleet_delivered, fleet_undelivered_reason = _fleet_blocks_confirmed_in_claude_md(
            worktree=worktree, claude_md_blocked=claude_md_blocked,
            docs_unavailable_reason=docs_unavailable_reason,
            materialized_documents=materialized_documents)

        def _spawn_claude(spawn_model: str) -> subprocess.Popen:
            nonlocal policy
            # ROUTING (platform/decisions/0090): a review-class run pinned to a PR
            # goes through `sudo review-launch` instead of a direct `claude -p`
            # the moment the launcher is installed — see `_review_launch_path`'s
            # docstring for why presence-on-disk is the one signal every caller
            # shares. `pr` (not `review_sha`) gates this: the launcher re-resolves
            # the PR itself from `--pr`/`--repo`, so there is nothing to route
            # without one. Until the launcher exists on this machine, this branch
            # is never taken and every review-class run keeps dispatching exactly
            # as it does today — the `claude -p` build below, unchanged.
            _launcher = _review_launcher_for(args.agent, pr)
            # Resolved for the model this spawn runs. A fail-over respawn runs a
            # different model, and its denials and grants are that model's, so the
            # policy recorded in policy.json is rewritten here on every spawn.
            policy = _resolve_run_policy(args.agent, repo, agent, spawn_model,
                                         eval_mode=getattr(args, "eval_mode", False))
            _write_policy(run_dir, policy, denials_applied=_launcher is None)
            if _launcher is not None:
                cmd = _review_launch_cmd(_launcher, repo=repo, pr=pr,
                                         role=args.agent, run_id=run_id)
                # `sudo`'s own `env_reset` (platform/specs/builder-runs-as-two-
                # accounts Handoff: "Sudo rule ... env_reset kept") is the real
                # boundary here — whatever is passed below never reaches the
                # launcher's environment. AGENTCTL_RUN_ID is kept only so a `ps`
                # on the dispatcher side can still identify which run a stray
                # `sudo` process belongs to.
                #
                # `stdin=subprocess.DEVNULL` (round 2 of #732, finding 1): this
                # process (running as `agents`) is the "sudo caller" the
                # launcher's own session must never inherit anything from —
                # without this, whatever sits on THIS process's own stdin would
                # flow through `sudo` into `review-launch` unchanged, and from
                # there into `claude -p` if its adapter did not also close it
                # (see `bin/review-launch`'s `ClaudeSession.run`). Closed here
                # too so the chain holds even if that adapter regresses.
                return subprocess.Popen(
                    cmd, cwd=str(worktree),
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=T.open_owner_only(stderr_path, append=True),
                    env={"AGENTCTL_RUN_ID": run_id},
                )
            # ARCH-346 + knowledge#793 round 6: the permission MODE is the enforcement
            # lever, not a flag on top of it, and every run is now `dontAsk` — a
            # file-write scope (run_sandbox's `permissions.allow`, below) can bind only
            # under a mode that refuses what no allow rule names; bypassPermissions
            # allows every write, and no deny list carves the worktree out of that.
            # `enforcing` below decides only whether the tool-policy allow-list is ALSO
            # passed (--allowedTools) — for an eval dispatch (agent-platform#813) that
            # allow-list is the entire "never post" guarantee, since `eval_mode` no
            # longer has to force the mode itself. `TP is None` never reaches here: the
            # same `_spawn_dispatch` preflight that refuses an eval dispatch when
            # `tool_policy` didn't import refuses every OTHER dispatch too (security
            # review, #813 round 4) — there is no remaining caller that can get this far
            # with `TP is None`, so unlike before round 4, this does not fall back to
            # `bypassPermissions`.
            eval_mode = getattr(args, "eval_mode", False)
            eval_directive = _eval_mode_system_prompt(eval_scratch_dir) if eval_mode else ""
            enforcing = bool(policy is not None
                             and policy.enforced and (eval_mode or _enforce_tool_policy()))
            mode = TP.MODE_ENFORCE
            # The Claude Code sandbox and the grant-file denial (Option A, Slate a-ow0q4o).
            # It sits before --disallowedTools (the `--model` ordering guards) and before
            # the prompt, which `--` below keeps positional.
            # `fleet_delivered`/`fleet_undelivered_reason`: the ONE decision taken above,
            # before any subprocess of this dispatch existed — never recomputed here, so a
            # respawn can never act on a CLAUDE.md the previous attempt's subprocess had
            # write access to. See that decision's own comment and
            # `_fleet_blocks_confirmed_in_claude_md`'s docstring. `eval_scratch_dir`
            # (round 8) confines an eval dispatch's write grant to its own directory
            # instead of the shared temp root every other dispatch still gets — see
            # run_sandbox.settings's own docstring for why.
            if not fleet_delivered:
                _log_stream_note(
                    run_dir,
                    f"agentctl: keeping the user CLAUDE.md loaded — {fleet_undelivered_reason}\n")
            sandbox_json = RS.settings_json(
                home=RS.passwd_home(), worktree=worktree, runs_root=RUNS_ROOT,
                git_dir=git_dir, exclude_user_claude_md=fleet_delivered,
                eval_scratch_dir=eval_scratch_dir, repo=repo)
            # The verdict server (knowledge#793): Claude starts it outside the sandbox with
            # this run's id in its launch environment. The run's Bash cannot read the
            # review-record credential, so its verdict goes through this server. Folded
            # into the combined `--mcp-config` below, not its own flag — see that
            # comment for why.
            verdict_server = Path(__file__).resolve().parent / "mcp-verdict-server"
            cmd = [
                CLAUDE_BIN, "-p",
                "--output-format", "stream-json",
                "--verbose",
                "--permission-mode", mode,
                "--settings", sandbox_json,
            ]
            # Tool lockdown (ARCH-064 + ARCH-246): hard-deny review/sub-agent tools
            # to the agents that mustn't have them. Applied before --model so the
            # flag's greedy arg consumption stops at --model, not the prompt.
            disallowed = _disallowed_tools(args.agent, repo, agent, model=spawn_model,
                                           eval_mode=getattr(args, "eval_mode", False))
            if disallowed:
                cmd += ["--disallowedTools", *disallowed]
            # `_is_private_dispatch`/`_mcp_servers_for_policy` resolved together here,
            # ahead of both the --tools and --mcp-config decisions below, because
            # --tools' own safety depends on the answer (see the trap comment right
            # below this one).
            #
            # NO AGENT MAY LOSE A TOOL ITS OWN DEFINITION GRANTS (round 1 of this PR,
            # #811: narrowing on `policy.allowed` alone cut `kb` from every
            # `reviewer`/`security-reviewer`/`planner`/`platform-planner`/`scout` dispatch,
            # though each one's own roster `tools:` line grants a `mcp__kb__` tool and
            # `tool_policy.py`'s `_READ_SURFACE` grants none — making the ADR check both
            # the roster and the security-review rubric instruct impossible on every
            # dispatch today, not only once live enforcement turns on). `agent["tools"]` is
            # the SAME resolved list `_disallowed_tools`/`resolve_agent` already carry here,
            # not re-read; passing it into both narrowing functions is the union fix.
            # `_resolved_agent_tools` (round 2 of this PR, #811) refuses rather than
            # unioning a malformed shape — see its own docstring.
            agent_tools = _resolved_agent_tools(agent, args.agent)
            agent_builtins = _resolved_agent_builtins(agent, args.agent)  # CQ·426
            is_private = _is_private_dispatch(repo, agent)
            mcp_servers = None if is_private else _mcp_servers_for_policy(policy, agent_tools)
            # Tool SURFACE, not permission (issue_01M4BT13RP23KRTA80VM6R7HNF): `--tools`
            # controls which built-ins Claude Code loads a schema for at all, independent
            # of `--permission-mode` — a bypassPermissions run still only needs the
            # built-ins its policy actually names. `None` (no real allow-list to read)
            # passes no flag, keeping today's full built-in surface; placed before
            # --model for the same greedy-arg-consumption reason as the flags around it.
            #
            # THE TRAP, AND WHY `ToolSearch` CLOSES IT (one-turn `claude -p` A/B, same
            # policy, same synthetic system prompt, in an empty dir, Claude Code 2.1.293,
            # first-party Anthropic endpoint — no gateway, no custom `ANTHROPIC_BASE_URL`).
            # Restricting `--tools` while at least one MCP server is still attached via
            # `--mcp-config` disables Claude Code's deferred tool-loading for THAT SERVER
            # IF `--tools` omits `ToolSearch` — Claude Code then has no way to defer, and
            # loads every one of the server's tool schemas in full, net LARGER than not
            # restricting `--tools` at all: a reviewer-shaped policy with only the `ops`
            # server attached measured 41,623 first-turn tokens with `--tools` restricted
            # to its built-ins alone, against 38,944 for the same `ops` server with no
            # `--tools` restriction.
            #
            # Adding `ToolSearch` to the restricted set reopens deferral and the trap does
            # not fire: the same reviewer-shaped policy, `--tools` restricted to its
            # built-ins PLUS `ToolSearch`, measured 14,786 — below the 38,944 unrestricted
            # baseline, not above it. A coder-shaped built-in surface (14 built-ins, a
            # broader set than reviewer's 5) measured 15,287 restricted-plus-`ToolSearch`
            # against 23,641 unrestricted — the mechanism isn't reviewer-specific. Measured
            # the same way with `ENABLE_TOOL_SEARCH=true` added on top of `ToolSearch`:
            # 14,784 / 15,288 — no material difference, because deferred tool-loading is
            # already on by default once `ToolSearch` is in the tool list, on a first-party
            # endpoint with no custom base URL (the 2.1.293 binary's own embedded
            # settings-reference text: "Claude API ... with no custom base URL: not
            # needed... tool search is on by default"). So `ENABLE_TOOL_SEARCH` is not set.
            #
            # `ToolSearch` is therefore added to the built-in surface whenever a real MCP
            # server remains attached (`mcp_servers` truthy; `not is_private` is implied —
            # a private dispatch's `mcp_servers` is always `None`, never truthy, since the
            # assignment above skips `_mcp_servers_for_policy` for it) — not suppressed to
            # `None` as an earlier version of this comment described. A policy naming no
            # built-in at all (`_builtin_tool_surface` returns `()`) still needs
            # `ToolSearch` added in that case: without it, `--tools ""` would disable the
            # one tool the attached server's schema loading depends on.
            # CQ·426: unenforced-policy `mcp_servers is None` means "keep BOTH kb/ops".
            tool_surface = _builtin_tool_surface(policy, agent_tools, agent_builtins)
            mcp_attached = bool(mcp_servers) or (agent_builtins is not None and mcp_servers is None)
            if tool_surface is not None and not is_private and mcp_attached:
                tool_surface = tuple(sorted(set(tool_surface) | {"ToolSearch"}))
            if tool_surface is not None:
                cmd += ["--tools", *(tool_surface or ("",))]
            # ARCH-346: the AUTONOMOUS runtime resolves its own policy. It does NOT
            # inherit the interactive meaning of the roster's `tools:` field, which
            # `claude -p` never reads. `policy.json` in the run dir records what this
            # run could actually do — previously that was reconstructable only by
            # knowing which runtime you were in, which is how the roster came to read
            # like a permission boundary it was not.
            if enforcing:
                # Only meaningful under dontAsk. Placed before --model so the flag's
                # greedy arg consumption stops at --model, not at the prompt (the same
                # trap --disallowedTools has above).
                cmd += ["--allowedTools", *policy.allowed]
            # `--strict-mcp-config` is now UNCONDITIONAL (issue_01M4APS4KRPE6ESTZAVEJVFDKC):
            # without it, a `--pr` dispatch's worktree (the PR's own branch) loads that
            # branch's committed `.mcp.json` alongside whatever `--mcp-config` names — an
            # MCP server a PR controls, started outside the run's sandbox (agent-platform#793
            # round 2). Same wall `bin/co` puts on CFO (ADR-0043), now closing the identical
            # gap for every dispatch, not only a private crew's.
            #
            # Non-private dispatches get `--mcp-config` first so the `kb`/`ops` servers they
            # relied on from global `~/.claude.json` config still reach them, and — for a
            # review-class agent — the verdict server (knowledge#793), all three named in
            # ONE combined config since `--strict-mcp-config` makes `--mcp-config` the only
            # MCP source — see `_dispatch_mcp_config_json`'s docstring. `is_private` (above)
            # is the same gate `_disallowed_tools` uses; a private dispatch gets neither flag
            # here, keeping the zero MCP servers ADR-0043 gives it — verdict included, since
            # a black-box crew's reviewer has no PR review record to post either. Which of
            # `kb`/`ops` are named (`mcp_servers`, above) is narrowed by the policy, UNIONED
            # WITH the agent's own roster grant (`_mcp_servers_for_policy`,
            # issue_01M4BT13RP23KRTA80VM6R7HNF) — a policy with no `mcp__kb__` rule still
            # keeps the kb server attached when the dispatched agent's own `tools:` line
            # names one, same for ops; only an agent whose policy AND own roster both omit a
            # server's prefix gets that server dropped. The verdict server is NEVER subject
            # to that narrowing — `_dispatch_mcp_config_json` folds it in after the kb/ops
            # filter, keyed only on `_is_review_agent`, so a reviewer's own tool-surface
            # narrowing can never drop its one way to post a verdict.
            #
            # `--name` (`run_sandbox.inside_dispatched_run`'s ancestor walk greps every
            # process's argv for RUN_NAME_PREFIX) stays unconditional either way — a
            # private dispatch must still be detectable as "inside a dispatched run"
            # the same as any other. On the non-private branch it sits right after
            # `--mcp-config`'s value, ending that flag's list of values.
            # `eval_mode` takes this same no-`--mcp-config` branch: `_dispatch_mcp_config_json`
            # keys only on `_is_review_agent`, so without this a replay would get the
            # verdict server unconditionally — another route to stamp a review.
            if not is_private and not eval_mode:
                cmd += ["--mcp-config",
                        _dispatch_mcp_config_json(args.agent, run_id, verdict_server, mcp_servers),
                        "--name", RS.run_name(run_id)]
            else:
                cmd += ["--name", RS.run_name(run_id)]
            cmd += ["--strict-mcp-config"]
            cmd += ["--model", claude_model_arg(spawn_model)]
            if getattr(args, "effort", None):  # passthrough to claude's own --effort
                cmd += ["--effort", args.effort]
            cmd += [
                "--append-system-prompt",
                agent["body"] + worktree_directive(worktree, repo)
                + attribution_directive(spawn_model, args.agent) + eval_directive,
                # `--` ends option parsing, so a task whose text starts with a flag
                # (`--settings=...`) reaches claude as the prompt, never as an option.
                "--", user_prompt,
            ]
            proc_env = {
                # A dispatched run has no pane and never belongs to the
                # dispatcher's tmux server (issue_01M2EG40BSYN7MXM2EWBT9VKBN) —
                # see dispatch_env's docstring for the tmux socket-precedence
                # mechanism that made a bare `tmux kill-server` in a dispatched
                # run reach the operator's live server on 2026-09-13.
                # deny_push (issue_01M3MMJFKSE5ZCA5YNXCJ1YCAK): reviewer and security-reviewer
                # roles get a git that refuses to push to a network remote (except one
                # configured with an explicit pushurl) — see dispatch_env's docstring for the
                # mechanism and the PR #698 incident that made this necessary.
                # private_object_dir/shared_object_dir (knowledge#793 round 6): the run's own
                # git writes new objects to a private store — run_sandbox.private_objects_dir.
                # github_token (CQ·418): this run's own per-run convivy-bosun installation
                # token, minted in _spawn_dispatch before any side effect — never the
                # operator's gh-managed, keyring-stored one.
                **DE.dispatch_env(
                    deny_push=_is_review_agent(args.agent),
                    private_object_dir=private_objects_dir,
                    shared_object_dir=(git_dir / "objects") if git_dir else None,
                    github_token=run_github_token),
                # Only for a repo in RS.POSTGRES_SOCKET_REPOS (round-1 revise
                # on PR #817): the sandbox grants that repo's run the
                # dedicated agent Postgres cluster's unix socket (never the operator's own
                # cluster — see RS's POSTGRES_SOCKET_REPOS comment for why) but leaves
                # TCP localhost closed, so PGHOST/PGPORT point the test suite's client
                # at that socket instead of the default TCP host libpq would otherwise
                # try, and PGUSER picks the one non-superuser role that cluster trusts
                # on its socket.
                **({"PGHOST": str(RS.agent_postgres_socket_dir(RS.passwd_home())),
                    "PGPORT": str(RS.AGENT_POSTGRES_PORT),
                    "PGUSER": RS.AGENT_POSTGRES_ROLE}
                   if repo in RS.POSTGRES_SOCKET_REPOS else {}),
                "AGENTCTL_RUN_ID": run_id,
                "AGENTCTL_AGENT_NAME": args.agent,
                "AGENTCTL_REPO": repo,
                "AGENTCTL_RUN_DIR": str(run_dir),
                # Pin off the bash-first steer Claude Code 2.1.263 injects under
                # bypassPermissions (and auto mode) — see bin/co's matching
                # comment for the full rationale. CLAUDE_CODE_THRIFTY_SONIC is
                # an undocumented experiment gate (Anthropic names these
                # tengu_<two random words>; this one is thrifty_sonic) that any
                # release can rename or drop with no notice, which is why
                # tests/test_claude_thrifty_sonic_pin.py exists — it is what
                # turns a silently-dropped pin into a red test instead of the
                # reminder reappearing. Evidence it was live: the attachment
                # record `{type: auto_mode, bashFirst: true, bypass: true}` in
                # `~/.claude/projects/<cwd-slug>/<session>.jsonl`.
                "CLAUDE_CODE_THRIFTY_SONIC": "0",
                # `--strict-mcp-config` above already strips the claude.ai connectors
                # (Gmail/Drive/Calendar/Docs) from every dispatch; this is the second
                # wall (issue_01M4BT13RP23KRTA80VM6R7HNF), so the operator's account
                # connectors stay out of a dispatched run's context even if a future
                # change drops the strict flag. Verified in the 2.1.293 binary's own
                # strings that this is the live gate: `ps(process.env.ENABLE_CLAUDEAI_MCP_SERVERS)`
                # parses "false" (case-insensitive, also "0"/"no"/"off") as disabled,
                # short-circuiting connector-list generation before it starts.
                "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
                # 5-minute prompt-cache TTL for every dispatched run (issue_01M4BT13RP23KRTA80VM6R7HNF):
                # Claude Code 2.1.293 defaults the main conversation to a 1-hour TTL on a
                # subscription within its usage limits, and 1-hour cache WRITES are billed
                # at a higher rate than 5-minute ones — a cost a dispatched run, which never
                # pauses long enough between turns to need the longer hold, should not pay.
                # "5m"/"1h" are the only two accepted values (code.claude.com/docs/en/
                # settings-reference and /docs/en/prompt-caching; confirmed in the 2.1.293
                # binary's own embedded settings-schema strings: `i4e=["5m","1h"]`). This
                # variable takes precedence over the `promptCacheTtl` setting per the same
                # docs.
                "CLAUDE_CODE_PROMPT_CACHE_TTL": "5m",
            }
            # The run's HOME is the passwd home, whatever the caller's env says. The
            # sandbox denies the grant under the passwd home, so a run that chose
            # another HOME could otherwise get a child whose user settings (and hooks,
            # which run outside the sandbox) it wrote itself. CLAUDE_CONFIG_DIR is the
            # same kind of relocation, and nothing here sets it, so it is dropped.
            proc_env["HOME"] = str(RS.passwd_home())
            proc_env.pop("CLAUDE_CONFIG_DIR", None)
            if eval_scratch_dir is not None:
                # Round 8: eval mode's `allowWrite` no longer covers the shared temp
                # root at all (run_sandbox.settings's `eval_scratch_dir` parameter), so
                # a tool that writes to whatever TMPDIR names (a `mkstemp` call, a
                # build tool's own scratch file) needs it repointed at this run's own
                # directory or it would hit a path the sandbox now refuses.
                proc_env["TMPDIR"] = str(eval_scratch_dir)
            # Worktree venv PATH guard (ARCH-027 bug-fix: Option 1): prepend the
            # worktree's .venv/bin so bare pytest and python resolve to the repo's
            # Python 3.11 venv rather than Homebrew's /opt/homebrew/bin/pytest
            # under Python 3.14 with older globally-installed deps.
            venv_bin = (worktree / ".venv" / "bin").resolve()
            if venv_bin.is_dir():
                proc_env["PATH"] = f"{venv_bin}:" + proc_env.get("PATH", "")
            # Review pin (ARCH-184): the worktree is already hard-reset + asserted
            # at this SHA; export it so the reviewer can self-check (HEAD == this)
            # and stamp its verdict with the commit it actually reviewed.
            if review_sha:  # the resolved pin (--review-sha OR the --pr self-resolved head)
                proc_env["AGENTCTL_REVIEW_SHA"] = review_sha
            # AGENTCTL_EVAL_MODE no longer exists (round-1 revise, agent-platform#813):
            # eval-ness used to be a subprocess-writable env var `cmd_review_post` read
            # at runtime, which the replayed model could strip with `env -u
            # AGENTCTL_EVAL_MODE agentctl review-post ...` — both round-1 reviews found
            # this. Eval-ness lives in this process's own `eval_mode` local instead (which
            # drove the eval allow-list above and the eval system-prompt directive). Round
            # 2 removed `cmd_review_post`'s eval check entirely, so nothing anywhere reads
            # this var any more; it is popped as hygiene (so an ambient leftover from
            # testing this feature by hand doesn't ride along into a dispatched run's
            # environment for no reason), not because anything downstream still depends
            # on its absence.
            proc_env.pop("AGENTCTL_EVAL_MODE", None)
            if is_gateway_model(spawn_model):
                proc_env = gateway_env(
                    spawn_model, proc_env,
                    virtual_key=_gateway_virtual_key(),
                    gateway_url=_gateway_url(),
                )
                task_label = _header_task_label(args.task)
                proc_env["ANTHROPIC_CUSTOM_HEADERS"] = "\n".join([
                    "x-agentctl-run-id: " + run_id,
                    "x-agentctl-agent: " + args.agent,
                    "x-agentctl-task: " + task_label,
                    "x-agentctl-run-dir: " + str(run_dir),
                ])
            # stderr appends so a fallback respawn (ARCH-131) keeps the first
            # attempt's failure evidence.
            return subprocess.Popen(
                cmd, cwd=str(worktree),
                stdout=subprocess.PIPE,
                stderr=T.open_owner_only(stderr_path, append=True),
                env=proc_env,
            )

        def _respawn_in_place(spawn_model: str, **meta_updates
                              ) -> tuple[dict | None, int, str | None]:
            """Run the session again in the SAME run dir and worktree; returns
            `(final_event, exit_code, cost_stop_reason)` from the second attempt.

            Shared by the two respawn paths — the ARCH-131 cross-provider fail-over
            and the api_error retry — which differ only in the model they hand
            `_spawn_claude` and what they record in meta. The bookkeeping around
            them (clear a stale kill outcome, re-register the new pid, keep
            streaming into the same transcript) is identical, and holding two
            copies of it is how one path comes to leave a dead pid in the registry
            or a `killed` outcome on a run that is still working.
            """
            p = _spawn_claude(spawn_model)
            # cmd_kill may have stamped outcome "killed" + ended_at — the run
            # continues, so clear both; _finalize_run rewrites them at real end.
            stale_outcome = run_dir / "outcome.json"
            if stale_outcome.exists():
                stale_outcome.unlink()
            # `pid_started_at` re-recorded here, not just at first spawn: this IS
            # the moment a new pid starts (ARCH-131 fail-over or an api_error
            # retry), so `_run_process_gone` has something fresh to corroborate
            # the new pid against rather than comparing it to the dead attempt's
            # start time. Recorded into the REGISTRY entry below, not meta — see
            # `_run_process_gone`'s docstring for why.
            pid_started_at = _pid_start_time(p.pid)
            # Re-derived for the model THIS attempt spawns: a grant's cap applies
            # to whatever model the run uses (the operator's 2026-10-07 ruling), so it's
            # unchanged across an ARCH-131 fail-over; an ordinary dispatch's
            # source can change if the fail-over crosses the gateway/subscription
            # line (e.g. deepseek -> sonnet).
            respawn_cost_cap, respawn_cost_cap_source = _run_cost_cap_for_agent(spawn_model, agent)
            T.update_meta(run_dir, pid=p.pid, ended_at=None,
                         cost_cap_source=respawn_cost_cap_source, **meta_updates)
            R.remove_run(run_id)  # stale pid (self-exit) or already gone (kill)
            try:
                # `dispatcher_pid`/`dispatcher_pid_started_at`: the same dispatcher
                # process and start time recorded at the first spawn's `R.attach_pid`
                # call (below, past this closure's definition — a nested function
                # reads its enclosing scope at CALL time, so this local is already
                # assigned by the time a respawn reaches here). A respawn changes
                # which claude child is running, never which dispatcher runs it.
                R.add_run({"run_id": run_id, "agent": args.agent, "task": args.task,
                           "started_at": started_at, "repo": repo,
                           "worktree": str(worktree), "pid": p.pid,
                           "pid_started_at": pid_started_at,
                           "dispatcher_pid": os.getpid(),
                           "dispatcher_pid_started_at": dispatcher_pid_started_at,
                           "parent_run": args.parent})
            except R.ConcurrencyError as e:
                print(f"warning: respawn left unregistered "
                      f"(kill by run-id unavailable): {e}", file=sys.stderr)
            ev: dict | None = None
            respawn_cost_stop_reason: str | None = None
            try:
                ev, respawn_cost_stop_reason = _stream_transcript(
                    p, run_dir,
                    cost_cap=respawn_cost_cap,
                    token_cap=_run_token_cap(spawn_model),
                    git_dir=git_dir,
                    private_objects_dir=private_objects_dir)
            except KeyboardInterrupt:
                p.terminate()
                try: p.wait(timeout=5)
                except subprocess.TimeoutExpired: p.kill()
            except (BrokenPipeError, OSError) as exc:
                _on_broken_stream(run_id, run_dir, exc)  # ARCH-253 (OSError-scoped)
            p.wait()
            return ev, p.returncode, respawn_cost_stop_reason

        # Python preflight (worktree interpreter guard): assert the worktree
        # has a usable venv Python before the worker spawns, so a bare pytest
        # invocation resolves to the repo's .venv Python/pytest rather than
        # Homebrew's py3.14 (ARCH-027 bug-fix: Option 3).
        # Run BEFORE write_meta and reserve_slot so a SystemExit from a broken
        # venv never creates a ghost reservation or a run record without outcome.
        _preflight_python_worktree(worktree)

        # Write meta.json early (pid=None) so a complete record exists even
        # when the admission retry budget exhausts and no subprocess starts.
        T.write_meta(run_dir, run_id=run_id, agent=args.agent, task=args.task,
                     started_at=started_at, repo=repo, worktree=str(worktree),
                     profile=profile, model=model, pid=None, label=args.label,
                     parent_run=args.parent, billing_source=_billing_source_for(model),
                     origin=_run_origin(args.parent), review_sha=review_sha, co_session=co_session,
                     overnight_wave=overnight_wave, pr=pr,
                     model_resolved=model_resolved, agent_source=agent.get("source"),
                     model_choice=model_choice, issue=issue_val,
                     held_until=None, hold_reason=None,
                     cost_cap_source=_run_cost_cap_for_agent(model, agent)[1])
        _record_item_override_meta(run_dir, args)
        if getattr(args, "eval_mode", False):
            # Audit trail only (round-2 revise, agent-platform#813): nothing in
            # `cmd_review_post` or any other gate reads this field back. The
            # guarantee that an eval replay never posts is the permission layer
            # (`tool_policy.resolve`'s eval branch, forced `dontAsk`), not a
            # record the run's own `Write` tool could later edit.
            T.update_meta(run_dir, eval_mode=True)
        # `dispatcher_pid` is THIS process (`_run_session`'s caller — the foreground
        # `agentctl spawn` invocation, or the daemonized grandchild for --detach). It
        # is the process that drains the child's stdout and writes `outcome.json` in
        # `_finalize_run`, AFTER `meta["pid"]` (the claude child) has already exited.
        # Recorded here for display/debugging only — meta.json lives in the run's
        # own directory, which the run's Bash tool can write (same UID,
        # `AGENTCTL_RUN_DIR` handed to it directly), so nothing may read this copy
        # back for liveness. `_died_without_finalizing` corroborates the dispatcher
        # pid against the REGISTRY instead — see its docstring and `R.attach_pid`
        # below (issue_01M1A3B1GQ54207ZYT1NMSVKPY, security review PR #641 round 1).
        # The registry write is deferred to `R.attach_pid`, alongside the child's
        # own `pid`/`pid_started_at`, rather than made here: `_pid_start_time`
        # shells out to `ps`, and doing that before capacity is even reserved would
        # run a subprocess on paths that today start none at all — the
        # capacity_refused and spawn-preflight-failure returns below, both of which
        # exist specifically to finalize WITHOUT ever reaching `_spawn_claude`.
        T.update_meta(run_dir, dispatcher_pid=os.getpid())
        if claude_md_blocked is not None:
            T.update_meta(run_dir, claude_md_blocked_path=claude_md_blocked[0],
                          claude_md_blocked_reason=claude_md_blocked[1])
        if render_skipped is not None:
            T.update_meta(run_dir, profile_render_skipped=render_skipped)
        if docs_unavailable_reason is not None:
            T.update_meta(run_dir, docs_unavailable_reason=docs_unavailable_reason)

        # Usage hold (issue_01M3PZ6J0D55EFC8GGAYMN9SH4): AFTER meta.json exists
        # (so `agentctl status` can already show it waiting) and BEFORE
        # `R.reserve_slot` below (a reservation older than
        # `R.RESERVATION_TIMEOUT_SECONDS` (60s) is reaped as an abandoned
        # crash, so a multi-hour hold must finish before one is taken, not
        # hold one open). `on_hold` stamps meta.json each time a wait begins —
        # including a second, later `resets_at` if the state re-read after the
        # first wait is itself still held (e.g. overage, which a five-hour
        # window reset alone does not clear).
        _wait_for_rate_limit_hold(
            pr_round_fix=pr is not None,
            on_hold=lambda held_until, hold_reason:
                T.update_meta(run_dir, held_until=held_until, hold_reason=hold_reason))

        # Reserve capacity BEFORE starting the subprocess so a run that would
        # lose the concurrency race is never abandoned mid-flight. Retry with
        # bounded back-off: the global ceiling drains on the timescale of
        # minutes (agent runs) so 5 min of waiting covers a normal burst.
        # Only start the process once a slot is confirmed, then fill in the
        # real pid via attach_pid.
        _sleep = _SPAWN_RETRY_SLEEP_0
        _deadline = time.monotonic() + _SPAWN_RETRY_BUDGET_S
        while True:
            try:
                R.reserve_slot({
                    "run_id": run_id, "agent": args.agent, "task": args.task,
                    "started_at": started_at, "repo": repo,
                    "worktree": str(worktree), "parent_run": args.parent,
                })
                break  # slot reserved — safe to spawn
            except R.ConcurrencyError as e:
                if time.monotonic() + _sleep > _deadline:
                    # Budget exhausted. Record a distinct, machine-readable
                    # outcome so callers can tell "never started" from "slow".
                    T.update_meta(run_dir, ended_at=T.now_iso())
                    T.write_outcome(
                        run_dir, exit_status="capacity_refused",
                        error_reason=(
                            f"{e} — retried for up to {_SPAWN_RETRY_BUDGET_S}s"
                        ),
                    )
                    print(
                        f"error: spawn capacity exhausted after "
                        f"{_SPAWN_RETRY_BUDGET_S}s of retries: {e}",
                        file=sys.stderr,
                    )
                    return 2
                time.sleep(_sleep)
                _sleep = min(_sleep * _SPAWN_RETRY_BACKOFF, _SPAWN_RETRY_SLEEP_MAX)

        try:
            proc = _spawn_claude(model)
        except Exception as exc:
            # FINALIZE, don't just release the slot. Releasing left a run
            # directory holding meta.json and no outcome.json, and because
            # `_spawn_claude` raised BEFORE `T.update_meta(run_dir, pid=...)`
            # ran, that meta carries no pid at all. `_died_without_finalizing`
            # treats an unrecorded pid as UNKNOWN rather than dead — correct, so
            # a slow-starting run is not declared vanished — so it never fires,
            # `cmd_status` prints "(still running)" with `pid: None`, and
            # `agentctl wait` polls for an outcome.json that nobody will ever
            # write. On 2026-09-03 a dispatcher lost 83 minutes to exactly that,
            # waiting on run-0ff51496 and run-8315add2, both killed at the
            # gateway-key preflight by a keychain locked since the 09-02 reboot.
            #
            # The machine-global contract every dispatcher is told to rely on is
            # that `wait`'s exit code is the completion signal and 4 means the
            # run errored. Silent-and-pending is the one outcome that breaks it,
            # and it is worse than either finishing or failing loudly.
            #
            # Scoped to the whole spawn rather than to the keychain read: any
            # failure inside `_spawn_claude` leaves the same unfinalized shape,
            # and PR #451 already swept the sibling `write_meta` call sites for
            # this. This path was missed because it raised from a nested builder
            # instead of returning bare.
            T.update_meta(run_dir, ended_at=T.now_iso())
            T.write_outcome(
                run_dir, exit_status="errored",
                error_reason=f"spawn preflight failed: {exc}",
                terminal_reason="spawn_preflight_failed",
            )
            R.remove_run(run_id)  # release the reserved slot on spawn failure
            print(f"error: spawn preflight failed: {exc}", file=sys.stderr)
            return 2

        # `pid_started_at` lets `_run_process_gone` tell "this pid is still our
        # process" from "the OS recycled this number to something else" — a bare
        # pid match can't, since a dead run's old pid can be reassigned to an
        # unrelated long-lived process and read as alive forever. Recorded into
        # the REGISTRY, not meta.json — see `_run_process_gone`'s docstring for
        # why: meta.json lives in the run directory, which the run itself can
        # write. `dispatcher_pid_started_at` gets the identical treatment for the
        # SAME reason, one field over — see `_died_without_finalizing`'s docstring
        # (issue_01M1A3B1GQ54207ZYT1NMSVKPY, security review PR #641 round 1).
        # Computed here, past both early-return paths above (capacity_refused,
        # spawn-preflight-failed), and reused by `_respawn_in_place`'s `R.add_run`
        # below — its closure reads this same local; the dispatcher's own pid and
        # start time never change across a respawn, only the child's do.
        T.update_meta(run_dir, pid=proc.pid)
        dispatcher_pid_started_at = _pid_start_time(os.getpid())
        R.attach_pid(run_id, proc.pid, pid_started_at=_pid_start_time(proc.pid),
                     dispatcher_pid=os.getpid(),
                     dispatcher_pid_started_at=dispatcher_pid_started_at)

        # Launched: only now does "ran on <model>" hold. Announcing at the
        # override gate above would leave a comment claiming a run for a spawn
        # that then failed.
        if _pending_item_announce:
            _announce_item_override(**_pending_item_announce)

        try:
            print(f"spawned {run_id}  pid={proc.pid}  agent={args.agent}  worktree={worktree}", file=sys.stderr)
        except (BrokenPipeError, OSError) as exc:
            # ARCH-253: the inline `... | head` pipe can close before this very
            # line (when preceding warnings consumed head's quota). Recover the
            # streams here too so the rest of the run still finalizes.
            _on_broken_stream(run_id, run_dir, exc)

        final_event = None
        interrupted = False
        # per-run gateway-spend breaker: a Library grant's cap (ARCH-185 + the operator's
        # 2026-10-07 ruling) or, with no grant, _run_cost_cap unchanged.
        cost_cap, _ = _run_cost_cap_for_agent(model, agent)
        token_cap = _run_token_cap(model)  # pricing-independent backstop (ARCH-245)
        try:
            final_event, cost_stop_reason = _stream_transcript(
                proc, run_dir, cost_cap=cost_cap,
                token_cap=token_cap,
                git_dir=git_dir,
                private_objects_dir=private_objects_dir)
        except KeyboardInterrupt:
            interrupted = True
            proc.terminate()
            try: proc.wait(timeout=5)
            except subprocess.TimeoutExpired: proc.kill()
        except (BrokenPipeError, OSError) as exc:
            # ARCH-253: a broken stdout pipe (inline spawn + `| head`) must not
            # propagate past _finalize_run. Scoped to OSError (BrokenPipeError is
            # a subclass) so a real logic bug in _stream_transcript still crashes
            # loudly. Don't terminate the child — it may still finish cleanly;
            # just recover the streams and fall through.
            _on_broken_stream(run_id, run_dir, exc)
        proc.wait()
        exit_code = proc.returncode

        # A transient API death retries ONCE, on the SAME model, before the
        # cross-provider fail-over below is even considered. "Connection closed
        # mid-response" is by nature a blip on the wire, and on 2026-08-02 seven
        # runs died on it in a single day — each one a manual re-dispatch, and two
        # of them reviewers whose co read the completion as a clean finish.
        #
        # This is NOT the ARCH-131/378 fail-over and does not inherit its refusals.
        # That one hops PROVIDER and TIER, which is a decision a human owns for an
        # interactive dispatch; a same-model retry changes nothing about who did
        # the work, so an interactive origin is no reason to withhold it.
        #
        # Once, by construction — there is no loop here. A second api_error falls
        # through to the fail-over and then to `errored`, which the waiter now
        # carries out to the caller (EXIT_RUN_FAILED).
        if (final_event is not None
                and final_event.get("terminal_reason") == "api_error"
                and not interrupted):
            # CAN a retry work, before asking whether it is SAFE. The two
            # questions are different and were collapsed into the second one.
            #
            # `_api_retry_refusal` reasons entirely about side effects — would a
            # second attempt duplicate a review stamp, or start on top of a
            # half-written worktree. That is the right question and it is
            # correctly answered. But a run that died at STARTUP on an unusable
            # model left nothing behind, so it sails through every one of those
            # checks and spends the single retry on a model that can never run.
            # Only then does it reach the fail-over, which for an interactive
            # origin refuses and needs a human — so the attempt that exists to
            # save a manual re-dispatch bought nothing.
            #
            # Observed twice: `run-faef2e84` (2026-08-03) and `run-12898f6b`
            # (2026-08-06), both `test-writer` on `claude-sonnet-4-6`, both
            # carrying `api_retry_of: "api_error"` against a 400 that named the
            # model as the problem.
            raw_status = final_event.get("api_error_status")
            death_status = parse_api_error_status(
                raw_status, unparseable=_UNPARSEABLE_STATUS)
            if not api_death_is_retryable(death_status):
                said = (f"the server returned {death_status} — it refused the request "
                        f"itself, so the same request fails the same way"
                        if death_status != _UNPARSEABLE_STATUS else
                        f"the death carried an unreadable status "
                        f"({_scrub_api_error_message(str(raw_status))}), which says "
                        f"nothing about whether a retry could work")
                # BOTH provider-supplied values are scrubbed, not just the obvious
                # one. `result` is the text that looks like a message; `raw_status`
                # is the same untyped JSON field read off the same event stream,
                # which is why `parse_api_error_status` int()-guards it rather than
                # trusting it. Anything non-numeric there is GUARANTEED to route
                # through the unparseable branch above — so a gateway stuffing a
                # header into that field lands verbatim in `meta.json` unless it is
                # scrubbed too. Fixing only `result` left the identical sink open
                # one line away.
                #
                # SCRUBBED. This is provider text and it lands in `meta.json` via
                # `T.update_meta` below — a structured record with downstream
                # readers, not a private scratch file. `_scrub_api_error_message`
                # exists for exactly this value and is already applied to it
                # before it reaches `outcome.json`; the sibling
                # `_api_retry_refusal` never needed it because every string it
                # returns is synthesized here. This is the first path to put raw
                # upstream error text into that field, so it is the first that
                # has to redact. A gateway echoing a request header on a
                # malformed-auth diagnostic is the shape `_CRED_RE` was built
                # against.
                detail = _scrub_api_error_message(str(final_event.get("result") or ""))
                refusal = (f"{said}. Going straight to the fail-over "
                           f"({detail or 'no detail'})")
            else:
                refusal = _api_retry_refusal(run_dir=run_dir, worktree=worktree,
                                             agent_name=args.agent)
            if refusal:
                print(f"{run_id}: died on an API error; NOT retrying — {refusal}.",
                      file=sys.stderr)
                T.update_meta(run_dir, api_retry_declined_reason=refusal)
            else:
                print(f"{run_id}: died on an API error "
                      f"({final_event.get('result') or 'no detail'}); retrying once on "
                      f"{model}. Its worktree is unchanged and its tool-call log "
                      f"records nothing that reached outside it.", file=sys.stderr)
                retry_event, exit_code, retry_cost_stop_reason = _respawn_in_place(
                    model, api_retry_of="api_error", api_retry_at=T.now_iso())
                # `or final_event`: a retry that itself dies before emitting a
                # result must not erase the first attempt's diagnosis — the run
                # would then finalize with no terminal_reason at all.
                final_event = retry_event or final_event
                # `or`, not overwrite: the first attempt's own cap breach (if
                # any) must survive a retry that itself never crosses the cap.
                cost_stop_reason = retry_cost_stop_reason or cost_stop_reason

        # ARCH-131: harness fail-over. An Anthropic-direct claude that died
        # abnormally — nonzero exit (API/rate-limit error) or signal kill
        # (negative returncode; the ARCH-070 timeout-kill of a hung run) —
        # respawns once on deepseek in the same run dir/worktree. Ctrl-C and a
        # `kill --final` marker mean "stay dead". Gateway models never enter
        # (fallback_model_for returns None — the LiteLLM router owns their hop).
        fb_model = fallback_model_for(model)
        # ARCH-378: a fail-over may not silently produce work at a tier the roster
        # forbids. Two independent refusals, checked before the respawn.
        fb_block: str | None = None
        if fb_model and exit_code != 0 and not interrupted:
            floor = model_floor_for(agent)
            if _model_tier(floor) == 0:
                # An unrecognised floor must never read as "no floor". Tier 0 on
                # the TARGET is fail-closed (nothing satisfies a floor); tier 0 on
                # the FLOOR would invert that — `10 < 0` is False, so the hop
                # would proceed. The same unknown-is-zero rule has opposite safety
                # meaning on each side of the comparison, which is how a roster
                # naming a model the tier table has not learned yet (a new
                # snapshot, a typo) would silently re-open exactly this hole.
                fb_block = (f"agent's model_floor ({floor}) is not a ranked model "
                            f"— refusing rather than treating an unknown floor as "
                            f"no floor; add it to _MODEL_TIERS")
            elif _run_origin(args.parent) == "interactive":
                # The operator's rule: an interactive dispatch never swaps provider on its
                # own. The run is detached, so there is no prompt to raise here —
                # refusing and recording is what puts the choice back to the human,
                # who sees it via the ARCH-367 waiter and can re-dispatch with an
                # explicit --model.
                fb_block = "interactive origin — fail-over needs a human decision"
            elif _model_tier(fb_model) < _model_tier(floor):
                fb_block = (f"{fb_model} is below this agent's model_floor "
                            f"({floor})")
        if fb_block:
            print(f"{run_id}: {model} died (exit {exit_code}); NOT failing over to "
                  f"{fb_model} — {fb_block} (ARCH-378). The run fails instead of "
                  f"completing at a tier nobody chose.", file=sys.stderr)
            T.update_meta(run_dir, fallback_blocked_to=fb_model,
                          fallback_blocked_reason=fb_block)
            fb_model = None
        # The fail-over is a new dispatch of another model, so it needs that model's policy.
        # Refused here, and recorded like the ARCH-378 refusals above, when the Library does
        # not answer for it. Read in the detached grandchild, a refusal would escape
        # `_run_session` without finalising the run.
        if (fb_model and exit_code != 0 and not interrupted
                and not (run_dir / "no-fallback").exists()):
            try:
                _library_denials(args.agent, repo, fb_model, failover=True)
            except SystemExit as exc:
                print(f"{run_id}: {model} died (exit {exit_code}); NOT failing over to "
                      f"{fb_model} — {exc}", file=sys.stderr)
                T.update_meta(run_dir, fallback_blocked_to=fb_model,
                              fallback_blocked_reason=str(exc))
                fb_model = None
        if (exit_code != 0 and not interrupted and fb_model
                and not (run_dir / "no-fallback").exists()):
            print(f"{run_id}: {model} died (exit {exit_code}); failing over to "
                  f"{fb_model} (ARCH-131)", file=sys.stderr)
            fb_event, exit_code, fb_cost_stop_reason = _respawn_in_place(
                fb_model, model=fb_model,
                billing_source=_billing_source_for(fb_model),
                fallback_from=model,
                fallback_reason=f"exit_code={exit_code}",
                model_choice="harness_fallback")
            final_event = fb_event or final_event
            cost_stop_reason = fb_cost_stop_reason or cost_stop_reason
            # The fail-over is a HARNESS decision, not the subprocess's — so
            # updating these local vars (unlike re-reading meta.json) can't be
            # forged by the run. _finalize_run below is threaded these values
            # rather than reading them back off disk (security review, PR #477
            # round 2): see _post_model_resolution_signal's docstring.
            model = fb_model
            model_choice = "harness_fallback"

    # Round 6, continued (agent-platform#813), confinement tightened round 8 (round-7
    # finding): the eval directive told this run to write its verdict inside its own
    # directory (`eval_scratch_dir`, `RS.create_eval_scratch_dir`'s return value for
    # this dispatch — never shared with any sibling eval arm, and never `run_dir`
    # itself, which is denied to every run's own write, unconditionally). This is the
    # dispatcher side of that split — it runs here, outside the sandbox, only after the
    # run's own claude process has already exited, so nothing it reads can still be
    # rewritten by that run. `_collect_eval_verdict` is the untrusted-input boundary: a
    # missing, symlinked or unparsable verdict file, or one that fails validation,
    # returns None, and None writes nothing — a replay with no verdict stays a replay
    # with no verdict, never a recorded pass. The directory is removed either way,
    # successful write or not, so a replay never leaves its own leftover in shared
    # scratch space.
    if getattr(args, "eval_mode", False) and not args.dry_run:
        eval_verdict = _collect_eval_verdict(
            eval_scratch_dir, run_id=run_id, repo=repo, review_sha=review_sha,
            agent_name=args.agent, pr=pr)
        if eval_verdict is not None:
            (run_dir / "eval-review.json").write_text(json.dumps(eval_verdict))
        if eval_scratch_dir is not None:
            shutil.rmtree(eval_scratch_dir, ignore_errors=True)

    # The private-object import (round 6, knowledge#793) moved INSIDE
    # `_finalize_run` — the first thing it now does, before `_commits_since` and
    # every other subprocess call it makes — under issue_01M4RP1K026XJE740DMQ7AP31M,
    # so a crash later in finalize can no longer strand an already-import-eligible
    # commit with no outcome written at all. `git_dir`/`private_objects_dir` are
    # the same values computed once above, at spawn time.
    _finalize_run(run_dir=run_dir, worktree=worktree, run_id=run_id,
                  exit_code=exit_code, final_event=final_event,
                  profile=profile, agent=agent,
                  git_dir=git_dir, private_objects_dir=private_objects_dir,
                  model=model, model_resolved=model_resolved, model_choice=model_choice,
                  agent_name=args.agent, repo=repo, issue=issue_val,
                  materialized_documents=materialized_documents,
                  cost_stopped_reason=cost_stop_reason,
                  dry_run=args.dry_run)

    R.remove_run(run_id)

    # Only now that the run is finalized and deregistered (ARCH-344). The verdict
    # lives on the PR and in the run-dir; the tree it was read from is dead weight.
    _reap_review_worktree(args.agent, worktree, run_id)

    # The per-run #*-explanations autopost — the "3.9" explainer auto-trigger plus
    # completion notice — is retired (ARCH-170). It duplicated the post-merge
    # changelog (each product's post_changelog.py → #*-changelog); #*-explanations
    # is being repurposed for decision records, not per-run worker output.
    return 0 if exit_code == 0 else 1


def _spawn_hint_lines(run_id: str) -> list[str]:
    """The follow-up commands printed after a detached spawn.

    `wait` leads because it is the step the dispatcher must take NEXT, and the only
    one that ends with it being TOLD. A detached run is `setsid`'d out of the
    caller's process tree on purpose (see `_detach_and_run`), so nothing here can
    wake an interactive co when the run finishes — the notification has to come from
    a process the CALLER holds. `agentctl wait` is that process: backgrounded by the
    caller's harness, its exit is the completion signal.

    This list used to be status/logs/kill — three ways to LOOK at a run and no way to
    be told about it. The result was co's sitting idle after their reviewers had
    already finished, across every product (operator, 2026-07-18). The affordance was
    missing at the one moment a dispatcher is deciding what to do next, which is why
    a documented rule alone would not have fixed it.
    """
    return [
        f"  agentctl wait {run_id}   <- run this in the BACKGROUND to be notified "
        f"when it finishes; takes several run-ids",
        f"  agentctl status {run_id}",
        f"  agentctl logs -f {run_id}",
        f"  agentctl kill {run_id}",
    ]


def _detach_and_run(*, args: argparse.Namespace, agent: dict, run_id: str,
                    run_dir: Path, worktree: Path, profile: str, repo: str,
                    started_at: str, user_prompt: str,
                    review_sha: str | None = None,
                    pr: int | str | None = None,
                    claude_md_blocked: tuple[str, str] | None = None,
                    render_skipped: str | None = None,
                    materialized_documents: list[dict] | None = None,
                    docs_unavailable_reason: str | None = None,
                    run_github_token: str | None = None) -> int:
    """Double-fork daemonize, then run the session in the grandchild.

    Parent (the caller): prints the run-id + helper commands to stderr and
    returns 0 to the shell. First child: setsid() to detach from the
    controlling terminal, then forks the grandchild and exits — this prevents
    the grandchild (no longer a session leader) from re-acquiring a TTY.
    Grandchild: redirects stdin → /dev/null, stdout/stderr → run_dir
    detach.{out,err}.log so post-mortem inspection has something to look at,
    then runs `_run_session` and `os._exit`s with its exit code.
    """
    sys.stdout.flush(); sys.stderr.flush()

    pid = os.fork()
    if pid > 0:
        # Parent process — user-facing report and clean exit.
        # Carry agent + worktree on the header line so tools/logs that grep the
        # foreground `spawned … worktree=…` line still find it now that detach is the
        # default (the grandchild's pid isn't known here, so it's not on this line).
        print(f"spawned {run_id} (detached)  agent={args.agent}  worktree={worktree}",
              file=sys.stderr)
        for line in _spawn_hint_lines(run_id):
            print(line, file=sys.stderr)
        return 0

    # First child — detach from controlling terminal, fork grandchild, exit.
    try:
        os.setsid()
    except OSError:
        pass  # already a session leader is fine
    pid2 = os.fork()
    if pid2 > 0:
        os._exit(0)

    # Grandchild — redirect stdio and run the session.
    devnull_fd = os.open(os.devnull, os.O_RDONLY)
    out_fd = os.open(str(run_dir / "detach.out.log"),
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.fchmod(out_fd, 0o600)
    err_fd = os.open(str(run_dir / "detach.err.log"),
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.fchmod(err_fd, 0o600)
    os.dup2(devnull_fd, 0)
    os.dup2(out_fd, 1)
    os.dup2(err_fd, 2)
    os.close(devnull_fd); os.close(out_fd); os.close(err_fd)

    try:
        exit_code = _run_session(
            args=args, agent=agent, run_id=run_id, run_dir=run_dir,
            worktree=worktree, profile=profile, repo=repo,
            started_at=started_at, user_prompt=user_prompt,
            review_sha=review_sha, pr=pr, claude_md_blocked=claude_md_blocked,
            render_skipped=render_skipped,
            materialized_documents=materialized_documents,
            docs_unavailable_reason=docs_unavailable_reason,
            run_github_token=run_github_token,
        )
    except Exception:
        import traceback
        traceback.print_exc(file=sys.stderr)
        exit_code = 1
    # os._exit() skips atexit, so dispatch_env's private TMUX_TMPDIR, GH_CONFIG_DIR and
    # git-wrapper-dir cleanup (registered inside _run_session's DE.dispatch_env() call)
    # never fires on its own here — this grandchild's normal termination IS os._exit(),
    # not just its SIGKILLed case. Clean up explicitly first.
    DE.cleanup_private_tmux_tmpdir()
    DE.cleanup_private_gh_config_dir()
    DE.cleanup_private_git_wrapper_dir()
    os._exit(exit_code)


def _budget_gate(args, agent: dict, repo: str, profile: str) -> int | None:
    """Pre-flight budget check. Returns an exit code if the spawn should be
    refused, or None to proceed. Hard cap → write a budget_refused run dir +
    return 3. Soft warn → prompt y/N on tty; auto-allow if non-interactive
    (overnight launchd should not silently die at $30.01)."""
    # ARCH-156: the daily caps govern autonomous (scheduled / full_monty) spend
    # only — interactive co-session spend is uncapped by decision. The crossing
    # flags below are computed off the SCHEDULED pool, so gating every spawn on
    # them falsely warns (and, past the hard cap, refuses) a human co's
    # reviewer/coder dispatch on a day with heavy overnight spend. Skip the gate
    # entirely when this spawn's own origin isn't capped.
    origin = _run_origin(args.parent)
    if origin not in B.CAPPED_ORIGINS:
        return None
    # Gate against THIS spawn's own pool (ARCH-320): a curation worker checks the
    # curation pool, an overnight worker the overnight pool — they don't contend.
    pool = B.POOL_BY_ORIGIN[origin]
    bstatus = B.status(pool, soft_override=args.budget_warn)
    soft, hard = bstatus["soft_usd"], bstatus["hard_usd"]
    if bstatus["hard_crossed"]:
        return _budget_refuse_and_record(args, agent, repo, profile, bstatus, hard)
    if bstatus["soft_crossed"]:
        # Return value is unused now that the Slack once-per-day notifier is gone,
        # but the CALL must stay: it creates the day's crossing marker, which
        # budget.status() still reports as soft_marker_exists and agent-summary
        # still reads. Dropping the call would silently empty both.
        B.mark_crossed("soft", pool)
        msg = (f"WARNING: daily soft budget exceeded for {pool} pool "
               f"(${bstatus['spent_today_usd']:.2f} >= ${soft:.2f}; "
               f"hard cap ${hard:.2f})")
        if sys.stdin.isatty():
            print(msg, file=sys.stderr)
            try:
                resp = input("continue with spawn? [y/N] ").strip().lower()
            except EOFError:
                resp = ""
            if resp != "y":
                print("aborted by user", file=sys.stderr)
                return 4
        else:
            print(msg + " — non-interactive, auto-allowing", file=sys.stderr)
        return None


def _budget_refuse_and_record(args, agent: dict, repo: str, profile: str,
                              bstatus: dict, hard: float) -> int:
    """Write a telemetry record for a hard-budget-refused spawn (exit_status:
    budget_refused) and return exit code 3."""
    purpose = derive_purpose(args.agent, args.task, pr=getattr(args, "pr", None))
    try:
        desired = W.desired_path(repo, purpose)
    except ValueError:
        desired = Path(f"(unknown:{repo})")
    if not R.ACTIVE_PATH.exists():
        R.bootstrap()
    run_id = T.new_run_id()
    run_dir = T.create_run_dir(run_id)
    started = T.now_iso()
    user_prompt = args.task + (f"\n\n(reviewer: {args.reviewer})" if args.reviewer else "")
    T.write_prompt(run_dir, system=agent["body"], user=user_prompt)
    _model = model_id(agent.get("model_alias"))
    T.write_meta(run_dir, run_id=run_id, agent=args.agent, task=args.task,
                 started_at=started, repo=repo, worktree=str(desired),
                 profile=profile, model=_model,
                 pid=None, parent_run=args.parent, label=args.label,
                 billing_source=_billing_source_for(_model),
                 origin=_run_origin(args.parent), overnight_wave=_overnight_wave())
    T.update_meta(run_dir, ended_at=T.now_iso())
    T.write_cost(run_dir, by_model={})
    T.write_outcome(run_dir, exit_status="budget_refused")
    T.write_docs_consulted(run_dir, profile=profile,
                           individuated_agents=[], individuated_skills=[],
                           queried_at_runtime=[], materialized_documents=[])
    pool = bstatus.get("pool", B.DEFAULT_POOL)
    first = B.mark_crossed("hard", pool)
    print(f"error: daily hard budget cap reached for {pool} pool "
          f"(${bstatus['spent_today_usd']:.2f} >= ${hard:.2f}); "
          f"refusing spawn (run_id={run_id}{'; first today' if first else ''})",
          file=sys.stderr)
    return 3


# Grace period after the terminal `result` event before we reap a subprocess
# that hasn't exited (ARCH-069). A `claude -p` that ends its turn with
# background tasks still pending emits its `result` but never closes stdout, so
# the drain loop below would block on EOF forever and _finalize_run never runs
# (the 2026-05-27 hang: two runs alive 6h, phantom unbounded in-flight budget).
REAP_GRACE_SECONDS = float(os.environ.get("AGENTCTL_REAP_GRACE_SECONDS", "60"))


def _reap_lingering(proc: subprocess.Popen, run_dir: Path) -> None:
    """Timer callback, fired REAP_GRACE_SECONDS after the terminal `result`.
    If the subprocess is still alive it emitted its result but won't exit on its
    own — terminate it so stdout closes, the drain loop ends, and the normal
    _finalize_run path runs. Escalate to SIGKILL if SIGTERM doesn't take."""
    if proc.poll() is not None:
        return  # exited on its own within the grace window — nothing to do
    sys.stderr.write(
        f"reaper: {run_dir.name} emitted result but did not exit within "
        f"{REAP_GRACE_SECONDS:.0f}s — terminating pid {proc.pid}\n")
    sys.stderr.flush()
    proc.terminate()
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()


# The operator's 2026-10-07 ruling (slate a-1ommg6): this default, and the
# AGENTCTL_RUN_COST_CAP override below, govern only an ordinary dispatch (no
# Library checkout grant — it doesn't call checkout yet). A grant-path
# dispatch's cap comes from the grant's own budget.cap_usd instead (see
# _run_cost_cap_for_agent). This default and its env override go once ordinary
# dispatches move to checkout grants too.
DEFAULT_RUN_COST_CAP_USD = 10.0
# Token backstop (ARCH-245): the dollar cap above fails OPEN when a gateway model
# is unpriced — its gateway_spend rows log usd=0 (the ARCH-207 glm-5.2 / mimo
# class), so cumulative spend never crosses the dollar cap and a runaway runs
# unbounded. This token ceiling trips on raw volume regardless of pricing. Set
# clear of the legitimate max (~46M tokens, the largest real refactorer run as of
# 2026-06-24) with ~2x margin and below the 121M-token runaway it backstops; the
# dollar cap stays primary for priced models (it fires far earlier).
DEFAULT_RUN_TOKEN_CAP = 100_000_000
_COST_CHECK_INTERVAL_S = 20.0
# How often a live run's accumulated cost is checkpointed to cost-partial.json
# (issue_01M1D1HNMGCAKH89ZWY3XSJPGS). One write per live run per interval, on
# the same disk every run dir already lives on; 30s keeps a Deck panel or
# budget.py within half a minute of the true figure while staying well under
# the 4-run concurrency ceiling's worst case (4 writes / 30s, negligible next
# to the per-line transcript/tool_calls appends already happening every turn).
_COST_PARTIAL_WRITE_INTERVAL_S = 30.0
# How often a live run's private object store is caught up into the shared store
# (`_stream_transcript`'s `remove=False` import, see its own docstring). Same order as
# the two intervals above: a dispatched run's worktree can hold a dangling branch ref
# for up to this long after a commit before any OTHER git process sharing the repo's
# objects can read it cleanly — the autopull-visible window the 2026-10-07 incident hit.
_LIVE_IMPORT_INTERVAL_S = 20.0


def _run_cost_cap(model: str) -> float | None:
    """Per-run gateway-spend ceiling (ARCH-185). Only gateway and Codex (metered at
    OpenAI's API rates) runs get a cap — Anthropic runs bill the subscription and
    are covered by the daily budget gate. Override with AGENTCTL_RUN_COST_CAP (USD;
    <= 0 disables). The cap catches a looping run before it runs away (the
    2026-06-18 $23 kimi refactorer loop), independent of the daily budget gate."""
    if not (is_gateway_model(model) or is_codex_model(model)):
        return None
    raw = os.environ.get("AGENTCTL_RUN_COST_CAP", "").strip()
    if raw:
        try:
            v = float(raw)
        except ValueError:
            return DEFAULT_RUN_COST_CAP_USD
        return v if v > 0 else None
    return DEFAULT_RUN_COST_CAP_USD


def _run_cost_cap_for_agent(model: str, agent: dict) -> tuple[float | None, str]:
    """Per-run dollar cap plus where it came from — `source` is one of
    `T.VALID_COST_CAP_SOURCES` ("grant", "default", "env", "none"), recorded
    onto meta.json's `cost_cap_source` so `agentctl status` shows which applied.

    The operator's 2026-10-07 ruling (slate a-1ommg6): where a dispatch has a Library
    checkout grant (`resolve_agent_from_grant`, carried as `agent["grant"]`),
    the Library decided the per-run cap at checkout — `grant["budget"]["cap_usd"]`
    — and that decision applies to whatever model the run ends up running,
    including an ARCH-131 cross-provider fail-over; it is read here AHEAD of
    the model check below, not merged with it. `None` there means the Library
    decided this project gets no dollar kill, not a missing field —
    `_agent_from_grant` already refused a grant whose `budget` has no `cap_usd`
    key, so indexing it here is safe.

    An ordinary dispatch (no grant) keeps `_run_cost_cap`'s existing
    default/env/subscription behaviour, unchanged, just labeled: "env" when
    AGENTCTL_RUN_COST_CAP is set (gateway/Codex models only, matching
    `_run_cost_cap`'s own scope), "default" for the DEFAULT_RUN_COST_CAP_USD
    fallback, "none" for a subscription model, which gets no gateway-spend cap
    to begin with."""
    grant = agent.get("grant")
    if grant is not None:
        return grant["budget"]["cap_usd"], "grant"
    cap = _run_cost_cap(model)
    if not (is_gateway_model(model) or is_codex_model(model)):
        return cap, "none"
    raw = os.environ.get("AGENTCTL_RUN_COST_CAP", "").strip()
    return cap, ("env" if raw else "default")


def _cap_breach_reason(gw_usd: float, gw_tokens: int, gw_has: bool,
                       cost_cap: float | None,
                       token_cap: int | None) -> tuple[str, str] | None:
    """Pure breaker decision (ARCH-185 + ARCH-245). Returns (kind, reason) when the
    run should be killed, else None — `kind` is the machine label ("cost-cap" /
    "token-cap", which cap fired) and `reason` the human string. Returning both
    from one place keeps the audit marker and the message in sync (no substring
    re-derivation downstream). The dollar cap is primary — it fires far earlier for
    priced models; the token cap is the pricing-independent backstop that still
    trips when an unpriced model logs spend as $0."""
    if not gw_has:
        return None
    if cost_cap is not None and gw_usd > cost_cap:
        return ("cost-cap",
                f"gateway spend ${gw_usd:.2f} exceeded per-run cap ${cost_cap:.2f}")
    if token_cap is not None and gw_tokens > token_cap:
        return ("token-cap",
                f"gateway tokens {gw_tokens:,} exceeded per-run token cap "
                f"{token_cap:,} (spend logged ${gw_usd:.2f} — likely an unpriced "
                f"model; ARCH-245 backstop)")
    return None


def _run_token_cap(model: str) -> int | None:
    """Per-run token ceiling (ARCH-245) — the pricing-independent backstop to the
    dollar cap. Only gateway runs get it (same scope as _run_cost_cap; subscription
    runs are covered by the daily budget). Catches a runaway even when the model is
    unpriced and gateway spend logs ~$0. Override with AGENTCTL_RUN_TOKEN_CAP
    (total in+out tokens; <= 0 disables)."""
    if not (is_gateway_model(model) or is_codex_model(model)):
        return None
    raw = os.environ.get("AGENTCTL_RUN_TOKEN_CAP", "").strip()
    if raw:
        try:
            v = int(float(raw))
        except (ValueError, OverflowError):
            # OverflowError covers int(float("inf")) — a garbage override falls to
            # the default rather than crashing spawn.
            return DEFAULT_RUN_TOKEN_CAP
        return v if v > 0 else None
    return DEFAULT_RUN_TOKEN_CAP


def _log_stream_note(run_dir: Path, message: str) -> None:
    """Best-effort note to the run's stderr.log; never raises.

    Used by `_stream_transcript`'s cost-partial checkpoint (round 2,
    issue_01M1D1HNMGCAKH89ZWY3XSJPGS): a logging failure here must not take
    down the drain loop it exists to keep alive, so this swallows its own
    OSError the same way `_on_broken_stream` does."""
    try:
        T.write_owner_only(run_dir / "stderr.log", message, append=True)
    except OSError:
        pass


def _stream_transcript(proc: subprocess.Popen, run_dir: Path,
                       cost_cap: float | None = None,
                       token_cap: int | None = None,
                       git_dir: Path | None = None,
                       private_objects_dir: Path | None = None
                       ) -> tuple[dict | None, str | None]:
    """Drain claude's stdout. Each line is one stream-json event. Tees verbatim
    to transcript.jsonl + stdout, derives tool_calls.jsonl from matched
    tool_use/tool_result pairs by id. Returns `(final_event, cost_stop_reason)`:
    the final 'result' event if any, and the cap's own human-readable reason
    if the per-run cost/token cap fired and killed the process, else `None`.

    That second value is this function's own in-memory record of the breach —
    the SAME fact `cost-killed.txt` (below) is written for, but returned
    rather than left for a caller to read back off disk, because `_finalize_run`
    must not trust that file (security review, PR #874 round 1): it sits in a
    directory the run's own subprocess can write to for its whole execution
    window. The caller threads this return value into `_finalize_run` as
    `cost_stopped_reason` instead.

    When `cost_cap` or `token_cap` is set (gateway runs), polls the run's gateway
    spend at most every ~20s and terminates the process the moment cumulative
    spend crosses the dollar cap (ARCH-185) OR cumulative tokens cross the token
    cap (ARCH-245, the pricing-independent backstop for unpriced models).

    Independent of either cap, checkpoints the run's accumulated cost to
    cost-partial.json every `_COST_PARTIAL_WRITE_INTERVAL_S`
    (issue_01M1D1HNMGCAKH89ZWY3XSJPGS), from the SAME sources `_resolve_cost`
    reads at finalisation — see `_write_cost_partial_checkpoint` — so a reader
    of an in-flight run gets a RECORDED figure instead of budget.py's flat-rate
    guess. Checked once per line, so a run that goes quiet mid-turn (a long
    single tool call with no intervening stdout) can lag behind wall-clock;
    that lag is exactly what cost-partial.json's `written_at` exposes.

    Also independent of either cap (and `git_dir`/`private_objects_dir` is None for a
    non-git agent, same as `_run_session`'s own locals): catches this run's own private
    object store up into the shared store every `_LIVE_IMPORT_INTERVAL_S`
    (`RS.import_private_objects(..., remove=False)`) — the successor to knowledge#793's
    own window. That round made `objects` under the shared git directory unwritable by a
    dispatched run's own git, so the run's commits land in a private store instead and
    the dispatcher imports them into the shared store once the run ends. But the run's
    branch ref ITSELF lives in the shared ref store and moves the moment the run commits,
    so for as long as a run holds a commit the existing end-of-run import hasn't reached
    yet, that ref points at an object no OTHER git process sharing this repo's objects can
    read — measured 2026-10-07 (two merge coders running): `git fetch` in the PRIMARY
    checkout failed outright on `bad object refs/heads/<branch>`, and the autopull job
    that runs it read every such failure as "offline" and went silent for 3.5 hours.
    `remove=False` is what makes this safe to call while the run is still alive: it never
    deletes the private directory a live run could still write another object into (see
    its own docstring), so this narrows the window to one polling interval instead of
    closing it to zero — a git worktree's own checked-out HEAD is, by git's own design,
    always a connectivity root that `git fetch`/`fsck`/`rev-list --all` must resolve from
    ANY other worktree sharing its object database, whichever ref carries it (measured: a
    detached HEAD trips the identical failure a branch ref does), so there is no ref
    placement that avoids this while this run is checked out on a linked worktree at all.

    The checkpoint write and the per-turn usage accumulation feeding it each
    catch `Exception` (round 3, security-reviewer finding on this same PR —
    round 2's narrower `except (TypeError, ValueError)` still let an Infinity
    usage field's `OverflowError` unwind the loop): this loop also enforces
    the cost/token-cap circuit breaker above, so an uncaught exception from
    either — a symlink at the checkpoint's temp path, a provider emitting a
    malformed usage field — must never unwind the loop and silently disable
    that breaker for the rest of the run. A failure is logged once to the
    run's stderr.log via `_log_stream_note` and the loop keeps draining; a
    malformed usage value skips only that turn's usage."""
    pending: dict[str, dict] = {}
    final_event: dict | None = None
    cost_stop_reason: str | None = None
    reaper: threading.Timer | None = None
    assert proc.stdout is not None
    transcript_path = run_dir / "transcript.jsonl"
    spend_log = run_dir / "gateway_spend.jsonl"
    last_cost_check = time.monotonic()
    last_partial_write = time.monotonic()
    # Read only when there is a private store to catch up — None otherwise, so a caller
    # that passes neither `git_dir` nor `private_objects_dir` (every existing call site
    # and test before this one) gets zero extra `time.monotonic()` calls, same as before.
    last_live_import = time.monotonic() if private_objects_dir is not None else None
    usage_by_model: dict[str, dict[str, int]] = {}
    usage_dedup = T.UsageDedup()
    with transcript_path.open("a") as tf:
        for raw in proc.stdout:
            line = raw.decode("utf-8", errors="replace").rstrip("\n")
            if not line:
                continue
            tf.write(line + "\n"); tf.flush()
            sys.stdout.write(line + "\n"); sys.stdout.flush()
            # Circuit-breaker: a looping gateway run burns real metered money
            # fast; kill it once cumulative spend crosses the dollar cap (ARCH-185)
            # OR cumulative tokens cross the token cap (ARCH-245 — the backstop
            # that still fires when an unpriced model logs spend as $0).
            if ((cost_cap is not None or token_cap is not None)
                    and (time.monotonic() - last_cost_check) >= _COST_CHECK_INTERVAL_S):
                last_cost_check = time.monotonic()
                gw_usd, gw_ti, gw_to, gw_has = _read_gateway_spend(spend_log)
                breach = _cap_breach_reason(gw_usd, gw_ti + gw_to, gw_has,
                                            cost_cap, token_cap)
                if breach:
                    kind, reason = breach
                    cost_stop_reason = reason
                    T.write_owner_only(run_dir / "cost-killed.txt", reason + "\n")
                    # don't respawn a runaway; marker names which cap fired (the
                    # respawn gate only existence-checks this, but keep audit honest)
                    T.write_owner_only(run_dir / "no-fallback", kind + "\n")
                    print(f"{run_dir.name}: COST CAP — {reason}; terminating.",
                          file=sys.stderr)
                    proc.terminate()
                    try:
                        proc.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                    break
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            etype = event.get("type")
            if etype == "assistant":
                message = event.get("message", {}) or {}
                for block in message.get("content", []):
                    if block.get("type") == "tool_use":
                        pending[block["id"]] = {
                            "timestamp": T.now_iso(),
                            "tool_name": block.get("name", ""),
                            "input": block.get("input", {}),
                            "start_ns": time.monotonic_ns(),
                        }
                # Per-turn usage, for the cost-partial.json checkpoint below —
                # the same field cost_join.co_main_loop_node and
                # subagent-telemetry-emit.py already sum for a session with no
                # terminal self-reported total. T.UsageDedup dedupes on
                # (message.id, requestId): Claude Code writes the same
                # assistant response into the stream more than once with
                # byte-identical usage (ARCH-383); summing every occurrence
                # double-counts. A record with neither key is counted, never
                # collapsed with other keyless ones.
                turn_model = message.get("model")
                turn_usage = message.get("usage")
                if turn_model and isinstance(turn_usage, dict):
                    if not usage_dedup.is_duplicate(message.get("id"), event.get("requestId")):
                        try:
                            turn_tokens = {
                                k: int(turn_usage.get(k, 0) or 0)
                                for k in ("input_tokens", "output_tokens",
                                         "cache_read_input_tokens",
                                         "cache_creation_input_tokens")
                            }
                            # TTL breakdown (1h vs 5m cache writes), when this
                            # turn's usage carries one — Claude Code on a
                            # subscription writes at the 1-hour TTL, and
                            # T.cost_from_usage needs this to price it at the
                            # 1-hour rate instead of the 5-minute rate.
                            turn_cache_creation = turn_usage.get("cache_creation")
                            turn_cc_tokens = {
                                k: int(turn_cache_creation.get(k, 0) or 0)
                                for k in ("ephemeral_1h_input_tokens", "ephemeral_5m_input_tokens")
                            } if isinstance(turn_cache_creation, dict) else None
                        except Exception as exc:
                            # ANY malformed usage field must not crash this
                            # loop (it also enforces the cost/token cap below)
                            # — skip only this turn's usage and keep draining.
                            # A bare (TypeError, ValueError) tuple here was
                            # round 2's mistake (round 3, security-reviewer
                            # finding on agent-platform#592): int(float("inf"))
                            # raises OverflowError, which that tuple didn't
                            # catch, so an Infinity usage field still unwound
                            # the loop. The run fully controls this JSON
                            # (arbitrary Bash in its own run dir) so the exact
                            # shape isn't enumerable — catch broadly instead of
                            # re-typing to each newly observed failure mode.
                            _log_stream_note(
                                run_dir,
                                f"{run_dir.name}: cost-partial usage skipped "
                                f"on {type(exc).__name__}: {exc}\n")
                        else:
                            acc = usage_by_model.setdefault(turn_model, {})
                            for k, v in turn_tokens.items():
                                acc[k] = acc.get(k, 0) + v
                            if turn_cc_tokens is not None:
                                acc_cc = acc.setdefault("cache_creation", {})
                                for k, v in turn_cc_tokens.items():
                                    acc_cc[k] = acc_cc.get(k, 0) + v
            elif etype == "user":
                for block in event.get("message", {}).get("content", []):
                    if block.get("type") != "tool_result":
                        continue
                    pend = pending.pop(block.get("tool_use_id"), None)
                    if pend is None:
                        continue
                    raw_content = block.get("content", "")
                    if isinstance(raw_content, list):
                        summary = "\n".join(b.get("text", "") for b in raw_content if isinstance(b, dict))
                    else:
                        summary = str(raw_content)
                    duration_ms = int((time.monotonic_ns() - pend["start_ns"]) / 1_000_000)
                    T.append_tool_call(
                        run_dir,
                        timestamp=pend["timestamp"],
                        tool_name=pend["tool_name"],
                        input=pend["input"],
                        result_summary=summary[:500],
                        duration_ms=duration_ms,
                        is_error=bool(block.get("is_error")),
                    )
            elif etype == "result":
                final_event = event
                # Terminal event. If the process doesn't close stdout on its
                # own within the grace window, reap it so this loop can end.
                if reaper is None:
                    reaper = threading.Timer(
                        REAP_GRACE_SECONDS, _reap_lingering, args=(proc, run_dir))
                    reaper.daemon = True
                    reaper.start()
            if (time.monotonic() - last_partial_write) >= _COST_PARTIAL_WRITE_INTERVAL_S:
                last_partial_write = time.monotonic()
                try:
                    _write_cost_partial_checkpoint(run_dir, usage_by_model)
                except Exception as exc:
                    # ANY exception here (a symlink at the checkpoint's temp
                    # path, a permission error, a corrupt meta.json) must not
                    # unwind this loop — see the docstring above.
                    _log_stream_note(
                        run_dir,
                        f"{run_dir.name}: cost-partial checkpoint failed on "
                        f"{type(exc).__name__}: {exc}\n")
            if (private_objects_dir is not None
                    and (time.monotonic() - last_live_import) >= _LIVE_IMPORT_INTERVAL_S):
                last_live_import = time.monotonic()
                try:
                    RS.import_private_objects(git_dir, private_objects_dir, remove=False)
                except (OSError, subprocess.CalledProcessError) as exc:
                    # Same resilience rule as the cost-partial checkpoint just above: a
                    # transient failure here (a concurrent write mid-enumeration, a full
                    # disk) must not unwind the loop — the end-of-run import still runs
                    # unconditionally once the run exits, with `remove=True`.
                    _log_stream_note(
                        run_dir,
                        f"{run_dir.name}: live import of private objects failed on "
                        f"{type(exc).__name__}: {exc}\n")
    if reaper is not None:
        reaper.cancel()
    return final_event, cost_stop_reason


def _read_gateway_spend(path: Path) -> tuple[float, int, int, bool]:
    """Sum usd + tokens from a gateway_spend.jsonl file.

    Returns (total_usd, total_tokens_in, total_tokens_out, has_record). The
    per-call rows are the cumulative truth for a gateway run, so usd and the token
    counts must come from the SAME source — sourcing usd here but tokens from the
    final event's `usage` records real summed dollars against last-turn-only
    tokens (the misleading split agent-summary's per-model breakdown exposed).
    Returns (0.0, 0, 0, False) when the file is missing or empty — the caller uses
    estimate_fallback in that case.
    """
    if not path.exists():
        return 0.0, 0, 0, False
    total = 0.0
    tokens_in = 0
    tokens_out = 0
    found = False
    try:
        with path.open() as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                record = json.loads(line)
                total += float(record.get("usd", 0.0) or 0.0)
                tokens_in += int(record.get("tokens_in", 0) or 0)
                tokens_out += int(record.get("tokens_out", 0) or 0)
                found = True
    except (OSError, json.JSONDecodeError, ValueError):
        return 0.0, 0, 0, False
    return round(total, 6), tokens_in, tokens_out, found


def _write_cost_partial_checkpoint(run_dir: Path, usage_by_model: dict[str, dict[str, int]]) -> None:
    """Checkpoint spend-so-far for a run still executing (cost-partial.json),
    from the SAME sources `_resolve_cost` reads at finalisation, so the two
    figures can never disagree in method. What the written `usd` means
    depends on which branch fires — see `write_cost_partial`'s docstring
    (telemetry.py) for the full statement; summarised here since this is the
    function that picks the branch:

    Gateway spend log first, when one exists — it is the finalisation-time
    source of truth for a gateway run too (`_resolve_cost`'s first branch),
    written per-request DURING the run, so reading it here is byte-identical
    to what the close will read, just earlier: real metered spend, a genuine
    floor. Otherwise price the per-turn `usage` seen in the stream so far via
    `cost_from_usage` — the same fallback `cost_join.co_main_loop_node` and
    subagent-telemetry-emit.py already use for a session with no
    self-reported total. There is no mid-run equivalent of the CLI's
    terminal `total_cost_usd` (the anthropic_cli branch's source): it is
    emitted once, in the final `result` event, so a still-running anthropic
    session has no exact-total source to read yet. This fallback is NOT that
    total and NOT a floor — it's the run's own summed token usage priced at
    list rate, measured by the round-1 reviewer at -12% to +16% against the
    eventual `cost.json` figure across five finished runs from one day
    (round 2 on this PR), in both directions. Enough to act on, not a bound,
    and not to be quoted as one. A no-op while neither source has anything (a
    run too young to have completed a turn or logged a gateway request)."""
    spend_log = run_dir / "gateway_spend.jsonl"
    gw_usd, gw_tokens_in, gw_tokens_out, has_record = _read_gateway_spend(spend_log)
    if has_record:
        try:
            model_used = (T.read_meta(run_dir) or {}).get("model")
        except (OSError, json.JSONDecodeError):
            model_used = None
        model_used = GATEWAY_GROUP_MODELS.get(model_used, model_used) if model_used else "?"
        T.write_cost_partial(
            run_dir,
            by_model={model_used: {"tokens_in": gw_tokens_in, "tokens_out": gw_tokens_out,
                                   "usd": gw_usd}},
            cost_source="gateway_spend_log")
        return
    if usage_by_model:
        T.write_cost_partial(run_dir, by_model=T.cost_from_usage(usage_by_model, where=run_dir.name),
                             cost_source="estimate_fallback")


def _elapsed_minutes(run_dir: Path) -> float:
    """Minutes between started_at and ended_at in meta.json.

    ended_at is written by T.update_meta immediately before this is called.
    Returns 0.0 when either timestamp is missing or malformed.
    """
    try:
        meta = json.loads((run_dir / "meta.json").read_text())
        started = meta.get("started_at") or ""
        ended = meta.get("ended_at") or ""
        if not started or not ended:
            return 0.0
        t0 = datetime.fromisoformat(started.replace("Z", "+00:00"))
        t1 = datetime.fromisoformat(ended.replace("Z", "+00:00"))
        return max(0.0, (t1 - t0).total_seconds() / 60.0)
    except (OSError, json.JSONDecodeError, ValueError):
        return 0.0


def _resolve_cost(run_dir: Path, final_event: dict | None, agent: dict) -> tuple[dict, str]:
    """Decide cost.json's (by_model, cost_source).

    The gateway spend log is the source of truth for a gateway run and is written
    per-request DURING the run, so it holds the real cost even when the run errored
    with no terminal event. Read it FIRST, independent of `final_event` (ARCH-185):
    the prior code computed cost only inside `if final_event:`, so an errored/looping
    gateway run wrote cost.json `usd: 0` — and both the scorecard (ARCH-107) and the
    budget cap (ARCH-156, which sums cost.json across run dirs) went blind to real
    out-of-pocket spend (the 2026-06-18 $23 kimi loop that evaded the $80 cap).
    """
    spend_log = run_dir / "gateway_spend.jsonl"
    gw_usd, gw_tokens_in, gw_tokens_out, has_record = _read_gateway_spend(spend_log)

    # Resolve the model: the terminal event when present, else the spawned model
    # recorded in meta (an errored run has no final event but meta has its model).
    # The gateway echoes its group name ("deepseek") as the response model;
    # normalize back to the provider string so is_gateway_model() holds.
    # Resolution order matters (ARCH-211): the terminal event's model is most
    # authoritative, then meta's `model` (the ACTUAL spawned model — including an
    # AGENT_FULL_MONTY override that forces a gateway agent onto sonnet), and only
    # then the agent's roster alias as a last resort. The old order put the roster
    # alias ahead of meta (`final_event.get("model") or model_id(alias)`), so a
    # forced-sonnet full-monty run with an empty terminal-event model was mislabeled
    # as the agent's configured gateway model (e.g. bug-fixer → zai/glm-5.2) and
    # then estimate_fallback-priced — phantom GLM cost (~$11.53 on 2026-06-20) on
    # runs that actually ran sonnet on the subscription (real marginal ~$0).
    model_used = None
    if final_event:
        model_used = final_event.get("model")
    if not model_used:
        model_used = (T.read_meta(run_dir) or {}).get("model")
    if not model_used:
        model_used = model_id(agent.get("model_alias"))
    model_used = GATEWAY_GROUP_MODELS.get(model_used, model_used) if model_used else None

    if has_record and model_used and is_gateway_model(model_used):
        # Real metered spend wins, error or not. Tokens come from the spend log too
        # (cumulative across all calls) so cost.json is internally consistent.
        return ({model_used: {"tokens_in": gw_tokens_in, "tokens_out": gw_tokens_out,
                              "usd": gw_usd}}, "gateway_spend_log")

    if final_event:
        usage = final_event.get("usage", {}) or {}
        tokens_in = sum(int(usage.get(k, 0) or 0) for k in
                        ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        tokens_out = int(usage.get("output_tokens", 0) or 0)
        if model_used and is_gateway_model(model_used):
            # Gateway model but NO spend record: fail-closed — do NOT write usd: 0.
            # Use the in-flight estimate and flag the gap (ARCH-065/069). Floor to
            # 0.0001 so the "never usd: 0" invariant holds when timestamps are absent.
            elapsed_min = _elapsed_minutes(run_dir)
            return ({model_used: {"tokens_in": tokens_in, "tokens_out": tokens_out,
                                 "usd": max(round(elapsed_min * 0.15, 4), 0.0001)}},
                    "estimate_fallback")
        # Anthropic branch — byte-identical to the pre-gateway implementation.
        return ({model_used: {"tokens_in": tokens_in, "tokens_out": tokens_out,
                             "usd": float(final_event.get("total_cost_usd", 0.0) or 0.0)}},
                "anthropic_cli")

    # No gateway record and no terminal event — genuinely no cost data to record.
    return ({}, "anthropic_cli")


# The marker every rescued review carries. `review-post` refuses a body containing
# it (ARCH-397 rescue), because a prose warning inside a file is a control an agent
# reads and may skip, and the readers of that file ARE agents. A co under time
# pressure that relays a recovered review would produce a stamp carrying a real
# run-id and a real commit over second-hand substance — ARCH-193's authenticity
# gap moved one layer up, from the stamp to what is behind it (security-reviewer,
# PR #395). Overridable, deliberately: the recovered text is sometimes exactly
# what a human wants to post after reading it, and that should be a conscious act.
# Digests of every review rescued on this machine. `review-post` refuses a body
# whose digest is here, which is what makes the control survive a caller stripping
# the marker line out (security-reviewer, PR #395 round 2). Append-only and
# owner-only; a missing or unreadable index degrades to "not a known rescue",
# because a posting path must not break when telemetry is absent.
RESCUE_DIGEST_INDEX = Path.home() / ".agentctl" / "rescued-review-digests"

# Written by `review-post` itself, into ITS OWN run's directory, at the moment the
# Library refuses the review record (issue_01M3830J6EKZ394Q8AVYRQGN40 round 2). The
# generic ARCH-397 downgrade below only knows a called review-post left no stamp; it
# has no way to say WHY without this — and falls back to naming the PRE-Library-write
# cause (the PR head moving under the pin), which is the wrong explanation for a
# Library refusal and points whoever reads it at a stale commit that was never the
# problem. Best-effort like every other rescue write: a run dir it cannot resolve (a
# runless review has none) or cannot write to must never turn a correctly-refused
# post into a crash.
_LIBRARY_REFUSAL_MARKER_FILENAME = "review-post-library-refusal.json"


def _rescued_digest(text: str) -> str:
    """A digest of review substance, insensitive to whitespace and to the marker.

    Normalised so the obvious edits — reflowing, deleting the marker line, trimming
    trailing blanks — do not slip a rescued review past the refusal. It is not meant
    to survive a rewrite: someone who rewrites the review has written one.
    """
    body = "\n".join(
        ln.strip() for ln in text.splitlines()
        if ln.strip() and RESCUED_REVIEW_MARKER not in ln)
    return hashlib.sha256(body.encode()).hexdigest()


RESCUED_REVIEW_MARKER = "<!-- agentctl-rescued-review: not posted by its own run -->"


def _rescue_unposted_review_inner(run_dir, run_id: str, pr: str | None = None,
                                  reviewed_commit: str | None = None
                                  ) -> tuple[str | None, bool | None]:
    """Save a review that was written and never posted, and say whether the run TRIED.

    ARCH-397 marks a review run errored when it ends with no stamp, which is right:
    the absence has to be loud. But the review itself is usually sitting complete in
    the run log, and recovering it meant hand-parsing JSONL — done four times in one
    Keel session on 2026-08-12/13, each time to recover a full review that had cost
    about a dollar. The cost of that failure was never the tokens; it was the digging.

    The text is SURFACED, never posted. Auto-posting would have laundered the one
    review withheld on purpose that session, by a reviewer that refused to stamp a
    head which had moved under it.

    **`attempted` is read from the TRANSCRIPT, not `tool_calls.jsonl`, and the
    difference decides whether this is honest.** `tool_calls.jsonl` records only
    tool_use blocks agentctl matched to a tool_result, so a call whose result never
    arrived — the exact death this runs after — is absent, and the check would fail
    OPEN in the one case it exists for. It also stores `result_summary`, free text
    from whatever the run read, so a bare substring test flips on any run that merely
    READ the string "review-post" — which every reviewer of this repository does,
    repeatedly, and which a PR author could arrange on purpose. Both failures were
    found on PR #395; `_run_touched_the_outside_world` learned the same lesson at
    #351 and this now follows it.

    Returns None for `attempted` when the transcript is missing or unreadable, rather
    than False. "It did not try" and "we cannot tell what it did" are different
    claims, and reporting the second as the first is the false confidence ARCH-397
    exists to remove.
    """
    # SELF-REPORTED, AND UNVERIFIED. The transcript is written by the run being
    # judged, so this says what the model EMITTED, not what actually executed: a
    # command denied by the run's own allowlist, or malformed to fail harmlessly,
    # still reads as an attempt. That is tolerable here because it feeds one
    # diagnostic sentence — `exit_status` stays errored either way, and the
    # authoritative gate `_review_run_posted_stamp` reads the PR's real comments
    # independently of anything the run wrote. Do NOT wire this into anything
    # consequential (an auto-re-dispatch policy, a merge decision) without first
    # replacing it with evidence the run cannot author (security-reviewer, PR #395).
    attempted: bool | None = None
    transcript = run_dir / "transcript.jsonl"
    if transcript.exists():
        try:
            attempted = False
            for name, inp in _transcript_tool_uses(transcript):
                if name != "Bash":
                    continue
                if _REVIEW_POST_CALL_RE.search(str(inp.get("command") or "")):
                    attempted = True
                    break
        except OSError:
            attempted = None

    # A rescue may already sit in this run's directory — `review-post` itself
    # writes one before it starts any wait that could outlive it (issue_
    # 01M26ZWF6XRY44B1F0HEJ43FVB), so a run whose review-post call was killed
    # mid-CI-wait reaches here with the file already in place. That copy is the
    # LITERAL review body; re-deriving "text" from the run's last chat message
    # below and overwriting the file with it would replace exact prose with
    # whatever the model happened to say as its final turn, which is a strictly
    # worse recovery of the SAME review. Read it back rather than clobber it.
    existing = run_dir / "unposted-review.md"
    if existing.exists():
        try:
            existing_text = existing.read_text()
        except OSError:
            existing_text = None
        if existing_text:
            # This call only happens once finalize has confirmed no stamp reached
            # the PR (the caller's own gate) — the moment the digest is MEANT to be
            # written, per `_write_rescue_files`'s docstring. The pre-wait persist
            # that put the file here deliberately skipped it, because at write time
            # it could not yet tell a review about to succeed from one about to be
            # lost.
            try:
                T.write_owner_only(RESCUE_DIGEST_INDEX,
                                   f"{pr or '-'}\t{_rescued_digest(existing_text)}\n",
                                   append=True)
            except OSError:
                pass
            return existing_text, attempted

    text = None
    try:
        log = run_dir / "detach.out.log"
        if log.exists():
            for line in log.read_text(errors="ignore").splitlines():
                if '"type":"result"' not in line and '"type": "result"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except (ValueError, TypeError):
                    # A run that died mid-write leaves a truncated final line. Skip
                    # it and keep whatever complete record came before.
                    continue
                # "Parses as JSON" is not "is a record". A line whose top-level value
                # is a list slips past the substring pre-filter above and then raises
                # AttributeError on .get — which the outer catch would turn into a
                # total loss, discarding a review already recovered from an EARLIER
                # line. One bad record must never erase results in hand
                # (reviewer, PR #395 round 2).
                if not isinstance(rec, dict):
                    continue
                # `result` is trusted to be a STRING here because the digest calls
                # .splitlines() on it. A dict result raises AttributeError, which
                # escapes to the outer total catch and discards both the recovered
                # text and the correctly-computed `attempted` flag — after which
                # the message says "No review text was found", which is false: text
                # was found and the code choked on its shape. Same guard this file
                # already applies to the identical field when scanning transcripts
                # (reviewer, PR #395 round 3).
                if rec.get("type") == "result" and isinstance(rec.get("result"), str) \
                        and rec["result"]:
                    text = rec["result"]
    except OSError:
        pass

    if text:
        _write_rescue_files(
            run_dir, run_id, pr, text,
            "Recovered from the run log by agentctl at finalize time (ARCH-397). "
            "It reached no PR. Verify it against the diff before acting on it.",
            reviewed_commit=reviewed_commit)
    return text, attempted


def _write_rescue_files(run_dir, run_id: str, pr: str | None, text: str, note: str,
                        *, reviewed_commit: str | None = None,
                        write_digest: bool = True) -> None:
    """Write TEXT into this run's durable rescue slot: `unposted-review.md` (survives
    the worktree reap, ARCH-344) and, when `write_digest`, the digest index (survives
    a stripped or edited marker line, security-reviewer PR #395 round 2). Shared by
    the finalize-time recovery above and `review-post`'s own pre-wait persist
    (issue_01M26ZWF6XRY44B1F0HEJ43FVB) so both leave the same re-postable shape.

    `reviewed_commit`, when known, is recorded in the file's own header — not only
    in whatever message a caller happens to print alongside it. A re-post needs
    both the run-id (already in the header) and the reviewed commit to authenticate
    (`review_protocol.resolve_run_facts` reads an ended run's meta.json directly),
    and the rescue FILE is the one artifact guaranteed to survive whichever of the
    several causes above actually did the killing (issue_01M26ZWF6XRY44B1F0HEJ43FVB).

    `write_digest=False` is for the pre-wait persist ONLY, and it is load-bearing,
    not a style choice. That call runs on EVERY qualifying review-post invocation —
    most of which go on to post successfully, no kill involved. The digest index is
    what `_is_rescue` checks to REFUSE relaying a review without `--allow-rescued`;
    writing it before the outcome is known would flag this run's own text as
    "rescued" the moment it is merely about to be posted, so a second, ordinary
    re-post of byte-identical prose (test_review_post_reposting_the_same_review_is_
    one_record_and_still_posts) would refuse itself. The digest is the record that
    THIS review is CONFIRMED lost, and only finalize — which reads whether a stamp
    actually reached the PR — is in a position to confirm that; it adds the digest
    itself when it reads this file back (see the caller above).

    Best-effort, matching `_rescue_unposted_review`'s contract: a telemetry write
    must never take down the caller, whether that caller is finalize or a
    review-post still trying to post for real.
    """
    if write_digest:
        try:
            # The DIGEST is the control; the marker below is only a courtesy to a
            # human reader. A marker inside the body is defeated by deleting one
            # line, which is the same "an agent reads it and may skip it" weakness
            # that made a prose warning insufficient in the first place
            # (security-reviewer, PR #395 round 2). Hashing the text means the
            # refusal survives any edit that leaves the review substantively intact.
            T.write_owner_only(RESCUE_DIGEST_INDEX,
                               f"{pr or '-'}\t{_rescued_digest(text)}\n", append=True)
        except OSError:
            pass
    try:
        T.write_owner_only(
            run_dir / "unposted-review.md",
            f"{RESCUED_REVIEW_MARKER}\n"
            f"# Review written by {run_id} and never posted\n"
            + (f"Reviewed commit: {reviewed_commit}\n" if reviewed_commit else "")
            + f"\n{note} `review-post` REFUSES a body carrying the marker above, so "
              f"relaying this as a verdict takes a deliberate override rather than a "
              f"paste.\n\n{text}\n")
    except OSError:
        pass


def _rescue_unposted_review(run_dir, run_id: str, pr: str | None = None,
                            reviewed_commit: str | None = None
                            ) -> tuple[str | None, bool | None]:
    """`_rescue_unposted_review_inner`, unable to fail.

    TOTAL BY DESIGN, the same rule `_scan_rate_limits` states: this is an optional
    enrichment on the finalize path, and nothing it could learn is worth a run
    failing to finalize. The inner function catches `OSError` around each read and
    the write, which is not enough — a `UnicodeEncodeError` on review prose under a
    stripped locale is not an `OSError`, and neither is a `TypeError` from an
    unexpected record shape. Neither call site of `_finalize_run` wraps it, so an
    escape would propagate past `R.remove_run` and `_reap_review_worktree`: the run
    would stay registered and its worktree would leak, which is a worse outcome than
    losing a rescue (reviewer, PR #395).

    Degrades to (None, None), which the caller already handles as "no text, and we
    cannot tell whether it tried".
    """
    try:
        return _rescue_unposted_review_inner(run_dir, run_id, pr, reviewed_commit)
    except Exception:  # noqa: BLE001 — see above; the catch is the point
        return None, None


def _run_facts_mismatch_reason(run_id: str, *, pr: str, repo_stamp: str,
                               reviewed_commit: str, agent: str) -> str | None:
    """Does dispatch run `run_id` actually own this `review-post` call — the same
    PR, review-class role, repo and reviewed commit the call's own arguments
    claim (security-reviewer, PR #725 round 2)? Answered by
    `review_protocol.authenticate_run` (the run-identity half of `authenticate`),
    not `authenticate`: the posted-record half needs the verdict this call has not
    recorded yet, since the record is written after this check (CQ·399).

    Run-ids are not secret: every posted stamp and every `agentctl status`/`wait`
    prints one, so a caller can name any run-id on the machine. `_persist_review_
    before_wait` calls this to decide whether it may write into the run `run_id`
    names; a non-None result there means "not this call's own run," and the write
    is withheld (see that function's docstring for what withholding does and does
    not protect — this function only ANSWERS the question, it does not enforce
    anything itself).

    EVERY COMPARED FIELD MUST MATCH; A MISSING RECORDED VALUE IS A MISMATCH, NEVER
    A SKIP (security-reviewer, PR #725 round 3). `review_protocol.authenticate_run` —
    reused below for the agent-role check, and the ONE run authenticator this shares
    with `review-status`'s posted-stamp check (ARCH-193), so the two can never
    authenticate a run the other would reject — intentionally SKIPS its repo and
    review_sha comparisons when `facts.repo`/`facts.review_sha` is empty, so a
    legacy run from before those fields existed degrades to the weaker checks
    instead of failing every old stamp closed. That degradation is right for a
    POSTED stamp review-status reads off a PR (the run already happened; a human
    can still see the stamp's own claimed repo/commit in the comment). It is wrong
    for THIS gate: here `repo_stamp`/`reviewed_commit` are the CALL's own claims
    about a run it has not proven it owns, so an empty recorded field must not let
    the call's claim stand unchallenged. The repo and review_sha checks just below
    enforce that — strictly, and only for this caller — before handing off to
    `authenticate_run()` for the agent-role comparison (already strict: an empty
    `facts.agent` is not a review-class agent, so it fails `is_review_class`, not
    a skip).

    `facts.pr` is compared directly, before any of the above — `RunFacts.pr`
    exists only for `run-register-api`'s Library-facing facts route, by that
    dataclass's own docstring, so `authenticate_run()` never touches it — and a
    missing/falsy `facts.pr` is a mismatch exactly like a missing repo or
    review_sha: a run dispatched via `--review-sha` with no `--pr` (a real,
    current dispatch shape) records no PR to compare, so treating that absence as
    a match would let an unpinned caller name any `--pr` against it.

    Returns None when `run_id` is empty (the runless `--allow-unverified` path,
    which has no run to authenticate against — unaffected by this check) or when
    every compared field — pr, repo, review_sha, agent-role — matches. Otherwise a
    human-readable mismatch reason.
    """
    if not run_id:
        return None
    facts = _resolve_run_facts(run_id)
    if not facts.pr or str(facts.pr) != str(pr):
        return (f"run {run_id} has no recorded PR to compare against PR {pr}"
                if not facts.pr else
                f"run {run_id} was dispatched for PR {facts.pr}, not PR {pr}")
    if not facts.repo or RP._repo_basename(facts.repo) != RP._repo_basename(repo_stamp):
        return (f"run {run_id} has no recorded repo to compare against '{repo_stamp}'"
                if not facts.repo else
                f"run {run_id} was dispatched for repo '{facts.repo}', "
                f"not '{repo_stamp}'")
    if not facts.review_sha or not RP._sha_match(facts.review_sha, reviewed_commit):
        return (f"run {run_id} has no recorded reviewed commit to compare against "
                f"{reviewed_commit}" if not facts.review_sha else
                f"run {run_id} was pinned to {facts.review_sha}, not {reviewed_commit}")
    candidate = RP.ReviewStamp(version=RP.PROTOCOL_VERSION, pr=str(pr), repo=repo_stamp,
                              reviewed_commit=reviewed_commit, verdict="", agent=agent,
                              run_id=run_id)
    return RP.authenticate_run(candidate, facts, review_agents=_REVIEW_AGENTS)


def _record_posted_review(run_id: str, *, pr: str, repo_stamp: str, reviewed_commit: str,
                          agent: str, verdict: str) -> str | None:
    """Record the verdict and PR this `review-post` is about to post into the posting
    run's own meta.json (CQ·399), so `review_protocol.authenticate` can hold the stamp
    to them. Returns a refusal reason, or None when the post may go ahead.

    Writes only when the named run's recorded facts agree with this call's arguments
    (`_run_facts_mismatch_reason`, the test the rescue write uses). For any other run the
    stamp still posts, and the merge gate discards it as unauthenticated; writing into
    that run would replace its record.

    That test does not show who is calling. THE LIMIT: any process running as this user
    with Bash can get a counted APPROVE that no reviewer posted, by two routes.
    (1) Claim-first: the process runs `review-post --run-id <reviewer run>` before that
    reviewer posts, from a process whose environment does not set both AGENTCTL_RUN_ID
    and AGENTCTL_REVIEW_SHA — a co, the steward, cron, or any shell outside a pinned
    dispatched run. The record is written for that run, and WRITE-ONCE below then
    refuses the reviewer's real REQUEST_CHANGES. (2) Direct write:
    the process writes `review_verdict` and `review_pr` into the reviewer run's meta.json
    (`T.update_meta` does not freeze them) and posts a stamp. WRITE-ONCE does not apply
    to that route. `review_protocol._posted_record_mismatch` then reads the forged record
    and passes the stamp. PR #793 denies a dispatched run's Bash, Write and Edit writes
    into its own run record and run directory, and binds its verdict post to a tool
    scoped to that run. It confines dispatched runs only: a co or the steward runs
    `review-post` from Bash, outside any sandbox, so both routes stay open to any such
    process running as this user even once #793 ships. That is the accepted limit;
    the documented rescue flow (ARCH-397, `cmd_review_post`'s `--allow-rescued`
    advice) is itself the claim-first shape, re-posting a dead run's record with
    `--run-id` and no pin.

    WRITE-ONCE. A second post by the same run with another verdict or PR would replace
    the recorded one, and the earlier genuine stamp's copy would then authenticate. That
    is the forgery this record exists to refuse, so the second post is refused before
    anything is written or posted. The same verdict and PR again is allowed: a rescued
    re-post carries the verdict the run already recorded.
    """
    if not run_id:
        return None
    if _run_facts_mismatch_reason(run_id, pr=pr, repo_stamp=repo_stamp,
                                  reviewed_commit=reviewed_commit, agent=agent) is not None:
        return None
    facts = _resolve_run_facts(run_id)
    if not facts.posted_verdict and not facts.posted_pr:
        T.update_meta(facts.run_dir, review_verdict=verdict, review_pr=pr)
        return None
    if (facts.posted_verdict, facts.posted_pr) == (verdict, pr):
        return None
    return (f"run {run_id} already posted {facts.posted_verdict} on PR {facts.posted_pr}; "
            f"a post of {verdict} on PR {pr} would replace that record, and the stamp "
            f"posted earlier would no longer authenticate")


def _persist_review_before_wait(run_id: str, pr: str, repo_stamp: str, reviewed_commit: str,
                                agent: str, text: str) -> None:
    """`review-post` calling this on ITSELF, before it does anything that can block
    long enough to be killed (issue_01M26ZWF6XRY44B1F0HEJ43FVB).

    PR #1127 (2026-07-31): both reviewers reached APPROVE, `review-post` was waiting
    out a PENDING required check (`_approve_blocked_by_ci`, up to
    CI_PENDING_WAIT_SECS), a headless reviewer's Bash tool backgrounds a command
    past 120s, the run's turn ended, the run was reaped, and the waiting
    review-post process died with it — with NOTHING written anywhere: not the
    Library record (written only after the wait, near the end of this function),
    not a PR comment, not even ARCH-397's rescue, which only fires at the
    REVIEWING RUN's own finalize and recovers the run's last chat message, not
    this file's contents. Reproduced on current main (SIGTERM mid-wait leaves no
    trace) before this was written.

    So the fix does not live in a signal handler — SIGTERM cleanup in Python is not
    reliable enough to hang a durable write off of — it lives in ordering: persist
    the review BEFORE the risky window starts, using the exact same rescue slot
    ARCH-397 already made every other code path check first
    (`_rescue_unposted_review_inner` reads it back rather than overwriting it, and
    a killed wait now leaves the SAME artifact a Library refusal does: a
    re-postable `unposted-review.md` plus the finalize-time downgrade that makes
    the run read errored rather than completed).

    A NO-OP, NOT ONLY WHEN `run_id` NAMES NO RUN, BUT ALSO WHEN IT NAMES A REAL RUN
    THAT IS NOT THIS CALL (security-reviewer, PR #725 round 2). Run-ids are not
    secret — every posted stamp and every `agentctl status`/`wait` prints one — so
    `run_id` here is caller-supplied, untrusted input, and the original version of
    this function wrote straight into whatever directory it named. Any same-user
    process could then run `review-post --run-id <victim-run-id> ...` and clobber a
    live review's rescue slot with chosen text, which `_rescue_unposted_review_inner`
    would later surface as that run's "lost review" verbatim. `_run_facts_mismatch_
    reason` closes that: the target run's own meta.json must independently record
    the same PR, review-class role, repo and reviewed commit this call is running
    with, and a run whose meta.json does not record one of those (an unpinned
    `--review-sha`-only dispatch, missing its `pr`, being the concrete case —
    security-reviewer, PR #725 round 3) does not get a pass on that field: a
    missing recorded value is a mismatch, never a match by default. See that
    function's own docstring for why this is STRICTER here than the degradation
    `review_protocol.authenticate` applies to a POSTED stamp's run-id (ARCH-193),
    which this reuses only for the agent-role check. This still lets the call
    POST (an inauthentic run-id is the gate's problem at `review-status` time, same
    as any other unverified stamp); it only withholds the WRITE into a run this
    call cannot prove is its own.

    THIS PROTECTS ONLY THAT ONE THING. It does not make the rescue slot itself
    tamper-proof: run directories are mode 700 owned by the single user this
    machine runs everything as, so any process running as that same user can
    write `unposted-review.md` directly, bypassing `review-post` (and this check)
    entirely — same-user write access is not a boundary this function can enforce
    from inside a `review-post` invocation. That gap belongs to the planted-run-
    directory class (issue_01M1JWB7M75SZ160VRJRCGARBF) and the review-record
    credential design (issue_01M3SJ2NSEB0QVMQPTZVTA0MJK), not to this function.

    Also a no-op when `run_dir` cannot be resolved at all (a runless review,
    `--allow-unverified`, has no run directory to write into — the same gap the
    Library-refusal marker write already accepts) or when `text` is itself a
    rescue relay (an `--allow-rescued` re-post of an already-rescued review; the
    caller passes `review_body` post-`_is_rescue`-check, so this only ever sees a
    fresh review).
    """
    if RESCUED_REVIEW_MARKER in text:
        return
    run_dir = _find_run_dir(run_id) if run_id else None
    if run_dir is None:
        return
    if _run_facts_mismatch_reason(run_id, pr=pr, repo_stamp=repo_stamp,
                                  reviewed_commit=reviewed_commit, agent=agent) is not None:
        return
    try:
        _write_rescue_files(
            run_dir, run_id, pr, text,
            "Written by review-post itself, before a wait that might outlive it "
            "(issue_01M26ZWF6XRY44B1F0HEJ43FVB). It may simply still be posting — "
            "check `agentctl status` for this run before treating it as lost.",
            reviewed_commit=reviewed_commit, write_digest=False)
    except Exception:  # noqa: BLE001 — a rescue write must never crash review-post
        pass


def _review_run_posted_stamp(*, repo: str, pr: str, run_id: str) -> bool | None:
    """Did the review run `run_id` leave its stamp on PR `pr`? (ARCH-397)

    A review run stamps with its own dispatch run-id (AGENTCTL_RUN_ID), so a stamp
    on the PR carrying this run-id is proof this run posted. Returns:
      True  — a stamp with this run-id is present (it posted),
      False — the PR was read and no such stamp exists (it did NOT post),
      None  — the check could not run (gh failure / no repo). The caller must NOT
              downgrade on None: a network blip must never manufacture a false
              "no review", which is the very false signal this exists to remove.
    """
    if not repo or not pr or not run_id:
        return None
    slug = repo if "/" in repo else f"convivy/{repo}"
    try:
        view = _gh_pr_json(str(pr), ["comments"], repo=slug)
    except (RuntimeError, json.JSONDecodeError, OSError):
        return None
    for c in view.get("comments") or []:
        s = RP.parse(c.get("body", ""))
        if s is not None and s.run_id == run_id:
            return True
    return False


# The ops-plane and KB tools that only READ. Everything else under those two MCP
# namespaces is treated as a write, so a tool added later refuses a retry until
# someone lists it here — the fail-closed direction, since the cost of getting
# this wrong is a duplicate issue on the operator's board or a duplicate KB document.
_OPS_READ_TOOLS = frozenset({
    "mcp__ops__issue_list", "mcp__ops__issue_get", "mcp__ops__bug_list",
    "mcp__ops__signal_get", "mcp__ops__signal_search", "mcp__ops__signal_list",
})
_KB_READ_TOOLS = frozenset({
    "mcp__kb__kb_search", "mcp__kb__kb_get", "mcp__kb__kb_list_topics",
    "mcp__kb__kb_leases",
})
# Shell commands that reach outside the worktree. A retry re-runs the prompt, so
# each of these would happen TWICE: a second PR, a second comment, a second
# review stamp, a second dispatched subagent. `gh api` is listed whole rather
# than by method — a read through it costs one declined retry, and parsing the
# method out of a shell string to decide is exactly the kind of cleverness that
# fails open.
_EXTERNAL_MUTATION_RE = re.compile(
    r"(?:^|[|&;(]|\s)(?:"
    r"git\s+push"
    r"|gh\s+(?:pr|issue)\s+(?:create|comment|review|edit|close|merge|reopen|ready)"
    r"|gh\s+(?:api|release|repo\s+create|workflow\s+run)"
    r"|agentctl\s+(?:review-post|publish|pr-open|spawn|kb\s+apply)"
    r"|curl\b[^\n]*(?:-X\s*(?:POST|PUT|PATCH|DELETE)|--data|-d\s)"
    # `eval "git push …"` and `bash -c "gh pr comment …"` put a QUOTE before the
    # verb, which the prefix anchor above does not match, so the whole list is
    # bypassed by one level of quoting (security-reviewer, #351 round 2). Refusing
    # on the wrapper itself closes that at near-zero false-positive cost: an agent
    # reaching for `eval` in a run that is about to be retried is rare, and one
    # declined retry is the price. A wrapper SCRIPT that calls `gh pr create`
    # internally is still out of reach — no command-string test can see inside it.
    r"|eval\s"
    # `-c` may abut its argument: `bash -c'git push'` is one shell word and runs,
    # while `\s` after `-c` does not match the quote (security-reviewer, #351
    # round 3). `eval` needs no equivalent — it cannot concatenate with its
    # argument without whitespace.
    r"""|(?:ba|z|)sh\s+-c[\s'\"]"""
    r")"
)


# A real `agentctl review-post` INVOCATION, not a mention. Anchored on the binary
# name so a command that merely names the string in an argument or a heredoc does
# not match (security-reviewer, PR #395).
_REVIEW_POST_CALL_RE = re.compile(r"\bagentctl\s+review-post\b")


def _run_touched_the_outside_world(run_dir: Path, worktree: Path) -> str | None:
    """A tool call this run made whose effect a RETRY would duplicate, or None.

    The file-change check cannot see any of these: an agent can file an ops-plane
    issue, write a KB document, comment on a PR or dispatch a subagent and then
    die on an API error without a byte changing in its worktree. Re-running the
    prompt then does all of it a second time — a duplicate issue on the board is
    the cleanest example (security-reviewer, #351).

    Reads the run's TRANSCRIPT rather than `tool_calls.jsonl`, and the difference
    is load-bearing. `tool_calls.jsonl` records only tool_use blocks agentctl
    MATCHED to a tool_result; a call whose result never arrived is absent from it.
    That is exactly the shape of the death this gate runs after — the connection
    dropped mid-response — so reading the matched log would fail OPEN in the one
    case it exists for (security-reviewer, #351 round 2). The transcript holds
    every tool_use block the model emitted, matched or not.

    An absent transcript returns None (nothing ran); an unreadable one refuses.
    """
    transcript = run_dir / "transcript.jsonl"
    if not transcript.exists():
        # `create_run_dir` writes this file EMPTY at spawn, so a real run always
        # has one. Absence means it was removed — by an agent's own Bash, or by
        # something operating on the run dir — and the honest reading of "the
        # record of what this run did is gone" is a refusal, not a clean bill
        # (security-reviewer, #351 round 3). An empty file still reads as "nothing
        # ran", which is the case this used to conflate absence with.
        return ("its transcript is missing, so there is no record of what it "
                "already did — refusing rather than assuming nothing")
    try:
        calls = list(_transcript_tool_uses(transcript))
    except OSError as e:
        return f"its transcript could not be read to check what it already did ({e})"
    # A trailing separator, so a SIBLING whose name merely starts with the same
    # string — `/runs/run-abc-evil` beside `/runs/run-abc` — does not read as
    # inside it (security-reviewer, #351 round 3).
    wt = os.path.realpath(worktree).rstrip(os.sep) + os.sep
    for name, inp in calls:
        if name.startswith("mcp__ops__") and name not in _OPS_READ_TOOLS:
            return f"it already called {name} — a retry would file a second one"
        if name.startswith("mcp__kb__") and name not in _KB_READ_TOOLS:
            return f"it already called {name} — a retry would write the KB twice"
        if name == "Bash":
            cmd = str(inp.get("command") or "")
            m = _EXTERNAL_MUTATION_RE.search(cmd)
            if m:
                return (f"it already ran `{m.group(0).strip()}`, which reaches "
                        f"outside the worktree — a retry would run it again")
        if name in ("Write", "Edit", "NotebookEdit"):
            # A write INSIDE the worktree is already covered by the file-change
            # check, and is the common case. One outside it is not, and is the
            # shape that edits a launchd plist or a file in another repo.
            #
            # realpath on BOTH sides: a symlink inside the worktree pointing out of
            # it would otherwise pass a plain string prefix test (security-reviewer,
            # #351 round 2). A relative path resolves against this process's cwd
            # rather than the agent's, so it will not match the worktree and
            # refuses — the fail-closed direction, and the right one for a path we
            # cannot place.
            path = str(inp.get("file_path") or "")
            if path and not os.path.realpath(path).startswith(wt):
                return (f"it already wrote {path}, outside its worktree — a retry "
                        f"would write it again")
    return None


def _transcript_tool_uses(transcript: Path):
    """Yield `(tool_name, input_dict)` for every tool_use block in a transcript.

    A malformed line is skipped rather than fatal: the transcript is appended
    live, so its last line can be a partial write from a process that died
    mid-flush — which is the very run this reads. Skipping one line loses at most
    the call it described; raising would lose all of them.
    """
    with transcript.open() as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") != "assistant":
                continue
            for block in (event.get("message") or {}).get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    inp = block.get("input")
                    yield block.get("name") or "", inp if isinstance(inp, dict) else {}


def _api_retry_refusal(*, run_dir: Path, worktree: Path,
                       agent_name: str) -> str | None:
    """Why a run that died on an API error must NOT be retried in place, or None
    when the retry is safe.

    A retry re-runs the SAME prompt from scratch in the SAME worktree, so it is
    safe exactly while the dead attempt left nothing behind. Each check below
    names a side effect a second attempt would DUPLICATE rather than replace —
    and duplication is the failure mode that matters here, because a second
    review stamp from one run-id, or a second pass over a half-written worktree,
    is worse than the manual re-dispatch this exists to save.

    Fails closed: an unreadable worktree or an unreadable PR refuses the retry.
    The cost of refusing is one re-dispatch a human was already doing.
    """
    if (run_dir / "no-fallback").exists():
        return ("a no-fallback marker is set — `kill --final`, or a cost/token "
                "cap fired; the run is meant to stay down")
    try:
        mod, add, dele = _changed_files(worktree, run_dir)
    except Exception as e:
        return f"its worktree could not be read to check for work it already did ({e})"
    touched = len(mod) + len(add) + len(dele)
    if touched:
        return (f"it already changed {touched} file(s) in the worktree, so a retry "
                f"would start on top of its half-finished state — publish or reset "
                f"the worktree and re-dispatch by hand")
    outside = _run_touched_the_outside_world(run_dir, worktree)
    if outside:
        return outside
    meta = T.read_meta(run_dir)
    if _is_review_agent(agent_name) and meta.get("pr"):
        posted = _review_run_posted_stamp(repo=meta.get("repo") or "",
                                          pr=str(meta.get("pr")),
                                          run_id=meta.get("run_id") or "")
        if posted is True:
            return "it already posted its review stamp before dying"
        if posted is None:
            return ("its PR could not be read to check for a stamp it may already "
                    "have posted, and two verdicts under one run-id would break "
                    "the gate that reads them")
    # The retry is a second spawn's worth of spend, and the daily cap can have
    # been crossed by the work that ran between this run's own gate and its
    # death. Only the CAPPED origins have a pool to breach — an interactive
    # dispatch is uncapped by decision (ARCH-156), which is why this asks the
    # same question `_budget_gate` does rather than a stricter one. Read the
    # ALREADY-RECORDED origin off this run's own meta.json (written once, at
    # spawn time, via the parent-inheritance `_run_origin` now uses) rather
    # than re-deriving one — there is no live process env to consult here, the
    # run already died.
    origin = meta.get("origin", T.DEFAULT_ORIGIN)
    if origin in B.CAPPED_ORIGINS:
        pool = B.POOL_BY_ORIGIN[origin]
        try:
            crossed = B.status(pool)["hard_crossed"]
        except Exception as e:
            return f"the {pool} pool's budget could not be read to authorize a retry ({e})"
        if crossed:
            return (f"the {pool} pool is past its daily hard cap — a retry is a "
                    f"second spawn's spend, and the cap does not care that the "
                    f"first one failed")
    return None


_CRED_RE = re.compile(
    r'(?i)(?:'
    r'Bearer\s+\S+'                           # bare Bearer <token> (no header prefix)
    r'|sk-(?:ant-)?[A-Za-z0-9_\-]{16,}'      # Anthropic/OpenAI-style keys (sk-*/sk-ant-*)
    r'|x-api-key[^\r\n]+'                    # x-api-key header: capture to end of line
    r'|Authorization[^\r\n]+'               # Authorization header: capture to end of line
    r'|gh[pousr]_[A-Za-z0-9]{36,}'           # GitHub classic/OAuth/App tokens (ghp_/gho_/ghu_/ghs_/ghr_)
    r'|github_pat_[A-Za-z0-9_]{36,}'        # GitHub fine-grained PATs
    r'|(?-i:(?:AKIA|ASIA)[A-Z0-9]{16})'    # AWS access key IDs — (?-i:…) opts out of outer (?i); real IDs are uppercase-only
    r'|xox[bp]-[A-Za-z0-9\-]{20,}'          # Slack bot (xoxb-) and user (xoxp-) tokens
    r')'
)
_API_ERROR_MSG_LIMIT = 400
# A terminal reason is a short classifier token from the harness ("completed",
# "api_error", "aborted_streaming", "blocking_limit"). The cap bounds a malformed
# value rather than trimming a real one — no reason the harness emits comes close.
_TERMINAL_REASON_MAX_CHARS = 64
# Everything outside a conservative token charset becomes "?". Every reason the
# harness actually emits passes through byte-for-byte; newlines, carriage returns
# and ANSI escapes do not, and those are what let a 64-character value forge a
# line in `agentctl status` or `agentctl wait`, both of which print this field
# through an unescaped f-string.
_TERMINAL_REASON_UNSAFE_RE = re.compile(r"[^A-Za-z0-9_.:-]")

# A 4xx the server will refuse identically no matter how many times we ask, EXCEPT
# these — a timeout and a rate limit are 4xx by numbering and transient in fact.
#
# 409 was CONSIDERED and left out. Some HTTP retry policies treat a conflict as a
# concurrent-modification race worth re-attempting, but the survey below shows
# zero 409s across every api_error run on record here, so adding it would be
# policy borrowed from elsewhere rather than a rule this fleet's evidence
# supports. Noted so the next reader knows it was weighed, not missed.
_RETRYABLE_4XX = frozenset({408, 429})
# A status that arrived but could not be read as an integer. Distinct from None,
# which means no response reached us at all — that is the wire death and it is the
# most retryable case there is. Garbage tells us nothing, so it must not inherit
# the permissive reading of an absent one.
_UNPARSEABLE_STATUS = -1


def parse_api_error_status(raw, *, unparseable):
    """`api_error_status` as an int, or `unparseable` when it is not one.

    Two call sites read this field and they want OPPOSITE fallbacks, which is
    exactly how they would drift apart if each kept its own try/except.
    `_finalize_run` records the status and maps garbage to None, because a record
    should not assert a status that was never sent. The retry decision maps it to
    `_UNPARSEABLE_STATUS`, because for a DECISION "unreadable" must not inherit
    the permissive reading that absence gets. One parser, the caller names the
    fallback, and the difference stays deliberate rather than accidental.
    """
    if raw is None:
        # Absent is absent for both callers. Only GARBAGE splits them.
        return None
    try:
        return int(raw)
    except (TypeError, ValueError):
        return unparseable


def api_death_is_retryable(status: int | None) -> bool:
    """Whether retrying the SAME request could plausibly succeed.

    The same-model retry exists for a blip on the wire. It is wasted — worse than
    wasted, since there is only one — on a request the server has already refused
    on its merits and will refuse again.

    THE STATUS CLASS IS THE EVIDENCE, not the message text. Every `api_error` run
    in `<root>/agent-runs` for June–August 2026 falls into three shapes and the
    split is clean:

        no status  n=10  "Connection closed mid-response"      — wire, retry
        500        n=3   "Internal server error ... temporary"  — server, retry
        400        n=4   "Invalid model name passed in model="  — us, do NOT retry

    All four 400s are `test-writer` on `claude-sonnet-4-6`, a name that does not
    resolve, and TWO of them (`run-faef2e84`, `run-12898f6b`) spent the retry on
    that same unusable name before the fail-over was even reached.

    Classifying on the status class rather than on "Invalid model name" is
    deliberate. The message is prose from a provider and will be reworded; the
    class is a contract. A rule keyed on the wording would pass its test and
    silently stop working the first time the sentence changed — the failure this
    epic exists to remove, rebuilt one layer up.

    A missing status means the death never reached a response at all (the wire
    shape), which is the most retryable case there is. An UNREADABLE one is not
    the same thing and must not inherit that reading — it is checked first,
    because `_UNPARSEABLE_STATUS` sits outside the 4xx range and a rule that only
    refuses 4xx would otherwise wave it through as retryable. (It did, until the
    test below caught it.)
    """
    if status == _UNPARSEABLE_STATUS:
        return False
    if status is None:
        return True
    if status in _RETRYABLE_4XX:
        return True
    return not (400 <= status < 500)


def _scrub_api_error_message(text: str) -> str:
    """Redact credential-shaped tokens from an API error message and truncate."""
    return _CRED_RE.sub('[redacted]', text)[:_API_ERROR_MSG_LIMIT]


def _scan_rate_limits(run_dir: Path) -> dict:
    """What the SUBSCRIPTION quota was doing while this run executed (ARCH-442).

    The CLI emits `rate_limit_event` events carrying a `rate_limit_info` object —
    the same signal the TUI's extra-usage indicator reads. It reaches the
    transcript already and nothing has ever recorded it, so every downstream
    reader has had to infer plan-versus-overage from dollar estimates that cannot
    tell them apart.

    Returns `{}` when the run reported no quota at all, which is a real and common
    case (a short run may emit none). Absent and `false` mean different things —
    "we never heard" versus "we heard, and it was inside the plan" — and
    collapsing them is what would make an overage report quietly wrong.

    THIS IS NOT PER-RUN ATTRIBUTION. The quota is account-wide, so what this
    records is "the subscription was in overage while this run executed", not
    "this run's dollars came out of credits". That is the question ARCH-174 needs
    answered; do not let a dashboard label it as the other one.

    TRUST BOUNDARY, stated because it is not obvious. The transcript is written by
    the harness, but an agent with Bash can infer its own run dir and append to it.
    APPENDING a benign event turns a run that reported NOTHING into one reporting
    "inside the plan", which dilutes the day's overage fraction. Appending cannot
    hide real overage: the flag is monotonic within a pass and never reset.
    REWRITING the file is different and is NOT covered — truncating it before
    finalize erases the events outright, and the run then reports no quota at all
    (security-reviewer, #356). That is a weaker prize than "inside the plan", and
    it is the honest limit of what this protects.

    Either way it reaches nothing but this dashboard: the quota is account-wide,
    so no cost attribution moves. Accepted for now, and recorded rather than
    assumed away — the durable answer is a harness-written integrity marker the
    scan checks before trusting agent-writable lines, which is backlogged because
    ARCH-439's retry gate reads the same file for a sharper purpose.

    Reads the transcript at finalize rather than accumulating during the stream:
    the ARCH-131 fail-over and the ARCH-439 retry both append to this same file,
    so one pass at the end covers every attempt without threading state through
    two respawn paths. The substring pre-filter keeps that pass cheap — the vast
    majority of lines never match.
    """
    transcript = run_dir / "transcript.jsonl"
    if not transcript.exists():
        return {}
    seen_any = False
    overage = False
    peak: float | None = None
    worst_rank = -1
    try:
        # errors="replace" matches _stream_transcript's own decode. Without it a
        # single invalid UTF-8 byte on a matching line raises UnicodeDecodeError
        # DURING ITERATION, which `except OSError` does not catch — and this is
        # called inline in write_outcome's argument list, so the throw would skip
        # write_outcome, R.remove_run and _reap_review_worktree together: no
        # outcome.json, a run registered forever, a leaked worktree
        # (security-reviewer, #356).
        with transcript.open(errors="replace") as f:
            for line in f:
                if '"rate_limit_info"' not in line:
                    continue
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue  # a partial last line from a run that died mid-flush
                # isinstance BEFORE .get, rather than catching the AttributeError
                # it would raise: a JSON array on a line that passed the substring
                # pre-filter would otherwise propagate past the outer OSError
                # handler and crash finalize (reviewer, #356). Every transcript
                # event is an object today; this does not depend on that holding.
                if not isinstance(event, dict):
                    continue
                info = event.get("rate_limit_info")
                if not isinstance(info, dict):
                    continue
                seen_any = True
                if info.get("isUsingOverage"):
                    overage = True
                util = info.get("utilization")
                # Only two of the six observed payload shapes carry utilization,
                # so its absence is normal and must not read as 0.0.
                if isinstance(util, (int, float)):
                    peak = util if peak is None else max(peak, util)
                status = info.get("status")
                if status in T.RATE_LIMIT_SEVERITY:
                    worst_rank = max(worst_rank, T.RATE_LIMIT_SEVERITY.index(status))
    except Exception:
        # TOTAL BY DESIGN. This is an optional enrichment on the finalize path,
        # and nothing it could learn is worth a run failing to finalize. Any
        # failure degrades to "this run reported no quota", which is a state the
        # readers already handle and already distinguish from `false`.
        return {}
    if not seen_any:
        return {}
    out: dict = {"overage_seen": overage}
    if peak is not None:
        out["peak_utilization"] = round(float(peak), 4)
    if worst_rank >= 0:
        out["rate_limit_status"] = T.RATE_LIMIT_SEVERITY[worst_rank]
    return out


# The five-hour utilization fraction at or above which a fresh dispatch waits
# for the window to reset rather than run into extra usage (operator, 2026-09-29:
# "no to extra usage on autonomous work" — issue_01M3PZ6J0D55EFC8GGAYMN9SH4).
RATE_LIMIT_HOLD_UTILIZATION = 0.9

# The weekly (seven-day) utilization fraction at or above which every dispatch
# waits until the weekly `resets_at`: fresh, `--pr` round fix and `--pr` review
# alike. operator, 2026-10-04: "Let's make it 96% instead of 90% — there's a lot more
# tokens per basis point in the weekly than in the session limit." operator,
# 2026-10-08: "99% is the right number for the weekly usage threshold"; they
# spend their weekly reset at 99-100% rather than have work stop at 96%. Its own
# constant, so moving one threshold never moves the other. It leaves headroom
# below 1.0: a run started below it can still cross 1.0, and nothing re-checks
# during a run.
WEEKLY_HOLD_UTILIZATION = 0.99


def _rate_limit_hold_decision(five_hour: dict | None, *, now: datetime,
                              pr_round_fix: bool,
                              seven_day: dict | None = None) -> tuple[datetime, str] | None:
    """`(held_until, hold_reason)` if a dispatch must wait right now, else
    `None`. `five_hour` and `seven_day` are `usage_window.read_five_hour_window()`
    and `read_seven_day_window()`'s returns (round 2, second part, PR #716 —
    this used to read a fleet-wide state file this process wrote at finalize;
    it now reads the same scan `tools/usage-window-context.py`'s co-session
    hook reads, PR #714, so the two readers of "the account's live windows"
    can't drift).

    THE FIVE-HOUR WINDOW holds a dispatch when its reading reports
    `isUsingOverage`, or when its utilization is at or above
    `RATE_LIMIT_HOLD_UTILIZATION`. THE SEVEN-DAY WINDOW holds every dispatch
    on utilization at or above `WEEKLY_HOLD_UTILIZATION`: fresh, `--pr` round
    fix and `--pr` review alike (`pr_round_fix` is true for every `--pr` run).
    It never holds on overage.
    `isUsingOverage` is account-level, so a seven-day reading can carry the
    flag after the overage has ended, and nothing in a held dispatch writes
    the transcript line that would clear it; a weekly overage hold could last
    up to seven days. The seven-day reader drops the flag for that reason.
    A holding window holds until its own `resets_at`. When more than one
    holds, the dispatch waits for the LATER `resets_at`. `hold_reason` names
    each holding window.

    A missing reading (`None`) holds nothing, for either window — the seven-day
    reading is treated exactly as the five-hour one is.

    FAILS OPEN on a `None` reading (no reading found, or the freshest one has
    already reset — `read_*_window` treats those the same) by reading it as
    "nothing to hold on". NEVER RAISES: every field a reading carries is
    already validated by its reader (utilization finite and not below 0, with
    no upper bound; `resets_at` finite, positive, and no further ahead of
    `now` than the window's length plus slack), so `datetime.fromtimestamp`
    below never sees an `inf`/`nan`/absurdly-large value. This runs on every
    spawn; refusing dispatch on a parsing question would be a worse failure
    than the extra usage this exists to avoid.

    Five-hour `isUsingOverage` holds regardless of `pr_round_fix` — the spec is explicit
    that a round-fix may proceed at or above the utilization threshold, but
    never into overage. Utilization alone is waived for a round-fix on an
    open PR for the five-hour window only, as on `origin/main`: finishing work
    already in flight is worth proceeding for, the same way it is not worth
    starting something new for. The weekly threshold is not waived for any
    `--pr` run. It leaves headroom below 1.0, not a guarantee: a dispatch
    started below it can still cross 1.0 during its run, and nothing re-checks
    during a run.

    TRUST BOUNDARY, stated because it is not obvious (security-reviewer,
    round 2, PR #716). The readings come from run transcripts under the runs
    root; a dispatched run has Bash and can infer its own run dir, the same
    boundary `_scan_rate_limits` already states. A forged benign
    `rate_limit_info` line can suppress a five-hour hold for every later spawn,
    or re-touch a fresh `resets_at` to re-arm one indefinitely. Neither is
    defended: no occurrence of either has been observed, and PR #715 declined
    the same class of cross-run corroboration on this module for the same
    reason. Accepted, not protected against.

    A forged usage reading in any recent transcript can hold dispatches, hold
    them again for each further forged reading planted after its reset, or lift
    a hold that a genuine reading sets; the reader's code (`_recent_transcripts`,
    `_read_window` and `_tail_window_reading`) is the reference for how a reading
    is chosen.

    The planting mechanism and the single sleep exist on the five-hour path
    already (accepted in PR #716). What is new is that the weekly hold reaches
    `--pr` runs. This is the same accepted same-account threat.
    """
    holds: list[tuple[datetime, str]] = []
    if five_hour is not None and five_hour["is_using_overage"]:
        holds.append((datetime.fromtimestamp(five_hour["resets_at"], tz=timezone.utc),
                      "the five-hour window is already spending from overage"))
    for label, window, threshold in (("five-hour", five_hour, RATE_LIMIT_HOLD_UTILIZATION),
                                     ("seven-day", seven_day, WEEKLY_HOLD_UTILIZATION)):
        if window is None:
            continue
        utilization = window["utilization"]
        if utilization < threshold or (pr_round_fix and label == "five-hour"):
            continue
        reason = f"{label} window utilization {utilization:.2f} >= {threshold:.2f}"
        resets_at_dt = datetime.fromtimestamp(window["resets_at"], tz=timezone.utc)
        holds.append((resets_at_dt, reason))
    if not holds:
        return None
    held_until = max(resets_at_dt for resets_at_dt, _ in holds)
    hold_reason = "; ".join(dict.fromkeys(reason for _, reason in holds))
    return held_until, hold_reason


def _read_usage_window_safe(label: str, read, now: datetime) -> dict | None:
    """`read(RUNS_ROOT, ...)` for one usage window, logged rather than raised
    on failure — the module's own docstring already promises "never raises"
    for anything the scan itself can hit (an unreadable runs root, a malformed
    transcript line); this guards the boundary around that call instead (an
    import gone wrong, `RUNS_ROOT` unset).

    Every dispatch reaches this; a scan failure must degrade to "no hold" on
    that window (see `_rate_limit_hold_decision`'s docstring), not block
    dispatch.
    """
    try:
        return read(RUNS_ROOT, now=now.timestamp())
    except Exception as e:
        print(f"spawn: usage-hold {label} window unreadable ({e}) — dispatching without "
              f"a hold check on it", file=sys.stderr)
        return None


def _usage_hold_decision(now: datetime, *, pr_round_fix: bool) -> tuple[datetime, str] | None:
    """`_rate_limit_hold_decision` fed both windows' readings off the real scan."""
    return _rate_limit_hold_decision(
        _read_usage_window_safe("five-hour", UW.read_five_hour_window, now),
        now=now, pr_round_fix=pr_round_fix,
        seven_day=_read_usage_window_safe("seven-day", UW.read_seven_day_window, now))


def _hold_sleep(seconds: float) -> None:
    """`_wait_for_rate_limit_hold`'s own sleep call, kept separate from plain
    `time.sleep` so a test spying on the hold isn't also charged an unrelated
    loop's sleep. `_run_session`'s real spawn path calls `_pid_start_time`
    (its `ps -p <pid>` probe uses `subprocess.run(..., timeout=5)`), which
    busy-polls via `time.sleep` — CPython's own `Popen.wait(timeout=...)`
    delay loop — when the child is slow to reap; a loaded CI runner hits that
    and a fast local one does not (CI fix, round 1, PR #716). A test that
    monkeypatches THIS name instead of `time.sleep` never sees that noise."""
    time.sleep(seconds)


def _wait_for_rate_limit_hold(*, pr_round_fix: bool,
                              on_hold=None) -> tuple[str, str] | None:
    """Block the CALLING PROCESS until the usage windows (five-hour and weekly)
    are clear to dispatch into (issue_01M3PZ6J0D55EFC8GGAYMN9SH4). Returns `(held_until,
    hold_reason)` for the run's meta.json if a hold happened, else `None`.

    Called from `_run_session`, which — for a detached spawn, the default —
    runs in the double-forked grandchild (`_detach_and_run`), reached only
    after the parent has already printed the run id and returned. The wait
    therefore never holds open a co session's Bash tool, which is why it does
    not live in `_spawn_dispatch` (the parent process) instead.

    `on_hold(held_until, hold_reason)`, when given, is called once per hold
    found, BEFORE sleeping on it — the caller's hook to make the hold visible
    (meta.json) before this function blocks, rather than only after it
    returns.

    One wait, then a re-check, not a hold-until-genuinely-clear loop by
    default: after sleeping to `resets_at`, the state is re-read to catch a
    fresher write that landed during the sleep (another run finalizing
    mid-wait). If that fresher read is itself still held — most likely
    `isUsingOverage`, which a five-hour window reset does not by itself
    clear — the loop waits again on the NEW `resets_at` it names (calling
    `on_hold` again), rather than dispatching into overage regardless.
    """
    now = datetime.now(timezone.utc)
    decision = _usage_hold_decision(now, pr_round_fix=pr_round_fix)
    if decision is None:
        return None
    held: tuple[str, str] | None = None
    while decision is not None:
        held_until_dt, hold_reason = decision
        held_until = held_until_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
        held = (held_until, hold_reason)
        print(f"spawn: holding until {held_until} — {hold_reason}; waiting "
              f"rather than dispatching into extra usage", file=sys.stderr)
        if on_hold is not None:
            on_hold(held_until, hold_reason)
        sleep_seconds = max(0.0, (held_until_dt - datetime.now(timezone.utc)).total_seconds())
        _hold_sleep(sleep_seconds)
        now = datetime.now(timezone.utc)
        decision = _usage_hold_decision(now, pr_round_fix=pr_round_fix)
    return held


# Sentinel default for _finalize_run's eight trusted-value parameters below —
# distinct from `None`, which is a real value a harness caller can legitimately
# thread. A bare `agentctl._finalize_run(...)` test call that names none of them
# posts the Archives record below with `None` in their place (`[]` for the one
# list-valued parameter, `materialized_documents`), since only the real
# dispatch path (`_run_session`) always passes all eight explicitly.
_UNSET = object()


# `_materialized_documents` below must read no more of this file than it has
# to: it runs against a worktree the run's own subprocess has not started
# yet (see that function's docstring), but the FILE is the same
# `.profile-documents.json` a compromised run would later try to abuse, so
# the read is capped the same way any other run-writable file this harness
# trusts is capped. The largest real `.profile-documents.json` is a handful
# of KB (one row per profile document plus one per instruction block); 1 MiB
# is far past any legitimate profile's size.
_MAX_PROFILE_DOCUMENTS_BYTES = 1024 * 1024

# `kind` values `individuate()` (bin/knowledge-ctx) ever writes to a
# `documents` row. Anything else in that field means the file was not
# produced by `individuate()` — forged, corrupted, or from a future version
# this reader doesn't know about — and the row is dropped rather than
# trusted through.
_KNOWN_PROFILE_DOCUMENT_KINDS = frozenset({
    "agent", "skill", "architecture", "decision", "runbook", "reference", "spec",
})

_SHA256_HEX_RE = re.compile(r"^[0-9a-f]{64}$")


def _open_profile_documents_nofollow(path: Path) -> "int | None":
    """A read fd for `path`, or None unless it is (and stays) a plain regular
    file — never raises.

    `lstat` (never follows a symlink) before any `open()`, so a run that
    replaces this file with a symlink to an unbounded source (e.g.
    `/dev/zero`) or a FIFO with no writer is refused before the syscall that
    could hang or over-read ever runs. `O_NOFOLLOW` closes the race between
    that `lstat` and the `open` (a symlink swapped in during the window
    between them); `O_NONBLOCK` keeps a FIFO that reappears in that same
    window from blocking the open. `os.fstat` on the resulting descriptor
    re-checks `S_ISREG`, because `O_NOFOLLOW` alone refuses a symlink and
    nothing else.

    `lib/agent-platform/worktrees.py`'s `_read_render_record` reads this
    exact file's sibling manifest in this exact `.claude/` directory, but has
    none of this: it `lstat`s for `S_ISREG` and then calls plain
    `read_text()`, which follows a symlink swapped in after that `lstat` and
    can block on a FIFO — the same gap this function closes, left open there
    (code review, PR #740 round 2; outside this PR's diff).
    """
    try:
        lst = path.lstat()
    except OSError:
        return None
    if not stat.S_ISREG(lst.st_mode):
        return None
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            return None
    except OSError:
        os.close(fd)
        return None
    return fd


def _validate_profile_document_row(doc: object) -> dict | None:
    """One `{id, kind, body_sha256}` row for `docs_consulted.json`'s `docs`
    key, or None to drop `doc` — a `documents` entry from
    `.profile-documents.json` is allowlisted field-by-field rather than
    copied through, because by the time `_materialized_documents` reads this
    file the worktree may already have been rewritten by something other
    than `individuate()` (a prior, now-fixed version of this reader read the
    file back AFTER the agent subprocess exited, which is exactly the
    window a forged row would come from — see `_materialized_documents`'s
    docstring for why the read moved earlier).

    `id` must be a string. `kind` must be one of `_KNOWN_PROFILE_DOCUMENT_KINDS`
    — `individuate()` can legitimately emit no `kind` outside that set.
    `body_sha256` must be a 64-character lowercase hex string, OR `None` —
    `individuate()` wrote `None` for an "other kind" row whose checkout source
    it refused to open (a symlink/FIFO/oversized file). That write is retired,
    but a `.profile-documents.json` written before it can still carry the value,
    and that is a legitimate, harness-produced value, not a forgery; anything else in that
    field (the wrong length, uppercase, non-hex characters, a non-string) is
    dropped like any other malformed field. Any field that fails its check
    drops the WHOLE row rather than keeping the row with that field nulled,
    because a row this reader cannot fully vouch for is not one the
    accountability record this feeds should claim was given.
    """
    if not isinstance(doc, dict):
        return None
    doc_id = doc.get("id")
    if not isinstance(doc_id, str) or not doc_id:
        return None
    kind = doc.get("kind")
    if kind not in _KNOWN_PROFILE_DOCUMENT_KINDS:
        return None
    body_sha256 = doc.get("body_sha256")
    if body_sha256 is not None and not (
            isinstance(body_sha256, str) and _SHA256_HEX_RE.match(body_sha256)):
        return None
    return {"id": doc_id, "kind": kind, "body_sha256": body_sha256}


def _validate_instruction_block_row(block: object) -> dict | None:
    """Same contract as `_validate_profile_document_row`, for one
    `instruction_blocks` entry. `kind` is not read from the file — it is
    always `"instruction-block"`, a harness constant, not data `individuate()`
    put in the row — so there is nothing to validate there. `scope` is
    optional and, when present, must be a string; anything else drops the
    row, same as a malformed `id` or `body_sha256` does.
    """
    if not isinstance(block, dict):
        return None
    block_id = block.get("id")
    if not isinstance(block_id, str) or not block_id:
        return None
    body_sha256 = block.get("body_sha256")
    if body_sha256 is not None and not (
            isinstance(body_sha256, str) and _SHA256_HEX_RE.match(body_sha256)):
        return None
    scope = block.get("scope")
    if scope is not None and not isinstance(scope, str):
        return None
    return {"id": block_id, "kind": "instruction-block",
            "body_sha256": body_sha256, "scope": scope}


def _materialized_documents(worktree: Path) -> list[dict]:
    """The full document set this worktree's individuation just brought, read
    from `.claude/.profile-documents.json` (`W._PROFILE_DOCUMENTS_NAME`, which
    mirrors `bin/knowledge-ctx`'s own `_PROFILE_DOCUMENTS_NAME` the same way
    that file mirrors constants across the deployed/repo seam) rather than
    recomputed here — `individuate()` already hashed what it actually wrote
    to disk, so this states what the run received rather than re-deriving it
    from files ARCH-344 may since have reaped.

    MUST BE CALLED RIGHT AFTER `activate_profile` IN `_spawn_dispatch`, BEFORE
    THE AGENT SUBPROCESS EVER STARTS, and the result threaded through
    `session_kwargs`/`_run_session`/`_finalize_run` as a parameter — never
    called again later, and never called by `_finalize_run` itself. A worktree
    stays writable by its own agent subprocess for that subprocess's entire
    execution window (ARCH-193, `_post_model_resolution_signal`'s docstring
    makes the same point about meta.json and run_dir), so reading
    `.profile-documents.json` back from the worktree AFTER the subprocess has
    exited would let a compromised or merely buggy run add, edit or delete
    rows in the very accountability record this feature exists to make
    (security review, PR #740 round 1). Calling this once, at dispatch time,
    before the subprocess exists, removes that window rather than guarding it.

    One `{id, kind, body_sha256}` per profile document (the agent file, every
    skill, and any other kind the profile brought but did not mirror to
    disk), plus one per instruction block composed into the worktree's
    CLAUDE.md, those carrying an extra `scope` field. Each row is validated
    field-by-field by `_validate_profile_document_row`/
    `_validate_instruction_block_row` and dropped whole on any mismatch,
    because even at dispatch time this file sits in a worktree `knowledge-ctx
    use` just wrote to — nothing says ANOTHER process couldn't have raced it;
    the validation is cheap enough to apply unconditionally rather than
    trusting "we just wrote this."

    `id`, `kind` and `body_sha256` match the Library protocol contract's
    document row fields, so a `docs[]` row the protocol defines later can
    fill this same shape without translation — the contract does not yet
    define `docs[]` rows. `scope` has no equivalent there; it is
    agentctl-only data (an instruction block's composition scope) carried
    under its own name rather than folded into the three shared fields.

    A worktree with no `.profile-documents.json` (no render ran, it predates
    this file, or the read was refused — not a plain regular file, past
    `_MAX_PROFILE_DOCUMENTS_BYTES`, unparseable, or any other failure)
    answers an empty list — the surrounding record still writes everything
    else it knows about the run. Never raises.
    """
    path = worktree / ".claude" / W._PROFILE_DOCUMENTS_NAME
    fd = _open_profile_documents_nofollow(path)
    if fd is None:
        return []
    try:
        with os.fdopen(fd, "rb") as f:
            raw = f.read(_MAX_PROFILE_DOCUMENTS_BYTES + 1)
    except OSError:
        return []
    if len(raw) > _MAX_PROFILE_DOCUMENTS_BYTES:
        print(f"spawn: {path} exceeds {_MAX_PROFILE_DOCUMENTS_BYTES} bytes — "
              f"refusing to read it; this run's docs_consulted.json will "
              f"record an empty document set", file=sys.stderr)
        return []
    try:
        record = json.loads(raw)
    except ValueError:
        print(f"spawn: {path} is not valid JSON — refusing to read it; "
              f"this run's docs_consulted.json will record an empty "
              f"document set", file=sys.stderr)
        return []
    if not isinstance(record, dict):
        return []
    docs: list[dict] = []
    for doc in record.get("documents") or []:
        validated = _validate_profile_document_row(doc)
        if validated is not None:
            docs.append(validated)
    for block in record.get("instruction_blocks") or []:
        validated = _validate_instruction_block_row(block)
        if validated is not None:
            docs.append(validated)
    return docs


def _activation_names(worktree: Path) -> tuple[list[str], list[str]]:
    """The agent and skill names individuated into `worktree`'s `.claude`
    dir, as of the moment this is called.

    Shared by both `docs_consulted.json` writes: `_spawn_dispatch` calls this
    right alongside `_materialized_documents`, before the agent subprocess
    starts; `_finalize_run` calls it again after the subprocess has exited,
    since unlike `materialized_documents` (threaded through as a captured
    parameter so a run's own subprocess can never rewrite its own
    accountability record) this one has always read the worktree fresh at
    finalize time, and that is unchanged here. A worktree with neither
    directory, or whose caller never rendered one, answers `([], [])`."""
    agents_dir = worktree / ".claude" / "agents"
    skills_dir = worktree / ".claude" / "skills"
    individuated_agents = sorted(p.stem for p in agents_dir.glob("*.md")) if agents_dir.exists() else []
    individuated_skills = sorted(d.name for d in skills_dir.iterdir() if d.is_dir()) if skills_dir.exists() else []
    return individuated_agents, individuated_skills


# Cap matches `_MAX_PROFILE_DOCUMENTS_BYTES`'s reasoning: the largest composed
# CLAUDE.md (every `scope: fleet` block plus a profile's own `claude_md_extras`) is a
# handful of KB; 1 MiB is far past any legitimate render's size.
_MAX_RENDERED_CLAUDE_MD_BYTES = 1024 * 1024


def _rendered_claude_md_text(worktree: Path) -> "str | None":
    """`worktree`'s own `.claude/CLAUDE.md` text, or None on anything short of a
    clean read of a plain regular file within `_MAX_RENDERED_CLAUDE_MD_BYTES` —
    never raises. Reuses `_open_profile_documents_nofollow`'s NOFOLLOW/O_NONBLOCK
    discipline (that helper has nothing profile-documents-specific in it, only in
    its name) for the same reason: this file sits in a worktree the run's own
    subprocess can rewrite once it starts, so a symlink or oversized read here must
    refuse rather than hang or follow. Called only before that subprocess exists
    (see `_fleet_blocks_confirmed_in_claude_md`'s docstring)."""
    fd = _open_profile_documents_nofollow(worktree / ".claude" / "CLAUDE.md")
    if fd is None:
        return None
    try:
        with os.fdopen(fd, "rb") as f:
            raw = f.read(_MAX_RENDERED_CLAUDE_MD_BYTES + 1)
    except OSError:
        return None
    if len(raw) > _MAX_RENDERED_CLAUDE_MD_BYTES:
        return None
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return None


def _fleet_blocks_confirmed_in_claude_md(
        *, worktree: Path, claude_md_blocked: "tuple[str, str] | None",
        docs_unavailable_reason: "str | None",
        materialized_documents: "list[dict] | None") -> "tuple[bool, str | None]":
    """Whether THIS dispatch's rendered `.claude/CLAUDE.md` actually carries every
    `scope: fleet` instruction block `activate_profile`'s render recorded as
    composed into it — the one positive fact `run_sandbox.settings()`'s
    `exclude_user_claude_md` may act on. Returns `(True, None)` only on that
    showing; `(False, reason)` on anything short of it, and never raises — every
    failure mode here must fail CLOSED to keeping the user CLAUDE.md loaded, never
    open to trusting a record about to be acted on without being checked.

    `docs_unavailable_reason is None` says only that knowledge-ctx's render
    reported `.profile-documents.json` current for this dispatch; it is not, by
    itself, a showing that the fleet blocks the render recorded actually landed in
    `.claude/CLAUDE.md` — `individuate()` (bin/knowledge-ctx) writes that record
    unconditionally, even on the render whose own CLAUDE.md write the ARCH-023/080
    ownership gate refused (a hand-written file not in the previous individuation
    manifest). That refusal already comes back from `activate_profile` as
    `claude_md_blocked`, which this checks first (round 2: PR #823's round 1 fix
    gated on `docs_unavailable_reason is None` alone and missed exactly this case).
    Past both flags, this still does not trust the record: it re-derives the fleet
    block ids `materialized_documents` (the SAME validated rows `cmd_spawn` already
    computed from that file via `_materialized_documents`, before the agent
    subprocess ever started) carries under `kind: instruction-block` / `scope:
    fleet`, and checks the worktree's OWN `.claude/CLAUDE.md` — read fresh here,
    also before that subprocess exists — for the exact marker
    `render_instruction_blocks_md` (bin/knowledge-ctx) writes ahead of each
    block's body. Only when every recorded fleet id's marker is actually present
    does this confirm. An empty fleet-id set (no `scope: fleet` row recorded at
    all) is also a decline, not a vacuous pass — it is evidence the render didn't
    do what this exclusion assumes, not evidence there was nothing to check."""
    if claude_md_blocked is not None:
        return False, f"composed CLAUDE.md write was blocked ({claude_md_blocked[1]})"
    if docs_unavailable_reason is not None:
        return False, docs_unavailable_reason
    fleet_ids = sorted({
        doc["id"] for doc in (materialized_documents or [])
        if doc.get("kind") == "instruction-block" and doc.get("scope") == "fleet"
    })
    if not fleet_ids:
        return False, "no scope:fleet instruction block recorded for this render"
    text = _rendered_claude_md_text(worktree)
    if text is None:
        return False, (f"{worktree / '.claude' / 'CLAUDE.md'} could not be read "
                       f"to confirm the recorded fleet blocks landed")
    missing = [i for i in fleet_ids if f"<!-- instruction-block: {i} scope:fleet " not in text]
    if missing:
        return False, f"CLAUDE.md is missing the recorded fleet block(s): {', '.join(missing)}"
    return True, None


def _import_private_objects_retrying(git_dir: Path, private_objects_dir: Path,
                                     run_id: str) -> BaseException | None:
    """`RS.import_private_objects`, retried on a transient fork failure. Returns
    None on success (including the ordinary no-op when there is nothing to
    import), or the exception that finally won once every attempt is spent.

    Retries ONLY `OSError` — `BlockingIOError`/EAGAIN from a fork that cannot
    start a subprocess at all is one; any other failure to start the
    subprocess is too. This is the exact failure mode run-89f78c3f hit eight
    times on 2026-10-12 (the box at its per-user process limit) and a retry
    is the right response to it: the condition is transient, and clears on
    its own as other processes exit.

    A `subprocess.CalledProcessError` means a git subprocess started and
    refused — not the fork-contention failure this retries for, and not one a
    retry would fix — so it is returned immediately, on the first attempt,
    the same as an exhausted OSError.
    """
    sleep = _PRIVATE_IMPORT_RETRY_SLEEP_0
    for attempt in range(1, _PRIVATE_IMPORT_RETRY_ATTEMPTS + 1):
        try:
            RS.import_private_objects(git_dir, private_objects_dir)
            return None
        except subprocess.CalledProcessError as e:
            return e
        except OSError as e:
            if attempt == _PRIVATE_IMPORT_RETRY_ATTEMPTS:
                return e
            print(f"agentctl: run {run_id}'s private-object import hit "
                  f"{type(e).__name__}: {e} (attempt {attempt}/"
                  f"{_PRIVATE_IMPORT_RETRY_ATTEMPTS}) — retrying", file=sys.stderr)
            time.sleep(sleep)
            sleep *= _PRIVATE_IMPORT_RETRY_BACKOFF
    return None  # unreachable — the loop above always returns


def _finalize_run(*, run_dir: Path, worktree: Path, run_id: str, exit_code: int,
                  final_event: dict | None, profile: str, agent: dict,
                  git_dir: Path | None = None, private_objects_dir: Path | None = None,
                  model=_UNSET, model_resolved=_UNSET, model_choice=_UNSET,
                  agent_name=_UNSET, repo=_UNSET, issue=_UNSET,
                  materialized_documents=_UNSET,
                  cost_stopped_reason=_UNSET,
                  dry_run: bool = False) -> None:
    """`model`, `model_resolved`, `model_choice`, `agent_name`, `repo` and
    `issue` are the harness's OWN resolved values from the caller's scope
    (`_run_session`'s locals) — never
    read from meta.json here, because the run's own subprocess can reach its
    run_dir and rewrite that file for its entire execution window, and reading
    it back would let a compromised or merely buggy run forge the very
    Archives record meant to hold it accountable (ARCH-193 binds `review_sha`
    via a harness-set value for the same reason).

    `cost_stopped_reason` is the SAME story, and used to not be: this function
    used to read `cost-killed.txt` back off `run_dir` itself to decide whether
    the per-run cost/token cap (ARCH-185/ARCH-245) fired, and that file sits
    in a directory the run's own subprocess can write to for its whole
    execution window. Because `cost_stopped` sat outside the ARCH-397
    review-stamp downgrade's and the primary-mutation guard's allow-sets
    below, a run that planted the marker could permanently skip both and
    recolor a silently failed review, or a mutation of a primary checkout it
    does not own, as a benign budget stop (security review, PR #874 round
    1). The fact now has to arrive as a parameter, carried in memory from
    `_stream_transcript`'s own return value through `_run_session`'s locals
    — the one piece of this the run's subprocess never touches, because the
    cap fires and terminates the subprocess from THIS process, not from
    inside it. `_stream_transcript` still writes `cost-killed.txt` too, as a
    human-readable record for anyone reading the run dir by hand, but this
    function no longer trusts it. `_UNSET` here means "no cap info was
    threaded", read as `None` (no cap fired) the same way the six scalars
    above default to it on a bare test call.

    `materialized_documents` is the same story, one more time: `_spawn_dispatch`
    calls `_materialized_documents(worktree)` once, right after
    `activate_profile` and before the agent subprocess ever starts, and
    threads the resulting list all the way here through `session_kwargs`/
    `_run_session` — this function never calls `_materialized_documents`
    itself, because by the time THIS function runs the subprocess has
    already exited and the worktree's `.claude/.profile-documents.json` has
    spent its entire execution window writable by that subprocess (security
    review, PR #740 round 1). Defaults to the same `_UNSET` sentinel as the
    six scalars above, for the same reason: a bare `_finalize_run(...)` test
    call that names none of them renders `docs: []` below, visibly distinct
    from a real dispatch (which always threads this explicitly), rather than
    that call silently re-deriving a value from the worktree the way the
    pre-fix version did.

    `cost` and `outcome`, below, are threaded into the Archives post the same
    way: as the dicts `write_cost`/`write_outcome` just computed in THIS
    process, never read back off cost.json/outcome.json. A second process
    (`agentctl publish`) used to re-read meta.json/cost.json/outcome.json to
    post a superseding record once a run's commits were pushed
    (`_post_model_resolution_promoted_signal`); that record was removed
    entirely (security review, PR #477 round 4) because nothing makes a
    cross-process disk read of those files sound — the harness only waits on
    the `claude -p` subprocess's own pid, not a process group, so a subprocess
    can background a detached write that lands after this function returns and
    before `agentctl publish` runs, minutes later. Building the record from
    values still live in the harness's own memory removes the read entirely
    rather than trying to time around it.

    `dry_run` skips the committed_not_pushed/committed_local_only check below
    entirely. A `spawn --dry-run` writes a stub transcript and never touches
    the worktree, so it never commits — but `worktree` there is the real repo
    it would have run in, which can carry pre-existing local commits of its
    own (issue_01M2EKF1YCM97QDTZ2EHS6W5NX). Counting THOSE against a dry run
    would be a false positive on every dry run of a repo that has any commits
    at all.

    `git_dir`/`private_objects_dir` (issue_01M4RP1K026XJE740DMQ7AP31M) are
    threaded in from the caller's own `RS.git_common_dir`/
    `RS.run_private_objects_dir`, the same values `_run_session` computes
    once at spawn time — rather than re-derived here — for the same
    never-trust-the-worktree-mid-run reason the six scalars above are.
    `private_objects_dir` is None only when `worktree` isn't a git checkout
    at all (`git_dir` is None) — a dry run's `private_objects_dir` is still a
    real `Path`, computed the same way, because dry-run only skips its
    `mkdir` at spawn time. No import is attempted for a dry run either way:
    the import call below still runs, but `RS.import_private_objects`'s own
    `if not private_dir.is_dir(): return` no-ops on the directory that was
    never created. The import itself is the FIRST thing this function
    does, below, before any other subprocess call it makes (`_commits_since`
    and the rest): it used to run in the caller, right before this function
    was called, which still left a window where THIS function's own later
    crash on an unrelated fork failure (`_commits_since`, run-89f78c3f,
    2026-10-12) stranded an already-import-eligible commit with no outcome
    written at all. Importing first here does not make that later crash
    impossible, but it does mean the commit is already safe in the shared
    store by the time anything else in this function can fail."""
    private_import_error = (
        _import_private_objects_retrying(git_dir, private_objects_dir, run_id)
        if private_objects_dir is not None else None)

    try:
        T.update_meta(run_dir, ended_at=T.now_iso())
    except (OSError, ValueError) as e:
        print(f"agentctl: could not stamp ended_at for run {run_id} "
              f"({type(e).__name__}: {e}) — continuing so cost/outcome/Archives "
              f"still get recorded", file=sys.stderr)

    by_model, cost_source = _resolve_cost(run_dir, final_event, agent)
    cost = T.write_cost(run_dir, by_model=by_model, cost_source=cost_source)
    # cost.json just became authoritative (write_cost_partial's docstring);
    # drop the now-superseded checkpoint rather than leave a stale in-flight
    # figure sitting next to the final one. Best-effort — every reader already
    # checks cost.json first, so a failed unlink here degrades to "readers see
    # a harmless stale file", not a wrong answer.
    try:
        (run_dir / T.COST_PARTIAL_FILENAME).unlink(missing_ok=True)
    except OSError:
        pass

    # Trust the model's terminal `result` over the process exit code: a run we
    # had to reap (ARCH-069 — SIGTERM gives a nonzero exit) that still emitted
    # result:success genuinely finished its turn, and shouldn't read "errored".
    if final_event is not None:
        exit_status = ("errored" if final_event.get("is_error")
                       or final_event.get("subtype") == "error" else "completed")
    else:
        exit_status = "completed" if exit_code == 0 else "errored"

    # The per-run cost/token cap (ARCH-185/ARCH-245) is what actually stopped this
    # run, if it fired: `_stream_transcript` terminates the process BEFORE a
    # result event can ever arrive, so without this the run above reads as a bare
    # "errored" indistinguishable from a crash — the gap clause 9 of the
    # budget-enforcement epic names.
    #
    # NOT applied yet. `cost_stopped_reason` (the parameter; normalized here the
    # same way the other _UNSET-defaulted values are) only CANDIDATES this run
    # for `cost_stopped` — applied at the bottom of this function, after the
    # ARCH-397 downgrade and the primary-mutation guard below have had their
    # turn, via `_safety_downgrade_applied`. Those two are safety signals and
    # must win: a run can be cost-capped AND have silently failed its review, or
    # cost-capped AND mutated a primary checkout, and recording only
    # `cost_stopped` would hide the more serious fact behind a benign budget
    # stop (security review, PR #874 round 1).
    cost_stopped_reason = (None if cost_stopped_reason is _UNSET
                           else cost_stopped_reason)
    if cost_stopped_reason is not None:
        # Sanitised the same way `fallback_blocked_reason` is at its `wait` print
        # site: a sentence with spaces and punctuation, collapsed to one line
        # rather than reduced to a token charset, because this is still a
        # harness-formatted string built from gateway-reported numbers
        # (`_cap_breach_reason`), not free text, but the format is cheap
        # insurance against a future change to that function putting
        # something less constrained into it.
        cost_stopped_reason = SC.sanitise(cost_stopped_reason, max_len=200)
    _safety_downgrade_applied = False
    # Set only by the ARCH-397 downgrade below, to a FIXED string with no
    # run-controlled content (unlike the printed stderr explanation a few
    # lines down, which does interpolate meta.json fields for an operator
    # reading the log) — this one rides into `error_reason`, which
    # `cmd_status` and `wait` print verbatim, so it stays off the same
    # attacker-controlled fields `api_terminal_reason`'s sanitiser exists to
    # keep out of that path (security review, PR #874 round 3).
    arch397_reason = None

    # ARCH-397: a review run that ends its turn without calling `agentctl
    # review-post` reports `completed` with every signal green, but no stamp ever
    # reaches the PR — so the merge gate reads "no review", a co that trusts the
    # waiter (ARCH-367) waits forever, and the dispatch cost is paid for nothing.
    # Observed intermittently (deck: 1 of 4 runs, ~$0.58 each). The only thing that
    # should end a review run is a posted stamp, so make its absence LOUD: a review
    # run against a PR that "completed" without stamping is downgraded to errored.
    #
    # Fails safe. The check needs the network (read the PR's comments), so a gh
    # failure returns None and we leave the status untouched — a blip must never
    # manufacture the false "no review" this exists to remove. Only a definite
    # "the PR was read and this run's stamp is not there" downgrades.
    if exit_status == "completed":
        meta = T.read_meta(run_dir)
        if _is_review_agent(meta.get("agent") or "") and meta.get("pr"):
            posted = _review_run_posted_stamp(
                repo=meta.get("repo") or "", pr=str(meta.get("pr")), run_id=run_id)
            if posted is False:
                exit_status = "errored"
                _safety_downgrade_applied = True
                arch397_reason = (
                    "ended its turn without posting a review stamp (ARCH-397) "
                    "— see stderr for the rescue/re-dispatch guidance.")
                rescued, attempted = _rescue_unposted_review(
                    run_dir, run_id, str(meta.get('pr')),
                    reviewed_commit=meta.get("review_sha"))
                # A run that CALLED review-post and was refused behaved correctly.
                # Two causes are distinguishable: `review-post` itself drops a marker
                # in this run's directory the moment the LIBRARY refuses the review
                # record (issue_01M3830J6EKZ394Q8AVYRQGN40 round 2) — read it first,
                # because asserting the OTHER cause (the PR head moving under ARCH-184's
                # pin) when this one applies sends a reader chasing a stale commit that
                # was never the problem. Absent that marker, the head-moving cause is
                # what the undifferentiated message cost on 2026-08-13, so it stays the
                # fallback explanation.
                library_refusal = None
                try:
                    marker = run_dir / _LIBRARY_REFUSAL_MARKER_FILENAME
                    if marker.exists():
                        library_refusal = json.loads(marker.read_text())
                except (OSError, ValueError):
                    library_refusal = None
                # library_refusal is the ONE cause where re-posting the SAME text is
                # the right instruction, not re-dispatch: the run's reviewed commit
                # was already pinned and normalized when review-post ran, and
                # `run_facts` (both the merge gate's and the Library's, off the same
                # `review_protocol.resolve_run_facts` loader) reads a run's meta.json
                # directly and covers an ended run, not only a live one — so a re-post
                # naming THIS run's own `--run-id`/`--reviewed-commit` still
                # authenticates `run-verified` once the Library is reachable
                # (issue_01M3830J6EKZ394Q8AVYRQGN40 round 1). The other three causes
                # keep "re-dispatch, do not post it yourself": a head-moved refusal
                # was correctly rejecting a stale commit, a never-called run has no
                # real review to relay, and an unknown cause must not be guessed into
                # either instruction.
                if attempted is True and library_refusal is not None:
                    why = (f"It CALLED `review-post`, and the Library refused the review "
                           f"record ({library_refusal.get('status', '')}: "
                           f"{library_refusal.get('error', '')}) — POSTING NOTHING to the "
                           f"PR is correct behaviour rather than a fault in the run. Once "
                           f"the Library is reachable, re-post the SAME review rather than "
                           f"re-dispatching a fresh one.")
                elif attempted is True:
                    why = ("It CALLED `review-post` and the post was refused, most often "
                           "because the PR head moved under it, which ARCH-184's pin turns "
                           "into a refusal rather than a stale stamp. That is correct "
                           "behaviour rather than a fault in the run: re-dispatch against "
                           "the new head.")
                elif attempted is False:
                    why = "It never called `review-post`. Re-dispatch to get a real verdict."
                else:
                    # Do NOT name a cause here. `attempted` is None when the
                    # transcript is missing OR unreadable OR when the rescue hit an
                    # internal error later, and asserting the first would send a
                    # reader chasing a transcript problem that may not exist
                    # (reviewer, PR #395 round 2).
                    why = ("Whether it tried to post is UNKNOWN, so nothing here "
                           "distinguishes a refused post from a forgotten one. "
                           "Re-dispatch.")
                rescued_path = run_dir / "unposted-review.md"
                review_sha = meta.get("review_sha")
                # meta['repo'] is always the bare dispatch-target name (`--on`), never
                # `owner/repo` — expanded here the same way the other printed re-post
                # commands are (bin/agentctl ~4265, ~6096, ~13296), or the printed
                # command hits review-post's OWN "no owner/repo slug is known" refusal
                # and posts nothing (reviewer, PR #722 round 2).
                _repo = meta.get("repo") or ""
                repo_slug = _repo if "/" in _repo else f"convivy/{_repo}"
                if attempted is True and library_refusal is not None and rescued:
                    where = (f" Its review was written and is saved at {rescued_path}. "
                             + (f"Re-post it with `agentctl review-post --pr "
                                f"{meta.get('pr')} --verdict <the verdict recorded in "
                                f"{rescued_path}> --agent {meta.get('agent')} --body-file "
                                f"{rescued_path} --repo {repo_slug} "
                                f"--reviewed-commit {review_sha} --run-id {run_id} "
                                f"--allow-rescued`."
                                if review_sha else
                                "This run's reviewed commit was never pinned, so a re-post "
                                "cannot authenticate the same way a fresh dispatch would — "
                                "re-dispatch instead."))
                else:
                    where = (f" Its review was written and is saved at "
                             f"{rescued_path} — read it rather than paying "
                             f"for it twice, but do not post it yourself."
                             if rescued else
                             " No review text was found in its log either.")
                print(f"agentctl: review run {run_id} ({meta.get('agent')} on "
                      f"{meta.get('repo')} PR #{meta.get('pr')}) COMPLETED WITHOUT "
                      f"POSTING a review stamp — marking errored (ARCH-397). {why}"
                      f"{where}", file=sys.stderr)

        # A worker run (coder, bug-fixer) that committed its fix but exited before
        # the orchestrator called `agentctl publish` reports `completed` with
        # files_modified populated — every external signal corroborates success — but
        # the PR head never moved. Observed on run-10424476 (coder, sous-chef PR #387
        # revision round, 2026-07-27): the agent read its own definition, which says
        # the orchestrator publishes, committed correctly, then exited without pushing.
        # The reviewer's REQUEST_CHANGES stood against a stale commit.
        #
        # At finalize time, every successful worker run has unpushed commits — that is
        # the ARCH-055 contract: the worker commits, the orchestrator publishes. So
        # committed_not_pushed at this point is the normal transient state, not an
        # alarm. `agentctl publish --run <id>` promotes it to `completed` after a
        # verified push (see _promote_if_committed_not_pushed). Only runs where the
        # orchestrator never calls publish retain committed_not_pushed permanently,
        # which is the genuine failure case.
        #
        # GATED on commits THIS run made — started_head.txt (snapshotted at spawn,
        # around line 3614) `..HEAD` via `_commits_since`. Without this gate,
        # W.unpublished_commits's `HEAD --not --remotes` answers "is it anywhere
        # else" for the WHOLE tree, so in a repo with no remotes it counts every
        # commit on HEAD whether or not this run made it
        # (issue_01M2EKF1YCM97QDTZ2EHS6W5NX: a `--dry-run` that committed nothing
        # was marked committed_not_pushed off 8 pre-existing commits in a
        # remoteless repo). `W.unpublished_commits` itself stays exactly as it
        # is — it is still what answers "has it actually been pushed", which a
        # commit count alone cannot (a branch fully pushed after this run's
        # commit must stay `completed`) — and it stays unchanged for its OTHER
        # caller, `allocate_worktree`'s delete gate, where counting every commit
        # as unpublished is the fail-safe direction.
        #
        # Fails safe twice over. A missing or unreadable started_head.txt, or a
        # git failure, returns None from `_commits_since` and leaves the status
        # untouched — no gate, no downgrade. And once gated open, a
        # W.unpublished_commits failure returns None here too, for the same
        # reason: an inconclusive result must never manufacture a spurious
        # committed_not_pushed.
        #
        # A repo with no remote can't be published to, so a run that DID commit
        # unpublished work there gets `committed_local_only` instead of a
        # `committed_not_pushed` that would send an orchestrator after a publish
        # that can't happen. This reads started_remote.txt — a SPAWN-TIME
        # snapshot of `_has_git_remote`, written next to started_head.txt
        # (around line 3647 and 7644) — rather than calling `_has_git_remote`
        # here at finalize time. Worktrees share their primary checkout's
        # `.git/config`, so a finalize-time re-check would let the run decide
        # its own label: `git remote remove origin` during the run's own
        # lifetime flips it from the loud, published committed_not_pushed to
        # the silent, never-promoted committed_local_only, and strips the
        # remote from the primary checkout and every sibling worktree too
        # (issue_01M2EKF1YCM97QDTZ2EHS6W5NX round 2, security review). A
        # missing/unreadable record, or one reading "unknown" (the spawn-time
        # check itself failed), falls back to `committed_not_pushed` — the
        # more cautious of the two, since `agentctl publish` will fail there
        # with a plain git error rather than silently stranding real
        # unpublished work under a status that says nothing to do.
        #
        # Excluded: dry runs (never commit; see `_finalize_run`'s docstring),
        # review agents (they do not commit), and any run already downgraded
        # by the ARCH-397 check above (the inner guard re-checks exit_status).
        if (exit_status == "completed" and not dry_run
                and not _is_review_agent(meta.get("agent") or "")):
            try:
                started_head = (run_dir / "started_head.txt").read_text().strip()
            except OSError:
                started_head = None
            commits_made = _commits_since(worktree, started_head) if started_head else None
            if commits_made:
                try:
                    unpushed = W.unpublished_commits(worktree)
                except Exception:
                    unpushed = None
                if unpushed:
                    try:
                        started_remote = (run_dir / "started_remote.txt").read_text().strip()
                    except OSError:
                        started_remote = None
                    if started_remote == "false":
                        exit_status = "committed_local_only"
                        print(
                            f"agentctl: run {run_id} ({meta.get('agent')} in "
                            f"{meta.get('repo') or worktree}) COMPLETED WITH "
                            f"{commits_made} COMMIT(S) IN A REPO WITH NO REMOTE — "
                            f"marking committed_local_only. There is nowhere to "
                            f"publish to; this is the run's normal terminal state, "
                            f"not a call to `agentctl publish`.", file=sys.stderr)
                    else:
                        exit_status = "committed_not_pushed"
                        print(
                            f"agentctl: run {run_id} ({meta.get('agent')} in "
                            f"{meta.get('repo') or worktree}) COMPLETED WITH "
                            f"{commits_made} COMMITTED-BUT-UNPUSHED COMMIT(S) — "
                            f"marking committed_not_pushed. Work exists only in the "
                            f"local worktree; the orchestrator must publish before "
                            f"reviewers see it. To publish: agentctl publish --run "
                            f"{run_id}", file=sys.stderr)

    # Did this run write into a PRIMARY checkout it does not own?
    # (`primary_guard`, issue_01KZ7E0YNV84W55796CZ8ETX6X.) Deliberately OUTSIDE the
    # `exit_status == "completed"` guard above: a run that errored AND trashed the operator's
    # checkout still has to say so, and the finding is the more important of the two
    # facts. `agentctl publish` warned twice during the incident that produced the
    # diagnosis and nobody connected the warnings, which is why this refuses instead.
    #
    # It overrides `committed_not_pushed` and `committed_local_only` on purpose.
    # Both are normal healthy ends of a worker (the former promoted back to
    # `completed` by `publish --run`) — a run that mutated a primary must not be
    # quietly treated as fine, published or otherwise.
    # `errored` and `killed` are left alone — already non-success, and the loud
    # print plus the persisted detail below land either way.
    # Only a WORKING-TREE mutation downgrades. A HEAD move alone is reported and
    # nothing more: a human switching branches or committing in a primary while a
    # run is in flight moves HEAD without the run touching anything, and the first
    # live firing of this guard discarded a finished review for exactly that. See
    # `Mutation.is_working_tree_mutation`.
    #
    # AND ONLY WHEN THE EVIDENCE NAMES THIS RUN (`issue_01KZ94PCSF9HFQ9487FR4A3V5F`).
    # The guard reads the filesystem, so every run alive at the time sees a mutation
    # any one of them made — six runs were marked `primary_mutated` across
    # 2026-08-04/05 and five were innocent by their own attribution. Failing a
    # bystander buys nothing: the finding is already durable in
    # `primary_mutations.json` and on stderr, so the only effect is to discard a
    # finished review or strand committed work. An unattributed mutation files an
    # issue instead, in `_detect_primary_mutations` above — without which this
    # relaxation would make a real leak quiet. See `Mutation.downgrades_run`.
    mutations = _detect_primary_mutations(run_dir=run_dir, worktree=worktree, run_id=run_id)
    if (any(m.downgrades_run for m in mutations)
            and exit_status in ("completed", "committed_not_pushed", "committed_local_only")):
        exit_status = "primary_mutated"
        _safety_downgrade_applied = True

    # The import retried (and, on exhaustion, reported) at the top of this function
    # never crashed, so without this the run would still read whatever exit_status the
    # checks above landed on — "completed", most often — with no sign that its commits
    # never actually reached the shared store. `primary_mutated` is left alone: that
    # override already names the more serious problem (a checkout the run does not own
    # was mutated), and a run cannot be BOTH overrides' headline fact at once.
    #
    # Also counts as a safety downgrade for the cost-cap candidate below: stranded
    # commits that only `agentctl publish --run <id>` can recover are the more
    # serious fact to surface than a benign budget stop, same as ARCH-397 and
    # primary_mutated above.
    #
    # Gated on `_safety_downgrade_applied` rather than only `!= "primary_mutated"`
    # (security review, PR #874 round 3): that flag is ALSO raised by the
    # ARCH-397 downgrade above, and a review run has write access to its own
    # private-objects directory for its whole execution window — so a run that
    # makes its OWN import fail, on top of ending without posting its stamp,
    # used to have this override replace ARCH-397's `errored` with the
    # benign-reading `committed_private_only`, whose own `wait` advice tells
    # the operator not to re-dispatch, exactly wrong for a review that never
    # stamped. Checking the flag catches that case too, and still excludes
    # `primary_mutated` same as before, since that branch raises the same flag.
    #
    # The reason STRING is still built whenever the import failed, win or lose:
    # same reason `cost_stopped_reason` rides into `error_reason` below even
    # when it loses to a safety downgrade. A safety finding and a
    # stranded-commits finding can both be true of one run, and the status can
    # only name one of them — losing the other's reason text to it is the bug
    # this guards against.
    private_import_reason = None
    if private_import_error is not None:
        private_import_reason = (
            f"private-object import failed after retrying "
            f"({type(private_import_error).__name__}: {private_import_error}); "
            f"commits exist only in {private_objects_dir}. `agentctl publish "
            f"--run {run_id}` imports them and pushes — do not re-dispatch.")
        if not _safety_downgrade_applied:
            exit_status = "committed_private_only"
            _safety_downgrade_applied = True
            print(f"agentctl: run {run_id} COMMITTED, but {private_import_reason}",
                  file=sys.stderr)
        else:
            print(f"agentctl: run {run_id} COMMITTED, but {private_import_reason} "
                  f"— status stays {exit_status!r}, the more serious finding.",
                  file=sys.stderr)

    # NOW apply the cost/token-cap candidate from above: the ARCH-397 downgrade,
    # the primary-mutation guard and the private-import check just had their
    # turn, and none of the three fired, so the cap's own kill is the most
    # informative thing left to record. The cost reason still rides in
    # `error_reason` below even when one of the three DID fire and wins the
    # status — `write_outcome` has no other source for it, so there is nothing
    # to restructure to keep it visible alongside that verdict.
    if cost_stopped_reason is not None and not _safety_downgrade_applied:
        exit_status = "cost_stopped"

    # PERSIST WHATEVER THE HARNESS SAID, not only "api_error". The harness emits
    # a classified terminal record on session end and `_stream_transcript` already
    # parses it; until now this kept the value only when it equalled "api_error"
    # and discarded every other reason at the last step. Across 4,565 August 2026
    # runs `terminal_reason` survived on 12. Reading the 112 errored transcripts
    # back recovers 73 `completed`, 12 `aborted_streaming`, 12 `api_error`, 12 with
    # no result event, 2 `aborted_tools`, 1 `blocking_limit` — so 100 of 112 failures
    # were classifiable all along and nothing downstream could see it.
    #
    # `completed` on an errored run is the signal, not a contradiction: the harness
    # recorded a clean session end while agentctl marked the run failed. It is the
    # largest category, 73 of 112, and all 73 are review agents that ended a turn
    # without stamping — ARCH-397 above already detects and downgrades them, so what
    # was missing here was only the reason, never the detection.
    #
    # ABSENT NOW MEANS THE HARNESS EMITTED NO RESULT EVENT, where before it meant
    # "the reason was not api_error". Nothing synthetic is written in its place: a
    # cause of death invented here is exactly the evidence this epic moves AWAY from
    # (the run's own guess), and classifying a missing record belongs to the observer.
    #
    # Only a non-empty string is taken, and it is capped AND reduced to a token
    # charset. The field is the harness's to set rather than the agent's, but a
    # reason that is a dict, a null or a megabyte of text is malformed input either
    # way, and `write_outcome` would persist it verbatim.
    #
    # The charset is the half that is a security control rather than hygiene. This
    # is the first path carrying the harness's raw string content out to a terminal:
    # `cmd_status` and the `wait` failure line both print it through a plain
    # f-string with no escaping, where previously only the compile-time literal
    # "api_error" could reach them. `.strip()` removes surrounding whitespace and
    # leaves embedded newlines and ANSI sequences intact, so a 64-character value
    # is ample room to forge an extra line of output — `wait: run-X SUCCEEDED` is
    # the one that matters, since a co reads that line to decide whether a review
    # landed.
    #
    # `bosun-watches-its-agents` designs this field as harness-authored and outside
    # the model's control, and says in the same breath that this "narrows the
    # surface rather than eliminating it, and the difference must not be flattened".
    # Sanitizing here takes that at its word. Nothing branches on the persisted
    # value today — the retry and fail-over paths still read `final_event` directly
    # — but step 2 moves those decisions onto this record, and the cheap time to
    # make the field safe is before it carries weight.
    #
    # Substitution rather than rejection, because the two failures must stay
    # distinguishable: absent means the harness emitted no record, and a value of
    # `?????` means it emitted something malformed. Dropping the latter would file
    # a malformed reason as a missing one.
    #
    # The api_error gate below reads the STRIPPED value where it used to read the
    # raw one. For the real shape — a clean `api_error` token — the two are the
    # same. They diverge only on a padded `" api_error "`, which the old gate
    # dropped as a mismatch and this one accepts. That widening is deliberate: a
    # padded reason is the same death, and silently declining to record its status
    # and scrubbed message would be the bug, not the safeguard.
    api_terminal_reason = None
    api_error_status = None
    api_error_message = None
    if final_event is not None:
        raw_reason = final_event.get("terminal_reason")
        if isinstance(raw_reason, str) and raw_reason.strip():
            api_terminal_reason = _TERMINAL_REASON_UNSAFE_RE.sub(
                "?", raw_reason.strip()[:_TERMINAL_REASON_MAX_CHARS])
    if api_terminal_reason == "api_error":
        raw_status = final_event.get("api_error_status")
        api_error_status = parse_api_error_status(raw_status, unparseable=None)
        raw_msg = str(final_event.get("result") or "")
        api_error_message = _scrub_api_error_message(raw_msg) if raw_msg else None

    # Both land here when both fired (committed_private_only wins the status,
    # but a run can ALSO have crossed its cost/token cap on the way) — combine
    # rather than let one silently overwrite the other, since `write_outcome`
    # has only this one field for either.
    if private_import_reason is not None and cost_stopped_reason is not None:
        combined_error_reason = (
            f"{private_import_reason} It also hit its cost/token cap: "
            f"{cost_stopped_reason}")
    else:
        combined_error_reason = private_import_reason or cost_stopped_reason

    # `arch397_reason` goes in front rather than through the branch above: it is
    # the ONE reason that can be set at the same time its own status
    # (`errored`) has already been decided, by an override this function runs
    # before it (ARCH-397), rather than competing for the status the way
    # `private_import_reason` and `cost_stopped_reason` compete for
    # `committed_private_only` above. Prepending keeps both of those intact
    # unchanged and adds the missing-stamp fact alongside whichever of them
    # still applies (security review, PR #874 round 3).
    if arch397_reason is not None:
        combined_error_reason = (
            f"{arch397_reason} {combined_error_reason}"
            if combined_error_reason else arch397_reason)

    files_mod, files_add, files_del = _changed_files(worktree, run_dir)
    outcome = T.write_outcome(
        run_dir, exit_status=exit_status,
        files_modified=files_mod, files_added=files_add, files_deleted=files_del,
        prs_opened=[], tests_run=None, tests_passed=None,
        subagents_spawned=[],
        error_reason=combined_error_reason,
        terminal_reason=api_terminal_reason,
        api_error_status=api_error_status,
        api_error_message=api_error_message,
        **_scan_rate_limits(run_dir),
    )

    individuated_agents, individuated_skills = _activation_names(worktree)
    queried: list[dict] = []
    if (run_dir / "tool_calls.jsonl").exists():
        for entry in T.iter_tool_calls(run_dir):
            if entry["tool_name"].startswith("mcp__kb__"):
                queried.append({
                    "id": entry["input"].get("id"),
                    "via": entry["tool_name"],
                    "args": entry["input"],
                })
    T.write_docs_consulted(
        run_dir, profile=profile,
        individuated_agents=individuated_agents,
        individuated_skills=individuated_skills,
        queried_at_runtime=queried,
        materialized_documents=(
            [] if materialized_documents is _UNSET else materialized_documents),
    )

    _post_model_resolution_signal(
        run_id=run_id, cost=cost, outcome=outcome,
        model=None if model is _UNSET else model,
        model_resolved=None if model_resolved is _UNSET else model_resolved,
        model_choice=None if model_choice is _UNSET else model_choice,
        agent_name=None if agent_name is _UNSET else agent_name,
        repo=None if repo is _UNSET else repo,
        issue=None if issue is _UNSET else issue,
    )


# _post_model_resolution_signal (posted at finalize) inherits post_structured's
# default 30s _DELIVERY_TIMEOUT unless overridden — a budget sized for a
# one-shot launchd job that "has all the time in the world"
# (signal_client._DELIVERY_TIMEOUT's own comment). This call runs inline, on
# every single run's finalize, so a slow-but-not-down store would otherwise
# add up to 30s of dead time to every run's exit, fleet-wide. Close to the
# tee's 2s (signal_client._TIMEOUT) rather than equal to it: this write, unlike
# the tee's, still wants to land rather than being purely fire-and-forget
# (reviewer + security-reviewer, PR #477 round 2).
#
# THE BOUND IS PER ATTEMPT, AND post_structured MAKES UP TO THREE (#604). The
# record carries a dedup_key, so a timeout or 503 is retried with jittered
# backoff, and a store that stops answering costs about 13.5s (3 x 3s plus 1.5s and 3s of backoff)
# rather than 3s. As with the guard's signal, the timeout bounds each socket operation, so a store that
# trickles bytes can exceed that. That is deliberate: eight
# records were lost on 2026-09-15/16 to a single 3s attempt during lock
# contention. A store that is down refuses the connection at once, so a healthy
# or dead store still costs well under a second; only a locked one pays the wait.
# `test_finalize_path_post_uses_a_short_timeout` holds the bound at 15s.
_MODEL_RESOLUTION_POST_TIMEOUT = 3


def _post_model_resolution_signal(*, run_id: str, cost: dict, outcome: dict,
                                  model: str | None, model_resolved: str | None,
                                  model_choice: str | None, agent_name: str | None,
                                  repo: str | None, issue: str | None) -> None:
    """Archives record for this run's model-resolution event (model-lane epic
    issue_01KZH2GYGTVHFXZ055GEZVH2ZJ, issue_01M174CH86JBCP7291PS0TM097): run,
    persona, work item, model, cost, outcome, and how the model was chosen.
    This is the ONLY model-resolution record a run gets — there used to be a
    second, superseding one posted from `agentctl publish` once a
    `committed_not_pushed` run's commits were verified pushed; it was removed
    (security review, PR #477 round 4, see below).

    `outcome.exit_status` here is the status AS OF FINALIZATION, not as of
    whenever (if ever) someone later runs `agentctl publish`.
    `committed_not_pushed` is the normal terminal state of a healthy worker
    (coder, bug-fixer) — ARCH-055's contract is that the worker commits and the
    orchestrator publishes — so for judging whether a model did good work,
    `committed_not_pushed` says the same thing `completed` does; the only
    thing a later promotion to `completed` would add is whether somebody
    subsequently pushed, which is not a model-quality signal. That is the
    reasoning for not re-adding a promoted record: don't.

    Written HERE, at finalization, not at resolution — cost and outcome don't
    exist until the run ends, and the Archives is append-only, so a record
    written earlier could never be completed. `cost` and `outcome` arrive as
    the dicts `_finalize_run` just computed by calling `write_cost`/
    `write_outcome` in this same process — not read back off cost.json/
    outcome.json. Reading either file back would depend on the run's own
    subprocess being gone, and it is not reliably gone: the harness waits on
    the `claude -p` pid only (no process group), so a subprocess can
    background a detached write (`(sleep N; write) & disown`) that lands
    after this function returns. Taking the values as parameters instead of
    reading them removes that race rather than timing around it.

    `model`, `model_resolved`, `model_choice`, `agent_name`, `repo` and `issue`
    are the same story and were already parameters before this round —
    deliberately NOT read from meta.json, and `_post_model_resolution_record`
    below takes each as its own named parameter rather than a `meta` dict for
    exactly this reason — a dict lets a field nobody threaded silently fall
    back to whatever the file says, where a missing named parameter is a
    TypeError at call time instead. They arrive as parameters, the harness's
    own resolved values from `_run_session`'s scope: meta.json lives in the
    run's own run_dir, which the agent subprocess can reach and rewrite for
    its entire execution window, and reading it back would let a compromised
    or merely buggy run forge the very record meant to hold it accountable.
    ARCH-193 binds `review_sha` the same way, for the same reason (security
    review, PR #477 rounds 2-4). `issue` was already sanitised where
    `_run_session` first read it off `--issue`, the same rule
    `_log_model_override` applies to `reason`, and for the same contract:
    signal_client's module docstring requires it of any platform-did-not-author
    value landing in a body OR meta.

    Best-effort, like every `post_structured` caller: never raises, and must
    never delay or fail the run's own finalization over a store that is slow or
    down — on a short delivery timeout for exactly that reason (see
    `_MODEL_RESOLUTION_POST_TIMEOUT`). Not silent, though — `post_structured`
    already logs a non-created/duplicate result to stderr, but its message
    carries only the stream, not which run failed to get a record; logging the
    run_id here is what makes the gap findable rather than merely detectable.
    """
    _post_model_resolution_record(
        run_id=run_id, cost=cost, outcome=outcome,
        model=model, model_resolved=model_resolved, model_choice=model_choice,
        agent_name=agent_name, repo=repo, issue=issue,
        dedup_key=f"model-resolution-{run_id}")


def _post_model_resolution_record(*, run_id: str, cost: dict, outcome: dict,
                                  model: str | None, model_resolved: str | None,
                                  model_choice: str | None, agent_name: str | None,
                                  repo: str | None, issue: str | None,
                                  dedup_key: str) -> None:
    """POST for the model-resolution Archives record. Deliberately takes every
    field as its OWN named parameter rather than a `meta` dict — with a dict, a
    field the caller didn't think to pass would silently fall back to whatever
    meta.json says, re-opening the forgery gap for the next field someone adds;
    a missing named parameter is a TypeError instead (security review, PR #477
    round 3)."""
    choice = model_choice or "roster_default"
    body = (f"{agent_name} on {repo} resolved "
            f"{model} ({choice}), outcome {outcome.get('exit_status')}, "
            f"${cost.get('usd', 0.0):.4f}")
    payload_meta = {
        "run": run_id,
        "persona": agent_name,
        "repo": repo,
        "work_item": SC.sanitise(issue, max_len=200) if issue else None,
        "model": model,
        "model_resolved": model_resolved,
        "choice": choice,
        "cost": cost,
        "outcome": {
            "exit_status": outcome.get("exit_status"),
            "terminal_reason": outcome.get("terminal_reason"),
        },
    }
    try:
        result = SC.post_structured(
            "model_resolution", "model-resolution", body,
            # The repo's registry project, which is how the Library scopes the
            # same repo's review records; a repo the registry does not know
            # stays `platform`. product_for_channel maps Slack channels and
            # filed 2,224 of these under `platform` (found 2026-09-16).
            product=projects.project_for_repo(repo) or "platform",
            meta=payload_meta,
            dedup_key=dedup_key,
            timeout=_MODEL_RESOLUTION_POST_TIMEOUT,
        )
    except Exception as e:  # defence in depth — post_structured already swallows
        print(f"agentctl: model-resolution Archives record for {run_id} NOT "
              f"delivered: {type(e).__name__}: {e}", file=sys.stderr)
        return
    if result not in ("created", "duplicate"):
        print(f"agentctl: model-resolution Archives record for {run_id} NOT "
              f"delivered: {result}", file=sys.stderr)


def _reap_review_worktree(agent_name: str, worktree: Path, run_id: str) -> None:
    """Remove a review worktree once its run is finalized (ARCH-344).

    A review worktree is disposable the moment the verdict is posted: the reviewer
    reads a tree pinned to an exact SHA (ARCH-184) and authors nothing, and nothing
    ever reopens one. So nothing reclaimed them — by 2026-07-13 the fleet held 802
    stale review trees / 10 GB, one pair per PR since #15, growing with every cycle
    (the review cycle now runs on every PR by standing rule, ARCH-161).

    MUST run after _finalize_run, which still reads the tree (changed files, the
    individuated agents/skills manifest).

    Fails safe three ways: it only ever touches a linked worktree, it keeps any tree
    a reviewer somehow wrote to, and a reap error never fails the run.
    """
    if not _is_review_agent(agent_name):
        return
    if os.environ.get("AGENTCTL_KEEP_REVIEW_WORKTREE"):
        print(f"[{run_id}] keeping review worktree (AGENTCTL_KEEP_REVIEW_WORKTREE set): "
              f"{worktree}", file=sys.stderr)
        return
    try:
        # Never the human's clone. A linked worktree has a `.git` FILE; a primary
        # checkout has a `.git` DIRECTORY. A review dispatch is always dedicated and
        # commit-pinned (allocate_worktree refuses a commit without a purpose), so
        # this cannot be the primary today — but the blast radius of being wrong is
        # somebody's working tree, so it is checked rather than assumed.
        #
        # is_file() FOLLOWS symlinks, so a `.git` symlinked to a regular file would
        # satisfy it while being none of the things this check means to allow. Reject
        # the symlink explicitly, so the code enforces what the sentence above claims.
        gitpath = worktree / ".git"
        if not gitpath.is_file() or gitpath.is_symlink():
            print(f"[{run_id}] NOT reaping {worktree}: not a linked worktree",
                  file=sys.stderr)
            return
        # A reviewer authors nothing, so ANYTHING here that isn't build debris is
        # something a human would want to see — including UNTRACKED files, which
        # `--force` would otherwise delete without a trace. The case that matters is a
        # crafted diff inducing the reviewer to write a file; reaping the tree would
        # destroy the only evidence it happened. Raises if git can't read the tree,
        # which the handler below turns into "keep it" — an unreadable tree is not a
        # clean one.
        entries = W.unlanded_entries(worktree)
        if entries:
            preview = ", ".join(e[3:] for e in entries[:5])
            more = f" (+{len(entries) - 5} more)" if len(entries) > 5 else ""
            print(f"[{run_id}] NOT reaping {worktree}: {len(entries)} unlanded "
                  f"change(s) a reviewer should not have made — {preview}{more}",
                  file=sys.stderr)
            return
        # force: `git worktree remove` refuses a tree holding untracked files, and a
        # review run always leaves some (node_modules, caches, coverage output).
        # Without it the reap would be a silent no-op on the biggest trees. Everything
        # that is NOT debris has already kept the tree above, so force only drops junk.
        W.remove_worktree(worktree, force=True)
    except Exception as exc:  # noqa: BLE001 — a failed reap must never fail the run
        print(f"[{run_id}] review-worktree reap failed ({exc}); leaving {worktree}",
              file=sys.stderr)


# --- list / status / logs / kill --------------------------------------------


def cmd_list(args) -> int:
    co_session = getattr(args, "co_session", None)
    if co_session:
        return _cmd_list_co_session(co_session, as_json=bool(getattr(args, "json", False)))
    runs = R.list_runs()
    if not runs:
        print("(no active runs)")
        return 0
    now = datetime.now(timezone.utc)
    name_w = max(len(r["agent"]) for r in runs)
    for r in runs:
        start = datetime.fromisoformat(r["started_at"].replace("Z", "+00:00"))
        elapsed = int((now - start).total_seconds())
        h, m = divmod(elapsed, 3600); m, s = divmod(m, 60)
        elapsed_str = f"{h:d}h{m:02d}m{s:02d}s"
        print(f"{r['run_id']}  {r['agent']:<{name_w}}  pid={r['pid']:<7}  {elapsed_str}  {r['repo']}  — {r['task']}")
    return 0


def _first_line_only(meta: dict) -> dict:
    """*meta*, with every string field cut to its first line.

    Applied to the whole row rather than to `task` alone: `meta.json` carries
    other free-text fields an operator controls at dispatch time (`label` via
    `agentctl spawn --label`, at minimum), and this output is written into a
    rollover handoff a successor session acts on — any of them can carry an
    embedded blank line followed by `## Recommended next move` into it just
    as `task` could
    (round 2 of #557, the finding round 1's per-field fix on `task` alone
    missed). Doing it generically over the row means a field `write_meta`
    adds later is covered without a matching edit here.
    """
    return {
        k: v.splitlines()[0] if isinstance(v, str) and v else v
        for k, v in meta.items()
    }


def _cmd_list_co_session(co_session: str, *, as_json: bool) -> int:
    """`agentctl list --co-session <id>`'s body: *co_session*'s own top-level
    live dispatches, for a rollover handoff to carry (Slice 4,
    issue_01M1S2X8ENKYEGSDE3H0REFD3G).

    The session writing a handoff is the one least reliable at listing its own
    runs from memory as it degrades, so this reads the run register instead —
    wrapping `session_state._dispatched_by`, which already matches each live
    run's `meta.json["co_session"]` against *co_session* and already excludes
    a nested run (one dispatched by another run, not by a co session
    directly): a nested run's meta carries `parent_run` and no `co_session`
    at all, so it can never match here.

    Every string field is truncated to its first line (`_first_line_only`)
    before either output branch below sees it, so neither the text nor the
    `--json` form can carry an embedded heading past the first line of any
    field — not just `task`.

    `_dispatched_by` sources `run_id` from the run register entry that
    located each `meta.json`, never from the `meta.json` payload itself, and
    drops (with a stderr warning) any run whose own `meta.json` disagrees —
    a worker can write its own `meta.json` with Bash (#457 round 2 did this
    for `pid_started_at`), and this output feeds a rollover handoff a
    successor session runs `agentctl wait <run-ids>` against, so a forged
    `run_id` string here would be an injection into that later command line.
    """
    dispatches = [_first_line_only(dict(meta)) for meta in SS._dispatched_by(co_session)]
    if as_json:
        print(json.dumps(dispatches, indent=2))
        return 0
    if not dispatches:
        print("(no active runs)")
        return 0
    for meta in dispatches:
        run_id = meta.get("run_id") or ""
        agent = meta.get("agent") or ""
        task = meta.get("task") or ""
        print(f"{run_id}  {agent}  {task}")
    return 0


def _live_review_runs(repo: str, agent: str, _current_sha: str) -> list[dict]:
    """Live review runs of `agent` on `repo`, with the commit each is pinned to.

    Reads the pin from each run's meta.json rather than the registry, because the
    registry tracks liveness and meta.json is where ARCH-184 records the pin. A
    run whose meta is missing or unreadable is SKIPPED rather than treated as a
    match — this guard exists to prevent waste, and blocking a dispatch on a
    half-written file would be a worse failure than the one it prevents.
    """
    out: list[dict] = []
    try:
        runs = R.list_runs()
    except Exception:                                            # noqa: BLE001
        return out
    for run in runs:
        if run.get("ended_at"):
            continue
        run_id = run.get("run_id") or ""
        run_dir = _find_run_dir(run_id)
        if run_dir is None:
            continue
        try:
            meta = json.loads((run_dir / "meta.json").read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if meta.get("repo") != repo:
            continue
        if _strip_app_prefix(meta.get("agent") or "") != _strip_app_prefix(agent):
            continue
        sha = meta.get("review_sha")
        if not sha:
            continue
        out.append({"run_id": run_id, "agent": meta.get("agent") or agent,
                    "review_sha": sha, "pr": meta.get("pr")})
    return out


def _stale_review_runs(live: list[dict], *, review_sha: str,
                       pr_number: int | str | None) -> list[dict]:
    """Of `live`, the runs reviewing a commit the head has moved past — and that we
    can CONFIRM are reviewing this same PR.

    The confirmation is the point. A different sha in the same repo is far more
    often a different PR than a dead review, and the caller prints a `kill --final`
    for whatever this returns, so an unconfirmed match must stay silent: telling
    someone to kill another session's healthy review is a worse failure than not
    warning at all. A run whose meta predates the `pr` field carries None and is
    skipped for the same reason.
    """
    if pr_number is None:
        return []
    return [r for r in live
            if r["review_sha"] != review_sha
            and r.get("pr") is not None
            and str(r["pr"]) == str(pr_number)]


def _find_run_dir(run_id: str) -> Path | None:
    """Thin wrapper over the shared resolver (review_protocol.find_run_dir),
    bound to this process's own RUNS_ROOT so `monkeypatch.setattr(agentctl,
    "RUNS_ROOT", ...)` still redirects every caller here — see that
    function's docstring for the shape check and why it's shared with
    bin/run-register-api's /runs/<run_id>/facts route.

    An ambiguous run-id (the same id under more than one date directory — a
    planted duplicate, issue_01M1JWB7M75SZ160VRJRCGARBF) is folded into None
    here rather than raised: every one of this wrapper's ~17 callers already
    treats None as "no run to act on" and refuses/skips/no-ops accordingly,
    and picking one of the duplicates was the bug this wrapper must not
    reintroduce. `cmd_status`/`cmd_logs` call `_resolve_run_dir_for_diagnostic`
    instead, to show an operator which directories collided."""
    try:
        return RP.find_run_dir(run_id, RUNS_ROOT)
    except RP.AmbiguousRunDir:
        return None


def _resolve_run_dir_for_diagnostic(run_id: str) -> "tuple[Path | None, int]":
    """Resolve `run_id` for the read-only diagnostic commands (`status`,
    `logs`): returns `(run_dir, 0)` on success, or `(None, exit_code)` with
    the diagnostic already printed to stderr. An ambiguous run-id prints
    which directories it resolves to, in place of the generic "no run dir"
    message a genuinely unknown run-id gets, so an operator watching for a
    planted duplicate (issue_01M1JWB7M75SZ160VRJRCGARBF) can see it rather
    than have it read as an ordinary miss."""
    try:
        run_dir = RP.find_run_dir(run_id, RUNS_ROOT)
    except RP.AmbiguousRunDir as e:
        print(f"run-id {run_id} is ambiguous: found under {len(e.dirs)} run "
              f"directories ({', '.join(str(d) for d in e.dirs)}) — refusing "
              f"to pick one", file=sys.stderr)
        return None, 1
    if run_dir is None:
        print(f"no run dir for {run_id}", file=sys.stderr)
        return None, 1
    return run_dir, 0


def _resolve_worktree_by_run(run_id: str) -> Path | None:
    """Resolve a run-id's worktree the same way whether the run is still active or
    already finished (P1c, 2026-07-04).

    The active-runs registry (`R.get_run`) is deleted at finalize (`R.remove_run`),
    so a `--run` lookup that reads it alone fails the moment a run completes — which
    is exactly when `publish`/`pr-open` are called. `status`/`wait` never hit this
    because they resolve via the permanent run dir. This unifies them: registry
    fast-path for a live run, then fall back to the run dir's meta.json (written at
    spawn, never deleted)."""
    entry = R.get_run(run_id)
    if entry and entry.get("worktree"):
        return Path(entry["worktree"]).expanduser().resolve()
    run_dir = _find_run_dir(run_id)
    if run_dir is not None:
        meta = T.read_meta(run_dir)
        if meta.get("worktree"):
            return Path(meta["worktree"]).expanduser().resolve()
    return None


def cmd_codex_probe(args: argparse.Namespace) -> int:
    """Launch the one sanctioned Codex run: the conformance probe (see codex_probe).

    Read-only sandbox in a scratch repo with no remote, so an attempt the guards
    fail to stop still cannot write anywhere or push. The stream is kept under the
    printed directory whatever the verdict; the verdict is recorded against the
    bridge manifest and is one of `codex_dispatch_refusal`'s two gates — a pass no
    longer lifts the refusal on its own (PR #821 round 3,
    `CODEX_READ_CONFINEMENT_REFUSAL`): every Codex dispatch stays refused until a
    read-confinement mechanism is confirmed live."""
    home = CB.codex_home() if CB else None
    refusal = codex_precondition_refusal(args.model, home)
    if refusal is not None:
        print(f"error: refusing to run the probe on {args.model!r}: {refusal}", file=sys.stderr)
        return 2
    codex_bin = args.codex_bin or shutil.which("codex")
    if not codex_bin:
        print("error: no `codex` on PATH", file=sys.stderr)
        return 2
    timeout = args.timeout or CP.TIMEOUT_S
    out = Path(tempfile.mkdtemp(prefix="codex-probe-"))
    work = out / "work"
    work.mkdir()
    subprocess.run(["git", "init", "-q", "-b", "probe", str(work)], check=True)
    argv = CP.launch_argv(args.model, work, codex_bin)
    # The shim's denial records: a fresh directory outside the workdir, so the read-only
    # run cannot write it and never chooses its path (see codex_probe).
    denial_dir = Path(tempfile.mkdtemp(prefix="codex-probe-denials-"))
    denial_log = denial_dir / "denials.jsonl"
    exit_code, stdout, stderr = None, "", ""
    # `probe_env` allowlists to PATH/HOME/USER/etc (never GH_TOKEN/GITHUB_TOKEN to begin
    # with); `git_credential_guard_env` layers on the same GH_CONFIG_DIR/GIT_CONFIG_*/
    # GIT_TERMINAL_PROMPT redirection `_run_codex_review_session` already gets (CQ·418
    # round 4) — this launch never mints a token, so github_token stays None.
    env = DE.git_credential_guard_env(CP.probe_env(dict(os.environ), home, denial_log))
    try:
        run = subprocess.run(argv, env=env, text=True,
                             capture_output=True, stdin=subprocess.DEVNULL, timeout=timeout)
        exit_code, stdout, stderr = run.returncode, run.stdout, run.stderr
    except subprocess.TimeoutExpired as exc:
        stdout = exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or "")
        stderr = f"timed out after {timeout}s"
    (out / "events.jsonl").write_text(stdout)
    (out / "stderr.txt").write_text(stderr)
    denials = CP.read_denials(denial_log)
    (out / "hook-denials.jsonl").write_text("".join(json.dumps(d) + "\n" for d in denials))
    shutil.rmtree(denial_dir, ignore_errors=True)
    result = CP.evaluate(stdout, exit_code, stderr, denials)
    CP.record(home, args.model, result, codex_bin)
    print(json.dumps(result, indent=2))
    print(f"codex-probe: {'PASS' if result['passed'] else 'FAIL'} for {args.model}; "
          f"stream kept in {out}")
    return 0 if result["passed"] else 1


def cmd_status(args) -> int:
    run_dir, err = _resolve_run_dir_for_diagnostic(args.run_id)
    if run_dir is None:
        return err
    meta = T.read_meta(run_dir)
    print(f"run_id:       {meta['run_id']}")
    print(f"agent:        {meta['agent']}")
    print(f"task:         {meta['task']}")
    print(f"repo:         {meta['repo']}")
    print(f"worktree:     {meta['worktree']}")
    print(f"profile:      {meta['profile']}")
    # ARCH-378: never print a bare `model:` that a fail-over substituted. The
    # 2026-07-19 incident was invisible precisely here — status showed the FINAL
    # model and read exactly like a correctly-resolved cheap agent.
    _resolved = meta.get("model_resolved")
    if meta.get("fallback_from"):
        print(f"model:        {meta['model']}  ⚠ FAILED OVER from "
              f"{meta['fallback_from']} ({meta.get('fallback_reason') or 'reason unrecorded'})")
    elif _resolved and _resolved != meta["model"]:
        print(f"model:        {meta['model']}  (resolved: {_resolved})")
    else:
        print(f"model:        {meta['model']}")
    if meta.get("fallback_blocked_to"):
        print(f"fail-over:    REFUSED → {meta['fallback_blocked_to']} "
              f"({meta.get('fallback_blocked_reason') or 'reason unrecorded'})")
    if meta.get("claude_md_blocked_path"):
        print(f"claude_md:    NOT DELIVERED — {meta['claude_md_blocked_path']} left in "
              f"place ({meta.get('claude_md_blocked_reason') or 'reason unrecorded'})")
    if meta.get("profile_render_skipped"):
        print(f"profile:      NOT RENDERED — target is the {meta['profile_render_skipped']}; "
              f"the run uses the .claude already there")
    if meta.get("held_until"):
        print(f"usage_hold:   held until {meta['held_until']} "
              f"({meta.get('hold_reason') or 'reason unrecorded'})")
    print(f"started:      {meta['started_at']}")
    # Derive done-state from ground truth, not just meta.ended_at (P1b, 2026-07-04):
    # a run killed before _finalize_run (e.g. a foreground parent SIGTERM'd at a
    # caller timeout) never gets ended_at written, so the old `ended_at or "(still
    # running)"` reported a dead run as running forever. outcome.json on disk is the
    # authoritative "finalized" signal (the same one `agentctl wait` uses); a dead pid
    # with no outcome is a killed-not-finalized run, not a live one.
    ended_at = meta.get("ended_at")
    if ended_at:
        ended_display = ended_at
    elif (run_dir / "outcome.json").exists():
        ended_display = "(finalized — see exit_status below)"
    elif meta.get("pid") is not None and _run_process_gone(meta):
        ended_display = "(process gone, not finalized — likely killed mid-run)"
    else:
        ended_display = "(still running)"
    print(f"ended:        {ended_display}")
    print(f"pid:          {meta.get('pid')}")
    print(f"billing:      {meta.get('billing_source')}")
    print(f"cost_cap:     {meta.get('cost_cap_source') or '(unrecorded — predates this field)'}")
    if (run_dir / "outcome.json").exists():
        outcome = T.read_outcome(run_dir)
        print(f"\nexit_status:  {outcome['exit_status']}")
        if outcome.get("terminal_reason"):
            reason_txt = _printable_terminal_reason(outcome["terminal_reason"])
            print(f"terminal_reason: {reason_txt}")
            meaning = _TERMINAL_REASON_MEANING.get(reason_txt)
            if meaning:
                print(f"  meaning:      {meaning}")
        if outcome.get("api_error_status") is not None:
            print(f"api_error_status: {outcome['api_error_status']}")
        if outcome.get("api_error_message"):
            print(f"api_error_message: {outcome['api_error_message']}")
        if outcome.get("error_reason"):
            print(f"error_reason: {outcome['error_reason']}")
        print(f"files_mod:    {outcome.get('files_modified') or '-'}")
        print(f"files_add:    {outcome.get('files_added') or '-'}")
        print(f"files_del:    {outcome.get('files_deleted') or '-'}")
        c = _run_counters(run_dir, outcome)
        print(f"counters:     model={c['model']}  tokens={c['tokens']}  "
              f"tool_calls={c['tool_calls']}  files={c['files']}")
    if (run_dir / "cost.json").exists():
        cost = T.read_cost(run_dir)
        print(f"\ntokens:       in={cost['tokens_in']} out={cost['tokens_out']}")
        print(f"usd:          ${cost['usd']:.4f}")
    return 0


# `result` exit codes. Distinct from `wait`'s 2/3/4 so a caller chaining the two can
# tell which command spoke. 1 (no such run) matches `status` and `wait`.
EXIT_RESULT_UNKNOWN_RUN = 1
EXIT_RESULT_RUNNING = 5
EXIT_RESULT_NONE = 6


def _final_text_of(run_dir: Path) -> str | None:
    """The run's answer: `result` of the LAST `type: result` event in transcript.jsonl,
    else the last assistant text block, else None. Read-only and line-tolerant: a
    torn or non-object line is skipped, since a killed run can end mid-write and its
    earlier lines are still the answer."""
    result_text = assistant_text = None
    try:
        with (run_dir / "transcript.jsonl").open() as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(rec, dict):
                    continue
                if rec.get("type") == "result":
                    if isinstance(rec.get("result"), str) and rec["result"]:
                        result_text = rec["result"]
                elif rec.get("type") == "assistant":
                    msg = rec.get("message")
                    content = msg.get("content") if isinstance(msg, dict) else None
                    if isinstance(content, list):
                        for block in content:
                            if (isinstance(block, dict) and block.get("type") == "text"
                                    and isinstance(block.get("text"), str) and block["text"]):
                                assistant_text = block["text"]
    except OSError:
        pass
    return result_text if result_text is not None else assistant_text


def cmd_result(args) -> int:
    """Print a finished run's final text to stdout, undecorated, so a caller can capture
    it (`out=$(agentctl result run-x)`). Read-only: it never touches the run, its
    worktree or its registry entry."""
    run_dir = _find_run_dir(args.run_id)
    if run_dir is None:
        print(f"no run dir for {args.run_id}", file=sys.stderr)
        return EXIT_RESULT_UNKNOWN_RUN
    try:
        meta = T.read_meta(run_dir)
    except (OSError, ValueError):
        meta = {}
    outcome = None
    if (run_dir / "outcome.json").exists():
        try:
            outcome = T.read_outcome(run_dir)
        except (OSError, ValueError):
            outcome = {}
    if outcome is None:
        # outcome.json is the only proof a run finished. The claude child exiting is not:
        # `_finalize_run` drains its stdout and writes outcome.json from the DISPATCHER
        # afterwards, so in that window the transcript is partial and a child-pid-only
        # test would print it with exit 0 (`wait` made the same mistake, seven false
        # deaths). `_died_without_finalizing` counts the run dead only once the child
        # and the registry-corroborated dispatcher are both gone.
        if _died_without_finalizing(run_dir):
            print(f"{args.run_id} died without finalizing: its process is gone and it "
                  f"never wrote an outcome, so any transcript text is partial "
                  f"(see `agentctl status {args.run_id}`)", file=sys.stderr)
            return EXIT_RESULT_NONE
        print(f"{args.run_id} is still running; block on it with "
              f"`agentctl wait {args.run_id}`, then re-run `agentctl result`",
              file=sys.stderr)
        return EXIT_RESULT_RUNNING
    exit_status = outcome.get("exit_status") or "unknown"
    text = _final_text_of(run_dir)
    if text is None:
        print(f"{args.run_id} finished with no result text (exit_status: {exit_status})",
              file=sys.stderr)
        return EXIT_RESULT_NONE
    if args.json:
        cost = None
        if (run_dir / "cost.json").exists():
            try:
                cost = T.read_cost(run_dir).get("usd")
            except (OSError, ValueError, AttributeError):
                pass
        print(json.dumps({"run_id": meta.get("run_id", args.run_id),
                          "agent": meta.get("agent"), "exit_status": exit_status,
                          "cost_usd": cost, "result": text}))
    else:
        sys.stdout.write(text)
    return 0


# `wait` exit codes. 0 ok / 1 no run dir / 2 timeout were already load-bearing;
# 3 is the killed waiter (ARCH-367), given its own code so a caller branching on
# $? can tell it apart instead of inferring it from a signal-shaped -15.
EXIT_WAITER_KILLED = 3
# 4 is "the wait succeeded and the run FAILED" — the fact the waiter used to
# swallow. A backgrounded `agentctl wait` is how a co learns a dispatch finished,
# and the harness reports the WAITER's exit code; the waiter exited 0 because it
# waited successfully, so a run that died on an API error reported `completed
# (exit code 0)` to its caller. Seven such runs on 2026-08-02, two of them
# reviewers that posted nothing while their co read the notification as a clean
# finish. The exit code is what carries the failure across that boundary.
EXIT_RUN_FAILED = 4

# Exit statuses that mean the dispatched work did NOT happen, so `wait` exits
# EXIT_RUN_FAILED. Deliberately narrower than "not completed":
#   - `committed_not_pushed` is the NORMAL terminal state of a successful worker
#     (ARCH-055: the worker commits, the orchestrator publishes), so failing on
#     it would make every healthy coder dispatch look broken;
#   - `committed_local_only` is the same healthy state in a repo with no remote
#     to publish to — it is not "not pushed", there is nowhere to push;
#   - `superseded` is the resume-watchdog re-spawning a wave on purpose, which
#     the 05:00 healthcheck already treats as fine.
#   - `primary_mutated` IS in the set: the run wrote into a checkout it does not
#     own, so whatever else it produced must be inspected before it is trusted,
#     and a co that reads exit 0 here would publish a run that touched the operator's tree.
#   - `committed_private_only` IS in the set: unlike `committed_not_pushed`, the
#     commit is NOT yet readable from the shared store at all, so a co that reads
#     exit 0 here would report success over work only `agentctl publish --run <id>`
#     can still recover (its `error_reason` names the private directory).
#   - `cost_stopped` IS in the set: the run's per-run cost/token cap fired and the
#     turn never finished, same as `killed`/`errored` — the cap stopping it on
#     purpose is still the work not happening.
WAIT_FAILURE_STATUSES = frozenset(
    {"errored", "killed", "budget_refused", "capacity_refused", "primary_mutated",
     "committed_private_only", "cost_stopped"})

# What a terminal_reason means for an operator. Each entry states only what is known
# of the reason; a value without an entry prints as the bare token.
_TERMINAL_REASON_MEANING = {
    "blocking_limit": (
        "the run's outcome reports terminal_reason blocking_limit. Read the run's "
        "transcript before retrying."),
}
_UNKNOWN_COUNTER = "unknown"
# tool_calls.jsonl carries each call's full input, so its size grows with the run. A
# file over this cap reads `unknown`.
_TOOL_CALLS_MAX_BYTES = 64 * 1024 * 1024
# Model names are the keys of cost.json's by_model, which the run writes. A character
# outside this set (space, `=`, `,`, control or escape bytes) prints as `?`, so a name
# cannot open a second field on the wait line. `/` stays because provider-qualified
# model ids use it.
_MODEL_NAME_UNSAFE_RE = re.compile(r"[^A-Za-z0-9_./:\[\]-]")
_MODEL_NAME_MAX_CHARS = 200


def _run_counters(run_dir: Path, outcome: dict) -> dict[str, str]:
    """A finished run's billed model, token total, tool-call count and changed-file
    count, as printable text. A counter whose source is missing, unreadable or
    malformed reads `unknown`, never 0: zero is a measured figure, and a run that died
    before writing cost.json must not read as one that spent nothing.

    `tokens` is tokens_in + tokens_out summed over every turn, so it is cumulative
    billed input plus output, not the size of the context window. For a transcript-
    derived record, tokens_in includes cache reads and cache writes (`cost_from_usage`
    in telemetry.py). The gateway spend-log path is unverified: `_read_gateway_spend`
    reads only the tokens_in and tokens_out fields and does not say whether the
    gateway counts cache tokens in them.

    `tool_calls` counts tool_calls.jsonl, which holds only calls agentctl matched to a
    result. A call that died before its result is absent, so the figure is a floor,
    not the transcript's total.

    The run writes both files, so they are read through `T.read_capped_regular_file`:
    a FIFO, symlink or oversized file reads `unknown` instead of hanging the caller or
    following a link."""
    counters = {"model": _UNKNOWN_COUNTER, "tokens": _UNKNOWN_COUNTER,
                "tool_calls": _UNKNOWN_COUNTER, "files": _UNKNOWN_COUNTER}
    cost_bytes = T.read_capped_regular_file(run_dir / "cost.json", T._COST_MAX_BYTES)
    if cost_bytes is not None:
        try:
            cost = json.loads(cost_bytes)
            by_model = cost.get("by_model")
            if isinstance(by_model, dict) and by_model:
                # Reduced before the set is taken, so names that differ only in
                # unsafe characters print once. An empty name reads unknown.
                names = sorted({_MODEL_NAME_UNSAFE_RE.sub("?", m) or _UNKNOWN_COUNTER
                                for m in by_model})
                counters["model"] = ",".join(names)[:_MODEL_NAME_MAX_CHARS]
            # OverflowError: a run-written 1e400 parses to inf, and int(inf) raises it.
            # RecursionError: a run-written body nested deeper than json.loads allows.
            counters["tokens"] = str(int(cost["tokens_in"]) + int(cost["tokens_out"]))
        except (ValueError, KeyError, TypeError, AttributeError, OverflowError,
                RecursionError):
            pass
    tool_bytes = T.read_capped_regular_file(run_dir / "tool_calls.jsonl",
                                            _TOOL_CALLS_MAX_BYTES)
    if tool_bytes is not None:
        counters["tool_calls"] = str(sum(1 for ln in tool_bytes.split(b"\n") if ln.strip()))
    # outcome.json is run-written, so each list is checked before len() counts it: a
    # string or dict of the right name would otherwise print a count of characters or
    # keys. Writers produce lists of path strings (`_changed_files`).
    file_lists = [outcome.get(k) for k in
                  ("files_modified", "files_added", "files_deleted")]
    if all(isinstance(f, list) and all(isinstance(p, str) for p in f)
           for f in file_lists):
        counters["files"] = str(sum(len(f) for f in file_lists))
    return counters


def _printable_terminal_reason(reason) -> str:
    """`terminal_reason` as one printable token, reduced at read time wherever it is
    printed. outcome.json sits in a run directory the run's subprocess can reach (see
    `_finalize_run`'s docstring), so the write-time reduction at
    `_TERMINAL_REASON_UNSAFE_RE` does not bound a value read back from it. A missing
    or empty reason reads `unknown`."""
    if not reason:
        return _UNKNOWN_COUNTER
    reduced = _TERMINAL_REASON_UNSAFE_RE.sub("?", str(reason)[:_TERMINAL_REASON_MAX_CHARS])
    return reduced or _UNKNOWN_COUNTER


def _failure_suffix(run_dir: Path, outcome: dict) -> str:
    """The per-run counters `wait` appends to the line of a run that ended non-zero."""
    reason_txt = _printable_terminal_reason(outcome.get("terminal_reason"))
    c = _run_counters(run_dir, outcome)
    return (f"  terminal_reason={reason_txt}  model={c['model']}  tokens={c['tokens']}"
            f"  tool_calls={c['tool_calls']}  files={c['files']}")


def _install_killed_waiter_handler(run_ids: list[str], dirs: dict[str, Path]) -> None:
    """Make a killed WAITER say so, instead of dying silently mid-sleep (ARCH-367).

    THE AMBIGUITY. A backgrounded `agentctl wait` is subject to the harness's
    task-lifetime cap. On a long run the harness kills the WAITER while the run —
    setsid'd out of the caller's process tree — keeps working. Killed inside
    `time.sleep`, the waiter printed nothing at all, so its death was indistinguishable
    from a dispatch that finished.

    That silence is dangerous rather than merely confusing. The intuitive recovery is
    to redispatch, which puts a SECOND worker into the same worktree on the same
    branch, racing the first — a corruption risk, not just wasted tokens. Five
    instances in one vivy co session across 2026-07-21/22.

    So the last thing the waiter does is explain what died and what to do about it.
    This is deliberately a structural fix rather than a documented habit: the doc in
    machine-global CLAUDE.md only helps a reader who already suspects the situation,
    and the whole problem is that nothing signals it.

    SIGKILL cannot be caught, so a hard kill still exits silently — this catches the
    SIGTERM/SIGHUP that a harness or a closing session sends first, which is the case
    actually observed.

    THE SECOND REAL KILLER. The task-lifetime cap above is not the only one: the
    harness also runs a memory-pressure reaper that kills a backgrounded task under
    system memory pressure, stamping a different reason. The operator disabled it machine-wide
    on 2026-09-14 (`CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP=1`, platform/decisions/0082),
    but the variable is read at session launch, so a session started before that
    change keeps reaping until it relaunches. Only the task notification tells the
    two killers apart, so the printed line names the harness and points there rather
    than asserting which of the two actually fired.
    """
    def _on_death(signum, _frame):
        name = signal.Signals(signum).name
        pending = [rid for rid in run_ids if not (dirs[rid] / "outcome.json").exists()]
        out = sys.stdout
        print(f"\nwait: THIS WAITER was killed ({name}) by the harness — usually its "
              f"task-lifetime cap; read the task notification for what it says. The "
              f"run(s) below are NOT affected.", file=out)
        if pending:
            print(f"wait: still running, not the run that died: {' '.join(pending)}",
                  file=out)
            print(f"wait: re-attach (backgrounded) with:  agentctl wait "
                  f"{' '.join(pending)}", file=out)
            print(f"wait: or check liveness with:         agentctl status {pending[0]}",
                  file=out)
            print("wait: do NOT redispatch before checking — a second worker in the "
                  "same worktree races the first.", file=out)
        else:
            print("wait: all runs had already finished; nothing is in flight.", file=out)
        try:
            out.flush()
        except Exception:
            pass
        # os._exit, not sys.exit: SystemExit raised from a handler can be swallowed
        # by the interrupted frame, and a dying process must not depend on unwinding
        # cleanly. Nothing here owns state that needs a finally block.
        os._exit(EXIT_WAITER_KILLED)

    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, _on_death)
        except (ValueError, OSError):
            # Not the main thread, or a platform without the signal: the waiter still
            # works, it just cannot narrate its own death. Never fatal.
            pass


def _uninstall_killed_waiter_handler() -> None:
    """Restore default signal disposition once the wait has decided its exit code.

    The handler exists for the window in which the waiter is BLOCKED and its death
    would be misread. Past that window it is a liability: a SIGTERM arriving while
    the outcome lines print would exit 3 on a wait that succeeded, and `spawn --wait`
    propagates that to its caller as a failure (reviewer, #214)."""
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, signal.SIG_DFL)
        except (ValueError, OSError):
            pass


def _wait_meta(run_dir: Path, rid: str) -> dict | None:
    """This run's meta.json, or None with the gap NAMED on stderr.

    Read ONCE per run and handed to both consumers below, so a run with a broken
    file produces one complaint rather than one per thing that would have been
    reported from it.

    RETURNING None SILENTLY IS THE BUG THIS AVOIDS. `read_meta` raises on
    malformed JSON and yields a non-dict for valid JSON that is a list — and the
    run itself writes this file, since its directory is exported into its own
    environment. Swallowing that would make "this run never failed over" and "I
    could not tell" the same output, which is the absent-is-not-false shape, and
    it would hand the party being reported on a one-file way to look ordinary.
    Degrading to None rather than raising is still right: one agent must not be
    able to suppress the waiter's whole report for a batch.
    """
    try:
        meta = T.read_meta(run_dir)
    except Exception as exc:
        print(f"wait: {rid} — could not read meta.json ({type(exc).__name__}); "
              f"a fail-over or a refused fail-over would NOT be reported for it",
              file=sys.stderr)
        return None
    if not isinstance(meta, dict):
        print(f"wait: {rid} — meta.json is {type(meta).__name__}, not an object; "
              f"a fail-over or a refused fail-over would NOT be reported for it",
              file=sys.stderr)
        return None
    return meta


def _failover_note(meta: dict | None, rid: str) -> str | None:
    """The line for a run that actually swapped provider, or None.

    Every value comes from meta.json, which the run itself can write, so each one
    reaching the terminal goes through `sanitise` — this output is read by a co
    deciding whether to trust a result, and an unescaped newline forges a whole
    extra line of waiter output.
    """
    if not meta or not meta.get("fallback_from"):
        return None
    frm = SC.sanitise(str(meta["fallback_from"]), max_len=80)
    to = SC.sanitise(str(meta.get("model") or "?"), max_len=80)
    why = SC.sanitise(str(meta.get("fallback_reason") or "reason unrecorded"),
                      max_len=200)
    return (f"wait: {rid} FAILED OVER — it ran on {to}, not {frm} ({why}). "
            f"The result was produced at a tier nobody chose (ARCH-131/378).")


# HOW MANY CONSECUTIVE POLLS BOTH THE CHILD AND THE DISPATCHER MUST STAY GONE
# before the waiter calls a run dead. `_finalize_run` writes outcome.json from
# inside the DISPATCHER process (registry-recorded `dispatcher_pid`), well after
# the claude CHILD (`meta["pid"]`) has already exited — so a dispatcher pid that
# is gone has either written outcome.json already or never will, but "already"
# and "visible to this process" are not the same instant, and a waiter that
# announced a death during that window would be wrong in the one direction that
# costs the most. Two polls at the 5s default is ten seconds, against the 23
# HOURS a nightly sweep would take to notice the same thing. This no longer
# bounds how long finalize itself may take — see `_died_without_finalizing`
# (issue_01M1A3B1GQ54207ZYT1NMSVKPY).
_DEAD_POLLS_TO_CONFIRM = 2


def _died_without_finalizing(run_dir: Path) -> bool:
    """The run's process is gone and it never wrote an outcome.

    THE FACT THE WAITER WAS MISSING. Its only notion of finished was
    `outcome.json` appearing, so a run that died before writing one left the
    waiter polling for a file that would never exist — until its timeout, or
    until the harness killed it, with the pid dead the whole time and nothing
    looking. Over July-August 2026 that happened to twenty dispatched runs; ten
    were reviewers, so ten pull requests got substantial review work and no
    verdict while whoever dispatched them waited.

    `cmd_status` has computed exactly this for a long time and prints "(process
    gone, not finalized — likely killed mid-run)". It is a command someone has to
    think to run. This is the same test, in the loop that is already blocking.

    WATCHES BOTH PROCESSES A RUN HAS, NOT JUST ONE. `meta["pid"]` is the claude
    CHILD, returned by `_spawn_claude` as a `Popen` with `stdout=subprocess.PIPE`.
    The DISPATCHER — recorded at spawn as `dispatcher_pid` (see `_run_session`) —
    is the DIFFERENT process that drains that pipe and writes `outcome.json` in
    `_finalize_run`, AFTER the child has already exited. Calling a run dead the
    moment the child's pid disappeared condemned every run whose finalize (a large
    piped transcript, cost accounting, posting a review stamp) outlasted
    `_DEAD_POLLS_TO_CONFIRM` polls — ten confirmed false deaths in one 2026-09-22
    session, all `completed` or `committed_not_pushed` per `agentctl status`
    (issue_01M1A3B1GQ54207ZYT1NMSVKPY). A run is now reported dead only once BOTH
    pids are gone.

    THE THREAT MODEL IS DELIBERATE SAME-UID TAMPERING, NOT ONLY ACCIDENTAL PID
    REUSE — the same threat model `_run_process_gone`'s docstring lays out for the
    child pid. `meta.json` lives in the run's own directory, and the run's own
    Bash tool can write it: `AGENTCTL_RUN_DIR` hands that path directly into the
    run's environment. A run (or content steering one) can start a long-lived
    decoy process and overwrite `meta.json`'s `dispatcher_pid` with its pid, and a
    bare `_pid_alive` on a value read from there would then read the decoy as the
    real dispatcher forever — the exact gap PR #457 closed for the child pid,
    reopened here for the dispatcher one (security review, PR #641 round 1). So
    BOTH pids checked here — child and dispatcher — are read from and
    corroborated against the REGISTRY (`R.get_run`), never from meta.json:
    `R.attach_pid` records `dispatcher_pid` and `dispatcher_pid_started_at` the
    same way it already records the child's `pid`/`pid_started_at` (`R.add_run`
    does too, for the respawn and dry-run paths that write a fresh entry outright
    instead of filling one in), written by the dispatcher itself under the
    registry's own flock, a file whose path is never exported into a run's
    environment and which the run has no reason to write. `meta.json`'s own
    `dispatcher_pid` field still exists, for a human reading the file — nothing
    here uses it for liveness.

    A run registered before this field existed has no `dispatcher_pid` in its
    REGISTRY entry (an older entry shape, or the registry entry already reaped);
    for those there is no second pid to corroborate against, so this falls back
    to the child-pid-only test that is all such a run ever had.

    META IS RE-READ EVERY POLL RATHER THAN CACHED, because the pid changes under
    us: an ARCH-131 fail-over respawns in place and writes a new one, so a cached
    pid would read as dead the moment the first attempt exited and report a
    recovering run as vanished.

    Unknown is NOT dead. A missing or unreadable meta, a pid not yet recorded, or
    no registry entry for this run_id returns False and the waiter keeps
    waiting — the run may simply be starting.

    "Gone" for both pids is registry-corroborated, not a bare `_pid_alive`: a live
    pid — the OS having recycled it, or a decoy process started to survive the
    check — is corroborated against the start time the registry recorded at
    spawn, so a pid that fails to match reads as gone rather than as the original
    process still running.
    """
    if (run_dir / "outcome.json").exists():
        return False
    try:
        meta = T.read_meta(run_dir)
    except Exception:
        return False
    if not _run_process_gone(meta):
        return False
    entry = R.get_run(meta.get("run_id"))
    dispatcher_pid = entry.get("dispatcher_pid") if entry else None
    if dispatcher_pid is None:
        return True  # pre-fix / unregistered run: no second pid to check, old behaviour stands
    if not _pid_alive(dispatcher_pid):
        return True
    recorded = entry.get("dispatcher_pid_started_at")
    if not recorded:
        return False
    current = _pid_start_time(dispatcher_pid)
    if current is None:
        return False
    return current != recorded  # mismatch: the OS recycled the pid, or a decoy took it — gone either way


def _wait_for_runs(run_ids: list[str], *, timeout: float | None, poll: float,
                   any_: bool = False) -> int:
    """Block until the given detached run(s) finish; the shared body of `wait`.

    Factored out so `spawn --wait` cannot drift from `wait` — they are the same
    operation, and two copies of a polling loop with two notions of "finished" is
    exactly the seam where a dispatcher starts believing a run ended that hasn't.

    Exits EXIT_RUN_FAILED (4) when a run it waited on ended in a
    WAIT_FAILURE_STATUSES status. "Finished" and "succeeded" are different facts
    and the waiter now carries both: it waited successfully AND the work did not
    happen, which is precisely the case a caller must not read as done.

    AND WHEN A RUN ENDS WITHOUT FINISHING AT ALL. There is a third fact, and this
    loop used to have no way to see it: a run whose process is gone that never
    wrote an outcome. Waiting on `outcome.json` alone meant waiting for a file
    that would never be written — until the timeout, or until the harness killed
    the waiter — with the pid dead the whole time and nothing looking. That is
    what happened to twenty dispatched runs over July-August 2026, ten of them
    reviewers, so ten pull requests received substantial review work and no
    verdict while their dispatcher waited.

    Detection is ~10s (two polls at the 5s default), against the ~23 hours a
    nightly sweep takes to reach the same conclusion. The sweep still exists and
    is still worth having — it catches runs nobody was waiting on — but it is the
    backstop, and this is the mechanism. A postmortem is not detection.
    """
    dirs: dict[str, Path] = {}
    for rid in run_ids:
        d = _find_run_dir(rid)
        if d is None:
            print(f"wait: no run dir for {rid}", file=sys.stderr)
            return 1
        dirs[rid] = d
    _install_killed_waiter_handler(run_ids, dirs)
    # Say what is being watched, before blocking. A backgrounded waiter otherwise
    # prints NOTHING until it finishes, so a caller has no confirmation it attached
    # to the run it meant — a mistyped run-id and a slow run look identical for as
    # long as the run lasts. stderr because that is already this function's channel
    # for diagnostics (no-run-dir, timeout), leaving stdout to the result lines a
    # caller may parse.
    print(f"wait: watching {len(run_ids)} run(s): {' '.join(run_ids)}", file=sys.stderr,
          flush=True)
    deadline = time.monotonic() + timeout if timeout else None
    done = lambda rid: (dirs[rid] / "outcome.json").exists()
    # A RUN CAN END WITHOUT FINISHING, and until now this loop had no way to say
    # so. `done` waits for a file; `dead_strikes` watches the process that would
    # write it. See `_died_without_finalizing`.
    dead_strikes = {rid: 0 for rid in run_ids}
    while True:
        for rid in run_ids:
            if done(rid):
                dead_strikes[rid] = 0
            elif _died_without_finalizing(dirs[rid]):
                dead_strikes[rid] += 1
            else:
                # Consecutive, not cumulative: a run that looked dead once and is
                # alive now was a misread, and must not carry a strike forward.
                dead_strikes[rid] = 0
        vanished = [rid for rid in run_ids
                    if dead_strikes[rid] >= _DEAD_POLLS_TO_CONFIRM]
        finished = {rid: done(rid) or rid in vanished for rid in run_ids}
        if (any if any_ else all)(finished.values()):
            break
        if deadline is not None and time.monotonic() >= deadline:
            # Same reason as after the loop: this path has decided its own exit code
            # (2), so the handler must not overwrite it with 3 mid-print.
            _uninstall_killed_waiter_handler()
            pending = [rid for rid, ok in finished.items() if not ok]
            print(f"wait: timeout after {timeout:.0f}s; still running: "
                  f"{', '.join(pending)}", file=sys.stderr)
            return 2
        time.sleep(poll)
    # The runs are done, so the waiter is no longer the thing whose death matters.
    # Leaving the handler installed means a SIGTERM arriving during the printing
    # below — a small window, but a real one — exits 3 on a wait that SUCCEEDED, and
    # `spawn --wait` propagates that to its caller as a failure (reviewer, #214).
    _uninstall_killed_waiter_handler()
    failed: list[tuple[str, dict]] = []
    metas: dict[str, dict | None] = {}
    for rid in run_ids:
        d = dirs[rid]
        if (d / "outcome.json").exists():
            o = T.read_outcome(d)
            usd = T.read_cost(d)["usd"] if (d / "cost.json").exists() else 0.0
            line = f"{rid}  {o['exit_status']}  ${usd:.4f}"
            # A non-zero run carries its counters on the same line, so the operator
            # sees what it burned and how it ended without opening the directory.
            if o.get("exit_status") in WAIT_FAILURE_STATUSES:
                line += _failure_suffix(d, o)
            print(line)
            # AN ACTION IS REPORTED AS LOUDLY AS A REFUSAL, and this is the half
            # that succeeds. 68 runs failed over across June-August 2026 and 64 of
            # them COMPLETED, so they never reach the failure loop below and the
            # waiter said nothing at all: a run that quietly finished at a
            # different provider looked exactly like one that finished where it
            # was sent. That is the 2026-07-19 incident shape verbatim, which
            # `cmd_status` already refuses to reproduce ("never print a bare
            # model: that a fail-over substituted") — but `status` is a command
            # someone must think to run, and this line is one they already read.
            # `dirs[rid]`, never a loop-carried name — the first version of the
            # refusal read below used one and reported a run's metadata under a
            # different run's id.
            metas[rid] = _wait_meta(dirs[rid], rid)
            _fo = _failover_note(metas[rid], rid)
            if _fo:
                print(_fo, file=sys.stderr)
            if o.get("exit_status") in WAIT_FAILURE_STATUSES:
                failed.append((rid, o))
        elif rid in vanished:
            # NOT "(still running)", which is what this printed before and is the
            # most expensive thing the waiter could say here: it sends the caller
            # back to poll a run whose process has already gone.
            print(f"{rid}  died-unfinalized  $0.0000")
        else:
            print(f"{rid}  (still running)")

    if vanished:
        # LOUD, ON STDERR, AND NON-ZERO — the same treatment a failed run gets,
        # because this is worse: a failed run at least recorded why. There is no
        # outcome.json, no exit status, no cost and no terminal reason, and
        # nothing else will ever write them.
        for rid in vanished:
            print(f"wait: {rid} DIED WITHOUT FINALIZING — its process is gone and "
                  f"no outcome.json was ever written, so it has no exit status, "
                  f"no cost and no terminal reason.", file=sys.stderr)
        print(f"wait: {len(vanished)} run(s) vanished mid-flight. Do NOT read a "
              f"stamp, a PR or a queue entry as their result — they may have left "
              f"a worktree, a branch or a half-posted comment, so inspect before "
              f"re-dispatching: agentctl status {vanished[0]}", file=sys.stderr)

    if failed or vanished:
        # Loud, on stderr, and then a non-zero exit — because the caller may be a
        # harness notification with no reader, a bash step, or a co that will
        # otherwise go read a stamp from an earlier round and call the PR cleared.
        for rid, o in failed:
            why = o.get("api_error_message") or o.get("error_reason") or ""
            # `terminal_reason` is now recorded for every run rather than only
            # api_error deaths, so this line can read "FAILED ... (completed)" —
            # which is not a contradiction and must not be read as one. It means
            # the harness ended the session cleanly and agentctl failed the run
            # anyway. Say so, rather than leaving a caller to reconcile two words
            # that look opposed.
            #
            # WHY the run was failed depends on the exit_status, and naming the
            # wrong cause is worse than naming none. `errored` with a clean
            # `completed` is the ARCH-397 downgrade and can be nothing else — it
            # is the only "completed" → "errored" transition in `_finalize_run`.
            # But `primary_mutated` reaches this same bucket with the same reason,
            # for ANY agent rather than only a review one, and that is the more
            # serious incident of the two: a run wrote into a checkout it does not
            # own. Pointing its reader at a missing review stamp would send them
            # looking for the wrong thing entirely.
            reason = o.get("terminal_reason")
            shown_reason = _printable_terminal_reason(reason)
            if reason == "completed" and o["exit_status"] == "errored":
                note = " (harness ended the session cleanly — agentctl failed it; " \
                       "for a review run this is the missing-stamp downgrade)"
            elif reason == "completed":
                note = " (harness ended the session cleanly — agentctl failed it on " \
                       f"{o['exit_status']}; see that status, not the reason)"
            elif reason:
                note = f" ({shown_reason})"
            else:
                note = ""
            print(f"wait: {rid} FAILED — exit_status={o['exit_status']}" + note
                  + (f": {why}" if why else ""), file=sys.stderr)
            meaning = _TERMINAL_REASON_MEANING.get(shown_reason)
            if meaning:
                print(f"wait: {rid} {shown_reason} — {meaning}", file=sys.stderr)
            # AND NAME A REFUSED RECOVERY, because until now nothing did.
            #
            # When a fail-over is declined (ARCH-378: an interactive origin, or a
            # target below the agent's model_floor) the run dies with a working
            # recovery target sitting beside it. That decision is recorded in
            # meta.json and, measured across 13,707 June-August 2026 run
            # directories, 101 runs carried it — 48 of them review agents holding
            # a --pr, so 48 pull requests lost a review this way.
            #
            # The refusal block's own comment reasons that refusing "puts the
            # choice back to the human, who sees it via the ARCH-367 waiter". This
            # is that waiter, and it printed exit_status and terminal_reason and
            # nothing else. The only reader of the field in the whole repo was
            # `agentctl status <run-id>` — a command someone has to think to run,
            # against a run id they must already hold. The recording was real and
            # the route to the human was not.
            #
            # 98 of the 101 are the interactive-origin refusal specifically, which
            # BY DEFINITION had a co waiting on this line. This is their report.
            #
            # Read once in the loop above and keyed by run id, so a broken file
            # produces one complaint rather than one per consumer, and so nothing
            # here can pick up a loop-carried directory by accident — the first
            # version used the `d` left bound by the polling loop and reported one
            # run's metadata under another run's id.
            meta = metas.get(rid)
            blocked_to = meta.get("fallback_blocked_to") if meta else None
            if blocked_to:
                # SANITISED, because meta.json sits in the run tree every
                # dispatched agent can write, and this line is read by a co
                # deciding whether a review landed. An unescaped value with a
                # newline in it forges a second line of waiter output — the same
                # surface that made `terminal_reason` a security finding when it
                # first became printable. `sanitise` collapses newlines and strips
                # control characters rather than reducing to a token charset,
                # because a legitimate reason is a sentence with spaces and
                # punctuation in it.
                reason_txt = SC.sanitise(
                    str(meta.get("fallback_blocked_reason") or "reason unrecorded"),
                    max_len=200)
                print(f"wait: {rid} had a recovery available and REFUSED it — "
                      f"fail-over to {SC.sanitise(str(blocked_to), max_len=80)} "
                      f"was blocked: {reason_txt}. Re-dispatch with an explicit "
                      f"--model to override (ARCH-378).", file=sys.stderr)
        # THE MESSAGE IS PER-STATUS, because "it failed" means two different
        # things here (`issue_01KZ94NMS1CD2FQBEG5X1JWH83`).
        #
        # For `errored` / `killed` / `budget_refused` / `capacity_refused` the
        # turn did not finish, so nothing reached a reader. Deliberately narrower
        # than "they left nothing behind": a `killed` run can have made local
        # commits before the signal reached it, so claiming nothing was committed
        # would be false for exactly the status a caller most needs to inspect
        # (reviewer, #351).
        #
        # For `primary_mutated` that sentence is FALSE, and false in the
        # direction that costs money. The status is assigned in `_finalize_run`,
        # which runs AFTER the agent's turn ends, while a reviewer posts its stamp
        # DURING the turn. So the sequence is: review completes, stamp lands on
        # the PR, finalize downgrades, wait exits 4, caller is told nothing was
        # published. On 2026-08-04/05 six reviewer runs on knowledge#171 and #172
        # ended this way with all six reviews already on their PRs; the
        # orchestrating co believed the message, reported ~$2.20 of review work
        # "discarded", and re-dispatched duplicates — paying twice for reviews it
        # already had and leaving real findings unread for hours.
        #
        # Same false-confidence shape as ARCH-397 and ARCH-439, inverted: those
        # were a run reporting success having produced nothing, this is a run
        # reporting nothing having produced its whole output.
        #
        # `committed_private_only` gets the same carve-out as `primary_mutated`,
        # and for the same reason: the generic barren message below says
        # "Re-dispatch", and that is false for this status specifically. The
        # run's commits exist — they are sitting in its private object store,
        # not lost — and `agentctl publish --run <id>` recovers them; dispatching
        # again pays for the same work twice while the recoverable commits sit
        # unread. The per-run line printed above, from `error_reason`, already
        # says this ("do not re-dispatch"); the bucket message used to say the
        # opposite in the same breath (reviewer, PR #870 round 1).
        mutated = [(rid, o) for rid, o in failed
                   if o.get("exit_status") == "primary_mutated"]
        private_only = [(rid, o) for rid, o in failed
                        if o.get("exit_status") == "committed_private_only"]
        # `cost_stopped` is NOT excluded from `barren` (reviewer, PR #874 round
        # 1): a run the cap killed mid-turn can still have committed real work
        # first, and the committed-work detection — "check the worktree for
        # local commits first if the run was killed" — applies to it exactly as
        # much as to any other killed run. Leaving it out of `barren` meant that
        # instruction never printed for a cost-capped run at all, so a caller
        # got only the budget note below and nothing telling them to look for
        # local commits before concluding there is nothing to recover.
        # `primary_mutated` and `committed_private_only` stay excluded: both
        # buckets' own messages already say their work is REAL and must not be
        # re-dispatched, the opposite of `barren`'s "did NOT do the work".
        cost_stopped = [(rid, o) for rid, o in failed
                        if o.get("exit_status") == "cost_stopped"]
        barren = [(rid, o) for rid, o in failed
                  if o.get("exit_status") not in
                  ("primary_mutated", "committed_private_only")]
        if barren:
            print(f"wait: {len(barren)} run(s) did NOT do the work. Nothing was "
                  f"published on their behalf — no review stamp, no PR, no queue "
                  f"entry — so do not read one as this run's result. Re-dispatch, "
                  f"and check the worktree for local commits first if the run was "
                  f"killed.", file=sys.stderr)
            # A review run can fail to POST while having done the whole review.
            # Finalize saves that text (ARCH-397); name it here, because the cost
            # of this failure was never the tokens — it was a caller hand-parsing
            # JSONL to recover a review that already existed, four times in one
            # session. Do not print the review itself: it is long, and a caller
            # who reads it inline is a caller who might relay it as a verdict.
            for rid, _o in barren:
                try:
                    rescued = T.run_dir(rid) / "unposted-review.md"
                except Exception:
                    continue
                if rescued.exists():
                    print(f"wait: {rid} WROTE a review and never posted it — "
                          f"{rescued}. Read it; do not post it on the run's behalf, "
                          f"and re-dispatch for a real stamp.", file=sys.stderr)
        if mutated:
            print(f"wait: {len(mutated)} run(s) DID their work and then mutated a "
                  f"primary checkout. The two facts are independent, which is why "
                  f"this is its own status rather than `errored`: a review stamp, "
                  f"PR or queue entry from these runs is REAL and should be read. "
                  f"Do NOT re-dispatch on this status alone — you would pay twice "
                  f"for output you already have. Investigate the mutation "
                  f"separately: {', '.join(rid for rid, _ in mutated[:6])}"
                  # Name the count rather than trailing an ellipsis. A bounded
                  # list that does not say what it dropped reads as the whole set
                  # (security-reviewer, PR #368).
                  + (f" and {len(mutated) - 6} more" if len(mutated) > 6 else "")
                  + ", detail in each run dir's primary_mutations.json.",
                  file=sys.stderr)
        if private_only:
            print(f"wait: {len(private_only)} run(s) COMMITTED but the commits "
                  f"are readable only from each run's own private object store, "
                  f"not yet from the shared repo. Do NOT re-dispatch on this "
                  f"status alone — you would pay twice for output you already "
                  f"have. `agentctl publish --run <id>` imports and pushes each "
                  f"one: {', '.join(rid for rid, _ in private_only[:6])}"
                  + (f" and {len(private_only) - 6} more" if len(private_only) > 6 else "")
                  + ".", file=sys.stderr)
        if cost_stopped:
            print(f"wait: {len(cost_stopped)} run(s) were stopped for crossing their "
                  f"per-run cost or token cap (ARCH-185/ARCH-245) — a budget decision, "
                  f"not a crash. Re-dispatching as-is repeats the same spend and hits "
                  f"the same cap; raise the cap deliberately or change what the run is "
                  f"doing first. See each run's error_reason for which cap fired: "
                  f"{', '.join(rid for rid, _ in cost_stopped[:6])}"
                  + (f" and {len(cost_stopped) - 6} more" if len(cost_stopped) > 6 else "")
                  + ".", file=sys.stderr)
        # `failed` can be EMPTY here now: a run that vanished mid-flight reaches
        # this block with no outcome to have failed. Naming a run id is still the
        # useful last line, so take it from whichever list has one.
        _detail = failed[0][0] if failed else vanished[0]
        print(f"wait: full detail:  agentctl status {_detail}", file=sys.stderr)
        return EXIT_RUN_FAILED
    return 0


def cmd_wait(args) -> int:
    """Block in the FOREGROUND until the given detached run(s) finish: their run
    dir gets outcome.json (written by _finalize_run at exit; now guaranteed even
    for a lingering process by the ARCH-069 reaper), OR the run's process is
    gone and outcome.json will now never come — see `_died_without_finalizing`.

    The overnight orchestrator MUST call this after dispatching a detached
    worker instead of yielding its turn to a backgrounded poll + notification:
    in `claude -p`, ending the turn ends the session, which abandons the run
    mid-flight (ARCH-070 — the 2026-05-27 vivy drain quit ~33 min in while
    "waiting for the reviewer"). A foreground `agentctl wait` keeps the turn
    alive until the worker is genuinely done.

    Returns 0 when the wait condition is met AND every finished run succeeded,
    4 when one of them ended errored/killed/budget_refused/capacity_refused/
    cost_stopped OR died without finalizing (its process vanished mid-flight — inspect with
    `agentctl status` before re-dispatching, per the waiter's own stderr), 2 on
    timeout (prints the still-running ids so the caller can kill + skip-defer),
    1 if an id won't resolve, 3 if the waiter itself was killed."""
    return _wait_for_runs(args.run_id, timeout=args.timeout, poll=args.poll,
                          any_=args.any)


# verify-init exit codes (ARCH-254). 0/2/3 chosen so the overnight orchestrator
# can branch on $?: 0 healthy, 3 re-dispatch, 2 leave-alone.
VERIFY_INIT_OK = 0        # init event seen, or the run already finalized → lived
VERIFY_INIT_TIMEOUT = 2   # pid still alive but no init yet → slow-but-alive, don't re-dispatch
VERIFY_INIT_PREDEATH = 3  # pid dead, no init, no outcome → pre-init death, re-dispatch


def _pid_alive(pid) -> bool:
    """True if `pid` names a live process. None/garbage/non-positive → False.
    pid <= 0 is rejected up front: os.kill(0, 0) signals the whole process group
    (would read as alive), and negative pids are group ids — neither is a worker."""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (OSError, OverflowError):
        return False
    return True


def _pid_start_time(pid) -> str | None:
    """The OS's record of when `pid` started, or None if it can't be read.

    `ps -p <pid> -o lstart=` runs the same on darwin and the ubuntu CI runner
    (unlike /proc, which darwin doesn't have). None covers every failure —
    missing `ps`, the pid already gone, a non-numeric pid — so a caller treats
    "can't tell" as absence of evidence rather than as a mismatch.
    """
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    try:
        cp = subprocess.run(["ps", "-p", str(pid), "-o", "lstart="],
                            capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if cp.returncode != 0:
        return None
    return cp.stdout.strip() or None


def _run_process_gone(meta: dict) -> bool:
    """True if the pid meta.json records is not this run's live process —
    outright dead, or a live pid the OS has since recycled to an unrelated
    process.

    A bare `os.kill(pid, 0)` only proves *some* process holds that number; the
    OS reuses pids, so a recycled one belonging to an unrelated long-lived
    process reads as alive forever. Corroborating the live pid against the
    start time the OS recorded for it at spawn turns a mismatch into proof of
    reuse instead of a mere suspicion.

    THE RECORDED START TIME COMES FROM THE REGISTRY (`registry.get_run`), NOT
    FROM meta.json, and that is load-bearing, not a style choice. meta.json
    lives in the run's own directory, which the run's Bash tool can write —
    same UID, and the directory is handed to the run in its own environment.
    An earlier version of this fix recorded the start time in meta itself,
    which closed the pid-recycling case but opened a narrower one: a single
    bad write to meta's `pid_started_at` field, with the pid left genuinely
    alive and untouched, was on its own enough to make a live run read as
    dead (security review, PR #457 round 2 — the round's own new test proved
    it by doing exactly that). The registry's `active.json` is written only
    by the dispatcher, under `fcntl.flock`, and its path is never exported
    into a run's environment — the run itself has no path to it and no
    reason to write it, so a buggy or confused agent clobbering its own
    metadata can no longer condemn itself this way.

    THIS IS NOT A SECURITY BOUNDARY — active.json is still same-UID writable,
    and a prior session tested using this registry as a trust anchor against
    a genuinely adversarial actor and rejected it for exactly that reason.
    What moving the value here closes is the realistic failure: a run has
    both the path to its own meta.json and reasons to write it, and has
    neither for the registry. `cmd_status`'s advisory line and
    `_died_without_finalizing`'s wait-loop verdict both call this function,
    and now read a start time the run being checked cannot have written —
    they agree because the source is out of that run's reach, not merely
    because they call the same code.

    Absence of evidence is not evidence of absence: no pid recorded in meta,
    no registry entry for this run_id (already reaped, or an older run from
    before this field existed), no `pid_started_at` on that entry, or the
    current start time unreadable (`ps` unavailable, a transient failure) —
    every one of those returns False, the same "unknown is NOT dead" posture
    `_pid_alive` already carries.
    """
    pid = meta.get("pid")
    if pid is None:
        return False
    if not _pid_alive(pid):
        return True
    entry = R.get_run(meta.get("run_id"))
    recorded = entry.get("pid_started_at") if entry else None
    if not recorded:
        return False
    current = _pid_start_time(pid)
    if current is None:
        return False
    return current != recorded


def _transcript_has_init(run_dir: Path) -> bool:
    """True once the session has emitted its `init` system event — the marker
    that `claude -p` has made its first API call. Substring-prefiltered so we
    only JSON-parse candidate lines."""
    tpath = run_dir / "transcript.jsonl"
    try:
        with tpath.open() as f:
            for line in f:
                if '"init"' not in line:
                    continue
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("type") == "system" and ev.get("subtype") == "init":
                    return True
    except OSError:
        return False
    return False


def _safe_meta_pid(run_dir: Path):
    """Best-effort pid from meta.json, None if unreadable. `update_meta` writes
    the pid by truncate-then-write, so a poll can catch the file empty or partial
    (json.loads('') → JSONDecodeError, a ValueError subclass) — that's 'pid not
    known yet', not a crash. Treating it as None keeps verify-init polling rather
    than exiting 1 (which an orchestrator can't tell from 'run dir not found')."""
    if not (run_dir / "meta.json").exists():
        return None
    try:
        return T.read_meta(run_dir).get("pid")
    except (OSError, ValueError):
        return None


def _verify_init_state(run_dir: Path, pid) -> str:
    """One-shot classification, no waiting: 'init' (reached init, or finalized →
    it lived), 'predeath' (pid dead before init and no clean finalize), or
    'pending' (no verdict yet). Pure except for the pid liveness probe."""
    if _transcript_has_init(run_dir):
        return "init"
    if (run_dir / "outcome.json").exists():
        return "init"  # finalized (even a fast run that beat our first poll) → lived
    if pid is not None and not _pid_alive(pid):
        return "predeath"
    return "pending"


def cmd_verify_init(args) -> int:
    """Poll a just-spawned worker until its `init` event appears, or it dies
    before reaching init (ARCH-254). The overnight orchestrator calls this right
    after a detached `agentctl spawn` and re-dispatches on a pre-init death (exit
    3) instead of letting a silently-dead worker sit unnoticed until the 05:00
    healthcheck — the failure class behind the ARCH-253 worker losses.

    Re-reads meta each poll so it tolerates the brief window before the detached
    grandchild writes its pid. Exit: 0 init (or finalized), 3 pre-init death,
    2 timeout (pid alive, no init yet — treat as slow-but-alive)."""
    run_dir = _find_run_dir(args.run_id)
    if run_dir is None:
        print(f"verify-init: no run dir for {args.run_id}", file=sys.stderr)
        return 1
    deadline = time.monotonic() + args.timeout
    while True:
        pid = _safe_meta_pid(run_dir)
        state = _verify_init_state(run_dir, pid)
        if state == "init":
            print(f"{args.run_id}  init ok")
            return VERIFY_INIT_OK
        if state == "predeath":
            print(f"verify-init: {args.run_id} died before init "
                  f"(pid {pid} gone, no init event, no outcome) — pre-init death",
                  file=sys.stderr)
            return VERIFY_INIT_PREDEATH
        if time.monotonic() >= deadline:
            print(f"verify-init: {args.run_id} no init within {args.timeout:.0f}s; "
                  f"pid {pid} still alive — slow-but-alive, not re-dispatching",
                  file=sys.stderr)
            return VERIFY_INIT_TIMEOUT
        time.sleep(args.poll)


def cmd_logs(args) -> int:
    run_dir, err = _resolve_run_dir_for_diagnostic(args.run_id)
    if run_dir is None:
        return err
    transcript = run_dir / "transcript.jsonl"
    if not args.follow:
        sys.stdout.write(transcript.read_text())
        return 0
    with transcript.open() as f:
        f.seek(0, 2)
        while True:
            line = f.readline()
            if not line:
                if not R.get_run(args.run_id):
                    return 0
                time.sleep(0.5)
                continue
            sys.stdout.write(line); sys.stdout.flush()


# --- session dir (ARCH-361 / agent-platform#141) -------------------------------

SESSION_DIR_ENV = "CONVIVY_SESSION_DIR"


def session_id_for(path: Path) -> str:
    """A session's stable, globally-unique identity, derived from its run dir.

    The dir name alone (co-vivy-2322) repeats every day, so it cannot identify a
    session on its own. Qualifying it with the run-dir's date gives one string
    that is unique, sortable, and readable — used as the issue-claim owner, so
    the queue can show WHICH session holds an issue (ARCH-361 Part B).
    """
    return f"{path.parent.name}/{path.name}"


def cmd_session_dir(args) -> int:
    """Create (or resolve) this session's canonical run directory and print it.

    The model is deliberately not in the naming path. A co session used to
    compose `co-<product>-<HHMM>` itself, and on 2026-07-17 a vivy session
    inferred its local time by converting a UTC instant through "Mountain Time",
    picked up a DST offset Arizona does not observe, and named its handoff dir an
    hour into the future (agent-platform#141). A correct instruction to call
    `date` was already in the skill and was simply skipped, which is why the fix
    is to remove the choice rather than to reword the instruction — the ARCH-311
    failure class, LLM nondeterminism feeding a deterministic consumer.

    So: one `datetime.now().astimezone()` call, one implementation, here.

    Idempotent per session. With CONVIVY_SESSION_DIR exported, this returns that
    directory unchanged — handoff-leave and a claim taken hours apart must agree
    on the session's identity, and re-deriving it from the clock would not.
    Without it, a session with CLAUDE_CODE_SESSION_ID set gets the directory it
    recorded on its first call (lib/agent-platform/co_rollover.py), so the ops MCP
    `handoff_write` tool and `bin/co-rollover` resolve the same path. Only a call
    with neither variable mints a new directory every time.
    """
    product = args.product.strip().lower()
    if not CRO.PRODUCT_SLUG_OK.match(product):
        print(f"error: --product must be a lowercase slug, got {args.product!r}", file=sys.stderr)
        return 2

    existing = os.environ.get(SESSION_DIR_ENV, "").strip()
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "").strip()
    if existing:
        d = Path(existing)
        if not d.is_dir():
            print(f"error: {SESSION_DIR_ENV} points at {existing}, which is not a directory",
                  file=sys.stderr)
            return 1
    else:
        # ONE clock read: the day bucket is derived from the same instant as the
        # HHMM, so a midnight crossing between two reads cannot file a directory
        # whose name belongs to one day and whose parent bucket belongs to the
        # next. (Same formula as T.platform_day(), which reads the clock itself.)
        now = datetime.now().astimezone()
        if session:
            try:
                d = CRO.session_handoff_dir(session, product, runs_root=T.RUNS_ROOT, now=now)
            except CRO.HandoffDirError as exc:
                print(f"error: {exc}", file=sys.stderr)
                return 1
        else:
            d = CRO.mint_handoff_dir(product, runs_root=T.RUNS_ROOT, now=now)

    print(session_id_for(d) if args.print_ == "id" else str(d))
    return 0


def cmd_budget(_args) -> int:
    print(f"date:           {T.platform_day()} (local)")
    # Each autonomous pool is gated independently (ARCH-320); interactive spend is
    # shared context (not pool-scoped), so print it once.
    interactive = None
    for pool in B.POOL_ORIGINS:
        bstatus = B.status(pool)
        interactive = bstatus["interactive_today_usd"]
        origins = "+".join(B.POOL_ORIGINS[pool])
        soft_tag = "  (CROSSED)" if bstatus["soft_crossed"] else ""
        hard_tag = "  (SPAWNS REFUSED)" if bstatus["hard_crossed"] else ""
        soft_m = "set" if bstatus["soft_marker_exists"] else "unset"
        hard_m = "set" if bstatus["hard_marker_exists"] else "unset"
        print(f"[{pool} pool]  ({origins})")
        print(f"  spent:        ${bstatus['spent_today_usd']:.4f}  "
              f"(completed ${bstatus['completed_usd']:.4f} + in-flight est "
              f"${bstatus['estimated_inflight_usd']:.4f})  ← caps gate on this")
        print(f"  soft warn:    ${bstatus['soft_usd']:.2f}{soft_tag}")
        print(f"  hard cap:     ${bstatus['hard_usd']:.2f}{hard_tag}")
        print(f"  markers:      soft={soft_m}  hard={hard_m}")
    print(f"interactive:    ${interactive:.4f}  (uncapped; co-session work)")
    return 0


def _list_models() -> list[dict]:
    """The models this platform serves, in the order and shape the
    platform/contracts/agentctl-models contract fixes: MODEL_ALIASES entries
    first (dict order), then _MODEL_TIERS ids no alias maps to (alias null),
    each model exactly once. Built from those two tables directly — no second
    copy of a model name lives here."""
    seen: set[str] = set()
    models: list[dict] = []
    for alias, model in MODEL_ALIASES.items():
        if model in seen:
            continue  # a later alias for an already-listed model; keep the first
        seen.add(model)
        models.append({"alias": alias, "model": model,
                       "provider": "gateway" if is_gateway_model(model) else "anthropic"})
    for model in _MODEL_TIERS:
        if model in seen:
            continue
        seen.add(model)
        models.append({"alias": None, "model": model,
                       "provider": "gateway" if is_gateway_model(model) else "anthropic"})
    return models


def cmd_models(args) -> int:
    models = _list_models()
    if getattr(args, "json", False):
        print(json.dumps({"schema_version": 1, "models": models}))
        return 0
    alias_w = max((len(m["alias"] or "") for m in models), default=0)
    for m in models:
        print(f"{(m['alias'] or ''):<{alias_w}}  {m['model']:<30}  {m['provider']}")
    return 0


def _collect_run_descendants(root_id: str) -> list[dict]:
    """All in-flight runs transitively parented by root_id (BFS over the registry).

    `R.list_runs()` reaps dead pids first, so this returns only descendants that
    are still alive — exactly the leak target. A live grandchild whose parent has
    already deregistered (the canary 2026-06-27 orphan: a fix-drain agent died,
    its wrapper removed it from the registry, but its dispatched bug-fixer kept
    running) is still found here by its `parent_run` link to root_id.

    Limitation: a descendant reachable only THROUGH an already-removed
    intermediate is not found (the parent-chain link is gone). The canary failure
    mode — a direct child of the reaped run — is covered; deeper transitive
    orphans through a dead middle run are rare and out of scope for this reaper.
    """
    live = R.list_runs()
    children: dict[str, list[dict]] = {}
    for r in live:
        p = r.get("parent_run")
        if p:
            children.setdefault(p, []).append(r)
    out: list[dict] = []
    queue = list(children.get(root_id, []))
    seen: set[str] = set()
    while queue:
        run = queue.pop(0)
        rid = run.get("run_id")
        if not rid or rid in seen:
            continue
        seen.add(rid)
        out.append(run)
        queue.extend(children.get(rid, []))
    return out


def _terminate_run(run_id: str, final: bool) -> int:
    """Kill one run by its registry pid and finalize its run dir + registry entry.

    Returns 0 when the run was killed/cleared, 1 when run_id is not in the
    registry (already finalized). Extracted from cmd_kill so the same delicate
    SIGTERM -> poll -> SIGKILL -> finalize sequence serves both the root kill and
    each descendant under `kill --tree`.
    """
    entry = R.get_run(run_id)
    if not entry:
        return 1
    pid = int(entry["pid"])
    # ARCH-131: killing an Anthropic-direct run auto-respawns it once on
    # deepseek (the wrapper survives the claude kill and falls over) — that's
    # the wanted behavior for a timeout-kill of a hung worker. --final writes
    # the no-fallback marker BEFORE the signal so the wrapper stays down.
    run_dir = _find_run_dir(run_id)
    if final and run_dir:
        T.write_owner_only(run_dir / "no-fallback", b"", append=True)
    elif run_dir:
        try:
            meta = json.loads((run_dir / "meta.json").read_text())
            fb = fallback_model_for(meta.get("model", ""))
            if (fb is not None
                    and not meta.get("fallback_from")
                    and not (run_dir / "no-fallback").exists()):
                # ARCH-378 refuses most of these hops now, so print what will
                # actually happen. A note telling an operator to `kill --final`
                # against a respawn that cannot occur is the same class of defect
                # this guard exists to fix: an authoritative message that is wrong.
                blocked_reason = None
                if meta.get("origin") == "interactive":
                    blocked_reason = "interactive origin"
                else:
                    try:
                        _ag = resolve_agent(meta.get("agent", ""),
                                            repo=meta.get("repo"))
                        _fl = model_floor_for(_ag)
                        if _model_tier(fb) < _model_tier(_fl) or _model_tier(_fl) == 0:
                            blocked_reason = f"model_floor {_fl}"
                    except (Exception, SystemExit):             # noqa: BLE001
                        # SystemExit is deliberate here, not sloppiness:
                        # `resolve_agent` raises it on every failure path,
                        # including "the Library is unreachable". `except Exception` misses
                        # it (SystemExit is a BaseException), and the outer
                        # handler catches only OSError/JSONDecodeError, so an
                        # unresolvable agent would abort `agentctl kill` BEFORE
                        # the signal is sent and leave the run alive. A cosmetic
                        # note must never cost the kill.
                        blocked_reason = "unknown"
                if blocked_reason == "unknown":
                    print(f"note: {run_id} may auto-respawn on {fb} (ARCH-131) "
                          f"unless its model_floor refuses it (ARCH-378); "
                          f"`kill --final` keeps it down either way",
                          file=sys.stderr)
                elif blocked_reason:
                    print(f"note: {run_id} will NOT auto-respawn — {blocked_reason} "
                          f"refuses the fail-over (ARCH-378); it stays down",
                          file=sys.stderr)
                else:
                    print(f"note: {run_id} will auto-respawn on {fb} "
                          f"(ARCH-131); use `kill --final` to keep it down",
                          file=sys.stderr)
        except (OSError, json.JSONDecodeError):
            pass
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        print(f"pid {pid} already gone; clearing registry", file=sys.stderr)
        # ARCH-253: close out the run before the early return — mirror the
        # SIGKILL-survivor path below. Without this, a kill of an already-dead
        # pid cleared the registry but left ended_at/outcome unwritten, so the
        # run stayed permanently ambiguous (the phantom-"running" symptom).
        # (Ordering note: this writes outcome then meta, matching the kill paths
        # here; _finalize_run does meta-then-outcome — harmless, separate files.)
        kdir = _find_run_dir(run_id)
        if kdir and not (kdir / "outcome.json").exists():
            T.write_outcome(kdir, exit_status="killed")
            T.update_meta(kdir, ended_at=T.now_iso())
        R.remove_run(run_id)
        return 0
    print(f"sent SIGTERM to pid {pid} ({run_id})")
    for _ in range(20):
        time.sleep(0.5)
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            break
    else:
        try:
            os.kill(pid, signal.SIGKILL)
            print("escalated to SIGKILL", file=sys.stderr)
        except ProcessLookupError:
            pass
    run_dir = _find_run_dir(run_id)
    if run_dir and not (run_dir / "outcome.json").exists():
        T.write_outcome(run_dir, exit_status="killed")
        T.update_meta(run_dir, ended_at=T.now_iso())
    R.remove_run(run_id)
    return 0


def cmd_kill(args) -> int:
    # --tree: reap the whole run subtree, descendants first so no child outlives
    # its parent's kill (lever-C orphan-reap follow-up). The launcher's stale
    # fix-drain reap passes `--final --tree` so a silently-dead fix-drain agent
    # cannot leave a live bug-fixer grandchild burning after the night finalizes.
    tree = getattr(args, "tree", False)
    reaped = 0
    if tree:
        for child in _collect_run_descendants(args.run_id):
            cid = child.get("run_id")
            if not cid:
                continue
            print(f"reaping descendant {cid} ({child.get('agent', '?')}) "
                  f"of {args.run_id}")
            if _terminate_run(cid, args.final) == 0:
                reaped += 1
    rc = _terminate_run(args.run_id, args.final)
    if rc == 1:
        # Root not in the registry. With --tree this is the orphan-reap success
        # case — the parent's wrapper already deregistered it, and we still
        # reaped its live descendants — so it is not an error.
        if tree:
            print(f"{args.run_id} not in registry (already finalized); "
                  f"reaped {reaped} live descendant(s)")
            return 0
        print(f"{args.run_id} not in registry", file=sys.stderr)
        return 1
    return 0


# --- entry ------------------------------------------------------------------


# Where scribe does its work. A dedicated, tooling-owned checkout of the knowledge
# repo, pinned to main — never the shared <root>/knowledge checkout that co
# sessions and the operator work in. See _scribe_worktree.
SCRIBE_WORKTREE = Path.home() / ".knowledge-scribe-wt"

# How long a KB write (kb apply or kb propose) waits for another one to finish before giving up.
# Generous: an apply is a validator run plus a push, seconds not minutes, so a
# wait this long means the holder is wedged rather than merely slow.
SCRIBE_LOCK_TIMEOUT = 180

# The held lock file. Module-global ONLY so it outlives _scribe_lock's frame —
# closing the object releases the flock, so letting it be garbage-collected
# would drop the lock while the apply is still running.
_SCRIBE_LOCK_FH = None


def _scribe_lock(timeout: int | None = None) -> str:
    """Serialize scribe applies. Returns "" on success, or a reason.

    `timeout` defaults to SCRIBE_LOCK_TIMEOUT read AT CALL TIME, deliberately not
    as a default argument — a default binds once at import and would ignore any
    later change to the module constant, which is exactly how a test asking for a
    1-second wait ends up blocking for the full three minutes.

    WHY A LOCK IS REQUIRED, NOT MERELY TIDY (reviewer finding, #191). The scribe
    worktree is a FIXED path, so two concurrent applies — two co sessions each
    triggering a sync — share one working tree and one git index. Two failures
    follow, and the second is the dangerous one:

      - FALSE REFUSAL. Each run snapshots `_kb_errors` before writing, but the
        after-snapshot sees the other run's file too, so A's valid patch is
        rejected for errors B introduced.
      - A SILENT MIS-ATTRIBUTED COMMIT. `git add` and `git commit` are not atomic
        together. If A stages its doc and B stages its own before A commits, A's
        commit carries BOTH files; B's commit then finds an empty index and
        fails. B returns rc=1 while B's document is already committed and pushed,
        and re-running B refuses with "target exists but patch has no edits". The
        caller is told it failed, the KB says otherwise, and the retry cannot
        succeed.

    The lock is held for the whole apply — reset, validate, commit, push — since
    every one of those steps is part of the same critical section. It is released
    by process exit rather than an explicit unlock: an apply is one short-lived
    CLI invocation, and letting the OS drop the fd removes every path where an
    early return leaks a held lock.

    The old shared-checkout design had this same gap. It is closed here rather
    than carried forward.
    """
    global _SCRIBE_LOCK_FH
    if timeout is None:
        timeout = SCRIBE_LOCK_TIMEOUT

    # A second call in the SAME process means the previous apply is done. Release
    # its handle explicitly: flock is held per open file description, so the new
    # fd below would otherwise contend with our own stale one and block until the
    # timeout. Closing here rather than letting refcounting do it keeps that from
    # depending on when the old object happens to be collected.
    if _SCRIBE_LOCK_FH is not None:
        try:
            _SCRIBE_LOCK_FH.close()
        except OSError:
            pass
        _SCRIBE_LOCK_FH = None

    lock_path = SCRIBE_WORKTREE.with_suffix(".lock")
    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        fh = open(lock_path, "w")
    except OSError as e:
        return f"could not open the scribe lock at {lock_path} ({e})"

    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            _SCRIBE_LOCK_FH = fh          # hold it open for the process's lifetime
            return ""
        except OSError:
            if time.monotonic() >= deadline:
                fh.close()
                return (f"another KB write (kb apply or kb propose) has held {lock_path} "
                        f"for over {timeout}s; it is probably wedged. Check for a stuck "
                        f"agentctl process before re-running")
            time.sleep(0.2)


def _scribe_worktree(library) -> tuple[Path | None, str]:
    """A clean checkout of knowledge/main for scribe to write, commit, and push in.

    WHY SCRIBE DOES NOT USE THE SHARED CHECKOUT (ARCH-386, superseding the #188
    branch guard). `<root>/knowledge` is shared by every co session and by the operator.
    scribe used to write and commit straight into it, which coupled a KB-sync to
    whatever unrelated state that checkout happened to be in:

      - A co that left a FEATURE BRANCH checked out silently diverted a
        cross-project sync onto it (a vivy factual-sync landed on top of an
        app-kit PR commit; convivy-app-kit-co inbox note, 2026-07-20). #188
        stopped the diversion by refusing off-main — correct, but it converts
        someone else's checkout state into a scribe outage.
      - UNCOMMITTED WORK from other sessions skews the validator baseline. On
        2026-07-21 the shared checkout held six modified/untracked files from
        three different sources, so `_kb_errors` measured a tree nobody intended
        to publish.
      - A commit lands in a checkout whose owner did not ask for it, mixed in
        with their in-progress edits.

    A dedicated worktree removes the coupling in both directions: scribe cannot
    be blocked by, and cannot disturb, whatever anyone else is doing. It is reset
    to `origin/main` before every apply, so a patch is always evaluated against
    the real current KB rather than a checkout that may be hours stale.

    THE ONE TRADE-OFF, stated so it is not discovered later: the commit no longer
    appears in the shared checkout immediately. `knowledge-autopull` fast-forwards
    that checkout every 10 minutes, so the KB index trails a sync by up to that
    long, where it used to be current the moment scribe committed.

    Returns (path, "") on success, or (None, reason) — the caller refuses loudly
    rather than silently falling back to the shared checkout, since a silent
    fallback would reintroduce exactly what this exists to prevent.

    `library` (`_KbLibrary` on a GitHub origin, `_PlainGitLibrary` otherwise —
    `_kb_library`) makes the fetch. It is a parameter with no default so that no
    caller can reach this and fetch over the ssh remote, which authenticates as
    the operator; each caller obtains it before calling, ahead of the lock, so
    a refusal to obtain it leaves no lock taken.
    """
    src = KNOWLEDGE_ROOT
    if not (src / ".git").exists():
        return None, f"{src} is not a git checkout"

    # Take the lock BEFORE the fetch, so the whole critical section — fetch,
    # reset, validate, commit, push — is serialized against a second apply.
    held = _scribe_lock()
    if held:
        return None, held

    r = library.fetch_main(src)
    if r.returncode != 0:
        return None, f"could not fetch origin/main ({r.stderr.strip()})"

    main_sha = _exact_origin_main(src)
    if main_sha is None:
        return None, _missing_origin_main("the scribe worktree", src)

    if not (SCRIBE_WORKTREE / ".git").exists():
        # `git worktree add` refuses if the path exists as a non-worktree; a stale
        # directory here is leftover junk from an interrupted run, never user data.
        #
        # The removal is CHECKED rather than best-effort (security-reviewer, #191).
        # Under `ignore_errors=True` a partial removal — one locked file is enough
        # — leaves a non-empty, non-worktree directory that fails `worktree add`
        # on this and every future run, so scribe wedges permanently with a
        # message pointing at worktree creation rather than at the real cause.
        # Naming it here makes that state diagnosable on the first occurrence.
        if SCRIBE_WORKTREE.exists():
            shutil.rmtree(SCRIBE_WORKTREE, ignore_errors=True)
            if SCRIBE_WORKTREE.exists():
                return None, (f"{SCRIBE_WORKTREE} exists but is not a git worktree, and it "
                              f"could not be removed. Every apply will fail until it is "
                              f"cleared by hand (`rm -rf {SCRIBE_WORKTREE}`)")
        # Drop any registration left behind when the worktree path was removed
        # without `git worktree remove` — by the rmtree above, or by a human
        # deleting the directory. git >= 2.28 auto-prunes during `worktree add`;
        # doing it explicitly makes this work on older git too (reviewer, #191).
        subprocess.run(["git", "-C", str(src), "worktree", "prune"],
                       capture_output=True, text=True)
        r = subprocess.run(
            ["git", "-C", str(src), "worktree", "add", "--detach",
             str(SCRIBE_WORKTREE), main_sha],
            capture_output=True, text=True)
        if r.returncode != 0:
            return None, f"could not create the scribe worktree ({r.stderr.strip()})"

    # Reset every time. The worktree is tooling-owned and nothing else writes it,
    # so discarding local state is safe — and it is what guarantees the patch is
    # applied to current main rather than to whatever a previous run left behind.
    for cmd in (["git", "-C", str(SCRIBE_WORKTREE), "reset", "--hard", "--quiet", main_sha],
                ["git", "-C", str(SCRIBE_WORKTREE), "clean", "-qfd"]):
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            return None, f"could not reset the scribe worktree ({r.stderr.strip()})"

    return SCRIBE_WORKTREE, ""


def _kb_errors(kroot: Path) -> set | None:
    """The knowledge validator's current complaints, as a set of lines.

    None means the validator could not run at all — the caller treats that as
    "nothing to check" rather than refusing every sync.

    Deliberately the repo's own `scripts/validate.py` and not a
    reimplementation: the rules it enforces (frontmatter, required fields,
    status vocabulary, duplicate ADR numbers) live and change in that repo, and
    a copy here would drift and start passing exactly what CI rejects.
    """
    script = kroot / "scripts" / "validate.py"
    if not script.is_file():
        print(f"kb write: no KB validator at {script} — proceeding on the "
              f"structural guards alone. A doc that CI would reject can land.",
              file=sys.stderr)
        return None
    try:
        r = subprocess.run([sys.executable, str(script)], cwd=str(kroot),
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"kb write: KB validator could not run ({e}); "
              f"falling back to the structural guards only.", file=sys.stderr)
        return None
    return {ln.strip() for ln in (r.stdout + r.stderr).splitlines()
            if ln.strip().startswith("ERROR")}


def _kb_new_errors(before: set | None, after: set | None) -> str | None:
    """Errors this patch INTRODUCED, or None if it introduced none.

    A before/after diff rather than matching the target's filename in the
    validator's output. Two reasons, both from the review of PR #149:

    - Matching on the filename is a runtime contract with validate.py's output
      FORMAT. If a future revision phrased an error without naming the file
      ("ERROR at line 3: missing frontmatter"), the match would come back empty
      and the guard would report clean — silently passing exactly the content it
      exists to stop. A guard whose failure mode is "fails open when the thing
      it parses changes shape" is worse than no guard. A diff cares only that
      the error set GREW, whatever the lines say.
    - A basename match is not path-qualified, so an error about product A's
      `0001-initial.md` would block a clean sync of product B's `0001-initial.md`.
      A pre-existing error is in `before`, so it is never attributed here.

    Either side None (validator unavailable) -> None: nothing was checked.
    """
    if before is None or after is None:
        return None
    introduced = after - before
    return "\n".join(sorted(introduced)) if introduced else None


def _wt_uses_ruff_format(wt: Path) -> bool:
    """True when this worktree's CI runs `ruff format` (the gate publish mirrors).

    Narrow on purpose: many suite repos lint (`ruff check`) but do NOT enforce
    formatting. We only gate where CI actually runs `ruff format`, so the scan
    is for that exact string in the repo's own workflow files — the same ground
    truth the coder agents use ("never run a formatter unless the repo's CI
    already does"). As of 2026-06 that is sous-chef only.
    """
    workflows = wt / ".github" / "workflows"
    if not workflows.is_dir():
        return False
    for pat in ("*.yml", "*.yaml"):
        for yml in workflows.glob(pat):
            try:
                if "ruff format" in yml.read_text():
                    return True
            except OSError:
                pass
    return False


def _ruff_format_gate(wt: Path) -> int:
    """Block an unformatted worktree from reaching CI (F4).

    Mirrors CI's own `ruff format --check .` so a formatting miss fails here, at
    publish time with an actionable message, instead of burning a full review +
    CI round (the F1 metering PR's only CI failure was unformatted code). Checks
    the working tree, matching `ruff format --check .` semantics; the worker
    normally publishes a clean tree (uncommitted files already get the dirty
    warning above). Returns 0 to proceed, 1 to block.

    Best-effort on a missing `ruff`: warn and proceed rather than break publish
    for every repo — CI stays the hard gate. The gate only ever adds an earlier
    catch, never removes the ability to publish.
    """
    if not _wt_uses_ruff_format(wt):
        return 0
    try:
        rf = subprocess.run(["ruff", "format", "--check", "."],
                            cwd=str(wt), capture_output=True, text=True)
    except FileNotFoundError:
        print("publish: WARNING — repo CI runs `ruff format` but `ruff` is not on PATH; "
              "skipping the local format gate (CI will still enforce it).", file=sys.stderr)
        return 0
    if rf.returncode != 0:
        detail = (rf.stdout or rf.stderr or "").strip()
        print(f"publish: BLOCKED — `ruff format --check .` failed in {wt}:\n{detail}\n"
              f"  Run `ruff format .` in the worktree, commit, then re-run publish "
              f"(this is exactly what CI enforces — fixing it here saves a review+CI round).",
              file=sys.stderr)
        return 1
    return 0


def _wt_ci_runs(wt: Path, needle: str) -> bool:
    """True when this worktree's CI workflows contain `needle`.

    Generalizes `_wt_uses_ruff_format`'s scan so a gate is only ever applied where
    CI actually runs that command. Same ground truth the coder agents use, and the
    same reason: gating on something CI does not enforce would block a publish over
    a rule the repo never adopted.
    """
    workflows = wt / ".github" / "workflows"
    if not workflows.is_dir():
        return False
    for pat in ("*.yml", "*.yaml"):
        for yml in workflows.glob(pat):
            try:
                if needle in yml.read_text():
                    return True
            except OSError:
                pass
    return False


def _ruff_lint_gate(wt: Path) -> int:
    """Block a lint-failing worktree from reaching CI.

    WHY THIS EXISTS SEPARATELY FROM THE FORMAT GATE. `_ruff_format_gate` mirrors
    `ruff format --check`, which is a different command from `ruff check` and, as
    its own docstring notes, applies to sous-chef alone. Lint is the one that
    actually fails: sampling 26 recent coder-class PRs whose first push failed CI
    (2026-07-29), `Ruff lint` was the single most common failure at 5 of 12, and
    lint-or-typecheck together were 9 of 12 — 75%. Only one was a real test
    failure.

    These are the cheapest checks in the suite. Catching one here costs ~20
    seconds; the same failure caught in CI costs a full run — vivy's serial gate
    alone is 22 minutes — plus, usually, a coder re-dispatch and another review
    round.

    WHY A GATE RATHER THAN AN INSTRUCTION. The dispatch briefs already say to run
    the repo's CI commands before pushing, and PRs still arrive lint-red. This is
    the same argument `cmd_publish` already makes for pushing: it exists "rather
    than relying on an LLM to remember `git push` each round". Remembering
    `ruff check` fails the same way.

    Best-effort on a missing `ruff`: warn and proceed. CI stays the hard gate; this
    only ever adds an earlier catch.
    """
    if not _wt_ci_runs(wt, "ruff check"):
        return 0
    try:
        r = subprocess.run(["ruff", "check", "."],
                           cwd=str(wt), capture_output=True, text=True)
    except FileNotFoundError:
        print("publish: WARNING — repo CI runs `ruff check` but `ruff` is not on PATH; "
              "skipping the local lint gate (CI will still enforce it).", file=sys.stderr)
        return 0
    if r.returncode != 0:
        detail = (r.stdout or r.stderr or "").strip()
        print(f"publish: BLOCKED — `ruff check .` failed in {wt}:\n{detail}\n"
              f"  Fix the findings (many are auto-fixable with `ruff check --fix .`), "
              f"commit, then re-run publish. This is exactly what CI enforces — fixing "
              f"it here saves a review+CI round.", file=sys.stderr)
        return 1
    return 0


# Per-repo typecheck, keyed by the directory the command runs in. Held here rather
# than as a `make` target convention in each product repo, deliberately: the repos
# do not agree today (vivy has `make typecheck` but no lint target, constance has
# lint/typecheck/check, sous-chef has no Makefile), and establishing a convention
# across three product repos is a product change this platform should not be making
# on its own. A table is honest about that; a convention would pretend agreement
# that does not exist.
#
# Keyed by repo name, matched against the worktree's primary. Each entry is
# (subdirectory relative to the worktree, argv). A repo absent from the table is
# simply not typecheck-gated.
_TYPECHECK_GATES: dict[str, tuple[str, list[str]]] = {
    "vivy":      ("frontend", ["npm", "run", "typecheck"]),
    "constance": (".", ["mypy"]),
    # convivy-deck is Swift, so `swift build` IS its typecheck — the compiler is
    # what rejects a type error, and it is the first step deck's CI runs before
    # `swift test`. Worth gating even though deck's CI costs no GitHub minutes: it
    # runs on a self-hosted runner on the mini, so a failed round is our own CPU,
    # and that runner deliberately wipes `.build` for a clean build every time.
    #
    # This gate is slower than the other entries. A worker's worktree usually holds
    # warm `.build` state, making it incremental; a cold worktree pays a full
    # compile. It is still cheaper than deck's CI round, which is clean-build plus
    # test plus package.
    #
    # `--disable-automatic-resolution` is the one flag here that is not obvious, and
    # it is a security fix from review. Without it, `swift build` on a cold or stale
    # package cache makes OUTBOUND CONNECTIONS to resolve dependencies — Apple's CDN,
    # GitHub. No other gate does that: ruff is offline, `npm run typecheck` uses an
    # existing node_modules, `mypy` uses the local env. Adding a gate that silently
    # phones out during `publish` is a behaviour change nobody asked for, and on a
    # flaky network it hangs the push rather than failing it.
    #
    # The cost is that an unresolved worktree now FAILS the gate instead of quietly
    # fetching. That is the right trade: the compiler says dependencies are
    # unresolved, which is actionable, and `--skip-checks` covers the case where a
    # worker genuinely needs to publish from a tree it never built.
    "convivy-deck": (".", ["swift", "build", "--disable-automatic-resolution"]),
}


def _typecheck_gate(wt: Path, repo: str) -> int:
    """Block a typecheck-failing worktree, for the repos whose CI runs one.

    Typecheck was 4 of 12 sampled first-push failures (`Frontend type check` x3,
    `Typecheck` x1) — second only to lint, and deterministic in the same way.

    Best-effort throughout: an unknown repo, a missing subdirectory, or a missing
    toolchain warns and proceeds. A frontend typecheck needs `node_modules`, which
    a fresh worktree may not have, and refusing to publish because a worktree was
    never `npm install`-ed would block real work over a setup gap rather than a
    defect.
    """
    entry = _TYPECHECK_GATES.get(repo)
    if not entry:
        return 0
    subdir, argv = entry
    cwd = (wt / subdir).resolve()
    if not cwd.is_dir():
        return 0
    # Pre-flight: detect a missing toolchain before running the gate, so a
    # worktree that was never `npm install`-ed or never had its dependencies
    # resolved warns and skips rather than failing with a "command not found"
    # error message that points the reader at fixing type errors they do not have.
    # The docstring already promises this: "a missing toolchain warns and proceeds."
    missing = ""
    if argv[0] == "npm":
        # For npm-script gates, the real tool is a binary in node_modules/.bin.
        # Checking for the specific binary the script runs would require parsing
        # package.json; checking the .bin directory with a glob is cheaper and
        # catches the same setup gap: if nothing has been npm-installed, the
        # directory is absent or empty.
        node_bin = cwd / "node_modules" / ".bin"
        if not node_bin.is_dir() or not any(node_bin.iterdir()):
            missing = "node_modules (run `npm ci` in the worktree's frontend/)"
    if missing:
        print(f"publish: WARNING — missing {missing}; skipping the local typecheck "
              f"gate. CI still enforces typecheck on the pushed branch.",
              file=sys.stderr)
        return 0
    try:
        r = subprocess.run(argv, cwd=str(cwd), capture_output=True, text=True)
    except FileNotFoundError:
        print(f"publish: WARNING — {repo} CI runs `{' '.join(argv)}` but it is not "
              f"available here; skipping the local typecheck gate (CI still enforces it).",
              file=sys.stderr)
        return 0
    if r.returncode != 0:
        # Combine both stdout and stderr — npm puts its script banner on stdout
        # and the shell's "command not found" on stderr. The old `(stdout or stderr)`
        # discarded the latter when the former was non-empty.
        detail = ((r.stdout or "") + (r.stderr or "")).strip()
        # npm prints its own failure banner; keep the tail, which carries the errors.
        tail = "\n".join(detail.splitlines()[-40:])
        # Distinguish "the compiler was never there" from "the compiler ran and
        # found problems". "command not found" is the shell's message when a
        # resolved binary is absent — distinct from a tsc "Cannot find module"
        # diagnostic, which is a real typecheck error from a running compiler.
        if r.returncode == 127 or "command not found" in detail:
            print(f"publish: WARNING — `{' '.join(argv)}` in {cwd} could not run:"
                  f" a required tool was not found.\n{tail}\n"
                  f"  Run `npm ci` in the worktree's frontend/, then re-run publish.\n"
                  f"  (The local typecheck gate is best-effort; CI still enforces it.)",
                  file=sys.stderr)
            return 0
        print(f"publish: BLOCKED — `{' '.join(argv)}` failed in {cwd}:\n{tail}\n"
              f"  Fix the type errors, commit, then re-run publish. This is exactly what "
              f"CI enforces — fixing it here saves a review+CI round.", file=sys.stderr)
        return 1
    return 0


def _content_scan_gate(wt: Path, repo_name: str, head: str) -> int:
    """Refuse to push `head` when Builder's content scan (`publish_scan.py`,
    Shipwright's own `bin/publish-engine`) cannot vouch for it.

    UNLIKE THE STYLE GATES ABOVE, THIS ONE IS NOT BEST-EFFORT. The others warn
    and proceed on a missing tool because CI still enforces lint/format/
    typecheck; nothing else in the PR flow runs the content scan (that is the
    whole reason this gate exists — a cleanup that passed it was undone a day
    later by ordinary reviewed PRs that added a name back). So a scan that
    cannot run — Shipwright's checkout, `bin/publish-engine`, or either names
    file missing — blocks the push exactly like a scan that found something.

    `PS is None` covers the one window this needs its own message for: a
    machine where this module has not been linked into
    `~/.local/lib/agent-platform` yet (`bin/agentctl`'s own fail-soft import,
    same pattern as `tool_policy`/`primary_guard`, so a deploy window never
    crashes every `agentctl` command over one new module) — refused here
    rather than silently skipped, because this gate's whole point is that
    publish must never push unscanned.
    """
    if PS is None:
        print("publish: BLOCKED — publish_scan is not linked into this process; "
              "refusing to push unscanned. Run install.sh, or wait for the next "
              "agent-platform-autopull tick, then re-run publish.", file=sys.stderr)
        return 1
    try:
        PS.scan_commit(repo_name, wt, head)
    except PS.PublishScanRefused as exc:
        print(f"publish: BLOCKED by Builder's content scan — refusing to push "
              f"{head[:9]} ({repo_name}):\n{exc}", file=sys.stderr)
        return 1
    return 0


def _default_base(git) -> str:
    """The repo's default branch, from `origin/HEAD`, falling back to "main".

    `git` is a caller-supplied runner already bound to the worktree. origin/HEAD can be
    unset (no symref), in which case `--abbrev-ref` yields "HEAD" or an unresolved ref —
    neither a real branch — so fall back rather than trust it.
    """
    sref = git("rev-parse", "--abbrev-ref", "refs/remotes/origin/HEAD").stdout.strip()  # e.g. origin/main
    base = sref.split("/", 1)[1] if sref.startswith("origin/") else ""
    return base if base and base != "HEAD" else "main"


def _kb_indexer():
    """Import the shared indexing module, preferring this checkout's copy.

    Imported lazily: it pulls in `yaml`, and no other agentctl path needs it, so
    a missing dependency must not break every other subcommand. `__file__` is
    resolved because `~/.local/bin/agentctl` is a symlink into the repo working
    tree (ARCH-229) — resolving lands on the repo's `lib/knowledge`, so a
    feature-branch checkout tests its own indexer rather than the installed one.

    Does NOT call `venv_bootstrap.ensure` itself. Every kb subcommand that
    reaches this (`kb sync`, `kb propose`, `kb apply`) does that once, as its
    own first action, before any stdin read, lock, lease or journal row — a
    call here would run only on whichever of those paths happens to reach it
    first, which is a place, not a guarantee (round-2 review, PR 695: the
    `kb apply` path reached `import yaml` only after already reading stdin for
    a Deck signature, silently discarding it on re-exec).
    """
    for cand in (Path(__file__).resolve().parent.parent / "lib" / "knowledge",
                 Path.home() / ".local" / "lib" / "knowledge"):
        if (cand / "indexer.py").is_file():
            if str(cand) not in sys.path:
                sys.path.insert(0, str(cand))
            break
    import indexer  # noqa: PLC0415 — lazy by design, see above
    return indexer


def _kb_indexer_errors(rel: str, content: str) -> list[str]:
    """Why the knowledge indexer would drop `content` written at `rel`, or `[]`.

    `[]` for a path the indexer does not serve (a profile YAML through kb propose,
    say): it has no frontmatter and no row to drop. An indexer that cannot be
    imported is a refusal, not a pass. This check exists because the write path
    reported success on documents the index then dropped, and skipping it
    silently would restore exactly that."""
    try:
        ix = _kb_indexer()
    except Exception as exc:  # noqa: BLE001 — any import failure is "cannot check"
        return [f"the indexer's check could not run ({exc})"]
    if not ix.is_indexable_rel(rel):
        return []
    return ix.document_errors(content, rel)


def _kb_git(*a):
    """Run git against the shared knowledge checkout."""
    return subprocess.run(["git", "-C", str(KNOWLEDGE_ROOT), *a],
                          capture_output=True, text=True)


def _kb_changed_paths(old: str, new: str) -> list[str]:
    """Repo-relative paths touched between two commits. NUL-separated, so a path
    containing a space or a newline survives the round trip."""
    out = _kb_git("diff", "--name-only", "-z", f"{old}..{new}").stdout
    return [p for p in out.split("\0") if p]


def _kb_writes():
    """The lease/journal store. Lazy, like the indexer — only the kb verbs need it."""
    import kb_writes  # noqa: PLC0415 — lazy by design
    return kb_writes


def _kb_holder(explicit: str | None = None) -> str:
    """Who holds a lease. The identity the ops plane uses for an issue claim.

    A dispatched agent has a run-id, which is the useful thing to see in a
    conflict ("run-7f3a91 holds it until 14:20"). An interactive session is
    `session:<id>`, from the CLAUDE_CODE_SESSION_ID the harness gives every
    session and, through it, the kb MCP server that runs these verbs.

    PER SESSION, NOT PER USER. This used to read CLAUDE_SESSION_ID, which the
    harness never sets, so every interactive session fell through to
    `session:<user>` and one co's checkout never stopped another co's write:
    the case the operator named on 2026-09-11 ("The Library shouldn't go around changing
    docs other crews have checked out to work on"). The user fallback remains
    only for a caller outside any session. Never anonymous: a conflict that
    cannot name the holder is a conflict nobody can resolve.

    WHAT THIS PROTECTS AGAINST, AND WHAT IT DOES NOT. It stops two sessions
    colliding by accident, which is what the shared `session:<user>` guaranteed.
    It does not authenticate the session: the id is an environment value
    compared by equality, and `kb leases` shows every live holder, so a process
    running as this user can present another session's id. That was already
    true under `session:<user>`; no occurrence of it has been seen (security
    review, PR 532), so nothing here tries to stop it.
    """
    if explicit:
        return explicit
    run_id = os.environ.get("AGENTCTL_RUN_ID")
    if run_id:
        return run_id
    for var in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        session_id = os.environ.get(var)
        if session_id:
            return f"session:{session_id}"
    return f"session:{getpass.getuser()}"


def _kb_resolve_ref(ident: str) -> tuple[str | None, str]:
    """A doc id or a repo-relative path -> its repo-relative path.

    Accepts both because callers have both: an agent holds ids (`shared/agents/
    architect`, what `kb_search` returns), while tooling holds paths. A value
    ending in `.md`, `.yaml` or `.yml` is taken as a path; anything else is
    looked up in the index.

    A .yaml or .yml path is a PROFILE, which the index does not hold, so it can
    only resolve as a path. That lets `kb checkout` lease one and `kb propose
    --delete` remove it. Every write verb still refuses it through
    `is_indexable_rel`, so a profile is not editable here.
    """
    ident = ident.strip()
    if not ident:
        return None, "empty document identifier"
    if ident.endswith((".md", ".yaml", ".yml")):
        # NORMALIZE BEFORE ANYONE MATCHES ON IT. `projects/agent-platform/../
        # agent-platform/agents/reviewer.md` reaches the real roster file while
        # defeating a prefix check on the roster directory, so an un-normalized
        # string makes the PR-only guard decorative for any caller who controls
        # this argument. Security + code review of #243 found this from two
        # directions; normalizing here closes it for every caller at once.
        #
        # PR G turned that guard into a `/agents/` SEGMENT, which the traversal
        # above no longer defeats. Normalizing stays: it is what keeps the guard
        # independent of how the guard happens to be spelled today, and the
        # escape check below needs the normalized form regardless.
        norm = posixpath.normpath(ident.replace("\\", "/"))
        if posixpath.isabs(norm) or norm == ".." or norm.startswith("../"):
            return None, (f"{ident!r} escapes the knowledge root; pass a path "
                          f"relative to the repo, e.g. projects/<project>/<kind>/<slug>.md")
        return norm, ""
    if not KB_INDEX.exists():
        return None, f"knowledge index missing at {KB_INDEX}; cannot resolve id {ident!r}"
    conn = sqlite3.connect(f"file:{KB_INDEX}?mode=ro", uri=True)
    try:
        rows = conn.execute("SELECT source_ref FROM docs WHERE id = ?", (ident,)).fetchall()
    finally:
        conn.close()
    if not rows:
        return None, (f"no document with id {ident!r} in the index. Pass a repo-relative "
                      f"path ending in .md to write a doc that does not exist yet.")
    # Normalized on the way out too. The index's source_refs come from the
    # indexer reading real git-tracked paths, so a non-canonical one should not
    # occur — but "should not occur" is a weak reason to leave the one branch
    # that skips normalization, when the cost of closing it is this line.
    return posixpath.normpath(rows[0][0].replace("\\", "/")), ""


class _KbOriginUnreadable(Exception):
    """`origin/main` could not be read at all: no App identity, or the fetch failed.
    A doc that is merely not on it is a different answer (`_kb_blob_at_origin`)."""


def _kb_blob_at_origin(source_ref: str) -> tuple[str | None, str]:
    """`(content, "")` for the doc on `origin/main`, fetched fresh, or `(None, why)`
    when `origin/main` was read and the doc is not on it.

    Raises `_KbOriginUnreadable` when `origin/main` could not be read at all. That
    is not "the doc does not exist": a caller that took it for that would report
    `exists: false` about a document that is there.

    Read from origin rather than from the shared checkout on purpose. The shared
    checkout trails main by up to the autopull interval, so basing an edit on it
    would hand the caller a stale content-sha and earn a spurious `stale`
    refusal at apply time. `git show` needs no worktree and takes no lock.
    """
    library, why = _kb_library_git("kb checkout", read_only=True)
    if library is None:
        raise _KbOriginUnreadable(why)
    fetched = library.fetch_main(KNOWLEDGE_ROOT)
    if fetched.returncode != 0:
        raise _KbOriginUnreadable(f"could not fetch origin/main ({fetched.stderr.strip()})")
    main_sha = _exact_origin_main(KNOWLEDGE_ROOT)
    if main_sha is None:
        # Unreadable, not "the doc is absent": the caller would report exists:false.
        raise _KbOriginUnreadable(f"{GR.ORIGIN_MAIN_REF} does not exist in {KNOWLEDGE_ROOT}")
    r = _kb_git("show", f"{main_sha}:{source_ref}")
    if r.returncode != 0:
        return None, f"{source_ref} does not exist on origin/main"
    return r.stdout, ""


def _kb_refuse_foreign_lease(kbw, verb: str, source_ref: str, holder: str,
                             **journal) -> bool:
    """True, having reported and journaled it, when another holder has a live
    lease on the doc.

    The operator, 2026-09-11: "Only checked out items can be changed", and "The Library
    shouldn't go around changing docs other crews have checked out to work on."
    Exit 3, `leased`, is the code `kb checkout` already gives for the same
    condition, so a caller handles one meaning in one place. `lease_for` reads
    an expired lease as absent, so a dead session holds a doc for its TTL and no
    longer.
    """
    other = kbw.lease_for(source_ref)
    if not other or other["holder"] == holder:
        return False
    print(f"kb {verb}: refused — {source_ref} is leased by {other['holder']} until "
          f"{other['expires_at']}. Wait for that holder to release it, or "
          f"coordinate with them.", file=sys.stderr)
    kbw.journal(verb, source_ref=source_ref, holder=holder, result="leased",
                detail=other["holder"], **journal)
    return True


def cmd_kb_checkout(args) -> int:
    """Take a lease on a doc and return its current content plus the sha to write against."""
    kbw = _kb_writes()
    source_ref, err = _kb_resolve_ref(args.doc)
    if err:
        print(f"kb checkout: {err}", file=sys.stderr)
        return 1

    holder = _kb_holder(args.holder)
    # The same refusal kb apply and kb propose make, before the lease store or the
    # journal sees the value: a session-derived holder is the likeliest place for
    # a malformed one to come from (security review, PR 532).
    if not kbw.valid_holder(holder):
        print(f"kb checkout: refused — holder {holder!r} is not a valid identity "
              f"(letters, digits, and : . _ - only, max 64).", file=sys.stderr)
        return 1
    held_before = (kbw.lease_for(source_ref) or {}).get("holder") == holder
    lease, conflict = kbw.acquire(source_ref, holder, note=args.note)
    if conflict:
        print(f"kb checkout: {source_ref} is leased by {conflict['holder']} "
              f"until {conflict['expires_at']}. Wait, or coordinate with that holder.",
              file=sys.stderr)
        kbw.journal("checkout", source_ref=source_ref, holder=holder,
                    result="leased", detail=conflict["holder"])
        return 3

    try:
        content, err = _kb_blob_at_origin(source_ref)
    except _KbOriginUnreadable as e:
        # Nothing was read, so nothing is checked out: a four-hour lease taken for
        # this would block every other session's checkout of the doc for a read
        # that returned no content. A lease this holder already had is theirs, from
        # an earlier checkout, and stays.
        if not held_before:
            kbw.release(source_ref, holder)
        print(f"kb checkout: could not read {source_ref} from origin/main, so nothing "
              f"was checked out{'' if held_before else ' and no lease is held'} — {e}",
              file=sys.stderr)
        kbw.journal("checkout", source_ref=source_ref, holder=holder,
                    result="unreadable", detail=str(e))
        return 1
    if err:
        # A doc that does not exist yet is a legitimate checkout: it is how
        # `kb_create` reserves the path before writing it. Report empty content
        # and the sha of nothing, so the caller can pass it as `--base-sha` and
        # still get the create-vs-clobber check.
        content = ""
    payload = {"source_ref": source_ref, "exists": not err,
               "content": content, "content_sha": kbw.content_sha(content),
               "lease": lease}
    kbw.journal("checkout", source_ref=source_ref, holder=holder, result="ok")
    print(kbw.as_json(payload))
    return 0


def cmd_kb_release(args) -> int:
    kbw = _kb_writes()
    source_ref, err = _kb_resolve_ref(args.doc)
    if err:
        print(f"kb release: {err}", file=sys.stderr)
        return 1
    holder = _kb_holder(args.holder)
    if not kbw.valid_holder(holder):
        print(f"kb release: refused — holder {holder!r} is not a valid identity "
              f"(letters, digits, and : . _ - only, max 64).", file=sys.stderr)
        return 1
    if kbw.release(source_ref, holder):
        kbw.journal("release", source_ref=source_ref, holder=holder, result="ok")
        print(f"kb release: released {source_ref}")
        return 0
    active = kbw.lease_for(source_ref)
    if active:
        print(f"kb release: {source_ref} is held by {active['holder']}, not by you "
              f"({holder}) — nothing released.", file=sys.stderr)
        return 3
    print(f"kb release: no active lease on {source_ref} — nothing to do.")
    return 0


def cmd_kb_leases(args) -> int:
    kbw = _kb_writes()
    leases = kbw.active_leases()
    if args.json:
        print(kbw.as_json(leases))
        return 0
    if not leases:
        print("kb leases: none active")
        return 0
    for lease in leases:
        note = f"  ({lease['note']})" if lease.get("note") else ""
        print(f"{lease['expires_at']}  {lease['holder']:<28} {lease['source_ref']}{note}")
    return 0


def cmd_kb_sync(args) -> int:
    """Fast-forward the knowledge checkout and reindex what changed, as ONE step.

    This exists because nothing owned commit->reindex. Three decoupled processes
    each did part of it: writers pushed, `knowledge-autopull` fast-forwarded the
    shared checkout on a timer, and the watcher's filesystem observer indexed
    whatever it happened to notice — which empirically missed the batched changes
    a fast-forward produces, leaving the index silently stale until a human
    noticed and kickstarted launchd.

    Owning both halves closes that window: when this returns, what is on disk is
    what `kb_search` and `kb_get` serve. Verification is what makes the claim
    checkable rather than merely intended, and a failed verification self-heals
    with the same full reconcile the watcher runs at startup.

    Idempotent, and safe to run when there is nothing to do.
    """
    # First action, before the fetch, the fast-forward, or a single index write:
    # the system `python3.11` this script's shebang resolves to on a clean
    # Linux install has no PyYAML, so `import indexer` (via `_kb_indexer`
    # below) needs this run before it, not left to whichever helper happens to
    # import `yaml` first (round-2 review, PR 695).
    venv_bootstrap.ensure(__file__, requires=("yaml",))
    idx = _kb_indexer()
    repo = KNOWLEDGE_ROOT
    if not (repo / ".git").exists():
        print(f"kb sync: {repo} is not a git repo", file=sys.stderr)
        return 1

    idx.ensure_db()

    if args.verify_only:
        return _kb_report_verify(idx, heal=not args.no_heal, dry_run=args.dry_run,
                                 quiet=args.quiet)

    # Offline is not a failure. The timer will retry, and the index is unchanged.
    # A missing or refused App identity is one, and is said so and exits 1: read as
    # "offline" it would leave the index stale and the timer's log silent for as
    # long as the key stayed away. Not every refusal is permanent. A missing key or
    # a widened installation stays until someone fixes it, but a 5xx or 429 from
    # api.github.com also lands here (`github_app.request` returns any HTTP error as
    # a status, so it surfaces as `Unreadable`, "installations could not be read
    # (502)"; only a socket-level failure is `Unreachable`). The timer retries those
    # too, at the cost of one exit-1 line per cycle while GitHub is unwell.
    import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
    try:
        library = _kb_library(read_only=True)
    except KM.Unreachable:
        print("kb sync: fetch failed (likely offline) — index left as-is",
              file=sys.stderr)
        return 0
    except KM.Unreadable as e:
        if _kb_origin_is_github(KNOWLEDGE_ROOT):
            print(f"kb sync: refused — cannot obtain the convivy-library App identity — "
                  f"{e}. The index is left as-is; it does not fall back to a personal "
                  f"credential.", file=sys.stderr)
        else:
            print("kb sync: refused — the knowledge repo's origin is neither a local "
                  "repository nor a GitHub remote the Library can push to as its App "
                  "— only those two are supported. The index is left as-is.",
                  file=sys.stderr)
        return 1
    fetched = library.fetch_main(KNOWLEDGE_ROOT)
    if fetched.returncode != 0:
        # The reason goes with it: a rejected token and a dead network both land
        # here, and "likely offline" alone reads the same for either.
        print(f"kb sync: fetch failed (likely offline) — index left as-is. "
              f"{fetched.stderr.strip()}", file=sys.stderr)
        return 0

    local = _kb_git("rev-parse", "HEAD").stdout.strip()
    remote = _exact_origin_main(KNOWLEDGE_ROOT)
    if remote is None:
        print(_missing_origin_main("kb sync", KNOWLEDGE_ROOT) + " The index is left as-is.",
              file=sys.stderr)
        return 1
    if not local:
        print("kb sync: could not resolve HEAD", file=sys.stderr)
        return 1

    if local == remote and not args.full:
        # Nothing arrived, but the index can still be wrong. The validator's
        # allowlists live in THIS repo, so registering a project makes a doc
        # indexable without a single commit landing in the knowledge tree — the
        # file did not change, the validator's opinion of it did. This path used
        # to return 0 here without looking, and placard's bead sat unindexed
        # through four registration sites while the documented command reported
        # success (issue_01M1TJM4D2ZMFK6NT5ZTZHXE2H). Verification re-reads every
        # doc with the current validator, which is the only pass that notices,
        # and it costs half a second on the real corpus.
        #
        # `--quiet` is the timer's: it drops the healthy line so a no-op cycle
        # does not fill the log, and nothing else — a heal still prints. It
        # means the same on every path below, so the one flag has one meaning.
        return _kb_report_verify(idx, heal=not args.no_heal, dry_run=args.dry_run,
                                 quiet=args.quiet,
                                 state=f"up to date at {local[:9]}")

    if local != remote:
        if args.dry_run:
            print(f"kb sync: would fast-forward {local[:9]} -> {remote[:9]}")
            return 0
        ff = _kb_git("merge", "--ff-only", remote)
        if ff.returncode != 0:
            # Divergence, or a dirty tree. Never force it: the checkout may hold
            # work that is not on origin, which is exactly the ARCH-395 incident.
            print(f"kb sync: fast-forward REFUSED ({local[:9]} -> {remote[:9]}) — "
                  f"the checkout has diverged or has uncommitted edits. "
                  f"Resolve by hand; the index is left untouched.\n{ff.stderr.strip()}",
                  file=sys.stderr)
            return 1

    if args.full:
        if args.dry_run:
            print("kb sync: would run a full scan and reconcile")
            return 0
        res = idx.full_scan_and_reconcile()
        print(f"kb sync: full scan — {res['indexed']} indexed, "
              f"{res['removed']} reconciled out, {len(res['invalid'])} invalid")
    else:
        changed = _kb_changed_paths(local, remote)
        res = idx.index_paths(changed)
        print(f"kb sync: {local[:9]} -> {remote[:9]} — {res['indexed']} indexed, "
              f"{res['removed']} removed, {len(res['invalid'])} invalid "
              f"({res['skipped']} non-doc paths skipped)")

    for rel, err in res["invalid"]:
        # Loud, because an invalid doc is absent from the index rather than
        # wrong in it — the silent-vanish case a caller then reads as "missing".
        print(f"kb sync: INVALID {rel}: {err}", file=sys.stderr)
    for rel, err in res["deferred"]:
        # Not refused: the roster could not be read, so the row is left as it was.
        print(f"kb sync: DEFERRED {rel}: {err}{idx.kept_suffix(rel)}", file=sys.stderr)
    for rel, err in res["refused"]:
        # Refused on its own grounds, so the outage does not change the answer.
        print(f"kb sync: REFUSED {rel}: {err}{idx.kept_suffix(rel)}", file=sys.stderr)

    return _kb_report_verify(idx, heal=not args.no_heal, dry_run=args.dry_run,
                             quiet=args.quiet,
                             reported={rel for rel, _ in res["invalid"]}
                             | {rel for rel, _ in res["deferred"]}
                             | {rel for rel, _ in res["refused"]})


def _kb_read_change(edits_arg, content_arg, content_file=None,
                    edits_file=None) -> tuple[list, str | None, str]:
    """Parse the change arguments into (edits, full_body, error).

    LITERAL AND FILE ARE SEPARATE FLAGS, deliberately. `--content` used to mean
    "text, unless it happens to name a file, in which case read that" — convenient
    in a shell and unsafe anywhere else. Two callers each testing `is_file()`
    cannot agree: a file created between the caller's check and this one flips the
    meaning of the argument, so a guard at the boundary is a race rather than a
    control (security review, #247). One flag, one meaning; a value that looks
    like a path is content, because the caller said `--content`.

    Shared by `kb apply` and `kb propose` so the two cannot disagree about what a
    change IS. They differ in where the result lands — main or a PR — and that is
    the only thing they should differ about.
    """
    edits = []
    raw_edits = None
    if edits_file:
        try:
            raw_edits = Path(edits_file).read_text()
        except OSError as e:
            return [], None, f"could not read --edits-file ({e})"
    elif edits_arg:
        raw_edits = edits_arg
    if raw_edits is not None:
        # Name the flag the caller actually used. Reporting "--edits" for a
        # problem in --edits-file sends them to inspect the wrong thing.
        which = "--edits-file" if edits_file else "--edits"
        try:
            edits = json.loads(raw_edits)
        except json.JSONDecodeError as e:
            return [], None, f"{which} is not valid JSON ({e})"
        if not isinstance(edits, list) or not edits:
            return [], None, f"{which} must be a non-empty JSON list of {{old,new}}"

    body = None
    if content_file:
        try:
            body = Path(content_file).read_text()
        except OSError as e:
            return [], None, f"could not read --content-file ({e})"
    elif content_arg is not None:
        body = content_arg

    if bool(edits) == (body is not None):
        return [], None, "give exactly one of --edits/--edits-file or --content/--content-file"
    return edits, body, ""


def _kb_apply_edits(prior: str | None, edits: list, body: str | None,
                    *, allow_overwrite: bool) -> tuple[str | None, str]:
    """Produce the new file content, or an error. Anchors must match exactly once.

    Refusing on drift (0 matches) AND on ambiguity (>1) is deliberate: an anchor
    that matches twice would silently edit whichever came first, which is a
    different change from the one the caller described.
    """
    if body is not None:
        if prior is not None and not allow_overwrite:
            return None, ("target exists, so use edits. Replacing a whole doc "
                          "needs an explicit overwrite.")
        return (body if body.endswith("\n") else body + "\n"), ""
    if prior is None:
        return None, "target does not exist; supply full content to create it"
    out = prior
    for i, e in enumerate(edits):
        old = (e or {}).get("old", "")
        if not old:
            return None, f"edit {i} has an empty 'old' anchor"
        n = out.count(old)
        if n != 1:
            return None, (f"edit {i} anchor matches {n}x (need exactly 1). "
                          f"The doc drifted, or the anchor is not unique.")
        out = out.replace(old, e.get("new", ""), 1)
    return out, ""


def cmd_kb_audit(args) -> int:
    """Read the KB's write history back. The compensating control for `in-session`.

    Exits 3 when a commit reached main by neither sanctioned path, so a scheduled
    run surfaces as a failure rather than a log line nobody opens — the same
    reasoning that made the briefing job's silent push failure invisible for a
    day.

    THREE, NOT TWO, because argparse already owns 2 for a usage error. The first
    live run proved why that matters: the deployed binary had no `kb audit`
    subcommand yet, argparse exited 2, and the launcher reported BYPASSES FOUND
    for a command that never ran. An audit that manufactures a security finding
    out of its own failure is worse than one that does not run at all.
    """
    # Resolve THIS checkout's copy first, like `_kb_indexer` does. agentctl only
    # has the DEPLOYED lib dir on sys.path, and that symlinks into the primary
    # checkout — so a module that exists only on a feature branch is invisible,
    # and the command dies with ModuleNotFoundError rather than running the code
    # under review (ARCH-229's deploy split again).
    _libdir = Path(__file__).resolve().parent.parent / "lib" / "agent-platform"
    if (_libdir / "kb_audit.py").is_file() and str(_libdir) not in sys.path:
        sys.path.insert(0, str(_libdir))
    import kb_audit  # noqa: PLC0415 — lazy, like the other kb helpers
    result = kb_audit.audit(since=args.since, ref=args.ref, root=KNOWLEDGE_ROOT)
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(kb_audit.render(result))
    if result.get("error"):
        return 1
    return 3 if result["unsigned"] else 0


def _kb_indexable_hint(source_ref: str) -> str:
    """Best-effort corrected path for an indexer-shape refusal.

    The refused string may be a bare frontmatter id (missing the `projects/`
    prefix), a path outside `projects/`, or a file with a non-`.md` extension.
    The hint must be a path the indexer WOULD serve, so it prepends `projects/`
    when absent and replaces a non-`.md` extension rather than appending to it —
    `notes.txt.md` would send a retry into a second refusal (round-2 review).
    """
    hint = source_ref if source_ref.startswith("projects/") else "projects/" + source_ref
    if not hint.endswith(".md"):
        hint = os.path.splitext(hint)[0] + ".md"
    return hint


# TWO KINDS OF NON-.md PATH A PROPOSAL MAY EDIT. A profile (the steward's call,
# 2026-09-11): .yaml under projects/<project>/profiles/. And the agent policy
# file, at exactly projects/platform/policy/agent-policy.yaml: one per knowledge
# repository, never per project, so it is one exact path and no other file under
# policy/ is accepted. The indexer serves neither, and both are PR-only under
# every provenance (kb_writes.is_pr_only), so kb propose is the only route that
# can change one. Refusing them left them uneditable by anyone once the
# knowledge repo required a KB-Write trailer on every PR (knowledge#399 met it
# first for profiles). Every other path that is not a .md under projects/ is
# still refused.
#
# .yaml ONLY, NOT .yml. knowledge-ctx's load_profile and list_profiles look for
# `<name>.yaml` and nothing else, and the policy reader looks for the .yaml name,
# so a .yml file would pass every check here, merge, and never be loaded: the
# file-nothing-reads trap the .md rule exists for (review, PR 540).
_KB_PROFILE_REL = re.compile(r"projects/[^/]+/profiles/[^/]+\.yaml")


def _kb_is_profile_rel(source_ref: str) -> bool:
    return _KB_PROFILE_REL.fullmatch(source_ref) is not None


def _kb_is_policy_rel(source_ref: str) -> bool:
    return source_ref == _kb_writes().POLICY_PATH


def _kb_is_yaml_proposable_rel(source_ref: str) -> bool:
    return _kb_is_profile_rel(source_ref) or _kb_is_policy_rel(source_ref)


def _kb_read_batch(batch_arg, batch_file) -> tuple[list[dict], str]:
    """Parse a batch proposal into [{id, edits, content, base_sha}], or an error.

    One entry per document; each carries exactly one of a non-empty `edits` list
    or a `content` string, the same either-or `_kb_read_change` enforces for a
    single document, an optional `base_sha`, and an optional `allow_overwrite`,
    which a `content` entry needs to replace a document that exists, exactly as
    `--content` needs `--allow-overwrite` (reviewer, #605)."""
    raw = batch_arg
    which = "--batch"
    if batch_file:
        which = "--batch-file"
        try:
            raw = Path(batch_file).read_text()
        except OSError as e:
            return [], f"could not read --batch-file ({e})"
    try:
        items = json.loads(raw)
    except (TypeError, json.JSONDecodeError) as e:
        return [], f"{which} is not valid JSON ({e})"
    if not isinstance(items, list) or not items:
        return [], f"{which} must be a non-empty JSON list of documents"
    out = []
    for i, item in enumerate(items):
        if not isinstance(item, dict) or not isinstance(item.get("id"), str) or not item["id"]:
            return [], f"{which} entry {i} needs a string `id`"
        edits, content = item.get("edits"), item.get("content")
        has_edits = isinstance(edits, list) and bool(edits)
        has_content = isinstance(content, str)
        if has_edits == has_content:
            return [], (f"{which} entry {i} ({item['id']}) needs exactly one of a "
                        f"non-empty `edits` list or a `content` string")
        base = item.get("base_sha")
        if base is not None and not isinstance(base, str):
            return [], f"{which} entry {i} ({item['id']}) has a non-string `base_sha`"
        overwrite = item.get("allow_overwrite", False)
        if not isinstance(overwrite, bool):
            return [], f"{which} entry {i} ({item['id']}) has a non-boolean `allow_overwrite`"
        out.append({"id": item["id"], "edits": edits if has_edits else [],
                    "content": content if has_content else None, "base_sha": base,
                    "allow_overwrite": overwrite})
    return out, ""


def _kb_propose_refusal(ref: str, new_content: str, journal) -> int | None:
    """Why a proposed file would land broken, as an exit code, or None.

    A profile must parse as knowledge-ctx loads one; a document must be one the
    indexer would keep. Checked for every document before any branch exists."""
    if _kb_is_yaml_proposable_rel(ref):
        # The KB validator reads only .md, so it says nothing about a profile.
        # Parse it the way knowledge-ctx's load_profile does and refuse what
        # that would fail on, before any branch exists. `cmd_kb_propose`, this
        # function's only caller, has already run `venv_bootstrap.ensure` as
        # its own first action, so `yaml` is importable here.
        import yaml  # noqa: PLC0415 — only a profile edit needs it
        try:
            parsed = yaml.safe_load(new_content)
        except yaml.YAMLError as e:
            print(f"kb propose: refused — {ref} is not valid YAML, so "
                  f"knowledge-ctx could not load it:\n{e}", file=sys.stderr)
            journal("invalid", "profile is not valid YAML")
            return 6
        if not isinstance(parsed, dict):
            print(f"kb propose: refused — {ref} must be a YAML mapping, as "
                  f"knowledge-ctx loads a profile; it parsed as "
                  f"{type(parsed).__name__}.", file=sys.stderr)
            journal("invalid", "profile is not a YAML mapping")
            return 6
    # A document the indexer would drop is refused here too, before any branch
    # exists: otherwise a PR that passes CI and review merges a doc no agent can
    # read (see the matching check in cmd_kb_apply).
    dropped = _kb_indexer_errors(ref, new_content)
    if dropped:
        detail = "; ".join(dropped)
        print(f"kb propose: refused — the knowledge indexer would drop {ref} "
              f"({detail}), so the merged document would be invisible to every "
              f"agent.", file=sys.stderr)
        journal("invalid", detail)
        return 6
    return None


def cmd_kb_propose(args) -> int:
    """Open a PR for a KB change instead of writing main. The judgment-class path.

    This is where every write that is not a decision the operator states themself in session
    has to go — and it is the ONLY route for roster and profile paths, under any
    provenance. It exists so that "you may not write this
    directly" has an answer other than "so do it by hand", which is what the
    per-edit worktree ceremony used to be.

    Deliberately does NOT take a provenance: a proposal's whole point is that the
    review cycle, not a claimed provenance, is what authorizes it.

    `--delete` proposes REMOVING the named files, several in one PR when the
    caller names several. Nothing else in the cage removes a document: `apply`
    and an edit proposal take content, and an empty body fails validation rather
    than deleting, so retiring the convivy-lab documents on 2026-09-11 had no
    route but git, which the Library may not use. A delete demands the caller's
    OWN live lease on every path, where an edit only refuses a foreign one: an
    edit carries a base sha from `kb checkout`, a delete has no content to carry
    one, and the lease is then the only evidence the caller checked the item
    out. It may name any file under projects/, a .yaml profile included, since
    the indexer-shape rule guards against WRITING a file nothing serves and a
    removal writes nothing.

    `--batch` changes SEVERAL documents in one PR: one mechanical change across a
    roster (adding a required field to 53 agent documents) would otherwise be 53
    PRs and 53 review cycles. Every document passes the checks a single edit
    does, a `content` entry replacing an existing document included, which needs
    its own `allow_overwrite` as `--content` needs `--allow-overwrite`. Like a
    delete, each needs the caller's OWN live lease, since only a checked-out item
    changes and a batch is where skipping a checkout would be easiest to miss.
    Nothing is branched until every document has passed.
    """
    # First action, before the holder is even validated: a refusal below (a
    # foreign lease, an invalid holder) journals a row, and re-exec must not
    # run after that row exists, so it must not run after ANY of this
    # function's own side effects either (round-2 review, PR 695).
    venv_bootstrap.ensure(__file__, requires=("yaml",))
    if _kb_refuse_if_not_github("kb propose"):
        return 2
    kbw = _kb_writes()
    holder = _kb_holder(args.holder)
    if not kbw.valid_holder(holder):
        print(f"kb propose: refused — holder {holder!r} is not a valid identity.",
              file=sys.stderr)
        return 1

    delete = args.delete
    batch_arg = getattr(args, "batch", None)
    batch_file = getattr(args, "batch_file", None)
    batch = None
    if batch_arg is not None or batch_file:
        if (delete or args.also or args.edits is not None or args.content is not None
                or args.content_file or args.edits_file or args.base_sha
                or args.allow_overwrite):
            print("kb propose: refused — --batch carries each document's id, change and "
                  "base sha itself, so it takes no further paths, no --delete, and no "
                  "--edits/--content/--base-sha.", file=sys.stderr)
            return 1
        batch, err = _kb_read_batch(batch_arg, batch_file)
        if err:
            print(f"kb propose: {err}", file=sys.stderr)
            return 1
    if args.also and not delete:
        print("kb propose: refused — only --delete takes several paths; an edit "
              "proposal names one document.", file=sys.stderr)
        return 1
    if delete and (args.edits is not None or args.content is not None
                   or args.content_file or args.edits_file or args.allow_overwrite):
        print("kb propose: refused — --delete takes no edits or content.", file=sys.stderr)
        return 1

    refs: list[str] = []
    for ident in ([item["id"] for item in batch] if batch else (args.doc, *args.also)):
        ref, err = _kb_resolve_ref(ident)
        if err:
            print(f"kb propose: {err}", file=sys.stderr)
            return 1
        if ref in refs and batch:
            # Two entries for one document would each apply to the same prior,
            # and the second would silently replace the first.
            print(f"kb propose: refused — {ref} appears twice in the batch.",
                  file=sys.stderr)
            return 1
        if ref not in refs:
            refs.append(ref)
    if batch:
        # The positional document must be one of the batch's, so the command line
        # cannot name one document while the batch changes others.
        named, err = _kb_resolve_ref(args.doc)
        if err or named not in refs:
            print(f"kb propose: refused — {args.doc!r} is not one of the batch's "
                  f"documents; name one of them as the document argument.",
                  file=sys.stderr)
            return 1
    if args.base_sha and len(refs) > 1:
        print("kb propose: refused — --base-sha is one document's content-sha, so it "
              "cannot stand for a delete of several.", file=sys.stderr)
        return 1
    source_ref = refs[0]

    def journal_each(result: str, detail: str) -> None:
        for ref in refs:
            kbw.journal("propose", source_ref=ref, holder=holder,
                        result=result, detail=detail)

    # A proposal is a change to the doc too, only one a reviewer approves before
    # it lands, so another holder's live lease refuses it the same way it
    # refuses `apply`. Checked before any git work, like the policy refusal.
    for ref in refs:
        if _kb_refuse_foreign_lease(kbw, "propose", ref, holder):
            return 3

    if delete:
        for ref in refs:
            if not ref.startswith("projects/"):
                print(f"kb propose: refused — {ref!r} is not under projects/, so it is "
                      f"not a knowledge document.", file=sys.stderr)
                return 1
            # Foreign leases were refused above, so any lease left is the caller's.
            if not kbw.lease_for(ref):
                print(f"kb propose: refused — {ref} is not checked out. A delete is a "
                      f"change, and only a checked-out item changes: run `agentctl kb "
                      f"checkout {ref}` (kb_checkout) first.", file=sys.stderr)
                kbw.journal("propose", source_ref=ref, holder=holder,
                            result="unleased", detail="delete")
                return 1

    elif batch:
        for ref in refs:
            if not (_kb_indexer().is_indexable_rel(ref) or _kb_is_yaml_proposable_rel(ref)):
                print(f"kb propose: refused — {ref!r} is not a path the indexer will "
                      f"index, nor a profile or the agent policy file, so it cannot be in a batch.", file=sys.stderr)
                return 1
            if not kbw.lease_for(ref):
                print(f"kb propose: refused — {ref} is not checked out. Every document in "
                      f"a batch needs your own checkout: run `agentctl kb checkout {ref}` "
                      f"(kb_checkout) first.", file=sys.stderr)
                kbw.journal("propose", source_ref=ref, holder=holder,
                            result="unleased", detail="batch")
                return 1

    # Same indexer-shape rule as kb apply: a proposal that is not a `.md` under
    # projects/ would merge into a file the indexer never serves. The validator
    # checks frontmatter, not location, and PR review may not notice a wrong path
    # either, so refuse here — before the worktree lock or any git work — from
    # the indexer's own predicate. Roster and profile paths live under projects/,
    # so they are not collateral damage. A profile is the one exception: see
    # _kb_is_yaml_proposable_rel above.
    elif not (_kb_indexer().is_indexable_rel(source_ref) or _kb_is_yaml_proposable_rel(source_ref)):
        print(f"kb propose: refused — {source_ref!r} is not a path the indexer will "
              f"index (a .md document under projects/), nor a profile "
              f"(projects/<project>/profiles/<name>.yaml) or the agent policy file "
              f"({_kb_writes().POLICY_PATH}), so the merged proposal would "
              f"be a file nothing ever retrieves. The argument is named `id` but takes "
              f"a PATH. Did you mean {_kb_indexable_hint(source_ref)!r}?", file=sys.stderr)
        return 1

    edits = body = None
    if not delete and not batch:
        edits, body, err = _kb_read_change(
            args.edits, args.content, args.content_file, args.edits_file)
        if err:
            print(f"kb propose: {err}", file=sys.stderr)
            return 1

    # THE APP IDENTITY IS OBTAINED BEFORE THE LOCK, for the reason given in
    # `cmd_kb_apply`: the fetch that opens `_scribe_worktree` is made as the App,
    # and a refusal here leaves no lock, no cage state and no remote touched. The
    # PR token is minted with it, so the `gh` calls at the end cannot be the first
    # place a missing permission or key is discovered, after a branch has landed.
    import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
    library, why = _kb_library_git("kb propose", pull_requests=True)
    if library is None:
        journal_each("no-identity", why)
        return 2

    kroot, err = _scribe_worktree(library)   # lock + reset to fresh origin/main
    if err:
        print(f"kb propose: {err}", file=sys.stderr)
        return 1

    # The cage's own commit BEFORE this proposal writes or commits anything, read
    # as a sha (never re-resolved as a name on the cleanup path below, per the
    # security reviewer). `_scribe_worktree` has just reset the cage to it, so
    # this is always the same commit `main_sha` names there; capturing it here,
    # under its own name, means cleanup can detach back to it even once the
    # cage's HEAD has moved on to a proposal commit.
    r_pre = _kb_git_at(kroot, "rev-parse", "HEAD")
    pre_sha = r_pre.stdout.strip() if r_pre.returncode == 0 and r_pre.stdout.strip() else None

    kroot_resolved = kroot.resolve()
    for ref in refs:
        if kroot_resolved not in (kroot / ref).resolve().parents:
            print(f"kb propose: refused — {ref} resolves outside the knowledge root",
                  file=sys.stderr)
            return 1
    target = kroot / source_ref

    if delete:
        missing = [ref for ref in refs if not (kroot / ref).is_file()]
        if missing:
            print(f"kb propose: refused — nothing to delete at {', '.join(missing)}: "
                  f"not a file on origin/main.", file=sys.stderr)
            return 1

    changed: dict[str, str] = {}
    # The branch tag hashes the batch AS SUBMITTED, before already-current documents
    # are dropped: a re-proposal whose changed set shrank (one document merged or
    # was reverted meanwhile) must still land on its open PR rather than open a
    # second one beside it (reviewer, #605).
    submitted_refs = list(refs)
    # Files this attempt would CREATE, which the cleanup below removes: checkout
    # -f restores tracked files but leaves an uncommitted new one on disk.
    created: list[Path] = []
    if batch:
        for item, ref in zip(batch, refs):
            path = kroot / ref
            prior_b = path.read_text() if path.is_file() else None
            sha_b = kbw.content_sha(prior_b if prior_b is not None else "")
            if item["base_sha"] and item["base_sha"] != sha_b:
                print(f"kb propose: refused — stale base for {ref}. You wrote against "
                      f"{item['base_sha'][:12]}, origin/main holds {sha_b[:12]}.",
                      file=sys.stderr)
                return 5
            new_b, err = _kb_apply_edits(prior_b, item["edits"], item["content"],
                                         allow_overwrite=item["allow_overwrite"])
            if err:
                print(f"kb propose: refused — {ref}: {err}", file=sys.stderr)
                return 1
            if new_b == (prior_b or ""):
                continue
            refusal = _kb_propose_refusal(ref, new_b, journal_each)
            if refusal is not None:
                return refusal
            changed[ref] = new_b
            if prior_b is None:
                created.append(path)
        if not changed:
            print("kb propose: no change — every document in the batch already has "
                  "this content.")
            return 0
        # A document already holding its content is left out of the PR, and said so.
        unchanged = [ref for ref in refs if ref not in changed]
        if unchanged:
            print(f"kb propose: already current, not in the PR: {', '.join(unchanged)}",
                  file=sys.stderr)
        refs[:] = list(changed)

    prior = target.read_text() if not batch and target.is_file() else None
    if not batch and not delete and prior is None:
        created.append(target)
    current_sha = kbw.content_sha(prior if prior is not None else "")
    if not batch and args.base_sha and args.base_sha != current_sha:
        print(f"kb propose: refused — stale base. You wrote against "
              f"{args.base_sha[:12]}, origin/main holds {current_sha[:12]}.",
              file=sys.stderr)
        return 5

    new_content = None
    if not delete and not batch:
        new_content, err = _kb_apply_edits(prior, edits, body,
                                           allow_overwrite=args.allow_overwrite)
        if err:
            print(f"kb propose: refused — {err}", file=sys.stderr)
            return 1
        if new_content == (prior or ""):
            print(f"kb propose: no change — {source_ref} already has this content.")
            return 0
        refusal = _kb_propose_refusal(source_ref, new_content, journal_each)
        if refusal is not None:
            return refusal

    # The branch name carries the DOC as well as the title. A title-only slug
    # collides whenever two proposals are similarly named — "update the runbook"
    # is not a distinctive string — and the push below would then land one
    # proposal's commit on another's branch. Including a hash of the path makes
    # a collision mean the same doc AND the same intent, which is a re-proposal
    # rather than an accident. Several paths hash joined; one path hashes to the
    # same tag it always had, so a re-proposal still finds its branch.
    slug = re.sub(r"[^a-z0-9]+", "-", args.title.lower()).strip("-")[:40] or "kb-change"
    tag = hashlib.sha256("\n".join(submitted_refs).encode()).hexdigest()[:8]
    branch = f"kb/{slug}-{tag}"

    r = _kb_git_at(kroot, "checkout", "-q", "-B", branch)
    if r.returncode != 0:
        print(f"kb propose: could not create branch {branch}: {r.stderr.strip()}",
              file=sys.stderr)
        return 1

    # EVERY exit from here detaches. A `git add`, `commit` or `push` failure used
    # to return with the cage still on the branch, and the next `kb apply` then
    # ran its `reset --hard origin/main` against that BRANCH rather than a
    # detached HEAD — one verb's error path quietly changing another verb's
    # meaning. try/finally rather than a detach before each return, because the
    # next early return added would forget it again (code review, #247).
    try:

        before = _kb_errors(kroot)
        if delete:
            r = _kb_git_at(kroot, "rm", "-q", "--", *refs)
            if r.returncode != 0:
                print(f"kb propose: git rm failed: {r.stderr.strip()}", file=sys.stderr)
                return 1
        elif batch:
            for ref, text in changed.items():
                (kroot / ref).parent.mkdir(parents=True, exist_ok=True)
                (kroot / ref).write_text(text)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(new_content)
        introduced = _kb_new_errors(before, _kb_errors(kroot))
        if introduced is not None:
            # Validate even on the PR path. A proposal that reddens CI wastes a whole
            # review cycle discovering what the validator knew before the push. A
            # delete is checked too: removing a doc another depends on is an error.
            print(f"kb propose: refused — this change introduces KB validation errors, "
                  f"so its PR would land red.\n{introduced}", file=sys.stderr)
            journal_each("invalid", introduced)
            return 6

        action = "deleting" if delete else "changing"
        if args.dry_run:
            print(f"kb propose: DRY-RUN ok — would open a PR {action} {', '.join(refs)} "
                  f"on branch {branch}; validator reports no new errors.")
            return 0

        trailers = "\n".join(kbw.write_trailer("propose", ref, "proposal", holder)
                             for ref in refs)
        msg = (f"docs: {args.title}\n\n{args.rationale or 'Proposed via `agentctl kb propose`.'}\n\n"
               f"{trailers}{kb_coauthor_trailer()}")
        # `git rm` has already staged a delete; an edit stages its one file.
        if delete:
            stage_steps = []
        elif batch:
            stage_steps = [("add", *(str(kroot / ref) for ref in changed))]
        else:
            stage_steps = [("add", str(target))]
        # Authored and committed as the App, for this invocation only (see
        # `cmd_kb_apply`). The requesting session is the `holder` in the trailer.
        for cmd in stage_steps:
            r = _kb_git_at(kroot, *cmd, env=KM.commit_env())
            if r.returncode != 0:
                print(f"kb propose: git {cmd[0]} failed: {r.stderr.strip()}", file=sys.stderr)
                return 1
        r = _kb_commit(kroot, msg, KM.commit_env())
        if r.returncode != 0:
            print(f"kb propose: git commit failed: {r.stderr.strip()}", file=sys.stderr)
            return 1

        # `--force-with-lease` with no per-ref expectation only protects a branch the
        # worktree has TRACKING INFO for, and the cage fetches origin/main alone — so
        # on every first push the lease protects nothing (security review, #247).
        # Read the remote tip explicitly and state the expectation, which makes the
        # lease real: absent remotely, refuse to clobber; present, only overwrite the
        # exact commit we looked at.
        #
        # Both the tip read and the push run as `convivy-library` (see
        # `_kb_library_git`), against the https URL rather than `origin`, and with no
        # `-u`: that flag names a remote, and the branch is deleted below in any case.
        ls = library(kroot, "ls-remote", KM.push_url(), f"refs/heads/{branch}")
        remote_tip = ls.stdout.split()[0] if ls.returncode == 0 and ls.stdout.strip() else ""
        if remote_tip:
            push = ["push", "-q", f"--force-with-lease={branch}:{remote_tip}",
                    KM.push_url(), branch]
        else:
            # Nothing there yet, so a plain push is both sufficient and safer: it
            # fails rather than overwrites if someone creates the branch in between.
            push = ["push", "-q", KM.push_url(), branch]
        r = library(kroot, *push)
        if r.returncode != 0:
            print(f"kb propose: push failed — another proposal may hold {branch}. "
                  f"{r.stderr.strip()}", file=sys.stderr)
            journal_each("push-failed", branch)
            return 1

        # A PROPOSAL ONTO A BRANCH THAT ALREADY HAS AN OPEN PR IS A REVISION, and
        # the push above has already landed it. `gh pr create` would then fail
        # with "already exists", and reporting that as a failure is wrong in the
        # way that matters: the work happened, the caller reads a failed
        # submission, and retries or gives up. Found on knowledge#393, the first
        # PR revised this way. Looked up only after a successful push, so a push
        # or validation failure above still exits non-zero; if the lookup itself
        # fails, fall through to create, whose own error is then the report.
        named = ", ".join(f"`{ref}`" for ref in refs)
        why = ("A deletion always takes this path: no direct write removes a document."
               if delete else
               "This path exists because the change is not eligible for a direct "
               "write — either it carries no direct provenance, or it touches a "
               "roster/profile path, which takes review under every provenance.")
        body_md = (f"{args.rationale or ''}\n\nProposed by `{holder}` via "
                   f"`agentctl kb propose`. {'Deletes' if delete else 'Changes'} {named}.\n\n"
                   f"{why}")
        # The three `gh` calls below run as the App, with the PR token, so the
        # PR is authored by `convivy-library[bot]` and no stored login is read.
        existing = library.gh(
            kroot, "pr", "list", "--repo", "convivy/knowledge", "--head", branch,
            "--state", "open", "--json", "url", "--jq", ".[0].url // \"\"")
        existing_url = existing.stdout.strip() if existing.returncode == 0 else ""
        if existing_url:
            head = _kb_git_at(kroot, "rev-parse", "HEAD").stdout.strip()
            # The description goes with the revision. Left alone, it describes
            # the first proposal while the branch carries the second (knowledge#393
            # had to be corrected by hand). A failed edit does not undo the
            # revision, which has landed, so it warns rather than failing.
            edit = library.gh(
                kroot, "pr", "edit", existing_url, "--repo", "convivy/knowledge",
                "--body", body_md)
            if edit.returncode != 0:
                print(f"kb propose: the branch is updated, but the PR description "
                      f"could not be refreshed: {edit.stderr.strip()}", file=sys.stderr)
            journal_each("updated", existing_url)
            print(f"kb propose: updated {existing_url} (head {head[:12]})")
            return 0

        pr = library.gh(
            kroot, "pr", "create", "--repo", "convivy/knowledge", "--base", "main",
            "--head", branch, "--title", args.title, "--body", body_md)
        if pr.returncode != 0:
            print(f"kb propose: branch pushed but PR creation failed: {pr.stderr.strip()}",
                  file=sys.stderr)
            journal_each("pr-failed", branch)
            return 1

        url = pr.stdout.strip().splitlines()[-1] if pr.stdout.strip() else ""
        journal_each("ok", url)
        print(url or f"kb propose: opened a PR from {branch}")
        return 0
    finally:
        # EVERY exit also RESTORES the cage. Detaching alone left a dry run's edit
        # on disk and its branch in the cage (seen 2026-09-11 after the #531
        # deploy probe), and a refused or failed attempt left the same. `-f`
        # discards a tracked edit or a staged delete; a created file that never
        # committed is untracked, which checkout leaves alone, so it is removed
        # here; and the local branch goes because the pushed one, if any, is the
        # only copy anything reads.
        main_sha = _exact_origin_main(kroot)
        undone: list[str] = []
        if main_sha is None:
            # No ref to detach at, and a name is never re-resolved here, so detach at
            # `pre_sha` — the cage's own commit BEFORE this proposal, recorded
            # above. Detaching at the cage's current HEAD instead would keep the
            # proposal whenever it had already committed, since HEAD by cleanup
            # time IS the proposal commit (reviewer, round 4). The branch cannot
            # be deleted while the cage has it checked out, so the detach has to
            # come first.
            target = pre_sha if pre_sha is not None else "HEAD"
            for step in (("checkout", "-q", "-f", "--detach", target),
                         ("reset", "-q", "--hard", target)):
                r = _kb_git_at(kroot, *step)
                if r.returncode != 0:
                    undone.append(f"`git {step[0]}` failed ({r.stderr.strip()})")
        else:
            _kb_git_at(kroot, "checkout", "-q", "-f", "--detach", main_sha)
        for path in created:
            # Detaching above has already dropped a created file the proposal went
            # on to commit — it is not in the tree detached to (`pre_sha` or
            # `main_sha`), except on the rare fallback where `pre_sha` was never
            # recorded and the detach target is the cage's own HEAD, a no-op that
            # leaves a committed created file tracked right where it was. `ls-files`
            # tells the two apart: what is still on disk AND untracked here is only
            # what never got as far as a commit (a dry run, or a write before the
            # commit step), which checkout leaves alone because it was never tracked.
            tracked = _kb_git_at(kroot, "ls-files", "--error-unmatch",
                                 str(path)).returncode == 0
            if path.is_file() and not tracked:
                path.unlink()
        r = _kb_git_at(kroot, "branch", "-q", "-D", branch)
        if main_sha is None:
            if r.returncode != 0:
                undone.append(f"the local branch {branch} was not deleted "
                              f"({r.stderr.strip()})")
            if pre_sha is None:
                outcome = ("Not everything was restored: the cage's pre-proposal "
                           "commit was never recorded, so its edits could not be "
                           "confirmed discarded" +
                           ("; " + "; ".join(undone) if undone else ""))
            elif undone:
                outcome = "Not everything was restored: " + "; ".join(undone)
            else:
                outcome = ("The restore checkout was skipped because the ref is "
                           "missing, so the cage was detached at its pre-proposal "
                           "commit, its edits were discarded and the local branch "
                           "was deleted; the next `kb apply` resets the cage once "
                           "the ref exists")
            print(_missing_origin_main("kb propose", kroot, outcome=outcome),
                  file=sys.stderr)


def _kb_merge_read(repo: str, pr: str, library) -> "tuple[object, str, dict]":
    """Gather every fact `kb_merge.refusals` needs for `repo`#`pr`: its own
    view, commits and author, the review gate's own decision, every
    `Merge-after` companion's state, and — after fetching `origin/main` and
    the PR's head fresh into the knowledge checkout with `library` — the
    agent policy, the changed files, and whether the head still contains
    that fresh main.

    Returns `(facts, head, carried)`. `head` is THIS read's own fresh
    headRefOid (used for the author/commits/companions reads and for
    messages); `facts.head_sha` is the head the review gate's own,
    separately-read decision reports, so a push landing between the two
    reads as a moved head (`facts.gate_head != facts.head_sha`). `carried`
    is `{role: commit}` for every role whose stale APPROVE carried onto
    `facts.head_sha` here (platform/decisions/0078). When some OTHER reason
    (CI, draft, mergeability) already refuses regardless, the carry is never
    attempted, and `facts.review_reasons` says so for a stale-but-APPROVE
    role rather than reporting it as a settled "re-review needed" — the
    carry's own conditions are unaffected either way (agent-platform#857).

    `cmd_kb_merge` calls this once, or twice when it rebuilds the branch
    (issue_01M4JFSBA38N836QE0VANPCWNB): once to decide whether to, once
    after, against the rebuilt head. May raise `RuntimeError` or
    `json.JSONDecodeError` from the first PR read; the caller reports that
    as a refusal.
    """
    import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
    fields = ["number", "state", "headRefName", "baseRefName", "isCrossRepository",
              "headRefOid", "body"]
    view = _gh_pr_json(pr, fields, repo=repo)
    head = (view.get("headRefOid") or "").strip()

    # One compact JSON object per commit per line, so no paging flag is assumed
    # beyond --paginate. Anything unparseable leaves `commits` None, which refuses.
    commits = None
    r = subprocess.run(
        ["gh", "api", "--paginate", f"repos/{repo}/pulls/{pr}/commits?per_page=100",
         "--jq", ".[] | {sha: .sha, commit: {message: .commit.message}}"],
        capture_output=True, text=True)
    if r.returncode == 0:
        try:
            commits = [json.loads(line) for line in r.stdout.splitlines() if line.strip()]
        except ValueError:
            commits = None

    # The author is what the pulls endpoint says opened the PR, compared in
    # `refusals` with the App's own identity. Unreadable leaves it None, which refuses.
    author = None
    r = subprocess.run(
        ["gh", "api", f"repos/{repo}/pulls/{pr}",
         "--jq", "{login: .user.login, id: .user.id, type: .user.type}"],
        capture_output=True, text=True)
    if r.returncode == 0:
        try:
            author = json.loads(r.stdout)
        except ValueError:
            author = None

    # The review gate's own decision, computed in-process — the same function
    # `agentctl review-status` is itself "a thin printer over" — rather than run
    # as a subprocess and its printed text parsed. Routed exactly as
    # `cmd_review_status` routes (platform/decisions/0090): once the launcher
    # is installed, `review-status` reads GitHub check-runs instead of comment
    # stamps, and this command must decide the same way rather than keep
    # reading stamps on its own say-so. `_review_status_from_checks` reports no
    # stamps (it never reads comments), so `from_checks` also gates the carry
    # attempt below — the carry (platform/decisions/0078) is defined over an
    # APPROVE *stamp*, and there is nothing to carry once review-status itself
    # has stopped producing them.
    #
    # `result.head` is this read's own fresh headRefOid; a push landing between
    # `view` above and this read is caught below as a moved head, and
    # `result.stamps` (comment-stamp path only) is every authenticated review
    # stamp on the PR (not just the latest per role), which the carry attempt
    # needs to search.
    from_checks = _review_launch_path() is not None
    if from_checks:
        result = _review_status_from_checks(pr, repo, list(KM.REVIEW_ROLES))
    else:
        result = _review_status_decision(pr, repo, list(KM.REVIEW_ROLES),
                                         allow_unverified=False, ignore_ci=False)
    head_after = result.head
    stamps = result.stamps
    review_ok = result.ok
    review_reasons = list(result.reasons)

    companions = {}
    for crepo, num in KM.merge_after(view.get("body")):
        try:
            companions[(crepo, num)] = _gh_pr_json(str(num), ["state"], repo=crepo).get("state")
        except (RuntimeError, json.JSONDecodeError):
            companions[(crepo, num)] = None

    # The policy and the changed files come from the knowledge checkout after a
    # fresh fetch of origin/main and of the PR's head, against the head the gate
    # judged. A fetch or read that fails is one refusal, never a partial read.
    policy = changes = problem = base_sha = head_contains_base = None
    stamp_changes = {}
    number = int(view.get("number") or pr)
    carried: dict = {}   # role -> the commit whose APPROVE carried, for the diagnostic below
    if not (KNOWLEDGE_ROOT / ".git").exists():
        problem = f"{KNOWLEDGE_ROOT} is not a git checkout"
    else:
        fetched = library.fetch_main(KNOWLEDGE_ROOT)
        if fetched.returncode == 0:
            fetched = library.fetch_pr_head(KNOWLEDGE_ROOT, number)
        if fetched.returncode != 0:
            problem = f"could not fetch ({fetched.stderr.strip()})"
        try:
            if problem is None:
                policy, changes, base_sha, head_contains_base = KM.read_git_facts(
                    KNOWLEDGE_ROOT, number, head_after)
                stamp_changes = KM.read_stamp_changes(KNOWLEDGE_ROOT, base_sha, stamps)
            # The carry attempt (platform/decisions/0078's 2026-10-09 amendment):
            # tried only when the gate itself did not already pass, only when
            # `review-status` decided from comment stamps rather than checks
            # (`not from_checks` — the carry is defined over an APPROVE stamp,
            # and `_review_status_from_checks` produces none to carry), and
            # only once every OTHER reason it gave (CI, draft, mergeability —
            # none of them fixable by carrying a stamp) is confirmed absent by
            # recomputing the SAME per-role decision with CI forced green, so
            # the only difference between the two calls is the role check
            # itself. `review-status` is never told to report anything
            # different; this is read-only.
            if problem is None and not review_ok and head_after and not from_checks:
                plain = RP.evaluate_gate(head=head_after, stamps=stamps,
                                         required_agents=list(KM.REVIEW_ROLES),
                                         ci_green=True)
                other = [r for r in review_reasons if r not in plain.reasons]
                if not other:
                    blocked = []
                    for role in KM.REVIEW_ROLES:
                        if role in plain.approvals:
                            continue
                        candidates = [s for s in stamps if RP._review_base(s.agent) == role]
                        commit, why_not = KM.carry_for_role(
                            KNOWLEDGE_ROOT, candidates, head_after, base_sha)
                        if commit is None:
                            blocked.append(f"no carried APPROVE from {role}: {why_not}")
                        else:
                            carried[role] = commit
                    if not blocked:
                        review_ok = True
                        review_reasons = []
                    else:
                        review_reasons = other + blocked
                else:
                    # `other` already refuses regardless of any carry (CI, draft,
                    # mergeability — none fixable by carrying a stamp), so the
                    # attempt above never runs and `KM.carry_for_role` never looks
                    # at these roles' stamps. A "stale" line in `review_reasons` was
                    # produced by `review-status`'s own per-role check, which knows
                    # nothing of carrying, and reads as a settled "re-review needed"
                    # refusal rather than the "not checked yet" it actually is
                    # (agent-platform#857: a `--dry-run` read it that way while CI
                    # was still pending at a head whose carry, once CI went green,
                    # in fact held). Rewrite each such line in place rather than
                    # evaluate the carry here — evaluating it would mean running
                    # `KM.carry_for_role`'s git reads on roles `other` has already
                    # made moot, for a result this command would then discard.
                    for role in KM.REVIEW_ROLES:
                        if role in plain.approvals:
                            continue
                        candidates = [s for s in stamps if RP._review_base(s.agent) == role]
                        latest = candidates[-1] if candidates else None
                        if latest is None or latest.verdict != "APPROVE":
                            continue
                        stale_line = (
                            f"{role} APPROVE is stale — reviewed "
                            f"{latest.reviewed_commit or '?'}, head is "
                            f"{head_after or '?'} (re-review needed)")
                        if stale_line in review_reasons:
                            review_reasons = [
                                (f"{role}'s APPROVE reviewed "
                                 f"{latest.reviewed_commit or '?'} not yet evaluated "
                                 f"for carry while another reason refuses "
                                 f"regardless: {'; '.join(other)}") if r == stale_line
                                else r
                                for r in review_reasons]
        except KM.Unreadable as e:
            problem = str(e)
        finally:
            # The fetched head is read, so the ref goes; objects wait for git's own gc.
            _kb_git_at(KNOWLEDGE_ROOT, "update-ref", "-d", KM.pr_ref(number))

    facts = KM.Facts(
        repo=repo, number=number, state=view.get("state") or "",
        head_ref=view.get("headRefName") or "", base_ref=view.get("baseRefName") or "",
        cross_repo=bool(view.get("isCrossRepository")), head_sha=head_after,
        body=view.get("body") or "", commits=commits, stamps=stamps,
        review_ok=review_ok, review_reasons=review_reasons, gate_head=head,
        companions=companions,
        author=author, policy=policy, changes=changes, git_problem=problem,
        base_sha=base_sha, head_contains_base=head_contains_base,
        stamp_changes=stamp_changes)
    return facts, head, carried


def _kb_merge_write_token(config) -> "tuple[str | None, str | None]":
    """A fresh installation token scoped to the configured repository, with
    `contents: write` and `pull_requests: write` — the same mint the merge
    call itself makes, shared here so a rebuild and the merge that follows it
    spend one mint rather than two. `(token, None)`, or `(None, problem)`
    naming the stage that failed."""
    import kb_merge as KM  # noqa: PLC0415
    problem = KM.key_problem(config.key_path)
    if problem:
        return None, problem
    try:
        jwt = KM.app_jwt(config.key_path, config.app_id)
        inst = KM.knowledge_installation(jwt, owner=config.owner, repo=config.repo)
        token = KM.installation_token(jwt, inst, repo=config.repo)
    except KM.Unreadable as e:
        return None, str(e)
    return token, None


def _kb_merge_rebuild(repo: str, pr: str, facts, config, token: str
                      ) -> "tuple[str | None, str | None]":
    """Attempt the platform/decisions/0078 (2026-10-10 amendment) rebuild of
    `facts`'s branch onto `facts.base_sha`. `(new_head_sha, None)` on
    success, or `(None, reason)` — never partial: the branch's ref moves
    only once the new commit exists on GitHub and the PR's head has just
    been re-read and confirmed unmoved, so a proposer's concurrent push is
    never overwritten.
    """
    import kb_merge as KM  # noqa: PLC0415
    try:
        blocked = KM.rebuild_blocked(KNOWLEDGE_ROOT, facts.head_sha, facts.base_sha)
        if blocked is not None:
            return None, f"cannot rebuild onto {KM.BASE}: {blocked}"
        entries = KM.rebuild_tree_entries(KNOWLEDGE_ROOT, facts.head_sha, facts.base_sha)
        base_tree = KM.tree_sha_at(KNOWLEDGE_ROOT, facts.base_sha)
        message = KM.rebuild_message(KNOWLEDGE_ROOT, facts.commits or [], facts.head_sha)
    except KM.Unreadable as e:
        return None, f"cannot rebuild onto {KM.BASE}: {e}"
    try:
        new_tree = KM.create_tree(token, base_tree, entries, repo=config.repo)
        new_commit = KM.create_commit(token, message, new_tree, facts.base_sha,
                                      repo=config.repo)
    except KM.Unreadable as e:
        return None, f"could not build the rebuilt commit: {e}"
    # Re-read the PR's head right before moving the branch, so a push that
    # landed while the commit above was being built is never overwritten.
    try:
        current = (_gh_pr_json(pr, ["headRefOid"], repo=repo).get("headRefOid") or "").strip()
    except (RuntimeError, json.JSONDecodeError) as e:
        return None, f"could not re-read {repo}#{pr}'s head before updating the branch: {e}"
    if current != facts.head_sha:
        return None, (f"{repo}#{pr}'s head moved to {(current or '?')[:12]} while "
                      f"the rebuilt commit was being built; not updating the branch")
    try:
        KM.update_branch_ref(token, facts.head_ref, new_commit, repo=config.repo)
    except KM.Unreadable as e:
        return None, f"could not update {facts.head_ref}: {e}"
    return new_commit, None


class _HeadCatchupProblem(NamedTuple):
    """Why `_kb_merge_await_head_catchup` is not reporting `new_sha` as the
    PR's head yet. `retryable` is true only when the bound ran out while the
    head still read `old_sha`, the pre-rebuild commit — GitHub's pull-request
    API can lag a force-push that has already landed by a few seconds
    (agent-platform#853's first live rebuild on knowledge#852: `git
    ls-remote` and a `gh pr view` moments later both already read the
    rebuilt sha, while the read this function makes had not caught up yet),
    so a caller may retry once that passes. `retryable` is false when the
    head reads a THIRD sha — neither `old_sha` nor `new_sha` — since that is
    some other, concurrent move of the branch, not API lag, and waiting
    longer will not fix it."""
    message: str
    retryable: bool


def _kb_merge_await_head_catchup(repo: str, pr: str, old_sha: str, new_sha: str, *,
                                 timeout: float, poll: float = None
                                 ) -> "_HeadCatchupProblem | None":
    """Poll `repo#pr`'s `headRefOid` — the same read
    `_kb_merge_required_check_conclusions` trusts — until it reports
    `new_sha`, the sha a rebuild just force-pushed. `None` once it does.

    Reading `old_sha` during the wait means "not caught up yet" and is
    retried until `timeout`; reading anything else refuses at once, since a
    third sha means something other than API lag moved the branch and more
    polling cannot fix that. This is the fix for agent-platform#853's first
    live rebuild, which refused its own freshly-pushed head because this
    exact read still returned the pre-rebuild sha for a few seconds.

    `poll` defaults to `KB_MERGE_HEAD_CATCHUP_POLL_SECS` resolved AT CALL
    TIME, not as the parameter's own default value — that constant is
    defined later in this file than this function, so binding it at `def`
    time would raise `NameError` the moment the module loads."""
    poll = KB_MERGE_HEAD_CATCHUP_POLL_SECS if poll is None else poll
    deadline = time.monotonic() + timeout
    while True:
        try:
            current = (_gh_pr_json(pr, ["headRefOid"], repo=repo).get("headRefOid") or "").strip()
        except (RuntimeError, json.JSONDecodeError) as e:
            return _HeadCatchupProblem(
                message=f"could not read {repo}#{pr}'s head while waiting for it "
                        f"to catch up: {e}",
                retryable=False)
        if current == new_sha:
            return None
        if current != old_sha:
            return _HeadCatchupProblem(
                message=(f"{repo}#{pr}'s head is now {(current or '?')[:12]}, "
                         f"neither the pre-rebuild {old_sha[:12]} nor the rebuilt "
                         f"{new_sha[:12]} — something else moved the branch"),
                retryable=False)
        if time.monotonic() >= deadline:
            return _HeadCatchupProblem(
                message=(f"{repo}#{pr}'s head still reads the pre-rebuild "
                         f"{old_sha[:12]}, not yet the rebuilt {new_sha[:12]}, "
                         f"after {timeout:.0f}s"),
                retryable=True)
        time.sleep(poll)


def _kb_merge_required_check_conclusions(repo: str, pr: str, sha: str, *,
                                         old_sha: str = None
                                         ) -> "dict | str":
    """Each of `kb_merge.REBUILD_REQUIRED_CHECKS`'s conclusion on `sha`, read
    through the same GraphQL `statusCheckRollup` + workflow-file-path keying
    the merge gate itself trusts (`_latest_per_check`, ARCH-380) — never
    through REST `commits/<sha>/check-runs` matched by name alone, which
    carries no workflow association and so cannot tell the real `validate`
    from a same-named check-run an injected workflow or a different app
    posted (round 2 security finding, agent-platform#853: the #182 bypass
    ARCH-380 closed, reopened one level down in this rebuild gate).

    Returns `{name: conclusion-or-None}` on success: a name with no
    correctly-keyed check-run at all, and one whose conclusion is still
    empty (still running), both map to `None`, exactly as before — the
    caller waits on every value being a non-empty string, never on none of
    them being `None`. The same all-`None` shape is returned, rather than a
    refusal, when `current` reads `old_sha` — the PR API's `headRefOid` can
    still lag a few seconds behind a force-push that has already landed
    (agent-platform#853's first live rebuild, knowledge#852), and a caller
    passing `old_sha` is asking this to treat that lag the same way it
    treats a check that hasn't posted yet: worth polling again, not a
    refusal. Pass `old_sha=None` (the default) when the caller has no such
    sha to compare against, or wants any mismatch treated as a hard refusal.

    Returns a `str` refusal reason, never a dict, when the rollup cannot be
    trusted at all: `repo#pr`'s current head is neither `sha` nor `old_sha`
    (so this would be judging a commit that moved out from under it for a
    reason other than API lag), or the workflow-run → path map could not be
    built at all (so no check could be verified against its required path,
    and falling back to name-only keying would restore the bypass this
    function exists to close). A caller must treat a `str` as an immediate,
    non-retryable refusal — never as "every check is still missing", which
    would poll forever against a premise that isn't going to resolve itself."""
    import kb_merge as KM  # noqa: PLC0415
    try:
        view = _gh_pr_json(pr, ["headRefOid", "statusCheckRollup"], repo=repo)
    except (RuntimeError, json.JSONDecodeError) as e:
        return f"could not read {repo}#{pr}'s checks: {e}"
    current = (view.get("headRefOid") or "").strip()
    if current != sha:
        if old_sha is not None and current == old_sha:
            return {name: None for name in KM.REBUILD_REQUIRED_CHECKS}
        return (f"{repo}#{pr}'s head is now {(current or '?')[:12]}, not the "
                f"rebuilt {sha[:12]} — refusing rather than judge the wrong "
                f"commit's checks")
    path_map = _workflow_path_map(repo, sha)
    if path_map is None:
        return (f"could not read {sha[:12]}'s workflow-run paths — refusing "
                f"rather than key its required checks by name alone")
    rollup = view.get("statusCheckRollup") or []
    found: dict[str, str] = {}
    for c in _latest_per_check(rollup, path_map):
        name = c.get("name") or c.get("context") or "?"
        wanted_path = KM.REBUILD_REQUIRED_CHECK_WORKFLOWS.get(name)
        if wanted_path is None:
            continue
        run_id = _run_id_from_details_url(c.get("detailsUrl") or "")
        actual_path = path_map.get(run_id) if run_id is not None else None
        if actual_path != wanted_path:
            continue   # not from its required workflow file — never counted
        # Lower-cased so this function's contract (and the "success" literal
        # `_kb_merge_await_required_checks` compares against) stays exactly
        # what it was when this read REST: GraphQL's CheckConclusionState
        # enum comes back upper-cased ("SUCCESS"), REST's came back lower.
        concl = (c.get("conclusion") or "").lower()
        if concl:
            found[name] = concl
    return {name: found.get(name) for name in KM.REBUILD_REQUIRED_CHECKS}


class _RequiredChecksProblem(NamedTuple):
    """Why `_kb_merge_await_required_checks` is not reporting the rebuilt
    head's required checks as passed. `retryable` is true only when they
    never settled within the timeout — the rebuilt head's checks may still
    finish, so re-running `kb merge` later could succeed. Once every one of
    them HAS concluded, `retryable` is false: a conclusion that isn't
    "success" (`failure`, `cancelled`, `timed_out`, `neutral`, `skipped`,
    `action_required`) never becomes "success" on its own, so a caller must
    never suggest retrying — and must never merge. The same `retryable=False`
    applies when `_kb_merge_required_check_conclusions` returns a refusal
    string rather than conclusions at all (the head moved again, or the
    checks could not be keyed to their required workflow path): a premise
    that unreadable, like a concluded failure, does not get better by
    polling the same question again within this call."""
    message: str
    retryable: bool


def _kb_merge_await_required_checks(repo: str, pr: str, sha: str, *, timeout: float,
                                    poll: float = None, old_sha: str = None
                                    ) -> "_RequiredChecksProblem | None":
    """Wait until every one of `kb_merge.REBUILD_REQUIRED_CHECKS` has a
    recorded conclusion on `sha`, or `timeout` seconds pass, then judge the
    rebuilt head by those conclusions. `None` only when every one of them is
    exactly "success" — a `_RequiredChecksProblem` otherwise, whether because
    a check never settled, because one settled on something other than
    "success" (knowledge#699: a rebuilt head whose `validate` failed must
    never read as passed, let alone merge), or because the rollup itself
    could not be trusted at all (agent-platform#853 round 2: `repo#pr`'s
    head moved off `sha` for a reason other than `old_sha` lag, or the
    required checks could not be keyed to their workflow path and so could
    not be verified at all).

    `old_sha`, when given, is forwarded to `_kb_merge_required_check_conclusions`
    so that a `headRefOid` still lagging behind the rebuild (agent-platform#853's
    first live rebuild) reads as "no conclusions yet" here too, exactly like a
    check that hasn't posted — never as the hard refusal a genuinely different
    third sha gets. `cmd_kb_merge` already waits out that lag with
    `_kb_merge_await_head_catchup` before calling this, so `old_sha` here is
    defense in depth against the same lag recurring mid-poll, not the primary
    fix for it.

    Waits for the PRESENCE of a conclusion, never for the ABSENCE of
    "pending": a check that never started at all would read identically to
    one still running under the latter, and the rebuilt head deserves actual
    evidence that each required check ran, not merely that none is known to
    be in flight. Presence is not success, though: once every check has
    concluded, each conclusion is read on its own merits, never treated as a
    pass merely for being non-empty.

    `poll` defaults to `CI_PENDING_POLL_SECS` resolved AT CALL TIME, not as
    the parameter's own default value — that constant is defined later in
    this file than this function, so binding it at `def` time would raise
    `NameError` the moment the module loads."""
    poll = CI_PENDING_POLL_SECS if poll is None else poll
    deadline = time.monotonic() + timeout
    while True:
        conclusions = _kb_merge_required_check_conclusions(repo, pr, sha, old_sha=old_sha)
        if isinstance(conclusions, str):
            return _RequiredChecksProblem(message=conclusions, retryable=False)
        missing = [name for name, concl in conclusions.items() if not concl]
        if not missing:
            failed = [(name, concl) for name, concl in conclusions.items()
                     if concl != "success"]
            if not failed:
                return None
            named = ", ".join(f"{name} concluded {concl!r}" for name, concl in failed)
            return _RequiredChecksProblem(
                message=f"{named} on {sha[:12]}: not every required check succeeded",
                retryable=False)
        if time.monotonic() >= deadline:
            return _RequiredChecksProblem(
                message=(f"{', '.join(missing)} still show no recorded conclusion on "
                         f"{sha[:12]} after {timeout:.0f}s"),
                retryable=True)
        time.sleep(poll)


def cmd_kb_merge(args) -> int:
    """Merge a knowledge PR the Library opened, once its review cycle passed
    (platform/decisions/0078): once an earlier APPROVE carries to its
    current, rebuilt head (the 2026-10-09 amendment under "What the Library
    may merge"), and — when the only thing wrong is that the branch no
    longer contains `main` — once this command has rebuilt the branch onto
    main itself and that rebuilt head's required checks have passed (the
    2026-10-10 amendment, issue_01M4JFSBA38N836QE0VANPCWNB).

    The conditions, and why each exists, live in lib/agent-platform/kb_merge.py.
    `_kb_merge_read` gathers the facts they read, from GitHub and from git,
    and never from the caller. When `kb_merge.refusals()` finds exactly one
    problem — the branch is stale — and `kb_merge.rebuild_worth_trying` says
    rebuilding is safe, this builds a new commit transplanting the branch's
    own changes onto the freshly fetched `main`, force-updates the branch to
    it, waits for the PR's head to catch up to that push (agent-platform#853's
    first live rebuild refused its own freshly-pushed head on exactly this
    lag), waits for its required checks, and re-reads everything from the top
    against the rebuilt head before deciding again. Never rebuilds twice in
    one invocation: if `main` moves again during that wait, this refuses and
    says so, and a second `kb merge` rebuilds again through the same path.
    `--dry-run` decides and reports without merging OR rebuilding.
    """
    import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
    if _kb_refuse_if_not_github("kb merge"):
        return 2
    try:
        config = KM.load_config()
    except KM.Unreadable as e:
        print(f"kb merge: refused — {e}", file=sys.stderr)
        return 2
    repo = args.repo or config.repo
    pr = str(args.pr)
    # The fetch is made as the App with a read-only token, so this refuses before
    # anything is read when the identity is unavailable, exactly as `kb sync` does.
    library, _ = _kb_library_git("kb merge", read_only=True)
    if library is None:
        return 2

    try:
        facts, head, carried = _kb_merge_read(repo, pr, library)
    except (RuntimeError, json.JSONDecodeError) as e:
        print(f"kb merge: refused — cannot read {repo}#{pr}: {e}", file=sys.stderr)
        return 2
    why = KM.refusals(facts, config)

    rebuilt = False
    token = None
    if why and not args.dry_run and KM.rebuild_worth_trying(facts):
        token, token_problem = _kb_merge_write_token(config)
        if token_problem:
            print(f"kb merge: cannot rebuild {repo}#{pr} — {token_problem}", file=sys.stderr)
            return 2
        rebuilt_head, rebuild_problem = _kb_merge_rebuild(repo, pr, facts, config, token)
        if rebuilt_head is None:
            why = why + [rebuild_problem]
        else:
            catchup_problem = _kb_merge_await_head_catchup(
                repo, pr, facts.head_sha, rebuilt_head, timeout=args.head_wait)
            if catchup_problem:
                if catchup_problem.retryable:
                    print(f"kb merge: {repo}#{pr} — rebuilt the branch to "
                          f"{rebuilt_head[:12]}, but {catchup_problem.message}. "
                          f"Re-run kb merge once the head catches up.", file=sys.stderr)
                else:
                    print(f"kb merge: {repo}#{pr} — rebuilt the branch to "
                          f"{rebuilt_head[:12]}, but {catchup_problem.message}; "
                          f"the branch was rebuilt and was not merged.", file=sys.stderr)
                return 1
            settle_problem = _kb_merge_await_required_checks(
                repo, pr, rebuilt_head, timeout=args.check_wait, old_sha=facts.head_sha)
            if settle_problem:
                if settle_problem.retryable:
                    print(f"kb merge: {repo}#{pr} — rebuilt the branch to "
                          f"{rebuilt_head[:12]}, but {settle_problem.message}. "
                          f"Re-run kb merge once the checks finish.", file=sys.stderr)
                else:
                    print(f"kb merge: {repo}#{pr} — rebuilt the branch to "
                          f"{rebuilt_head[:12]}, but {settle_problem.message}; "
                          f"the branch was rebuilt and was not merged.", file=sys.stderr)
                return 1
            try:
                facts, head, carried = _kb_merge_read(repo, pr, library)
            except (RuntimeError, json.JSONDecodeError) as e:
                print(f"kb merge: refused — cannot read {repo}#{pr} after rebuilding: {e}",
                      file=sys.stderr)
                return 2
            if facts.head_sha != rebuilt_head:
                print(f"kb merge: refused — {repo}#{pr}'s head moved to "
                      f"{facts.head_sha[:12]} after the rebuild to {rebuilt_head[:12]}; "
                      f"re-run kb merge.", file=sys.stderr)
                return 1
            why = KM.refusals(facts, config)
            if why and facts.head_contains_base is False:
                print(f"kb merge: refused — {repo}#{pr} at {facts.head_sha[:12]}:",
                      file=sys.stderr)
                for w in why:
                    print(f"  - {w}", file=sys.stderr)
                print(f"kb merge: {KM.BASE} moved again while waiting for the rebuilt "
                      f"head's checks; not rebuilding twice in one run. Re-run kb merge.",
                      file=sys.stderr)
                return 1
            rebuilt = True

    if why:
        print(f"kb merge: refused — {repo}#{pr} at {head[:12] or '?'}:")
        for w in why:
            print(f"  - {w}")
        return 1
    for role, commit in sorted(carried.items()):
        print(f"kb merge: {repo}#{pr} — {role}'s APPROVE at {commit[:12]} carries to "
              f"{facts.head_sha[:12]} (platform/decisions/0078)")
    if rebuilt:
        print(f"kb merge: {repo}#{pr} — rebuilt the branch onto {KM.BASE} at "
              f"{facts.head_sha[:12]}; its required checks passed "
              f"(platform/decisions/0078)")
    if args.dry_run:
        print(f"kb merge: {repo}#{pr} at {head[:12]} — every condition holds. "
              f"--dry-run, so nothing was merged.")
        return 0

    if token is None:
        # The installation is derived and checked (the configured repository
        # alone) before any merge token exists, and the token is minted for
        # that installation.
        token, problem = _kb_merge_write_token(config)
        if problem:
            print(f"kb merge: cannot merge {repo}#{pr} — {problem}", file=sys.stderr)
            return 2
    ok, msg = KM.merge_pr(facts.number, facts.head_sha, token, repo=config.repo)
    print(f"kb merge: {repo}#{pr} — {msg}", file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_docs_merge(args) -> int:
    """Merge a reviewed documentation-only PR when the adopter's policy
    (`agents_may_merge_documents`) allows it (issue_01M3SGQ4QTQ8FB0DN0X9G54ZXP)
    — any repository of the install, not `agentctl kb merge`'s knowledge
    repository alone.

    The conditions, and why each exists, live in
    lib/agent-platform/docs_merge.py. This gathers the facts they read: the
    PR's state and head, the agent policy at the knowledge repo's freshly
    fetched origin/main (via `_kb_library_git`'s read-only identity, the same
    path `kb merge` already uses), the changed files diffed in the TARGET
    repository's own primary checkout, and `review-status`'s PASS/FAIL
    decision computed in-process via `_review_status_decision` — never by
    running `review-status` as a subprocess and parsing its output.
    `--dry-run` decides and reports without merging.
    """
    import docs_merge as DM  # noqa: PLC0415 — lazy, like the other kb helpers
    import kb_merge as KM  # noqa: PLC0415
    repo = args.repo
    pr = str(args.pr)
    number = args.pr

    try:
        config: "DM.DocsMergeConfig | None" = DM.load_config()
        config_error = None
    except DM.Unreadable as e:
        config, config_error = None, str(e)

    # The policy is read through the same identity `kb merge` already uses to
    # read the knowledge repo — a read-only Library App token, or plain git
    # on a local (no-GitHub) knowledge origin. A refused identity or a failed
    # fetch leaves `policy` None, which `refusals()` reports as "not read".
    policy = None
    library, _ = _kb_library_git("docs merge", read_only=True)
    if library is not None:
        fetched = library.fetch_main(KNOWLEDGE_ROOT)
        if fetched.returncode == 0:
            policy = DM.read_policy(KNOWLEDGE_ROOT)

    try:
        view = _gh_pr_json(pr, ["number", "state", "headRefOid", "baseRefName",
                                "isCrossRepository"], repo=repo)
        state = view.get("state") or ""
        head = (view.get("headRefOid") or "").strip()
        base_ref = view.get("baseRefName") or ""
        cross_repo = bool(view.get("isCrossRepository"))
        read_error = None
    except (RuntimeError, json.JSONDecodeError) as e:
        state, head, base_ref, cross_repo, read_error = "", "", "", False, str(e)

    # `--repo` names a local filesystem path (`DM.repo_root`) before
    # `refusals()` ever checks it against `config.repos` — checked here,
    # against the shape and the config, before that path is derived or any
    # checkout is touched, so `--repo x/..` or a repo the config does not
    # name never reaches `repo_root()`, `git fetch` or `git diff`.
    repo_allowed = (DM.valid_repo_shape(repo) and config is not None
                    and repo.lower() in {r.lower() for r in config.repos})

    # The changed files come from the TARGET repository's own primary
    # checkout, fetched fresh (ambient credentials — see docs_merge.py's
    # module docstring for why this read differs from the policy read
    # above), diffed against the head just read. A fetch or read that fails
    # is one refusal, never a partial read.
    changes = git_problem = None
    if head and repo_allowed:
        root = DM.repo_root(repo)
        if not (root / ".git").exists():
            git_problem = f"{root} is not a git checkout"
        else:
            git_problem = DM.fetch_pr_and_main(root, number)
            if git_problem is None:
                try:
                    changes = DM.read_changes(root, number, head)
                except DM.Unreadable as e:
                    git_problem = str(e)
            DM.drop_pr_ref(root, number)

    # review-status's PASS/FAIL decision, computed in-process — the structured
    # result `cmd_review_status` itself prints, read directly rather than
    # parsed from a subprocess's stdout.
    review = _review_status_decision(pr, repo, list(KM.REVIEW_ROLES),
                                     allow_unverified=False, ignore_ci=False)

    facts = DM.Facts(
        repo=repo, number=number, state=state, head_at_diff=head,
        head_at_review=review.head, base_ref=base_ref, cross_repo=cross_repo,
        review_ok=review.ok, review_reasons=review.reasons, stamps=review.stamps,
        policy=policy, changes=changes, git_problem=git_problem,
        read_error=read_error or review.read_error)
    why = DM.refusals(facts, config, config_error)
    if why:
        print(f"docs merge: refused — {repo}#{pr} at {head[:12] or '?'}:")
        for w in why:
            print(f"  - {w}")
        return 1

    if args.dry_run:
        print(f"docs merge: {repo}#{pr} at {head[:12]} — every condition holds. "
              f"--dry-run, so nothing was merged.")
        return 0

    problem = DM.key_problem(config.key_path)
    if problem:
        print(f"docs merge: cannot merge {repo}#{pr} — {problem}", file=sys.stderr)
        return 2
    try:
        jwt = DM.app_jwt(config.key_path, config.app_id)
        inst = DM.installation_for(jwt, config)
        token = DM.merge_token(jwt, inst, repo)
    except DM.Unreadable as e:
        print(f"docs merge: cannot merge {repo}#{pr} — {e}", file=sys.stderr)
        return 2
    ok, msg = DM.merge_pr(number, head, token, repo)
    print(f"docs merge: {repo}#{pr} — {msg}", file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


# The most stdin `--provenance person` will read. A real Access assertion is
# about 1 KB and a Deck signature's JSON (a PEM certificate plus a base64
# signature) is a couple more; the cap keeps a runaway pipe from filling memory.
KB_PERSON_MAX_STDIN = 16 * 1024


def _kb_person_from_stdin(kbw, *, edits_requested: bool
                          ) -> tuple[str | None, str, object | None]:
    """The verified email behind a `--provenance person` write, or
    `(None, reason, None)`.

    Two proofs share stdin, told apart by its first non-whitespace byte
    (library-protocol.md §2.2): a Cloudflare Access JWT (never `{`), verified
    and returned as `(email, "", None)`; or a Deck-signature JSON object
    (always `{`), whose certificate and timing check out here but whose
    SIGNATURE cannot verify yet — it covers the write's own canonical path and
    final bytes, neither known until after the cage worktree is open and the
    edit is applied. For that case this returns `(None, "", pending)`, where
    `pending(document, base_sha, content_sha256)` is deck_signature.verify's
    phase 2, to be called once those three are final; `person` stays
    unconfirmed (and every journal call keeps recording `author_kind='agent'`)
    until it returns an email.

    The assertion arrives on stdin and nowhere else: argv is visible in `ps` to
    every process on the machine, and a temp file would leave a live bearer
    credential or a signing certificate on disk for the length of a save. A
    terminal on stdin is refused rather than waited on, so a hand-typed call
    fails instead of hanging.

    The reasons are fixed codes, never the token, the certificate, or the
    claimed email.

    Assumes `venv_bootstrap.ensure(requires=("cryptography",))` has already
    run: `cmd_kb_apply`, this function's only caller, runs it as its own first
    action, before this reads stdin at all. Doing that bootstrap HERE used to
    mean it ran only after `sys.stdin.read()` already drained the pipe, so the
    re-exec `ensure` triggers restarts the process onto an empty stdin and the
    Deck signature this was meant to verify is gone (round-2 review, PR 695).
    """
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return None, "no-assertion", None
        token = sys.stdin.read(KB_PERSON_MAX_STDIN + 1).strip()
    except (OSError, ValueError):
        return None, "no-assertion", None
    if not token:
        return None, "no-assertion", None
    if len(token) > KB_PERSON_MAX_STDIN:
        return None, "assertion-too-large", None
    if token.startswith("{"):
        import deck_signature as ds  # noqa: PLC0415 — lazy, like the other kb helpers
        pending, reason = ds.verify(token, edits_requested=edits_requested)
        if pending is None:
            return None, reason, None
        return None, "", pending
    import access_assertion as aa  # noqa: PLC0415 — lazy, like the other kb helpers
    ok, claims, reason = aa.verify(token)
    if not ok:
        return None, reason, None
    email = claims.get("email")
    if not isinstance(email, str):
        return None, "no-email", None
    email = email.strip().lower()
    if (not email or len(email) > kbw.MAX_PERSON_LEN
            or any(c.isspace() for c in email)):
        return None, "bad-email", None
    if email not in aa.config()["persons"]:
        return None, "not-in-persons", None
    return email, "", None


def cmd_kb_apply(args) -> int:
    """Write a doc through the cage: sha-gated, policy-gated, validated, reindexed.

    The ordering here is the whole safety argument, so it is worth stating.
    `_scribe_worktree()` takes the write lock FIRST and resets a dedicated
    worktree to fresh `origin/main`. Only then is the base-sha compared. That
    means the precondition is checked against the same tree the commit will be
    built from, with no window in between for another writer to land — a check
    against the shared checkout, or before the lock, would be a race dressed up
    as a guarantee.

    A write over SOMEONE ELSE'S live lease is refused with exit 3, `leased`
    (operator, 2026-09-11: "The Library shouldn't go around changing docs other crews
    have checked out to work on"). It used to be a warning, on the reasoning
    that the sha precondition protects the content. The sha stops a lost update;
    it does not stop a second session rewriting a document its holder is midway
    through, which is the disruption the rule names. A write with no lease on
    the document at all is still accepted here: the base sha still comes from
    `kb checkout`, which takes one.
    """
    # First action, before the holder or the message is even validated, and
    # above all before `--provenance person` reads its assertion off stdin
    # below. `venv_bootstrap.ensure`'s re-exec (`os.execv`) restarts this
    # process with the same stdin file descriptor, at whatever position a
    # prior read left it — a pipe already drained does not rewind, so a
    # bootstrap that runs AFTER that read hands the restarted process EOF
    # instead of the Deck signature or Access token it was sent, and `kb
    # apply --provenance person` refuses as `no-assertion` having verified
    # nothing (round-2 review, PR 695). `yaml` is `_kb_indexer`'s, for the
    # validate-before-write and reindex steps below; `cryptography` is
    # `deck_signature`'s, for the Deck-signature branch of
    # `_kb_person_from_stdin`.
    venv_bootstrap.ensure(__file__, requires=("yaml", "cryptography"))
    kbw = _kb_writes()
    holder = _kb_holder(args.holder)
    provenance = args.provenance

    # The verified email, once the Access assertion or the Deck signature below
    # confirms one — None until then and for every provenance but `person`.
    # Read by `_apply_journal` so every journal call in this function records
    # `author_kind='person'` from the moment verification succeeds and `'agent'`
    # before it and always otherwise; nothing here parses `provenance` to
    # decide, and no call in this function can pass `journal_person` an
    # unverified value.
    person: str | None = None

    def _apply_journal(ref: str, result: str, detail: str | None = None) -> None:
        if person:
            kbw.journal_person("apply", person=person, source_ref=ref, holder=holder,
                                provenance=provenance, result=result, detail=detail)
        else:
            kbw.journal("apply", source_ref=ref, holder=holder,
                        provenance=provenance, result=result, detail=detail)

    # The audit surface must not be corruptible by the thing it audits. A holder
    # carrying a newline, or a message carrying its own `KB-Write:` line, plants
    # a second trailer that the bypass audit would read in place of the real one.
    if not kbw.valid_holder(holder):
        print(f"kb apply: refused — holder {holder!r} is not a valid identity "
              f"(letters, digits, and : . _ - only, max 64).", file=sys.stderr)
        return 1
    if not kbw.message_is_trailer_safe(args.message):
        print("kb apply: refused — the commit message contains a `KB-Write:` or "
              "`KB-Person:` line, which would forge the audit trailer.", file=sys.stderr)
        return 1

    source_ref, err = _kb_resolve_ref(args.doc)
    if err:
        print(f"kb apply: {err}", file=sys.stderr)
        return 1

    if any(c.isspace() for c in source_ref):
        # Refused here rather than left to raise out of `write_trailer`: the
        # trailer is four space-separated fields, so such a path would produce a
        # line the audit scanner misparses. A clean refusal beats an unhandled
        # exception, and the KB's own id convention has no whitespace anyway.
        print(f"kb apply: refused — {source_ref!r} contains whitespace, which cannot be "
              f"recorded unambiguously in the KB-Write audit trailer.", file=sys.stderr)
        return 1

    # Policy before any git work: a refusal here costs nothing and the caller
    # gets the same answer whether or not the repo is reachable.
    allowed, why = kbw.policy_for(source_ref, provenance)
    if not allowed:
        print(f"kb apply: refused — {why}", file=sys.stderr)
        _apply_journal(source_ref, "refused-policy", why)
        return 4

    # `person` is honoured only on evidence: an Access assertion or a Deck
    # signature on stdin that verifies. Any failure is exit 8, and nothing is
    # written under another provenance, since this function only ever carries
    # the one it was given. Placed after the policy check so a guarded path
    # still refuses at exit 4 without reading stdin, and before any git work
    # so a refusal costs nothing. `pending_signature` is set only for a Deck
    # signature whose certificate checks out but whose actual SIGNATURE is
    # unverified until the canonical path and final bytes exist — see
    # `_kb_person_from_stdin`.
    pending_signature = None
    if provenance == "person":
        person, reason, pending_signature = _kb_person_from_stdin(
            kbw, edits_requested=bool(args.edits or args.edits_file))
        if person is None and pending_signature is None:
            print(f"kb apply: refused — provenance 'person' needs a valid Cloudflare "
                  f"Access assertion or Deck signature on stdin ({reason}). Nothing "
                  f"was written.", file=sys.stderr)
            _apply_journal(source_ref, "refused-assertion", reason)
            return 8

    # The indexer serves nothing outside `projects/*.md`, so a write anywhere
    # else reports success for a document no agent can ever retrieve — every
    # check passes and nothing serves it. Refused here, before any git work,
    # from the indexer's OWN predicate so the cage and the index cannot drift
    # about what is retrievable. The trap that makes the mistake easy is the
    # argument name: `id` takes a PATH, and the two differ by the `projects/`
    # prefix, so a caller who passes the frontmatter id as if it were the path
    # gets this refusal with the corrected path.
    if not _kb_indexer().is_indexable_rel(source_ref):
        print(f"kb apply: refused — {source_ref!r} is not a path the indexer will "
              f"index (a .md document under projects/), so the write would land a "
              f"file nothing ever retrieves. The argument is named `id` but takes "
              f"a PATH. Did you mean {_kb_indexable_hint(source_ref)!r}?", file=sys.stderr)
        return 1

    edits, new_body, err = _kb_read_change(
        args.edits, args.content, args.content_file, args.edits_file)
    if err:
        print(f"kb apply: {err}", file=sys.stderr)
        return 1

    if _kb_refuse_foreign_lease(kbw, "apply", source_ref, holder,
                                provenance=provenance):
        return 3

    # THE APP IDENTITY IS OBTAINED BEFORE THE LOCK, because the fetch that opens
    # `_scribe_worktree` is made as the App. It used to be obtained after the
    # validation and before the commit, so that a refusal left nothing to reset;
    # this is earlier and keeps that property, since nothing has been taken or
    # written yet: no lock, no cage state, no file. A refusal is exit 2, as
    # `kb merge`'s is. It also means `--no-push` and `--dry-run` need the
    # identity, for the fetch alone.
    library, why = _kb_library_git("kb apply")
    if library is None:
        _apply_journal(source_ref, "no-identity", why)
        return 2

    kroot, err = _scribe_worktree(library)   # takes the lock; resets to origin/main
    if err:
        print(f"kb apply: {err}", file=sys.stderr)
        _apply_journal(source_ref, "error", err)
        return 1

    target = kroot / source_ref
    resolved = target.resolve()
    # Resolved ONCE and reused. Calling it twice would leave a theoretical window
    # where the two checks disagree if the cage path were itself a symlink whose
    # target moved between them (security review, round 2).
    kroot_resolved = kroot.resolve()
    if kroot_resolved not in resolved.parents:
        print(f"kb apply: refused — {source_ref} resolves outside the knowledge root",
              file=sys.stderr)
        return 1

    # Re-run the policy on the CANONICAL path, now that one exists. The check
    # above ran on the caller's string, which is the right place to refuse
    # cheaply; this one runs on what git will actually stage, which is the only
    # thing that is authoritative. Symlinks, `..` segments and filesystem case
    # folding are all invisible to a string match and all visible here.
    canonical_ref = str(resolved.relative_to(kroot_resolved))

    # A signed save names its file by its canonical path (library-protocol.md
    # §2.2): a symlink or a `..` segment cannot carry a signed write to a file
    # the person did not name. Checked only for a Deck signature — the Access
    # path has no such envelope field to hold the write to a single path.
    if pending_signature is not None and source_ref != canonical_ref:
        print(f"kb apply: refused — a Deck signature names {source_ref}, which "
              f"resolves to {canonical_ref}; a signed save may not be redirected "
              f"by a symlink or a `..` segment. Nothing was written.", file=sys.stderr)
        _apply_journal(canonical_ref, "refused-assertion",
                       f"path-not-canonical; requested as {source_ref}")
        return 8

    allowed, why = kbw.policy_for(canonical_ref, provenance)
    if not allowed:
        print(f"kb apply: refused — {source_ref} resolves to {canonical_ref}, and {why}",
              file=sys.stderr)
        _apply_journal(canonical_ref, "refused-policy",
                       f"canonical path check; requested as {source_ref}")
        return 4

    # The indexer-shape rule has the same string-vs-filesystem gap the policy
    # re-check above just closed: it ran on the caller's string, but a symlink
    # committed in the checkout can make a `projects/*.md`-shaped path resolve to
    # a real file the indexer will not serve. Only the resolved path is
    # authoritative, so re-check the shape on it (the #243 pattern, applied to
    # this PR's rule).
    if not _kb_indexer().is_indexable_rel(canonical_ref):
        print(f"kb apply: refused — {source_ref} resolves to {canonical_ref}, which the "
              f"indexer will not index (a .md document under projects/), so the write "
              f"would land a file nothing ever retrieves.", file=sys.stderr)
        return 1

    prior = target.read_text() if target.is_file() else None
    current_sha = kbw.content_sha(prior if prior is not None else "")

    if args.base_sha != current_sha:
        # The lost-update guard. The caller edited version X; main now holds Y.
        # Refuse and hand back the current sha so the caller can re-read, merge
        # semantically, and retry — resolving it at the CONTENT level rather
        # than letting git silently serialize two divergent intents.
        print(f"kb apply: refused — stale base. You wrote against {args.base_sha[:12]}, "
              f"origin/main holds {current_sha[:12]}. Re-checkout, merge your change "
              f"into the current content, and retry.", file=sys.stderr)
        _apply_journal(source_ref, "stale",
                       f"base={args.base_sha[:12]} current={current_sha[:12]}")
        return 5

    new_content, err = _kb_apply_edits(prior, edits, new_body,
                                       allow_overwrite=args.allow_overwrite)
    if err:
        print(f"kb apply: refused — {err}", file=sys.stderr)
        _apply_journal(source_ref, "bad-change", err)
        return 1

    # Phase 2 of the Deck signature: the envelope is built from exactly what is
    # about to be written — the canonical path, the base this write is held to,
    # and the sha256 of `new_content` itself, never a value the request
    # claimed. A signature over another document, an older base, or different
    # bytes fails to verify against this envelope rather than against a
    # separate check for each; only once it verifies is the registry asked.
    if pending_signature is not None:
        person, reason = pending_signature(canonical_ref, args.base_sha,
                                           kbw.content_sha(new_content))
        if person is None:
            print(f"kb apply: refused — the Deck signature on stdin did not verify "
                  f"({reason}). Nothing was written.", file=sys.stderr)
            _apply_journal(source_ref, "refused-assertion", reason)
            return 8

    if new_content == (prior or ""):
        print(f"kb apply: no change — {source_ref} already has this content.")
        _apply_journal(source_ref, "no-op")
        return 0

    before = _kb_errors(kroot)
    made_dirs = []
    d = target.parent
    while not d.exists() and kroot in d.parents:
        made_dirs.append(d)
        d = d.parent
    target.parent.mkdir(parents=True, exist_ok=True)

    def _restore():
        if prior is None:
            target.unlink(missing_ok=True)
        else:
            target.write_text(prior)
        for made in made_dirs:
            try:
                made.rmdir()
            except OSError:
                break

    target.write_text(new_content)

    introduced = _kb_new_errors(before, _kb_errors(kroot))
    if introduced is not None:
        _restore()
        print(f"kb apply: refused — this write introduces KB validation errors, so it "
              f"would red knowledge CI. Working tree restored.\n{introduced}", file=sys.stderr)
        _apply_journal(source_ref, "invalid", introduced)
        return 6
    # validate.py passing is not the indexer accepting. It only WARNS on some
    # conditions the indexer treats as errors (an audience value outside the
    # roster, on purpose, so a roster addition cannot false-fail CI), and the
    # indexer then drops the row. On 2026-09-12 that let a kb_create report
    # "created" for a decision every agent then could not see. So the indexer's
    # own check runs too, before anything is committed.
    dropped = _kb_indexer_errors(source_ref, new_content)
    if dropped:
        _restore()
        detail = "; ".join(dropped)
        print(f"kb apply: refused — the knowledge indexer would drop this document "
              f"({detail}), so it would reach main and be invisible to every agent. "
              f"Working tree restored.", file=sys.stderr)
        _apply_journal(source_ref, "invalid", detail)
        return 6

    if args.dry_run:
        _restore()
        print(f"kb apply: DRY-RUN ok — would write {source_ref} ({provenance}); "
              f"validator reports no new errors.")
        return 0

    head = _kb_git_at(kroot, "rev-parse", "HEAD").stdout.strip()
    upstream = _exact_origin_main(kroot)
    if upstream is None:
        _restore()
        print(_missing_origin_main("kb apply", kroot), file=sys.stderr)
        return 1
    if not head or head != upstream:
        _restore()
        print("kb apply: refused — the cage worktree is not at origin/main, so a commit "
              "here would not land on main. Treat this as a bug rather than re-running.",
              file=sys.stderr)
        return 1

    verb = "create" if prior is None else "update"
    msg = (f"docs: {verb} {source_ref}\n\n"
           f"{args.message or 'Written via `agentctl kb apply` (ARCH-408 cage).'}\n\n"
           f"{kbw.write_trailer(verb, source_ref, provenance, holder)}"
           + (f"\n{kbw.person_trailer(person)}" if person else kb_coauthor_trailer()))
    # The commit is authored and committed as the App on a GitHub origin, for
    # this invocation only: `~/.gitconfig` is the operator's and stays
    # untouched. On a non-GitHub origin `library.commit_env()` is None, so the
    # commit takes whatever identity `git` already resolves for the cage
    # worktree — the same as every write before the App identity existed, with
    # `_kb_commit` falling back to a placeholder identity only when that
    # resolves to none at all. The requesting session is the `holder` in the
    # KB-Write trailer above either way.
    r = _kb_git_at(kroot, "add", str(target), env=library.commit_env())
    if r.returncode != 0:
        print(f"kb apply: git add failed: {r.stderr.strip()}", file=sys.stderr)
        _apply_journal(source_ref, "error", r.stderr.strip())
        return 1
    r = _kb_commit(kroot, msg, library.commit_env())
    if r.returncode != 0:
        print(f"kb apply: git commit failed: {r.stderr.strip()}", file=sys.stderr)
        _apply_journal(source_ref, "error", r.stderr.strip())
        return 1

    if not args.no_push:
        r = library.push_main(kroot)
        if r.returncode != 0:
            # Origin moved between the reset and the push. The commit is local to
            # a worktree that gets hard-reset next run, so nothing is stranded —
            # the caller re-checkouts against the new head and retries.
            print(f"kb apply: push refused — origin/main advanced while this write was "
                  f"in flight. Re-checkout and retry.\n{r.stderr.strip()}", file=sys.stderr)
            _apply_journal(source_ref, "push-race")
            return 7

    _apply_journal(source_ref, "ok", verb)
    print(f"kb apply: {verb}d {source_ref} ({provenance})")

    if not args.no_push and not args.no_sync:
        # Commit and reindex as one step (ARCH-408 / #240): when this returns,
        # what was just written is what `kb_search` serves.
        idx = _kb_indexer()
        idx.ensure_db()
        library.fetch_main(KNOWLEDGE_ROOT)
        main_sha = _exact_origin_main(KNOWLEDGE_ROOT)
        if main_sha and _kb_git("merge", "--ff-only", main_sha).returncode == 0:
            res = idx.index_paths([source_ref])
            for rel, err in res["deferred"]:
                # The write is pushed, so it stays 0. The index keeps the row it had,
                # and the next `kb sync` retries the document.
                print(f"kb apply: {rel} is pushed but not indexed: {err}. The next "
                      f"`kb sync` retries it.", file=sys.stderr)
            for rel, err in res["refused"]:
                # The write is pushed, so it stays 0. A refusal holds on every pass, so
                # no retry admits it until the document changes.
                print(f"kb apply: REFUSED {rel}: {err}{idx.kept_suffix(rel)}. The write "
                      f"is pushed but not indexed.", file=sys.stderr)
        else:
            print("kb apply: wrote and pushed, but the shared checkout could not "
                  "fast-forward, so the index will catch up on the next `kb sync`.",
                  file=sys.stderr)
    return 0


def _kb_git_at(root: Path, *a, env: dict | None = None):
    return subprocess.run(["git", "-C", str(root), *a], capture_output=True, text=True,
                          env=env)


# The identity `bin/install-payload` gives the knowledge repo's first commit on
# a fresh, no-GitHub Builder install (company/decisions/0009), used below ONLY
# as a per-commit fallback — never written to any config file.
_FALLBACK_COMMIT_NAME = "Builder"
_FALLBACK_COMMIT_EMAIL = "builder@localhost"


def _kb_commit(root: Path, msg: str, env: dict | None):
    """`git commit -q -m msg` in `root`, under `env` (a kb write path's
    `library.commit_env()` — `_KbLibrary`'s App identity, or `None` for
    `_PlainGitLibrary`, which lets `git` resolve whatever identity it already
    has for `root`).

    First probes `git var GIT_AUTHOR_IDENT` in `root` under that SAME `env` —
    the exact resolution the commit is about to make. A fresh adopter account
    has no `user.name`/`user.email` anywhere (Shipwright issue on
    agent-platform fc54a97, 2026-09-28: `kb_create` failed with `git commit
    failed: Author identity unknown`), so only when that probe fails does this
    one commit fall back to a placeholder identity, applied with `-c
    user.name=`/`-c user.email=` on the commit invocation alone. Never writes
    a config file, and never reached when `env` already carries an identity —
    `_KbLibrary.commit_env()` always does (both `GIT_AUTHOR_*` and
    `GIT_COMMITTER_*`), so the App path's commits are unaffected. A user's own
    identity, from config or from `GIT_AUTHOR_NAME`/`GIT_AUTHOR_EMAIL` in
    `env`, resolves the probe first and always wins.
    """
    if _kb_git_at(root, "var", "GIT_AUTHOR_IDENT", env=env).returncode == 0:
        return _kb_git_at(root, "commit", "-q", "-m", msg, env=env)
    return _kb_git_at(root, "-c", f"user.name={_FALLBACK_COMMIT_NAME}",
                      "-c", f"user.email={_FALLBACK_COMMIT_EMAIL}",
                      "commit", "-q", "-m", msg, env=env)


def _exact_origin_main(root: Path) -> str | None:
    """The sha `refs/remotes/origin/main` holds in `root`, or None when that exact
    ref is absent. Callers act on the sha and refuse on None; see git_refs."""
    return GR.origin_main_sha(root)


def _missing_origin_main(what: str, root: Path, outcome: str = "Nothing was changed") -> str:
    return (f"{what}: refused — {GR.ORIGIN_MAIN_REF} does not exist in {root}, so there is "
            f"no main to read. {outcome}; a ref with a similar name is never "
            f"used in its place.")


class _KbLibrary:
    """`git` and `gh` as the `convivy-library` GitHub App.

    Calling it runs `git -C root args`, for every knowledge fetch and the two
    pushes, authenticated by `kb_merge.push_env` with the git token: `contents:
    write` for `kb apply` and `kb propose`, `contents: read` for `kb sync` and
    `kb checkout`, which only fetch. `.gh(root, args...)` runs `gh` with the PR
    token, for the calls that open or edit a PR. Each token travels in
    the environment of the one process it authenticates and is scrubbed from what
    comes back, because both `kb apply` and `kb propose` print git's and gh's
    stderr, and journal it on failure.
    """

    def __init__(self, git_token: str, pr_token: str | None = None):
        import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
        self._git_token, self._pr_token = git_token, pr_token
        self._git_env = KM.push_env(git_token)
        self._gh_env = KM.gh_env(pr_token) if pr_token else None

    def __call__(self, root: Path, *a):
        import kb_merge as KM  # noqa: PLC0415
        r = subprocess.run(["git", "-C", str(root), *a], capture_output=True,
                           text=True, env=self._git_env)
        r.stdout, r.stderr = (KM.scrub(r.stdout, self._git_token),
                              KM.scrub(r.stderr, self._git_token))
        return r

    def gh(self, root: Path, *a):
        import kb_merge as KM  # noqa: PLC0415
        if self._gh_env is None:
            raise RuntimeError("this identity was obtained without a PR token")
        r = subprocess.run(["gh", *a], capture_output=True, text=True,
                           cwd=str(root), env=self._gh_env)
        r.stdout, r.stderr = (KM.scrub(r.stdout, self._pr_token),
                              KM.scrub(r.stderr, self._pr_token))
        return r

    def fetch_main(self, root: Path):
        """Refresh `origin/main` in `root` from the https URL, in place of the ssh
        remote's `fetch origin main`, which authenticates as the operator."""
        import kb_merge as KM  # noqa: PLC0415
        return self(root, "fetch", "--quiet", KM.push_url(), KM.MAIN_REFSPEC)

    def fetch_pr_head(self, root: Path, number: int):
        """Fetch pull request `number`'s head into `kb_merge.pr_ref(number)`."""
        import kb_merge as KM  # noqa: PLC0415
        return self(root, "fetch", "--quiet", KM.push_url(),
                    f"+refs/pull/{number}/head:{KM.pr_ref(number)}")

    def push_main(self, root: Path):
        """Push `HEAD` to `main` as the App, over https."""
        import kb_merge as KM  # noqa: PLC0415
        return self(root, "push", "--quiet", KM.push_url(), "HEAD:main")

    def commit_env(self) -> dict:
        """The environment a commit in `root` is made under: the App, author and
        committer both (`kb_merge.commit_env`)."""
        import kb_merge as KM  # noqa: PLC0415
        return KM.commit_env()


class _PlainGitLibrary:
    """`git`, with no App identity, against `root`'s own `origin` remote.

    Used when the knowledge repo's origin is local (company/decisions/0009):
    a solo, no-GitHub install whose `origin` is a local bare repo, where the App
    — installed on `convivy/knowledge` on GitHub and nothing else — has no
    account to authenticate to. Every call is plain `git -C root ...` with the
    operator's own environment and config: no token, no `GIT_CONFIG_*`
    injection, no `gh`. Commits are authored under whatever `git` already
    resolves for `root` (`user.name`/`user.email`, from `~/.gitconfig` or the
    repo's own config) — the same identity every write carried before the App
    identity was introduced (`commit_env` returns None, so nothing overrides
    it). Same call surface as `_KbLibrary` (`fetch_main`, `push_main`,
    `commit_env`) so `_scribe_worktree` and the cage callers need not know which
    one they were handed.
    """

    def __call__(self, root: Path, *a):
        return subprocess.run(["git", "-C", str(root), *a], capture_output=True, text=True)

    def fetch_main(self, root: Path):
        import kb_merge as KM  # noqa: PLC0415
        return self(root, "fetch", "--quiet", "origin", KM.MAIN_REFSPEC)

    def push_main(self, root: Path):
        return self(root, "push", "--quiet", "origin", "HEAD:main")

    def commit_env(self) -> None:
        return None


# The one place that decides whether the knowledge repo's origin is local
# (company/decisions/0009). A `file://` URL or a bare filesystem path, in
# whatever form `git` will actually fetch from and push to once its own
# `insteadOf`/`pushurl` rewrites are applied, on EVERY URL configured for
# each side (`git remote get-url --all`) — a single non-local URL anywhere on
# either side (github.com, a different host, an unrecognised network remote)
# is not local, and goes through the App-identity path exactly as a GitHub
# origin always has. No URL at all on a side (no such remote) is local. The
# scp-like ssh syntax (`host:path`, a colon before any slash, with no
# `://`) is a network remote, not a local path, no matter the host.
_FILE_URL_RE = re.compile(r"^file://", re.IGNORECASE)


def _kb_origin_url_is_local(url: str) -> bool:
    """True when `url` (one fetch or push URL `git` already resolved for
    `origin`) names a local filesystem path or a `file://` URL rather than a
    network remote."""
    if not url:
        return True
    if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", url):
        return bool(_FILE_URL_RE.match(url))
    slash = url.find("/")
    colon = url.find(":")
    if colon != -1 and (slash == -1 or colon < slash):
        return False  # scp-like ssh syntax: host:path
    return True


def _kb_origin_urls(root: Path) -> tuple[list[str] | None, list[str] | None]:
    """`(fetch_urls, push_urls)` for `root`'s `origin` remote — EVERY URL
    `git` will actually fetch from or push to on each side, in the order
    `git` would try them, after any `pushurl` or `insteadOf`/`pushInsteadOf`
    rewrite (`git remote get-url --all`, which applies the same rewrites the
    single-URL form does). `git push origin <ref>` pushes to every
    configured pushurl, not just the first, so a side is never reduced to
    one URL here. A side with no such remote resolves to `[]` (there is
    nothing to judge). A side `git` failed to resolve for any other reason
    resolves to `None`, so a caller can tell "empty" from "unknown" and fail
    closed on the latter."""
    def _get_urls(*args: str) -> list[str] | None:
        r = subprocess.run(["git", "-C", str(root), "remote", "get-url", "--all", *args],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return [line for line in r.stdout.splitlines() if line]
        if re.search(r"no such remote", r.stderr, re.IGNORECASE):
            return []
        return None

    return _get_urls("origin"), _get_urls("--push", "origin")


def _kb_origin_is_local(root: Path) -> bool:
    """True when `root` will both fetch from and push to nothing but local
    filesystem paths or `file://` URLs, on every URL configured for either
    side.

    This is the ONE function that makes the decision (company/decisions/0009):
    every caller that needs to know whether the App identity applies reads it
    from here, never from a flag or an environment variable. It reads
    `_kb_origin_urls`, which resolves ALL of a side's URLs, not just the
    first — `git push` pushes to every configured pushurl, so an `origin`
    with a local pushurl added first and a GitHub one added second must be
    judged on the whole set, or such an origin would read as local and push
    to GitHub over plain git as the operator's own ssh identity, exactly what the App
    identity exists to prevent. Also applies a `pushurl` or an
    `insteadOf`/`pushInsteadOf` rewrite before returning — so a local-looking
    `origin` that a rewrite sends to github.com is judged by where it
    actually goes, not by its configured value. Local only when every URL on
    both sides is local; a side with no URL at all (no such remote) is
    vacuously local, so a fresh knowledge repo with no origin configured yet
    takes the plain-git branch instead of crashing. A side `_kb_origin_urls`
    could not resolve at all (a `git remote get-url` failure that was not
    "no such remote") fails closed to not-local, since an unreadable side
    could just as easily be hiding a GitHub URL as a local one.
    """
    fetch_urls, push_urls = _kb_origin_urls(root)
    if fetch_urls is None or push_urls is None:
        return False
    return (all(_kb_origin_url_is_local(u) for u in fetch_urls)
            and all(_kb_origin_url_is_local(u) for u in push_urls))


# Recognises every https and ssh form git accepts for a GitHub remote,
# case-insensitively. Used only to pick refusal wording when the App
# identity is unavailable (`_kb_library_git`) — never to decide which branch
# a caller takes; `_kb_origin_is_local` is the one decision.
_GITHUB_ORIGIN_RE = re.compile(r"^(?:https://|ssh://git@|git@)github\.com[:/]", re.IGNORECASE)


def _kb_origin_is_github(root: Path) -> bool:
    """True when any of `root`'s resolved fetch or push URLs name
    github.com."""
    fetch_urls, push_urls = _kb_origin_urls(root)
    return any(_GITHUB_ORIGIN_RE.match(u) for u in (fetch_urls or []) + (push_urls or []))


def _kb_refuse_if_not_github(who: str) -> bool:
    """True, having printed the refusal, when the knowledge repo's origin is
    local. `kb propose` opens a pull request and `kb merge` merges one — both
    GitHub-only, as company/decisions/0009 says — so on a local origin there
    is nothing for either to act on. Checked and refused before any git or
    network work, so the caller sees a message naming the real reason instead
    of the App-identity refusal a missing key would otherwise produce.
    """
    if not _kb_origin_is_local(KNOWLEDGE_ROOT):
        return False
    print(f"{who}: refused — the knowledge repo's origin is not GitHub, and "
          f"{who} needs GitHub connected.", file=sys.stderr)
    return True


def _kb_library(pull_requests: bool = False, read_only: bool = False):
    """The identity to write knowledge with, or `kb_merge.Unreadable`
    (`Unreachable` when GitHub could not be reached at all) naming the stage
    that failed. Prints nothing. `_kb_library_git` is the one that refuses;
    `kb sync` calls this directly, because an unreachable GitHub is not a
    failure for it.

    Branches on `_kb_origin_is_local(KNOWLEDGE_ROOT)`, the one place that
    decision is made. Where the origin is local, no App identity is sought at
    all — this returns a `_PlainGitLibrary` synchronously for `read_only` or a
    push, and `pull_requests` (GitHub-only, asked for by `kb propose` alone,
    which refuses before reaching here on a local origin) raises rather than
    silently reaching for the App. Where it is not local — a GitHub remote or
    any other network remote — this is exactly as it was: a `_KbLibrary`
    authenticated as the convivy-library App, and a missing or refused key
    still raises `Unreadable` here.

    `pull_requests` adds the PR token, minted beside the push token from one
    installation check. Only `kb propose` asks for it. `read_only` swaps the push
    token for a `contents: read` one, for the callers that only fetch (`kb sync`,
    `kb checkout`); it has no use for a PR token, so the two are exclusive."""
    if read_only and pull_requests:
        raise ValueError("a read-only identity carries no PR token")
    if _kb_origin_is_local(KNOWLEDGE_ROOT):
        if pull_requests:
            raise ValueError("a PR token is GitHub-only; the knowledge repo's "
                             "origin is local")
        return _PlainGitLibrary()
    import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
    if read_only:
        return _KbLibrary(KM.read_credential())
    if pull_requests:
        push, pr = KM.push_and_pr_credentials()
        return _KbLibrary(push, pr)
    return _KbLibrary(KM.push_credential())


def _kb_library_git(who: str, pull_requests: bool = False, read_only: bool = False):
    """`(library, None)`, or `(None, why)` after printing a refusal.

    On a non-local origin — GitHub or any other network remote — `library` is
    `_KbLibrary`: `git` authenticated as the `convivy-library` GitHub App for
    every knowledge fetch and push (`kb apply` to main, `kb propose` to a
    `kb/` branch), and with `pull_requests` also `gh` for that PR. All of it
    used to run as operator-at-convivy, over the ssh remote and `gh`'s stored
    login. An App token authenticates over https, so a caller names
    `KM.push_url()` in place of `origin` (`_KbLibrary.fetch_main` does for the
    fetch); the token is minted here, once, and travels only in that
    process's environment (`kb_merge.push_env` says where it lands and which
    exposure that accepts).

    THERE IS NO FALLBACK ON A NON-LOCAL ORIGIN. A missing key, an unsignable
    JWT, a widened installation or a refused mint refuses the command and
    names which; nothing here falls back to the ssh remote or to `gh`'s login
    (both are the operator). A non-GitHub network remote hits the same refusal, worded
    to say the origin is neither local nor a GitHub remote the Library can
    push to as its App, rather than reading like a missing key on an
    otherwise-valid GitHub install.

    On a local origin (company/decisions/0009), `library` is a
    `_PlainGitLibrary` instead: no App identity is sought, so this never
    refuses for that reason there. `pull_requests` is GitHub-only and the
    caller that asks for it (`kb propose`) refuses before reaching this
    function on a local origin (`_kb_refuse_if_not_github`).
    """
    import kb_merge as KM  # noqa: PLC0415 — lazy, like the other kb helpers
    try:
        return _kb_library(pull_requests=pull_requests, read_only=read_only), None
    except KM.Unreadable as e:
        if _kb_origin_is_github(KNOWLEDGE_ROOT):
            why = f"cannot obtain the convivy-library App identity — {e}"
            print(f"{who}: refused — {why}. It does not fall back to a "
                  f"personal credential.", file=sys.stderr)
        else:
            why = ("the knowledge repo's origin is neither a local repository "
                   "nor a GitHub remote the Library can push to as its App — "
                   "only those two are supported")
            print(f"{who}: refused — {why}.", file=sys.stderr)
        return None, why


def _kb_not_checked(v) -> int:
    """How many documents the verify pass did not compare: each deferred one, and each
    refused one whose row is kept. The index still serves that row, and nothing compares it."""
    return len(v["deferred"]) + len(v["refused_kept"])


def _kb_report_verify(idx, *, heal: bool, dry_run: bool,
                      quiet: bool = False, state: str = "",
                      reported=frozenset()) -> int:
    """Verify the index against the working tree; self-heal a mismatch.

    Returns 0 when the index matches (or was healed into matching), 2 when it
    does not and healing was declined or failed. 2 rather than 1 so a caller can
    tell "the index is wrong" from "the sync could not run".

    `state` opens the healthy line with how we got here. The line ends `verified` only
    when every document was compared; a deferred document, or a refused one whose row is
    kept, was not, so the line ends `partly checked`. A refused document with no row is
    compared and counted as expected absent. `quiet` drops the healthy line and the DROPPED
    lines, so a caller can silence a routine pass without silencing a failure or a heal.

    `reported` holds the documents the caller already named with an INVALID, DEFERRED or
    REFUSED line in this run, so a document gets one line per event and not two.
    """
    v = idx.verify_index()
    # One line per dropped document that no INVALID line named, whether or not the
    # index needs healing: the count below says how many were dropped and never
    # which, and a dropped document is served to nobody. Not under --quiet:
    # knowledge-autopull runs this every 600 s, and a document that stays invalid
    # would be named every cycle, where a no-op cycle writes nothing. Under
    # --quiet the sync that brought the document in already named it, on its
    # INVALID line, and `kb sync` or `--verify-only` without --quiet names every
    # one on demand.
    if not quiet:
        for rel, err in v["invalid"]:
            if rel not in reported:
                print(f"kb sync: DROPPED {rel}: {err}", file=sys.stderr)
    # A deferred document was not compared: the roster could not decide it. A refused
    # document was compared and refused on its own grounds, which holds on every pass, so
    # it gets REFUSED. Each line gives the index's own reason. Under --quiet the counts
    # alone are logged, once per cycle, because a line per document every 600 s would
    # flood the log.
    deferred = [rel for rel in v["deferred"] if rel not in reported]
    refused = [rel for rel in v["refused"] if rel not in reported]
    if not quiet:
        for rel in deferred:
            print(f"kb sync: DEFERRED {rel}: {v['deferred_reasons'][rel]}"
                  f"{idx.kept_suffix(rel)}", file=sys.stderr)
        for rel in refused:
            print(f"kb sync: REFUSED {rel}: {v['refused_reasons'][rel]}"
                  f"{idx.kept_suffix(rel)}", file=sys.stderr)
    if v["ok"]:
        not_checked = _kb_not_checked(v)
        verdict = "partly checked" if not_checked else "verified"
        label = f"{state}, {verdict}" if state else verdict
        if not quiet:
            # A refused document with a kept row still has a row at its path, so it is
            # not expected absent; only a refused document with no row is.
            absent = len(v["invalid"]) + len(v["refused"]) - len(v["refused_kept"])
            not_checked_note = f", {not_checked} not checked" if not_checked else ""
            print(f"kb sync: {label} — {v['indexed']} docs indexed, "
                  f"{absent} invalid on disk "
                  f"(expected absent){not_checked_note}")
        elif not_checked:
            print(f"kb sync: {not_checked} not checked: the "
                  f"Library's roster could not be read", file=sys.stderr)
        return 0

    print(f"kb sync: VERIFY FAILED — {len(v['missing'])} missing, "
          f"{len(v['extra'])} extra, {len(v['stale'])} stale "
          f"(disk {v['disk']}, indexed {v['indexed']})", file=sys.stderr)
    for label in ("missing", "extra", "stale"):
        for rel in v[label][:10]:
            print(f"  {label}: {rel}", file=sys.stderr)
        if len(v[label]) > 10:
            print(f"  {label}: … and {len(v[label]) - 10} more", file=sys.stderr)

    if not heal or dry_run:
        print("kb sync: not healing (--no-heal or --dry-run)", file=sys.stderr)
        return 2

    print("kb sync: healing with a full scan and reconcile", file=sys.stderr)
    idx.full_scan_and_reconcile()
    v2 = idx.verify_index()
    if v2["ok"]:
        not_checked = _kb_not_checked(v2)
        not_checked_note = f", {not_checked} not checked" if not_checked else ""
        print(f"kb sync: healed — {v2['indexed']} docs indexed{not_checked_note}")
        return 0
    print(f"kb sync: STILL INCONSISTENT after a full reconcile — "
          f"{len(v2['missing'])} missing, {len(v2['extra'])} extra, "
          f"{len(v2['stale'])} stale. This is a real defect, not drift.",
          file=sys.stderr)
    return 2


def _find_run_by_worktree(wt: Path) -> Path | None:
    """Reverse-lookup: given a worktree path, return the most recent run dir whose
    meta.json names that worktree.

    Scans date dirs newest-first and, WITHIN a day, orders candidates by their
    meta.json `started_at` rather than by run-dir name. That distinction is
    load-bearing rather than tidy. A run id is `run-{8 random hex}`, so sorting
    names lexicographically orders by random hex — which is to say, not at all.

    Getting it wrong INVERTS the signal this whole mechanism exists to produce.
    Every worker run is `committed_not_pushed` at finalize (ARCH-055), so on a
    reused worktree two runs the same day can both be in that state. If the
    lookup returns the older one, `publish` promotes IT to `completed` — clearing
    the genuine alarm on a run whose work was never pushed — while the run that
    actually published stays flagged. The alarming run is the safe one and the
    quiet one lost work: exactly backwards, and roughly a coin flip on random
    hex. Found by security-reviewer on PR #274.

    `started_at` is written into every meta.json by telemetry.write_meta, so the
    ordering key already exists. A candidate whose `started_at` is missing or
    unparseable sorts LAST rather than being dropped: it is still a legitimate
    match, and preferring a run with a readable timestamp is the safer tie-break.

    Returns None when no run matches, when the worktree resolves to an unreadable
    meta, or on any I/O error.

    Ambiguity policy: most-recent match wins. A worktree genuinely used by two
    simultaneously-live runs is a concurrency violation the spawn guard prevents;
    if it somehow occurs, promoting the most-recent run is the least-bad choice and
    leaves the earlier run's outcome unchanged.
    """
    try:
        wt_resolved = str(wt.resolve())
    except OSError:
        return None
    for date_dir in sorted(RUNS_ROOT.glob("20*-*-*/"), reverse=True):
        matches: list[tuple[str, Path]] = []
        for run_dir in date_dir.iterdir():
            if not run_dir.is_dir():
                continue
            meta_path = run_dir / "meta.json"
            if not meta_path.exists():
                continue
            try:
                meta = json.loads(meta_path.read_text())
            except (OSError, ValueError):
                continue
            raw = meta.get("worktree", "")
            if not raw:
                continue
            try:
                if str(Path(raw).resolve()) != wt_resolved:
                    continue
            except OSError:
                continue
            # ISO-8601 UTC sorts correctly as text, so no parsing is needed. The
            # empty-string default sorts BEFORE any real timestamp, which under
            # reverse=True puts an unreadable one last — see the docstring.
            started = meta.get("started_at") or ""
            matches.append((started if isinstance(started, str) else "", run_dir))
        if matches:
            matches.sort(key=lambda m: m[0], reverse=True)
            return matches[0][1]
    return None


def _promote_if_committed_not_pushed(run_id: str | None, wt: "Path | None" = None) -> None:
    """After a verified push, promote committed_not_pushed → completed in outcome.json.

    Called from cmd_publish on every successful push path. The promotion makes
    committed_not_pushed a transient state: correct at finalize time (commits exist,
    remote has not received them yet), and corrected to completed once the push is
    verified. Only runs where agentctl publish is never called retain the status.

    Resolves the run dir by run_id when present, then falls back to a worktree
    reverse-lookup when run_id is absent (the canonical --repo/--purpose publish
    path). Fails safe: any I/O error leaves the outcome unchanged.

    Does not touch the model-resolution Archives record. That record was
    posted once, at finalize, from harness-held values in the finalizing
    process; this function runs later, in `agentctl publish`, a separate
    process with no such values, so its only source for a second record would
    be a fresh disk read of meta.json/cost.json/outcome.json — files the run's
    own subprocess can still reach at the time this promotion normally
    happens. See `_post_model_resolution_signal`'s docstring for why that
    record was removed rather than hardened again (security review, PR #477
    round 4).
    """
    if run_id:
        run_dir = _find_run_dir(run_id)
    elif wt is not None:
        run_dir = _find_run_by_worktree(wt)
    else:
        return
    if run_dir is None:
        return
    try:
        outcome = T.read_outcome(run_dir)
    except (OSError, ValueError):
        return
    if outcome.get("exit_status") != "committed_not_pushed":
        return
    try:
        T.write_outcome(
            run_dir,
            exit_status="completed",
            files_modified=outcome.get("files_modified"),
            files_added=outcome.get("files_added"),
            files_deleted=outcome.get("files_deleted"),
            prs_opened=outcome.get("prs_opened"),
            tests_run=outcome.get("tests_run"),
            tests_passed=outcome.get("tests_passed"),
            subagents_spawned=outcome.get("subagents_spawned"),
            terminal_reason=outcome.get("terminal_reason"),
            api_error_status=outcome.get("api_error_status"),
            api_error_message=outcome.get("api_error_message"),
        )
    except (OSError, ValueError):
        return


def _restore_suppressed_before_push(git, wt: Path) -> bool:
    """Put back an instruction file the DISPATCHER removed. True if it committed.

    THE FAILURE THIS CLOSES, which is not the one the suppression's own docstring
    anticipates. `suppress_repo_instructions` deletes `CLAUDE.md`/`AGENTS.md`
    from a dispatch worktree and leaves the deletion visible to git deliberately,
    with `worktrees._is_platform_suppression` exempting that porcelain line so the
    platform's own cleanup does not read it as the agent's work. That exemption
    is in the status-READING paths only. Nothing constrains what the agent's
    `git commit -a` STAGES, so the deletion rides into the commit alongside real
    work and reaches the PR.

    Seen twice on 2026-09-18 in convivy-orient: `03629c8` removed `AGENTS.md`
    (-39) inside a commit titled "fix(home): re-disable the hover underline",
    and #311 carried the same deletion uncommitted until a co read `git status`
    before pushing. Both were caught by a reviewer reading the file list. Had
    either merged, every agent dispatched to that repo afterwards would have
    started without the rules, and `git ls-files` finds no CLAUDE.md there.

    WHY THIS RUNS AT PUBLISH AND NOT EARLIER. By the time anything platform-owned
    runs again the deletion is already committed; restoring the working tree
    alone would leave the commit, and the PR, still deleting the file. So the
    repair has to be a commit of its own, and publish is the last platform-owned
    step before the push.

    WHY THE CONTENT COMES FROM THE RECORDED SPAWN HEAD, NOT THE MERGE BASE. Base
    is the wrong comparison the moment the branch has touched the file itself: a
    round-1 commit that edits `AGENTS.md`, followed by a round-2 dispatch that
    suppresses it again and an agent `commit -a` that sweeps the deletion in,
    restores base's text and silently discards round 1 under a commit that says
    it is restoring. When origin has advanced it is worse — the restore writes
    main's newer text and the PR shows an instruction-file modification nobody
    made. What the dispatcher removed is what HEAD held at spawn.

    Best-effort and never fatal. A publish that cannot restore still pushes; the
    deletion then reaches the PR exactly as it does today, where a reviewer
    catches it. But it says so, because a silent skip and a successful repair
    would otherwise produce the same output.
    """
    recorded, spawn_head = read_suppression_record(wt)
    if not recorded or not spawn_head:
        return False
    if git("rev-parse", "--verify", "-q", f"{spawn_head}^{{commit}}").returncode != 0:
        return False
    # Only paths this branch actually DELETES relative to the commit the
    # dispatcher removed them from. A worktree whose agent never ran `commit -a`
    # has nothing to repair, and `--diff-filter=D` keeps this off a file the
    # branch merely modified.
    cp = git("diff", "--name-only", "--diff-filter=D", f"{spawn_head}..HEAD", "--", *recorded)
    deleted = [p for p in cp.stdout.splitlines() if p.strip()] if cp.returncode == 0 else []
    if not deleted:
        return False

    def _give_up(step: str) -> bool:
        print(f"publish: WARNING — could not restore {', '.join(deleted)} ({step} failed); "
              f"the dispatcher's deletion WILL reach the PR. A reviewer is now the only "
              f"thing between it and a merge.", file=sys.stderr)
        return False

    restored = []
    for path in deleted:
        if git("checkout", spawn_head, "--", path).returncode == 0:
            restored.append(path)
    if not restored:
        return _give_up("git checkout")
    if git("add", "--", *restored).returncode != 0:
        return _give_up("git add")
    msg = ("chore: restore instruction files the dispatcher removed\n\n"
           "`agentctl spawn` deletes these from a dispatch worktree so the agent is "
           "individuated rather than instructed by the branch it is working on. The "
           "deletion is not the agent's work and must not reach the PR.\n\n"
           "Restored: " + ", ".join(restored))
    # `--no-verify`: a repo's own pre-commit hook has no business gating the
    # platform's repair of its own deletion, and a hook that fails would leave
    # the deletion in the PR.
    if git("commit", "--no-verify", "-m", msg, "--", *restored).returncode != 0:
        return _give_up("git commit")
    print(f"publish: restored dispatcher-suppressed {', '.join(restored)} in a commit before "
          f"pushing (the deletion was not the agent's work)", file=sys.stderr)
    return True


def _refuse_inside_object_redirected_run(cmd: str) -> str | None:
    """None when this process is free to touch git and the private-object import;
    else the refusal message.

    True when any of `RS.GIT_OBJECT_REDIRECT_VARS` is set in this process's own
    environment — the signal a dispatched run's own shell always carries
    (`dispatch_env` sets `GIT_OBJECT_DIRECTORY`/`GIT_ALTERNATE_OBJECT_DIRECTORIES`
    for every real-repo dispatch), and `publish`/`pr-open` running under it means a
    run is calling one of them on its OWN worktree from inside its OWN shell — the
    CQ·477 incident (run-421dd904, 2026-10-12): a coder's `agentctl publish` on its
    own worktree reached `import_leftover_private_objects`, which found nothing
    missing from the shared store and ran `shutil.rmtree` on the private store this
    run's own git was still pointed at, breaking every git call for the rest of the
    run. `publish`/`pr-open` are the orchestrator's own step, run from an
    unsandboxed `agentctl` invocation after the run has ended; the run-side
    equivalent is the orchestrator calling `agentctl publish --run <id>` /
    `pr-open --run <id>` once this run is done, never the run calling either on
    itself."""
    hit = [v for v in RS.GIT_OBJECT_REDIRECT_VARS if v in os.environ]
    if not hit:
        return None
    return (f"{cmd}: REFUSED — this process's own git is redirected at a dispatched "
            f"run's private object store ({', '.join(hit)} set). {cmd} is the "
            f"orchestrator's step, run after the run ends (`agentctl {cmd} --run <id>`), "
            f"never a run calling it on its own worktree from inside its own shell.")


def cmd_publish(args) -> int:
    """Push a worktree's current branch to origin and verify origin == local HEAD.

    The deterministic worktree->origin sync for the ARCH-027 review auto-cycle
    (ARCH-055). `coder`/`bug-fixer` commit in the worktree but deliberately do
    NOT push; the orchestrator MUST call this after every (re-)dispatch round so
    reviewers always read origin==local and the open PR always reflects HEAD —
    rather than relying on an LLM to remember `git push` each round.

    Fast-forward push only — never force. A non-fast-forward (history rewrite,
    or origin ahead of local) fails loudly instead of clobbering: that's a real
    divergence the orchestrator should surface, not paper over.

    Resolve the worktree by explicit path, by --run <id> (registry lookup), or
    by --repo/--purpose (same resolution `spawn` uses).
    """
    refusal = _refuse_inside_object_redirected_run("publish")
    if refusal is not None:
        print(refusal, file=sys.stderr)
        return 1

    # --- resolve the worktree path ---
    if args.worktree:
        wt = Path(args.worktree).expanduser().resolve()
    elif args.run:
        wt = _resolve_worktree_by_run(args.run)
        if wt is None:
            print(f"publish: no registry entry or run dir with a worktree for run "
                  f"{args.run!r}", file=sys.stderr)
            return 2
    elif args.repo and args.purpose:
        wt = W.desired_path(args.repo, args.purpose).resolve()
    else:
        print("publish: need a worktree — pass PATH, or --run <id>, or --repo R --purpose P.",
              file=sys.stderr)
        return 2

    if not (wt / ".git").exists():
        print(f"publish: not a git worktree (no .git): {wt}", file=sys.stderr)
        return 2

    def git(*a):
        return subprocess.run(["git", "-C", str(wt), *a], capture_output=True, text=True)

    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not branch or branch == "HEAD":
        print(f"publish: refused — detached HEAD / no branch in {wt}.", file=sys.stderr)
        return 1
    head = git("rev-parse", "HEAD").stdout.strip()

    # Fold in a leftover private object store before reading HEAD's ancestry or
    # pushing it, but ONLY when HEAD itself is not resolvable from the shared store: a
    # run dispatched on this tree may have died, or its own end-of-run import may have
    # exhausted its retries (issue_01M4RP1K026XJE740DMQ7AP31M, run-89f78c3f,
    # 2026-10-12), leaving its commit reachable only through the private store —
    # invisible to this function's own plain-git reads and to `git push`.
    #
    # `git cat-file -e` is the exact check `rev-parse HEAD` above cannot make: it reads
    # the ref file (worktree-local), never the object, so it resolves to a sha even
    # when that sha names no object anywhere — which is exactly how the incident above
    # was first seen (`git cat-file -t HEAD` printing "fatal: bad object HEAD").
    # `remove=False`: a push that fails right after this must not have already
    # deleted the one copy of the commit it just proved exists.
    if git("cat-file", "-e", f"{head}^{{commit}}").returncode != 0:
        private_git_dir = RS.git_common_dir(wt)
        if private_git_dir is not None:
            RS.import_private_objects(
                private_git_dir, RS.run_private_objects_dir(wt, private_git_dir),
                remove=False)

    # Repo name for any suggested `--on` in this function's own messages, and
    # reused below for the fast-check gates. `args.repo` wins when given
    # explicitly; otherwise the worktree-naming convention this platform
    # already dispatches against (`<repo>` for a primary, `<repo>.<purpose>`
    # for a linked worktree — same convention `_cwd_repo_short` used to read
    # before spawn's `--on` inference was removed, PR #723 round 4) gives a
    # name to suggest without re-adding that inference to `spawn` itself.
    repo_name = args.repo or wt.name.split(".", 1)[0]

    # PR-awareness (ARCH-347): if this run belongs to a PR — via `--pr N` or the
    # `pr-link.json` a `spawn --pr` round-fix stamps — the worktree's branch MUST be the
    # PR's own branch. Otherwise `publish` would fast-forward an `agent/<task-slug>`
    # branch no PR points at, report success, and leave the PR head frozen (the #923
    # footgun). Resolve the PR's branch and refuse loudly on a mismatch, before any push.
    pr_number = getattr(args, "pr", None)
    if not pr_number and args.run:
        rd = _find_run_dir(args.run)
        if rd and (rd / "pr-link.json").exists():
            try:
                pr_number = json.loads((rd / "pr-link.json").read_text()).get("pr_number")
            except (OSError, ValueError):
                pr_number = None
    if pr_number:
        pv = subprocess.run(
            ["gh", "pr", "view", str(pr_number), "--json", "headRefName",
             "-q", ".headRefName"],
            cwd=str(wt), capture_output=True, text=True)
        if pv.returncode != 0:
            print(f"publish: --pr {pr_number}: cannot resolve PR head branch "
                  f"({pv.stderr.strip()}).", file=sys.stderr)
            return 1
        pr_branch = pv.stdout.strip()
        if branch != pr_branch:
            print(f"publish: REFUSED — worktree is on {branch!r} but PR #{pr_number} is on "
                  f"{pr_branch!r}. Pushing would land on a branch no PR points at, leaving "
                  f"the PR head stale (ARCH-347). Dispatch the round-fix with "
                  f"`agentctl spawn <coder> --on {repo_name} --pr {pr_number}` so it commits "
                  f"on the PR branch.", file=sys.stderr)
            return 1

    dirty = sum(1 for l in git("status", "--porcelain").stdout.splitlines() if l.strip())
    if dirty:
        print(f"publish: WARNING — {dirty} uncommitted file(s) in {wt}; pushing committed HEAD "
              f"only (uncommitted work will NOT reach origin).", file=sys.stderr)

    # An EMPTY worktree is a bug, not a no-op (vivy co, 2026-07-18). When a worker writes
    # into the main checkout instead of its worktree, the worktree is left with zero commits
    # beyond its base — and the in-sync early-return below then prints "already in sync" and
    # exits 0, because origin genuinely does match. publish cannot distinguish "no new work"
    # from "the work went somewhere else", so it reports success over a lost slice. That
    # silence is what let three collisions in one vivy session (once an entire 293-line slice,
    # recovered by hand) and a crossed PR body on merged #978 stand undetected.
    #
    # Refuse instead. A worktree publish is meant to carry work; zero commits beyond base
    # means the work is not here. This does NOT fire on a round-fix that legitimately added
    # no commit — that worktree sits on the PR's own branch, which is already ahead of base.
    #
    # The base is resolved to a sha through the exact ref (git_refs): a tag or branch
    # literally named `origin/<base>` would otherwise stand in for the real ref, and a
    # tag on an ancestor of HEAD would make an empty worktree read as carrying work.
    base_ref = ""
    base_sha = ""
    default_base = _default_base(git)
    for cand, label in ((f"refs/remotes/origin/{default_base}", f"origin/{default_base}"),
                        (f"refs/heads/{default_base}", default_base)):
        base_sha = GR.exact_ref_sha(wt, cand) or ""
        if base_sha:
            base_ref = label
            break
    if base_ref:
        ahead = git("rev-list", "--count", f"{base_sha}..HEAD").stdout.strip()
        if ahead == "0":
            print(f"publish: REFUSED — {wt} has NO commits beyond {base_ref} on {branch!r}. "
                  f"An empty worktree means the work never landed here — the usual cause is a "
                  f"worker that wrote into the main checkout instead of its worktree. Pushing "
                  f"would report success over lost work. Check the main checkout for the "
                  f"worker's files (`git -C <primary> status`) and recover them onto this "
                  f"branch before publishing.", file=sys.stderr)
            return 1
    # base unresolvable (no origin, unusual layout) — do not block on a check we cannot make.

    # The fast-check gates, before any network work or the in-sync early-return —
    # block here rather than after a wasted review + CI round. Ordered cheapest
    # first so the quickest failure reports soonest.
    #
    # `--skip-checks` exists for the case a gate is wrong about a worktree, and is
    # logged like a model override (ARCH-188) so leaning on it surfaces rather than
    # quietly becoming the norm. It does NOT skip any of the correctness refusals
    # above (PR-branch mismatch, empty worktree) — those are not style checks.
    if getattr(args, "skip_checks", False):
        print("publish: WARNING — fast checks SKIPPED via --skip-checks; CI is now the "
              "only gate on lint/format/typecheck for this push.", file=sys.stderr)
        _log_skipped_checks(wt=wt, branch=branch)
    else:
        for gate in (lambda: _ruff_format_gate(wt),
                     lambda: _ruff_lint_gate(wt),
                     lambda: _typecheck_gate(wt, repo_name)):
            if gate() != 0:
                return 1

    # Repair the dispatcher's own deletion, AFTER every refusal and every gate so
    # a publish that is going to fail leaves no commit behind, and BEFORE the
    # in-sync comparison and the push so the repair is what gets sent and what
    # gets verified. `--dry-run` must not mutate the branch, so it is excluded
    # here rather than inside the helper.
    #
    # `head` IS RE-READ WHEN IT COMMITS, and forgetting that broke exactly the
    # one path this mechanism exists for: `head` is read once near the top, the
    # repair moves HEAD past it, and then the in-sync check reads "origin already
    # matches" and skips the push, while the post-push verification compares the
    # pushed tip against the stale SHA and reports VERIFICATION FAILED over a
    # correct push.
    if not args.dry_run and _restore_suppressed_before_push(git, wt):
        head = git("rev-parse", "HEAD").stdout.strip()

    # Refresh the remote-tracking ref so the in-sync check + verification are honest.
    git("fetch", "origin", branch)
    remote_before = GR.exact_ref_sha(wt, f"refs/remotes/origin/{branch}") or ""

    if remote_before == head:
        print(f"publish: already in sync — origin/{branch} at {head[:9]} ({branch}).")
        _promote_if_committed_not_pushed(getattr(args, "run", None), wt)
        # Machine-readable head for the review pin (ARCH-184): the orchestrator
        # dispatches the reviewer with `agentctl spawn reviewer --pr <N>`, which pins the
        # PR's live head. A `--review-sha` dispatch with no `--pr` records no PR, so its
        # stamp never counts (CQ·399).
        print(f"published-sha: {head}")
        return 0
    if args.dry_run:
        print(f"publish: DRY-RUN — would fast-forward origin/{branch} "
              f"{remote_before[:9] or '(absent)'} -> {head[:9]}.")
        return 0

    # NOT subject to --skip-checks (unlike the fast-check gates above): that flag's own
    # message says it skips "lint/format/typecheck", a style gate CI re-enforces anyway.
    # Nothing else in the PR flow runs Builder's content scan, so this is the one place
    # it runs at all, and it runs on the exact commit about to be pushed.
    if _content_scan_gate(wt, repo_name, head) != 0:
        return 1

    r = git("push", "origin", f"HEAD:{branch}")
    if r.returncode != 0:
        print(f"publish: push FAILED ({branch}): {r.stderr.strip()}\n"
              f"  (non-fast-forward => history diverged/rewritten, or auth/remote error — "
              f"surface this; do not force.)", file=sys.stderr)
        return 1

    remote_after = GR.exact_ref_sha(wt, f"refs/remotes/origin/{branch}") or ""
    if remote_after != head:
        print(f"publish: pushed but VERIFICATION FAILED — origin/{branch}={remote_after[:9]} "
              f"!= HEAD={head[:9]}.", file=sys.stderr)
        return 1
    print(f"publish: pushed + verified — origin/{branch} now at {head[:9]} ({branch}).")
    _promote_if_committed_not_pushed(getattr(args, "run", None), wt)
    # Machine-readable head for the review pin (ARCH-184) — see the in-sync branch.
    print(f"published-sha: {head}")
    return 0


def _pr_open_edit_authorization(run_id: str | None, wt: Path,
                                 pr_number: int | None) -> tuple[bool, str]:
    """Whether THIS `pr-open` call may `gh pr edit` PR #`pr_number`'s body.

    Coder branches are `agent/<purpose>` with no per-task discriminator, so two
    dispatches whose tasks share their first 32 slugged characters share a branch —
    picking the PR to edit by branch name alone let the second run's `pr-open`
    overwrite the first run's open PR body with its own (hit for real on vivy PR
    1342, run-17e1ce7b/run-7d2061b5; issue 01KYRC81H34WCC6FVV9JZAWQGW). The edit is
    authorized only when the run THIS call is for was itself dispatched with
    `--pr N` naming this exact PR — recorded in that run's own meta.json (`spawn`
    threads its `--pr` through to `write_meta(..., pr=pr_number)`).

    `run_id` is `--run` when the caller passed it; otherwise the run is found by
    reverse-looking-up which run's meta.json names `wt` as its worktree
    (`_find_run_by_worktree`, the same resolver `publish`'s worktree-only path
    already relies on). Neither source is a stronger claim than the other:
    meta.json lives in the run's OWN directory, which the run's Bash tool can
    write, so this authorizes on the run's claim about itself, not on anything
    independently verified. There is no stronger record to prefer instead: the
    active-runs registry drops a run's entry at finalize (which happens before
    `pr-open` runs for a completed worker), and `pr-link.json` sits in the same
    run directory as meta.json, so it carries the identical exposure.
    """
    if pr_number is None:
        return False, "gh did not report this PR's number"
    run_dir = _find_run_dir(run_id) if run_id else _find_run_by_worktree(wt)
    if run_dir is None:
        return False, "no dispatched run resolves for this worktree"
    facts = RP.resolve_run_facts(run_dir.name, RUNS_ROOT)
    if not facts.found:
        return False, f"run {run_dir.name}'s meta.json is unreadable"
    if facts.pr is None:
        return False, f"run {run_dir.name} was dispatched without --pr"
    try:
        recorded = int(facts.pr)
    except (TypeError, ValueError):
        return False, f"run {run_dir.name}'s recorded --pr ({facts.pr!r}) is not a number"
    if recorded != pr_number:
        return False, f"run {run_dir.name} was dispatched with --pr {recorded}, not #{pr_number}"
    return True, ""


def _pr_open_refresh_existing(gh, args, branch: str, base: str, url: str,
                               body_path: Path, wt: Path, pr_number: int | None) -> int:
    """The branch already has an open PR: refresh its body from `body_path`
    and print the URL. Without this, a revise round rewrites `pr-body.md` but
    `pr-open`'s only write was `gh pr create`, so reviewers kept reading the
    first commit's description (issue 01M3P061TZ3RDS27P0HST3QHFB). The title
    stays as opened — only the body drifts across a revise round.

    The edit itself is gated by `_pr_open_edit_authorization` (security review,
    PR #711): only a run dispatched with `--pr N` naming THIS PR may edit its
    body, since a branch-name collision could otherwise let an unrelated run's
    `pr-open` overwrite it. An unauthorized call keeps the pre-refresh
    behaviour (print the URL, stamp the link, change nothing) and warns on
    stderr instead of refusing outright — nothing failed; the body just wasn't
    this call's to change."""
    ok, reason = _pr_open_edit_authorization(args.run, wt, pr_number)
    if not ok:
        pr_ref = f"#{pr_number}" if pr_number is not None else url
        print(f"pr-open: PR already open for {branch} — {url}")
        print(f"pr-open: body NOT refreshed — {reason}. Only a run dispatched with "
              f"`--pr` naming {pr_ref} may edit its body.", file=sys.stderr)
        _stamp_pr_link(gh, args.run, branch, base, url)
        return 0
    if args.dry_run:
        print(f"pr-open: DRY-RUN — would refresh the body of {url} from {body_path}.")
        return 0
    edit = gh("pr", "edit", url, "--body-file", str(body_path))
    if edit.returncode != 0:
        print(f"pr-open: gh pr edit FAILED ({url}): {edit.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"pr-open: PR already open for {branch} — refreshed body — {url}")
    _stamp_pr_link(gh, args.run, branch, base, url)
    return 0


def _stamp_pr_link(gh, run_id: str | None, branch: str, base: str, url: str) -> None:
    """Record the run→PR link first-class for the scorecard (ARCH-107, Phase 0).

    Writes `pr-link.json` into the worker run's dir so `model-scorecard` joins by a
    *recorded* link instead of reconstructing the branch from the worktree name — the
    reconstruction is None for arch-led refactorer/coder worktrees (no `<repo>.`
    purpose suffix), which left ~1/3 of producer runs unjoinable. Best-effort and
    failure-isolated: a stamp problem must never fail the PR open (the PR is already
    created at the call site). No-op when `--run` wasn't passed."""
    if not run_id:
        return
    try:
        run_dir = _find_run_dir(run_id)
        if run_dir is None:
            print(f"pr-open: --run {run_id} has no run dir on disk; skipped link stamp.",
                  file=sys.stderr)
            return
        number = gh("pr", "view", branch, "--json", "number", "-q", ".number").stdout.strip()
        payload = {
            "pr_number": int(number) if number.isdigit() else None,
            "pr_url": url or None,
            "branch": branch,
            "base": base,
            "linked_at": T.now_iso(),
            "linked_by": "agentctl pr-open",
        }
        T.write_owner_only(run_dir / "pr-link.json", json.dumps(payload, indent=2) + "\n")
        print(f"pr-open: linked run {run_id} → PR #{payload['pr_number']} ({run_dir/'pr-link.json'}).",
              file=sys.stderr)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        print(f"pr-open: link stamp failed (non-fatal): {e}", file=sys.stderr)


def cmd_pr_open(args) -> int:
    """Open a GitHub PR for a worktree's branch from a worker-authored body file.

    The deterministic PR-open for the orchestrator (ARCH-058). Workers
    (`coder`/`bug-fixer`/`refactorer`) commit in the worktree, do NOT push, and
    write the PR body markdown to the path `git rev-parse --git-path pr-body.md`
    resolves to (a per-worktree gitdir file: never tracked, never committed).
    The orchestrator — which has no Write tool and must not hand-build a PR body
    inline in bash (the ARCH-051 quoting-corruption class) — then runs this:
    it reads that body file and opens the PR with `gh pr create --body-file`,
    so the multi-line markdown never passes through shell quoting.

    Mirrors `publish`'s worktree resolution (path / --run / --repo+--purpose).
    Enforces the ARCH-055 ordering: refuses unless `origin/<branch>` == local
    HEAD (i.e. `agentctl publish` already ran) so the PR never reflects an
    unpushed worktree. Idempotent: if the branch already has an OPEN PR, its
    body is refreshed from the same body file via `gh pr edit --body-file`
    (the title stays as opened) — so a revise round's rewritten pr-body.md
    reaches the PR instead of leaving reviewers reading the first commit's
    description. A branch whose only PR is MERGED or CLOSED is refused, not
    edited. The refresh itself only runs for a round-fix dispatched with
    `--pr N` naming this PR (`_pr_open_edit_authorization`, security review PR
    #711): two coder branches can collide on name, and without this a second
    run's `pr-open` could overwrite an unrelated PR's body.

    The one-line PR title comes from --title (safe as a single argv); only the
    fragile multi-line body comes from the file.
    """
    refusal = _refuse_inside_object_redirected_run("pr-open")
    if refusal is not None:
        print(refusal, file=sys.stderr)
        return 1

    # --- resolve the worktree path (mirrors publish) ---
    # Priority: explicit PATH > --repo+--purpose > --run (registry). repo+purpose
    # is checked before --run so the orchestrator can pass `--run <worker-id>`
    # alongside `--repo/--purpose` purely to stamp the run→PR link (ARCH-107): by
    # the time the PR opens the worker has finalized and left the registry, so
    # --run no longer resolves a worktree — but it still names the run dir to stamp.
    if args.worktree:
        wt = Path(args.worktree).expanduser().resolve()
    elif args.repo and args.purpose:
        wt = W.desired_path(args.repo, args.purpose).resolve()
    elif args.run:
        wt = _resolve_worktree_by_run(args.run)
        if wt is None:
            print(f"pr-open: no registry entry or run dir with a worktree for run "
                  f"{args.run!r}.", file=sys.stderr)
            return 2
    else:
        print("pr-open: need a worktree — pass PATH, or --run <id>, or --repo R --purpose P.",
              file=sys.stderr)
        return 2

    if not (wt / ".git").exists():
        print(f"pr-open: not a git worktree (no .git): {wt}", file=sys.stderr)
        return 2

    # Same family fix as `cmd_publish`: fold in any leftover private object store before
    # this function reads HEAD, so a dead run's commit (never imported because its
    # dispatcher died first — P1b, 2026-07-04) is resolvable rather than silently absent
    # from what `publish`/`push` already pushed. A no-op when there is nothing to import.
    W.import_leftover_private_objects(wt)

    def git(*a):
        return subprocess.run(["git", "-C", str(wt), *a], capture_output=True, text=True)

    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not branch or branch == "HEAD":
        print(f"pr-open: refused — detached HEAD / no branch in {wt}.", file=sys.stderr)
        return 1
    head = git("rev-parse", "HEAD").stdout.strip()

    # The worker's PR body lives at a per-worktree gitdir path (Path join is
    # safe whether git prints it relative-to-wt or absolute).
    body_rel = git("rev-parse", "--git-path", "pr-body.md").stdout.strip()
    body_path = (wt / body_rel).resolve()
    if not body_path.is_file() or body_path.stat().st_size == 0:
        print(f"pr-open: no PR body at {body_path} — the worker must write the PR body "
              f"there (`git rev-parse --git-path pr-body.md`) before pr-open.", file=sys.stderr)
        return 1

    # ARCH-055 ordering: origin must already match HEAD (publish ran). Reviewers
    # and the PR read origin; opening against an unpushed worktree is the exact
    # stale-PR failure publish exists to prevent.
    git("fetch", "origin", branch)
    remote = GR.exact_ref_sha(wt, f"refs/remotes/origin/{branch}") or ""
    if remote != head:
        print(f"pr-open: refused — origin/{branch}={remote[:9] or '(absent)'} != HEAD={head[:9]}. "
              f"Run `agentctl publish` first (ARCH-055); never open a PR against an unpushed "
              f"worktree.", file=sys.stderr)
        return 1

    # Base branch: the repo's default (origin/HEAD), overridable via --base.
    base = args.base or _default_base(git)

    def gh(*a):
        return subprocess.run(["gh", *a], cwd=str(wt), capture_output=True, text=True)

    # Idempotent: if a PR already exists for this branch AND is OPEN, return its
    # URL. A branch whose only PR is MERGED or CLOSED is stale — refusing loudly
    # prevents a caller from attaching a fresh fix to merged work (issue
    # 01KYRC81H34WCC6FVV9JZAWQGW: pr-open printed a merged PR's URL from a
    # collided branch name, and only a manual `gh pr view --json state` caught it).
    # Use `gh pr list --state open` rather than `gh pr view` because `pr view`
    # returns the most-recently-created PR on the branch regardless of state —
    # a branch with both a merged and an open PR could land on the wrong one.
    existing = gh("pr", "list", "--head", branch, "--state", "open",
                  "--json", "number,url", "--limit", "1")
    # --limit 1 is safe because GitHub enforces at most one open PR per branch.
    # If the invariant were violated, we would still return the first match;
    # the stale fallback below catches the degenerate case (zero / closed).
    if existing.returncode == 0 and existing.stdout.strip():
        try:
            infos = json.loads(existing.stdout.strip())
        except json.JSONDecodeError:
            infos = []
        if infos:
            url = infos[0].get("url") or ""
            pr_number = infos[0].get("number")
            return _pr_open_refresh_existing(gh, args, branch, base, url, body_path,
                                             wt, pr_number)

    # No open PR. Check whether a merged/closed PR exists on this branch and refuse.
    stale = gh("pr", "view", branch, "--json", "number,state,url")
    if stale.returncode == 0 and stale.stdout.strip():
        try:
            info = json.loads(stale.stdout.strip())
        except json.JSONDecodeError:
            info = {}
        state = info.get("state") or ""
        url = info.get("url") or ""
        pr_number = info.get("number")

        if state == "OPEN":
            # Transient gh pr list failure / auth glitch masked an open PR.
            # Idempotent return — the caller doesn't need to re-run.
            return _pr_open_refresh_existing(gh, args, branch, base, url, body_path,
                                             wt, pr_number)

        if state in ("MERGED", "CLOSED"):
            print(f"pr-open: the only PR on {branch} is {state} ({url}). "
                  f"Refusing to attach work to a {state.lower()} branch.",
                  file=sys.stderr)
            return 1

        # Unrecognised state (or empty, from a JSON parse failure) — fail closed.
        # An unparseable state cannot be safe, so we refuse rather than guess.
        print(f"pr-open: the only PR on {branch} has unrecognised state "
              f"({state!r}) — refusing to attach work.",
              file=sys.stderr)
        return 1

    # Workers open drafts by default (ARCH-364). CI runs a cheap lint lane on
    # drafts and the full suite only on mark-ready, so the review cycle works
    # against the draft and the full suite runs once as the merge gate rather
    # than twice. `--ready` opts out for a PR that needs the full suite now.
    draft = not args.ready

    if args.dry_run:
        print(f"pr-open: DRY-RUN — would `gh pr create` for {branch} -> base {base} "
              f"(title {args.title!r}, body {body_path}, "
              f"{'draft' if draft else 'ready for review'}).")
        return 0

    r = gh("pr", "create", "--title", args.title, "--body-file", str(body_path),
           "--base", base, "--head", branch, *(["--draft"] if draft else []))
    if r.returncode != 0:
        print(f"pr-open: gh pr create FAILED ({branch} -> {base}): {r.stderr.strip()}",
              file=sys.stderr)
        return 1
    url = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ""
    print(url or f"pr-open: created PR for {branch} (no URL captured; check `gh pr view {branch}`).")
    _stamp_pr_link(gh, args.run, branch, base, url)
    return 0


# --- stamped-review merge gate (ARCH-184 phase 2) ---------------------------

def _gh_repo_slug() -> str:
    """owner/repo for the cwd, or "" if gh can't resolve one (best-effort)."""
    r = subprocess.run(
        ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
        capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def _gh_pr_json(pr: str, fields: list[str], repo: str | None = None) -> dict:
    cmd = ["gh", "pr", "view", str(pr), "--json", ",".join(fields)]
    if repo:
        cmd += ["-R", repo]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"gh pr view {pr} failed")
    return json.loads(r.stdout)


def _gh_open_pr_for_branch(branch: str, repo: str) -> dict | None:
    """The open PR on `branch` in `repo` (`owner/name`), as `{"number", "url"}`,
    or None if there is none. `gh pr list --state open` rather than `gh pr view`
    for the same reason `pr-open` uses it: GitHub allows at most one open PR per
    branch, so `--limit 1` is safe, and a merged/closed PR on the same branch
    must not be read as open.

    Raises RuntimeError if gh could not be asked (down, no network, bad auth),
    or lets `subprocess.TimeoutExpired`/`OSError` propagate (gh hung — including
    on an interactive auth prompt, since stdin is closed rather than inherited —
    or isn't on PATH) — the caller must not read any of these as "no PR", which
    would silently reopen the collision this check exists to close
    (issue_01M3P0VPT1T33K4Y5HRFKH90JE)."""
    cmd = ["gh", "pr", "list", "--head", branch, "--state", "open",
           "--json", "number,url", "--limit", "1", "-R", repo]
    r = subprocess.run(cmd, capture_output=True, text=True,
                       stdin=subprocess.DEVNULL, timeout=15)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"gh pr list --head {branch} failed")
    try:
        infos = json.loads(r.stdout or "[]")
    except json.JSONDecodeError as e:
        raise RuntimeError(f"gh returned unparseable JSON: {e}") from e
    return infos[0] if infos else None


# Matches `https://github.com/owner/repo`, `git@github.com:owner/repo`, and
# `ssh://git@github.com/owner/repo`, case-insensitively, capturing the
# `owner/name` slug (a trailing `.git` and/or `/` stripped). A credentialed
# HTTPS origin (`https://user:token@github.com/owner/repo.git`) and the SCP
# form without `git@` (`github.com:owner/repo`) do not match; `_repo_github_slug`
# returns None for either, which `_refuse_open_pr_reuse` treats the same as a
# repo with no GitHub remote at all and skips the open-PR check.
_GITHUB_REMOTE_RE = re.compile(
    r"^(?:https://|ssh://git@|git@)github\.com[:/](?P<slug>[^/]+/[^/]+?)(?:\.git)?/?$",
    re.IGNORECASE)


def _repo_github_slug(repo: str) -> str | None:
    """`owner/name` for `repo`'s primary checkout's `origin` remote, or None
    when `repo` has no primary, has no `origin`, or `origin` doesn't match one
    of the GitHub HTTPS/SSH forms `_GITHUB_REMOTE_RE` recognizes.

    None is also the right answer (not an error) for a repo with no GitHub
    remote at all: a Builder adopter's local-only install, or a crew dir
    Shipwright's new-crew made with a bare `git init`, has no PRs to collide
    with either way. Read-only (`remote get-url`, no network); never raises —
    an unresolvable repo or an unreadable git config just means "cannot name a
    GitHub repo to ask", which callers treat as "nothing to check"."""
    try:
        primary = W.desired_path(repo, None)
    except ValueError:
        return None
    r = subprocess.run(["git", "-C", str(primary), "remote", "get-url", "origin"],
                       capture_output=True, text=True, check=False)
    if r.returncode != 0:
        return None
    m = _GITHUB_REMOTE_RE.match(r.stdout.strip())
    return m.group("slug") if m else None


def _branch_may_already_exist(repo: str, purpose: str, branch: str) -> bool:
    """True when `purpose`'s worktree is already on disk, or `branch` already
    exists locally or among this checkout's remote-tracking refs.

    Read-only and gh-free (`Path.exists`/`git show-ref`, never a network call):
    a task-hashed `purpose` (`derive_purpose`) has never existed before on a
    genuinely fresh dispatch, so this returns False without touching gh at all,
    and `_refuse_open_pr_reuse` can skip the open-PR lookup entirely — the
    common case, since most dispatches are fresh. Only when something might
    already be there (an earlier run's worktree, or a branch some earlier
    dispatch or push created) is the gh round-trip, and its dependence on gh
    being reachable, worth paying. Any resolution failure (unknown repo, no
    primary) answers False: there is nothing on disk to have already claimed
    the branch."""
    try:
        if W.desired_path(repo, purpose).exists():
            return True
        primary = W.desired_path(repo, None)
    except ValueError:
        return False
    return (GR.exact_ref_sha(primary, f"refs/heads/{branch}") is not None
            or GR.exact_ref_sha(primary, f"refs/remotes/origin/{branch}") is not None)


def _refuse_open_pr_reuse(agent_name: str, repo: str, purpose: str | None) -> str | None:
    """None when a fresh (non-`--pr`) dispatch may allocate `purpose`'s worktree;
    else the refusal message.

    A write-class dedicated-worktree worker's branch is `agent/<purpose>`
    (`W.branch_for_purpose`), and `_spawn_dispatch` only reaches this on a
    dispatch that is NOT a `--pr` round-fix (that path resolves through
    `W.allocate_on_branch` instead and never calls this). If that branch already
    has an OPEN pull request, going ahead here would commit a second run's work
    onto the first's PR — exactly the collision two Course-item dispatches hit
    sharing a 32-char slug (issue_01M3P0VPT1T33K4Y5HRFKH90JE). The fix is to make
    the operator say `--pr N` explicitly rather than silently reusing the tree.

    Review agents are exempt (`purpose is None` is also a no-op, covering the
    primary-kept and detached-main cases): their purpose is scoped to the PR
    already or left generic with a loud ARCH-184 warning, and their worktrees are
    commit-pinned and reaped after the run (ARCH-344) rather than persisted per
    branch — see the long comment in `derive_purpose`.

    gh is consulted at all only when `branch` might already be claimed
    (`_branch_may_already_exist`) and `repo` has a GitHub remote to ask
    (`_repo_github_slug`). A task-hashed purpose's branch has never existed on
    a fresh dispatch, so the overwhelmingly common case never calls gh and
    never depends on it being reachable — this guard used to run, and could
    refuse, on EVERY non-`--pr` write-class dispatch, so a gh outage refused
    brand-new work a GitHub outage cannot possibly collide with, and a repo
    with no GitHub remote (a Builder adopter install, or a `git init`-only crew
    dir) was refused outright rather than allowed. `repo` no longer has
    `convivy/` assumed onto it either: the owner/name comes from the repo's own
    `origin`, so a fork or a non-`convivy` remote is asked correctly instead of
    at the wrong slug.

    Once gh IS asked, a failed lookup is refused too, naming the failure,
    rather than treated as "no PR": the whole point is to fail closed against
    the collision, not open a quieter version of it whenever gh is
    unreachable. That now also covers gh hanging (`subprocess.TimeoutExpired`)
    or not being runnable at all (`OSError`), not just gh returning an error."""
    if purpose is None or _is_review_agent(agent_name):
        return None
    branch = W.branch_for_purpose(purpose)
    if not _branch_may_already_exist(repo, purpose, branch):
        return None
    slug = _repo_github_slug(repo)
    if slug is None:
        return None
    try:
        pr = _gh_open_pr_for_branch(branch, slug)
    except (RuntimeError, subprocess.TimeoutExpired, OSError) as e:
        return (f"cannot verify whether {branch} already has an open PR ({e}) — "
                f"refusing rather than risk a second run silently committing onto "
                f"one. Retry once gh is reachable.")
    if pr is None:
        return None
    number = pr.get("number")
    url = pr.get("url") or ""
    return (f"{branch} already has an open PR (#{number} {url}) — refusing to "
            f"reuse its worktree for a fresh dispatch, which would commit a "
            f"second run onto it. Pass `--pr {number}` for a round-fix.")


# The passing terminal conclusions for a CheckRun. Module-level so the ARCH-345
# APPROVE gate and its "which check failed" diagnostic read the SAME set as the merge
# gate — a second inline copy would silently drift the moment one is extended.
_PASS_CONCL = frozenset({"SUCCESS", "NEUTRAL", "SKIPPED"})

# SKIPPED is tolerated above because a deliberately-skipped job is not a FAILURE,
# and the APPROVE path needs that: under draft-gated CI (ARCH-364) the expensive
# jobs skip while the PR is a draft, which is exactly when reviewers approve.
#
# But a skip is not evidence of PASSING either, and the merge gate needs that
# distinction. See `_skipped_checks`.


def _repo_has_ci_workflows(repo: str) -> bool | None:
    """Whether the repo has any ACTIVE Actions workflow. None if unreadable.

    Used only to interpret an EMPTY rollup. A repo with no CI legitimately reports
    zero checks; a repo that HAS workflows and still reports zero means nothing
    ran, which is the empty-rollup twin of the skipped-check false pass.

    Deliberately a REST call and only made when the rollup is empty, which is
    rare — a merge gate can afford one request to avoid asserting a suite passed
    when none was scheduled.
    """
    r = subprocess.run(
        ["gh", "api", f"repos/{repo}/actions/workflows", "--jq",
         "[.workflows[] | select(.state == \"active\")] | length"],
        capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return int((r.stdout or "0").strip()) > 0
    except ValueError:
        return None


def _skipped_checks(rollup: list, path_map: dict | None = None) -> list:
    """Names of checks whose conclusion is SKIPPED.

    THE FALSE PASS THIS EXISTS TO STOP. On convivy-deck #1 the gate reported
    "PASS — CI green" while `build-test` had never run: its runs fired while the
    PR was a draft, the workflow's `draft == false` gate held the job, and SKIPPED
    counted as passing. `pr-ready` then cleared the draft flag without producing a
    new check run, so the stale skip persisted and the draft block no longer
    applied. Absence of evidence read as evidence, in the direction of confidence,
    inside the tool built to prevent exactly that.

    The caller decides what to do with these: a DRAFT is blocked anyway and its
    skips are expected, but a READY pr with a skipped required check has not been
    tested and must not pass.
    """
    out = []
    for c in _latest_per_check(rollup, path_map):
        if (c.get("conclusion") or "").upper() == "SKIPPED":
            out.append(c.get("name") or c.get("context") or "?")
    return out


_DETAILS_RUN_RE = re.compile(r'actions/runs/(\d+)/')


def _run_id_from_details_url(url: str) -> int | None:
    """Extract a GitHub Actions run ID from a CheckRun detailsUrl.

    detailsUrl format: https://github.com/{o}/{r}/actions/runs/{run_id}/job/{job_id}
    Returns None when the URL is absent, malformed, or carries no run segment.
    """
    m = _DETAILS_RUN_RE.search(url or "")
    if not m:
        return None
    try:
        return int(m.group(1))
    except ValueError:
        return None


def _workflow_path_map(repo: str, sha: str) -> dict[int, str] | None:
    """Return {run_id: workflow_file_path} for all workflow runs on a head SHA.

    Paginates through the REST endpoint so the map is always complete. A
    truncated map serves silently-incomplete path keying, which restores the
    shadow-workflow bypass window the map exists to close: an attacker who
    generates >100 runs on the head SHA can push their shadow run past position
    100 and have it fall back to workflowName keying with no visible signal.

    `--paginate` directs gh to follow Link headers and emit one JSON object per
    run across all pages; the output is NDJSON (one object per line). Each page
    is filtered with `.workflow_runs[] | {id, path}` before gh concatenates them.

    Returns None on any failure (API error, timeout, malformed response, gh not
    available). Callers fall back to workflowName keying and must make the
    degradation visible.
    """
    if not repo or not sha:
        return None
    try:
        r = subprocess.run(
            ["gh", "api", "--paginate",
             f"repos/{repo}/actions/runs?head_sha={sha}&per_page=100",
             "--jq", ".workflow_runs[] | {id, path}"],
            capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    try:
        runs = [json.loads(ln) for ln in r.stdout.splitlines() if ln.strip()]
        return {int(entry["id"]): entry["path"] for entry in runs}
    except (json.JSONDecodeError, KeyError, TypeError, ValueError):
        return None


def _unresolved_run_ids(rollup: list, path_map: dict | None) -> set[int]:
    """Run IDs from rollup detailsUrls that are absent from path_map.

    A non-empty return means those rollup entries fall back to workflowName
    keying — either the map was fetched before those runs existed (a new CI
    run that fired while the poll loop was waiting), or the map is otherwise
    incomplete. Silent fallback restores the shadow-workflow bypass; callers
    must emit a visible warning. Returns an empty set when path_map is None
    (caller already handles that case separately).
    """
    if path_map is None:
        return set()
    missed: set[int] = set()
    for c in rollup or []:
        run_id = _run_id_from_details_url(c.get("detailsUrl") or "")
        if run_id is not None and run_id not in path_map:
            missed.add(run_id)
    return missed


def _unparseable_details_urls(rollup: list, path_map: dict | None) -> set[str]:
    """detailsUrls that are present but contain no parseable run-id.

    A non-empty return means those rollup entries fall back to workflowName
    keying — the detailsUrl is set but does not match the actions/runs/{id}/
    pattern. Distinct from _unresolved_run_ids (run-id parsed but absent from
    the map) and from an absent detailsUrl (legacy StatusContext — normal).
    Returns an empty set when path_map is None (caller handles that separately).
    """
    if path_map is None:
        return set()
    urls: set[str] = set()
    for c in rollup or []:
        url = c.get("detailsUrl") or ""
        if url and _run_id_from_details_url(url) is None:
            urls.add(url)
    return urls


def _latest_per_check(rollup: list, path_map: dict | None = None) -> list:
    """Collapse a rollup to the most recent entry per (WORKFLOW_PATH, check name).

    THE FALSE FAIL THIS FIRST EXISTED TO STOP. A rollup carries SEVERAL entries
    for one check — a draft-time run and the later ready run both appear:

        python: SKIPPED  started=16:52:31
        python: SUCCESS  started=20:41:23

    Evaluating every entry lets one superseded result decide the verdict, both
    ways: a stale SKIPPED made the skip-gate refuse a PR whose suite HAD run
    (caught on this PR against live data), and a stale FAILURE keeps `_ci_is_green`
    red for a check that has since gone green.

    WHY THE KEY IS (WORKFLOW_PATH, NAME) AND NOT (WORKFLOW_NAME, NAME). Keying by
    name alone is a merge-gate bypass a PR branch can weaponize (found in security
    review of PR #182): add a second workflow with a job ALSO named `python` that
    echoes ok and finishes after the real suite; "newest wins" then picks the
    injected SUCCESS and drops the real FAILURE. The fix at #182 included the source
    workflowName in the key — better, but still not tight, because workflowName is
    the YAML `name:` field and two files can share the same name. Keying by the
    workflow FILE PATH (unique — two files cannot share a path) closes the residual:
    an injected job in `.github/workflows/shadow.yml` with `name: ci` lands on key
    (".github/workflows/shadow.yml", "python"), not (".github/workflows/ci.yml",
    "python"), so it cannot shadow the real check, while a genuine re-run (same file,
    same job name) still collapses correctly.

    When `path_map` is None (API call failed or not supplied) the key falls back to
    (workflowName, name) — the pre-path behaviour. That is acceptable degradation
    for the shadow-workflow protection, but callers must make it visible (log a
    warning) rather than letting it pass silently. The merge gate (`cmd_review_status`
    and `_approve_blocked_by_ci`) prints a notice when path_map is None.

    A legacy StatusContext has no workflow; it keys on ("", name) as before.

    UN-EXPANDED MATRIX TEMPLATE PLACEHOLDERS ARE DROPPED (constance-co note,
    2026-07-20; ARCH-384). A check-run whose name still contains a literal `${{`
    (e.g. `Backend tests (shard ${{ matrix.group }}/4)`) exists only because a
    matrix job was skipped BEFORE expansion under draft-gated CI (ARCH-364). It
    never carries a real result — the real shards run as `shard 1/4`…`4/4`, which
    are DIFFERENT names — yet the placeholder's SKIPPED conclusion lingers on the
    head SHA after `pr-ready` expands the real shards. Left in, it is a
    required-and-skipped false-negative on every matrix-CI PR that goes
    draft->ready. It must not enter the required set at all.

    A SKIPPED ENTRY IS TRANSPARENT: the winner for a key is the latest entry that
    carries a REAL result, and a skip is only the winner when nothing real ever ran
    (ARCH-385, reversing #182's `test_a_skip_that_is_the_latest_run_still_fails_the_gate`).
    On one SHA these three sit in the rollup together:

        python: SUCCESS  started=16:52:31
        python: SKIPPED  started=20:41:23

    #182 read that as "newest wins, the newest is a skip, so the suite has no
    evidence it ran" and failed the gate. But the suite demonstrably DID run on
    this exact SHA and passed; the later skip is a context artifact (a re-dispatch
    under a path filter, a concurrency cancel, a draft->ready re-evaluation), not
    a retraction of the run that already happened. Skipping past it restores the
    real evidence.

    WHY NOT "ANY SUCCESS ON THE KEY WINS", the obvious cheaper rule: it hides a
    genuine regression. Given SUCCESS -> FAILURE -> SKIPPED, an any-success rule
    returns the SUCCESS and the gate goes green over a real failure. Taking the
    latest NON-SKIPPED entry returns the FAILURE and stays red. Skips become
    transparent; every other result still obeys newest-wins, so a later FAILURE
    supersedes an earlier SUCCESS exactly as before.

    This cannot be weaponized to bypass the gate: an injected job lands under a
    DIFFERENT (path, name) key per the paragraph above, so it can neither shadow a
    real check nor skip one out of the required set.
    """
    latest: dict = {}
    for i, c in enumerate(rollup or []):
        name = c.get("name") or c.get("context") or "?"
        if "${{" in name:               # un-expanded matrix template placeholder — never a real result
            continue
        wf = c.get("workflowName") or ""
        # Key by workflow file path when the path map is available; fall back to
        # workflowName when the map is absent (API failure, legacy StatusContext,
        # or detailsUrl that doesn't carry a known run-id).
        key_source = wf
        if path_map is not None:
            details_url = c.get("detailsUrl") or ""
            run_id = _run_id_from_details_url(details_url)
            if run_id is not None:
                path = path_map.get(run_id)
                if path is not None:
                    key_source = path
        key = (key_source, name)
        when = c.get("completedAt") or c.get("startedAt") or ""
        # "Real" means "not a skip" — it deliberately includes an IN-FLIGHT entry
        # (conclusion None), which therefore outranks a SKIPPED on the same key.
        # That is correct and not a hole: `_ci_is_green` refuses an empty
        # conclusion outright, so an in-flight winner leaves the gate blocked
        # rather than passing. Read `real` as "carries a result of its own",
        # not as "completed with a meaningful outcome".
        real = (c.get("conclusion") or "").upper() != "SKIPPED"
        prev = latest.get(key)
        # `real` leads the sort key, so any real result outranks every skip on the
        # key; among entries of equal realness, newest still wins.
        if prev is None or (real, when, i) >= (prev[0], prev[1], prev[2]):
            latest[key] = (real, when, i, c)
    return [v[3] for v in latest.values()]


def _ci_is_green(rollup: list, path_map: dict | None = None) -> bool:
    """True iff every check in a `gh statusCheckRollup` is in a passing terminal
    state. A CheckRun passes on conclusion SUCCESS/NEUTRAL/SKIPPED; a legacy
    StatusContext passes on state SUCCESS. Anything else — a failure, or a run
    still in flight (empty conclusion) — fails the gate. Zero checks is vacuously
    green (a repo with no required CI); use --ignore-ci to be explicit there.

    `conclusion` is checked before `state` because GitHub's GraphQL schema sets
    `conclusion` only on a CheckRun (never on a StatusContext), so a present
    `conclusion` unambiguously identifies a CheckRun."""
    for c in _latest_per_check(rollup, path_map):
        concl = (c.get("conclusion") or "").upper()
        state = (c.get("state") or "").upper()
        if concl:                       # CheckRun (GitHub Actions etc.)
            if concl not in _PASS_CONCL:
                return False
        elif state:                     # StatusContext (legacy commit status)
            if state != "SUCCESS":
                return False
        else:                           # in-flight CheckRun: status set, conclusion not
            return False
    return True


CI_BLOCK_RED = 3        # the reviewed commit's CI is genuinely not green
CI_BLOCK_UNKNOWN = 4    # CI could not be read (transient gh/API failure) — retryable
# Distinct from UNKNOWN on purpose (round-1 security-reviewer suggestion). Both are
# retryable, but they want DIFFERENT retries: UNKNOWN means the API failed, so retry
# now; PENDING means the suite is still running, so retry when it finishes. Folding
# them together invites an orchestrator to re-run immediately with a fresh wait
# budget and chain waits indefinitely against a stuck suite. The exit code is the
# only part of this a caller can branch on, so the distinction belongs there and not
# only in the message text.
CI_BLOCK_PENDING = 5    # CI is still RUNNING — retry once the suite finishes

# How long review-post will WAIT for a merely-pending check before refusing, and how
# often it re-reads the rollup. See _split_rollup for why pending is waited on rather
# than refused. 0 disables the wait (refuse immediately), which is what --no-ci-wait
# and the test suite use.
#
# 1800s is chosen from the motivating incident, not picked round: selector #271's
# suite ran ~24 minutes (~1440s). A 900s default was the first draft and the round-1
# reviewer caught that it would NOT have resolved the very case this change exists to
# fix — the reviewer would still have timed out at 15 minutes, with a better message
# but the same stranded review. The budget has to exceed the slowest suite we have
# actually observed, with headroom, or the feature only half-works.
#
# Tune per dispatch with --ci-wait when a repo's suite is slower still.
CI_PENDING_WAIT_SECS = 1800
CI_PENDING_POLL_SECS = 20

# How long `kb merge` waits, after a rebuild's force-push, for the PR API's
# `headRefOid` to catch up to the sha it just pushed — a SEPARATE, much
# shorter budget than CI_PENDING_WAIT_SECS, which waits for CI to run rather
# than for a ref update to propagate. agent-platform#853's first live rebuild
# (knowledge#852, 2026-10-11) saw the lag resolve within seconds: `git
# ls-remote` and a `gh pr view` moments later both already read the rebuilt
# sha, while the read `kb merge` made right after pushing still returned the
# old one. 60s gives wide headroom over that observed lag without leaving a
# genuinely stuck rebuild polling for anywhere near as long as CI_PENDING_WAIT_SECS.
KB_MERGE_HEAD_CATCHUP_WAIT_SECS = 60
KB_MERGE_HEAD_CATCHUP_POLL_SECS = 2

# While CI is merely pending, the wait below re-probes over REST rather than
# GraphQL. REST has its own 5,000/hr pool; GraphQL is the one a day of review work
# drains (a single session exhausted it, and every `gh pr view` in this loop was a
# GraphQL read — up to ~90 per pending APPROVE at the old 20s cadence). The probe
# starts at the same 20s and backs off to a 2-minute ceiling, so a long suite costs
# a handful of cheap REST calls, not one GraphQL read every interval.
CI_SETTLE_POLL_START_SECS = 20
CI_SETTLE_POLL_MAX_SECS = 120


def _gh_api_json(path: str):
    """`gh api <path>` parsed as JSON, or None if the call or parse fails.

    A REST reader (own rate-limit pool), deliberately separate from `_gh_pr_json`,
    which is GraphQL. None on any failure so a caller can fall back rather than
    raise — an unreadable REST budget must never wedge a wait that GraphQL could
    still service."""
    r = subprocess.run(["gh", "api", path], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except (json.JSONDecodeError, ValueError):
        return None


def _ci_settled_rest(repo: str, sha: str):
    """Whether every CI check for `sha` has stopped moving — read over REST.

    This answers ONLY "has the suite settled?", never "did it pass". The
    authoritative green/red verdict stays on the GraphQL `statusCheckRollup` path,
    whose (workflow, name) collapse defeats a superseded run and a same-named-job
    injection (ARCH-380) — semantics REST check-runs cannot cheaply reproduce,
    because it carries no workflow association. So this probe never decides the
    verdict; it only lets the wait loop sleep on the idle REST pool and spend a
    single GraphQL read once the suite settles, instead of one per poll.

    True iff no check run is queued/in_progress AND the combined commit status is
    not a genuine `pending`. None if a read fails — the caller then falls back to a
    GraphQL read on the old cadence.

    The combined-status caveat is load-bearing and confirmed against live data: an
    Actions-only repo (all of ours) reports combined status `state: pending` with
    ZERO contexts permanently, because it has no legacy commit statuses at all.
    Reading that as "not settled" would judge every finished PR forever-running, so
    an empty-and-pending combined status counts as settled; only a `pending` with
    actual contexts is a real in-flight legacy status."""
    if not repo:
        return None
    runs = _gh_api_json(f"repos/{repo}/commits/{sha}/check-runs")
    if runs is None:
        return None
    for run in (runs.get("check_runs") or []):
        if (run.get("status") or "").lower() != "completed":
            return False
    status = _gh_api_json(f"repos/{repo}/commits/{sha}/status")
    if status is None:
        return None
    if (status.get("state") or "").lower() == "pending" and status.get("statuses"):
        return False
    return True


def _await_ci_settle(repo: str, sha: str, deadline: float) -> None:
    """Sleep on the REST budget until `sha`'s checks settle or `deadline` passes.

    Backs off from CI_SETTLE_POLL_START_SECS to CI_SETTLE_POLL_MAX_SECS. Returns as
    soon as REST reports the suite settled, cannot be read (None — fall back to a
    GraphQL read), or the deadline arrives. It never decides the verdict: the caller
    always re-reads the authoritative GraphQL rollup afterwards. Sleeping first, then
    probing, matches the old sleep-then-read order and bounds GraphQL re-reads to no
    more than the old fixed cadence even when REST is unreadable."""
    interval = CI_SETTLE_POLL_START_SECS
    while True:
        remaining = deadline - time.time()
        if remaining <= 0:
            return
        time.sleep(min(interval, max(1, int(remaining))))
        settled = _ci_settled_rest(repo, sha)
        if settled is None or settled:
            return
        interval = min(interval * 2, CI_SETTLE_POLL_MAX_SECS)


def _split_rollup(rollup, path_map: dict | None = None) -> tuple[list[str], list[str]]:
    """Split a statusCheckRollup into (red, pending) label lists.

    The distinction this draws is the point. `_ci_is_green` answers one question —
    "is everything done and passing?" — so a suite still running and a suite that
    FAILED are the same answer to it, and review-post refused both identically.

    They are not the same. A red check is a finding to route. A pending check is
    an absence of information that will resolve on its own in minutes, and
    refusing over it converts a wrong-draft-state mistake into a long blocking
    wait: selector #271 stranded a finished review for ~24 minutes against a
    15-line test-only diff, holding a verdict it was not allowed to post.

    That wait is where completed work goes to die. A dispatched `claude -p` run
    that stops making tool calls ends, and its finished-but-unposted review is
    lost — three runs died that way in one selector session. So the wait belongs
    HERE, inside a short-lived CLI process that is not an LLM and cannot time out
    for want of tool calls, rather than in the agent's own loop.
    """
    red, pending = [], []
    for c in _latest_per_check(rollup, path_map):
        concl = (c.get("conclusion") or "").upper()
        state = (c.get("state") or "").upper()
        name = c.get("name") or c.get("context") or "?"
        if concl:
            if concl not in _PASS_CONCL:
                red.append(f"{name}={concl}")
        elif state:
            if state in ("PENDING", "EXPECTED"):
                pending.append(f"{name}={state}")
            elif state != "SUCCESS":
                red.append(f"{name}={state}")
        else:
            pending.append(f"{name}=IN_PROGRESS")
    return red, pending


def _approve_blocked_by_ci(*, pr: str, repo: str, reviewed_commit: str,
                           wait_secs: int = CI_PENDING_WAIT_SECS) -> tuple[int, str] | None:
    """Why an APPROVE for `reviewed_commit` must NOT be recorded — or None to allow.

    Returns (exit_code, reason). The code separates a CONFIRMED red check
    (CI_BLOCK_RED) from an unreadable one (CI_BLOCK_UNKNOWN), because an orchestrator
    should treat them differently: a GitHub API blip is worth retrying, a red check is
    a finding to route. Both refuse the APPROVE — the distinction is for the caller's
    recovery, never for whether the verdict lands.

    Green required CI is a hard precondition of APPROVE (ARCH-345). Until now that
    invariant lived only in the reviewers' prompts, and overnight on constance #502 it
    simply did not hold: three review rounds recorded APPROVE while a required check
    was red the whole time. The failing tests were in a file the diff never touched —
    exactly the breakage a diff-only read cannot see. A recorded APPROVE over red CI is
    a forged green: the PR carries two Claude signoffs and reads as vetted, which is
    worse than no review at all.

    The merge gate (`review-status`) already refuses to PASS on red CI, but it gates
    the ORCHESTRATOR's ready-to-merge call — it cannot stop the stamp from being
    written, and the stamp is what a human skimming the PR thread sees. So the check
    belongs here too, at the point where the verdict is SHA-pinned and about to become
    a durable claim.

    Fails CLOSED: if CI cannot be read, the APPROVE is refused. A missing answer is not
    a green one, and the whole failure mode being closed is a verdict that outruns its
    evidence. `--ignore-ci` is the deliberate, logged way out.
    """
    try:
        view = _gh_pr_json(pr, ["statusCheckRollup", "headRefOid"], repo or None)
    except (RuntimeError, json.JSONDecodeError) as exc:
        return (CI_BLOCK_UNKNOWN,
                f"could not read CI for PR #{pr} ({exc}). Refusing to record an APPROVE "
                f"over unknown CI — re-run once `gh` can reach the PR, or pass "
                f"--ignore-ci if this repo genuinely has no required checks.")

    head = str(view.get("headRefOid") or "")
    if head and not RP._sha_match(head, reviewed_commit):
        # The re-dispatch advice names --pr, not a sha: `spawn --pr` pins the live head
        # itself. A --review-sha dispatch with no PR records no PR, so its stamp never
        # counts. The recovery path must not be the loop.
        return (CI_BLOCK_RED,
                f"the PR head moved: you reviewed {reviewed_commit[:9]}, the head is now "
                f"{head[:9]}. The CI rollup describes the head, not your commit, so this "
                f"APPROVE cannot be backed by evidence. Re-review the new head "
                f"(re-dispatch with --pr {pr}); an APPROVE at a stale "
                f"commit fails the merge gate anyway (ARCH-184).")

    # Fetch the workflow run → file-path map ONCE, before the loop, but only when
    # the rollup carries at least one CheckRun entry with a detailsUrl — that is
    # the only kind of entry the path join can improve, and it avoids a wasted
    # subprocess call when the rollup is all legacy StatusContexts or uses old
    # test fixtures that pre-date detailsUrl. The map is valid for reviewed_commit
    # at the moment it is built; a CI run that fires AFTER this call will be absent
    # from it. The per-iteration _unresolved_run_ids check below makes that visible
    # rather than silently falling back to workflowName keying, which would restore
    # the shadow-workflow bypass for those entries. When the map itself is unavailable,
    # _split_rollup falls back to workflowName keying — acceptable, but visible
    # (printed below).
    initial_rollup = view.get("statusCheckRollup") or []
    has_details = any(c.get("detailsUrl") for c in initial_rollup)
    path_map = None
    _warned_map_miss: set[int] = set()
    _warned_parse_miss: set[str] = set()
    if repo and has_details:
        path_map = _workflow_path_map(repo, reviewed_commit)
        if path_map is None:
            print(f"review-post: workflow path map unavailable for {reviewed_commit[:9]} "
                  f"— rollup collapse uses workflowName (shadow-workflow protection degraded).",
                  file=sys.stderr)
        else:
            missed = _unresolved_run_ids(initial_rollup, path_map)
            if missed:
                _warned_map_miss.update(missed)
                ids = ", ".join(str(r) for r in sorted(missed))
                print(f"review-post: workflow path map incomplete at {reviewed_commit[:9]} "
                      f"— run id(s) {ids} not mapped; those entries fall back to "
                      f"workflowName keying (shadow-workflow protection degraded).",
                      file=sys.stderr)
            parse_missed = _unparseable_details_urls(initial_rollup, path_map)
            if parse_missed:
                _warned_parse_miss.update(parse_missed)
                n = len(parse_missed)
                print(f"review-post: {n} rollup entr{'y' if n == 1 else 'ies'} at "
                      f"{reviewed_commit[:9]} ha{'s' if n == 1 else 've'} a non-standard "
                      f"detailsUrl — run-id could not be parsed; falling back to workflowName "
                      f"keying (shadow-workflow protection degraded).", file=sys.stderr)

    # Zero checks is vacuously green (a repo with no CI — prose/knowledge PRs), matching
    # _ci_is_green's existing contract, so this does not break those flows.
    #
    # A merely-PENDING check is waited out rather than refused (see _split_rollup). The
    # ARCH-345 invariant is untouched: an APPROVE is still never recorded over non-green
    # CI. All that changes is that "not yet known" stops being treated as "failed".
    deadline = time.time() + max(0, wait_secs)
    while True:
        # RE-CHECK THE HEAD ON EVERY ITERATION, not just once before the loop.
        #
        # The rollup we are about to read describes whatever commit is at the head
        # RIGHT NOW. If a push landed while we slept, that is a different commit
        # from the one being reviewed — and its CI going green would otherwise
        # return None here and stamp an APPROVE, against a commit the reviewer
        # never saw, from a green it did not earn.
        #
        # The ARCH-184 merge gate would refuse that stale stamp, so no bad merge
        # results. But the APPROVE comment still lands on the PR thread and reads
        # as a vetted review, which is precisely the "forged green" this function
        # exists to prevent. Caught by the round-1 security reviewer: the loop was
        # re-fetching headRefOid and then discarding it.
        live_head = str(view.get("headRefOid") or "")
        if live_head and not RP._sha_match(live_head, reviewed_commit):
            return (CI_BLOCK_RED,
                    f"the PR head moved while waiting for CI: you reviewed "
                    f"{reviewed_commit[:9]}, the head is now {live_head[:9]}. The rollup now "
                    f"describes the new head, not your commit, so this APPROVE cannot be "
                    f"backed by evidence. Re-review the new head (re-dispatch with "
                    f"--pr {pr}).")
        rollup = view.get("statusCheckRollup") or []
        # Emit a visible warning for any run-id that appeared in this rollup
        # but is absent from the path_map built before the loop. A new CI run
        # that fires mid-wait (a manual re-run, a concurrency-cancel restart)
        # will carry a fresh run-id the original map never saw; without this
        # check, it falls back to workflowName keying silently — restoring the
        # shadow-workflow bypass for that entry.
        new_missed = _unresolved_run_ids(rollup, path_map) - _warned_map_miss
        if new_missed:
            _warned_map_miss.update(new_missed)
            ids = ", ".join(str(r) for r in sorted(new_missed))
            print(f"review-post: new CI run(s) appeared after path map was built "
                  f"({ids}) — falling back to workflowName keying for those entries "
                  f"(shadow-workflow protection degraded).", file=sys.stderr)
        new_parse_missed = _unparseable_details_urls(rollup, path_map) - _warned_parse_miss
        if new_parse_missed:
            _warned_parse_miss.update(new_parse_missed)
            n = len(new_parse_missed)
            print(f"review-post: {n} rollup entr{'y' if n == 1 else 'ies'} with non-standard "
                  f"detailsUrl appeared after path map was built — run-id could not be parsed; "
                  f"falling back to workflowName keying (shadow-workflow protection degraded).",
                  file=sys.stderr)
        red, pending = _split_rollup(rollup, path_map)
        if not red and not pending:
            return None                      # green (or vacuously green: no checks)
        if red:
            detail = ", ".join(red[:6])
            return (CI_BLOCK_RED,
                    f"required CI is not green at {reviewed_commit[:9]} ({detail}). Green CI "
                    f"is a precondition of APPROVE. Treat the failure as a BLOCKING finding: "
                    f"post REQUEST_CHANGES naming it, and diagnose it — a check failing in a "
                    f"file your diff does not touch is precisely the breakage a diff-only "
                    f"read misses.")
        # pending only
        remaining = deadline - time.time()
        if remaining <= 0:
            detail = ", ".join(pending[:6])
            return (CI_BLOCK_PENDING,
                    f"required CI is still RUNNING at {reviewed_commit[:9]} ({detail}) after "
                    f"waiting {wait_secs}s. Not a failure — the result is simply not known "
                    f"yet, so the APPROVE has nothing to stand on. Re-run this exact "
                    f"review-post once the suite finishes; your review body is unchanged and "
                    f"still valid. (If this PR should have been opened as a DRAFT, that is "
                    f"the actual bug — a draft runs only the cheap lane, per ARCH-364.)")
        print(f"review-post: CI still running at {reviewed_commit[:9]} "
              f"({', '.join(pending[:3])}) — waiting up to {int(remaining)}s rather than "
              f"refusing, so a finished review is not thrown away.", file=sys.stderr)
        # Sleep on the REST budget until the suite settles, then take ONE
        # authoritative GraphQL read. The old loop re-read the GraphQL rollup every
        # 20s (~90 reads per pending APPROVE), which is what drained the shared
        # GraphQL pool; the settle probe moves that polling to the idle REST pool
        # and leaves only the settle-time read on GraphQL. The head-moved re-check,
        # the split, and the fail-closed re-read below are unchanged.
        _await_ci_settle(repo, reviewed_commit, deadline)
        try:
            view = _gh_pr_json(pr, ["statusCheckRollup", "headRefOid"], repo or None)
        except (RuntimeError, json.JSONDecodeError) as exc:
            return (CI_BLOCK_UNKNOWN,
                    f"could not re-read CI for PR #{pr} while waiting ({exc}).")


def _review_record_base() -> tuple[str | None, str]:
    """The Library address the review record goes to: None for the fixed address, or a
    loopback stand-in named by RV.RECORD_URL_ENV. Returns (base, error). A value that
    is not an http address on 127.0.0.1 with a port is an error, never a fallback to the
    fixed address, so a test that misspells the stand-in cannot write to the Library."""
    import urllib.parse
    raw = os.environ.get(RV.RECORD_URL_ENV, "").strip()
    if not raw:
        return None, ""
    parts = urllib.parse.urlsplit(raw)
    if (parts.scheme != "http" or parts.hostname != "127.0.0.1" or parts.port is None
            or parts.path not in ("", "/") or parts.query or parts.fragment
            or parts.username or parts.password):
        return None, f"{RV.RECORD_URL_ENV} must be http://127.0.0.1:<port>, not {raw!r}"
    return f"http://127.0.0.1:{parts.port}", ""


def _post_review_record_to(base: str, fields: dict) -> dict:
    """`IC.post_review_record` aimed at a loopback stand-in (RV.RECORD_URL_ENV). It lives
    here, not in issue_client, so the seam is code this process runs. Several lib modules
    put `~/.local/lib/agent-platform` ahead of this checkout on sys.path, so a copy of
    issue_client from another checkout can load instead. That copy has no seam, and it
    would post to the fixed Library address. Same token, opener and redirect refusal as
    `IC.post_review_record`."""
    import urllib.error
    import urllib.request
    import issue_client as IC
    import vault_plane as VP
    try:
        tok = SC.TOKEN_FILE.read_text().strip() or None
    except OSError:
        tok = None
    if not tok:
        return {"status": "skip", "error": "no Library token available", "record": {}}
    req = urllib.request.Request(
        f"{base}/review-records", data=json.dumps(fields).encode("utf-8"),
        headers=VP.library_headers(token=tok, json_body=True), method="POST")
    try:
        with IC.pinned_opener().open(req, timeout=IC._TIMEOUT) as resp:
            return {"status": "ok", "record": json.loads(resp.read().decode("utf-8"))}
    except urllib.error.HTTPError as e:
        return {"status": f"error:{e.code}", "error": str(e.reason), "record": {}}
    except Exception as e:  # noqa: BLE001 — reported as the status, like IC's
        return {"status": f"error:{e.__class__.__name__}", "error": str(e), "record": {}}


def cmd_review_post(args) -> int:
    """Post a SHA-stamped review verdict to a PR (ARCH-184 phase 2).

    The reviewer writes its prose review to a body file; review-post prepends a
    machine-parseable stamp (review_protocol) whose authoritative fields — the
    exact commit reviewed and the dispatch run-id — are read from the harness env
    the Phase-1 pin set (AGENTCTL_REVIEW_SHA / AGENTCTL_RUN_ID), never typed by
    the agent, then posts the combined comment with `gh pr comment`. The merge
    gate (`agentctl review-status`) trusts that stamp, not the narration: an
    APPROVE can only ever claim the commit the harness actually pinned.

    For the steward's daytime Agent-tool reviewers (no `agentctl spawn`, so no
    env), pass --reviewed-commit / --run-id explicitly; that path is human-
    supervised.
    """
    # A PINNED run (both env vars set) posts the commit and run id the harness
    # pinned. The runless flags below exist for reviews with no dispatch; a pinned
    # reviewer that copies the runless example either stamps a commit the harness
    # never pinned or leaves its PR a draft (agent-platform #154, and #648 round 3,
    # where --no-auto-ready stranded the PR after both reviewers approved).
    pinned_sha = os.environ.get("AGENTCTL_REVIEW_SHA", "")
    pinned_run = os.environ.get("AGENTCTL_RUN_ID", "")
    reviewed_commit = args.reviewed_commit or pinned_sha
    run_id = args.run_id or pinned_run

    # EVAL MODE (the review-replay eval harness, `agentctl spawn --eval-mode`) used
    # to be checked here, reading eval-ness off the run's own meta.json. Round-2
    # revise (agent-platform#813): deleted outright rather than hardened. The run
    # itself can `Write` its own meta.json — that tool is granted unscoped to every
    # review-class dispatch, eval or not (`_WRITE_SCOPE_CAVEAT`,
    # lib/agent-platform/tool_policy.py) — so a value read from meta.json here was
    # never a signal this command could trust; a REAL (non-eval) run could write
    # `eval_mode: true` into its own meta.json and make this command silently skip
    # posting its real review. The actual guarantee an eval replay never posts is
    # the permission layer, not this command: `tool_policy.resolve`'s eval branch
    # grants an eval dispatch neither `gh` nor `Bash(agentctl review-post:*)`, under
    # forced `dontAsk` (`_spawn_claude`'s `enforcing` computation), so an eval
    # replay cannot reach this call at all. It writes its verdict straight to its
    # own run directory instead, via the `Write` tool its allow-list does grant —
    # see `_eval_mode_system_prompt`. Nothing below branches on eval-ness; this
    # command behaves the same for every caller that can actually reach it.

    # ONCE THE LAUNCHER IS INSTALLED, IT POSTS THE VERDICT ITSELF (platform/
    # decisions/0090: "`agentctl review-post` keeps only its runless path").
    # A PINNED invocation (both env vars set) means a dispatched reviewer is
    # calling this directly — exactly the call `review-launch` makes
    # obsolete, since under the launcher a reviewer persona never runs
    # `agentctl` at all; it just prints its verdict as the last line of its
    # own response (round 4 of #732, finding 2 — `review_launch.extract_verdict`
    # reads it from the session's own stdout, never a file) and the launcher
    # posts the comment and the check as root, after the session ends.
    # Refusing here stops a leftover persona prompt from double-posting once
    # the launcher is live. The RUNLESS path (no pinned env — the steward's
    # human-supervised reviews) is unaffected; it carries no run and the
    # launcher has no opinion about it.
    if pinned_run and pinned_sha and _review_launch_path() is not None:
        print("review-post: the review-launch installer is present on this machine, "
              "so a dispatched reviewer no longer posts its own verdict — "
              "review-launch does that itself (as root, after the session ends). "
              "This run's persona should print its verdict as instructed instead of "
              "calling `agentctl review-post`.", file=sys.stderr)
        return 2
    if pinned_run and pinned_sha:
        typed = args.reviewed_commit
        if typed:
            # A typed value passes only as a prefix of the pin, at least 7 hex
            # characters. It is never stamped: `gh api .../commits/<typed>` resolves
            # a branch or tag named like a hex prefix before a sha, so the stamp
            # takes the pin below.
            if not (len(typed) >= 7 and re.fullmatch(r"[0-9a-fA-F]+", typed)
                    and pinned_sha.lower().startswith(typed.lower())):
                print(f"review-post: this run is pinned to {pinned_sha}; --reviewed-commit "
                      f"names {typed}. Drop --reviewed-commit.", file=sys.stderr)
                return 2
            print("review-post: this run is pinned; --reviewed-commit matches the pin "
                  "and is redundant. Drop it.", file=sys.stderr)
        if args.run_id:
            if args.run_id != pinned_run:
                print(f"review-post: this run is pinned to {pinned_run}; --run-id "
                      f"names {args.run_id}. Drop --run-id.", file=sys.stderr)
                return 2
            print("review-post: this run is pinned; --run-id matches the pin "
                  "and is redundant. Drop it.", file=sys.stderr)
        for _flag, _attr in (("--allow-unverified", "allow_unverified"),
                             ("--no-auto-ready", "no_auto_ready")):
            if getattr(args, _attr, False):
                print(f"review-post: this run is pinned, so {_flag} does not apply. "
                      f"Drop {_flag}.", file=sys.stderr)
                return 2
        reviewed_commit = pinned_sha
        run_id = pinned_run
    if not reviewed_commit:
        print("review-post: no reviewed commit. Dispatch the reviewer with "
              "`agentctl spawn <reviewer> --on <repo> --pr <N>` (ARCH-184) so "
              "AGENTCTL_REVIEW_SHA is set to the PR's head and the run records its PR, or "
              "pass --reviewed-commit <sha> explicitly. A `--review-sha` dispatch with no "
              "`--pr` records no PR, so its stamp never counts.", file=sys.stderr)
        return 2

    body_path = Path(args.body_file).expanduser()
    if not body_path.is_file() or body_path.stat().st_size == 0:
        print(f"review-post: empty/missing review body at {body_path}.", file=sys.stderr)
        return 2
    review_body = body_path.read_text().rstrip("\n")

    # A RESCUED review is not this run's review. The rescue file (ARCH-397) is a
    # verbatim copy of what some earlier run wrote and never posted, and it carries
    # a marker for exactly this check. Relaying it would produce a stamp whose
    # run-id and commit are real while the substance is second-hand — possibly of a
    # stale commit, possibly of an analysis that was interrupted — which is ARCH-193
    # authenticity defeated one layer up, in the content behind the stamp rather
    # than in the stamp itself (security-reviewer, PR #395).
    #
    # A refusal rather than a warning, because the readers of that file are agents,
    # and the file already carried a warning. Overridable, because a human who has
    # read the recovered review may legitimately want it posted, and that should
    # cost a deliberate flag.
    # Marker OR digest. The marker catches the untouched file and reads plainly to a
    # human; the digest catches a body someone edited the marker out of, which is a
    # one-line evasion of a control whose whole purpose is to cost more than that
    # (security-reviewer, PR #395 round 2).
    _is_rescue = RESCUED_REVIEW_MARKER in review_body
    if not _is_rescue:
        try:
            if RESCUE_DIGEST_INDEX.exists():
                # SCOPED TO THIS PR. An unbounded content-only index grows a
                # false-positive surface forever: a fresh review whose normalised
                # text collides with any rescue ever recorded would be refused, on
                # a PR that has nothing to do with it (reviewer, PR #395 round 3).
                # A rescue is only relevant to the PR it was written about.
                _want = f"{args.pr}\t{_rescued_digest(review_body)}"
                _known = set(RESCUE_DIGEST_INDEX.read_text().splitlines())
                _is_rescue = _want in _known
        except OSError:
            # A posting path must not break because telemetry is unreadable.
            _is_rescue = False
    if _is_rescue and not getattr(args, "allow_rescued", False):
        print(f"review-post: {body_path} is a RESCUED review — text an earlier run "
              f"wrote and never posted (ARCH-397). Posting it would stamp this run's "
              f"id and commit onto somebody else's analysis, which may have been of a "
              f"different head. Re-dispatch for a real review, or pass "
              f"--allow-rescued if you have read it and mean to post it anyway.",
              file=sys.stderr)
        return 2

    # Two repo forms (ARCH-203). The STAMP gets the short `--on` form so
    # review-status authenticates it against the run registry (a reviewer passes
    # `--repo convivy/constance` from `gh pr view`, but the run records the short
    # `constance`). The `gh pr comment -R` flag below keeps the FULL `owner/repo`
    # form gh documents, so it resolves regardless of the cwd's git remote rather
    # than relying on owner-inference. (review_protocol also basename-normalizes the
    # authenticity compare, so already-posted owner/name stamps still pass.)
    repo_full = args.repo or _gh_repo_slug() or ""
    repo_stamp = repo_full.rsplit("/", 1)[-1]

    # A malformed slug is rejected here rather than basenamed into something that
    # happens to resolve. `--repo convivy/knowledge/extra` used to basename to `extra`,
    # which is not a dispatch target, so the ARCH-392 refusal below would not fire for
    # a review that is in fact on `knowledge` — the gate's own bypass, found in the
    # #197 security review. `review-status` still rejected the result on repo mismatch,
    # so it failed closed, but a control with a known bypass is not one to keep.
    if repo_full and len(repo_full.split("/")) > 2:
        print(f"review-post: --repo {repo_full!r} is not a valid `owner/name` slug.",
              file=sys.stderr)
        return 2

    # Normalize reviewed_commit to the full 40-char SHA at write time so the stamp
    # never carries an ambiguous abbreviation. A caller passing a short SHA via
    # --reviewed-commit (or AGENTCTL_REVIEW_SHA carrying one) would otherwise produce
    # a stamp whose reviewed-commit never compares equal to the 40-char head in
    # review-status, causing a REQUEST_CHANGES to be silently discarded as a stale
    # replay (sous-chef PR #380, 2026-07-27). The reader-side _sha_match in
    # review_protocol handles stamps already posted; this closes the hole at the source.
    if reviewed_commit and len(reviewed_commit) < 40:
        # Gap 1: an empty repo_full means we cannot call the GitHub API to expand the
        # SHA. Fail closed — an abbreviated SHA in a stamp enables collision-assisted
        # prefix forgery via _sha_match's prefix comparison. A caller who cannot supply
        # a repo slug must pass the full 40-char SHA via --reviewed-commit.
        if not repo_full:
            print(f"review-post: cannot normalize abbreviated SHA {reviewed_commit!r} — "
                  f"no repo slug available (neither --repo nor the git remote resolved). "
                  f"Pass the full 40-char SHA in --reviewed-commit to bypass.",
                  file=sys.stderr)
            return 2
        if not re.fullmatch(r'[0-9a-fA-F]{1,40}', reviewed_commit):
            print(f"review-post: skipping SHA normalization — reviewed_commit "
                  f"{reviewed_commit!r} is not a hex SHA", file=sys.stderr)
        else:
            reviewed_commit = reviewed_commit.lower()  # canonical form before gh api call
            try:
                _nr = subprocess.run(
                    ["gh", "api", f"repos/{repo_full}/commits/{reviewed_commit}",
                     "--jq", ".sha"],
                    capture_output=True, text=True, timeout=15)
                if _nr.returncode == 0 and (full_sha := _nr.stdout.strip()) and len(full_sha) == 40:
                    reviewed_commit = full_sha
                elif _nr.returncode != 0:
                    # A 422 Ambiguous response is a clean subprocess exit with non-zero
                    # returncode — not a Python exception. Fail closed: an abbreviated SHA
                    # in a stamp enables collision-assisted prefix forgery via _sha_match.
                    print(f"review-post: SHA normalization failed for {reviewed_commit!r} "
                          f"(gh api exit {_nr.returncode}: {_nr.stderr.strip()!r}); "
                          f"pass the full 40-char SHA in --reviewed-commit to bypass.",
                          file=sys.stderr)
                    return 2
                else:
                    # Gap 2: returncode 0 but the output was not a 40-char SHA (unexpected
                    # GitHub API response format). Fail closed for the same reason as above.
                    print(f"review-post: SHA normalization returned unexpected output for "
                          f"{reviewed_commit!r} (got {_nr.stdout.strip()!r}); "
                          f"pass the full 40-char SHA in --reviewed-commit to bypass.",
                          file=sys.stderr)
                    return 2
            except Exception as e:
                print(f"review-post: SHA normalization failed for {reviewed_commit!r} "
                      f"({e}); pass the full 40-char SHA in --reviewed-commit to bypass.",
                      file=sys.stderr)
                return 2

    # ARCH-392. A stamp with no run-id is one `review-status` DISCARDS, so the thread
    # can read APPROVE while the gate reads FAIL — the two disagree silently, in the
    # direction of false confidence (knowledge #96, orient #100). Two defences, because
    # each covers what the other cannot.
    #
    # First: if the repo IS dispatchable, the verified path was available and this
    # review should never have been posted unverified. Refuse it. Checked before the CI
    # gate because it needs no network, and before the post for the ARCH-345 reason
    # below — a refusal that still commented would itself read as a review.
    #
    # Only APPROVE is refused, on ARCH-345's reasoning: a reviewer must always be able
    # to report bad news, and a discarded REQUEST_CHANGES fails closed anyway (the gate
    # stays FAIL either way). Non-APPROVE gets the warning and posts.
    unverified = not run_id
    dispatchable = unverified and W.is_dispatch_target(repo_stamp)
    # Recorded in BOTH surfaces for the same reason --ignore-ci is: the banner tells a
    # human, the stamp tells review-status and any auditor. On a run-id-less stamp there
    # is no run dir to ask instead, so the stamp field is the only machine-readable
    # record that a verified review was available and was skipped (#197 security review).
    dispatchable_bypassed = bool(getattr(args, "ignore_dispatchable", False)) and dispatchable
    if (dispatchable and args.verdict == "APPROVE" and not args.dry_run
            and not getattr(args, "ignore_dispatchable", False)):
        print(f"review-post: REFUSING to record APPROVE — {repo_stamp!r} is an agentctl "
              f"dispatch target, but this review carries no run-id, so `review-status` "
              f"would discard it and the PR would read APPROVED while the gate reads "
              f"FAIL.\n"
              f"  Dispatch the reviewer natively instead:\n"
              f"    agentctl spawn {args.agent} --on {repo_stamp} --pr {args.pr} --task \"...\"\n"
              f"  That sets AGENTCTL_RUN_ID, so the stamp authenticates and counts.\n"
              f"  (--ignore-dispatchable overrides, and says so on the PR.)",
              file=sys.stderr)
        return 2

    # Second: a run-id-less review on a NON-dispatchable repo (`ask`, which has no
    # primary under <root>/) is legitimate and still discarded by the gate. Nothing
    # in the rendered comment used to say so — an unverified APPROVE was byte-identical
    # to a counted one. Mark it visibly, the same argument as the --ignore-ci banner:
    # an integrity control the reader cannot see is one they will misread.
    if unverified:
        gate_hint = (f"agentctl review-status --pr {args.pr}"
                     + (f" --repo {repo_full}" if repo_full else ""))
        unverified_banner = (
            "> ⚠️ **Not machine-verified.** This review carries no dispatch run-id, so "
            "`agentctl review-status` DISCARDS it and the merge gate does not count it. "
            "Do not read this verdict as clearing the PR — the authoritative answer is "
            f"`{gate_hint}`."
        )
        if dispatchable_bypassed:
            unverified_banner += (
                f"\n>\n> Posted with `--ignore-dispatchable`: `{repo_stamp}` IS an "
                "agentctl target, so a verified review was available and was bypassed.")
    else:
        unverified_banner = ""

    # PERSIST BEFORE ANYTHING THAT CAN BLOCK OR BE KILLED — the CI wait
    # (`_approve_blocked_by_ci`, up to CI_PENDING_WAIT_SECS), the Library write, and
    # the PR comment post are all between here and a landed record, and any of them
    # dying with this process must not lose the review (issue_01M26ZWF6XRY44B1F0HEJ43FVB
    # — see `_persist_review_before_wait`'s docstring for the incident and why this
    # can't instead be a signal handler). Placed AFTER repo resolution, SHA
    # normalization and the ARCH-392 checks above — not before every other check in
    # this function, its original position (security-reviewer PR #725 round 2) —
    # because `repo_stamp` is what the persist now authenticates `run_id` against
    # (see `_persist_review_before_wait`'s docstring): moving it here means that
    # authentication runs on a resolved, normalized value, the same one that is
    # about to be stamped, rather than on args still subject to the checks above.
    #
    # Not itself a refusal: an unresolvable or mismatched `run_id` here still lets
    # this call POST (the ARCH-193 gate at `review-status` time is what discards an
    # inauthentic stamp — the same division of labour every other run-id-shaped
    # value in this function already keeps, e.g. the unverified banner above). Only
    # the WRITE into that run's rescue slot is withheld; see the docstring for why.
    # Skipped for `--dry-run` (nothing here is about to be posted for real) and for
    # an already-rescued relay (`_is_rescue` — re-persisting it would just re-wrap a
    # rescue in itself).
    if not args.dry_run and not _is_rescue:
        _persist_review_before_wait(run_id, str(args.pr), repo_stamp, reviewed_commit,
                                    args.agent, review_body)

    # ARCH-345. Checked BEFORE the comment is posted, so a blocked APPROVE leaves no
    # trace on the PR: a refusal that still posted the prose would read as a review.
    # Only APPROVE is gated — a reviewer must always be able to report bad news, and
    # REQUEST_CHANGES over red CI is exactly the verdict we want.
    #
    # --dry-run is exempt because it posts nothing and so cannot forge a green; gating
    # it would make a rendering preview require the network. It says so, rather than
    # printing a comment that implies the APPROVE would land.
    if args.verdict == "APPROVE" and not getattr(args, "ignore_ci", False) and not args.dry_run:
        blocked = _approve_blocked_by_ci(
            pr=str(args.pr), repo=repo_full, reviewed_commit=reviewed_commit,
            wait_secs=(0 if getattr(args, "no_ci_wait", False)
                       else (getattr(args, "ci_wait", None) or CI_PENDING_WAIT_SECS)))
        if blocked is not None:
            code, why = blocked
            print(f"review-post: REFUSING to record APPROVE — {why}", file=sys.stderr)
            return code

    # An --ignore-ci APPROVE is marked in BOTH surfaces: the stamp (so review-status
    # and any audit can see it) and the visible line (so a human skimming the thread
    # can). Without this the bypassed APPROVE renders byte-identical to a gated one,
    # which makes the escape hatch on an integrity control invisible — the exact
    # "reads as vetted" problem ARCH-345 exists to fix, reintroduced through its own
    # back door.
    ci_bypassed = bool(getattr(args, "ignore_ci", False)) and args.verdict == "APPROVE"
    header = RP.render_header(pr=str(args.pr), repo=repo_stamp,
                             reviewed_commit=reviewed_commit, verdict=args.verdict,
                             agent=args.agent, run_id=run_id, ci_ignored=ci_bypassed,
                             dispatchable_ignored=dispatchable_bypassed)
    visible = (f"**review · {args.agent} → {args.verdict}**  ·  reviewed "
               f"`{reviewed_commit[:9]}`" + (f"  ·  run `{run_id}`" if run_id else ""))
    if ci_bypassed:
        visible += ("\n\n> ⚠️ **CI gate bypassed** (`--ignore-ci`). This APPROVE was recorded "
                    "WITHOUT verifying that the reviewed commit's required checks are green "
                    "(ARCH-345). Do not read it as CI-backed.")
    if unverified_banner:
        visible += f"\n\n{unverified_banner}"
    comment = f"{header}\n\n{visible}\n\n{review_body}\n"

    if args.dry_run:
        loc = f" ({repo_full})" if repo_full else ""
        # When the ARCH-392 refusal WOULD fire, print that instead of the comment. The
        # CI note below is a "might" — dry-run cannot know if CI is red without the
        # network — but this one is deterministic, and rendering a comment that would
        # never be posted reads as a preview of the wrong outcome (#197 review).
        if (dispatchable and args.verdict == "APPROVE"
                and not getattr(args, "ignore_dispatchable", False)):
            print(f"review-post: DRY-RUN — a real post would REFUSE this APPROVE and "
                  f"comment NOTHING: {repo_stamp!r} is an agentctl dispatch target and "
                  f"this review carries no run-id (ARCH-392).\n"
                  f"  Dispatch natively instead:\n"
                  f"    agentctl spawn {args.agent} --on {repo_stamp} --pr {args.pr} "
                  f"--task \"...\"")
            return 0
        print(f"review-post: DRY-RUN — would comment on PR #{args.pr}{loc}:\n{comment}")
        if args.verdict == "APPROVE":
            print("review-post: DRY-RUN did NOT check CI; a real post refuses an "
                  "APPROVE over red CI (ARCH-345).", file=sys.stderr)
        return 0

    # The posting run's own record goes first, so a refusal here leaves no Library
    # record behind. The stamp posted below is held to this verdict and PR by
    # `authenticate` (CQ·399); see `_record_posted_review`. LIMIT: any process running as
    # this user with Bash can get a counted APPROVE no reviewer posted, by claim-first or
    # by a direct write of the record (`_record_posted_review`, `_posted_record_mismatch`).
    refused = _record_posted_review(run_id, pr=str(args.pr), repo_stamp=repo_stamp,
                                    reviewed_commit=reviewed_commit, agent=args.agent,
                                    verdict=args.verdict)
    if refused is not None:
        print(f"review-post: REFUSING to post — {refused}", file=sys.stderr)
        return 2

    # THE LIBRARY'S REVIEW RECORD IS WRITTEN FIRST, AND THE PR SEES NOTHING UNTIL
    # IT LANDS (issue_01M3830J6EKZ394Q8AVYRQGN40, ARCH-193 phase 2 continued). Today
    # a review exists only as a GitHub comment; the Library's record is meant to be
    # its durable copy, so a review that never reaches the Library must never reach
    # the PR either — a comment with no record behind it is exactly the gap this
    # write closes. `role` is the BASE role (never the raw --agent), because the
    # Library's run-facts check (`_review_record_auth`) compares against it: a
    # crew-prefixed run like `svc-reviewer` still records as `reviewer`.
    role = _strip_app_prefix(args.agent)
    repo_identity = f"github:{repo_full}" if repo_full and "/" in repo_full else None
    if repo_identity is None:
        print(f"review-post: cannot write the Library review record — no owner/repo "
              f"slug is known (neither --repo nor the git remote resolved), so "
              f"POSTING NOTHING to the PR. The review text is untouched at "
              f"{body_path}; re-run with --repo <owner/repo> once one is known.",
              file=sys.stderr)
        return 1
    # paths/doc_ids/item_ids: review-post has no flag carrying any of the three
    # today, so all three are sent empty rather than guessed at.
    record_fields = {
        "repo_identity": repo_identity, "reviewed_ref": reviewed_commit, "role": role,
        "verdict": args.verdict, "prose": review_body, "pr": int(args.pr),
        "paths": [], "doc_ids": [], "item_ids": [],
    }
    # A RUNLESS review (--allow-unverified --reviewed-commit, the steward's
    # Agent-tool path) has no run-id to send. The Library then has nothing to
    # verify the record against and stores it `unverified` — never claim more.
    if run_id:
        record_fields["run_id"] = run_id
    import issue_client as IC
    record_base, seam_error = _review_record_base()
    if seam_error:
        print(f"review-post: {seam_error}. POSTING NOTHING to the PR.", file=sys.stderr)
        return 2
    if record_base:
        lib_result = _post_review_record_to(record_base, record_fields)
    else:
        lib_result = IC.post_review_record(record_fields)
    if lib_result.get("status") != "ok":
        lib_status = lib_result.get("status", "")
        lib_error = lib_result.get("error", "")
        # 503 from `POST /review-records` means the Library's own run-facts read
        # came back unavailable, or the Library is not yet the write path — both
        # TRANSIENT refusals (the route's own docstring), never a rejected review.
        # Every other status (a 4xx validation refusal, an unreachable Library, a
        # bad response) is reported as-is, naming both what the Library said and
        # what failed.
        transient = lib_status in ("error:503",)
        kind = "is TRANSIENT (retry)" if transient else "was REFUSED"
        # ARCH-397's downgrade (`_finalize_run`) reads this marker to tell a Library
        # refusal apart from every other reason a called review-post could leave no
        # stamp — without it, that check can only guess the pre-Library-write cause
        # (the PR head moving), which is wrong here (issue_01M3830J6EKZ394Q8AVYRQGN40
        # round 2). A runless review has no run dir to write into, and the write is
        # best-effort like every other rescue write in this file: it must never turn
        # a correctly-refused post into a crash.
        run_dir = _find_run_dir(run_id) if run_id else None
        if run_dir is not None:
            try:
                T.write_owner_only(
                    run_dir / _LIBRARY_REFUSAL_MARKER_FILENAME,
                    json.dumps({"status": lib_status, "error": lib_error}))
            except OSError:
                pass
        # `body_path` lives in this run's own worktree, which is reaped once the run
        # ends (ARCH-344) — by the time anyone reads this stderr line the file it
        # names may already be gone. When a run dir is known, point at the durable
        # rescue path instead: ARCH-397 recovers this same review text into it at
        # finalize time, survives the reap, and re-posting from there needs
        # --allow-rescued (`_rescue_unposted_review_inner`'s marker check refuses an
        # unflagged rescued body).
        if run_dir is not None:
            rescued_path = run_dir / "unposted-review.md"
            where = (f"This run's review text is untouched at {body_path} for now, "
                     f"but that worktree does not outlive the run. Once this run "
                     f"finalizes, ARCH-397 recovers the same text to {rescued_path}, "
                     f"which does. Read it there and re-post once the Library is "
                     f"reachable with `agentctl review-post --pr {args.pr} --verdict "
                     f"{args.verdict} --agent {args.agent} --body-file {rescued_path} "
                     f"--repo {repo_full} --reviewed-commit {reviewed_commit} "
                     f"--run-id {run_id} --allow-rescued`.")
        else:
            _extra = f" --reviewed-commit {reviewed_commit}"
            _extra += f" --run-id {run_id}" if run_id else " --allow-unverified"
            where = (f"The review text is untouched at {body_path}; once the Library "
                     f"is reachable, re-run `agentctl review-post --pr "
                     f"{args.pr} --verdict {args.verdict} --agent {args.agent} "
                     f"--body-file {body_path} --repo {repo_full}{_extra}`.")
        print(f"review-post: the Library review-record write {kind} "
              f"({lib_status}: {lib_error}) — POSTING NOTHING to the PR: a review "
              f"with no durable Library record must not reach it. {where}",
              file=sys.stderr)
        return 1

    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as tf:
        tf.write(comment)
        tmp = tf.name
    try:
        cmd = ["gh", "pr", "comment", str(args.pr), "--body-file", tmp]
        if repo_full:
            cmd += ["-R", repo_full]
        r = subprocess.run(cmd, capture_output=True, text=True)
    finally:
        os.unlink(tmp)
    if r.returncode != 0:
        print(f"review-post: gh pr comment FAILED: {r.stderr.strip()}", file=sys.stderr)
        return 1
    print(r.stdout.strip() or
          f"review-post: posted {args.verdict} on PR #{args.pr} (reviewed {reviewed_commit[:9]}).")

    # Take the PR out of draft the moment this APPROVE completes the required set
    # (ARCH-364). Under draft-gated CI a PR that nobody marks ready is stranded:
    # the full suite never runs and GitHub refuses to merge a draft. Doing it here
    # rather than as a step each orchestrator must remember is deliberate —
    # forgetting that step is exactly what strands the PR, and this is the one
    # chokepoint every roster reviewer already goes through.
    #
    # Best-effort by design: a failure here must never turn a successfully-posted
    # review into a nonzero exit, or a reviewer would look like it failed when its
    # verdict actually landed.
    if (args.verdict == "APPROVE" and not args.dry_run
            and not getattr(args, "no_auto_ready", False)):
        try:
            code, msg = _mark_pr_ready(pr=str(args.pr), repo=repo_full,
                                       required=list(_REVIEW_AGENTS),
                                       allow_unverified=getattr(args, "allow_unverified", False))
            # code 1 is the ordinary "the other reviewer hasn't approved yet" case.
            print(f"review-post: auto-ready — {msg}" if code == 0
                  else f"review-post: not marking ready yet — {msg.splitlines()[0]}")
        except Exception as e:                                    # noqa: BLE001
            print(f"review-post: auto-ready check failed (non-fatal): {e}",
                  file=sys.stderr)
    return 0


def cmd_policy(args) -> int:
    """Print an agent's effective tool policy for a runtime (ARCH-346).

    The whole point of this command is that the answer used to be un-lookupable: you
    had to know that `claude -p` ignores `tools:` while Claude Code enforces it, and
    that a Task subagent inside an autonomous run sits on the other side of that line.
    Now you ask.
    """
    runtime = args.runtime
    if TP is None:
        print("error: tool_policy is not installed — run install.sh to link "
              "lib/agent-platform/tool_policy.py into ~/.local/lib/agent-platform/",
              file=sys.stderr)
        return 2
    # THE MODEL IS NOT OPTIONAL TO THE LIBRARY. Its policy endpoint answers
    # 400 {"error":"model is required"} without one, and `policy_client.resolve`
    # omits the parameter when `model` is None — so this command reported
    # "Library unavailable (HTTP Error 400)" and "this run was NOT checked
    # against operator-set tool policy" for every agent on every repo, while a
    # real spawn WAS being checked. The command operators use to inspect policy
    # was the one place giving the wrong answer about it.
    #
    # Resolved the same way the spawn path does (`default_model` at the spawn
    # site) so this command reports the policy of the model that would actually
    # run, rather than a second opinion about it. A roster miss degrades to None.
    # The Library answers a model-less policy call with 400, so `_disallowed_tools`
    # refuses and this command exits non-zero with that refusal.
    # `except (Exception, SystemExit)` — NOT bare `except Exception`. `resolve_agent`
    # calls `die()`, which is `sys.exit()`, and SystemExit derives from
    # BaseException rather than Exception, so a plain `except Exception` lets it
    # straight through. With the Library unreachable, `resolve_agent` refuses
    # with SystemExit, and resolving the agent to get its model would then KILL
    # the command outright — a strictly worse failure than the 400 this fix
    # exists to remove. CI caught the index-missing form of this; every dev
    # machine had the index, so a local run could not.
    try:
        _policy_agent = resolve_agent(args.agent, args.on)
        _policy_model = model_id(_policy_agent.get("model_alias"))
    except (Exception, SystemExit):
        _policy_model = None
    policy = TP.resolve(args.agent, runtime, args.on,
                        denied=_disallowed_tools(args.agent, args.on,
                                                 model=_policy_model))
    if args.json:
        rec = policy.as_dict()
        rec["enforcement_active"] = bool(policy.enforced and _enforce_tool_policy())
        print(json.dumps(rec, indent=2))
        return 0

    active = policy.enforced and (runtime == TP.INTERACTIVE or _enforce_tool_policy())
    print(f"agent:    {policy.agent}")
    print(f"runtime:  {runtime}")
    print(f"repo:     {policy.repo or '(none)'}")
    print(f"enforced: {policy.enforced}"
          + ("" if policy.enforced else "   <-- deny-list is the ONLY control here"))
    if runtime == TP.AUTONOMOUS and policy.enforced and not _enforce_tool_policy():
        print("          (allow-list RESOLVED but not applied — "
              "AGENTCTL_ENFORCE_TOOL_POLICY is off)")
    print(f"why:      {policy.reason}")
    if policy.allowed:
        print("allowed:")
        for t in policy.allowed:
            print(f"  + {t}")
    if policy.denied:
        print("denied:")
        for t in policy.denied:
            print(f"  - {t}")
    for n in policy.notes:
        print(f"note:     {n}")
    if runtime == TP.AUTONOMOUS:
        mode = TP.MODE_ENFORCE if active else TP.MODE_BYPASS
        print(f"\nEFFECTIVE: --permission-mode {mode}")
        if active:
            print("           anything outside `allowed` is DENIED (plus built-in "
                  "read-only Bash, which the mode permits).")
        else:
            print("           every tool EXCEPT the denied list is auto-approved.")
    return 0


_AUTHZ_RUN_DIR_PREFIXES = ("run-", "sub-")  # dispatched agent runs and their Task
                                             # subagents — NOT the "co-*" interactive
                                             # session dirs cost_join.py excludes the
                                             # same way, since ADR-0057's shell-call
                                             # shares are measured over dispatched runs.


def _authz_resolve_run_dirs(args) -> "list[Path] | None":
    """Resolve every run dir an `authz replay` invocation names: each
    positional `run` (a run-id or a run-dir path), plus every dispatched run
    on or after `--all-since`. Prints a diagnostic and returns None the first
    time a positional does not resolve; `--all-since` silently skips a run
    dir missing `meta.json` or `tool_calls.jsonl` rather than failing the
    whole replay over one short-lived or truncated run."""
    dirs: list[Path] = []
    for ref in args.run:
        p = Path(ref)
        if p.is_dir() and (p / "meta.json").exists():
            dirs.append(p.resolve())
            continue
        run_dir, code = _resolve_run_dir_for_diagnostic(ref)
        if run_dir is None:
            return None
        dirs.append(run_dir)
    if args.all_since:
        try:
            start = datetime.strptime(args.all_since, "%Y-%m-%d").date()
        except ValueError:
            print(f"authz replay: --all-since must be YYYY-MM-DD, got "
                  f"{args.all_since!r}", file=sys.stderr)
            return None
        for day_dir in sorted(RUNS_ROOT.iterdir()):
            if not day_dir.is_dir():
                continue
            try:
                day = datetime.strptime(day_dir.name, "%Y-%m-%d").date()
            except ValueError:
                continue
            if day < start:
                continue
            for run_dir in sorted(day_dir.iterdir()):
                if not run_dir.is_dir() or not run_dir.name.startswith(_AUTHZ_RUN_DIR_PREFIXES):
                    continue
                if (run_dir / "meta.json").exists() and (run_dir / "tool_calls.jsonl").exists():
                    dirs.append(run_dir)
    return dirs


def cmd_authz_replay(args) -> int:
    """Replay recorded `tool_calls.jsonl` through `bosun_authz.decide()` —
    read-only, writes nothing (issue_01M174BDTWWJCDMN8GMJVCWXQ4).

    This is the re-measurement platform/decisions/0057 calls for: that
    decision's 54%/80%/80% shell-call shares were measured once, and this is
    how a later reader checks whether they still hold. For each run, the
    session grant is `bosun_authz.grant_from_meta(meta)` — a proxy built from
    the run's own `meta.json`, not a real declared ceiling (see that
    function's docstring) — and the permission set is read from the run's own
    `policy.json` if it wrote one.
    """
    if AU is None:
        print("error: bosun_authz is not installed — run install.sh to link "
              "lib/agent-platform/bosun_authz.py into ~/.local/lib/agent-platform/",
              file=sys.stderr)
        return 2
    run_dirs = _authz_resolve_run_dirs(args)
    if run_dirs is None:
        return 1
    if not run_dirs:
        print("authz replay: no run directories to replay", file=sys.stderr)
        return 1

    now = datetime.now(timezone.utc)
    by_class: Counter = Counter()
    by_verdict: Counter = Counter()
    by_class_verdict: Counter = Counter()
    per_run = []
    for run_dir in run_dirs:
        try:
            meta = T.read_meta(run_dir)
        except (OSError, ValueError) as e:
            print(f"authz replay: {run_dir}: unreadable meta.json ({e})", file=sys.stderr)
            continue
        policy_record = None
        policy_path = run_dir / "policy.json"
        if policy_path.exists():
            try:
                policy_record = json.loads(policy_path.read_text())
            except (OSError, ValueError):
                policy_record = None
        try:
            grant = AU.grant_from_meta(meta)
        except (OSError, ValueError) as e:
            print(f"authz replay: {run_dir}: unreadable worktree in meta.json ({e})",
                  file=sys.stderr)
            continue
        permissions = AU.permissions_from_policy_record(policy_record)
        try:
            requests = list(T.iter_tool_calls(run_dir))
        except (OSError, ValueError) as e:
            print(f"authz replay: {run_dir}: unreadable tool_calls.jsonl ({e})",
                  file=sys.stderr)
            continue
        summary = AU.replay(requests, grant, permissions, now)
        by_class.update(summary.by_class)
        by_verdict.update(summary.by_verdict)
        by_class_verdict.update(summary.by_class_verdict)
        per_run.append({"run_id": meta.get("run_id"), "agent": meta.get("agent"),
                        **summary.as_dict()})

    total = sum(by_class.values())
    if args.json:
        print(json.dumps({
            "runs_replayed": len(per_run),
            "total_calls": total,
            "by_class": dict(by_class),
            "by_verdict": dict(by_verdict),
            "by_class_verdict": dict(by_class_verdict),
            "per_run": per_run,
        }, indent=2))
        return 0

    print(f"authz replay: {len(per_run)} run(s), {total} tool call(s)")
    for kind in (AU.NAMES_TARGET, AU.EXECUTES):
        n = by_class.get(kind, 0)
        pct = (100.0 * n / total) if total else 0.0
        print(f"  {kind:<14} {n:>7}  ({pct:5.1f}%)")
    for key in sorted(by_class_verdict):
        print(f"    {key:<24} {by_class_verdict[key]}")
    return 0


def _resolve_run_facts(run_id: str) -> "RP.RunFacts":
    """Thin wrapper over the shared loader (review_protocol.resolve_run_facts),
    bound to this process's own RUNS_ROOT the same way `_find_run_dir` is
    above. This is the I/O half of stamp authentication; the pure policy
    lives in review_protocol.authenticate. bin/run-register-api's
    `_facts_payload` calls the same shared loader directly, so the merge gate
    and the Library's run-verified check can never disagree about a run's
    facts."""
    return RP.resolve_run_facts(run_id, RUNS_ROOT)


def _head_advanced_beyond_pin(pin: str, head: str, repo: str) -> bool | None:
    """True iff the PR's live `head` is a forward descendant of the run's `pin` —
    the branch advanced past the pin while the review was in flight
    (issue_01KYRQBNXRHB2PT8BKKNEW745V). Uses the GitHub compare API
    (`repos/{owner}/{repo}/compare/{pin}...{head}`): status `ahead` means every pin
    commit is in head, i.e. pin is an ancestor of head. False when the compare
    succeeds and is not `ahead` (head diverged, sits behind, or is identical), and
    None when it cannot be determined at all (no repo slug, gh failure) — the caller
    fails closed and keeps the stale-replay rejection."""
    if not pin or not head or not repo:
        return None
    slug = repo if "/" in repo else f"convivy/{repo}"
    try:
        r = subprocess.run(
            ["gh", "api", f"repos/{slug}/compare/{pin}...{head}", "--jq", ".status"],
            capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return None
        return r.stdout.strip() == "ahead"
    except Exception:                                    # noqa: BLE001
        return None


def _authenticated_stamps(view: dict, *, allow_unverified: bool, echo: bool = True,
                          repo: str = "", pr: str) -> list:
    """Every review stamp on the PR that survives ARCH-193 authentication.

    `pr` is the PR the caller is evaluating. A stamp recorded for any other PR is
    dropped, even when its run is genuine (CQ·399).

    Factored out of cmd_review_status so `pr-ready` decides on exactly the same
    stamps the merge gate will later read. Two copies of this logic would drift,
    and the failure mode of drift here is a PR marked ready off a stamp the gate
    would have rejected.

    `repo` feeds the head-advance disambiguation (issue_01KYRQBNXRHB2PT8BKKNEW745V):
    when the commit-binding check rejects a stamp, ask whether the PR head simply
    advanced past the run's pin during the review — a benign race — rather than a
    replay. The stamp is dropped either way; the question is only how the rejection
    reads. `head` comes from the view's headRefOid, which both callers already fetch.
    """
    stamps = []
    head = (view.get("headRefOid") or "").strip()
    for c in view.get("comments") or []:
        s = RP.parse(c.get("body", ""))
        if s is None:
            continue
        if allow_unverified and not s.run_id and str(s.pr) == str(pr):
            # human-supervised carve-out: only for run-id-less stamps, and only for
            # the PR being evaluated (a copy of another PR's stamp has no run to check)
            stamps.append(s)
            continue
        facts = _resolve_run_facts(s.run_id)
        reason = RP.authenticate(s, facts, pr=pr, review_agents=_REVIEW_AGENTS)
        if reason is None:
            s.pinned_sha = facts.review_sha   # from meta.json, never from the comment
            stamps.append(s)
        else:
            # Head-advance disambiguation: asked only when the commit-binding check
            # fired (recognised by the STALE_REPLAY_MARKER token, not the message's
            # prose, so a reword cannot silently kill this), and only then — one
            # compare call per rejected stamp, never on the happy path. Anything
            # indeterminate (False or None) keeps the rejection; fail closed.
            if _STALE_REPLAY_MARKER in reason and _head_advanced_beyond_pin(
                    facts.review_sha, head, repo):
                reason = RP.authenticate(s, facts, pr=pr, review_agents=_REVIEW_AGENTS,
                                         head_advanced=True)
            if echo:
                print(f"  (ignoring unauthenticated stamp from "
                      f"{s.agent or '?'} → {s.verdict}: {reason})")
    return stamps


def _mark_pr_ready(*, pr: str, repo: str, required: list, allow_unverified: bool) -> tuple[int, str]:
    """Take a draft PR out of draft once its review cycle has cleared (ARCH-364).

    Returns (exit_code, message). Code 0 means "ready now" — either this call
    marked it, or it was already out of draft.

    CI is deliberately NOT part of this decision. Under ARCH-364 the review cycle
    runs against the DRAFT, where the expensive jobs are skipped on purpose, so
    requiring green CI here would mean requiring the very suite that marking
    ready is what triggers. The ordering is: reviewers approve -> mark ready ->
    full suite runs -> `review-status` gates the merge on that suite. This
    function owns the first arrow only.
    """
    try:
        view = _gh_pr_json(pr, ["headRefOid", "comments", "isDraft", "state"], repo=repo)
    except (RuntimeError, json.JSONDecodeError) as e:
        return 2, f"cannot read PR #{pr}: {e}"

    if (view.get("state") or "").upper() != "OPEN":
        return 2, f"PR #{pr} is not open ({view.get('state')})."
    if not view.get("isDraft"):
        return 0, f"PR #{pr} is already ready for review; nothing to do."

    head = (view.get("headRefOid") or "").strip()
    if not head:
        return 2, f"PR #{pr} has no head commit."

    # echo=False: on the review-post auto-ready path these diagnostics would
    # interleave into that command's output without its prefix. A direct
    # `review-status` / `pr-ready` call is where they belong, and both still
    # surface them through their own reporting.
    stamps = _authenticated_stamps(view, allow_unverified=allow_unverified, echo=False,
                                   repo=repo, pr=pr)
    # ci_green=True: see the docstring — CI is the NEXT gate, not this one.
    result = RP.evaluate_gate(head=head, stamps=stamps, required_agents=required,
                              ci_green=True)
    if not result.ok:
        return 1, (f"PR #{pr} head {head[:9]} — NOT ready to leave draft:\n  - "
                   + "\n  - ".join(result.reasons))

    r = subprocess.run(["gh", "pr", "ready", str(pr), "-R", repo] if repo
                       else ["gh", "pr", "ready", str(pr)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return 2, f"`gh pr ready` failed for PR #{pr}: {r.stderr.strip()}"

    # TOCTOU: a push can land between reading `head` above and `gh pr ready`
    # returning, which would take the PR out of draft on stamps that were valid
    # for the PREVIOUS head — leaving the newest commit unreviewed at the moment
    # the PR enters the merge queue. This is not a merge-gate bypass, because
    # `review-status` re-checks staleness against the head at merge time and
    # fails a stamp that no longer matches. But "appears ready, newest commit
    # unreviewed" is a misleading state to leave silently, so say so.
    try:
        after = _gh_pr_json(pr, ["headRefOid"], repo=repo)
        moved = (after.get("headRefOid") or "").strip()
    except (RuntimeError, json.JSONDecodeError):
        moved = ""      # best-effort: never fail the mark-ready over this check
    if moved and moved != head:
        return 0, (f"PR #{pr} marked ready, but the head MOVED during the call "
                   f"({head[:9]} -> {moved[:9]}). The approvals were for "
                   f"{head[:9]}, so the newest commit is unreviewed — re-review "
                   f"before merging. `review-status` will fail on the stale "
                   f"stamps until you do.")

    return 0, (f"PR #{pr} marked ready for review — all required reviewers "
               f"({', '.join(required)}) APPROVE at head {head[:9]}. "
               f"The full suite runs now; `review-status` gates the merge on it.")


def cmd_pr_ready(args) -> int:
    """Mark a draft PR ready once its review cycle has cleared (ARCH-364)."""
    repo = args.repo or _gh_repo_slug() or ""
    required = args.required or list(_REVIEW_AGENTS)
    code, msg = _mark_pr_ready(pr=str(args.pr), repo=repo, required=required,
                               allow_unverified=getattr(args, "allow_unverified", False))
    print(f"pr-ready: {msg}", file=sys.stderr if code else sys.stdout)
    return code


class ReviewStatusResult(NamedTuple):
    """`review-status`'s PASS/FAIL decision, as data rather than printed text
    (`docs merge`, issue_01M3SGQ4QTQ8FB0DN0X9G54ZXP) — so an in-process caller
    gates on the exact computation `cmd_review_status` prints, instead of
    running it as a subprocess and parsing stdout.

    `read_error` is set when the PR itself could not be read or carries no
    head commit; nothing else on the result is meaningful then. `terminal` is
    `"merged"` or `"closed"` for a PR `cmd_review_status` reports specially
    rather than running the review/CI decision at all — `ok` is True for a
    merged PR (its own exit 0, "nothing to gate") and False for a closed one
    (its exit 1), matching `cmd_review_status`'s behavior exactly. Otherwise
    `ok`/`reasons`/`head`/`stamps` are the full decision: `reasons` is empty
    iff `ok`, and `stamps` are the authenticated review stamps this decision
    read, so a caller that also needs them (rounds-per-role) does not
    re-authenticate.

    A NamedTuple, not a dataclass: `bin/agentctl` is loaded by the test suite
    as a module never registered in `sys.modules` (`tests/conftest.py`'s
    `_load_cli`), and `@dataclass` on a class whose module isn't there fails
    at class-definition time trying to resolve ClassVar/InitVar annotations.
    """
    ok: bool
    head: str
    reasons: list
    stamps: list
    read_error: str | None = None
    terminal: str | None = None
    merged_at: str | None = None


def _review_status_decision(pr, repo, required, *, allow_unverified=False,
                            ignore_ci=False) -> "ReviewStatusResult":
    """The decision `agentctl review-status` prints (ARCH-184 phase 2), with no
    printing of its own beyond the same degraded-fallback warnings
    `cmd_review_status` has always emitted to stderr while building the CI
    picture — an in-process caller sees exactly what the CLI's user does.

    Reads every review stamp on the PR, the current head SHA, and CI, then asks
    review_protocol.evaluate_gate: PASS iff every required reviewer's LATEST stamp
    is an APPROVE whose reviewed-commit == the PR's current head, AND CI is green.
    A reviewer whose APPROVE sits at an older commit is stale — the head moved
    under it — and fails the gate (the deterministic form of 're-review every
    revision'). The gate never consults narration: a 'merge anyway' comment
    carries no stamp and is invisible to it.

    Authenticity (ARCH-193): before the gate runs, every stamp is authenticated
    against the dispatch run it claims — a stamp whose run-id is not a real
    review-class run (a worker that forged the comment under bypassPermissions) is
    dropped with a printed reason and never counted. `allow_unverified` admits a
    stamp that carries NO run-id (the steward's human-supervised Agent-tool path,
    which has no run dir); it never admits a stamp whose run-id is present but wrong.

    `cmd_review_status` is a thin printer over this function; `docs merge` is the
    second caller, reading `ok`/`reasons`/`head`/`stamps` directly.
    """
    fields = ["headRefOid", "comments", "statusCheckRollup", "state", "isDraft",
              "mergeable", "mergeStateStatus", "baseRefName", "mergedAt"]
    try:
        view = _gh_pr_json(pr, fields, repo=repo)
    except (RuntimeError, json.JSONDecodeError) as e:
        return ReviewStatusResult(ok=False, head="", reasons=[], stamps=[],
                                  read_error=f"cannot read PR #{pr}: {e}")

    head = (view.get("headRefOid") or "").strip()
    if not head:
        return ReviewStatusResult(
            ok=False, head="", reasons=[], stamps=[],
            read_error=f"PR #{pr} has no head commit (closed/merged?).")

    # GitHub returns mergeable: UNKNOWN and mergeStateStatus: UNKNOWN for merged
    # (and closed) PRs — indistinguishable from the transient-computation state the
    # UNKNOWN message describes. Check state first so terminal PRs never reach the
    # mergeability branch.
    pr_state = (view.get("state") or "OPEN").upper()
    if pr_state == "MERGED":
        return ReviewStatusResult(
            ok=True, head=head, reasons=[], stamps=[], terminal="merged",
            merged_at=view.get("mergedAt") or "unknown time")
    if pr_state == "CLOSED":
        return ReviewStatusResult(ok=False, head=head, reasons=[], stamps=[],
                                  terminal="closed")

    stamps = _authenticated_stamps(view, allow_unverified=allow_unverified,
                                   repo=repo or "", pr=str(pr))

    # Fetch the workflow run → file-path map once. Both _ci_is_green and
    # _skipped_checks consume it so one call serves both. Only fetched when the
    # rollup carries at least one CheckRun with a detailsUrl — the only entries
    # that can be path-resolved. Legacy StatusContext rollups (no detailsUrl) and
    # test fixtures that predate the field get path_map=None, which safely falls
    # back to workflowName keying with no extra subprocess call.
    rollup = view.get("statusCheckRollup") or []
    has_details = any(c.get("detailsUrl") for c in rollup)
    path_map = None
    if not ignore_ci and has_details:
        path_map = _workflow_path_map(repo, head)
        if path_map is None:
            print("review-status: workflow path map unavailable — rollup collapse "
                  "uses workflowName (shadow-workflow protection degraded).",
                  file=sys.stderr)
        else:
            missed = _unresolved_run_ids(rollup, path_map)
            if missed:
                ids = ", ".join(str(r) for r in sorted(missed))
                print(f"review-status: workflow path map incomplete — run id(s) {ids} "
                      f"not mapped; those entries fall back to workflowName keying "
                      f"(shadow-workflow protection degraded).", file=sys.stderr)
            parse_missed = _unparseable_details_urls(rollup, path_map)
            if parse_missed:
                n = len(parse_missed)
                print(f"review-status: {n} rollup entr{'y' if n == 1 else 'ies'} with "
                      f"non-standard detailsUrl — run-id could not be parsed; falling back "
                      f"to workflowName keying (shadow-workflow protection degraded).",
                      file=sys.stderr)

    ci_green = True if ignore_ci else _ci_is_green(rollup, path_map)
    result = RP.evaluate_gate(head=head, stamps=stamps, required_agents=required,
                             ci_green=ci_green)

    # A draft can never pass the merge gate (ARCH-364). Under draft-gated CI the
    # expensive jobs report `skipped` while the PR is a draft, and _ci_is_green
    # counts SKIPPED as passing — correctly, since a deliberately-skipped job is
    # not a failure. But that means a draft whose only green is the cheap lint
    # lane would otherwise satisfy this gate, which would have it assert the
    # suite passed when the suite never ran. GitHub refuses to merge a draft
    # anyway; this makes the gate say so itself rather than leaning on that.
    draft_block = bool(view.get("isDraft"))

    # A READY pr with skipped checks has not been tested. While the PR was a
    # draft those skips were expected and harmless — the draft block refused it
    # regardless. Once `pr-ready` clears the flag, nothing re-runs the suite on
    # its own, so the stale skip would otherwise satisfy this gate and assert a
    # suite that never executed. Push a commit or re-run the workflow.
    skipped = [] if (ignore_ci or draft_block) else _skipped_checks(rollup, path_map)

    # THE EMPTY-ROLLUP TWIN. Zero checks is treated as vacuously green, which is
    # right for a repo with no CI and wrong for one whose suite simply never
    # scheduled — a deleted or broken workflow file, or a run that never fired.
    # Distinguish the two by asking whether the repo has any active workflow at
    # all. Unreadable (None) does not block: a gh blip must not wedge the gate.
    no_checks_ran = False
    if not ignore_ci and not draft_block and not rollup:
        no_checks_ran = _repo_has_ci_workflows(repo) is True

    # Mergeability — checked after the review/CI gate so its reason lines sort last
    # and are visually distinct from reviewer/CI failures.
    #
    # GitHub computes `mergeable` asynchronously; it returns UNKNOWN for a window
    # after any push to the base branch. UNKNOWN is treated as PENDING here — a
    # gate that passes on "I don't know" is indistinguishable from a gate that
    # never checks, which is the failure class this fix exists to close.
    mergeable = (view.get("mergeable") or "UNKNOWN").upper()
    merge_state = (view.get("mergeStateStatus") or "UNKNOWN").upper()
    base = view.get("baseRefName") or "base"
    merge_conflict = (mergeable == "CONFLICTING" or merge_state == "DIRTY")
    merge_pending = (mergeable == "UNKNOWN" and not merge_conflict)

    reasons = list(result.reasons)
    if draft_block:
        reasons.append("PR is still a DRAFT: its full suite has not run (the expensive "
                       "jobs report `skipped`), so green CI here does not mean tested. "
                       "Run `agentctl pr-ready --pr N` once the reviewers approve.")
    if no_checks_ran:
        reasons.append("NO checks reported at all, but the repo has active workflows: "
                       "the suite never ran for this commit. A missing run is not a "
                       "passing one. (`--ignore-ci` overrides.)")
    if skipped:
        reasons.append(f"required check(s) reported `skipped` with no real result: "
                       f"{', '.join(sorted(skipped))}. A skip is not evidence the suite "
                       f"ran — under draft-gated CI a job skips while the PR is a draft. "
                       f"Push a commit, or re-run the LATEST (ready-context) workflow run "
                       f"so the job actually executes — do NOT `gh run rerun` a draft-era "
                       f"run, which re-runs in its recorded draft context and re-skips "
                       f"(clobbering real results). Then re-check. (`--ignore-ci` overrides.)")
    if merge_conflict:
        reasons.append(f"PR does not merge cleanly into {base} "
                       f"(mergeable={mergeable!r}, mergeStateStatus={merge_state!r}). "
                       f"Rebase or merge {base} into this branch to resolve conflicts.")
    if merge_pending:
        reasons.append(f"mergeability is UNKNOWN (GitHub is still computing it after a "
                       f"recent push to {base}). Re-run once GitHub settles — a PASS while "
                       f"mergeability is unknown would silently allow a conflicting branch.")

    return ReviewStatusResult(ok=not reasons, head=head, reasons=reasons, stamps=stamps)


def _review_status_from_checks(pr, repo, required) -> "ReviewStatusResult":
    """`review-status`'s decision once `_review_launch_path()` says the
    launcher is installed (platform/decisions/0090: "`agentctl review-status`
    becomes a reader... and computes nothing"). PASS iff every required
    role's `builder/review/<role>` check, POSTED BY THE APPROVER APP, reads
    `success` on the PR's current head — nothing else is read or computed:
    no comment stamps, no CI, no draft block, no mergeability narration.
    GitHub's own required-status-check rule is what actually refuses the
    merge; this only reports what it will see.
    `review_launch.evaluate_checks_gate` is the one place that comparison is
    made, shared with `review-launch`'s own tests.

    THE APP FILTER IS TWO LAYERS (round 2 of #732, finding 6): the
    `?app_id=` query parameter below asks GitHub to return only the approver
    App's own check runs, and `evaluate_checks_gate` filters AGAIN on each
    entry's `app.id` rather than trusting the query to have done it — at
    head a3cd844c neither layer existed, so a check named
    `builder/review/reviewer` posted by any other App, or by a bare
    `checks:write` token, read as a pass.
    """
    fields = ["headRefOid", "state", "mergedAt"]
    try:
        view = _gh_pr_json(pr, fields, repo=repo)
    except (RuntimeError, json.JSONDecodeError) as e:
        return ReviewStatusResult(ok=False, head="", reasons=[], stamps=[],
                                  read_error=f"cannot read PR #{pr}: {e}")
    head = (view.get("headRefOid") or "").strip()
    if not head:
        return ReviewStatusResult(ok=False, head="", reasons=[], stamps=[],
                                  read_error=f"PR #{pr} has no head commit (closed/merged?).")
    pr_state = (view.get("state") or "OPEN").upper()
    if pr_state == "MERGED":
        return ReviewStatusResult(ok=True, head=head, reasons=[], stamps=[], terminal="merged",
                                  merged_at=view.get("mergedAt") or "unknown time")
    if pr_state == "CLOSED":
        return ReviewStatusResult(ok=False, head=head, reasons=[], stamps=[], terminal="closed")

    payload = _gh_api_json(
        f"repos/{repo}/commits/{head}/check-runs?app_id={RL.APPROVER_APP_ID}")
    check_runs = (payload or {}).get("check_runs")
    if payload is None or not isinstance(check_runs, list):
        return ReviewStatusResult(ok=False, head=head, reasons=[], stamps=[],
                                  read_error=f"cannot read check runs for {head[:9]}")
    ok, reasons = RL.evaluate_checks_gate(required_roles=required, check_runs=check_runs,
                                          approver_app_id=RL.APPROVER_APP_ID)
    return ReviewStatusResult(ok=ok, head=head, reasons=reasons, stamps=[])


def cmd_review_status(args) -> int:
    """Deterministic merge gate over stamped reviews (ARCH-184 phase 2). Exit 0
    on PASS, 1 on FAIL, so a caller can gate on
    `agentctl review-status --pr N && <merge>`.

    A thin printer over `_review_status_decision` (today's comment-stamp
    gate) or, once `_review_launch_path()` reports the launcher installed,
    over `_review_status_from_checks` instead (platform/decisions/0090) — see
    their docstrings for the gate each computes and, for the former, for
    authenticity (ARCH-193). The routing decision is the same one
    `_spawn_claude` makes; see `_review_launch_path`'s docstring.
    """
    required = args.required or list(_REVIEW_AGENTS)
    from_checks = _review_launch_path() is not None
    if from_checks:
        decision = _review_status_from_checks(args.pr, args.repo, required)
    else:
        decision = _review_status_decision(
            args.pr, args.repo, required,
            allow_unverified=getattr(args, "allow_unverified", False),
            ignore_ci=args.ignore_ci)

    if decision.read_error:
        print(f"review-status: {decision.read_error}", file=sys.stderr)
        return 2
    if decision.terminal == "merged":
        print(f"review-status: PR #{args.pr} head {decision.head[:9]} — "
              f"MERGED {decision.merged_at}")
        print("  nothing to gate: this PR is already merged.")
        return 0
    if decision.terminal == "closed":
        print(f"review-status: PR #{args.pr} head {decision.head[:9]} — CLOSED (unmerged).")
        print("  this PR was closed without merging; nothing to gate.")
        return 1

    verdict = "PASS" if decision.ok else "FAIL"
    print(f"review-status: PR #{args.pr} head {decision.head[:9]} — {verdict}")
    if decision.ok and from_checks:
        print(f"  builder/review/{{{', '.join(required)}}} all read `success` on this head. "
              f"This reports what GitHub's checks say; the required-status-check rule on "
              f"`main`, not this command, is what actually admits the merge.")
    elif decision.ok:
        print(f"  all required reviewers ({', '.join(required)}) APPROVE at the current head; "
              f"CI {'ignored' if args.ignore_ci else 'green'}.")
        if args.ignore_ci:
            # review-post records an --ignore-ci bypass in the durable stamp. This
            # command writes nothing, so the only place it can be visible is here —
            # say it plainly rather than let "CI ignored" read as "CI fine".
            print("  ! CI was NOT checked (--ignore-ci). This verdict says nothing "
                  "about whether the suite ran or passed.")
    else:
        for reason in decision.reasons:
            print(f"  - {reason}")
    return 0 if decision.ok else 1


# The id the Library mints: `issue_` and a 26-character ULID (Crockford base32, uppercase;
# store.new_ulid). The drain's brief puts this value on a command line unquoted, so
# anything else is refused here rather than trusted to be well-formed.
_ISSUE_ID_RE = re.compile(r"issue_[0-9A-HJKMNP-TV-Z]{26}")


def _issue_id_type(value: str) -> str:
    """argparse `type=` for `--issue`: a work-item id in the shape the Library mints.
    Anything else is refused, so no shell metacharacter can reach a dispatch command
    line through this value. A length cap bounded the input but not its characters."""
    if not _ISSUE_ID_RE.fullmatch(value):
        raise argparse.ArgumentTypeError(
            "--issue must be a work-item id: `issue_` and 26 uppercase Crockford "
            "base32 characters")
    return value


def _bosun_registration():
    """The Bosun's session-registration module. Lazy, like `_kb_writes()` —
    only the `bosun` verbs need it, and a new lib module is a deploy hazard
    for every OTHER subcommand if imported at this file's top level (see the
    comment on `tool_policy`'s import above)."""
    import bosun_registration  # noqa: PLC0415 — lazy by design
    return bosun_registration


def cmd_bosun_revoke_machine(args: argparse.Namespace) -> int:
    """Revoke every live session registered for one machine, over the
    Bosun's operator-only loopback listener (platform/decisions/0092
    Handoff: "Revoke-by-machine")."""
    import urllib.error
    import urllib.parse
    import urllib.request
    BRG = _bosun_registration()
    url = (f"http://{BRG.OPERATOR_HOST}:{BRG.OPERATOR_PORT}/revoke-machine/"
           f"{urllib.parse.quote(args.name, safe='')}")
    req = urllib.request.Request(url, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = json.loads(resp.read())
    except (urllib.error.URLError, OSError, ValueError) as exc:
        print(f"bosun revoke-machine: could not reach the Bosun's operator "
              f"listener at {BRG.OPERATOR_HOST}:{BRG.OPERATOR_PORT} ({exc})",
              file=sys.stderr)
        return 1
    print(f"bosun revoke-machine: ended {body.get('revoked', 0)} session(s) "
          f"for {args.name!r}")
    return 0


def _spawn_model_arg(value: str) -> str:
    """`--model`'s argparse `type`: a MODEL_ALIASES key resolves through
    `model_id` as before; a priced Codex slug (a key of
    `telemetry.CODEX_PRICING_PER_MTOK`) is accepted as itself — `model_id`'s
    `.get(alias_or_id, alias_or_id)` fallback already passes an unknown
    string through unchanged, so no alias table entry is needed for it.
    Anything else is rejected here, before any side effect, rather than
    reaching `_model_known` to be refused there with a less specific message
    (issue CQ·438)."""
    if value in MODEL_ALIASES or value in T.CODEX_PRICING_PER_MTOK:
        return value
    raise argparse.ArgumentTypeError(
        f"invalid choice: {value!r} (choose from "
        f"{', '.join(sorted(MODEL_ALIASES))}, or a priced Codex slug for a "
        f"review-agent dispatch: {', '.join(sorted(T.CODEX_PRICING_PER_MTOK))})")


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="agentctl", description="Spawn and manage agent runs.")
    sp = p.add_subparsers(dest="command", required=True)

    sp_spawn = sp.add_parser("spawn", help="Launch an agent")
    sp_spawn.add_argument("agent", help="agent name (e.g. coder, planner, reviewer)")
    sp_spawn.add_argument("--task", required=True, help="task description")
    sp_spawn.add_argument("--label", default=None,
                          help="short work-unit slug for this run (ARCH-239), e.g. "
                               "'recursion-guard' — the dashboard Task column; falls "
                               "back to --task if omitted")
    sp_spawn.add_argument("--issue", default=None, type=_issue_id_type,
                          help="the work-item id this dispatch is for (model-lane epic "
                               "issue_01M174CH86JBCP7291PS0TM097), carried onto meta.json "
                               "and the run's Archives model-resolution record so cost can "
                               "later join back to a work item. Optional — left null "
                               "rather than guessed out of free-text --task when omitted. "
                               "Must be `issue_` and 26 uppercase Crockford base32 "
                               "characters, the id shape the Library mints.")
    sp_spawn.add_argument("--on", default=None,
                          help="repo to dispatch against, short name (default: constance; "
                               "required with --pr, which needs it to know which repo's "
                               "PR number to read)")
    sp_spawn.add_argument("--profile", help="knowledge-ctx profile (default: <product>/<daytime|overnight>)")
    sp_spawn.add_argument("--agents-dir", default=None,
                          help="resolve the agent from this dir's <name>.md instead of the shared "
                               "knowledge index (ARCH-177; explicit override of the repo-local default)")
    sp_spawn.add_argument("--materialize-from-grant", action="store_true",
                          help="materialize this dispatch from the Library's checkout grant "
                               "(issue_01M4AEY9RGJVTCBNEY3YN49DCG) instead of the roster render: "
                               "persona, documents, model and limits all come from "
                               "POST /items/{id}/checkout. The grant's budget.cap_usd is this "
                               "run's per-run dollar cap (the operator's 2026-10-07 ruling, slate "
                               "a-1ommg6), enforced the same way _run_cost_cap's default/env "
                               "cap is for an ordinary dispatch. Requires --issue. Does not "
                               "redeem the slip or hold a library card (E15·2, "
                               "issue_01M35KR8VAC656WMQTY9D8SJ1H). Opt-in; the roster render "
                               "stays the default.")
    sp_spawn.add_argument("--parent", help="parent run-id when this is an auto-spawned "
                          "child (default: AGENTCTL_RUN_ID from the env, so a spawn made "
                          "inside an agentctl run nests under its dispatcher)")
    sp_spawn.add_argument("--reviewer", help="reviewer @-handle (appended to user prompt)")
    sp_spawn.add_argument("--review-sha",
                          help="pin a review-class agent (reviewer/security-reviewer) to this "
                               "commit: the worktree is hard-reset + asserted to it so the review "
                               "can't read a stale tree (ARCH-184). Use the SHA `agentctl publish` "
                               "printed for the head under review.")
    sp_spawn.add_argument("--pr", default=None,
                          help="the EXISTING PR this run belongs to (ARCH-347). A round-fix "
                               "coder dispatched with --pr N commits on the PR's OWN branch (so "
                               "`publish` pushes the PR, not an agent/<task-slug> orphan); a "
                               "reviewer with --pr N self-pins the PR's LIVE head (no stale "
                               "hand-carried --review-sha). Mutually exclusive with --review-sha.")
    sp_spawn.add_argument("--model", type=_spawn_model_arg,
                          help="override the agent's roster model for this dispatch (ARCH-188). "
                               "The default is deterministic from the agent's `model:` field — "
                               "override only when needed; overrides are logged and a co exceeding "
                               "3 in 24h is surfaced to #alerts-agent-cost-perf. A model-changing "
                               "override requires --reason. `fable` is available here; per "
                               "ARCH-134 do not pin it as an agent's roster model or let an agent "
                               "default to it. Also accepts a priced Codex slug "
                               f"({', '.join(sorted(T.CODEX_PRICING_PER_MTOK))}), which serves "
                               "only a reviewer/security-reviewer dispatch with a recorded "
                               "conformance-probe pass (`codex_dispatch_refusal`); every other "
                               "agent is refused.")
    sp_spawn.add_argument("--reason", default=None,
                          help="why this dispatch needs --model (required whenever --model "
                               "changes the resolved model from the agent's roster default). "
                               "Recorded on the override row alongside this run's id, so a run "
                               "of overrides can be judged rather than only counted.")
    sp_spawn.add_argument("--effort", default=None,
                          choices=["low", "medium", "high", "xhigh", "max"],
                          help="pass the `claude` CLI's own --effort through to this "
                               "dispatch (the review-replay eval harness's 'same model, "
                               "different effort' arm). Omitted by default, which leaves "
                               "the model's own default effort unchanged.")
    sp_spawn.add_argument("--eval-mode", dest="eval_mode", action="store_true",
                          help="the review-replay eval harness's replay dispatch: a "
                               "review-class agent (reviewer/security-reviewer) only, "
                               "and refused together with --pr (a replay pins its "
                               "worktree with --review-sha, never the PR's live head). "
                               "Denies gh pr comment/review/merge and gh issue comment "
                               "through this run's tool policy even for a review-class "
                               "agent, and makes `agentctl review-post` force its "
                               "dry-run branch — writing the verdict and body into the "
                               "run directory instead of posting — whether or not the "
                               "agent passes --dry-run itself. A replay must never post "
                               "to GitHub or record a review stamp: an old PR would get "
                               "a live comment, and a stamp on an open one would move "
                               "its merge gate.")
    sp_spawn.add_argument("--budget-warn", type=float, default=None,
                          help=f"soft warn threshold in USD (default: ${B.DEFAULT_SOFT_USD:.0f}, env DAILY_BUDGET_USD)")
    sp_spawn.add_argument("--dry-run", action="store_true",
                          help="skip the claude subprocess; emit a stub transcript instead")
    sp_spawn.add_argument("--force", action="store_true",
                          help="dispatch a review even if one is already running "
                               "against the same commit (ARCH-374); the duplicate "
                               "guard exists to stop wasted reviews, so use this "
                               "only when you genuinely want two")
    sp_spawn.add_argument("--detach", action="store_true",
                          help="double-fork daemonize: parent prints run-id + exits, "
                               "grandchild runs the session. This is now the DEFAULT; the "
                               "flag is kept for explicit/back-compat use (overnight launchd).")
    sp_spawn.add_argument("--foreground", "--attach", dest="foreground", action="store_true",
                          help="run inline and stream the transcript to stdout, blocking "
                               "until the worker exits (the pre-2026-07 default). Use this to "
                               "watch a run interactively, or in a script that sequences work "
                               "by the spawn's exit code. Without it, spawn daemonizes and "
                               "returns immediately (P1a, 2026-07-04).")
    sp_spawn.add_argument("--wait", dest="wait", action="store_true",
                          help="dispatch DETACHED, then block until the run finishes and "
                               "print its outcome — i.e. `spawn` then `wait`, as one "
                               "command. Run this as a BACKGROUND task: its exit is what "
                               "notifies an interactive caller, which a detached run "
                               "cannot do on its own. Unlike --foreground the run stays "
                               "detached, so killing the waiter leaves the work alive.")
    sp_spawn.add_argument("--wait-timeout", dest="wait_timeout", type=float, default=None,
                          help="seconds to wait with --wait before giving up (exit 2, "
                               "naming the still-running run). Default: wait forever.")
    sp_spawn.set_defaults(func=cmd_spawn)

    sp_list = sp.add_parser("list", help="show active runs")
    sp_list.add_argument("--co-session", dest="co_session", metavar="SESSION_ID", default=None,
                         help="show only SESSION_ID's own top-level live dispatches "
                              "(session_state._dispatched_by), for a rollover handoff to carry")
    sp_list.add_argument("--json", action="store_true",
                         help="with --co-session, emit JSON instead of one line per run")
    sp_list.set_defaults(func=cmd_list)

    sp_probe = sp.add_parser("codex-probe", help="run the Codex guard conformance probe "
                             "(spends the Codex subscription; read-only, no network)")
    sp_probe.add_argument("-m", "--model", required=True, help="the Codex model slug to probe")
    sp_probe.add_argument("--codex-bin", default=None, help="codex binary (default: PATH)")
    sp_probe.add_argument("--timeout", type=float, default=None,
                          help="seconds before the run is abandoned (default: 600)")
    sp_probe.set_defaults(func=cmd_codex_probe)

    sp_status = sp.add_parser("status", help="show details of one run")
    sp_status.add_argument("run_id")
    sp_status.set_defaults(func=cmd_status)

    sp_result = sp.add_parser(
        "result", help="print a finished run's final text (stdout, undecorated)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Print the `result` of the run's last result event in transcript.jsonl "
                    "(else its last assistant text block). Read-only.",
        epilog="exit codes:\n"
               "  0  finished run, result printed\n"
               "  1  unknown run id\n"
               "  5  run still running (use `agentctl wait <run-id>`)\n"
               "  6  no result text, or the run died without finalizing (stderr says which)")
    sp_result.add_argument("run_id")
    sp_result.add_argument("--json", action="store_true",
                           help="print {run_id, agent, exit_status, cost_usd, result} instead")
    sp_result.set_defaults(func=cmd_result)

    sp_wait = sp.add_parser(
        "wait", help="block (foreground) until detached run(s) finish — keeps the caller's turn "
                     "alive; exit 4 if a run FAILED")
    sp_wait.add_argument("run_id", nargs="+", help="one or more run ids to wait on")
    sp_wait.add_argument("--any", action="store_true",
                         help="return when the FIRST run finishes (default: wait for ALL)")
    sp_wait.add_argument("--timeout", type=float, default=1800.0,
                         help="max seconds to block before giving up (default 1800; 0 = no timeout)")
    sp_wait.add_argument("--poll", type=float, default=5.0,
                         help="seconds between checks (default 5)")
    sp_wait.set_defaults(func=cmd_wait)

    sp_verify_init = sp.add_parser(
        "verify-init",
        help="poll a just-spawned run for its init event; exit 3 on pre-init death (ARCH-254)")
    sp_verify_init.add_argument("run_id")
    sp_verify_init.add_argument("--timeout", type=float, default=120.0,
                                help="max seconds to wait for init before giving up (default 120)")
    sp_verify_init.add_argument("--poll", type=float, default=2.0,
                                help="seconds between checks (default 2)")
    sp_verify_init.set_defaults(func=cmd_verify_init)

    sp_logs = sp.add_parser("logs", help="print or tail a run's transcript")
    sp_logs.add_argument("run_id")
    sp_logs.add_argument("-f", "--follow", action="store_true", help="follow live")
    sp_logs.set_defaults(func=cmd_logs)

    sp_kill = sp.add_parser("kill", help="terminate a run (SIGTERM, escalates to SIGKILL after 10s)")
    sp_kill.add_argument("run_id")
    sp_kill.add_argument("--final", action="store_true",
                         help="suppress the ARCH-131 deepseek fail-over — the run stays dead")
    sp_kill.add_argument("--tree", action="store_true",
                         help="also reap all live descendant runs (by parent_run), "
                              "descendants first — for a stale parent whose dispatched "
                              "workers would otherwise outlive it")
    sp_kill.set_defaults(func=cmd_kill)

    sp_budget = sp.add_parser("budget", help="show today's spend vs soft/hard thresholds")
    sp_budget.set_defaults(func=cmd_budget)

    sp_models = sp.add_parser(
        "models", help="list the models this platform serves (read-only, no network)")
    sp_models.add_argument("--json", action="store_true",
                           help="print {schema_version, models: [{alias, model, provider}]} "
                                "instead of a table")
    sp_models.set_defaults(func=cmd_models)

    sp_kb = sp.add_parser("kb", help="knowledge-base index operations")
    kb_sub = sp_kb.add_subparsers(dest="kb_command", required=True)
    sp_kb_sync = kb_sub.add_parser(
        "sync", help="fast-forward the knowledge checkout and reindex what changed, as one step")
    sp_kb_sync.add_argument("--full", action="store_true",
                            help="full scan + reconcile instead of indexing only the "
                                 "fast-forwarded paths; also runs when already up to date")
    sp_kb_sync.add_argument("--verify-only", dest="verify_only", action="store_true",
                            help="skip fetch/fast-forward; only check the index against "
                                 "the working tree (exit 2 if they disagree)")
    sp_kb_sync.add_argument("--no-heal", dest="no_heal", action="store_true",
                            help="report a verification mismatch without running the "
                                 "full reconcile that would fix it")
    sp_kb_sync.add_argument("--dry-run", action="store_true",
                            help="show what would be fast-forwarded/indexed without writing")
    sp_kb_sync.add_argument("--quiet", action="store_true",
                            help="drop the one healthy line ('verified — N docs indexed'); "
                                 "a fast-forward summary, an invalid doc, a verification "
                                 "failure and a heal still print (what the 10-minute "
                                 "timer passes, so an up-to-date cycle logs nothing)")
    sp_kb_sync.set_defaults(func=cmd_kb_sync)

    sp_kb_co = kb_sub.add_parser(
        "checkout", help="lease a doc for editing and print its content + content-sha")
    sp_kb_co.add_argument("doc", help="doc id (shared/agents/architect) or repo-relative "
                                      ".md, .yaml or .yml path")
    sp_kb_co.add_argument("--holder", default=None,
                          help="lease holder (default: this run-id, else session:<user>)")
    sp_kb_co.add_argument("--note", default=None, help="what you intend to change")
    sp_kb_co.set_defaults(func=cmd_kb_checkout)

    sp_kb_rel = kb_sub.add_parser("release", help="drop a lease early")
    sp_kb_rel.add_argument("doc", help="doc id or repo-relative .md path")
    sp_kb_rel.add_argument("--holder", default=None)
    sp_kb_rel.set_defaults(func=cmd_kb_release)

    sp_kb_ls = kb_sub.add_parser("leases", help="list active leases")
    sp_kb_ls.add_argument("--json", action="store_true")
    sp_kb_ls.set_defaults(func=cmd_kb_leases)

    sp_kb_apply = kb_sub.add_parser(
        "apply", help="write a doc through the cage (sha-gated, policy-gated, validated)")
    sp_kb_apply.add_argument("doc", help="doc id or repo-relative .md path")
    sp_kb_apply.add_argument("--base-sha", dest="base_sha", required=True,
                             help="content-sha from `kb checkout`. Hard precondition: the "
                                  "write is refused if origin/main has moved on. Pass the "
                                  "sha of the empty string to create a new doc.")
    sp_kb_apply.add_argument("--provenance", required=True,
                             help="in-session | person | proposal | verifier-pass | generated | "
                                  "keel | steward — only in-session and person write main "
                                  "directly; person also needs a "
                                  "Cloudflare Access assertion or a Deck signature on stdin, "
                                  "which is verified and the person recorded in a KB-Person "
                                  "trailer, else exit 8 (a Deck signature refuses --edits and "
                                  "--edits-file); proposal never writes to "
                                  "main and takes the PR path; verifier-pass, generated, "
                                  "keel and steward are recognized but refused, and take "
                                  "the same PR path via kb_propose")
    sp_kb_apply.add_argument("--edits", default=None,
                             help="JSON list of {old,new} exact anchors, or a path to one")
    sp_kb_apply.add_argument("--content", default=None,
                             help="the document body itself, taken literally even if it "
                                  "looks like a path (use --content-file to read one)")
    sp_kb_apply.add_argument("--content-file", dest="content_file", default=None,
                             help="read the document body from this file")
    sp_kb_apply.add_argument("--edits-file", dest="edits_file", default=None,
                             help="read the JSON edit list from this file")
    sp_kb_apply.add_argument("--message", default=None, help="commit message body")
    sp_kb_apply.add_argument("--holder", default=None)
    sp_kb_apply.add_argument("--allow-overwrite", dest="allow_overwrite", action="store_true",
                             help="permit --content to replace an existing doc wholesale")
    sp_kb_apply.add_argument("--dry-run", action="store_true",
                             help="run every guard and the validator, write nothing")
    sp_kb_apply.add_argument("--no-push", dest="no_push", action="store_true",
                             help="commit in the cage worktree without pushing")
    sp_kb_apply.add_argument("--no-sync", dest="no_sync", action="store_true",
                             help="skip the reindex that normally follows a push")
    sp_kb_apply.set_defaults(func=cmd_kb_apply)

    sp_kb_prop = kb_sub.add_parser(
        "propose", help="open a PR for a KB change instead of writing main")
    sp_kb_prop.add_argument("doc", help="doc id or repo-relative .md path; with --delete, "
                                        "any file under projects/")
    sp_kb_prop.add_argument("also", nargs="*", default=[],
                            help="further paths removed in the same PR (--delete only)")
    sp_kb_prop.add_argument("--delete", action="store_true",
                            help="propose removing the named files; you must hold the "
                                 "checkout of each")
    sp_kb_prop.add_argument("--title", required=True, help="PR title")
    sp_kb_prop.add_argument("--rationale", default=None, help="why; becomes the PR body")
    sp_kb_prop.add_argument("--base-sha", dest="base_sha", default=None,
                            help="optional content-sha precondition, as for `apply`")
    sp_kb_prop.add_argument("--edits", default=None,
                            help="JSON list of {old,new} exact anchors, or a path to one")
    sp_kb_prop.add_argument("--content", default=None,
                            help="the document body itself, taken literally even if it "
                                 "looks like a path (use --content-file to read one)")
    sp_kb_prop.add_argument("--content-file", dest="content_file", default=None,
                            help="read the document body from this file")
    sp_kb_prop.add_argument("--edits-file", dest="edits_file", default=None,
                            help="read the JSON edit list from this file")
    sp_kb_prop.add_argument("--holder", default=None)
    sp_kb_prop.add_argument("--allow-overwrite", dest="allow_overwrite",
                            action="store_true")
    sp_kb_prop.add_argument("--batch", default=None,
                            help='JSON list of {"id", "edits" | "content", "base_sha"?}: '
                                 "several documents changed in one PR")
    sp_kb_prop.add_argument("--batch-file", dest="batch_file", default=None,
                            help="file holding the --batch JSON list")
    sp_kb_prop.add_argument("--dry-run", action="store_true",
                            help="validate and show the branch without pushing or opening a PR")
    sp_kb_prop.set_defaults(func=cmd_kb_propose)

    sp_kb_merge = kb_sub.add_parser(
        "merge", help="merge a knowledge PR the Library opened, once its review cycle "
                      "passed")
