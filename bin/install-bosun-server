#!/bin/sh
# install-bosun-server — deploy-pin and bootstrap the Bosun's registration
# listeners (platform/decisions/0059, platform/decisions/0092; E12 stage one).
#
# WHY. bin/bosun-server starts the mTLS registration listener Individuators
# register against and the loopback operator listener
# `agentctl bosun revoke-machine` calls. Run by hand, it dies with its
# terminal window or a reboot, taking every Individuator session with it —
# so, like com.convivy.run-register-api, it needs a supervised launchd job,
# never a symlink into this checkout (ADR-0059 rule 1: launchd re-reads a
# job's program on every restart, including an unattended crash-restart, so
# whatever branch this checkout sat on is what the next restart would serve).
#
# WHAT THIS DOES, per ADR-0059 rules 1, 2, 4, 6, 7, 8:
#   1. Reads a git REF (default main), never the live working tree, via
#      `git archive` (rule 7: an untracked or gitignored file, a credential
#      included, is invisible to the commit object `git archive` reads).
#   2. Extracts a COPY of bin/bosun-server and the lib/agent-platform/
#      modules its import closure reaches (bosun_registration, bosun_authz,
#      builder_root, vault_plane) plus requirements.txt, into
#      ~/.local/deploy/bosun-server/ (rule 2: a copy, never a symlink).
#   3. Builds a fresh venv inside that same deploy area and installs this
#      repo's pinned requirements.txt into it (rule 4: the interpreter and
#      its one third-party dependency, `cryptography`, travel with the code
#      rather than depending on launchd's inherited PATH or site-packages).
#   4. Writes the certificate, key and registration host this command's own
#      flags supply to ~/.config/convivy/bosun-server.env, mode 0600 (ARCH-342:
#      an operator-chosen, install-time value never belongs in the plist
#      template, because install.sh copies that template OVER the live plist —
#      same idiom as ~/.config/convivy/llm-gateway.env). Copies (never
#      symlinks) the plist template out of the repo into
#      ~/Library/LaunchAgents/, rendering only __HOME__ — the plist itself
#      carries none of the three — and refusing to clobber a live plist that
#      has drifted from the rendered template unless --force (rule 8 — the
#      same idiom install.sh phase 4 and install-run-register-api use).
#   5. Bootstraps the job in the GUI domain of the invoking operator
#      (`gui/$(id -u)`) — the per-user domain run-register-api's own plist
#      loads into, not the system LaunchDaemons domain install-individuator
#      uses for its root daemon. Non-fatal: a job already loaded, or a
#      launchctl this machine refuses for its own reasons, must not abort an
#      otherwise-successful install.
#
# --tls-cert/--tls-key are required on every real install (not --status):
# bosun_registration.build_server_ssl_context refuses to start the listener
# without both (lib/agent-platform/bosun_registration.py — SERVER_CERT_PATH/
# SERVER_KEY_PATH have no defaults), and a plist that launchd nonetheless
# KeepAlive-restarts forever against a missing certificate is a worse failure
# mode than this installer refusing up front. --registration-host defaults to
# 127.0.0.1, NOT the module's own 0.0.0.0 default: 0.0.0.0 also listens on
# the LAN and the tailnet, and this installer does not open that up by
# omission — an operator who wants Individuators on other machines to reach
# this listener has to name that host explicitly.
#
# Idempotent and re-run-safe: each run replaces the whole deploy area
# atomically (old directory renamed aside, new one moved into place, old one
# removed) — never a partial merge of two commits' files.
#
# Must stay POSIX sh / bash-3.2-safe: tests/bash/lint.sh parses every bin/
# script with a bash-or-/bin/sh shebang under /bin/bash -n on macOS 3.2.57.
set -eu

usage() {
  cat >&2 <<'EOF'
usage: install-bosun-server --tls-cert=<path> --tls-key=<path>
                             [--registration-host=<host>] [--ref=<git-ref>]
                             [--repo=<path>] [--allow-non-main] [--force]
                             [--status]

  --tls-cert=<path>        The macstudio server certificate (PEM), issued by
                            the Library's ceremony with the operator (0092
                            decision #6). Required unless --status.
  --tls-key=<path>         The matching private key. Required unless --status.
  --registration-host=<host> Address the mTLS registration listener binds.
                            Default: 127.0.0.1 — NOT the module's own 0.0.0.0
                            default, which also listens on the LAN and the
                            tailnet. Pass 0.0.0.0, or this machine's tailnet
                            address, to let Individuators on OTHER machines
                            reach this listener; the default serves only this
                            machine.
  --ref=<git-ref>           Ref to install from (default: main).
  --repo=<path>             Checkout to read the ref from (default: this
                            script's own repo — resolved from argv[0], not
                            the caller's cwd).
  --allow-non-main          Required to install anything other than main
                            (rule 6: the deploy area is installed from main).
  --force                   Overwrite a live plist that differs from the
                            rendered template.
  --status                  Print what commit is currently deployed and exit.
EOF
  exit 2
}

REPO=""
ROOT_CONFIG=""
REF="main"
ALLOW_NON_MAIN=0
PLIST_FORCE=0
STATUS_ONLY=0
TLS_CERT=""
TLS_KEY=""
REGISTRATION_HOST="127.0.0.1"
# FOR TESTS ONLY: skips `python3.11 -m venv` + `pip install`, which needs
# network egress to PyPI, and instead copies a stub `python3` from
# --venv-bin-dir into the deploy area's venv/bin/ — the same shape
# install-individuator's --skip-build/--build-dir gives its own suite.
SKIP_VENV=0
VENV_BIN_DIR=""

for arg in "$@"; do
  case "$arg" in
    --tls-cert=*) TLS_CERT="${arg#--tls-cert=}" ;;
    --tls-key=*) TLS_KEY="${arg#--tls-key=}" ;;
    --registration-host=*) REGISTRATION_HOST="${arg#--registration-host=}" ;;
    --ref=*) REF="${arg#--ref=}" ;;
    --repo=*) REPO="${arg#--repo=}" ;;
    --allow-non-main) ALLOW_NON_MAIN=1 ;;
    --force) PLIST_FORCE=1 ;;
    --status) STATUS_ONLY=1 ;;
    # FOR TESTS ONLY: same shape as install-run-register-api's --root-config
    # (company/decisions/0008) and install-individuator's --skip-build.
    --root-config=*) ROOT_CONFIG="${arg#--root-config=}" ;;
    --skip-venv) SKIP_VENV=1 ;;
    --venv-bin-dir=*) VENV_BIN_DIR="${arg#--venv-bin-dir=}" ;;
    -h|--help) usage ;;
    *) echo "install-bosun-server: unknown option: $arg" >&2; usage ;;
  esac
done

DEPLOY_DIR="$HOME/.local/deploy/bosun-server"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
PLIST_NAME="com.convivy.bosun-server.plist"

say() { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }

# --- --status: answer "what commit is this service serving", no install
# side effects. -------------------------------------------------------------
if [ "$STATUS_ONLY" -eq 1 ]; then
  if [ -f "$DEPLOY_DIR/DEPLOYED_COMMIT" ]; then
    cat "$DEPLOY_DIR/DEPLOYED_COMMIT"
    exit 0
  fi
  echo "install-bosun-server: nothing deployed yet at $DEPLOY_DIR" >&2
  exit 1
fi

# --- the certificate/key are required on every real install: refuse before
# any other work, naming why (see the module's own PreflightError, which
# this installer is deliberately stricter than this script need be — a
# KeepAlive job restarting forever against a certificate that was never
# configured is a worse failure mode than refusing here). ---------------
if [ -z "$TLS_CERT" ] || [ -z "$TLS_KEY" ]; then
  echo "install-bosun-server: --tls-cert and --tls-key are both required." >&2
  echo "  bosun_registration.build_server_ssl_context refuses to start the" >&2
  echo "  listener without a configured server certificate and key (0092" >&2
  echo "  decision #6); a KeepAlive job installed without them would only" >&2
  echo "  restart forever, never serving." >&2
  exit 2
fi

if [ "$SKIP_VENV" -eq 1 ] && [ -z "$VENV_BIN_DIR" ]; then
  echo "install-bosun-server: --skip-venv requires --venv-bin-dir" >&2
  exit 2
fi

# Never derived from argv[0]: install.sh symlinks this script into
# ~/.local/bin like any other tool, and through that symlink
# `dirname "$0"/..` lands on ~/.local rather than a checkout — same
# reasoning as install-run-register-api and install-individuator.
if [ -z "$REPO" ]; then
  _self_path="$0"; [ -L "$_self_path" ] && _self_path="$(readlink "$_self_path")"
  if [ -n "$ROOT_CONFIG" ]; then
    _root="$("$(dirname "$_self_path")/builder-root" --root --config "$ROOT_CONFIG")" || _root=""
  else
    _root="$("$(dirname "$_self_path")/builder-root" --root)" || _root=""
  fi
  if [ -z "$_root" ]; then
    echo "install-bosun-server: cannot resolve the machine's root (bin/builder-root --root); pass --repo" >&2
    exit 2
  fi
  REPO="$_root/agent-platform"
fi

git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "install-bosun-server: $REPO is not a git checkout" >&2
  exit 1
}

SHA="$(git -C "$REPO" rev-parse "$REF" 2>/dev/null)" || {
  echo "install-bosun-server: '$REF' does not resolve to a commit in $REPO" >&2
  exit 1
}

if [ "$REF" != "main" ] && [ "$ALLOW_NON_MAIN" -ne 1 ]; then
  echo "install-bosun-server: REFUSING to install ref '$REF' (resolves to $SHA)." >&2
  echo "  ADR-0059 rule 6: the deploy area installs from main. Pass --allow-non-main" >&2
  echo "  to install a different ref anyway (e.g. to verify a branch before merge)." >&2
  exit 1
fi

if [ "$SKIP_VENV" -ne 1 ]; then
  command -v python3.11 >/dev/null 2>&1 || {
    echo "install-bosun-server: python3.11 not found on PATH" >&2
    exit 1
  }
fi

say "Installing bosun-server from $REF ($SHA) in $REPO"

# --- stage the release in a sibling dir, never in place ---------------------
mkdir -p "$(dirname "$DEPLOY_DIR")"
# Clean staging on ANY exit, success or failure — never the live area, only
# the staging siblings.
_cleanup_stage() { rm -rf "$DEPLOY_DIR.new" "$DEPLOY_DIR.new.tar"; }
trap _cleanup_stage EXIT
trap '_cleanup_stage; exit 130' INT
trap '_cleanup_stage; exit 143' TERM
STAGE="$DEPLOY_DIR.new"
rm -rf "$STAGE"
mkdir -p "$STAGE"

# Staged through a file rather than piped: /bin/sh has no `pipefail`, so in
# `git archive ... | tar -x` a failing archive is invisible — tar exits 0 on
# empty input. As two commands, `set -e` catches the archive itself.
ARCHIVE="$STAGE.tar"
rm -f "$ARCHIVE"
git -C "$REPO" archive "$SHA" -- \
    bin/bosun-server \
    lib/agent-platform/bosun_registration.py \
    lib/agent-platform/bosun_authz.py \
    lib/agent-platform/builder_root.py \
    lib/agent-platform/vault_plane.py \
    requirements.txt \
  > "$ARCHIVE"
tar -x -C "$STAGE" -f "$ARCHIVE"
rm -f "$ARCHIVE"
chmod +x "$STAGE/bin/bosun-server"

if [ "$SKIP_VENV" -eq 1 ]; then
  say "Staging a stubbed interpreter (--skip-venv)"
  mkdir -p "$STAGE/venv/bin"
  cp "$VENV_BIN_DIR/python3" "$STAGE/venv/bin/python3"
  chmod +x "$STAGE/venv/bin/python3"
else
  say "Building pinned interpreter (python3.11 -m venv)"
  python3.11 -m venv "$STAGE/venv"

  # A network step, unlike the steps above: `set -eu` is still armed here
  # (the trap disarm is below, after this), so a pip failure — offline,
  # PyPI down, a bad pin — aborts the whole script, the EXIT trap removes
  # $STAGE, and $DEPLOY_DIR (the previous release, if any) is never touched.
  say "Installing Python dependencies (pip install -r requirements.txt)"
  "$STAGE/venv/bin/pip" install --quiet -r "$STAGE/requirements.txt"
fi

{
  echo "ref: $REF"
  echo "commit: $SHA"
  echo "installed_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "installed_from: $REPO"
} > "$STAGE/DEPLOYED_COMMIT"

# --- swap: the deploy area is replaced as one unit, never merged with the
# previous release. DISARM BEFORE THE SWAP: between the two `mv` calls below
# the live path does not exist and $STAGE IS the release, so a cleanup trap
# firing there would delete the only thing that can complete the swap
# forward (same reasoning as install-run-register-api / install-individuator).
trap - EXIT INT TERM

OLD=""
if [ -d "$DEPLOY_DIR" ]; then
  OLD="$DEPLOY_DIR.old.$$"
  mv "$DEPLOY_DIR" "$OLD"
fi
mv "$STAGE" "$DEPLOY_DIR"
[ -n "$OLD" ] && rm -rf "$OLD"

say "Deployed: $DEPLOY_DIR (commit $SHA)"

# --- config file: the certificate, key and bind host this command's own
# flags supply (ARCH-342). These are operator-chosen at install time, so they
# never go in the plist template, which install.sh copies OVER the live
# plist — same idiom as ~/.config/convivy/llm-gateway.env. bin/bosun-server
# sources this file before importing bosun_registration. Rewritten on every
# install, not seeded once: like the plist's own __HOME__ substitution, the
# values a re-run writes are exactly the flags that re-run was given. --------
BOSUN_ENV_DIR="$HOME/.config/convivy"
BOSUN_ENV_FILE="$BOSUN_ENV_DIR/bosun-server.env"
mkdir -p "$BOSUN_ENV_DIR"
ENV_STAGE="$(mktemp "$BOSUN_ENV_DIR/bosun-server.env.XXXXXX")"
{
  echo "BOSUN_TLS_CERT=$TLS_CERT"
  echo "BOSUN_TLS_KEY=$TLS_KEY"
  echo "BOSUN_REGISTRATION_HOST=$REGISTRATION_HOST"
} > "$ENV_STAGE"
chmod 600 "$ENV_STAGE"
mv "$ENV_STAGE" "$BOSUN_ENV_FILE"
say "Config written: $BOSUN_ENV_FILE"

# --- plist: rendered from the same ref, never the working tree, and never
# clobbering a live plist that has drifted from the template (ARCH-342 idiom,
# same as install.sh phase 4 and install-run-register-api). __HOME__ is
# substituted the same way install.sh substitutes $HOME at install time; the
# plist carries no certificate, key or host of its own (see above). ----------
mkdir -p "$LAUNCH_AGENTS"
PLIST_STAGE="$LAUNCH_AGENTS/$PLIST_NAME.new"
git -C "$REPO" show "$SHA:launchd/$PLIST_NAME" \
  | sed "s|__HOME__|$HOME|g" \
  > "$PLIST_STAGE"

PLIST_LIVE="$LAUNCH_AGENTS/$PLIST_NAME"
if [ -f "$PLIST_LIVE" ] && ! diff -q "$PLIST_LIVE" "$PLIST_STAGE" >/dev/null 2>&1 && [ "$PLIST_FORCE" -ne 1 ]; then
  warn "live plist differs from the template — NOT overwritten (--force to replace):"
  diff -u "$PLIST_LIVE" "$PLIST_STAGE" | sed 's/^/    /' || true
  rm -f "$PLIST_STAGE"
else
  mv "$PLIST_STAGE" "$PLIST_LIVE"
  say "Plist installed: $PLIST_LIVE"
fi

# --- bootstrap the job in the GUI domain of the invoking operator.
# Non-fatal: a job already loaded, or a launchctl this machine refuses for
# its own reasons, must not abort an otherwise-successful install — the
# deploy area and plist above are worth having regardless. -------------------
GUI_DOMAIN="gui/$(id -u)"
launchctl bootout "$GUI_DOMAIN/com.convivy.bosun-server" >/dev/null 2>&1 || true
BOOTSTRAP_ERR="$(mktemp "${TMPDIR:-/tmp}/bosun-server-bootstrap-err.XXXXXX")"
if launchctl bootstrap "$GUI_DOMAIN" "$PLIST_LIVE" 2>"$BOOTSTRAP_ERR"; then
  say "Bootstrapped: $GUI_DOMAIN/com.convivy.bosun-server"
else
  warn "could not bootstrap the job (see below); the deploy area and plist are installed regardless"
  cat "$BOOTSTRAP_ERR" >&2 || true
fi
rm -f "$BOOTSTRAP_ERR"

cat <<EOF

Install complete.

To check what commit is currently deployed:
  $0 --status
EOF
