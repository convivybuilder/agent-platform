import venv_bootstrap  # noqa: E402
if __name__ == "__main__":
    venv_bootstrap.ensure(__file__, requires=("requests",))
import requests  # noqa: E402
import builder_root as BR  # noqa: E402
import operator_config  # noqa: E402

ROOT = BR.root() / "knowledge"
ENV_FILE = Path.home() / ".local" / "etc" / "knowledge" / ".env"


def load_token() -> str:
    for line in ENV_FILE.read_text().splitlines():
        if line.startswith("NOTION_TOKEN="):
            return line.split("=", 1)[1].strip()
    sys.exit("NOTION_TOKEN missing from " + str(ENV_FILE))


TOKEN = load_token()
HEADERS = {
    "Authorization": f"Bearer {TOKEN}",
    "Notion-Version": "2022-06-28",
}

