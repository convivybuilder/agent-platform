#!/usr/bin/env python3.11
"""velocity-report — Convivy engineering velocity, total + by product/bucket.

A read-only harvester that rolls up throughput / volume / stability / decisions
metrics per repo, maps each repo to a product or engineering bucket, and writes a
windowed JSON the convivy-orient `/velocity` dashboard reads. Companion to
model-scorecard (which owns per-(agent,model) quality); this is the human-readable
"how much shipped, how safely" view across the whole org.

Metrics (per 7/30/90-day window, per bucket + a grand total):
  • Throughput — commits, PRs merged, features shipped (feat-typed merges).
  • Volume     — net lines changed (added − removed), generated/lockfiles excluded.
  • Stability  — reverts → change-failure rate (reverts ÷ merges); plus CI-first-pass%
                 and 7-day survival% read from the model-scorecard ledgers where they
                 exist (dev-crew repos + PA).
  • Decisions  — ADRs minted (knowledge, attributed to the ADR's project) + ARCH
                 entries (substrate decisions.md).

Sources, by what each repo has:
  • local git clone → commits, net LOC, reverts (all cloned repos).
  • GitHub (gh)     → PRs merged + features (best-effort; skipped if the repo doesn't
                      resolve, e.g. the local-only *-commercial sites).
  • The three NYH projects live under the <root>/nyh-architecture/ umbrella (mapped by
    REPO_SUBPATH): nyh-arch-tools at the operator's personal GitHub account (PRs via gh + local commits/LOC),
    nyh-etc + nyh-park-villa local-only (commits/LOC, no PRs). One bucket each.

LOC is a deliberately weak signal kept as one input among several — never read alone.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path


class FetchError(Exception):
    """A GitHub fetch failed after retries — distinct from 'the repo has no GitHub
    remote.' The caller carries forward the last-known-good value instead of writing
    a false zero, so a transient gh blip never pollutes the metrics or the history."""

