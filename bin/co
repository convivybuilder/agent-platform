unset _co_writing_guide_dir

# business-area-umbrella path: a configured directory (the registry's own
# top-level `_business_umbrella_dir`, `projects.business_umbrella_dirname()`)
# holds one git repo per project for a side business of the operator's own —
# physical-world projects (floorplans -> SketchUp -> Layout) plus the
# business-area crews (guest tech, marketing) alongside them. NOT a Convivy
# product: no agent (local git; each dir's CLAUDE.md supplies the role). co
# here is the launch ergonomic + handoff muscle memory; -r with no prompt
# resumes the latest handoff. Per-project styling (ARCH-077): each project
# carries its own iTerm DynamicProfile (deploys laptop-side, ARCH-078) and an
# accent below; the tmux status color works from the mini regardless. Adding
# a project needs no change here, nor an absent umbrella — see
# `_co_umbrella_refresh`'s own gate.
#
# A PROJECT IS INDIVIDUATED FROM THE CENTRAL KB ONLY ONCE IT IS READY FOR IT,
# per `_co_umbrella_refresh` below: `co -r` pulls the knowledge repo and
# renders a daytime profile when, and only when, this repo's git ignores
# `.claude/` AND a daytime profile actually resolves for it. Some of these
# side-business repos are built that way from the start (a `.gitignore` with
# `.claude/`, a daytime profile in the knowledge repo); others track a
# hand-written example-reviewer agent and skills under `.claude/` in git and
# do not ignore it — `use --force` rmtrees `.claude/agents` and
# `.claude/skills` before writing, which would destroy that tracked work, so
# the ignore check keeps them unrendered exactly as before this existed.
# Matches any repo directly under the umbrella directory; absent, the branch
# never fires.
_umbrella_dirname=$(python3 - "$(_co_lib_dir)" "$(_co_registry_path)" "$_co_crews_root" \
    2>/dev/null <<'PY' || true
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
try:
    import projects

    if sys.argv[2]:
        projects.PROJECTS_JSON = Path(sys.argv[2])
    projects.ROOT_OVERRIDE = sys.argv[3]
    projects._load_raw.cache_clear()
    print(projects.business_umbrella_dirname() or "")
except Exception:
    pass
PY
)
_umbrella_dir=""
[[ -n $_umbrella_dirname ]] && _umbrella_dir="$_co_crews_root/$_umbrella_dirname"

# Renders only when BOTH hold: git ignores `.claude/` in this repo (the
# shared check above, same gate the profiled-checkout branch applies), and a
# daytime profile resolves for this directory. `knowledge-ctx list` is the
# read-only way to answer the second question — it only reads the registry
# and the knowledge index, never writes anything, so this can be checked
# before committing to a pull and a `--force` render. Either check failing
# is not an error: one stderr line names the repo and which condition
# failed, and the launch proceeds unrendered, exactly as every repo under
# this umbrella does today.
#
# `_co_umbrella_rendered` lets the launch below tell apart "rendered this
# run" from "skipped" without re-running either check — the same reasoning
# as `_co_profiled_dirs_rendered` above, and set the same way: only once
# `_co_reindividuate` completes. Reset per invocation of this script, never
# across one, so no state survives between launches.
_co_umbrella_rendered=false
_co_umbrella_refresh() {
    # ${(V)}: same reasoning as the crew and profiled-checkout branches above
    # — cwd-derived, escaped regardless of this branch's closed-set gate.
    if ! _co_claude_render_ignored "$repo_root"; then
        print -u2 "co: refresh — skipping the render in ${(V)$(basename "$repo_root")}: git does not ignore .claude/ there, so rendered agents and CLAUDE.md would be left untracked."
        return 0
    fi
    if ! knowledge-ctx list 2>/dev/null | grep -qx '  daytime'; then
        print -u2 "co: refresh — skipping the render in ${(V)$(basename "$repo_root")}: no daytime profile resolves for this directory."
        return 0
    fi
    print -u2 "co: refresh (${(V)$(basename "$repo_root")} business-area umbrella) — pulling $_co_crews_root/knowledge"
    _co_pull_knowledge || {
        print -u2 "co: refresh — knowledge pull failed."
        return 1
    }
    _co_reindividuate daytime || return 1
    _co_umbrella_rendered=true
}

if [[ -n $repo_root && -n $_umbrella_dir && $(dirname "$repo_root") == $_umbrella_dir ]]; then
    # Same prompt gate the profiled-checkout branch uses for its render: a
    # named agent/prompt (`co coder`, `co "fix X"`) must reach claude as an
    # argument rather than trigger a render no profile has ever needed here.
    if [[ $# -eq 0 || $1 == /* || $1 == --resume ]]; then
        if $refresh; then
            _co_umbrella_refresh || exit 1
        fi
        _co_refresh_if_stale _co_umbrella_refresh
    fi
    # /handoff-pickup names a skill, so sending it needs the skill to actually
    # be there: either this render just wrote it (`_co_umbrella_rendered`,
    # the same rule `_co_profiled_dirs_rendered` applies above), or it never
    # renders here but ships hand-tracked in git already. A repo with
    # neither — a new project whose .gitignore lands before its daytime
    # profile does — launches with no prompt instead of an "Unknown command"
    # failure.
    if $refresh && [[ $# -eq 0 ]] \
       && { [[ $_co_umbrella_rendered == true ]] \
            || [[ -f "$repo_root/.claude/skills/handoff-pickup/SKILL.md" ]]; }; then
        set -- /handoff-pickup
    fi
    umbrella_proj=$(basename "$repo_root")
    # Per-project accent/label/fg now come from that project's own registry row
    # (`co_accent`/`co_label`/`co_fg`, read by `projects.co_style_by_basename`
    # — the generalised form of the per-crew styling case this umbrella used to
    # carry here) when one exists; a project under the umbrella with no row of
    # its own yet, or none at all, takes the same default brown + raw repo name
    # every unregistered project here always has.
    umbrella_accent="#6F4E37" umbrella_label=$umbrella_proj umbrella_fg="#ffffff"
    _umbrella_style_match=$(python3 - "$(_co_lib_dir)" "$(_co_registry_path)" "$_co_crews_root" \
        "$umbrella_proj" 2>/dev/null <<'PY' || true
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
try:
    import projects

    if sys.argv[2]:
        projects.PROJECTS_JSON = Path(sys.argv[2])
    projects.ROOT_OVERRIDE = sys.argv[3]
    projects._load_raw.cache_clear()
    style = projects.co_style_by_basename(sys.argv[4])
    if style:
        style_id, accent, label, fg = style
        print("\t".join([accent, label or style_id, fg]))
except Exception:
    pass
PY
    )
    if [[ -n $_umbrella_style_match ]]; then
        _umbrella_fields=("${(@ps:\t:)_umbrella_style_match}")
        umbrella_accent=$_umbrella_fields[1] umbrella_label=$_umbrella_fields[2] umbrella_fg=$_umbrella_fields[3]
    fi
    unset _umbrella_style_match _umbrella_fields
    # $umbrella_proj is a bare git-toplevel basename with no check of its own —
    # the `*)` sub-arm above also hands it straight to $umbrella_label — and
    # reaches `_apply_co_style` unconditionally. Safe because the name gate
    # lives in `_apply_co_style` itself (issue_01M3Q2DJMB5R37HZD9SMVTS323):
    # an unsafe name launches unstyled rather than reaching any OSC/tmux
    # write.
    _apply_co_style "$umbrella_proj" "$umbrella_accent" "$umbrella_label" "$umbrella_fg"
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --permission-mode $_co_permission_mode "$@"
fi
unset _umbrella_dirname _umbrella_dir

# Company-level commercial path: the one crew the registry flags
# `company_workspace: true` — company positioning + commercial
# presentation (ARCH-124), the altitude ABOVE the per-product
# <product>-commercial workspaces below. Default agent is the crew's own
# `co_default_agent` registry field (positioning-strategist when absent —
# platform decision 0100: a crew's settings come from the registry, not a
# name in bin/co's own source); `writer` starts the commercial-writer it
# dispatches for decks/copy, `pa` the product-analyst it reuses for data,
# `pm` the product-manager. This branch must precede the generic
# `*-commercial` branch below (this crew's own directory matches that glob
# too, but needs its own agents + project, not necessarily product-manager)
# — resolving it by registry FLAG rather than by name is what lets it keep
# that precedence with no name of its own in this file.
#
# No full-path gate here (unlike the crew-cockpit branch above): this branch
# never had one, even on `-r`, so there is nothing for the shared function
# below to reapply — it is a basename-only match in both places, unchanged.
_co_company_workspace_fields=$(python3 - "$(_co_lib_dir)" "$(_co_registry_path)" "$_co_crews_root" \
    2>/dev/null <<'PY' || true
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
try:
    import projects

    if sys.argv[2]:
        projects.PROJECTS_JSON = Path(sys.argv[2])
