#!/bin/bash
# install-individuator — build and deploy-pin the Individuator's root daemon
# (platform/decisions/0092; CQ·447 slice 3).
#
# WHY. The Individuator's machine key is usable only by the root daemon
# that holds it — 0092's whole point is that nothing readable as a file
# from an operator-level process (a dispatched run included) can act as
# this key. That means the daemon itself must run as root, from a
# root-owned binary, with a root-owned config naming the Bosun host and the
# accounts its Unix socket accepts a `register` request from (E12·2;
# platform/decisions/0099 item 8: a root-owned list of admitted accounts,
# "every account" meaning every account this config admits) — none of
# which this script may read from, or write into, the agent-platform
# checkout itself (ADR-0059's deploy-pinning rules apply here just as they
# do to a per-user daemon).
#
# The key itself is a software P-256 key the DAEMON creates and self-tests
# on its own first start, in its own launchd context (2026-10-15, replacing
# a Secure Enclave key this script used to generate and self-test itself,
# via `individuator keygen`/`individuator self-test`, right here, inside
# root's own `sudo` session). That is a DIFFERENT context than the one the
# daemon actually runs in, and that difference is exactly what masked a
# real production failure: the daemon's Secure Enclave signing was refused
# at its very first registration, because a launchd daemon cannot use the
# Secure Enclave at all — unsupported, not a configuration mistake — while
# this script's own `individuator self-test`, run inside the operator's
# login session moments earlier, had already passed. Running the self-test
# in the daemon's own process, every time it starts, closes that gap.
#
# WHAT THIS DOES:
#   1. Refuses outright unless running as root (`id -u` is 0) — every step
#      past this one writes root-owned files or a system-domain plist.
#   2. Reads a git REF (default main) via `git archive`, never the live
#      working tree, and builds the Individuator's Swift package in
#      release mode from that extracted copy.
#   3. Installs the two built binaries (`individuator`, the identity-core
#      CLI; `individuator-daemon`, the root service) as root-owned copies
#      under the install directory, and records their SHA-256 code hashes
#      alongside the ref and commit they were built from.
#   4. Copies `--root-ca` into a root-owned file beside the config (never
#      naming the operator-supplied path directly: that path typically sits
#      in the operator's home, writable by any process running as the
#      operator's uid), then writes the root-owned configuration
#      (`IndividuatorRootConfig`'s own JSON shape) naming the Bosun host,
#      its address, that copy's path, and the admitted accounts (each
#      `--account` resolved to a uid here, via `id -u`, rather than
#      resolved later by the daemon on every connection). `--bosun-host`
#      and `--account` each update only their own fields of an existing
#      config when given alone, and omitting both leaves it unchanged —
#      see usage() above for the full combination table.
#   5. Copies the LaunchDaemon plist into the system LaunchDaemons
#      directory (refusing to clobber a live one that has drifted from the
#      template, unless --force — the same idiom install.sh phase 4 and
#      install-run-register-api use) and bootstraps the job in the SYSTEM
#      domain — which, with the plist's own RunAtLoad, is what makes the
#      daemon create (or load, if a prior install already left one) and
#      self-test its key.
#   6. Waits for the daemon's own self-test line in --daemon-log (never
#      runs `individuator keygen` or `individuator self-test` itself —
#      see WHY above), then prints the CSR for the operator's signing
#      ceremony with the Library. The fingerprint for that ceremony comes
#      from the daemon's own self-test line, never recomputed by this
#      script: the whole point is that the number the operator hands the
#      Library is provably the daemon's own.
#
# The operator's remaining steps, after this script finishes, are not run
# by this script because no caller here can automate them yet: enroll the
# printed fingerprint with the Library under custody "root-file" —
# `enroll_machine.py issue <machine-name> <fingerprint> --custody
# root-file` — adopt the certificate it issues (`individuator adopt-cert`),
# and let the daemon register. That enroll call re-enrolls <machine-name>
# and so revokes its current "hardware" row in the same Library transaction;
# do not revoke it separately first. Once a registration succeeds, delete
# the retired Secure Enclave blob this script no longer writes or reads,
# /var/db/individuator/machine.key, by hand — never automated here, since
# nothing in this script can confirm a registration actually succeeded.
# The full operator procedure is the knowledge-base runbook
# agent-platform/runbooks/installing-the-individuator-with-a-root-file-key.
#
# Must stay bash-3.2-safe (no `declare -A`, `mapfile`, `${var,,}`, `&>>`):
# tests/bash/lint.sh parses every bin/ script with a bash-or-/bin/sh
# shebang under /bin/bash -n on macOS 3.2.57 (ARCH-082).
set -eu

usage() {
  cat >&2 <<'EOF'
usage: install-individuator [--ref=<git-ref>] [--repo=<path>] [--allow-non-main]
                             [--force] [--status]
                             [--bosun-host=<name>] [--bosun-address=<host:port>]
                             [--root-ca=<path>] [--account=<name>]...
                             [--library-address=<host:port>]
                             [--machine-name=<name>]
                             [--key-dir=<path>] [--install-dir=<path>]
                             [--config-path=<path>] [--launch-daemons-dir=<path>]
                             [--socket-dir=<path>] [--daemon-log=<path>]
                             [--self-test-wait-seconds=<n>]

Must be run as root (sudo).

  --ref=<git-ref>            Ref to build from (default: main).
  --repo=<path>              Checkout to read the ref from (default: this
                              script's own repo, resolved via bin/builder-root
                              against the invoking operator's home — SUDO_USER,
                              never root's own — since this always runs under
                              sudo; pass --repo if SUDO_USER is unset or root).
  --allow-non-main           Required to build anything other than main.
  --force                    Overwrite a live plist that differs from the template.
  --status                   Print what commit is currently deployed and exit.
  --bosun-host=<name>        The Bosun's machine name (its certificate's URI SAN
                              is convivy://machine/<name>). Required unless
                              --status or a config already exists at --config-path.
  --bosun-address=<host:port> Where to dial the Bosun's registration listener.
  --root-ca=<path>           The Library's root certificate, PEM. Copied to a
                              root-owned file beside --config-path; the config
                              names that copy, never this path.
  --account=<name>           A local account this machine's root daemon's
                              Unix socket accepts a `register` request from.
                              Repeat for more than one. Must match
                              ^[A-Za-z_][A-Za-z0-9_.-]*$ and resolve to a uid
                              via the system account database; a repeated
                              name, or two names resolving to the same uid,
                              is refused before anything is written. Required
                              on a first install (default: the account `sudo`
                              was run from, i.e. $SUDO_UID).
  --library-address=<host:port> Where to dial the Library for the forwarding
                              endpoint's Library-destined routes (E12·2 slice
                              S5b). Optional, and independent of --bosun-host/
                              --account: writes or updates only this one
                              field, preserving everything else already in
                              the config. Omitted (on a first install, or a
                              later run that never names it) means the
                              config carries no library_address at all, and
                              the daemon serves no forwarding socket.
  --machine-name=<name>      THIS machine's own name for the CSR (default:
                              `hostname -s`) — independent of --bosun-host,
                              which names a different machine.
  --key-dir=<path>           Where the machine key and certificate are stored
                              (default: /var/db/individuator).
  --install-dir=<path>       Where the built binaries are installed
                              (default: /usr/local/libexec/individuator).
  --config-path=<path>       Where the root-owned config is written
                              (default: /etc/individuator/config.json).
  --launch-daemons-dir=<path> Where the plist is installed
                              (default: /Library/LaunchDaemons).
  --socket-dir=<path>        Where the root daemon's Unix socket directory
                              is pre-created (default: /var/db/individuator-daemon,
                              matching IndividuatorPaths.defaultDaemonSocketPath).
  --daemon-log=<path>        Where the daemon's own self-test line is read from
                              (default: /var/log/individuator.out.log, the
                              plist's own StandardOutPath).
  --self-test-wait-seconds=<n> How long to wait for that line to appear before
                              continuing anyway with a warning (default: 5).

--bosun-host and --account are independent; against an existing
--config-path, each may be given alone to update only its own fields:
  both given         writes bosun_host/bosun_address/root_ca_path AND the
                      admitted-accounts list, all from this run's flags.
  --bosun-host only  updates bosun_host/bosun_address/root_ca_path and
                      keeps the admitted-accounts list already there.
  --account only     updates the admitted-accounts list and keeps
                      bosun_host/bosun_address/root_ca_path already there.
  neither given      leaves the config at --config-path unchanged.

--library-address is independent of both of the above: given, it writes
library_address alone (preserving every other field already there, or
freshly written by --bosun-host/--account in this same run); omitted, it
leaves library_address exactly as it already was (absent, on a first
install that never names it).
EOF
  exit 2
}

REPO=""
ROOT_CONFIG=""
REF="main"
ALLOW_NON_MAIN=0
PLIST_FORCE=0
STATUS_ONLY=0
BOSUN_HOST=""
BOSUN_ADDRESS=""
ROOT_CA=""
LIBRARY_ADDRESS=""
# Space-separated, one name per `--account`, in the order given — never a
# bash array: an EMPTY array subscripted as "${arr[@]}" under this script's
# own `set -u` throws "unbound variable" on bash 3.2 (confirmed against
# macOS's /bin/bash 3.2.57; fixed only in bash 4.4+), so a plain string
# is the bash-3.2-safe accumulator here, the same way `declare -A`/`mapfile`/
# `${var,,}` are avoided for ARCH-082. Account names never contain spaces.
ACCOUNT_NAMES=""
MACHINE_NAME=""
KEY_DIR="/var/db/individuator"
INSTALL_DIR="/usr/local/libexec/individuator"
CONFIG_PATH="/etc/individuator/config.json"
LAUNCH_DAEMONS_DIR="/Library/LaunchDaemons"
SOCKET_DIR="/var/db/individuator-daemon"
DAEMON_LOG="/var/log/individuator.out.log"
SELF_TEST_WAIT_SECONDS=5
# FOR TESTS ONLY: skips the git-archive + `swift build` step entirely and
# installs whatever is already at --build-dir/individuator{,-daemon} —
# the bash test suite stubs those two binaries rather than compiling a
# real Swift package on every run.
SKIP_BUILD=0
BUILD_DIR=""
# FOR TESTS ONLY: runs the real git-archive-and-extract step below (the same
# file list a real build uses), then runs the same per-product release build
# the real install path runs (build_release_binaries, below), and exits with
# that result before anything is installed. This is the real build, not a
# cheaper stand-in: `swift package describe` never compiles anything, so it
# cannot catch a build command that drags in the test targets (see
# build_release_binaries's own comment).
BUILD_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --ref=*) REF="${arg#--ref=}" ;;
    --repo=*) REPO="${arg#--repo=}" ;;
    --allow-non-main) ALLOW_NON_MAIN=1 ;;
    --force) PLIST_FORCE=1 ;;
    --status) STATUS_ONLY=1 ;;
    --bosun-host=*) BOSUN_HOST="${arg#--bosun-host=}" ;;
    --bosun-address=*) BOSUN_ADDRESS="${arg#--bosun-address=}" ;;
    --root-ca=*) ROOT_CA="${arg#--root-ca=}" ;;
    --account=*) ACCOUNT_NAMES="$ACCOUNT_NAMES ${arg#--account=}" ;;
    --library-address=*) LIBRARY_ADDRESS="${arg#--library-address=}" ;;
    --machine-name=*) MACHINE_NAME="${arg#--machine-name=}" ;;
    --key-dir=*) KEY_DIR="${arg#--key-dir=}" ;;
    --install-dir=*) INSTALL_DIR="${arg#--install-dir=}" ;;
    --config-path=*) CONFIG_PATH="${arg#--config-path=}" ;;
    --launch-daemons-dir=*) LAUNCH_DAEMONS_DIR="${arg#--launch-daemons-dir=}" ;;
    --socket-dir=*) SOCKET_DIR="${arg#--socket-dir=}" ;;
    --daemon-log=*) DAEMON_LOG="${arg#--daemon-log=}" ;;
    --self-test-wait-seconds=*) SELF_TEST_WAIT_SECONDS="${arg#--self-test-wait-seconds=}" ;;
    # FOR TESTS ONLY, same shape as install-run-register-api's --root-config.
    --root-config=*) ROOT_CONFIG="${arg#--root-config=}" ;;
    --skip-build) SKIP_BUILD=1 ;;
    --build-dir=*) BUILD_DIR="${arg#--build-dir=}" ;;
    # FOR TESTS ONLY, see BUILD_ONLY above.
    --build-only) BUILD_ONLY=1 ;;
    -h|--help) usage ;;
    *) echo "install-individuator: unknown option: $arg" >&2; usage ;;
  esac
done

say() { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }

# build_release_binaries <package-dir> — builds ONLY the two installed
# products, one `swift build -c release --product <p>` per product, rather
# than a whole-package `swift build -c release`. The whole-package form also
# builds the test targets (IndividuatorCoreTests, IndividuatorNetworkTests),
# and `@testable import IndividuatorCore` inside those targets cannot resolve
# against a release build of IndividuatorCore, which fails the build outright
# instead of producing the two binaries below (seen with Xcode 27 / Swift
# 6.4: "unable to resolve Swift module dependency to a compatible module").
# Both the real install path and --build-only call this same function, so the
# check mode can never drift from what actually gets installed.
build_release_binaries() {
  ( cd "$1" && swift build -c release --product individuator ) || return 1
  ( cd "$1" && swift build -c release --product individuator-daemon ) || return 1
}

# --- --status: no install side effects --------------------------------------
if [ "$STATUS_ONLY" -eq 1 ]; then
  if [ -f "$INSTALL_DIR/DEPLOYED_COMMIT" ]; then
    cat "$INSTALL_DIR/DEPLOYED_COMMIT"
    exit 0
  fi
  echo "install-individuator: nothing deployed yet at $INSTALL_DIR" >&2
  exit 1
fi

# --- must be root: every step past this one writes a root-owned file or a
# system-domain plist. -------------------------------------------------------
if [ "$(id -u)" -ne 0 ]; then
  echo "install-individuator: must be run as root (try: sudo $0 ...)" >&2
  exit 1
fi

if [ -z "$REPO" ]; then
  _self_path="$0"; [ -L "$_self_path" ] && _self_path="$(readlink "$_self_path")"
  if [ -n "$ROOT_CONFIG" ]; then
    # FOR TESTS ONLY: names the machine's root directly, bypassing the
    # SUDO_USER resolution below entirely.
    _root="$("$(dirname "$_self_path")/builder-root" --root --config "$ROOT_CONFIG")" || _root=""
    if [ -z "$_root" ]; then
      echo "install-individuator: cannot resolve the machine's root (bin/builder-root --root --config $ROOT_CONFIG); pass --repo" >&2
      exit 2
    fi
  else
    # This script always runs under sudo (the root check above already
    # passed). `bin/builder-root --root` resolves the PASSWD home of the
    # CALLING process's own uid (builder_root.real_account_home reads
    # pwd.getpwuid(os.getuid())), which under sudo is root's uid, 0 — so
    # plain `builder-root --root` here always resolves root's own home,
    # /var/root, never the invoking operator's, no matter what $HOME a
    # shell carries into sudo. Production occurrence, 2026-11-02: `sudo
    # install-individuator` resolved /var/root/builder/agent-platform and
    # refused it as "not a git checkout".
    #
    # SUDO_USER is sudo's own report of the account it was invoked from —
    # never inherited from the caller's environment, set by the sudo
    # binary itself — so it is trusted here, but ONLY now that running as
    # root (`id -u` 0) is already confirmed above; an unset SUDO_USER (a
    # direct root login, or a sudo config that strips it) or one naming
    # root itself names no OTHER account to resolve, so this refuses
    # rather than silently falling back to builder-root's own (root's)
    # home as before.
    if [ "$(id -u)" -ne 0 ]; then
      echo "install-individuator: internal error: REPO resolution reached with id -u != 0" >&2
      exit 1
    fi
    case "${SUDO_USER:-}" in
      "")
        echo "install-individuator: no SUDO_USER (not invoked via sudo from another account, or it was stripped) — cannot resolve the invoking operator's checkout under sudo; pass --repo" >&2
        exit 2
        ;;
      root)
        echo "install-individuator: SUDO_USER=root — refusing to resolve root's own checkout as the invoking operator's; pass --repo" >&2
        exit 2
        ;;
    esac
    # Same strict, JSON-safe character class as --account, above: a
    # SUDO_USER outside it resolves no real account, so this is refused
    # before it ever reaches `dscacheutil` as an argument.
    case "$SUDO_USER" in
      [A-Za-z_]*) ;;
      *) echo "install-individuator: SUDO_USER is not a valid account name: $SUDO_USER" >&2; exit 2 ;;
    esac
    case "$SUDO_USER" in
      *[!A-Za-z0-9_.-]*) echo "install-individuator: SUDO_USER is not a valid account name: $SUDO_USER" >&2; exit 2 ;;
    esac
    # The system account database, never a string built from SUDO_USER's
    # name: dscacheutil's `dir:` field is the account's actual configured
    # home, which need not live under the same parent directory as every
    # other account's.
    _invoking_home=""
    if command -v dscacheutil >/dev/null 2>&1; then
      _invoking_home="$(dscacheutil -q user -a name "$SUDO_USER" 2>/dev/null | sed -n 's/^dir: *//p' | head -n 1)"
    fi
    if [ -z "$_invoking_home" ] || [ ! -d "$_invoking_home" ]; then
      echo "install-individuator: cannot resolve SUDO_USER=$SUDO_USER's home via the system account database (dscacheutil); pass --repo" >&2
      exit 2
    fi
    # `--home` (not `--config`) carries the invoking account's home all the
    # way through root(): its OWN session-agent.env, its own fallback when
    # unconfigured, and the "too wide" guard, all resolved against
    # $_invoking_home rather than the calling (root) process's. `--config`
    # alone is not enough — it only moves which file is read; `~`
    # expansion, the compiled-in default root and the too-wide guard would
    # still have resolved against root's own home (round-1 finding,
    # confirmed empirically against f33f3d9e6: a session-agent.env naming no
    # CREWS_ROOT, or one of `~`/`~/builder`, still resolved under /var/root).
    _root="$("$(dirname "$_self_path")/builder-root" --root --home "$_invoking_home")" || _root=""
    if [ -z "$_root" ]; then
      echo "install-individuator: cannot resolve $SUDO_USER's root (bin/builder-root --root --home $_invoking_home); pass --repo" >&2
      exit 2
    fi
  fi
  REPO="$_root/agent-platform"
fi

if [ -z "$BOSUN_HOST" ] && [ ! -f "$CONFIG_PATH" ]; then
  echo "install-individuator: --bosun-host is required on a first install" >&2
  exit 2
fi
if [ -n "$BOSUN_HOST" ] && { [ -z "$BOSUN_ADDRESS" ] || [ -z "$ROOT_CA" ]; }; then
  echo "install-individuator: --bosun-host requires --bosun-address and --root-ca" >&2
  exit 2
fi

# On a first install (no config at --config-path yet), fall back to the
# account `sudo` was run from — the same ergonomic default the retired
# `--operator-uid` flag's "${SUDO_UID:-}" gave, just resolved to a name
# instead of taking a uid directly.
if [ -z "$ACCOUNT_NAMES" ] && [ ! -f "$CONFIG_PATH" ] && [ -n "${SUDO_UID:-}" ]; then
  _default_account="$(id -un "$SUDO_UID" 2>/dev/null)" || _default_account=""
  [ -n "$_default_account" ] && ACCOUNT_NAMES="$_default_account"
fi

# --- validate --account up front, before any build or write. Each name
# must match this strict, JSON-safe character class and resolve to a uid
# through the system account database (`id -u`); a name failing either is
# refused by name, before anything is written — fixing by construction the
# security-reviewer's PR 1110 round-1 finding that a hand-built JSON
# string let an unescaped name close its string and add an entry naming a
# uid the operator never gave. A name, or a uid two different names
# resolve to, repeated across --account is refused the same way, naming
# the duplicate, rather than reaching IndividuatorRootConfig.load as a
# config that only fails closed there, or main.swift's admitted-accounts
# dictionary build trapping on a duplicate key (reviewer's finding, same
# round). ACCOUNT_PAIRS collects "<uid>:<name>" tokens, one per --account,
# in order — uid resolved HERE, by this script itself, never carried
# forward as the operator's own argument text. --------------------------
ACCOUNT_PAIRS=""
if [ -n "$ACCOUNT_NAMES" ]; then
  _seen_account_names=""
  _seen_account_uids=""
  for _name in $ACCOUNT_NAMES; do
    case "$_name" in
      [A-Za-z_]*) ;;
      *) echo "install-individuator: invalid --account name: $_name" >&2; exit 2 ;;
    esac
    case "$_name" in
      *[!A-Za-z0-9_.-]*) echo "install-individuator: invalid --account name: $_name" >&2; exit 2 ;;
    esac
    case " $_seen_account_names " in
      *" $_name "*) echo "install-individuator: duplicate --account: $_name" >&2; exit 2 ;;
    esac
    _uid="$(id -u "$_name" 2>/dev/null)" || {
      echo "install-individuator: no such account: $_name" >&2
      exit 2
    }
    case " $_seen_account_uids " in
      *" $_uid "*)
        echo "install-individuator: duplicate --account: $_name resolves to uid $_uid, already admitted by another --account" >&2
        exit 2
        ;;
    esac
    _seen_account_names="$_seen_account_names $_name"
    _seen_account_uids="$_seen_account_uids $_uid"
    ACCOUNT_PAIRS="$ACCOUNT_PAIRS $_uid:$_name"
  done
fi
if [ -z "$ACCOUNT_PAIRS" ] && [ ! -f "$CONFIG_PATH" ]; then
  echo "install-individuator: --account is required on a first install (repeat --account for more than one)" >&2
  exit 2
fi

git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "install-individuator: $REPO is not a git checkout" >&2
  exit 1
}

SHA="$(git -C "$REPO" rev-parse "$REF" 2>/dev/null)" || {
  echo "install-individuator: '$REF' does not resolve to a commit in $REPO" >&2
  exit 1
}

if [ "$REF" != "main" ] && [ "$ALLOW_NON_MAIN" -ne 1 ]; then
  echo "install-individuator: REFUSING to build ref '$REF' (resolves to $SHA)." >&2
  echo "  ADR-0059 rule 6: the deploy area builds from main. Pass --allow-non-main" >&2
  echo "  to build a different ref anyway (e.g. to verify a branch before merge)." >&2
  exit 1
fi

say "Installing the Individuator from $REF ($SHA) in $REPO"

# --- stage and build in a sibling dir, never in place -----------------------
STAGE="$INSTALL_DIR.new"
_cleanup_stage() { rm -rf "$STAGE" "$STAGE.tar"; }
trap _cleanup_stage EXIT
trap '_cleanup_stage; exit 130' INT
trap '_cleanup_stage; exit 143' TERM
rm -rf "$STAGE"
mkdir -p "$STAGE"

if [ "$SKIP_BUILD" -eq 1 ]; then
  if [ -z "$BUILD_DIR" ]; then
    echo "install-individuator: --skip-build requires --build-dir" >&2
    exit 2
  fi
  BUILT_INDIVIDUATOR="$BUILD_DIR/individuator"
  BUILT_DAEMON="$BUILD_DIR/individuator-daemon"
else
  command -v swift >/dev/null 2>&1 || {
    echo "install-individuator: swift not found on PATH" >&2
    exit 1
  }
  ARCHIVE="$STAGE.tar"
  rm -f "$ARCHIVE"
  git -C "$REPO" archive "$SHA" -- \
      individuator/Package.swift \
      individuator/Package.resolved \
      individuator/Sources \
      individuator/Tests \
    > "$ARCHIVE"
  tar -x -C "$STAGE" -f "$ARCHIVE"
  rm -f "$ARCHIVE"

  if [ "$BUILD_ONLY" -eq 1 ]; then
    say "Build-only: building the two installed products (swift build -c release --product ...)"
    if build_release_binaries "$STAGE/individuator" \
        && [ -x "$STAGE/individuator/.build/release/individuator" ] \
        && [ -x "$STAGE/individuator/.build/release/individuator-daemon" ]; then
      exit 0
    else
      exit 1
    fi
  fi

  say "Building the release binaries (swift build -c release --product individuator, --product individuator-daemon)"
  build_release_binaries "$STAGE/individuator"
  BUILT_INDIVIDUATOR="$STAGE/individuator/.build/release/individuator"
  BUILT_DAEMON="$STAGE/individuator/.build/release/individuator-daemon"
fi

[ -x "$BUILT_INDIVIDUATOR" ] || { echo "install-individuator: $BUILT_INDIVIDUATOR is missing or not executable" >&2; exit 1; }
[ -x "$BUILT_DAEMON" ] || { echo "install-individuator: $BUILT_DAEMON is missing or not executable" >&2; exit 1; }

# --- install the binaries, root-owned, with their code hash recorded --------
mkdir -p "$(dirname "$INSTALL_DIR")"
OLD=""
if [ -d "$INSTALL_DIR" ]; then
  OLD="$INSTALL_DIR.old.$$"
  mv "$INSTALL_DIR" "$OLD"
fi
mkdir -p "$INSTALL_DIR"
cp "$BUILT_INDIVIDUATOR" "$INSTALL_DIR/individuator"
cp "$BUILT_DAEMON" "$INSTALL_DIR/individuator-daemon"
chown root:wheel "$INSTALL_DIR/individuator" "$INSTALL_DIR/individuator-daemon" 2>/dev/null || true
chmod 755 "$INSTALL_DIR/individuator" "$INSTALL_DIR/individuator-daemon"

{
  echo "ref: $REF"
  echo "commit: $SHA"
  echo "installed_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "installed_from: $REPO"
  echo "individuator_sha256: $(shasum -a 256 "$INSTALL_DIR/individuator" | awk '{print $1}')"
  echo "individuator_daemon_sha256: $(shasum -a 256 "$INSTALL_DIR/individuator-daemon" | awk '{print $1}')"
} > "$INSTALL_DIR/DEPLOYED_COMMIT"
[ -n "$OLD" ] && rm -rf "$OLD"
trap - EXIT INT TERM
rm -rf "$STAGE" "$STAGE.tar"

say "Installed: $INSTALL_DIR (commit $SHA)"

# --- the daemon's socket directory. Root-owned, mode 0755, matching
# IndividuatorPaths.defaultDaemonSocketPath's parent exactly: the daemon
# re-verifies and (on a fresh boot, were this directory ever to need it)
# recreates this itself on every start, since launchd's KeepAlive restarts
# it after a crash — this step exists so the directory, and its whole
# ancestor chain, is already correct before the plist is ever bootstrapped
# below, rather than depending on the daemon's first run to get it right. --
mkdir -p "$SOCKET_DIR"
chown root:wheel "$SOCKET_DIR" 2>/dev/null || true
chmod 755 "$SOCKET_DIR"

INDIVIDUATOR_BIN="$INSTALL_DIR/individuator"

# --- the root-owned configuration (IndividuatorRootConfig's own shape) ------
# --bosun-host, --account and --library-address are all independent (see
# usage() above for the full combination table): any may be given alone to
# update just its own fields of an existing config, preserving the others'
# current values.
if [ -z "$BOSUN_HOST" ] && [ -z "$ACCOUNT_PAIRS" ] && [ -z "$LIBRARY_ADDRESS" ]; then
  say "Config unchanged (none of --bosun-host, --account or --library-address given): $CONFIG_PATH"
else
  mkdir -p "$(dirname "$CONFIG_PATH")"
  chmod 700 "$(dirname "$CONFIG_PATH")"

  ROOT_CA_COPY_FOR_JSON=""
  if [ -n "$BOSUN_HOST" ]; then
    # --- pin the trust anchor: copy --root-ca into the same root-owned 0700
    # directory as the config, rather than pointing the config at the path the
    # operator gave as-is. The natural --root-ca value sits in the operator's
    # home, writable by any process running as the operator's uid — including
    # a dispatched run — which could otherwise redirect the daemon's trust
    # anchor after this install finishes. The copy is refreshed only when the
    # source differs from what is already there, so a re-run that passes the
    # same --root-ca does not needlessly rewrite a root-owned file. -----------
    ROOT_CA_COPY="$(dirname "$CONFIG_PATH")/root-ca.pem"
    if [ -f "$ROOT_CA_COPY" ] && cmp -s "$ROOT_CA" "$ROOT_CA_COPY"; then
      say "Root CA unchanged: $ROOT_CA_COPY"
    else
      ROOT_CA_TMP="$ROOT_CA_COPY.new.$$"
      cp "$ROOT_CA" "$ROOT_CA_TMP"
      chmod 644 "$ROOT_CA_TMP"
      chown root:wheel "$ROOT_CA_TMP" 2>/dev/null || true
      mv "$ROOT_CA_TMP" "$ROOT_CA_COPY"
      say "Root CA copied: $ROOT_CA -> $ROOT_CA_COPY"
    fi
    ROOT_CA_COPY_FOR_JSON="$ROOT_CA_COPY"
  fi

  # --- the admitted accounts (E12·2; platform/decisions/0099 item 8), and
  # every other field, built through python3's json module — stock on
  # macOS, the same `/usr/bin/python3` heredoc idiom bin/tailscale-watchdog
  # already depends on — rather than string concatenation, so construction
  # itself (not just the --account character-class check above) rules out
  # a name or host string closing its JSON string early (security-reviewer
  # finding on PR 1110 round 1). Reads whatever is already at
  # --config-path, when something is, to preserve the half of the config
  # (bosun_host/bosun_address/root_ca_path, or admitted_accounts/
  # operator_uid) this run did not pass new values for. ACCOUNT_PAIRS is
  # "<uid>:<name>" tokens, already validated and deduplicated above; a uid
  # was resolved by this script via `id -u`, never passed through as the
  # operator's own argument text. -------------------------------------------
  CONFIG_TMP="$CONFIG_PATH.new.$$"
  if ! /usr/bin/python3 - "$CONFIG_PATH" "$BOSUN_HOST" "$BOSUN_ADDRESS" "$ROOT_CA_COPY_FOR_JSON" \
      "$LIBRARY_ADDRESS" $ACCOUNT_PAIRS \
      > "$CONFIG_TMP" <<'PY'
import json
import sys

config_path, bosun_host, bosun_address, root_ca_path, library_address = sys.argv[1:6]
pairs = sys.argv[6:]

existing = {}
try:
    with open(config_path) as f:
        existing = json.load(f)
except FileNotFoundError:
    pass

doc_bosun_host = bosun_host or existing.get("bosun_host")
doc_bosun_address = bosun_address or existing.get("bosun_address")
doc_root_ca_path = root_ca_path or existing.get("root_ca_path")
if None in (doc_bosun_host, doc_bosun_address, doc_root_ca_path):
    sys.exit(
        "install-individuator: no existing config at " + config_path
        + " to preserve the Bosun fields from")
# The forwarding endpoint's Library destination (E12·2 slice S5b): optional,
# and left absent entirely (never written as JSON null) when neither this
# run nor any prior one ever named --library-address.
doc_library_address = library_address or existing.get("library_address")

accounts = None
operator_uid = None
if pairs:
    accounts = []
    seen_uids = set()
    seen_names = set()
    for pair in pairs:
        uid_str, name = pair.split(":", 1)
        uid = int(uid_str)
        if uid in seen_uids or name in seen_names:
            sys.exit(
                "install-individuator: duplicate account in admitted_accounts: " + name)
        seen_uids.add(uid)
        seen_names.add(name)
        accounts.append({"uid": uid, "account": name})
elif "admitted_accounts" in existing:
    accounts = existing["admitted_accounts"]
elif "operator_uid" in existing:
    operator_uid = existing["operator_uid"]
else:
    sys.exit(
        "install-individuator: no existing admitted accounts at " + config_path
        + " to preserve")

lines = ["{"]
lines.append('  "bosun_host": %s,' % json.dumps(doc_bosun_host))
lines.append('  "bosun_address": %s,' % json.dumps(doc_bosun_address))
lines.append('  "root_ca_path": %s,' % json.dumps(doc_root_ca_path))
if doc_library_address:
    lines.append('  "library_address": %s,' % json.dumps(doc_library_address))
if accounts is not None:
    entries = ", ".join(json.dumps(a) for a in accounts)
    lines.append('  "admitted_accounts": [%s]' % entries)
else:
    lines.append('  "operator_uid": %s' % json.dumps(operator_uid))
lines.append("}")
sys.stdout.write("\n".join(lines) + "\n")
PY
  then
    rm -f "$CONFIG_TMP"
    exit 2
  fi
  chmod 600 "$CONFIG_TMP"
  mv "$CONFIG_TMP" "$CONFIG_PATH"
  say "Config written: $CONFIG_PATH"
fi

# --- the plist: never clobbering a live one that has drifted from the
# template (ARCH-342 idiom), same as install.sh phase 4 and
# install-run-register-api. --------------------------------------------------
PLIST_NAME="com.convivy.individuator.plist"
mkdir -p "$LAUNCH_DAEMONS_DIR"
PLIST_STAGE="$LAUNCH_DAEMONS_DIR/$PLIST_NAME.new"
git -C "$REPO" show "$SHA:launchd/$PLIST_NAME" > "$PLIST_STAGE"
PLIST_LIVE="$LAUNCH_DAEMONS_DIR/$PLIST_NAME"
if [ -f "$PLIST_LIVE" ] && ! diff -q "$PLIST_LIVE" "$PLIST_STAGE" >/dev/null 2>&1 && [ "$PLIST_FORCE" -ne 1 ]; then
  warn "live plist differs from the template — NOT overwritten (--force to replace):"
  diff -u "$PLIST_LIVE" "$PLIST_STAGE" | sed 's/^/    /' || true
  rm -f "$PLIST_STAGE"
else
  mv "$PLIST_STAGE" "$PLIST_LIVE"
  chown root:wheel "$PLIST_LIVE" 2>/dev/null || true
  say "Plist installed: $PLIST_LIVE"
fi

# --- bootstrap the job in the SYSTEM domain. Non-fatal: a job already
# loaded, or a launchctl this machine refuses for its own reasons, must not
# abort an otherwise-successful install — the self-test wait and CSR below
# are worth running regardless. RunAtLoad means this is also what makes the
# daemon create (or load) and self-test its own key. -------------------------
launchctl bootout system/com.convivy.individuator >/dev/null 2>&1 || true
BOOTSTRAP_ERR="$(mktemp "${TMPDIR:-/tmp}/individuator-bootstrap-err.XXXXXX")"
if launchctl bootstrap system "$PLIST_LIVE" 2>"$BOOTSTRAP_ERR"; then
  say "Bootstrapped: system/com.convivy.individuator"
else
  warn "could not bootstrap the job (see below); the binaries and config are installed regardless"
  cat "$BOOTSTRAP_ERR" >&2 || true
fi
rm -f "$BOOTSTRAP_ERR"

# --- wait for the daemon's own self-test line in $DAEMON_LOG, rather than
# ever running `individuator self-test` or `individuator fingerprint`
# ourselves (see WHY, above). Bounded: the daemon normally creates and
# self-tests its key within moments of RunAtLoad starting it, but this
# script must not hang forever if the job never actually started (the
# warning above already covers that case; this one is distinct — the job
# loaded but hasn't logged yet). A timeout here is non-fatal: the CSR below
# still runs, and fails loudly on its own if the key truly never appeared. -
say "Waiting up to ${SELF_TEST_WAIT_SECONDS}s for the daemon's self-test line in $DAEMON_LOG"
waited=0
self_test_line=""
while [ "$waited" -lt "$SELF_TEST_WAIT_SECONDS" ]; do
  if [ -f "$DAEMON_LOG" ]; then
    self_test_line="$(grep 'machine key self-test' "$DAEMON_LOG" 2>/dev/null | tail -1)"
    [ -n "$self_test_line" ] && break
  fi
  sleep 1
  waited=$((waited + 1))
done
if [ -n "$self_test_line" ]; then
  say "Daemon self-test: $self_test_line"
else
  warn "no self-test line from the daemon in $DAEMON_LOG after ${SELF_TEST_WAIT_SECONDS}s"
  warn "check 'launchctl print system/com.convivy.individuator' and $DAEMON_LOG by hand before continuing"
fi

MACHINE_NAME="${MACHINE_NAME:-$(hostname -s 2>/dev/null || hostname)}"
say "Certificate signing request for '$MACHINE_NAME' (for the operator's enrollment ceremony with the Library, custody \"root-file\"):"
"$INDIVIDUATOR_BIN" csr --machine-name "$MACHINE_NAME" --key-dir "$KEY_DIR"
