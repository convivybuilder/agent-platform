        "session-dir",
        help="create/resolve this co session's canonical run dir and print it")
    sp_sdir.add_argument("--product", required=True,
                         help="product slug, e.g. vivy (names the dir co-<product>-<HHMM>)")
    sp_sdir.add_argument("--print", dest="print_", choices=("path", "id"), default="path",
                         help="path (default): absolute dir. id: the session's stable "
