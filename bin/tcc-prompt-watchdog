#!/usr/bin/env python3
"""tcc-prompt-watchdog — long-running daemon: push a phone alert when macOS
raises a TCC permission prompt on this machine (issue_01M3Q1VHWARM4NKYRH44D0MYX5).

Launched by launchd (launchd/com.convivy.tcc-prompt-watchdog.plist, KeepAlive) so
a crash restarts it the same way `log stream` itself restarts on exit. All the
logic — the predicate, the two prompt-message parsers, the dedup window, the
restart loop — lives in lib/agent-platform/tcc_prompt_watch.py so it can be
unit-tested without a real `log stream` subprocess.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Prefer this checkout's own lib over the installed farm, same reasoning as
# bin/budget-watchdog: a Builder deploy area has bin/ and lib/agent-platform/
# together but no ~/.local farm at all.
for _libdir in ((Path(__file__).resolve().parent.parent / "lib" / "agent-platform"),
                Path.home() / ".local" / "lib" / "agent-platform"):
    if (_libdir / "tcc_prompt_watch.py").is_file():
        sys.path.insert(0, str(_libdir))
        break
import tcc_prompt_watch  # noqa: E402

if __name__ == "__main__":
    sys.exit(tcc_prompt_watch.main())
