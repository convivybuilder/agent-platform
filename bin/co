# NYH-architecture path: the <root>/nyh-architecture/ umbrella holds one git repo
# per physical-architecture project for NYH (Now You're Here, the operator's short-term-rental
# company): floorplans -> SketchUp -> Layout. NOT Convivy products and NOT software:
# no knowledge-ctx profile, no agent, no KB pull (local git; each dir's CLAUDE.md
# supplies the role). co here is the launch ergonomic + handoff muscle memory; -r with
# no prompt resumes the latest handoff. Per-project styling (ARCH-077): each project
# carries its own iTerm DynamicProfile co-<project>.json (deploys laptop-side, ARCH-078)
# and an accent below; the tmux status color works from the mini regardless. Adding a
# project = add a case arm here + an iterm/co-<project>.json.
# Matches any repo directly under <root>/nyh-architecture/.
_nyh_umbrella="$_co_crews_root/nyh-architecture"
if [[ -n $repo_root && $(dirname "$repo_root") == $_nyh_umbrella ]]; then
    if $refresh && [[ $# -eq 0 ]]; then
        set -- /handoff-pickup
    fi
    nyh_proj=$(basename "$repo_root")
    nyh_fg="#ffffff"   # status-bar foreground; override for light/bright accents
    case $nyh_proj in
        nyh-park-villa) nyh_accent="#6F4E37"; nyh_label="Park Villa" ;;                          # brown
        nyh-etc)        nyh_accent="#1bb5ad"; nyh_label="East Texas Circle"; nyh_fg="#0b2e2b" ;; # turquoise (Tucson); dark fg for the bright accent
        *)              nyh_accent="#6F4E37"; nyh_label="$nyh_proj" ;;                            # default brown + raw repo name until the project gets its own
    esac
    # $nyh_proj is a bare git-toplevel basename with no check of its own —
    # the `*)` sub-arm above also hands it straight to $nyh_label — and
    # reaches `_apply_co_style` unconditionally. Safe because the name gate
    # lives in `_apply_co_style` itself (issue_01M3Q2DJMB5R37HZD9SMVTS323):
    # an unsafe name launches unstyled rather than reaching any OSC/tmux
    # write.
    _apply_co_style "$nyh_proj" "$nyh_accent" "$nyh_label" "$nyh_fg"
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --permission-mode $_co_permission_mode "$@"
fi

# Company-level commercial path: <root>/convivy-commercial — Convivy's company
# positioning + commercial presentation (ARCH-124), the altitude ABOVE the
# per-product <product>-commercial workspaces (ARCH-049). Default agent is the
# positioning-strategist; `writer` starts the commercial-writer it dispatches for
# decks/copy, `pa` the product-analyst it reuses for data. Lemon styling. The
# convivy-commercial → convivy map in `projects.EXPLICIT_PROJECT_BY_NAME` means
# `knowledge-ctx use commercial` activates the convivy/commercial profile. This
# branch must precede the generic `*-commercial` branch below (convivy-commercial
# matches that glob too, but needs its own agents + project, not product-manager).
#
# No full-path gate here (unlike substrate/selector/deck above): this branch
# never had one, even on `-r`, so there is nothing for the shared function
# below to reapply — it is a basename-only match in both places, unchanged.
_co_convivy_commercial_refresh() {
    print -u2 "co: refresh (convivy-commercial) — pulling $_co_crews_root/knowledge"
    _co_pull_knowledge || {
        print -u2 "co: refresh — knowledge pull failed."
        return 1
    }
    _co_reindividuate commercial "Common cause: a prior \`claude\` session still running here. Exit it first."
}

if [[ -n $repo_root && $(basename "$repo_root") == convivy-commercial ]]; then
    agent=positioning-strategist
    case "${1:-}" in
        ""|ps|strategist|positioning-strategist)  [[ -n ${1:-} ]] && shift ;;
        w|writer|commercial-writer)               agent=commercial-writer; shift ;;
        pa|analyst|product-analyst)               agent=product-analyst; shift ;;
        # A leading `/` is a prompt (e.g. rollover's `/handoff-pickup <path>`,
        # spawn_successor's `co -r "/handoff-pickup <path>"`), not an agent
        # name — no agent name here starts with `/`. Leave it in place as the
        # positional prompt and keep the branch's default agent. `--resume` is
        # the same, for `co restore`'s typed resume line.
        /*|--resume)                               ;;
        *)                                        agent=$1; shift ;;
    esac
    if $refresh; then
        _co_convivy_commercial_refresh || exit 1
        [[ $agent == positioning-strategist && $# -eq 0 ]] && set -- /handoff-pickup
    fi
    _co_refresh_if_stale _co_convivy_commercial_refresh
    agent_file=".claude/agents/${agent}.md"
    if [[ ! -f $agent_file ]]; then
        # ${(V)}: $(pwd) is cwd-derived (issue_01M3Q2DJMB5R37HZD9SMVTS323 round 2),
        # escaped regardless of this branch's closed-set (exact-literal) gate.
        print -u2 "co: agent '$agent' not individuated in ${(V)$(pwd)}/.claude/agents/"
        print -u2 "    Activate the company commercial profile first:  knowledge-ctx use commercial"
        exit 1
    fi
    # Lemon: light-yellow accent ($2) with a dark status foreground ($4 — white,
    # the default, is unreadable on lemon); "Convivy Commercial" is the display
    # label ($3). The iTerm profile co-convivy-commercial uses a pale-lemon bg.
    # Distinct from the steward `convivy` coral (#f4604c).
    _apply_co_style convivy-commercial "#e6ce00" "Convivy Commercial" "#26240a"
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --agent "$agent" --permission-mode $_co_permission_mode "$@"
fi

# Commercial path: the <root>/<product>-commercial/ workspaces (ARCH-049) —
# commercial-side product-manager sessions on the `commercial` profile, distinct
# from the engineering `daytime` profile. Default agent is product-manager; `pa`
# starts the product-analyst it dispatches for data. `-r` pulls knowledge,
# re-individuates the commercial profile, and resumes from the latest handoff.
#
# No full-path gate here either (same note as convivy-commercial above): a
# basename-only match in both places, unchanged.
_co_commercial_refresh() {
    print -u2 "co: refresh (commercial) — pulling $_co_crews_root/knowledge"
    _co_pull_knowledge || {
        print -u2 "co: refresh — knowledge pull failed."
        return 1
    }
    _co_reindividuate commercial "Common cause: a prior \`claude\` session still running here. Exit it first."
}

if [[ -n $repo_root && $(basename "$repo_root") == *-commercial ]]; then
    agent=product-manager
    case "${1:-}" in
        ""|pm|product-manager)        [[ -n ${1:-} ]] && shift ;;
        pa|analyst|product-analyst)   agent=product-analyst; shift ;;
        # A leading `/` is a prompt (e.g. rollover's `/handoff-pickup <path>`,
        # spawn_successor's `co -r "/handoff-pickup <path>"`), not an agent
        # name — no agent name here starts with `/`. Leave it in place as the
        # positional prompt and keep the branch's default agent. `--resume` is
        # the same, for `co restore`'s typed resume line.
        /*|--resume)                  ;;
        *)                            agent=$1; shift ;;
    esac
    if $refresh; then
        _co_commercial_refresh || exit 1
        [[ $agent == product-manager && $# -eq 0 ]] && set -- /handoff-pickup
    fi
    _co_refresh_if_stale _co_commercial_refresh
    agent_file=".claude/agents/${agent}.md"
    if [[ ! -f $agent_file ]]; then
        # ${(V)}: $(pwd) is cwd-derived (issue_01M3Q2DJMB5R37HZD9SMVTS323 round 2);
        # this is the glob-suffix (*-commercial) arm the round-1 reviews flagged
        # as reachable by any attacker-named directory ending in -commercial.
        print -u2 "co: agent '$agent' not individuated in ${(V)$(pwd)}/.claude/agents/"
        print -u2 "    Activate the commercial profile first:  knowledge-ctx use commercial"
        exit 1
    fi
    # Commercial workspaces share the product's brand styling (vivy-commercial
    # → vivy palette, constance-commercial → constance palette).
    commercial_product=$(basename "$repo_root")
    commercial_product=${commercial_product%-commercial}
    # Same shape as the case at the end of this file, and the same fallback for
    # the same reason. Not reachable today — the only `*-commercial` directories
    # on disk are vivy- and constance-, both covered, and convivy-commercial is
    # intercepted earlier — but a third commercial workspace would launch
    # unnamed without this.
    _co_set_name "$commercial_product"
    case $commercial_product in
        constance) _apply_co_style constance "#5B2A86" ;;
        vivy)      _apply_co_style vivy      "#1F4E79" ;;
    esac
    _co_exec_claude --remote-control $_co_name_args $claude_model_args --agent "$agent" --permission-mode $_co_permission_mode "$@"
fi

# Standalone Cookbook projects (~/Cookbook, ~/cookbook-app) — personal projects,
# NOT Convivy products: no knowledge-ctx profile and no agent to individuate. `co`
# here is purely the launch ergonomic carried over from the product repos —
