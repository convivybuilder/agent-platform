<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.convivy.knowledge-watcher</string>

  <!-- Deploy-pinned per platform/decisions/0059 rule 1
       (issue_01M19RRWSS9ETR09N9M2BJPA0Q): knowledge-watcher is a long-running
       daemon (KeepAlive true), not a timer, so ADR-0059's rationale applies in
       its sharper form — a daemon holds whatever branch it started from for as
       long as it runs, where a timer at least re-reads on its next firing. This
       reads a COPY installed from `main` into
       ~/.local/deploy/agent-platform-shared/ (rules 2, 6, 7) instead of the
       ~/.local/bin symlink into the checkout — that symlink still exists and
       still reaches the tree, for the person who re-invokes knowledge-watcher
       interactively while working on it (rule 5).
       bin/agent-platform-autopull refreshes the deploy area on every
       origin/main advance; bin/install-agent-platform-shared is what actually
       builds it, and now also ships lib/knowledge/ and installs watchdog +
       PyYAML into the deploy venv, since this daemon imports both.
       ProgramArguments names the deploy area's own pinned interpreter
       explicitly (rule 4), not the shebang or launchd's PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/deploy/agent-platform-shared/venv/bin/python3</string>
    <string>__HOME__/.local/deploy/agent-platform-shared/bin/knowledge-watcher</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/.local/deploy/agent-platform-shared</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.knowledge-index/watcher.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.knowledge-index/watcher.out.log</string>
</dict>
</plist>
