        help="seconds to wait for a rebuilt branch's required checks to settle "
             "before giving up and asking for a re-run (default: %(default)s)")
    sp_kb_merge.add_argument(
        "--head-wait", dest="head_wait", type=float,
        default=KB_MERGE_HEAD_CATCHUP_WAIT_SECS,
        help="seconds to wait, separately from --check-wait, for the PR's head to "
             "catch up to a rebuild's force-push before giving up and asking for a "
             "re-run (default: %(default)s)")
    sp_kb_merge.set_defaults(func=cmd_kb_merge)

    sp_kb_audit = kb_sub.add_parser(
