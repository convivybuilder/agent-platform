<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Retention for ~/Convivy/agent-runs (issue_01M109N0BN6N0H47XFASSN2FJJ, bosun).

  Two independent mechanisms: thins a run directory to its JSON facts past 35
  days, and deletes a whole day directory past 100 days. Both are keyed on the
  day directory's own name checked against a closed, two sided calendar band —
  see lib/agent-platform/run_retention.py for why a forgeable name is safe to
  use as the key. This job does not close the flood-cost denial of service a
  forged tree of same-day directories creates; it bounds how long a flood
  persists, not its peak sweep cost.

  04:40 local, daily. Between the hook-log prune at 04:10 and the run-observer
  sweep at 06:30, off the 01:00 overnight orchestrator hour, so none of the
  three contend.

  RunAtLoad is deliberately false: a retention job that runs on every bootstrap
  would delete on a reload during debugging, when the operator wants the
  corpus intact. A missed day is harmless, the next run collects it.

  (No double hyphen anywhere in this comment: XML forbids one inside a
  comment, plutil -lint accepts it anyway, and the repo's plist test is the
  check that catches it.)

  A plist change needs bootout plus bootstrap, not kickstart (ARCH-104).
-->
<dict>
    <key>Label</key>
    <string>com.convivy.run-retention</string>

    <!-- Deploy-pinned per platform/decisions/0059 rule 1
         (issue_01M19RRWSS9ETR09N9M2BJPA0Q): a timer firing unattended is
         production USE of run-retention, not someone working on it, so this reads
         a COPY installed from `main` into ~/.local/deploy/agent-platform-shared/
         (rules 2, 6, 7) instead of the ~/.local/bin symlink into the checkout —
         that symlink still exists and still reaches the tree, for the person who
         re-invokes run-retention interactively while working on it (rule 5).
         bin/agent-platform-autopull refreshes the deploy area on every
         origin/main advance; bin/install-agent-platform-shared is what actually
         builds it.
         ProgramArguments names the deploy area's own pinned interpreter
         explicitly (rule 4), not the shebang or launchd's PATH. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/deploy/agent-platform-shared/venv/bin/python3</string>
        <string>__HOME__/.local/deploy/agent-platform-shared/bin/run-retention</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.local/deploy/agent-platform-shared</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- STDIO DELIBERATELY OUTSIDE agent-runs, the tree this job deletes from.

         launchd opens these by plain path with no O_NOFOLLOW. A log inside
         agent-runs would let an agent pre-create it as a symlink to any file
         this user can write, and this job would then write to it under a
         trusted, unattended process rather than the agent's own reviewed
         transcript. Same reasoning as com.convivy.run-observer.plist, and the
         same destination it already uses. -->

    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/agent-platform/run-retention.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/agent-platform/run-retention.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
