<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.convivy.changelog-drain</string>

    <!-- Gets a changelog entry written for every merge that still lacks one
         (ARCH-411). Runs on the half hour rather than continuously: the merge
         feed it reads is filled by orient-github-capture on its own 900s
         interval, so a tighter cadence would mostly find nothing new.

         The cursor is derived from the store on each pass (a merge needs an
         entry when no source=co entry exists for its product+PR), so a missed
         run self-heals on the next one and there is no state file to corrupt.
         The default window is wider than the interval for exactly that reason.

         The max-dispatch flag below bounds one pass. Merges run ~53/day
         fleet-wide, so a burst or a backfill could otherwise spawn far more
         explainers than a single pass should; the remainder is picked up next
         time, oldest first. -->
    <!-- Deploy-pinned per platform/decisions/0059 rule 1
         (issue_01M19RRWSS9ETR09N9M2BJPA0Q): a timer firing unattended is
         production USE of changelog-drain, not someone working on it, so this reads
         a COPY installed from `main` into ~/.local/deploy/agent-platform-shared/
         (rules 2, 6, 7) instead of the ~/.local/bin symlink into the checkout —
         that symlink still exists and still reaches the tree, for the person who
         re-invokes changelog-drain interactively while working on it (rule 5).
         bin/agent-platform-autopull refreshes the deploy area on every
         origin/main advance; bin/install-agent-platform-shared is what actually
         builds it.
         ProgramArguments names the deploy area's own pinned interpreter
         explicitly (rule 4), not the shebang or launchd's PATH. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/deploy/agent-platform-shared/venv/bin/python3</string>
        <string>__HOME__/.local/deploy/agent-platform-shared/bin/changelog-drain</string>
        <string>--max-dispatch</string>
        <string>20</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/.local/deploy/agent-platform-shared</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Convivy/agent-runs/changelog-drain.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Convivy/agent-runs/changelog-drain.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ~/.local/bin MUST be here, and the reasoning that left it out was
             wrong in a way worth recording (ARCH-086).

             changelog-drain resolves agentctl and post-changelog by absolute
             path, so the original note concluded this PATH only needed to cover
             what THEY shell — git and gh. It does not: `agentctl spawn` execs
             `claude`, and claude lives ONLY at ~/.local/bin/claude. Off the
             launchd PATH it is not found, so every scheduled pass failed to
             spawn anything while the same command worked by hand.

             The failure is silent in the shape that matters: the drain reports
             "wrote 0, failed N" per pass and exits non-zero, which looks exactly
             like agents that ran and produced nothing. It was caught by reading
             the job's own log, not by any alarm. -->
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
