                       help="worktree path (or use --run / --repo+--purpose)")
    sp_pr.add_argument("--run", default=None,
                       help="worker run-id: resolves the worktree if still in the registry, and "
                            "always stamps the run→PR link (pr-link.json) for the scorecard (ARCH-107). "
                            "Pass it alongside --repo/--purpose when the worker has finalized.")
    sp_pr.add_argument("--repo", default=None, help="repo name (with --purpose)")
    sp_pr.add_argument("--purpose", default=None, help="worktree purpose (with --repo)")
